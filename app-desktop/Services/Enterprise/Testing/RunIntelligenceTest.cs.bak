using System;
using System.Threading.Tasks;
using Microsoft.Extensions.DependencyInjection;
using Microsoft.Extensions.Hosting;
using VoltrisOptimizer.Services.Enterprise.Testing;

namespace VoltrisOptimizer
{
    /// <summary>
    /// RUN INTELLIGENCE TEST
    /// Executa o teste completo do sistema de inteligência
    /// </summary>
    public class RunIntelligenceTest
    {
        public static async Task Main(string[] args)
        {
            Console.WriteLine("=== INICIANDO TESTE DO SISTEMA DE INTELIGÊNCIA ===");
            Console.WriteLine("Verificando se sistema IA funciona como ATERA...");
            Console.WriteLine();

            try
            {
                // Configurar serviços
                var services = new ServiceCollection();
                ConfigureServices(services);
                
                var serviceProvider = services.BuildServiceProvider();
                
                // Executar teste
                var test = new IntelligenceSystemTest(serviceProvider);
                var report = await test.RunCompleteTestAsync();
                
                // Exibir resultados
                test.PrintReport(report);
                
                // Salvar relatório
                await SaveReportToFile(report);
                
                Console.WriteLine("\nTeste concluído. Pressione qualquer tecla para sair...");
                Console.ReadKey();
            }
            catch (Exception ex)
            {
                Console.WriteLine($"ERRO FATAL: {ex.Message}");
                Console.WriteLine("Pressione qualquer tecla para sair...");
                Console.ReadKey();
            }
        }

        private static void ConfigureServices(IServiceCollection services)
        {
            // Adicionar logging
            services.AddLogging();
            
            // Adicionar serviços básicos
            services.AddSingleton<ILoggingService, ConsoleLoggingService>();
            
            // Adicionar serviços de inteligência Gamer
            services.AddVoltrisGamerIntelligenceServices();
            
            // Adicionar serviços de thermal
            services.AddVoltrisThermalServices();
        }

        private static async Task SaveReportToFile(IntelligenceTestReport report)
        {
            try
            {
                var reportPath = Path.Combine(
                    Environment.GetFolderPath(Environment.SpecialFolder.Desktop),
                    $"IntelligenceTestReport_{DateTime.Now:yyyyMMdd_HHmmss}.txt"
                );

                using var writer = new StreamWriter(reportPath);
                
                writer.WriteLine("RELATÓRIO DE TESTE - SISTEMA DE INTELIGÊNCIA VOLTRIS");
                writer.WriteLine("=".PadRight(60, '='));
                writer.WriteLine($"Data: {report.TestTimestamp:yyyy-MM-dd HH:mm:ss}");
                writer.WriteLine($"Status: {report.OverallStatus}");
                writer.WriteLine($"Veredito: {report.FinalVerdict}");
                writer.WriteLine($"Recomendação: {report.Recommendation}");
                writer.WriteLine();

                writer.WriteLine("RESULTADOS DETALHADOS:");
                writer.WriteLine("-".PadRight(40, '-'));
                
                foreach (var result in report.TestResults)
                {
                    var status = result.Value.Status switch
                    {
                        TestStatus.Passed => "PASS",
                        TestStatus.Failed => "FAIL", 
                        TestStatus.Partial => "PARTIAL",
                        _ => "UNKNOWN"
                    };
                    
                    writer.WriteLine($"{result.Key,-25}: {status,-8} - {result.Value.Message}");
                    
                    if (!string.IsNullOrEmpty(result.Value.Details))
                    {
                        writer.WriteLine($"{"",27}{result.Value.Details}");
                    }
                    writer.WriteLine();
                }

                writer.WriteLine("=".PadRight(60, '='));
                writer.WriteLine($"Relatório salvo em: {reportPath}");
                
                Console.WriteLine($"\nRelatório salvo em: {reportPath}");
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Erro ao salvar relatório: {ex.Message}");
            }
        }
    }

    // Implementação simples de logging para o teste
    public class ConsoleLoggingService : ILoggingService
    {
        public void LogInfo(string message) => Console.WriteLine($"[INFO] {DateTime.Now:HH:mm:ss} {message}");
        public void LogWarning(string message) => Console.WriteLine($"[WARN] {DateTime.Now:HH:mm:ss} {message}");
        public void LogError(string message) => Console.WriteLine($"[ERROR] {DateTime.Now:HH:mm:ss} {message}");
        public void LogError(string message, Exception ex) => Console.WriteLine($"[ERROR] {DateTime.Now:HH:mm:ss} {message}: {ex.Message}");
        public void LogSuccess(string message) => Console.WriteLine($"[SUCCESS] {DateTime.Now:HH:mm:ss} {message}");
        public void LogDebug(string message) => Console.WriteLine($"[DEBUG] {DateTime.Now:HH:mm:ss} {message}");
    }
}
