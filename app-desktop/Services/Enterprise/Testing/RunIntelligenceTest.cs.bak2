using System;
using System.IO;
using System.Threading.Tasks;
using Microsoft.Extensions.DependencyInjection;
using Microsoft.Extensions.Hosting;
using Microsoft.Extensions.Logging;
using VoltrisOptimizer.Services.Enterprise.Testing;
using VoltrisOptimizer.Services;
using VoltrisOptimizer.Core.Intelligence;
using VoltrisOptimizer.Services.Gamer.Intelligence;
using VoltrisOptimizer.Services.Gamer.Intelligence.Implementation;

namespace VoltrisOptimizer.Testing
{
    /// <summary>
    /// RUN INTELLIGENCE TEST - FIXED VERSION
    /// Executa o teste completo do sistema de inteligência com dependências corrigidas
    /// </summary>
    public class RunIntelligenceTestFixed
    {
        public static async Task Main(string[] args)
        {
            Console.WriteLine("=== INICIANDO TESTE DO SISTEMA DE INTELIGÊNCIA (MÉTODO ANTERIOR) ===");
            Console.WriteLine("Verificando se sistema IA funciona como ATERA...");
            Console.WriteLine("Estrutura: Services/Enterprise/Testing");
            Console.WriteLine();

            try
            {
                // Configurar serviços
                var services = new ServiceCollection();
                ConfigureServices(services);
                
                var serviceProvider = services.BuildServiceProvider();
                
                // Executar teste
                var test = new IntelligenceSystemTest(serviceProvider);
                var report = await test.RunCompleteTestAsync();
                
                // Exibir resultados
                test.PrintReport(report);
                
                // Salvar relatório
                await SaveReportToFile(report);
                
                Console.WriteLine("\nTeste concluído com sucesso!");
                Console.WriteLine("Pressione qualquer tecla para sair...");
                Console.ReadKey();
            }
            catch (Exception ex)
            {
                Console.WriteLine($"ERRO FATAL: {ex.Message}");
                Console.WriteLine($"Stack Trace: {ex.StackTrace}");
                Console.WriteLine("Pressione qualquer tecla para sair...");
                Console.ReadKey();
            }
        }

        private static void ConfigureServices(IServiceCollection services)
        {
            // Adicionar logging
            services.AddLogging(builder => builder.AddConsole());
            
            // Adicionar serviços básicos
            services.AddSingleton<ILoggingService, TestConsoleLoggingService>();
            
            // Adicionar serviços de inteligência Gamer
            services.AddVoltrisIntelligenceFramework();
            
            // Adicionar serviços individuais para garantir funcionamento
            services.AddSingleton<IGameIntelligence, GameIntelligenceService>();
            services.AddSingleton<PerGameLearningProfileService>();
            services.AddSingleton<PredictiveStutterPreventionService>();
            services.AddSingleton<AdaptiveHardwareEngineService>();
        }

        private static async Task SaveReportToFile(IntelligenceTestReport report)
        {
            try
            {
                var reportPath = Path.Combine(
                    Environment.GetFolderPath(Environment.SpecialFolder.Desktop),
                    $"IntelligenceTest_Report_{DateTime.Now:yyyyMMdd_HHmmss}.txt"
                );

                using var writer = new StreamWriter(reportPath);
                
                writer.WriteLine("RELATÓRIO DE TESTE - SISTEMA DE INTELIGÊNCIA VOLTRIS");
                writer.WriteLine("MÉTODO: Services/Enterprise/Testing");
                writer.WriteLine("=".PadRight(60, '='));
                writer.WriteLine($"Data: {report.TestTimestamp:yyyy-MM-dd HH:mm:ss}");
                writer.WriteLine($"Status: {report.OverallStatus}");
                writer.WriteLine($"Veredito: {report.FinalVerdict}");
                writer.WriteLine($"Recomendação: {report.Recommendation}");
                writer.WriteLine();

                writer.WriteLine("RESULTADOS DETALHADOS:");
                writer.WriteLine("-".PadRight(40, '-'));
                
                foreach (var result in report.TestResults)
                {
                    var status = result.Value.Status switch
                    {
                        TestStatus.Passed => "PASS",
                        TestStatus.Failed => "FAIL", 
                        TestStatus.Partial => "PARTIAL",
                        _ => "UNKNOWN"
                    };
                    
                    writer.WriteLine($"{result.Key,-25}: {status,-8} - {result.Value.Message}");
                    
                    if (!string.IsNullOrEmpty(result.Value.Details))
                    {
                        writer.WriteLine($"{"",27}{result.Value.Details}");
                    }
                    writer.WriteLine();
                }

                writer.WriteLine("=".PadRight(60, '='));
                writer.WriteLine($"Relatório salvo em: {reportPath}");
                
                Console.WriteLine($"\nRelatório salvo em: {reportPath}");
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Erro ao salvar relatório: {ex.Message}");
            }
        }
    }

    // Implementação simples de logging para o teste
    public class TestConsoleLoggingService : ILoggingService
    {
        public void LogInfo(string message) => Console.WriteLine($"[INFO] {DateTime.Now:HH:mm:ss} {message}");
        public void LogWarning(string message) => Console.WriteLine($"[WARN] {DateTime.Now:HH:mm:ss} {message}");
        public void LogError(string message) => Console.WriteLine($"[ERROR] {DateTime.Now:HH:mm:ss} {message}");
        public void LogError(string message, Exception? ex) => Console.WriteLine($"[ERROR] {DateTime.Now:HH:mm:ss} {message}: {ex?.Message}");
        public void LogSuccess(string message) => Console.WriteLine($"[SUCCESS] {DateTime.Now:HH:mm:ss} {message}");
        public void LogDebug(string message, string? source = null) => Console.WriteLine($"[DEBUG] {DateTime.Now:HH:mm:ss} {message}");
        public void LogTrace(string message, string? source = null) => Console.WriteLine($"[TRACE] {DateTime.Now:HH:mm:ss} {message}");
        public void LogCritical(string message, Exception? exception = null, string? source = null) => Console.WriteLine($"[CRITICAL] {DateTime.Now:HH:mm:ss} {message}");
        public void Log(VoltrisOptimizer.Services.LogLevel level, VoltrisOptimizer.Services.LogCategory category, string message, Exception? exception = null, string? source = null) => LogInfo(message);
        public event EventHandler<string>? LogEntryAdded;
        public void ClearLogs() { }
        public void ExportLogs(string filePath) { }
        public string[] GetLogs() => Array.Empty<string>();
        public string GetLogDirectory() => string.Empty;
        public void Dispose() { }
    }
}
