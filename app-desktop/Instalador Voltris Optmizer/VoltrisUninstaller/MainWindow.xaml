<Window x:Class="VoltrisUninstaller.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:services="clr-namespace:VoltrisUninstaller.Services"
        Title="{Binding [UninstallerTitle], Source={x:Static services:LocalizationService.Instance}}"
        Width="750" Height="620"
        MinWidth="700" MinHeight="550"
        WindowStyle="None"
        AllowsTransparency="False"
        Background="#1E1E2E"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen">
    
    <Border Background="{StaticResource DarkBrush}"
            BorderBrush="{StaticResource DarkBorderBrush}"
            BorderThickness="1"
        CornerRadius="12"
            UseLayoutRounding="True"
            SnapsToDevicePixels="True"
        ClipToBounds="True">
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" 
                            ShadowDepth="0" 
                            Opacity="0.5" 
                        Color="Black"/>
        </Border.Effect>
        
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="90"/> 
                <RowDefinition Height="*"/>
                <RowDefinition Height="100"/>
            </Grid.RowDefinitions>
            
             
            <Ellipse Width="300" Height="300" 
                    HorizontalAlignment="Left" 
                    VerticalAlignment="Top"
                    Margin="50,30,0,0"
                    Fill="{StaticResource AccentBlurBrush}">
                <Ellipse.Effect>
                    <BlurEffect Radius="100"/>
                </Ellipse.Effect>
            </Ellipse>
            
            <Ellipse Width="250" Height="250" 
                    HorizontalAlignment="Right" 
                    VerticalAlignment="Bottom"
                    Margin="0,0,80,50"
                    Fill="{StaticResource SecondaryBlurBrush}">
                <Ellipse.Effect>
                    <BlurEffect Radius="100"/>
                </Ellipse.Effect>
            </Ellipse>
            
            <Border Grid.RowSpan="3" Background="{StaticResource DarkBrush}" Opacity="0.7"/>
            
             
            <Border x:Name="HeaderBorder" Grid.Row="0"
                    Background="{StaticResource DarkPanelBrush}"
                    BorderBrush="{StaticResource DarkBorderBrush}"
                    BorderThickness="0,0,0,1"
                CornerRadius="12,12,0,0"
                    Padding="24,20,8,20"
                    MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Image Source="pack://application:,,,/Images/voltris.png"
                               Width="48" Height="48"
                               Stretch="Uniform"
                               Margin="0,0,16,0"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding [UninstallerTitle], Source={x:Static services:LocalizationService.Instance}}"
                                      FontFamily="Segoe UI Variable Display, Segoe UI"
                                      FontSize="14"
                                      FontWeight="SemiBold">
                                <TextBlock.Foreground>
                                    <StaticResource ResourceKey="VoltrisGradientHorizontalBrush"/>
                                </TextBlock.Foreground>
                            </TextBlock>
                            <TextBlock Text="{Binding [UninstallerCenterTitle], Source={x:Static services:LocalizationService.Instance}}"
                                      Foreground="{StaticResource TextSecondaryBrush}"
                                      FontSize="10" FontWeight="Bold"
                                      Opacity="0.6"
                                      Margin="0,2,0,0"/>
                        </StackPanel>
                    </StackPanel>
                    
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        

                        <Button x:Name="LanguageButton" Click="LanguageButton_Click" Cursor="Hand" Margin="0,0,4,0" ToolTip="{Binding [InstallerSelectLanguageTooltip], Source={x:Static services:LocalizationService.Instance}}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="langBorder" CornerRadius="4" Padding="8,6">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                <GradientStop Color="#FF4B6B" Offset="0"/>
                                                <GradientStop Color="#8B31FF" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                        <TextBlock Text="🌐" FontSize="16" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="langBorder" Property="Background">
                                                <Setter.Value>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                        <GradientStop Color="#FF6B8B" Offset="0"/>
                                                        <GradientStop Color="#A040FF" Offset="1"/>
                                                    </LinearGradientBrush>
                                                </Setter.Value>
                                            </Setter>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
</Button.Template></Button>
                        <Button x:Name="TransparencyToggleButton"
                                Background="Transparent"
                                BorderThickness="0"
                                Cursor="Hand"
                                Click="TransparencyToggleButton_Click"
                                MinWidth="46"
                                MinHeight="32"
                                ToolTip="{Binding [UninstallerTitle], Source={x:Static services:LocalizationService.Instance}}">
                          <Path Data="M12,3C7.05,3 3,7.05 3,12C3,16.95 7.05,21 12,21C16.95,21 21,16.95 21,12C21,7.05 16.95,3 12,3M12,5C15.87,5 19,8.13 19,12C19,15.87 15.87,19 12,19V5Z"
                                Fill="#94A8B8"
                                Width="16" Height="16"
                                Stretch="Uniform"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
                        </Button>
                    <Button x:Name="MinimizeButton" Content="—" Width="40" Height="40" Background="Transparent" Foreground="White" BorderThickness="0" FontSize="14" Click="MinimizeButton_Click" Cursor="Hand" Margin="0,0,4,0">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" CornerRadius="4">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#8B31FF"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button x:Name="CloseButton" Content="✕" Width="40" Height="40" Background="Transparent" Foreground="White" BorderThickness="0" FontSize="14" Click="CloseButton_Click" Cursor="Hand">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" CornerRadius="0,12,0,0">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#E81123"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
            
            
            <Grid Grid.Row="1">
                
                
                <Grid x:Name="IntroPanel" Visibility="Visible">
                    <StackPanel VerticalAlignment="Center" Margin="60,0">
                        <TextBlock Text="{Binding [UninstallerUninstallQuestion], Source={x:Static services:LocalizationService.Instance}}" 
                                 FontSize="32" FontWeight="Black" 
                                 HorizontalAlignment="Center"
                                 TextAlignment="Center">
                            <TextBlock.Foreground>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#31A8FF" Offset="0"/>
                                    <GradientStop Color="#8B31FF" Offset="1"/>
                                </LinearGradientBrush>
                            </TextBlock.Foreground>
                        </TextBlock>
                        
                        <TextBlock Text="{Binding [UninstallerUninstallWarning], Source={x:Static services:LocalizationService.Instance}}" 
                                 Style="{StaticResource DescriptionTextStyle}" 
                                 TextAlignment="Center" 
                                 FontSize="15"
                                 Margin="0,20,0,40"
                                 Opacity="0.8"/>
                        
                        <CheckBox x:Name="KeepUserDataCheckBox" 
                                  HorizontalAlignment="Center"
                                  Margin="0,30,0,0">
                        <CheckBox.Template>
                            <ControlTemplate TargetType="CheckBox">
                                <Border x:Name="bgBorder"
                                        Background="#1E1E2E"
                                        BorderBrush="#3D3D5C"
                                        BorderThickness="1"
                                        CornerRadius="16"
                                        Padding="24,20"
                                        MinWidth="450"
                                        Cursor="Hand">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        
                                        <Border x:Name="checkBoxArea" 
                                                Width="28" Height="28" 
                                                CornerRadius="8"
                                                Background="#2A2A3E"
                                                BorderBrush="#3D3D5C"
                                                BorderThickness="2"
                                                Margin="0,0,16,0">
                                            <Border.RenderTransform>
                                                <ScaleTransform ScaleX="1" ScaleY="1"/>
                                            </Border.RenderTransform>
                                            <TextBlock x:Name="checkMark" 
                                                      Text="✓" 
                                                      FontSize="16" 
                                                      FontWeight="Bold"
                                                      Foreground="White"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"
                                                      Visibility="Collapsed"/>
                                        </Border>
                                        
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding [KeepUserData], Source={x:Static services:LocalizationService.Instance}}" 
                                                      Foreground="White"
                                                      FontSize="15"
                                                      FontWeight="SemiBold"
                                                      FontFamily="Segoe UI"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsChecked" Value="True">
                                        <Setter TargetName="checkBoxArea" Property="Background">
                                            <Setter.Value>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                    <GradientStop Color="#FF4B6B" Offset="0"/>
                                                    <GradientStop Color="#8B31FF" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Setter.Value>
                                        </Setter>
                                        <Setter TargetName="checkBoxArea" Property="BorderBrush" Value="Transparent"/>
                                        <Setter TargetName="checkMark" Property="Visibility" Value="Visible"/>
                                        <Setter TargetName="bgBorder" Property="BorderBrush" Value="#8B31FF"/>
                                        <Setter TargetName="bgBorder" Property="Background" Value="#252035"/>
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bgBorder" Property="BorderBrush" Value="#8B31FF"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </CheckBox.Template>
                    </CheckBox>
                    </StackPanel>
                </Grid>

                
                <Grid x:Name="SurveyView" Visibility="Collapsed">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="600">
                        
                        <TextBlock Text="{Binding [SurveyTitle], Source={x:Static services:LocalizationService.Instance}}" 
                                 FontSize="28" FontWeight="Black"
                                 Foreground="White"
                                 HorizontalAlignment="Center" 
                                 TextAlignment="Center"
                                 Margin="0,0,0,30"/>
                        
                        <StackPanel x:Name="SurveyPanel">
                            <RadioButton Style="{StaticResource ModernRadioButtonStyle}" x:Name="Reason1" Margin="0,4">
                                <RadioButton.Content>
                                    <Border Background="{StaticResource DarkPanelBrush}" BorderBrush="{StaticResource DarkBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="16" Width="520">
                                        <TextBlock Text="{Binding [Reason1], Source={x:Static services:LocalizationService.Instance}}" Foreground="White" FontSize="14"/>
                                    </Border>
                                </RadioButton.Content>
                            </RadioButton>
                            
                            <RadioButton Style="{StaticResource ModernRadioButtonStyle}" x:Name="Reason2" Margin="0,4">
                                <RadioButton.Content>
                                    <Border Background="{StaticResource DarkPanelBrush}" BorderBrush="{StaticResource DarkBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="16" Width="520">
                                        <TextBlock Text="{Binding [Reason2], Source={x:Static services:LocalizationService.Instance}}" Foreground="White" FontSize="14"/>
                                    </Border>
                                </RadioButton.Content>
                            </RadioButton>
                            
                            <RadioButton Style="{StaticResource ModernRadioButtonStyle}" x:Name="Reason3" Margin="0,4">
                                <RadioButton.Content>
                                    <Border Background="{StaticResource DarkPanelBrush}" BorderBrush="{StaticResource DarkBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="16" Width="520">
                                        <TextBlock Text="{Binding [Reason3], Source={x:Static services:LocalizationService.Instance}}" Foreground="White" FontSize="14"/>
                                    </Border>
                                </RadioButton.Content>
                            </RadioButton>
                            
                            <RadioButton Style="{StaticResource ModernRadioButtonStyle}" x:Name="Reason4" Margin="0,4">
                                <RadioButton.Content>
                                    <Border Background="{StaticResource DarkPanelBrush}" BorderBrush="{StaticResource DarkBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="16" Width="520">
                                        <TextBlock Text="{Binding [Reason4], Source={x:Static services:LocalizationService.Instance}}" Foreground="White" FontSize="14"/>
                                    </Border>
                                </RadioButton.Content>
                            </RadioButton>
                            
                            <RadioButton Style="{StaticResource ModernRadioButtonStyle}" x:Name="Reason5" Margin="0,4" >
                                <RadioButton.Content>
                                    <Border Background="{StaticResource DarkPanelBrush}" BorderBrush="{StaticResource DarkBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="16" Width="520">
                                        <TextBlock Text="{Binding [Reason5], Source={x:Static services:LocalizationService.Instance}}" Foreground="White" FontSize="14"/>
                                    </Border>
                                </RadioButton.Content>
                            </RadioButton>
                        </StackPanel>
                    </StackPanel>
                </Grid>

                
                <Grid x:Name="ProgressPanel" Visibility="Collapsed">
                    <StackPanel VerticalAlignment="Center" Margin="80,0">
                        <TextBlock Text="{Binding [ExecutingUninstall], Source={x:Static services:LocalizationService.Instance}}" 
                                 FontSize="24" FontWeight="Black" 
                                 Foreground="White"
                                 HorizontalAlignment="Center"
                                 Margin="0,0,0,40"/>
                        
                        <Border Background="{StaticResource DarkPanelBrush}" 
                                BorderBrush="{StaticResource DarkBorderBrush}" 
                                BorderThickness="1" 
                            CornerRadius="20" 
                                Padding="4">
                            <ProgressBar x:Name="ProgressBar" Height="12" Minimum="0" Maximum="100" Value="0" Background="Transparent" BorderThickness="0">
                                <ProgressBar.Foreground>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#FF4B6B" Offset="0"/>
                                        <GradientStop Color="#8B31FF" Offset="0.5"/>
                                        <GradientStop Color="#31A8FF" Offset="1"/>
                                    </LinearGradientBrush>
                                </ProgressBar.Foreground>
                            </ProgressBar>
                        </Border>
                        
                        <TextBlock x:Name="StatusText" 
                                 Text="{Binding [StatusOptimizing], Source={x:Static services:LocalizationService.Instance}}" 
                                 Foreground="{StaticResource TextSecondaryBrush}" 
                                 FontSize="13" FontWeight="Bold"
                                 HorizontalAlignment="Center" 
                                 Margin="0,20,0,0"
                                 Opacity="0.6"/>
                    </StackPanel>
                </Grid>
            </Grid>

            
            <Border x:Name="FooterBorder" Grid.Row="2"
                    Background="{StaticResource DarkPanelBrush}"
                    BorderBrush="{StaticResource DarkBorderBrush}"
                    BorderThickness="0,1,0,0"
                CornerRadius="0,0,12,12"
                    Padding="24,20">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Button x:Name="CancelButton"
                       Content="{Binding [Back], Source={x:Static services:LocalizationService.Instance}}"
                           Style="{StaticResource SecondaryButtonStyle}"
                       Click="CancelButton_Click"
                           Margin="0,0,16,0"
                           Width="140" Height="50"/>
                    
                    <Button x:Name="UninstallButton"
                       Content="{Binding [Next], Source={x:Static services:LocalizationService.Instance}}"
                           Style="{StaticResource ModernButtonStyle}"
                       Click="UninstallButton_Click"
                           Width="220" Height="50"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
