<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>VoltrisOptimizerInstaller</AssemblyName>
    <RootNamespace>VoltrisOptimizerInstaller</RootNamespace>
    <NeutralLanguage>pt-BR</NeutralLanguage>
    <Version>1.0.2.5</Version>
    <Authors>Voltris Corporation</Authors>
    <Company>Voltris Corporation</Company>
    <Product>Voltris Optimizer Installer</Product>
    <Description>Instalador do Voltris Optimizer</Description>
    <Copyright>Copyright © VOLTRIS 2025</Copyright>
    <AssemblyTitle>Voltris Optimizer Installer</AssemblyTitle>
    <AssemblyDescription>Instalador oficial do Voltris Optimizer</AssemblyDescription>
    <FileVersion>1.0.2.5</FileVersion>
    <ProductVersion>1.0.2.5</ProductVersion>
    <ApplicationIcon>favicon.ico</ApplicationIcon>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <PublishReadyToRun>false</PublishReadyToRun>
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-x86</RuntimeIdentifier>
    <EnableDefaultEmbeddedResourceItems>false</EnableDefaultEmbeddedResourceItems>
    <StartupObject>VoltrisOptimizerInstaller.Program</StartupObject>
    
    <!-- OTIMIZAÇÃO DE PERFORMANCE EXTREMA -->
    <Optimize>true</Optimize>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <TieredCompilation>true</TieredCompilation>
    <TieredCompilationQuickJit>true</TieredCompilationQuickJit>
  </PropertyGroup>
  
  <!-- IMAGENS E �CONES -->
  <ItemGroup>
    <Resource Include="favicon.ico" />
    <Resource Include="..\..\Images\voltris.png">
      <Link>Images\voltris.png</Link>
    </Resource>
  </ItemGroup>
  
  <!-- EMBUTIR �CONE PARA PUBLISHSINGLEFILE -->
  <PropertyGroup>
    <ApplicationIcon>favicon.ico</ApplicationIcon>
  </PropertyGroup>
  
  <!-- PAYLOAD MONOL�TICO (TUDO DENTRO DO EXE) -->
  <ItemGroup Condition="'$(RuntimeIdentifier)' == 'win-x86'">
    <EmbeddedResource Include="..\..\@Resources\VOLTris_Optimizer_x86.zip">
      <LogicalName>VoltrisOptimizerInstaller.Payload.x86.zip</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\..\@Resources\uninstall_x86_single.exe">
      <LogicalName>VoltrisOptimizerInstaller.Resources.uninstall.exe</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
  
  <ItemGroup Condition="'$(RuntimeIdentifier)' == 'win-x64'">
    <EmbeddedResource Include="..\..\@Resources\VOLTris_Optimizer_x64.zip">
      <LogicalName>VoltrisOptimizerInstaller.Payload.x64.zip</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\..\@Resources\uninstall_x64_single.exe">
      <LogicalName>VoltrisOptimizerInstaller.Resources.uninstall.exe</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
  
  <PropertyGroup>
    <ApplicationVisualStyles>true</ApplicationVisualStyles>
    <ApplicationUseCompatibleTextRendering>false</ApplicationUseCompatibleTextRendering>
  </PropertyGroup>

</Project>


