<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============================================ -->
    <!-- TRANSPARÊNCIA DESATIVADA — DARK MODE       -->
    <!-- Brushes sólidos sem transparência            -->
    <!-- ============================================ -->

    <!-- Fundos principais sólidos (dark) -->
    <SolidColorBrush x:Key="DarkBrush"          Color="#171313"/>
    <SolidColorBrush x:Key="DarkPanelBrush"     Color="#1c1c1e"/>
    <SolidColorBrush x:Key="DarkPanelAltBrush"  Color="#2a2a2e"/>
    <SolidColorBrush x:Key="DarkBorderBrush"    Color="#3a3a3e"/>
    
    <SolidColorBrush x:Key="WindowBackgroundBrush"  Color="#171313"/>
    
</ResourceDictionary>