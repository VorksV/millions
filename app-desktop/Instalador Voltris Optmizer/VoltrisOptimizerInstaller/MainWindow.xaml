<Window x:Class="VoltrisOptimizerInstaller.MainWindow"
         xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
         xmlns:services="clr-namespace:VoltrisOptimizerInstaller.Services"
         Title="{Binding [InstallerTitle], Source={x:Static services:LocalizationService.Instance}}"
         Width="750" Height="620"
         MinWidth="700" MinHeight="550"
         WindowStyle="None"
         AllowsTransparency="False"
         Background="{StaticResource WindowBackgroundBrush}"
         ResizeMode="NoResize"
         WindowStartupLocation="CenterScreen"
         Icon="pack://application:,,,/favicon.ico"
         ContentRendered="Window_ContentRendered">
    
    <Border Background="{StaticResource WindowBackgroundBrush}"
            BorderBrush="{StaticResource DarkBorderBrush}"
            BorderThickness="1"
        CornerRadius="12"
            UseLayoutRounding="True"
            SnapsToDevicePixels="True"
        ClipToBounds="True">
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" 
                            ShadowDepth="0" 
                            Opacity="0.5" 
                        Color="Black"/>
        </Border.Effect>
        
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="90"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="110"/>
            </Grid.RowDefinitions>
            
            <!-- Efeitos de Fundo (Premium Blur) -->
            <Ellipse Width="300" Height="300" 
                    HorizontalAlignment="Left" 
                    VerticalAlignment="Top"
                    Margin="50,30,0,0"
                    Fill="{StaticResource AccentBlurBrush}">
                <Ellipse.Effect>
                    <BlurEffect Radius="100"/>
                </Ellipse.Effect>
            </Ellipse>
            
            <Ellipse Width="250" Height="250" 
                    HorizontalAlignment="Right" 
                    VerticalAlignment="Bottom"
                    Margin="0,0,80,50"
                    Fill="{StaticResource SecondaryBlurBrush}">
                <Ellipse.Effect>
                    <BlurEffect Radius="100"/>
                </Ellipse.Effect>
            </Ellipse>
            
            <Border Grid.RowSpan="3" Background="{StaticResource DarkPanelBrush}" Opacity="0.95"/>
            
            <!-- 1. HEADER -->
            <Border x:Name="HeaderBorder" Grid.Row="0"
                    Background="{StaticResource DarkPanelBrush}"
                    BorderBrush="{StaticResource DarkBorderBrush}"
                    BorderThickness="0,0,0,1"
                CornerRadius="12,12,0,0"
                    Padding="24,20,8,20"
                    MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Image Source="pack://application:,,,/Images/voltris.png"
                               Width="48" Height="48"
                               Stretch="Uniform"
                               Margin="0,0,16,0"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding [InstallerAppName], Source={x:Static services:LocalizationService.Instance}}"
                                      FontFamily="Segoe UI Variable Display, Segoe UI"
                                      FontSize="14"
                                      FontWeight="SemiBold">
                                <TextBlock.Foreground>
                                    <StaticResource ResourceKey="VoltrisGradientHorizontalBrush"/>
                                </TextBlock.Foreground>
                            </TextBlock>
                            <TextBlock Text="{Binding [InstallerAssistant], Source={x:Static services:LocalizationService.Instance}}"
                                      Foreground="{StaticResource TextSecondaryBrush}"
                                      FontSize="10" FontWeight="Bold"
                                      Opacity="0.6"
                                      Margin="0,2,0,0"/>
                        </StackPanel>
                    </StackPanel>
                    
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">

                        <Button x:Name="LanguageButton" Click="LanguageButton_Click" Cursor="Hand" Margin="0,0,4,0" ToolTip="{Binding [InstallerSelectLanguageTooltip], Source={x:Static services:LocalizationService.Instance}}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="langBorder" CornerRadius="4" Padding="8,6">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                <GradientStop Color="#FF4B6B" Offset="0"/>
                                                <GradientStop Color="#8B31FF" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                        <TextBlock Text="🌐" FontSize="16" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="langBorder" Property="Background">
                                                <Setter.Value>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                        <GradientStop Color="#FF6B8B" Offset="0"/>
                                                        <GradientStop Color="#A040FF" Offset="1"/>
                                                    </LinearGradientBrush>
                                                </Setter.Value>
                                            </Setter>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Button x:Name="MinimizeButton" Content="—" Width="40" Height="40" Background="Transparent" Foreground="White" BorderThickness="0" FontSize="14" Click="MinimizeButton_Click" Cursor="Hand" Margin="0,0,4,0">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" CornerRadius="4">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#8B31FF"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button x:Name="CloseButton" Content="✕" Width="40" Height="40" Background="Transparent" Foreground="White" BorderThickness="0" FontSize="14" Click="CloseButton_Click" Cursor="Hand">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" CornerRadius="0,12,0,0">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#E81123"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
            
            <!-- 2. CONTENT AREA -->
            <Grid Grid.Row="1">
                <ScrollViewer x:Name="ContentScroll" 
                             VerticalScrollBarVisibility="Disabled"
                             HorizontalScrollBarVisibility="Disabled"
                             Padding="40,10">
                    <StackPanel x:Name="ContentPanel" VerticalAlignment="Center">
                        <!-- Conteúdo dinâmico -->
                    </StackPanel>
                </ScrollViewer>
                
                <!-- Barra de progresso no content -->
                <Border x:Name="ContentProgressBorder" 
                        VerticalAlignment="Bottom" 
                        Margin="40,0,40,30"
                        Visibility="Collapsed">
                    <StackPanel>
                        <Border Background="{StaticResource DarkPanelBrush}"
                                BorderBrush="{StaticResource DarkBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="20"
                                Padding="6"
                                Height="16">
                            <ProgressBar x:Name="ContentProgressBar" 
                                        Height="8" 
                                        Minimum="0" Maximum="100" Value="0" 
                                        Background="Transparent" BorderThickness="0">
                                <ProgressBar.Foreground>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#FF4B6B" Offset="0"/>
                                        <GradientStop Color="#8B31FF" Offset="0.5"/>
                                        <GradientStop Color="#31A8FF" Offset="1"/>
                                    </LinearGradientBrush>
                                </ProgressBar.Foreground>
                            </ProgressBar>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>
            
            <!-- 3. FOOTER -->
            <Border x:Name="FooterBorder" Grid.Row="2"
                    Background="{StaticResource DarkPanelBrush}"
                    BorderBrush="{StaticResource DarkBorderBrush}"
                    BorderThickness="0,1,0,0"
                CornerRadius="0,0,12,12"
                    Padding="24,20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <Border x:Name="ProgressBarBorder" Grid.Row="0" Margin="40,0,40,10"
                            Background="{StaticResource DarkPanelBrush}"
                            BorderBrush="{StaticResource DarkBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="20"
                            Padding="4"
                            Height="20"
                            VerticalAlignment="Center"
                            Visibility="Collapsed">
                        <ProgressBar x:Name="ProgressBar" Height="10" Minimum="0" Maximum="100" Value="0" Background="Transparent" BorderThickness="0">
                            <ProgressBar.Foreground>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#FF4B6B" Offset="0"/>
                                    <GradientStop Color="#8B31FF" Offset="0.5"/>
                                    <GradientStop Color="#31A8FF" Offset="1"/>
                                </LinearGradientBrush>
                            </ProgressBar.Foreground>
                        </ProgressBar>
                    </Border>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Button x:Name="CancelButton"
                            Content="{Binding [Back], Source={x:Static services:LocalizationService.Instance}}"
                                Style="{StaticResource SecondaryButtonStyle}"
                            Click="CancelButton_Click"
                                Margin="0,0,16,0"
                                Width="140" Height="50"/>
                        
                        <Button x:Name="NextButton"
                            Content="{Binding [Next], Source={x:Static services:LocalizationService.Instance}}"
                                Style="{StaticResource ModernButtonStyle}"
                            Click="NextButton_Click"
                                Width="220" Height="50"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>