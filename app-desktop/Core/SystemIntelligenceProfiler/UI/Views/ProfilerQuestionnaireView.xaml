<UserControl xmlns:services="clr-namespace:VoltrisOptimizer.Services"
             xmlns:converters="clr-namespace:VoltrisOptimizer.UI.Converters"
             xmlns:vm="clr-namespace:VoltrisOptimizer.Core.SystemIntelligenceProfiler.UI.ViewModels"
             xmlns:controls="clr-namespace:VoltrisOptimizer.UI.Controls"
             x:Class="VoltrisOptimizer.Core.SystemIntelligenceProfiler.UI.Views.ProfilerQuestionnaireView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             Background="Transparent"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             SizeChanged="OnViewSizeChanged">

    <UserControl.Resources>
        <!-- StringToBoolConverter é declarado AQUI de propósito: ele só existia
             nos recursos locais desta view e não está em nenhum dicionário do
             app. Sem esta linha o InitializeComponent lança "Cannot find
             resource" e a página inteira fica em branco. -->
        <vm:StringToBoolConverter x:Key="StringToBoolConverter"/>
        <converters:UseCaseIconConverter x:Key="UseCaseIcon"/>
        <converters:UseCaseAccentConverter x:Key="UseCaseAccent"/>

        <!-- [FIX:GAMER-VARIANTS] NOME EXIBIDO DE UM PERFIL, NOS 3 IDIOMAS.
             Lê a chave do catálogo, que cobre os DEZ perfis.
             Havia um switch de 6 casos fazendo esse papel dentro do ViewModel: a
             quarta fonte de verdade do mesmo dado. A divergência entre elas foi
             o que deixou as quatro variantes gamer invisíveis — o ViewModel
             sabia o nome, mas o catálogo não era consultado, e o caminho de ida
             (token -> perfil) não existia para elas. -->
        <converters:ProfileDisplayNameConverter x:Key="ProfileDisplayName"/>
<converters:GamerFamilyBoolConverter x:Key="GamerFamilyBool"/>

        <LinearGradientBrush x:Key="BrandGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FF4B6B" Offset="0"/>
            <GradientStop Color="#8B31FF" Offset="0.52"/>
            <GradientStop Color="#31A8FF" Offset="1"/>
        </LinearGradientBrush>

        <RadialGradientBrush x:Key="GlowPink" Center="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
            <GradientStop Color="{DynamicResource AccentColor}" Offset="0"/>
            <GradientStop Color="Transparent" Offset="1"/>
        </RadialGradientBrush>
        <RadialGradientBrush x:Key="GlowPurple" Center="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
            <GradientStop Color="{DynamicResource SecondaryColor}" Offset="0"/>
            <GradientStop Color="Transparent" Offset="1"/>
        </RadialGradientBrush>
        <RadialGradientBrush x:Key="GlowBlue" Center="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
            <GradientStop Color="{DynamicResource PrimaryColor}" Offset="0"/>
            <GradientStop Color="Transparent" Offset="1"/>
        </RadialGradientBrush>

        <!-- Card de perfil. MinHeight garante que o conteúdo NUNCA seja cortado:
             o card cresce se precisar, em vez de espremer o texto. -->
        <Style x:Key="ProfileCard" TargetType="RadioButton">
            <Setter Property="Background" Value="#A3161C2B"/>
            <Setter Property="BorderBrush" Value="#263D4A61"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="True"/>
            <Setter Property="MinHeight" Value="76"/>
            <Setter Property="Margin" Value="0,0,10,10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Surface"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="14" SnapsToDevicePixels="True">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="14" ShadowDepth="2" Opacity="0.3" Color="#000000"/>
                            </Border.Effect>
                            <Grid>
                                <Border x:Name="AccentLine" Width="3" HorizontalAlignment="Left"
                                        CornerRadius="14,0,0,14" Opacity="0"
                                        Background="{Binding Tag, RelativeSource={RelativeSource AncestorType={x:Type RadioButton}}, Converter={StaticResource UseCaseAccent}}"/>
                                <!-- [FIX:CARDS-DIM] O desfoque vai no CONTEÚDO, não na
                                     superfície. A `Surface` já tem DropShadowEffect e
                                     um VisualElement aceita UM Effect — aplicar o
                                     desfoque ali trocaria a sombra do card. Por isso
                                     existe este Grid intermediário: ele recebe o
                                     desfoque e a superfície continua nítida, com a
                                     borda e o brilho legíveis. -->
                                <Grid x:Name="CardBody">
                                    <ContentPresenter Margin="{TemplateBinding Padding}"/>
                                </Grid>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#1CFFFFFF"/>
                                <Setter TargetName="Surface" Property="BorderBrush" Value="#598B31FF"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Surface" Property="BorderBrush" Value="#B0FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#1EFFFFFF"/>
                                <Setter TargetName="AccentLine" Property="Opacity" Value="1"/>
                            </Trigger>

                            <!-- [FIX:CARDS-DIM] OS CARTES NÃO ESCOLHIDOS FICAM
                                 DESFOCADOS.
                                 ==========================================
                                 Duas condições ao mesmo tempo, e as duas são
                                 necessárias:
                                   · já existe uma escolha no grupo
                                     (HasAnyCardSelected)
                                   · ESTE card não é o escolhido (IsChecked=false)

                                 Com uma só delas o efeito erraria. Só com
                                 "já existe escolha", o card marcado também
                                 desbotaria. Só com "não estou marcado", os seis
                                 cards nasceriam desbotados numa página em que o
                                 usuário ainda não escolheu nada — que é o pior
                                 dos dois, porque a página pareceria morta antes
                                 da primeira interação.

                                 `RelativeSource Self` dentro do template
                                 resolve para o próprio RadioButton, que é quem
                                 responde por IsChecked; o DataContext vem
                                 herdado da página, que é quem responde por
                                 HasAnyCardSelected. -->
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding DataContext.HasAnyCardSelected, RelativeSource={RelativeSource Self}}" Value="True"/>
                                    <Condition Binding="{Binding IsChecked, RelativeSource={RelativeSource Self}}" Value="False"/>
                                </MultiDataTrigger.Conditions>
                                <Setter TargetName="CardBody" Property="Effect">
                                    <Setter.Value>
                                        <BlurEffect Radius="3.4"/>
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="CardBody" Property="Opacity" Value="0.45"/>
                            </MultiDataTrigger>

                            <!-- O hover por cima do desfoque: passar o mouse num
                                 card desbotado tem que devolver a leitura de "isto
                                 aqui ainda é clicável". -->
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding DataContext.HasAnyCardSelected, RelativeSource={RelativeSource Self}}" Value="True"/>
                                    <Condition Binding="{Binding IsChecked, RelativeSource={RelativeSource Self}}" Value="False"/>
                                    <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True"/>
                                </MultiDataTrigger.Conditions>
                                <Setter TargetName="CardBody" Property="Effect" Value="{x:Null}"/>
                                <Setter TargetName="CardBody" Property="Opacity" Value="0.85"/>
                            </MultiDataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Segmento do controle segmentado de estratégia.
             Transparente por padrão, com borda de 1px. O selecionado ganha
             preenchimento + borda mais forte e o ícone assume a cor de
             destaque — o preenchimento vem de trigger de IsChecked, sem
             nenhum recurso extra. -->
        <Style x:Key="Segment" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="True"/>
            <Setter Property="Margin" Value="3,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Seg" Background="Transparent"
                                BorderBrush="#22FFFFFF" BorderThickness="1"
                                CornerRadius="10" Padding="10,8">
                            <!-- [FIX:CARDS-DIM] Mesmo esquema do ProfileCard: o
                                 desfoque fica no conteúdo, para a borda do
                                 segmento continuar nítida. -->
                            <ContentPresenter x:Name="CardBody" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Seg" Property="Background" Value="#12FFFFFF"/>
                                <Setter TargetName="Seg" Property="BorderBrush" Value="#3DFFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Seg" Property="Background" Value="#1CFFFFFF"/>
                                <Setter TargetName="Seg" Property="BorderBrush" Value="#598B31FF"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Seg" Property="BorderBrush" Value="#B0FFFFFF"/>
                            </Trigger>

                            <!-- [FIX:CARDS-DIM] Este estilo é usado na sub-escolha
                                 gamer, que é um grupo próprio dentro do mesmo campo
                                 `UseCase`. Escolher "Gamer Competitivo" precisa
                                 deixar os outros quatro perfis gamer desbotados,
                                 senão a sub-escolha parece uma lista de sete
                                 opções em vez de uma escolha entre cinco. -->
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding DataContext.HasAnyCardSelected, RelativeSource={RelativeSource Self}}" Value="True"/>
                                    <Condition Binding="{Binding IsChecked, RelativeSource={RelativeSource Self}}" Value="False"/>
                                </MultiDataTrigger.Conditions>
                                <Setter TargetName="CardBody" Property="Effect">
                                    <Setter.Value>
                                        <BlurEffect Radius="2.8"/>
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="CardBody" Property="Opacity" Value="0.45"/>
                            </MultiDataTrigger>

                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding DataContext.HasAnyCardSelected, RelativeSource={RelativeSource Self}}" Value="True"/>
                                    <Condition Binding="{Binding IsChecked, RelativeSource={RelativeSource Self}}" Value="False"/>
                                    <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True"/>
                                </MultiDataTrigger.Conditions>
                                <Setter TargetName="CardBody" Property="Effect" Value="{x:Null}"/>
                                <Setter TargetName="CardBody" Property="Opacity" Value="0.85"/>
                            </MultiDataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- [FIX:CARDS-DIM] MESMO visual do Segment, mas reagindo ao grupo da
             ESTRATÉGIA.
             =========================================================
             A linha Extrema / Equilibrado / Bateria é uma segunda decisão, em
             outro campo (`Strategy`), com o MESMO estilo visual. Não dá para
             reusar o estilo `Segment` como está: o gatilho dele escuta
             `HasAnyCardSelected`, e o resultado seria escolher um perfil de uso
             desbotar os três segmentos de prioridade — que nada tem a ver com
             aquilo. O inverso também: escolher a prioridade não pode mexer nos
             cards de uso.

             `BasedOn` não resolveria: o WPF não herda os gatilhos de um
             ControlTemplate, então qualquer condição nova exigiria reescrever o
             template inteiro de qualquer forma. A duplicação é o custo de ter
             dois grupos independentes, e o ganho é que cada um responde só ao
             seu próprio estado. -->
        <Style x:Key="SegmentStrategy" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="True"/>
            <Setter Property="Margin" Value="3,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Seg" Background="Transparent"
                                BorderBrush="#22FFFFFF" BorderThickness="1"
                                CornerRadius="10" Padding="10,8">
                            <ContentPresenter x:Name="CardBody" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Seg" Property="Background" Value="#12FFFFFF"/>
                                <Setter TargetName="Seg" Property="BorderBrush" Value="#3DFFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Seg" Property="Background" Value="#1CFFFFFF"/>
                                <Setter TargetName="Seg" Property="BorderBrush" Value="#598B31FF"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Seg" Property="BorderBrush" Value="#B0FFFFFF"/>
                            </Trigger>

                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding DataContext.HasAnyStrategySelected, RelativeSource={RelativeSource Self}}" Value="True"/>
                                    <Condition Binding="{Binding IsChecked, RelativeSource={RelativeSource Self}}" Value="False"/>
                                </MultiDataTrigger.Conditions>
                                <Setter TargetName="CardBody" Property="Effect">
                                    <Setter.Value>
                                        <BlurEffect Radius="2.8"/>
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="CardBody" Property="Opacity" Value="0.45"/>
                            </MultiDataTrigger>

                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding DataContext.HasAnyStrategySelected, RelativeSource={RelativeSource Self}}" Value="True"/>
                                    <Condition Binding="{Binding IsChecked, RelativeSource={RelativeSource Self}}" Value="False"/>
                                    <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True"/>
                                </MultiDataTrigger.Conditions>
                                <Setter TargetName="CardBody" Property="Effect" Value="{x:Null}"/>
                                <Setter TargetName="CardBody" Property="Opacity" Value="0.85"/>
                            </MultiDataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid x:Name="PageRoot">
        <!-- Fundo IDÊNTICO ao Dashboard: raiz transparente (o acrylic da
             MainWindow aparece por trás) + os mesmos dois brilhos radiais
             com as mesmas medidas, cores e opacidades. O Dashboard NÃO tem
             superfície opaca nenhuma — pintar um Border com
             WindowBackgroundBrush aqui era o que deixava esta página com
             cara diferente da tela inicial. -->
        <Grid IsHitTestVisible="False" ClipToBounds="True">
            <Ellipse Width="600" Height="600"
                     HorizontalAlignment="Left" VerticalAlignment="Top"
                     Margin="-200,-200,0,0" Opacity="0.08">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#3b82f6" Offset="0"/>
                        <GradientStop Color="Transparent" Offset="1"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
            <Ellipse Width="500" Height="500"
                     HorizontalAlignment="Right" VerticalAlignment="Bottom"
                     Margin="0,0,-150,-150" Opacity="0.06">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#8B31FF" Offset="0"/>
                        <GradientStop Color="Transparent" Offset="1"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>

            <!-- Orbes de névoa e poeira: a MESMA técnica do Dashboard
                 (DashboardView.xaml:464-460, ifOrb1..4 / ifSp1..5).
                 Sem eles o acrylic aparecia "limpo" e a página ficava com cara
                 de painel plano ao lado do Dashboard, que tem névoa viva.

                 CacheMode="BitmapCache" é obrigatório: BlurEffect é
                 rasterizado em software no WPF, e sem cache um orbe que se
                 move a cada quadro refaria o blur 60x por segundo. O cache
                 calcula o blur uma vez e o RenderTransform continua valendo
                 depois — o orbe se move igual, só que barato. -->
            <Grid>
                <Grid.Triggers>
                    <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="pOrb1" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" From="-34" To="34" Duration="0:0:16" AutoReverse="True" RepeatBehavior="Forever" BeginTime="-0:0:3"/>
                                <DoubleAnimation Storyboard.TargetName="pOrb1" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" From="-18" To="18" Duration="0:0:21" AutoReverse="True" RepeatBehavior="Forever" BeginTime="-0:0:7"/>
                                <DoubleAnimation Storyboard.TargetName="pOrb2" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" From="28" To="-28" Duration="0:0:19" AutoReverse="True" RepeatBehavior="Forever" BeginTime="-0:0:5"/>
                                <DoubleAnimation Storyboard.TargetName="pOrb2" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" From="-12" To="12" Duration="0:0:24" AutoReverse="True" RepeatBehavior="Forever" BeginTime="-0:0:11"/>
                                <DoubleAnimation Storyboard.TargetName="pDust1" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" From="-26" To="30" Duration="0:0:13" AutoReverse="True" RepeatBehavior="Forever" BeginTime="-0:0:2"/>
                                <DoubleAnimation Storyboard.TargetName="pDust1" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" From="-12" To="14" Duration="0:0:15" AutoReverse="True" RepeatBehavior="Forever" BeginTime="-0:0:9"/>
                                <DoubleAnimation Storyboard.TargetName="pDust2" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" From="22" To="-26" Duration="0:0:11" AutoReverse="True" RepeatBehavior="Forever" BeginTime="-0:0:4"/>
                                <DoubleAnimation Storyboard.TargetName="pDust2" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" From="10" To="-16" Duration="0:0:17" AutoReverse="True" RepeatBehavior="Forever" BeginTime="-0:0:12"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </Grid.Triggers>

                <Ellipse x:Name="pOrb1" CacheMode="BitmapCache" Width="96" Height="88" Opacity="0.15"
                         HorizontalAlignment="Left" VerticalAlignment="Top" Margin="34,120,0,0">
                    <Ellipse.Effect><BlurEffect Radius="30"/></Ellipse.Effect>
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="#FF22D3EE" Offset="0"/>
                            <GradientStop Color="#5522D3EE" Offset="0.5"/>
                            <GradientStop Color="#0022D3EE" Offset="1"/>
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                    <Ellipse.RenderTransform><TranslateTransform/></Ellipse.RenderTransform>
                </Ellipse>

                <Ellipse x:Name="pOrb2" CacheMode="BitmapCache" Width="84" Height="80" Opacity="0.13"
                         HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,58,120">
                    <Ellipse.Effect><BlurEffect Radius="28"/></Ellipse.Effect>
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="#FF8B5CF6" Offset="0"/>
                            <GradientStop Color="#558B5CF6" Offset="0.5"/>
                            <GradientStop Color="#008B5CF6" Offset="1"/>
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                    <Ellipse.RenderTransform><TranslateTransform/></Ellipse.RenderTransform>
                </Ellipse>

                <Ellipse x:Name="pDust1" Width="10" Height="10" Fill="#66FFFFFF" Opacity="0.3"
                         HorizontalAlignment="Left" VerticalAlignment="Top" Margin="150,230,0,0">
                    <Ellipse.RenderTransform><TranslateTransform/></Ellipse.RenderTransform>
                </Ellipse>

                <Ellipse x:Name="pDust2" Width="7" Height="7" Fill="#6699FF" Opacity="0.28"
                         HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,180,120,0">
                    <Ellipse.RenderTransform><TranslateTransform/></Ellipse.RenderTransform>
                </Ellipse>
            </Grid>
        </Grid>

        <Grid Margin="24,10,24,8">
                <!-- Brilhos de fundo, atrás de tudo. -->
                <Grid IsHitTestVisible="False" ClipToBounds="True">
                    <Ellipse Width="340" Height="280" HorizontalAlignment="Left" VerticalAlignment="Top"
                             Margin="-110,-100,0,0" Fill="{StaticResource GlowPink}" Opacity="0.22"/>
                    <Ellipse Width="300" Height="260" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                             Margin="0,0,-90,-90" Fill="{StaticResource GlowPurple}" Opacity="0.18"/>
                </Grid>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- ============ CABEÇALHO (centralizado) ============
                         Antes: logo à esquerda e textos ao lado, com o bloco
                         inteiro ancorado à esquerda. Agora o logo, o título e o
                         subtítulo formam UM grupo centralizado, empilhado —
                         leitura mais limpa e título no eixo da página. -->
                    <StackPanel Grid.Row="0" x:Name="HeaderPanel"
                                HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Border Width="36" Height="36" CornerRadius="11"
                                Background="{StaticResource BrandGradient}"
                                HorizontalAlignment="Center">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="14" ShadowDepth="0" Opacity="0.45" Color="#8B31FF"/>
                            </Border.Effect>
                            <Path Data="M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2M12,4A8,8 0 0,1 20,12A8,8 0 0,1 12,20A8,8 0 0,1 4,12A8,8 0 0,1 12,4M13,14H11V10H13M13,18H11V16H13M19,13H5V11H19M19,15H5V17H19M21,12V14H23V12M1,12V14H3V12"
                                  Fill="White" Width="18" Height="18" Stretch="Uniform"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <TextBlock Text="{Binding [ProfilerPageTitle], Source={x:Static services:LocalizationService.Instance}}"
                                   FontSize="17" FontWeight="Bold" Foreground="#F5F7FC"
                                   TextAlignment="Center" Margin="0,6,0,0"/>
                        <TextBlock Text="{Binding [ProfilerPageSubtitle], Source={x:Static services:LocalizationService.Instance}}"
                                   FontSize="11" Foreground="#8F9BAE" TextWrapping="Wrap"
                                   TextAlignment="Center" MaxWidth="620" HorizontalAlignment="Center"
                                   Margin="0,3,0,0" LineHeight="15"/>
                    </StackPanel>

                    <!-- ============ CONTEÚDO ============ -->
                    <Grid Grid.Row="1" Margin="0,10,0,0" x:Name="ContentRoot">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="264" x:Name="VorlokColumn"/>
                        </Grid.ColumnDefinitions>

                        <!-- Coluna principal.
                             O ScrollViewer resolve os dois problemas de uma vez:
                             - HorizontalScrollBarVisibility="Disabled" TRAVA a
                               largura do conteúdo na do viewport, o que impede a
                               página de ultrapassar a janela (era isso que
                               cortava o painel do Vorlok e o botão).
                             - VerticalScrollBarVisibility="Auto" deixa os
                               cards tiverem a ALTURA NATURAL, com MinHeight,
                               em vez de serem espremidos em linhas "*". Texto
                               cortado some, e em tela grande não aparece barra
                               nenhuma. -->
                        <!-- [FIX:NO-SCROLLVIEWER] A COLUNA PRINCIPAL NÃO ROLA MAIS
                             ================================================
                             Havia um `ScrollViewer` embrulhando `MainColumn`, e ele
                             era a CAUSA de o layout não caber — não a solução.

                             UM `ScrollViewer` ENTREGA ALTURA INFINITA ao conteúdo.
                             Com isso, a linha `*` do `MainColumn` não tem sobra
                             nenhuma para absorver: ela resolve para o conteúdo. E
                             o `UniformGrid` dos cards, que reparte a altura
                             disponível entre as linhas, recebia essa folga
                             infinita e CRESCIA. O efeito observável: os cards
                             inflavam, o bloco de estratégia era empurrado para
                             fora da tela, e o botão "Aplicar e continuar"
                             ficava escondido atrás da barra de rolagem.

                             Sem `ScrollViewer`, `MainColumn` recebe a altura
                             DEFINIDA de `ContentRoot`. A linha `*` volta a
                             absorver a sobra de verdade, os cards voltam à altura
                             natural, e a página cabe sem rolar.

                             A rolagem só "funcionava" porque a linha de ação ficava
                             na linha 2 do `PageRoot`, fora do `ContentRoot`, e
                             era espremida contra a borda. Com a linha de ação
                             dentro da coluna principal (linha 4), o conteúdo cabe
                             de fato e a rolagem deixou de ser necessária. -->
                        <Grid Margin="0,0,16,0">
                            <!-- [FIX:LAYOUT-FILL] A COLUNA PRINCIPAL VIRA GRID
                                 =========================================
                                 ANTES a coluna principal era um `StackPanel` com
                                 altura natural dentro do `ScrollViewer`. Todo bloco
                                 ocupava só o próprio tamanho e oSobrante ficava
                                 vazio no rodapé — com a página parecendo "cortada
                                 pela metade", e o botão de confirmar, que fica
                                 depois, empurrado para fora da dobra.

                                 AGORA são três linhas:

                                   linha 0  `*`    título + os 6 cards
                                   linha 1  Auto   sub-escolha gamer (condicional)
                                   linha 2  Auto   estratégia

                                 A linha 0 é a única que estica, e o que ela
                                 absorve é o ESPAÇO SOBRANTE — os cards crescem
                                 até o limite e o rodapé deixa de ser um buraco.

                                 POR QUE ISSO NÃO ESPREME O TEXTO, AO CONTRÁRIO
                                 DO QUE A AUSÊNCIA DE `*` JÁ TINHA FEITO
                                 =================================================================
                                 O `MinHeight="70"` do `ProfileCard` continua valendo,
                                 então a linha 0 nunca fica menor que a soma das
                                 alturas mínimas: os cards encolhem até o piso e
                                 param. Acima disso, crescem.

                                 E o conteúdo do card é um `Grid` com
                                 `VerticalAlignment="Center"` nos blocos, então um
                                 card mais alto cresce pelo CENTRO — o texto não
                                 encosta na borda e não é cortado. O problema
                                 histórico de linhas `*` era espremer conteúdo
                                 abaixo do mínimo, e o `MinHeight` resolve
                                 exatamente isso.

                                 A linha 1 é `Auto` e não `*` de propósito: a
                                 sub-escolha gamer só existe quando o card gamer
                                 está marcado. Se fosse `*`, ela apareceria com
                                 meia altura quando aparecesse, e o bloco de
                                 estratégia saltaria a cada clique. `Auto` mantém
                                 a página estável. -->
