<Application x:Class="VoltrisOptimizer.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:VoltrisOptimizer.UI.ViewModels">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/UI/Themes/Colors.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/UI/Themes/Converters.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/UI/Themes/Icons.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/UI/Themes/DriverIcons.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/UI/Themes/VoltrisDesignSystem.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/UI/Themes/DarkTheme.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/UI/Themes/TransparencyOn.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/UI/Themes/Styles.xaml"/>
                <!-- [FIX:TOOLTIP-BRANCO] Fica DEPOIS de Styles.xaml de propósito:
                     um estilo implícito só vale se for o último a definir o
                     TargetType. Se viesse antes, Styles.xaml (ou DarkTheme) poderia
                     sobrescrever e o tooltip voltaria ao branco do WPF. -->
                <ResourceDictionary Source="pack://application:,,,/UI/Themes/ToolTipTheme.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/UI/Themes/SidebarPremium.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <vm:ViewModelLocator x:Key="Locator" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
