<Window x:Class="VoltrisUpdater.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:services="clr-namespace:VoltrisUpdater.Services"
        Title="Voltris Updater"
        Width="500" Height="360"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen">
    
    <Window.Resources>
        <!-- Cores Oficiais do Voltris Optimizer -->
        <LinearGradientBrush x:Key="VoltrisGradient" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#FF4B6B" Offset="0"/>
            <GradientStop Color="#8B31FF" Offset="0.5"/>
            <GradientStop Color="#31A8FF" Offset="1"/>
        </LinearGradientBrush>
    </Window.Resources>

    <Border CornerRadius="16" Background="#0B0B10" BorderThickness="1" BorderBrush="#1F1F2E">
        <Border.Effect>
            <DropShadowEffect BlurRadius="40" ShadowDepth="5" Color="Black" Opacity="0.9"/>
        </Border.Effect>
        
        <Grid>
            <!-- Atmospheric Glows Modernos (Enterprise) -->
            <Ellipse Width="400" Height="400" Fill="#128B31FF" Margin="-150,-200,0,0" HorizontalAlignment="Left" VerticalAlignment="Top">
                <Ellipse.Effect>
                    <BlurEffect Radius="140"/>
                </Ellipse.Effect>
            </Ellipse>
            
            <Ellipse Width="400" Height="400" Fill="#10FF4B6B" Margin="0,-200,-150,0" HorizontalAlignment="Right" VerticalAlignment="Top">
                <Ellipse.Effect>
                    <BlurEffect Radius="140"/>
                </Ellipse.Effect>
            </Ellipse>

            <Grid Margin="40,35,40,35">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header Logo Section (Centralizado) -->
                <StackPanel Grid.Row="0" Margin="0,0,0,25" HorizontalAlignment="Center">
                    <TextBlock Text="V O L T R I S   O P T I M I Z E R" Foreground="{StaticResource VoltrisGradient}" FontWeight="Black" FontSize="13" Margin="0,0,0,8" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="UpdaterTitle" Text="{Binding [UpdaterTitle], Source={x:Static services:LocalizationService.Instance}}" Foreground="White" FontSize="24" FontWeight="SemiBold" HorizontalAlignment="Center" FontFamily="Segoe UI Variable Display, Segoe UI"/>
                </StackPanel>

                <!-- Info Display (Premium Background) -->
                <Border Grid.Row="1" Background="#14141E" CornerRadius="12" Padding="25" BorderBrush="#1C1C28" BorderThickness="1">
                    <StackPanel x:Name="ContentPanel" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock x:Name="StatusText" 
                                   Text="{Binding [WaitingAppClose], Source={x:Static services:LocalizationService.Instance}}" 
                                   FontSize="15" Foreground="#E0E0E5" 
                                   HorizontalAlignment="Center" TextAlignment="Center"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <!-- Professional Progress Section -->
                <StackPanel Grid.Row="2" Margin="0,30,0,0">
                    <Grid Margin="0,0,0,12">
                        <TextBlock x:Name="StepLabel" Text="{Binding [Preparing], Source={x:Static services:LocalizationService.Instance}}" FontSize="12" Foreground="#8A8A9D" FontWeight="Medium"/>
                        <TextBlock x:Name="PercentLabel" Text="0%" FontSize="13" Foreground="White" FontWeight="Bold" HorizontalAlignment="Right"/>
                    </Grid>
                    
                    <Border Background="#161622" CornerRadius="4" Height="6" BorderBrush="#111119" BorderThickness="1">
                        <Border x:Name="ProgressBar" 
                                HorizontalAlignment="Left" 
                                Width="0"
                                CornerRadius="3"
                                Background="{StaticResource VoltrisGradient}">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="12" ShadowDepth="0" Color="#8B31FF" Opacity="0.5"/>
                            </Border.Effect>
                        </Border>
                    </Border>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
