  <!-- REMOVIDO: distribuição do WinRing0 (WinRing0\**). O driver de kernel não assinado
       era a causa principal da quarentena do antivírus (HackTool:Win32/WinRing0).
       O backend seguro substitui: Services\Performance\CpuTuning\Core\Backends\SafeFallbackBackend.cs -->
  <Target Name="SignOutputBinaries" AfterTargets="Build" Condition="'$(Configuration)' == 'Release' and '$(EnableAuthenticodeSigning)' == 'true'">
    <ItemGroup>
      <_VoltrisFilesToSign Include="$(TargetDir)$(AssemblyName).exe" />
      <_VoltrisFilesToSign Include="$(TargetDir)$(AssemblyName).dll" />
      <_VoltrisFilesToSign Include="$(TargetDir)RecoveryEngine\*.dll" Condition="Exists('$(TargetDir)RecoveryEngine')" />
      <_VoltrisFilesToSign Include="$(TargetDir)DriverEngine\*.dll" Condition="Exists('$(TargetDir)DriverEngine')" />
    </ItemGroup>
    <Message Importance="high" Text="[Signing] Authenticode habilitado. Assinando artefatos do Voltris..." />
    <Error Condition="'$(SignToolPath)' == ''" Text="[Signing] SignToolPath não informado." />
    <Error Condition="'$(AuthenticodePfxPath)' == ''" Text="[Signing] AuthenticodePfxPath não informado." />
    <Error Condition="'$(AuthenticodePfxPassword)' == ''" Text="[Signing] AuthenticodePfxPassword não informado." />
    <Exec Command="&quot;$(SignToolPath)&quot; sign /fd SHA256 /f &quot;$(AuthenticodePfxPath)&quot; /p &quot;$(AuthenticodePfxPassword)&quot; /tr &quot;$(AuthenticodeTimestampUrl)&quot; /td SHA256 &quot;%(FullPath)&quot;" StandardOutputImportance="high" StandardErrorImportance="high" />
  </Target>
  <!-- ==========================================================================
       EMBUTIR O MANIFESTO DE EXECUÇÃO (elevação)
       ==========================================================================
       POR QUE ISTO É NECESSÁRIO:
       <ApplicationManifest>app.manifest</ApplicationManifest> NÃO é honrado pelo
       SDK do .NET (verificado com um projeto mínimo em .NET 8: o executável
       gerado não contém a string "requireAdministrator"). A propriedade é uma
       herança do .NET Framework, e no .NET Core/5+ simplesmente não chega ao
       compilador. Ou seja: o VOLTRIS NUNCA foi elevado, apesar do manifesto
       declarar requireAdministrator.

       CONSEQUÊNCIA REAL, MEDIDA NESTA MÁQUINA (i5-1135G7 + Iris Xe):
         - LibreHardwareMonitor não carrega driver de kernel  -> sem temperatura de die
         - MSAcpi_ThermalZoneTemperature (root\WMI)          -> "Acesso negado"
       As duas fontes que funcionavam dependiam de elevação, então a temperatura
       aparecia como "N/D" em máquinas comuns. (Existe uma fonte alternativa sem
       elevação — contador "Thermal Zone Information" — agora ligada em
       SystemMetricsCache, mas elevar o app é o estado correto: quase todo o resto
       do VOLTRIS também precisa de administrador.)

       COMO FUNCIONA:
       Usa mt.exe do Windows SDK. Se o SDK não estiver instalado, apenas AVISA e
       não quebra o build — o manifesto é desejável, não obrigatório para compilar.
       ======================================================================= -->
  <Target Name="EmbedApplicationManifest" AfterTargets="Build" BeforeTargets="SignOutputBinaries" Condition="'$(OS)' == 'Windows_NT'">
    <PropertyGroup>
      <_VoltrisTargetExe>$(TargetDir)$(AssemblyName).exe</_VoltrisTargetExe>
      <_VoltrisMtExe Condition="'$(WindowsSdkDir)' != '' AND Exists('$(WindowsSdkDir)bin\$(MTArchitecture)\mt.exe')">$(WindowsSdkDir)bin\$(MTArchitecture)\mt.exe</_VoltrisMtExe>
    </PropertyGroup>
    <!-- Descoberta do mt.exe: Windows SDK primeiro, depois qualquer mt.exe no PATH. -->
    <ItemGroup Condition="'$(_VoltrisMtExe)' == ''">
      <_VoltrisMtCandidate Include="$(WindowsSdkDir)bin\10.*\x64\mt.exe" />
      <_VoltrisMtCandidate Include="$(WindowsSdkVerBinPath)10.*\x64\mt.exe" />
      <_VoltrisMtCandidate Include="C:\Program Files (x86)\Windows Kits\10\bin\10.*\x64\mt.exe" />
      <_VoltrisMtCandidate Include="C:\Program Files\Windows Kits\10\bin\10.*\x64\mt.exe" />
    </ItemGroup>
    <PropertyGroup Condition="'$(_VoltrisMtExe)' == '' And '@(_VoltrisMtCandidate)' != ''">
      <_VoltrisMtExe>%(_VoltrisMtCandidate.FullPath)</_VoltrisMtExe>
    </PropertyGroup>
    <Warning Condition="'$(_VoltrisMtExe)' == ''" Text="[Manifest] mt.exe do Windows SDK não encontrado. O executável será gerado SEM requireAdministrator; sensores que exigem elevação (LibreHardwareMonitor, MSAcpi_ThermalZoneTemperature) ficarão indisponíveis. Instale o Windows SDK ou execute como administrador." />
    <Warning Condition="'$(_VoltrisMtExe)' != '' AND !Exists('$(_VoltrisTargetExe)')" Text="[Manifest] Executável não encontrado em $(_VoltrisTargetExe); manifesto não será embutido." />
    <Exec Condition="'$(_VoltrisMtExe)' != '' AND Exists('$(_VoltrisTargetExe)')" Command="&quot;$(_VoltrisMtExe)&quot; -nologo -manifest &quot;$(MSBuildProjectDirectory)\app.manifest&quot; -outputresource:&quot;$(_VoltrisTargetExe)&quot;#1" StandardOutputImportance="high" StandardErrorImportance="high" ContinueOnError="true" />
  </Target>
