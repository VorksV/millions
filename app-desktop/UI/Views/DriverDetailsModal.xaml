<UserControl xmlns:services="clr-namespace:VoltrisOptimizer.Services" x:Class="VoltrisOptimizer.UI.Views.DriverDetailsModal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Background="Transparent"
             UseLayoutRounding="True" SnapsToDevicePixels="True"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType">

    <UserControl.Resources>
        <!-- Converters Padrão WPF -->
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        
        <!-- Design System IGUAL ao DriversView -->
        <Style x:Key="DCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource BgCardGlass}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderLight}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="20"/>
        </Style>

        <Style x:Key="SecTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource DefaultTextBrush}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>

        <Style x:Key="ABtn" TargetType="Button">
            <Setter Property="Background" Value="#1AFFFFFF"/>
            <Setter Property="Foreground" Value="{DynamicResource DefaultTextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderLight}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#2AFFFFFF"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#31A8FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PBtn" TargetType="Button" BasedOn="{StaticResource ABtn}">
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#4B6BFF" Offset="0"/>
                        <GradientStop Color="#8B31FF" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
    </UserControl.Resources>
    
    <!-- Fundo com transparência dinâmica -->
    <Grid x:Name="MainGrid" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
        <!-- Fundo escurecido com efeito de blur -->
        <Grid.Background>
            <SolidColorBrush Color="#000000" Opacity="0.6"/>
        </Grid.Background>
        
        <!-- Container principal -->
        <Border x:Name="ModalContainer"
                HorizontalAlignment="Center" 
                VerticalAlignment="Center"
                Width="600" 
                Background="{DynamicResource BgCard}"
                BorderBrush="{DynamicResource BorderLight}"
                BorderThickness="1"
                CornerRadius="16"
                Padding="20">
            
            <Grid Margin="24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Cabeçalho -->
                <Grid Grid.Row="0" Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding [Loc_DriverDetails], Source={x:Static services:LocalizationService.Instance}}" 
                                   FontSize="18" 
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource DefaultTextBrush}"/>
                        <TextBlock x:Name="DriverNameText" 
                                   Text="{Binding [Loc_Loading], Source={x:Static services:LocalizationService.Instance}}" 
                                   FontSize="14" 
                                   Foreground="{DynamicResource DefaultTextBrush}"
                                   Margin="0,4,0,0"/>
                        <TextBlock Text="{Binding [Loc_StatusUpdateAvailable], Source={x:Static services:LocalizationService.Instance}}" 
                                   FontSize="12" 
                                   Foreground="#FFAA00"
                                   Margin="0,2,0,0"/>
                    </StackPanel>
                    
                    <!-- Botão fechar -->
                    <Button Grid.Column="1" 
                            x:Name="CloseButton"
                            Width="32" 
                            Height="32"
                            Background="Transparent"
                            BorderThickness="0"
                            Cursor="Hand"
                            Click="CloseButton_Click">
                        <Path Data="M19,6.41L17.59,5L12,10.59L6.41,5L5,6.41L10.59,12L5,17.59L6.41,19L12,13.41L17.59,19L19,17.59L13.41,12L19,6.41Z" Fill="{DynamicResource DefaultTextBrush}" Width="14" Height="14" Stretch="Uniform"/>
                    </Button>
                </Grid>

                <!-- Conteúdo com ScrollViewer -->
                <ScrollViewer Grid.Row="1" 
                              VerticalScrollBarVisibility="Auto" 
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <!-- Status do Driver -->
                        <Border Background="Transparent" 
                                BorderBrush="{DynamicResource BorderLight}" 
                                BorderThickness="1"
                                CornerRadius="12" 
                                Padding="16"
                                Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="{Binding [Loc_CurrentStatus], Source={x:Static services:LocalizationService.Instance}}" Style="{StaticResource SecTitle}"/>
                                <TextBlock Text="{Binding [Loc_VersionInstalledAndAvailableFor], Source={x:Static services:LocalizationService.Instance}}" 
                                           FontSize="12" 
                                           FontWeight="Medium"
                                           Foreground="{DynamicResource DefaultTextBrush}"/>
                                
                                <Border HorizontalAlignment="Left" 
                                        CornerRadius="20" 
                                        Padding="12,6"
                                        Background="#FFAA00"
                                        Margin="0,8,0,0">
                                    <TextBlock Text="{Binding [Loc_UpdateAvailable], Source={x:Static services:LocalizationService.Instance}}" 
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               FontSize="12"/>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Informações de Versão -->
                        <Border Background="Transparent" 
                                BorderBrush="{DynamicResource BorderLight}" 
                                BorderThickness="1"
                                CornerRadius="12" 
                                Padding="16"
                                Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="{Binding [Loc_VersionInformation], Source={x:Static services:LocalizationService.Instance}}" Style="{StaticResource SecTitle}"/>
                                
                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="20"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <!-- Versão Atual -->
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding [Loc_CurrentVersion], Source={x:Static services:LocalizationService.Instance}}" 
                                                   FontSize="12" 
                                                   FontWeight="Medium"
                                                   Foreground="{DynamicResource DefaultTextBrush}"/>
                                        <TextBlock x:Name="CurrentVersionText" 
                                                   Text="--" 
                                                   FontSize="14" 
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource DefaultTextBrush}"/>
                                        <TextBlock Text="{Binding [Loc_Installed], Source={x:Static services:LocalizationService.Instance}}" 
                                                   FontSize="11" 
                                                   Foreground="{DynamicResource DefaultTextBrush}"
                                                   Opacity="0.7"
                                                   TextAlignment="Right"/>
                                    </StackPanel>
                                    
                                    <!-- Versão Nova -->
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="{Binding [Loc_NewVersion], Source={x:Static services:LocalizationService.Instance}}" 
                                                   FontSize="12" 
                                                   FontWeight="Medium"
                                                   Foreground="{DynamicResource DefaultTextBrush}"/>
                                        <TextBlock x:Name="NewVersionText" 
                                                   Text="--" 
                                                   FontSize="14" 
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource DefaultTextBrush}"/>
                                        <TextBlock Text="{Binding [Loc_Available], Source={x:Static services:LocalizationService.Instance}}" 
                                                   FontSize="11" 
                                                   Foreground="#FFAA00"
                                                   TextAlignment="Right"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Informações do Fabricante -->
                        <Border Background="Transparent" 
                                BorderBrush="{DynamicResource BorderLight}" 
                                BorderThickness="1"
                                CornerRadius="12" 
                                Padding="16"
                                Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="{Binding [Loc_ManufacturerInformation], Source={x:Static services:LocalizationService.Instance}}" Style="{StaticResource SecTitle}"/>
                                
                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding [Loc_Manufacturer], Source={x:Static services:LocalizationService.Instance}}" 
                                                   FontSize="12" 
                                                   FontWeight="Medium"
                                                   Foreground="{DynamicResource DefaultTextBrush}"/>
                                        <TextBlock x:Name="VendorNameText" 
                                                   Text="--" 
                                                   FontSize="14" 
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource DefaultTextBrush}"/>
                                    </StackPanel>
                                    
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding [Loc_ReasonForUpdate], Source={x:Static services:LocalizationService.Instance}}" 
                                                   FontSize="12" 
                                                   FontWeight="Medium"
                                                   Foreground="{DynamicResource DefaultTextBrush}"/>
                                        <TextBlock Text="{Binding [Loc_PerformanceAndSecurityImprovement], Source={x:Static services:LocalizationService.Instance}}" 
                                                   FontSize="14" 
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource DefaultTextBrush}"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Informações Adicionais -->
                        <Border Background="Transparent" 
                                BorderBrush="{DynamicResource BorderLight}" 
                                BorderThickness="1"
                                CornerRadius="12" 
                                Padding="16"
                                Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="{Binding [Loc_AdditionalInformation], Source={x:Static services:LocalizationService.Instance}}" Style="{StaticResource SecTitle}"/>
                                
                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding [Loc_FileSize], Source={x:Static services:LocalizationService.Instance}}" 
                                                   FontSize="12" 
                                                   FontWeight="Medium"
                                                   Foreground="{DynamicResource DefaultTextBrush}"/>
                                        <TextBlock x:Name="FileSizeText" 
                                                   Text="--" 
                                                   FontSize="14" 
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource DefaultTextBrush}"/>
                                    </StackPanel>
                                    
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding [Loc_OfficialSource], Source={x:Static services:LocalizationService.Instance}}" 
                                                   FontSize="12" 
                                                   FontWeight="Medium"
                                                   Foreground="{DynamicResource DefaultTextBrush}"/>
                                        <Button Content="{Binding [Loc_OpenOfficialWebsite], Source={x:Static services:LocalizationService.Instance}}" 
                                                Style="{StaticResource ABtn}"
                                                Padding="8,4"
                                                FontSize="11"
                                                Cursor="Hand"
                                                Click="OpenSourceButton_Click"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Changelog -->
                        <Border Background="Transparent" 
                                BorderBrush="{DynamicResource BorderLight}" 
                                BorderThickness="1"
                                CornerRadius="12" 
                                Padding="16">
                            <StackPanel>
                                <TextBlock Text="{Binding [Loc_ReleaseNotes], Source={x:Static services:LocalizationService.Instance}}" Style="{StaticResource SecTitle}"/>
                                <TextBlock x:Name="ReleaseNotesText" 
                                           Text="{Binding [Loc_NoChangelogInformationAvailable], Source={x:Static services:LocalizationService.Instance}}" 
                                           FontSize="12" 
                                           FontWeight="Medium"
                                           Foreground="{DynamicResource DefaultTextBrush}"
                                           TextWrapping="Wrap"
                                           LineHeight="18"
                                           Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- Botões de Ação -->
                <StackPanel Grid.Row="2" 
                           Orientation="Horizontal" 
                           HorizontalAlignment="Right"
                           Margin="0,16,0,0">
                    <Button x:Name="InstallButton"
                            Content="{Binding [Loc_DownloadAndInstall], Source={x:Static services:LocalizationService.Instance}}"
                            Style="{StaticResource PBtn}"
                            Padding="16,8"
                            Margin="0,0,8,0"
                            FontSize="13"
                            Click="InstallButton_Click"/>
                    
                    <Button x:Name="CancelButton"
                            Content="{Binding [Loc_Cancel], Source={x:Static services:LocalizationService.Instance}}"
                            Style="{StaticResource ABtn}"
                            Padding="16,8"
                            FontSize="13"
                            Click="CancelButton_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
