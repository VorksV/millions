                            <Border Style="{StaticResource KeyBadgeStyle}"><TextBlock Text="CTRL" Foreground="#CCD6DC" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center"/></Border>
                            <TextBlock Text="+" Style="{StaticResource PlusStyle}"/>
                            <Border Style="{StaticResource KeyBadgeStyle}"><TextBlock Text="ALT" Foreground="#CCD6DC" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center"/></Border>
                            <TextBlock Text="+" Style="{StaticResource PlusStyle}"/>
                            <Border Style="{StaticResource KeyBadgeStyle}" Background="#1A3B82F6" BorderBrush="#333B82F6"><TextBlock Text="E" Foreground="#3B82F6" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center"/></Border>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Footer -->
                <TextBlock Text="{Binding [ShortcutsFooter], Source={x:Static services:LocalizationService.Instance}}"
                          FontSize="11" Foreground="#64748B" HorizontalAlignment="Center" Margin="0,8,0,0"
                          TextWrapping="Wrap" TextAlignment="Center"/>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Grid>
</UserControl>
