<UserControl xmlns:services="clr-namespace:VoltrisOptimizer.Services" x:Class="VoltrisOptimizer.UI.Views.ShortcutsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource DarkBrush}">
    <UserControl.DataContext>
        <Binding Source="{StaticResource Locator}" Path="ShortcutsVM" />
    </UserControl.DataContext>

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/UI/Themes/Converters.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <Color x:Key="C1">#F59E0B</Color>
            <Color x:Key="C2">#10B981</Color>
            <Color x:Key="C3">#8B5CF6</Color>
            <Color x:Key="C4">#3B82F6</Color>

            <Style x:Key="GlassCardStyle" TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource BgCardGlass}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource BorderLight}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="14"/>
                <Setter Property="Padding" Value="14,8"/>
                <Setter Property="Margin" Value="0,0,0,8"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="BorderBrush" Value="{DynamicResource BorderAccent}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="SectionHeaderStyle" TargetType="StackPanel">
                <Setter Property="Orientation" Value="Horizontal"/>
                <Setter Property="Margin" Value="0,4,0,10"/>
            </Style>

            <Style x:Key="SectionIconStyle" TargetType="Border">
                <Setter Property="Width" Value="30"/>
                <Setter Property="Height" Value="30"/>
                <Setter Property="CornerRadius" Value="8"/>
                <Setter Property="Margin" Value="0,0,10,0"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>

            <Style x:Key="KeyBadgeStyle" TargetType="Border">
                <Setter Property="Background" Value="#1AFFFFFF"/>
                <Setter Property="BorderBrush" Value="#33FFFFFF"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="6"/>
                <Setter Property="Padding" Value="10,4"/>
                <Setter Property="Margin" Value="0,0,5,0"/>
                <Setter Property="MinWidth" Value="32"/>
                <Setter Property="Height" Value="28"/>
            </Style>

            <Style x:Key="PlusStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="#667788"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="Margin" Value="0,0,5,0"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>

            <!-- Icon geometries -->
            <Geometry x:Key="IconGamepad">M21,6H3C1.9,6,1,6.9,1,8v8c0,1.1,0.9,2,2,2h18c1.1,0,2-0.9,2-2V8C23,6.9,22.1,6,21,6z M6,15c-1.1,0-2-0.9-2-2s0.9-2,2-2s2,0.9,2,2S7.1,15,6,15z M13,10h-2v2h-2v-2H7V8h2V6h2v2h2V10z M18,15c-1.1,0-2-0.9-2-2s0.9-2,2-2s2,0.9,2,2S19.1,15,18,15z</Geometry>
            <Geometry x:Key="IconEye">M12,4.5C7,4.5,2.73,7.61,1,12c1.73,4.39,6,7.5,11,7.5s9.27-3.11,11-7.5C21.27,7.61,17,4.5,12,4.5z M12,17c-2.76,0-5-2.24-5-5s2.24-5,5-5s5,2.24,5,5S14.76,17,12,17z M12,9c-1.66,0-3,1.34-3,3s1.34,3,3,3s3-1.34,3-3S13.66,9,12,9z</Geometry>
            <Geometry x:Key="IconCleanup">M19.5,8.5l-1.23-2.63L15.65,4.65c-0.27-0.06-0.54,0.15-0.6,0.42c-0.01,0.06-0.01,0.12,0,0.18l1.23,2.63l2.63,1.23c0.27,0.06,0.54-0.15,0.6-0.42C19.56,8.63,19.54,8.56,19.5,8.5z M14.5,12.5l-1.23-2.63L10.65,8.65c-0.27-0.06-0.54,0.15-0.6,0.42c-0.01,0.06-0.01,0.12,0,0.18l1.23,2.63l2.63,1.23c0.27,0.06,0.54-0.15,0.6-0.42C14.56,12.63,14.54,12.56,14.5,12.5z M7.5,14.5L6.27,11.87L3.65,10.65c-0.27-0.06-0.54,0.15-0.6,0.42c-0.01,0.06-0.01,0.12,0,0.18l1.23,2.63L6.9,16.51c0.27,0.06,0.54-0.15,0.6-0.42C7.56,16.03,7.54,15.96,7.5,14.5z</Geometry>
            <Geometry x:Key="IconGear">M19.14,12.94c0.04-0.3,0.06-0.61,0.06-0.94c0-0.32-0.02-0.64-0.07-0.94l2.03-1.58c0.18-0.14,0.23-0.41,0.12-0.61l-1.92-3.32c-0.12-0.22-0.37-0.29-0.59-0.22l-2.39,0.96c-0.5-0.38-1.03-0.7-1.62-0.94L14.4,2.81c-0.04-0.24-0.24-0.41-0.48-0.41h-3.84c-0.24,0-0.43,0.17-0.47,0.41L9.25,5.35C8.66,5.59,8.12,5.92,7.63,6.29L5.24,5.33c-0.22-0.08-0.47,0-0.59,0.22L2.74,8.87C2.62,9.08,2.66,9.34,2.86,9.48l2.03,1.58C4.84,11.36,4.8,11.69,4.8,12s0.02,0.64,0.07,0.94l-2.03,1.58c-0.18,0.14-0.23,0.41-0.12,0.61l1.92,3.32c0.12,0.22,0.37,0.29,0.59,0.22l2.39-0.96c0.5,0.38,1.03,0.7,1.62,0.94l0.36,2.54c0.05,0.24,0.24,0.41,0.48,0.41h3.84c0.24,0,0.44-0.17,0.47-0.41l0.36-2.54c0.59-0.24,1.13-0.56,1.62-0.94l2.39,0.96c0.22,0.08,0.47,0,0.59-0.22l1.92-3.32c0.12-0.22,0.07-0.47-0.12-0.61L19.14,12.94z M12,15.6c-1.98,0-3.6-1.62-3.6-3.6s1.62-3.6,3.6-3.6s3.6,1.62,3.6,3.6S13.98,15.6,12,15.6z</Geometry>
            <Geometry x:Key="IconBolt">M13,2L3,14H12L11,22L21,10H12L13,2Z</Geometry>
            <Geometry x:Key="IconDashboard">M4,13h6c0.55,0,1-0.45,1-1V4c0-0.55-0.45-1-1-1H4C3.45,3,3,3.45,3,4v8C3,12.55,3.45,13,4,13z M14,21h6c0.55,0,1-0.45,1-1v-8c0-0.55-0.45-1-1-1h-6c-0.55,0-1,0.45-1,1v8C13,20.55,13.45,21,14,21z M14,8h6c0.55,0,1-0.45,1-1V4c0-0.55-0.45-1-1-1h-6c-0.55,0-1,0.45-1,1v3C13,7.55,13.45,8,14,8z</Geometry>
            <Geometry x:Key="IconWrench">M22.7,19l-9.1-9.1c0.9-2.3,0.4-5-1.5-6.9c-2-2-5-2.4-7.4-1.3L9,6L6,9L1.6,4.7C0.4,7.1,0.9,10.1,2.9,12.1c1.9,1.9,4.6,2.4,6.9,1.5l9.1,9.1c0.4,0.4,1,0.4,1.4,0l2.3-2.3C23.1,20,23.1,19.4,22.7,19z</Geometry>
            <Geometry x:Key="IconShield">M12,1L3,5v6c0,5.55,3.84,10.74,9,12c5.16-1.26,9-6.45,9-12V5L12,1z M12,11.99h7c-0.53,4.12-3.28,7.79-7,8.94V12H5V6.3l7-3.11V11.99z</Geometry>
            <Geometry x:Key="IconShieldPlus">M12,1L3,5v6c0,5.55,3.84,10.74,9,12c5.16-1.26,9-6.45,9-12V5L12,1z M17,13h-4v4h-2v-4H7v-2h4V7h2v4h4V13z</Geometry>
            <Geometry x:Key="IconGlobe">M12,2C6.48,2,2,6.48,2,12s4.48,10,10,10s10-4.48,10-10S17.52,2,12,2z M11,19.93c-3.95-0.49-7-3.85-7-7.93c0-0.62,0.08-1.21,0.21-1.79L9,15v1c0,1.1,0.9,2,2,2V19.93z M17.9,17.39c-0.26-0.81-1-1.39-1.9-1.39h-1v-3c0-0.55-0.45-1-1-1H8v-2h2c0.55,0,1-0.45,1-1V7h2c1.1,0,2-0.9,2-2v-0.41c2.93,1.19,5,4.06,5,7.41C20,14.08,19.15,16,17.9,17.39z</Geometry>
            <Geometry x:Key="IconRefresh">M17.65,6.35C16.2,4.9,14.21,4,12,4c-4.42,0-7.99,3.58-7.99,8s3.57,8,7.99,8c3.73,0,6.84-2.55,7.73-6h-2.08c-0.82,2.33-3.04,4-5.65,4c-3.31,0-6-2.69-6-6s2.69-6,6-6c1.66,0,3.14,0.69,4.22,1.78L13,11h7V4L17.65,6.35z</Geometry>
            <Geometry x:Key="IconRestore">M13,3c-4.97,0-9,4.03-9,9H1l3.89,3.89l0.07,0.14L9,12H6c0-3.87,3.13-7,7-7s7,3.13,7,7s-3.13,7-7,7c-1.93,0-3.68-0.79-4.94-2.06l-1.42,1.42C8.27,19.99,10.51,21,13,21c4.97,0,9-4.03,9-9S17.97,3,13,3z M12,8v5l4.28,2.54l0.72-1.21l-3.5-2.08V8H12z</Geometry>
            <Geometry x:Key="IconPerformance">M12,2C6.48,2,2,6.48,2,12s4.48,10,10,10s10-4.48,10-10S17.52,2,12,2z M12,20c-4.42,0-8-3.58-8-8s3.58-8,8-8s8,3.58,8,8S16.42,20,12,20z M16.5,7.5l-2,6l-6,2l2-6L16.5,7.5z M12,13c-0.55,0-1-0.45-1-1s0.45-1,1-1s1,0.45,1,1S12.55,13,12,13z</Geometry>

            <Storyboard x:Key="EntryAnimation">
                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.5">
                    <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                </DoubleAnimation>
                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" From="20" To="0" Duration="0:0:0.5">
                    <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                </DoubleAnimation>
            </Storyboard>
        </ResourceDictionary>
    </UserControl.Resources>

    <UserControl.Triggers>
        <EventTrigger RoutedEvent="Loaded">
            <BeginStoryboard Storyboard="{StaticResource EntryAnimation}"/>
        </EventTrigger>
    </UserControl.Triggers>

    <Grid>
        <Grid IsHitTestVisible="False" ClipToBounds="True">
            <Ellipse Width="400" Height="400" Fill="{DynamicResource AccentBlurBrush}"
                     HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-80,-150,0">
                <Ellipse.Effect><BlurEffect Radius="100"/></Ellipse.Effect>
            </Ellipse>
            <Ellipse Width="300" Height="300" Fill="{DynamicResource PrimaryBlurBrush}"
                     HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="-80,0,0,-80">
                <Ellipse.Effect><BlurEffect Radius="80"/></Ellipse.Effect>
            </Ellipse>
        </Grid>

        <Grid Margin="28,12,28,14" ClipToBounds="True">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Header -->
                <RowDefinition Height="12"/>
                <RowDefinition Height="*"/>    <!-- Lista: scroll interno -->
            </Grid.RowDefinitions>

            <!-- HEADER COMPACTO -->
            <StackPanel Grid.Row="0" Orientation="Horizontal">
                <Border Width="40" Height="40" CornerRadius="10" Margin="0,0,14,0" VerticalAlignment="Center" Background="#0A000000">
                    <Border.Effect><DropShadowEffect BlurRadius="15" ShadowDepth="0" Color="{DynamicResource PrimaryColor}" Opacity="0.3"/></Border.Effect>
                    <Grid>
                        <Border CornerRadius="10" BorderThickness="1">
                            <Border.BorderBrush><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#F59E0B" Offset="0"/><GradientStop Color="#00FFFFFF" Offset="1"/></LinearGradientBrush></Border.BorderBrush>
                            <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#8B5CF6" Offset="0"/><GradientStop Color="#2A000000" Offset="1"/></LinearGradientBrush></Border.Background>
                        </Border>
                        <Path Data="{DynamicResource ShortcutsIcon}" Fill="#F59E0B" Width="19" Height="19" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding [Shortcuts], Source={x:Static services:LocalizationService.Instance}}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <TextBlock Text="{Binding [ShortcutsSubtitle], Source={x:Static services:LocalizationService.Instance}}" FontSize="11" Foreground="#94A3B8"/>
                </StackPanel>
            </StackPanel>

            <!-- Estado REAL do registro dos atalhos no Windows.
                 Antes esta informação não existia: a tela mostrava todas as combinações
                 como se funcionassem, mesmo quando outro programa já possuía a
                 combinação e o RegisterHotKey falhava silenciosamente. -->
            <Border Grid.Row="1" x:Name="HotkeyStatusBanner" Margin="0,14,0,4"
                    CornerRadius="10" Padding="14,10" Visibility="Collapsed">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background"><Setter.Value><SolidColorBrush Color="#F59E0B" Opacity="0.12"/></Setter.Value></Setter>
                        <Setter Property="BorderBrush"><Setter.Value><SolidColorBrush Color="#F59E0B" Opacity="0.4"/></Setter.Value></Setter>
                        <Setter Property="BorderThickness" Value="1"/>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <TextBlock x:Name="HotkeyStatusText" FontSize="12" FontWeight="SemiBold" Foreground="#F59E0B" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding [ShortcutGlobalScopeNote], Source={x:Static services:LocalizationService.Instance}}" FontSize="10" Foreground="#94A3B8" Margin="0,4,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,4,8">
                <StackPanel RenderTransformOrigin="0.5,0">

                <!-- ════════════════════════════════════════ -->
                <!-- 1. NAVEGAÇÃO RÁPIDA                     -->
                <!-- ════════════════════════════════════════ -->
                <StackPanel Style="{StaticResource SectionHeaderStyle}">
                    <Border Style="{StaticResource SectionIconStyle}" Background="#1A3B82F6">
                        <Path Data="{StaticResource IconDashboard}" Fill="#3B82F6" Width="18" Height="18" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="{Binding [ShortcutsNavSection], Source={x:Static services:LocalizationService.Instance}}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- ALT+1 Dashboard -->
                <Border Style="{StaticResource GlassCardStyle}">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="34" Height="34" CornerRadius="9" Background="#1A3B82F6" VerticalAlignment="Center" Margin="0,0,14,0">
                            <Path Data="{StaticResource IconDashboard}" Fill="#3B82F6" Width="20" Height="20" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Grid.Column="1" Text="{Binding [ShortcutAltDashboard], Source={x:Static services:LocalizationService.Instance}}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Style="{StaticResource KeyBadgeStyle}" Background="#1A3B82F6" BorderBrush="#333B82F6"><TextBlock Text="ALT" Foreground="#3B82F6" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center"/></Border>
                            <TextBlock Text="+" Style="{StaticResource PlusStyle}"/>
                            <Border Style="{StaticResource KeyBadgeStyle}" Background="#1A3B82F6" BorderBrush="#333B82F6"><TextBlock Text="1" Foreground="#3B82F6" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center"/></Border>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ALT+2 Cleanup -->
                <Border Style="{StaticResource GlassCardStyle}">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="34" Height="34" CornerRadius="9" Background="#1A10B981" VerticalAlignment="Center" Margin="0,0,14,0">
                            <Path Data="{StaticResource IconCleanup}" Fill="#10B981" Width="20" Height="20" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Grid.Column="1" Text="{Binding [ShortcutAltCleanup], Source={x:Static services:LocalizationService.Instance}}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Style="{StaticResource KeyBadgeStyle}" Background="#1A10B981" BorderBrush="#3310B981"><TextBlock Text="ALT" Foreground="#10B981" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center"/></Border>
                            <TextBlock Text="+" Style="{StaticResource PlusStyle}"/>
                            <Border Style="{StaticResource KeyBadgeStyle}" Background="#1A10B981" BorderBrush="#3310B981"><TextBlock Text="2" Foreground="#10B981" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center"/></Border>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ALT+3 Performance -->
                <Border Style="{StaticResource GlassCardStyle}">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="34" Height="34" CornerRadius="9" Background="#1A8B5CF6" VerticalAlignment="Center" Margin="0,0,14,0">
                            <Path Data="{StaticResource IconBolt}" Fill="#8B5CF6" Width="20" Height="20" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Grid.Column="1" Text="{Binding [ShortcutAltPerformance], Source={x:Static services:LocalizationService.Instance}}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Style="{StaticResource KeyBadgeStyle}" Background="#1A8B5CF6" BorderBrush="#338B5CF6"><TextBlock Text="ALT" Foreground="#8B5CF6" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center"/></Border>
                            <TextBlock Text="+" Style="{StaticResource PlusStyle}"/>
                            <Border Style="{StaticResource KeyBadgeStyle}" Background="#1A8B5CF6" BorderBrush="#338B5CF6"><TextBlock Text="3" Foreground="#8B5CF6" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center"/></Border>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ALT+4 Gamer -->
                <Border Style="{StaticResource GlassCardStyle}">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="34" Height="34" CornerRadius="9" Background="#1AF59E0B" VerticalAlignment="Center" Margin="0,0,14,0">
                            <Path Data="{StaticResource IconGamepad}" Fill="#F59E0B" Width="20" Height="20" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Grid.Column="1" Text="{Binding [ShortcutAltGamer], Source={x:Static services:LocalizationService.Instance}}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Style="{StaticResource KeyBadgeStyle}" Background="#1AF59E0B" BorderBrush="#33F59E0B"><TextBlock Text="ALT" Foreground="#F59E0B" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center"/></Border>
                            <TextBlock Text="+" Style="{StaticResource PlusStyle}"/>
                            <Border Style="{StaticResource KeyBadgeStyle}" Background="#1AF59E0B" BorderBrush="#33F59E0B"><TextBlock Text="4" Foreground="#F59E0B" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center"/></Border>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ALT+5 Repair -->
                <Border Style="{StaticResource GlassCardStyle}">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="34" Height="34" CornerRadius="9" Background="#1AEF4444" VerticalAlignment="Center" Margin="0,0,14,0">
                            <Path Data="{StaticResource IconWrench}" Fill="#EF4444" Width="20" Height="20" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Grid.Column="1" Text="{Binding [ShortcutAltRepair], Source={x:Static services:LocalizationService.Instance}}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Style="{StaticResource KeyBadgeStyle}" Background="#1AEF4444" BorderBrush="#33EF4444"><TextBlock Text="ALT" Foreground="#EF4444" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center"/></Border>
                            <TextBlock Text="+" Style="{StaticResource PlusStyle}"/>
                            <Border Style="{StaticResource KeyBadgeStyle}" Background="#1AEF4444" BorderBrush="#33EF4444"><TextBlock Text="5" Foreground="#EF4444" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center"/></Border>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ALT+6 Shield -->
                <Border Style="{StaticResource GlassCardStyle}">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="34" Height="34" CornerRadius="9" Background="#1A3B82F6" VerticalAlignment="Center" Margin="0,0,14,0">
                            <Path Data="{StaticResource IconShield}" Fill="#3B82F6" Width="20" Height="20" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Grid.Column="1" Text="{Binding [ShortcutAltShield], Source={x:Static services:LocalizationService.Instance}}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Style="{StaticResource KeyBadgeStyle}" Background="#1A3B82F6" BorderBrush="#333B82F6"><TextBlock Text="ALT" Foreground="#3B82F6" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center"/></Border>
                            <TextBlock Text="+" Style="{StaticResource PlusStyle}"/>
                            <Border Style="{StaticResource KeyBadgeStyle}" Background="#1A3B82F6" BorderBrush="#333B82F6"><TextBlock Text="6" Foreground="#3B82F6" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center"/></Border>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ALT+7 Settings -->
                <Border Style="{StaticResource GlassCardStyle}">
