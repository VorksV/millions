<UserControl xmlns:services="clr-namespace:VoltrisOptimizer.Services" x:Class="VoltrisOptimizer.UI.Views.NetworkView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource DarkBrush}"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch">

    <UserControl.Triggers>
        <EventTrigger RoutedEvent="Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.4"/>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </UserControl.Triggers>

    <Grid>
        <!-- Background decorativo -->
        <Grid IsHitTestVisible="False" ClipToBounds="True">
            <Ellipse Width="400" Height="400" 
                     Fill="{DynamicResource PrimaryBlurBrush}"
                     HorizontalAlignment="Right" VerticalAlignment="Top"
                     Margin="0,-100,-150,0">
                <Ellipse.Effect>
                    <BlurEffect Radius="100"/>
                </Ellipse.Effect>
            </Ellipse>
            <Ellipse Width="300" Height="300" 
                     Fill="{DynamicResource SecondaryBlurBrush}"
                     HorizontalAlignment="Left" VerticalAlignment="Bottom"
                     Margin="-80,0,0,-80">
                <Ellipse.Effect>
                    <BlurEffect Radius="80"/>
                </Ellipse.Effect>
            </Ellipse>
        </Grid>

        <Grid Margin="28,12,28,16" ClipToBounds="True">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Header -->
                <RowDefinition Height="14"/>
                <RowDefinition Height="*"/>    <!-- Content: preenche o viewport, sem scroll -->
            </Grid.RowDefinitions>

            <!-- HEADER COMPACTO -->
            <StackPanel Grid.Row="0" Orientation="Horizontal">
                <Border Width="40" Height="40" CornerRadius="10" Margin="0,0,14,0" VerticalAlignment="Center">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#00D4FF" Offset="0"/>
                            <GradientStop Color="#31A8FF" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="12" ShadowDepth="0" Color="#00D4FF" Opacity="0.4"/>
                    </Border.Effect>
                    <Path Data="{StaticResource NetworkIcon}" 
                          Fill="White" Width="20" Height="20" Stretch="Uniform" 
                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding [NetworkMgmt], Source={x:Static services:LocalizationService.Instance}}"
                               FontFamily="Segoe UI Variable Display, Segoe UI"
                               FontSize="11"
                               FontWeight="Bold"
                               Foreground="{DynamicResource PrimaryBrush}"
                               Margin="0,0,0,2"/>
                    <TextBlock Text="{Binding [NetworkOptimizeAndDns], Source={x:Static services:LocalizationService.Instance}}"
                               FontFamily="Segoe UI Variable Display, Segoe UI"
                               FontSize="20"
                               FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                </StackPanel>
            </StackPanel>

            <!-- CONTEÚDO: grid de estrelas que ocupa exatamente a altura disponível -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="1*"/>
                    <RowDefinition Height="14"/>
                    <RowDefinition Height="1*"/>
                </Grid.RowDefinitions>

                <!-- CARD 1: SELEÇÃO DE INTERFACE E STATUS -->
                <Border Grid.Row="0" Grid.Column="0"
                        Style="{StaticResource PremiumCard}"
                        Padding="16"
                        VerticalAlignment="Stretch">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                            <Border Width="32" Height="32" CornerRadius="8" Background="#2031A8FF" Margin="0,0,12,0">
                                <Path Data="M12,21L15.6,16.2C14.6,15.45 13.35,15 12,15C10.65,15 9.4,15.45 8.4,16.2L12,21M12,3C7.95,3 4.21,4.34 1.2,6.6L3,9C5.5,7.12 8.62,6 12,6C15.38,6 18.5,7.12 21,9L22.8,6.6C19.79,4.34 16.05,3 12,3M12,9C9.3,9 6.81,9.89 4.8,11.4L6.6,13.8C8.1,12.67 9.97,12 12,12C14.03,12 15.9,12.67 17.4,13.8L19.2,11.4C17.19,9.89 14.7,9 12,9Z" 
                                      Fill="#3B82F6" Width="16" Height="16" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="{Binding [NetworkAdapterStatus], Source={x:Static services:LocalizationService.Instance}}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </StackPanel>

                        <Grid Grid.Row="1">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Seleção -->
                            <StackPanel Grid.Row="0" Margin="0,0,0,10">
                                <TextBlock Text="{Binding [NetworkActiveAdapter], Source={x:Static services:LocalizationService.Instance}}" Style="{StaticResource Caption}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="2,0,0,6"/>
                                <ComboBox x:Name="cmbNetworkInterfaces" 
                                          Style="{StaticResource ModernComboBoxStyle}"
                                          SelectionChanged="cmbNetworkInterfaces_SelectionChanged"
                                          HorizontalAlignment="Stretch"
                                          MinHeight="40"/>
                                <TextBlock Text="{Binding [NetworkAdapterWarning], Source={x:Static services:LocalizationService.Instance}}" 
                                           FontSize="9" Foreground="{DynamicResource TextSecondaryBrush}" Opacity="0.5" TextWrapping="Wrap" Margin="2,6,0,0"/>
                            </StackPanel>

                            <!-- Detalhes DNS -->
                            <Grid Grid.Row="1" Margin="0,10,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="8"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- IPv4 -->
                                <Border Grid.Row="0" Grid.Column="0" Background="#08FFFFFF" CornerRadius="10" Padding="10" VerticalAlignment="Stretch">
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding [NetworkDnsIpv4Primary], Source={x:Static services:LocalizationService.Instance}}" FontSize="9" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,3"/>
                                        <TextBlock x:Name="txtIPv4DNSPrimary" Text="{Binding [NetworkLoading], Source={x:Static services:LocalizationService.Instance}}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Row="0" Grid.Column="2" Background="#08FFFFFF" CornerRadius="10" Padding="10" VerticalAlignment="Stretch">
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding [NetworkDnsIpv4Secondary], Source={x:Static services:LocalizationService.Instance}}" FontSize="9" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,3"/>
                                        <TextBlock x:Name="txtIPv4DNSSecondary" Text="{Binding [NetworkLoading], Source={x:Static services:LocalizationService.Instance}}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </Border>

                                <!-- IPv6 -->
                                <Border Grid.Row="2" Grid.Column="0" Background="#08FFFFFF" CornerRadius="10" Padding="10" VerticalAlignment="Stretch">
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding [NetworkDnsIpv6Primary], Source={x:Static services:LocalizationService.Instance}}" FontSize="9" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,3"/>
                                        <TextBlock x:Name="txtIPv6DNSPrimary" Text="{Binding [NetworkLoading], Source={x:Static services:LocalizationService.Instance}}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Row="2" Grid.Column="2" Background="#08FFFFFF" CornerRadius="10" Padding="10" VerticalAlignment="Stretch">
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding [NetworkDnsIpv6Secondary], Source={x:Static services:LocalizationService.Instance}}" FontSize="9" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,3"/>
                                        <TextBlock x:Name="txtIPv6DNSSecondary" Text="{Binding [NetworkLoading], Source={x:Static services:LocalizationService.Instance}}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Grid>
                    </Grid>
                </Border>

                <!-- CARD 2: CONFIGURAÇÃO DE DNS -->
                <Border Grid.Row="0" Grid.Column="2"
                        Style="{DynamicResource PremiumCard}"
                        Padding="16"
                        VerticalAlignment="Stretch">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                            <Border Width="32" Height="32" CornerRadius="8" Background="#20FF4B6B" Margin="0,0,12,0">
                                <Path Data="M7,2V13H10V22L17,10H13L17,2H7Z" Fill="#FF4B6B" Width="16" Height="16" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="{Binding [NetworkDnsOptimization], Source={x:Static services:LocalizationService.Instance}}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Margin="0,0,0,14">
                            <TextBlock Text="{Binding [NetworkRecommendedDns], Source={x:Static services:LocalizationService.Instance}}" Style="{StaticResource Caption}" Margin="2,0,0,6"/>
                            <ComboBox x:Name="cmbDNSOptions" 
                                      Style="{StaticResource ModernComboBoxStyle}"
                                      HorizontalAlignment="Stretch"
                                      MinHeight="40"/>
                        </StackPanel>

                        <StackPanel Grid.Row="2" Orientation="Horizontal" VerticalAlignment="Bottom" HorizontalAlignment="Stretch">
                            <Button x:Name="ApplyDNSButton" 
                                    Content="{Binding [NetworkApplyDns], Source={x:Static services:LocalizationService.Instance}}" 
                                    Style="{StaticResource NeonButtonStyle}" 
                                    Margin="0,0,10,0"
                                    MinHeight="44"
                                    FontSize="12"
                                    HorizontalAlignment="Stretch"
                                    Click="ApplyDNS_Click"/>
                            <Button x:Name="ResetDNSButton" 
                                    Content="{Binding [NetworkRestoreDefault], Source={x:Static services:LocalizationService.Instance}}" 
                                    Style="{StaticResource NeonSecondaryButtonStyle}" 
                                    Margin="10,0,0,0"
                                    MinHeight="44"
                                    FontSize="12"
                                    HorizontalAlignment="Stretch"
                                    Click="ResetDefaultDNS_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- CARD 3: OPÇÕES DE REPARO -->
                <Border Grid.Row="2" Grid.Column="0"
                        Style="{DynamicResource PremiumCard}"
                        Padding="16"
                        VerticalAlignment="Stretch">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                            <Border Width="32" Height="32" CornerRadius="8" Background="#2010B981" Margin="0,0,12,0">
                                <Path Data="M12,15.5A3.5,3.5 0 0,1 8.5,12A3.5,3.5 0 0,1 12,8.5A3.5,3.5 0 0,1 15.5,12A3.5,3.5 0 0,1 12,15.5M19.43,12.97C19.47,12.65 19.5,12.33 19.5,12C19.5,11.67 19.47,11.34 19.43,11L21.54,9.37C21.73,9.22 21.78,8.95 21.66,8.73L19.66,5.27C19.54,5.05 19.27,4.96 19.05,5.05L16.56,6.05C16.04,5.66 15.5,5.32 14.87,5.07L14.5,2.42C14.46,2.18 14.25,2 14,2H10C9.75,2 9.54,2.18 9.5,2.42L9.13,5.07C8.5,5.32 7.96,5.66 7.44,6.05L4.95,5.05C4.73,4.96 4.46,5.05 4.34,5.27L2.34,8.73C2.21,8.95 2.27,9.22 2.46,9.37L4.57,11C4.53,11.34 4.5,11.67 4.5,12C4.5,12.33 4.53,12.65 4.57,12.97L2.46,14.63C2.27,14.78 2.21,15.05 2.34,15.27L4.34,18.73C4.46,18.95 4.73,19.03 4.95,18.95L7.44,17.94C7.96,18.34 8.5,18.68 9.13,18.93L9.5,21.58C9.54,21.82 9.75,22 10,22H14C14.25,22 14.46,21.82 14.5,21.58L14.87,18.93C15.5,18.67 16.04,18.34 16.56,17.94L19.05,18.95C19.27,19.03 19.54,18.95 19.66,18.73L21.66,15.27C21.78,15.05 21.73,14.78 21.54,14.63L19.43,12.97Z" Fill="#10B981" Width="16" Height="16" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="{Binding [NetworkToolsTitle], Source={x:Static services:LocalizationService.Instance}}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </StackPanel>

                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <CheckBox Grid.Row="0" Grid.Column="0" x:Name="NetworkFlushDNS" Content="{Binding [NetworkClearDnsCache], Source={x:Static services:LocalizationService.Instance}}" Style="{StaticResource ModernCheckBoxStyle}" IsChecked="True" Margin="0,0,10,10" VerticalAlignment="Center"/>
                            <CheckBox Grid.Row="0" Grid.Column="1" x:Name="NetworkResetWinsock" Content="{Binding [NetworkResetWinsock], Source={x:Static services:LocalizationService.Instance}}" Style="{StaticResource ModernCheckBoxStyle}" IsChecked="True" Margin="10,0,0,10" VerticalAlignment="Center"/>
                            <CheckBox Grid.Row="1" Grid.Column="0" x:Name="NetworkResetTCP" Content="{Binding [NetworkResetTcpIp], Source={x:Static services:LocalizationService.Instance}}" Style="{StaticResource ModernCheckBoxStyle}" IsChecked="True" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <CheckBox Grid.Row="1" Grid.Column="1" x:Name="NetworkRenewDHCP" Content="{Binding [NetworkRenewDhcp], Source={x:Static services:LocalizationService.Instance}}" Style="{StaticResource ModernCheckBoxStyle}" IsChecked="False" Margin="10,0,0,0" VerticalAlignment="Center"/>
                        </Grid>
                    </Grid>
                </Border>

                <!-- CARD 4: AÇÕES GERAIS -->
                <Border Grid.Row="2" Grid.Column="2"
                        Style="{DynamicResource PremiumCard}"
                        Padding="16"
                        VerticalAlignment="Stretch">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                            <Border Width="32" Height="32" CornerRadius="8" Background="#208B31FF" Margin="0,0,12,0">
                                <Path Data="M13.13,22.19L11.5,18.36C13.07,17.78 14.54,17 15.9,16.09L13.13,22.19M5.64,12.5L1.81,10.87L7.91,8.1C7,9.46 6.22,10.93 5.64,12.5M19.22,4C19.5,4 19.75,4 19.96,4.05C20.13,5.44 19.94,8.3 16.66,11.58C14.96,13.29 12.93,14.6 10.65,15.47L8.5,13.37C9.42,11.06 10.73,9.03 12.42,7.34C14.73,5.03 17.3,4.08 19.22,4M4.15,17.54C5,18.38 5.96,18.5 6.47,18.5C7.16,18.5 7.69,18.24 7.86,18.07L9.7,16.22C9.19,16.39 8.66,16.5 8.11,16.55L7.63,16.59L7.17,16.95C6.64,17.36 6.36,17.5 6.08,17.5C5.77,17.5 5.37,17.35 5.05,17.03C4.5,16.47 4.41,15.88 4.97,15.33L6.32,13.97L6.61,14.25C6.62,13.95 6.66,13.66 6.71,13.36L4.15,15.93C3.59,16.5 3.29,16.69 4.15,17.54M21.56,2.46C21.56,2.46 19.37,0.28 11.32,8.34C9.75,9.91 8.5,11.77 7.6,13.87L10.14,16.41C12.24,15.5 14.1,14.26 15.66,12.68C23.72,4.63 21.56,2.46 21.56,2.46Z" Fill="#8B31FF" Width="16" Height="16" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="{Binding [NetworkRunOptimizations], Source={x:Static services:LocalizationService.Instance}}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </StackPanel>

                        <StackPanel Grid.Row="1" VerticalAlignment="Bottom">
                            <Button Grid.Column="0" x:Name="RunNetworkButton" Content="{Binding [NetworkOptimizeConnection], Source={x:Static services:LocalizationService.Instance}}" Style="{StaticResource NeonButtonStyle}" MinHeight="46" FontSize="12" HorizontalAlignment="Stretch" Click="RunNetworkButton_Click" Margin="0,0,0,10"/>
                            <Button Grid.Column="2" x:Name="OptimizeStackButton" Content="{Binding [NetworkFixErrors], Source={x:Static services:LocalizationService.Instance}}" Style="{StaticResource NeonSecondaryButtonStyle}" MinHeight="46" FontSize="12" HorizontalAlignment="Stretch" Click="OptimizeStackButton_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>