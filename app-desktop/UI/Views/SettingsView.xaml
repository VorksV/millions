    </UserControl.Resources>

    <UserControl.Triggers>
        <EventTrigger RoutedEvent="Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.4" />
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </UserControl.Triggers>

    <Grid>
        <!-- Background decorativo -->
        <Grid IsHitTestVisible="False" ClipToBounds="True">
            <Ellipse Width="400" Height="400" Fill="{DynamicResource AccentBlurBrush}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-150,-150,0">
                <Ellipse.Effect><BlurEffect Radius="100" /></Ellipse.Effect>
            </Ellipse>
            <Ellipse Width="350" Height="350" Fill="{DynamicResource SecondaryBlurBrush}" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="-100,0,0,-100">
                <Ellipse.Effect><BlurEffect Radius="80" /></Ellipse.Effect>
            </Ellipse>
        </Grid>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0" Margin="0" UseLayoutRounding="True" SnapsToDevicePixels="True" Style="{StaticResource ModernScrollViewerStyle}">

            <Grid MaxWidth="1400" MinWidth="600" Margin="24,16,24,24" HorizontalAlignment="Center" UseLayoutRounding="True" SnapsToDevicePixels="True">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Header -->
                <StackPanel Grid.Row="0" Margin="0,0,0,24" HorizontalAlignment="Center" Orientation="Horizontal">
                    <StackPanel.RenderTransform><TranslateTransform /></StackPanel.RenderTransform>
                    <StackPanel.Triggers>
                        <EventTrigger RoutedEvent="Loaded">
                            <BeginStoryboard Storyboard="{StaticResource HeaderEntryAnimation}" />
                        </EventTrigger>
                    </StackPanel.Triggers>

                    <Border Width="48" Height="48" CornerRadius="12" Margin="0,0,14,0" VerticalAlignment="Center">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#8B31FF" Offset="0" />
                                <GradientStop Color="#31A8FF" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="14" ShadowDepth="0" Color="#8B31FF" Opacity="0.5" />
                        </Border.Effect>
                        <Path Data="{StaticResource IconSettings}" Fill="White" Width="22" Height="22" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>

                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding [Settings], Source={x:Static services:LocalizationService.Instance}}" FontFamily="Segoe UI Variable Display, Segoe UI" FontSize="24" FontWeight="Bold">
                            <TextBlock.Foreground>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#FF4B6B" Offset="0" />
                                    <GradientStop Color="#8B31FF" Offset="0.5" />
                                    <GradientStop Color="#31A8FF" Offset="1" />
                                </LinearGradientBrush>
                            </TextBlock.Foreground>
                        </TextBlock>
                        <TextBlock Text="{Binding [SettingsSubtitle], Source={x:Static services:LocalizationService.Instance}}" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" HorizontalAlignment="Left" />
                    </StackPanel>
                </StackPanel>

                <!-- Conteúdo das Configurações -->
                <StackPanel Grid.Row="1">

                    <!-- Seção de Conta Voltris (Vinculada) -->
                    <Border x:Name="AccountSection" Style="{StaticResource SettingsCardStyle}" Visibility="Collapsed">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource SettingsIconStyle}" VerticalAlignment="Top">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#EC4899" Offset="0" />
                                        <GradientStop Color="#DB2777" Offset="1" />
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="12" ShadowDepth="0" Color="#EC4899" Opacity="0.4" />
                                </Border.Effect>
                                <Path Data="{StaticResource IconCloud}" Fill="White" Width="20" Height="20" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{Binding [AccountEnterprise], Source={x:Static services:LocalizationService.Instance}}" Style="{StaticResource SettingsSectionTitle}" />
                                <TextBlock x:Name="AccountEmailText" Text="{Binding [AccountManageCloud], Source={x:Static services:LocalizationService.Instance}}" Style="{StaticResource SettingsSectionDesc}" />
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <Button x:Name="UnlinkButton" Height="38" Padding="18,0" HorizontalAlignment="Left" Click="UnlinkDevice_Click" Cursor="Hand">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Background" Value="#20EF4444" />
                                                <Setter Property="Foreground" Value="#FFEF4444" />
                                                <Setter Property="BorderBrush" Value="#60EF4444" />
                                                <Setter Property="BorderThickness" Value="1.5" />
                                                <Setter Property="FontWeight" Value="SemiBold" />
                                                <Setter Property="FontSize" Value="13" />
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                    <Path Data="{StaticResource IconShield}" Fill="#FFEF4444" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center" />
                                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                </StackPanel>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="border" Property="Background" Value="#40EF4444" />
                                                                    <Setter TargetName="border" Property="BorderBrush" Value="#80EF4444" />
                                                                    <Setter Property="Foreground" Value="#FFFEF2F2" />
                                                                </Trigger>
                                                                <Trigger Property="IsPressed" Value="True">
                                                                    <Setter TargetName="border" Property="Background" Value="#60DC2626" />
                                                                    <Setter TargetName="border" Property="BorderBrush" Value="#A0EF4444" />
                                                                </Trigger>
                                                                <Trigger Property="IsEnabled" Value="False">
                                                                    <Setter Property="Opacity" Value="0.5" />
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </Button.Style>
                                        <TextBlock Text="{Binding [AccountUnlink], Source={x:Static services:LocalizationService.Instance}}" FontWeight="SemiBold" />
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Link Account Section (Quando não vinculada) -->
                    <Border x:Name="LinkAccountSection" Style="{StaticResource SettingsCardStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource SettingsIconStyle}" VerticalAlignment="Top">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#6366F1" Offset="0" />
                                        <GradientStop Color="#4338CA" Offset="1" />
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="12" ShadowDepth="0" Color="#6366F1" Opacity="0.4" />
                                </Border.Effect>
                                <Path Data="{StaticResource IconCloud}" Fill="White" Width="20" Height="20" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{Binding [AccountLinkTitle], Source={x:Static services:LocalizationService.Instance}}" Style="{StaticResource SettingsSectionTitle}" />
                                <TextBlock Text="{Binding [AccountLinkDesc], Source={x:Static services:LocalizationService.Instance}}" Style="{StaticResource SettingsSectionDesc}" />
                                <Button Content="{Binding [AccountLinkBtn], Source={x:Static services:LocalizationService.Instance}}" Height="36" Padding="20,0" Margin="0,4,0,0" HorizontalAlignment="Left" Style="{StaticResource NeonButtonStyle}" Click="LinkAccount_Click" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Seção de Idioma -->
                    <Border Style="{StaticResource SettingsCardStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource SettingsIconStyle}" VerticalAlignment="Top">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#3B82F6" Offset="0" />
                                        <GradientStop Color="#1D4ED8" Offset="1" />
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="12" ShadowDepth="0" Color="#3B82F6" Opacity="0.4" />
                                </Border.Effect>
                                <Path Data="{StaticResource IconGlobe}" Fill="White" Width="20" Height="20" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{Binding [LanguageAppTitle], Source={x:Static services:LocalizationService.Instance}}" Style="{StaticResource SettingsSectionTitle}" />
                                <TextBlock Text="{Binding [LanguageAppDesc], Source={x:Static services:LocalizationService.Instance}}" Style="{StaticResource SettingsSectionDesc}" />
                                <WrapPanel Margin="0,4,0,0">
                                    <ComboBox x:Name="LanguageCombo" Width="220" HorizontalAlignment="Left" Style="{StaticResource ModernComboBoxStyle}" SelectionChanged="LanguageCombo_SelectionChanged">
                                        <ComboBoxItem Content="{Binding [Portuguese], Source={x:Static services:LocalizationService.Instance}}" />
                                        <ComboBoxItem Content="{Binding [Spanish], Source={x:Static services:LocalizationService.Instance}}" />
                                        <ComboBoxItem Content="{Binding [English], Source={x:Static services:LocalizationService.Instance}}" />
                                    </ComboBox>
                                </WrapPanel>
                            </StackPanel>
                        </Grid>
                    </Border>


                    <!-- Seção de Aparência -->
                    <Border Style="{StaticResource SettingsCardStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource SettingsIconStyle}" VerticalAlignment="Top">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#8B5CF6" Offset="0" />
                                        <GradientStop Color="#6D28D9" Offset="1" />
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="12" ShadowDepth="0" Color="#8B5CF6" Opacity="0.4" />
                                </Border.Effect>
                                <Path Data="{StaticResource IconPalette}" Fill="White" Width="20" Height="20" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{Binding [AppearanceTitle], Source={x:Static services:LocalizationService.Instance}}" Style="{StaticResource SettingsSectionTitle}" />
                                <TextBlock Text="{Binding [AppearanceDesc], Source={x:Static services:LocalizationService.Instance}}" Style="{StaticResource SettingsSectionDesc}" />
                                <ComboBox x:Name="ThemeCombo" Width="200" Style="{StaticResource ModernComboBoxStyle}" HorizontalAlignment="Left" SelectionChanged="ThemeCombo_SelectionChanged">
                                    <ComboBoxItem Content="{Binding [ThemeDark], Source={x:Static services:LocalizationService.Instance}}" />
                                    <ComboBoxItem Content="{Binding [ThemeLight], Source={x:Static services:LocalizationService.Instance}}" />
                                </ComboBox>

                                <Grid Margin="0,16,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding [TransparencyEffect], Source={x:Static services:LocalizationService.Instance}}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                        <TextBlock Text="{Binding [TransparencyEffectDesc], Source={x:Static services:LocalizationService.Instance}}" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <CheckBox x:Name="TransparencyToggle" Grid.Column="1" IsChecked="True" Style="{StaticResource PremiumToggleStyle}" Checked="TransparencyToggle_Checked" Unchecked="TransparencyToggle_Unchecked" VerticalAlignment="Center" />
                                </Grid>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Seção de Inicialização -->
                    <Border Style="{StaticResource SettingsCardStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource SettingsIconStyle}" VerticalAlignment="Top">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#10B981" Offset="0" />
                                        <GradientStop Color="#059669" Offset="1" />
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="12" ShadowDepth="0" Color="#10B981" Opacity="0.4" />
                                </Border.Effect>
                                <Path Data="{StaticResource IconRocket}" Fill="White" Width="20" Height="20" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{Binding [StartupTitle], Source={x:Static services:LocalizationService.Instance}}" Style="{StaticResource SettingsSectionTitle}" />
                                <TextBlock Text="{Binding [StartupDesc], Source={x:Static services:LocalizationService.Instance}}" Style="{StaticResource SettingsSectionDesc}" />
                                <StackPanel>
                                    <CheckBox x:Name="CheckStartWithWindows" Content="{Binding [StartWithWindows], Source={x:Static services:LocalizationService.Instance}}" Style="{StaticResource ModernCheckBoxStyle}" Margin="0,0,0,10" IsChecked="True" Checked="CheckStartWithWindows_Checked" Unchecked="CheckStartWithWindows_Unchecked" />
                                    <CheckBox x:Name="CheckStartMinimized" Content="{Binding [StartMinimized], Source={x:Static services:LocalizationService.Instance}}" Style="{StaticResource ModernCheckBoxStyle}" Margin="0,0,0,10" Checked="CheckStartMinimized_Checked" Unchecked="CheckStartMinimized_Unchecked" />
                                    <CheckBox x:Name="CheckDesktopContextMenu" Content="{Binding [ShowDesktopContextMenu], Source={x:Static services:LocalizationService.Instance}}" Style="{StaticResource ModernCheckBoxStyle}" Margin="0,0,0,10" Checked="CheckDesktopContextMenu_Checked" Unchecked="CheckDesktopContextMenu_Unchecked" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Seção de Comportamento -->
                    <Border Style="{StaticResource SettingsCardStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource SettingsIconStyle}" VerticalAlignment="Top">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#F59E0B" Offset="0" />
                                        <GradientStop Color="#D97706" Offset="1" />
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="12" ShadowDepth="0" Color="#F59E0B" Opacity="0.4" />
                                </Border.Effect>
                                <Path Data="{StaticResource IconBolt}" Fill="White" Width="20" Height="20" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{Binding [BehaviorTitle], Source={x:Static services:LocalizationService.Instance}}" Style="{StaticResource SettingsSectionTitle}" />
                                <TextBlock Text="{Binding [BehaviorDesc], Source={x:Static services:LocalizationService.Instance}}" Style="{StaticResource SettingsSectionDesc}" />
                                <StackPanel>
                                    <CheckBox x:Name="CheckMinimizeToTray" Content="{Binding [MinimizeToTrayDesc], Source={x:Static services:LocalizationService.Instance}}" IsChecked="{Binding MinimizeToTrayChecked}" Style="{StaticResource ModernCheckBoxStyle}" Margin="0,0,0,10" />
                                    <CheckBox x:Name="CheckCloseToTray" Content="{Binding [CloseToTrayDesc], Source={x:Static services:LocalizationService.Instance}}" IsChecked="{Binding CloseToTrayChecked}" Style="{StaticResource ModernCheckBoxStyle}" Margin="0,0,0,10" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Seção de Notificações -->
                    <Border Style="{StaticResource SettingsCardStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource SettingsIconStyle}" VerticalAlignment="Top">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#8B5CF6" Offset="0" />
                                        <GradientStop Color="#7C3AED" Offset="1" />
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="12" ShadowDepth="0" Color="#8B5CF6" Opacity="0.4" />
                                </Border.Effect>
                                <Path Data="{StaticResource IconBell}" Fill="White" Width="20" Height="20" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1">
                                <TextBlock x:Name="NotificationSectionTitle" Text="{Binding [NotificationsTitle], Source={x:Static services:LocalizationService.Instance}}" Style="{StaticResource SettingsSectionTitle}" />
                                <TextBlock x:Name="NotificationSectionDesc" Text="{Binding [NotificationsDesc], Source={x:Static services:LocalizationService.Instance}}" Style="{StaticResource SettingsSectionDesc}" />
                                <StackPanel>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding [EnableNotifications], Source={x:Static services:LocalizationService.Instance}}" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" />
                                            <TextBlock Text="{Binding [EnableNotificationsDesc], Source={x:Static services:LocalizationService.Instance}}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="0,2,0,0" />
                                        </StackPanel>
                                        <CheckBox x:Name="CheckNotificationsEnabled" Grid.Column="1" Style="{StaticResource PremiumToggleStyle}" IsChecked="True" Checked="CheckNotificationsEnabled_Checked" Unchecked="CheckNotificationsEnabled_Unchecked" VerticalAlignment="Center" />
                                    </Grid>
                                    <CheckBox x:Name="CheckNotifyThreats" Content="{Binding [NotifyOnThreats], Source={x:Static services:LocalizationService.Instance}}" IsChecked="True" Style="{StaticResource ModernCheckBoxStyle}" Checked="CheckNotifyThreats_Changed" Unchecked="CheckNotifyThreats_Changed" Margin="0,0,0,8" />
                                    <CheckBox x:Name="CheckNotifyScanComplete" Content="{Binding [NotifyOnScanComplete], Source={x:Static services:LocalizationService.Instance}}" IsChecked="True" Style="{StaticResource ModernCheckBoxStyle}" Checked="CheckNotifyScanComplete_Changed" Unchecked="CheckNotifyScanComplete_Changed" Margin="0,0,0,8" />
                                    <CheckBox x:Name="CheckNotifyNewDevice" Content="{Binding [NotifyOnNewDevice], Source={x:Static services:LocalizationService.Instance}}" IsChecked="True" Style="{StaticResource ModernCheckBoxStyle}" Checked="CheckNotifyNewDevice_Changed" Unchecked="CheckNotifyNewDevice_Changed" Margin="0,0,0,4" />
                                    <Separator Background="#1AFFFFFF" Margin="0,8,0,8" />
                                    <Grid Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding [MuteToastPopups], Source={x:Static services:LocalizationService.Instance}}" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" />
                                            <TextBlock Text="{Binding [MuteToastPopupsDesc], Source={x:Static services:LocalizationService.Instance}}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="0,2,0,0" />
                                        </StackPanel>
                                        <CheckBox x:Name="CheckToastMuted" Grid.Column="1" Style="{StaticResource PremiumToggleStyle}" IsChecked="False" Checked="CheckToastMuted_Changed" Unchecked="CheckToastMuted_Changed" VerticalAlignment="Center" />
                                    </Grid>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Seção de Segurança e Modo Extremo -->
                    <Border Style="{StaticResource SettingsCardStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource SettingsIconStyle}" VerticalAlignment="Top">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#EF4444" Offset="0" />
                                        <GradientStop Color="#DC2626" Offset="1" />
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="12" ShadowDepth="0" Color="#EF4444" Opacity="0.4" />
                                </Border.Effect>
                                <Path Data="{StaticResource IconShield}" Fill="White" Width="20" Height="20" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{Binding [SecurityAdvancedTitle], Source={x:Static services:LocalizationService.Instance}}" Style="{StaticResource SettingsSectionTitle}" />
                                <TextBlock Text="{Binding [SecurityAdvancedDesc], Source={x:Static services:LocalizationService.Instance}}" Style="{StaticResource SettingsSectionDesc}" />
                                <Border Background="{DynamicResource DarkPanelAltBrush}" CornerRadius="12" Padding="14" Margin="0,0,0,14">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource IconShield}" Fill="#F59E0B" Width="16" Height="16" Stretch="Uniform" Margin="0,0,10,0" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding [RequiredElevatedPermissions], Source={x:Static services:LocalizationService.Instance}}" FontSize="12" Foreground="{DynamicResource WarningBrush}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                                <StackPanel>
                                    <CheckBox x:Name="CheckDryRun" Content="{Binding [DryRunOption], Source={x:Static services:LocalizationService.Instance}}" Style="{StaticResource ModernCheckBoxStyle}" Margin="0,0,0,10" Checked="CheckDryRun_Checked" Unchecked="CheckDryRun_Unchecked" />
                                    <CheckBox x:Name="CheckAllowWatchdog" Content="{Binding [AllowDpcWatchdog], Source={x:Static services:LocalizationService.Instance}}" Style="{StaticResource ModernCheckBoxStyle}" Checked="CheckAllowWatchdog_Checked" Unchecked="CheckAllowWatchdog_Unchecked" />
                                    <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                                        <TextBlock Text="{Binding [PrivilegeLevelLabel], Source={x:Static services:LocalizationService.Instance}}" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" />
                                        <TextBlock x:Name="AdminStatusText" Text="{Binding [Loc_Checking], Source={x:Static services:LocalizationService.Instance}}" VerticalAlignment="Center" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                    </StackPanel>
                                    <Button x:Name="RestartAdminButton" Content="{Binding [RestartAsAdmin], Source={x:Static services:LocalizationService.Instance}}" Style="{StaticResource NeonButtonStyle}" Height="36" Margin="0,12,0,0" HorizontalAlignment="Left" Padding="16,0" Click="RestartAsAdmin_Click" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>


                    <!-- Seção de Atualizações -->
                    <Border Style="{StaticResource SettingsCardStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource SettingsIconStyle}" VerticalAlignment="Top">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#8B31FF" Offset="0" />
                                        <GradientStop Color="#31A8FF" Offset="1" />
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="12" ShadowDepth="0" Color="#8B31FF" Opacity="0.4" />
                                </Border.Effect>
                                <Path Data="{StaticResource IconUpdate}" Fill="White" Width="20" Height="20" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{Binding [UpdatesTitle], Source={x:Static services:LocalizationService.Instance}}" Style="{StaticResource SettingsSectionTitle}" />
                                <TextBlock Text="{Binding [UpdatesDesc], Source={x:Static services:LocalizationService.Instance}}" Style="{StaticResource SettingsSectionDesc}" />
                                <Border Background="{DynamicResource DarkPanelAltBrush}" CornerRadius="12" Padding="14" Margin="0,0,0,14">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                            <Path Data="{StaticResource IconUpdate}" Fill="#3B82F6" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center" />
                                            <TextBlock x:Name="CurrentVersionText" Text="{Binding [CurrentVersionLoading], Source={x:Static services:LocalizationService.Instance}}" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="{StaticResource IconShield}" Fill="#10B981" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center" />
                                            <TextBlock x:Name="UpdateStatusText" Text="{Binding [UsingLatestVersion], Source={x:Static services:LocalizationService.Instance}}" FontSize="13" Foreground="{DynamicResource SuccessBrush}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                                <WrapPanel>
                                    <Button x:Name="CheckUpdatesButton" Content="{Binding [CheckUpdatesButton], Source={x:Static services:LocalizationService.Instance}}" Style="{StaticResource NeonButtonStyle}" Height="44" Padding="20,0" Margin="0,0,10,10" Click="CheckUpdatesButton_Click" />

                                    <!-- [UPDATE-FLUXO] SIMULADOR DE ATUALIZAÇÃO.
                                    Botão de TESTE. Percorre o fluxo inteiro
                                    (botão circular, arco, barra global, trava e
                                    os 3 idiomas) com progresso sintético.

                                    NÃO consulta o GitHub, NÃO baixa pacote e
                                    NÃO abre instalador — por isso dá para
                                    testar o estado "100% aguardando
                                    autorização", que na vida real fecharia o
                                    programa antes de ser visto. -->
                                    <Button x:Name="SimulateUpdateButton"
                                            Content="{Binding [UpdateFlowSimulation], Source={x:Static services:LocalizationService.Instance}}"
                                            Style="{StaticResource NeonButtonStyle}"
                                            Height="44" Padding="20,0" Margin="0,0,10,10"
                                            Click="SimulateUpdateButton_Click"
                                            ToolTip="Teste: não baixa nada, não acessa o GitHub" />
                                </WrapPanel>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- ═══════════════════════════════════════════════ -->
                    <!-- Seção Recursos Experimentais (Beta)            -->
                    <!-- ═══════════════════════════════════════════════ -->
                    <Border Style="{StaticResource SettingsCardStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource SettingsIconStyle}" VerticalAlignment="Top">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#F59E0B" Offset="0" />
                                        <GradientStop Color="#D97706" Offset="1" />
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="12" ShadowDepth="0" Color="#F59E0B" Opacity="0.4" />
                                </Border.Effect>
                                <Path Data="{StaticResource IconBolt}" Fill="White" Width="20" Height="20" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1">
                                <TextBlock x:Name="BetaSectionTitle" Text="{Binding [SettingsBetaTitle], Source={x:Static services:LocalizationService.Instance}}" Style="{StaticResource SettingsSectionTitle}" />
                                <TextBlock x:Name="BetaSectionDesc" Text="{Binding [SettingsBetaDesc], Source={x:Static services:LocalizationService.Instance}}" Style="{StaticResource SettingsSectionDesc}" TextWrapping="Wrap" />
                                <Separator Background="#1AFFFFFF" Margin="0,8,0,8" />
                                <!-- Toggle Mostrar Drivers -->
                                <Grid Margin="0,0,0,10" ToolTip="{Binding [SettingsBetaShowDriversTooltip], Source={x:Static services:LocalizationService.Instance}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding [SettingsBetaShowDriversTitle], Source={x:Static services:LocalizationService.Instance}}" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" />
                                        <TextBlock Text="{Binding [SettingsBetaShowDriversDesc], Source={x:Static services:LocalizationService.Instance}}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <CheckBox x:Name="ToggleShowDrivers" Grid.Column="1" Style="{StaticResource PremiumToggleStyle}" IsChecked="False" Checked="ToggleShowDrivers_Checked" Unchecked="ToggleShowDrivers_Unchecked" VerticalAlignment="Center" />
                                </Grid>
                                <!-- Toggle Mostrar Recuperar -->
                                <Grid Margin="0,0,0,4" ToolTip="{Binding [SettingsBetaShowRecoveryTooltip], Source={x:Static services:LocalizationService.Instance}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding [SettingsBetaShowRecoveryTitle], Source={x:Static services:LocalizationService.Instance}}" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" />
                                        <TextBlock Text="{Binding [SettingsBetaShowRecoveryDesc], Source={x:Static services:LocalizationService.Instance}}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <CheckBox x:Name="ToggleShowRecovery" Grid.Column="1" Style="{StaticResource PremiumToggleStyle}" IsChecked="False" Checked="ToggleShowRecovery_Checked" Unchecked="ToggleShowRecovery_Unchecked" VerticalAlignment="Center" />
                                </Grid>
                                <!-- Toggle Mostrar Shield -->
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Seção de Suporte -->
                    <Border Style="{StaticResource SettingsCardStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource SettingsIconStyle}" VerticalAlignment="Top">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#25D366" Offset="0" />
                                        <GradientStop Color="#128C7E" Offset="1" />
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="12" ShadowDepth="0" Color="#25D366" Opacity="0.4" />
                                </Border.Effect>
                                <Path Data="{StaticResource IconChat}" Fill="White" Width="20" Height="20" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{Binding [SupportPremiumTitle], Source={x:Static services:LocalizationService.Instance}}" Style="{StaticResource SettingsSectionTitle}" />
                                <TextBlock Text="{Binding [SupportPremiumDesc], Source={x:Static services:LocalizationService.Instance}}" Style="{StaticResource SettingsSectionDesc}" />
                                <Button x:Name="SupportButton" Content="{Binding [SupportPremiumButton], Source={x:Static services:LocalizationService.Instance}}" Style="{StaticResource NeonButtonStyle}" Height="44" Padding="24,0" HorizontalAlignment="Left" Click="SupportButton_Click" />
                            </StackPanel>
                        </Grid>
                    </Border>

                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
