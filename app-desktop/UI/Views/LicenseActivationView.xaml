<UserControl xmlns:converters="clr-namespace:VoltrisOptimizer.UI.Converters"
             xmlns:local="clr-namespace:VoltrisOptimizer.Services"
             x:Class="VoltrisOptimizer.UI.Views.LicenseActivationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             Background="Transparent"
             d:DesignHeight="768" d:DesignWidth="1280"
             FontFamily="Segoe UI Variable, Segoe UI"
             UseLayoutRounding="True" SnapsToDevicePixels="True"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <converters:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVis"/>
        <converters:StringToVisibilityConverter x:Key="StringToVisibility"/>

        <!-- ═════════════════════════════════════════════════════════════════ -->
        <!-- BUTTON STYLES -->
        <!-- ═════════════════════════════════════════════════════════════════ -->

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="MinHeight" Value="42"/>
            <Setter Property="Padding" Value="24,12"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="11" Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="18" ShadowDepth="0" Color="#8B31FF" Opacity="0.4" />
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#9B41FF" Offset="0"/>
                                            <GradientStop Color="#6B28D9" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#7B18D1" Offset="0"/>
                                            <GradientStop Color="#5B10A8" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PrimaryButtonBase" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="MinHeight" Value="42"/>
            <Setter Property="Padding" Value="24,12"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#8B31FF" Offset="0"/>
                        <GradientStop Color="#5B18CF" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="11" Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="18" ShadowDepth="0" Color="#8B31FF" Opacity="0.4" />
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#9B41FF" Offset="0"/>
                                            <GradientStop Color="#6B28D9" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#7B18D1" Offset="0"/>
                                            <GradientStop Color="#5B10A8" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Foreground" Value="#9CA3AF"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="MinHeight" Value="38"/>
            <Setter Property="Padding" Value="18,10"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="9" Padding="{TemplateBinding Padding}" 
                                BorderBrush="#2E3742" BorderThickness="{TemplateBinding BorderThickness}">
                            <Border.Background>
                                <SolidColorBrush Color="#0D0D16" Opacity="0.6"/>
                            </Border.Background>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background">
                                    <Setter.Value>
                                        <SolidColorBrush Color="#1A1A24" Opacity="0.8"/>
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#4B5563"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DangerButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="MinHeight" Value="42"/>
            <Setter Property="Padding" Value="24,12"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#FF4B6B" Offset="0"/>
                        <GradientStop Color="#E63350" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="11" Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="18" ShadowDepth="0" Color="#FF4B6B" Opacity="0.3" />
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#FF6B8B" Offset="0"/>
                                            <GradientStop Color="#F05070" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#E63350" Offset="0"/>
                                            <GradientStop Color="#C81E40" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ═════════════════════════════════════════════════════════════════ -->
        <!-- TEXT INPUT STYLE -->
        <!-- ═════════════════════════════════════════════════════════════════ -->

        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="#0D0D16"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="CaretBrush" Value="#8B31FF"/>
            <Setter Property="BorderBrush" Value="#308B31FF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="16,14"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontFamily" Value="Cascadia Code, Consolas, monospace"/>
            <Setter Property="Focusable" Value="True"/>
            <Setter Property="IsTabStop" Value="True"/>
            <Setter Property="AcceptsReturn" Value="False"/>
            <Setter Property="AcceptsTab" Value="False"/>
            <Setter Property="IsHitTestVisible" Value="True"/>
        </Style>
    </UserControl.Resources>

    <!-- ═════════════════════════════════════════════════════════════════════════════════════ -->
    <!-- MAIN CONTAINER GRID -->
    <!-- ═════════════════════════════════════════════════════════════════════════════════════ -->

    <Grid Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>    <!-- Breadcrumb -->
            <RowDefinition Height="*"/>        <!-- Content -->
            <RowDefinition Height="Auto"/>    <!-- Footer -->
        </Grid.RowDefinitions>

        <!-- ───────────────────────────────────────────────────────────────────────────────── -->
        <!-- BREADCRUMB & CONNECTION STATUS -->
        <!-- ───────────────────────────────────────────────────────────────────────────────── -->

        <Grid Grid.Row="0" Margin="20,16,20,12" Height="Auto">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="{Binding Source={x:Static local:LocalizationService.Instance}, Path=[LicBreadcrumbDashboard]}" Foreground="#6B7280" FontSize="12"/>
                <TextBlock Text=" / " Foreground="#4B5563" FontSize="12" Margin="6,0"/>
                <TextBlock Text="{Binding Source={x:Static local:LocalizationService.Instance}, Path=[LicBreadcrumbLicenses]}" Foreground="White" FontSize="12" FontWeight="SemiBold"/>
            </StackPanel>

            <Border Grid.Column="1" CornerRadius="20" Padding="12,6" VerticalAlignment="Center">
                <Border.Background>
                    <SolidColorBrush Color="#0D0D16" Opacity="0.5"/>
                </Border.Background>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="8" Height="8" VerticalAlignment="Center" Margin="0,0,8,0" Fill="#00FF88"/>
                    <TextBlock Text="{Binding ConnectionStatusText}" FontSize="11" Foreground="#A0AEC0" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ───────────────────────────────────────────────────────────────────────────────── -->
        <!-- MAIN CONTENT AREA -->
        <!-- ───────────────────────────────────────────────────────────────────────────────── -->

        <Grid Grid.Row="1" Margin="20,0,20,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*" MinWidth="300"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="1*" MinWidth="350"/>
            </Grid.ColumnDefinitions>

            <!-- ┌───────────────────────────────────────────────────────────────────────────┐ -->
            <!-- │ CARD ESQUERDO: STATUS DA LICENÇA & INFORMAÇÕES PRINCIPAIS              │ -->
            <!-- └───────────────────────────────────────────────────────────────────────────┘ -->

            <Border Grid.Column="0" CornerRadius="16" Padding="24">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#0D0D1A" Offset="0"/>
                        <GradientStop Color="#1A0D2E" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Border.BorderBrush>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#358B31FF" Offset="0"/>
                        <GradientStop Color="#1531A8FF" Offset="1"/>
                    </LinearGradientBrush>
                </Border.BorderBrush>
                <Border.BorderThickness>1</Border.BorderThickness>
                <Border.Effect>
                    <DropShadowEffect BlurRadius="24" ShadowDepth="0" Color="#8B31FF" Opacity="0.08"/>
                </Border.Effect>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="20"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="20"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="20"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="16"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- CENTERED ICON + LICENSE ACTIVATION HEADER -->
                    <StackPanel Grid.Row="0" Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Top">
                        <!-- Icon: License Activation -->
                        <Border Width="56" Height="56" CornerRadius="14" Margin="0,0,0,12" HorizontalAlignment="Center">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#FF4B6B" Offset="0"/>
                                    <GradientStop Color="#8B31FF" Offset="0.5"/>
                                    <GradientStop Color="#31A8FF" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="20" ShadowDepth="0" Color="#8B31FF" Opacity="0.7"/>
                            </Border.Effect>
                            <!-- License certificate icon: checkmark in document -->
                            <Path Data="M9,1C5.14,1 2,4.13 2,8V20C2,23.87 5.14,27 9,27H21C24.87,27 28,23.87 28,20V8C28,4.13 24.87,1 21,1H9M9,5H21C23.29,5 25,6.71 25,9V20C25,22.29 23.29,24 21,24H9C6.71,24 5,22.29 5,20V9C5,6.71 6.71,5 9,5M17,10L11,16L9,14V17L11,19L19,11V10Z"
                                  Fill="White" Width="32" Height="32" Stretch="Uniform" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>
                        
                        <!-- Header Text: ATIVAR LICENÇA -->
                        <TextBlock Text="{Binding Source={x:Static local:LocalizationService.Instance}, Path=[LicActivateHeader]}" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"
                                   Margin="0,0,0,8">
                            <TextBlock.Foreground>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#FF4B6B" Offset="0"/>
                                    <GradientStop Color="#8B31FF" Offset="0.5"/>
                                    <GradientStop Color="#31A8FF" Offset="1"/>
                                </LinearGradientBrush>
                            </TextBlock.Foreground>
                        </TextBlock>
                    </StackPanel>

                    <!-- Tagline -->
                    <TextBlock Grid.Row="2" Text="{Binding Source={x:Static local:LocalizationService.Instance}, Path=[LicUnlockFullPower]}" FontSize="18" FontWeight="Bold" 
                               Foreground="White" TextWrapping="Wrap" LineHeight="24"/>

                    <!-- Status - SEM LICENÇA -->
                    <StackPanel Grid.Row="4" Visibility="{Binding CanShowActivationForm, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{Binding Source={x:Static local:LocalizationService.Instance}, Path=[LicDeviceStatusLabel]}" FontSize="10" Foreground="#6B7280" FontWeight="SemiBold"/>
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <Ellipse Width="8" Height="8" VerticalAlignment="Center" Margin="0,0,8,0" Fill="#FF4B6B"/>
                            <TextBlock Text="{Binding Source={x:Static local:LocalizationService.Instance}, Path=[LicFreeVersionLabel]}" FontSize="13" FontWeight="SemiBold" Foreground="#FF4B6B"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Trial Progress - SEM LICENÇA -->
                    <StackPanel Grid.Row="4" Visibility="{Binding CanShowActivationForm, Converter={StaticResource BoolToVis}}" Margin="0,0,0,0"/>

                    <!-- Status - COM LICENÇA -->
                    <StackPanel Grid.Row="4" Visibility="{Binding CanShowLicenseInfo, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{Binding Source={x:Static local:LocalizationService.Instance}, Path=[LicActiveLabel]}" FontSize="10" Foreground="#6B7280" FontWeight="SemiBold"/>
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <Ellipse Width="8" Height="8" VerticalAlignment="Center" Margin="0,0,8,0" Fill="#00FF88"/>
                            <TextBlock Text="{Binding Source={x:Static local:LocalizationService.Instance}, Path=[LicVerifiedLabel]}" FontSize="13" FontWeight="SemiBold" Foreground="#00FF88"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- License Type Display - COM LICENÇA -->
                    <TextBlock Grid.Row="6" Text="{Binding ActiveLicenseType}" FontSize="20" FontWeight="Bold"
                               Visibility="{Binding CanShowLicenseInfo, Converter={StaticResource BoolToVis}}">
                        <TextBlock.Foreground>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#FF5A7F" Offset="0"/>
                                <GradientStop Color="#D946FF" Offset="0.55"/>
                                <GradientStop Color="#00E5FF" Offset="1"/>
                            </LinearGradientBrush>
                        </TextBlock.Foreground>
                    </TextBlock>

                    <!-- Trial Progress Bar - SEM LICENÇA -->
                    <Grid Grid.Row="8" Visibility="{Binding CanShowActivationForm, Converter={StaticResource BoolToVis}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="6"/>
                        </Grid.RowDefinitions>
                        <Grid Margin="0,0,0,6">
                            <TextBlock Text="{Binding Source={x:Static local:LocalizationService.Instance}, Path=[LicTrialLabel]}" FontSize="11" Foreground="#6B7280" FontWeight="SemiBold"/>
                            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                                <TextBlock FontSize="11" Foreground="#6B7280" FontWeight="SemiBold">
                                    <Run Text="{Binding TrialProgressPercent, StringFormat='{}{0:0}'}"/><Run Text="%"/>
                                </TextBlock>
                            </StackPanel>
                        </Grid>
                        <ProgressBar Grid.Row="1" Height="6" BorderThickness="0" Background="#0DFFFFFF" Value="{Binding TrialProgressPercent, Mode=OneWay}">
                            <ProgressBar.Foreground>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#31A8FF" Offset="0"/>
                                    <GradientStop Color="#8B31FF" Offset="0.5"/>
                                    <GradientStop Color="#FF4B6B" Offset="1"/>
                                </LinearGradientBrush>
                            </ProgressBar.Foreground>
                        </ProgressBar>
                    </Grid>

                    <!-- Hardware ID Card -->
                    <Border Grid.Row="10" Background="#0AFFFFFF" BorderBrush="#10FFFFFF"
                            BorderThickness="1" CornerRadius="12" Padding="14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Border Width="32" Height="32" CornerRadius="8" Background="#0A8B31FF" Margin="0,0,12,0">
                                <Path Data="M5,3H19A2,2 0 0,1 21,5V19A2,2 0 0,1 19,21H5A2,2 0 0,1 3,19V5A2,2 0 0,1 5,3M5,5V19H19V5H5Z"
                                      Fill="White" Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            </Border>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Source={x:Static local:LocalizationService.Instance}, Path=[LicHardwareIdLabel]}" FontSize="10" Foreground="#6B7280" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding HwidDisplay}" FontSize="11" FontFamily="Cascadia Code, Consolas"
                                           Foreground="#A0AEC0" Margin="0,3,0,0"/>
                            </StackPanel>

                            <Button Grid.Column="2" Style="{StaticResource SecondaryButton}"
                                    Command="{Binding CopyHwidCommand}"
                                    Padding="10,6" VerticalAlignment="Center" MinHeight="32" Margin="0,0,8,0">
                                <TextBlock Text="{Binding Source={x:Static local:LocalizationService.Instance}, Path=[LicCopyButton]}" FontSize="11"/>
                            </Button>

                            <!-- Status Message (Copiado) - Hardware ID -->
                            <TextBlock Grid.Column="3" Text="{Binding HwidStatusMessage}" FontSize="11" FontWeight="SemiBold"
                                       Foreground="#00FF88" VerticalAlignment="Center"
                                       Visibility="{Binding HwidStatusMessage, Converter={StaticResource StringToVisibility}}">
                                <TextBlock.ToolTip>
                                    <ToolTip Background="#00FF88" Foreground="#0C0C18" HasDropShadow="True" Padding="8,4">
                                        <TextBlock Text="{Binding HwidStatusMessage}" FontSize="11" FontWeight="SemiBold"/>
                                    </ToolTip>
                                </TextBlock.ToolTip>
                            </TextBlock>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- ┌───────────────────────────────────────────────────────────────────────────┐ -->
            <!-- │ CARD DIREITO: ATIVAÇÃO / GERENCIAMENTO DE LICENÇA                       │ -->
            <!-- └───────────────────────────────────────────────────────────────────────────┘ -->

            <Border Grid.Column="2" CornerRadius="16" Padding="24">
                <Border.Background>
                    <SolidColorBrush Color="#0C0C18"/>
                </Border.Background>
                <Border.BorderBrush>
                    <SolidColorBrush Color="#18FFFFFF"/>
                </Border.BorderBrush>
                <Border.BorderThickness>1</Border.BorderThickness>
                <Border.Effect>
                    <DropShadowEffect BlurRadius="24" ShadowDepth="0" Color="#8B31FF" Opacity="0.06"/>
                </Border.Effect>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- ═══ MODO ATIVAÇÃO ═══ -->
                    <!-- Header -->
                    <TextBlock Grid.Row="0" Text="{Binding Source={x:Static local:LocalizationService.Instance}, Path=[LicActivationFormHeader]}" FontSize="16" FontWeight="Bold" Foreground="White"
                               Visibility="{Binding CanShowActivationForm, Converter={StaticResource BoolToVis}}"/>

                    <!-- Subtitle -->
                    <TextBlock Grid.Row="2" Text="{Binding Source={x:Static local:LocalizationService.Instance}, Path=[LicActivationQuestion]}" FontSize="12" Foreground="#9CA3AF" TextWrapping="Wrap"
                               Visibility="{Binding CanShowActivationForm, Converter={StaticResource BoolToVis}}"/>

                    <!-- Input Field -->
                    <TextBox Grid.Row="4" x:Name="LicenseKeyInput" Style="{StaticResource ModernTextBox}"
                             Text="{Binding LicenseKey, UpdateSourceTrigger=PropertyChanged}"
                             Height="44"
                             TextAlignment="Center"
                             VerticalContentAlignment="Center"
                             Visibility="{Binding CanShowActivationForm, Converter={StaticResource BoolToVis}}"/>

                    <!-- Help Text -->
                    <TextBlock Grid.Row="6" Text="{Binding Source={x:Static local:LocalizationService.Instance}, Path=[LicKeyFormat]}"
                               FontSize="10" Foreground="#6B7280"
                               Visibility="{Binding CanShowActivationForm, Converter={StaticResource BoolToVis}}"/>

                    <!-- Activate Button -->
                    <Button Grid.Row="8" x:Name="ActivateButton" Style="{StaticResource PrimaryButtonBase}"
                            Command="{Binding ActivateCommand}" IsEnabled="{Binding CanActivate}"
                            HorizontalAlignment="Stretch" MinHeight="44"
                            Visibility="{Binding CanShowActivationForm, Converter={StaticResource BoolToVis}}">
                        <TextBlock FontSize="13" FontWeight="SemiBold">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="{Binding Source={x:Static local:LocalizationService.Instance}, Path=[LicActivateButtonText]}"/>
                                    <Setter Property="Foreground" Value="White"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsActivating}" Value="True">
                                            <Setter Property="Text" Value="{Binding Source={x:Static local:LocalizationService.Instance}, Path=[LicActivatingText]}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Button>

                    <!-- Sync Button (no modo ativação, fica na linha 10) -->
                    <Button Grid.Row="10" Style="{StaticResource SecondaryButton}"
                            Command="{Binding SyncWithServerCommand}"
                            HorizontalAlignment="Stretch" MinHeight="40"
                            Visibility="{Binding CanShowActivationForm, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{Binding Source={x:Static local:LocalizationService.Instance}, Path=[LicSyncButtonText]}" FontSize="12"/>
                    </Button>

                    <!-- ═══ MODO GERENCIAMENTO (COM LICENÇA) ═══ -->
                    <!-- License Info: Key -->
                    <TextBlock Grid.Row="0" Text="{Binding Source={x:Static local:LocalizationService.Instance}, Path=[LicKeyLabel]}" FontSize="10" Foreground="#6B7280" FontWeight="SemiBold"
                               Visibility="{Binding CanShowLicenseInfo, Converter={StaticResource BoolToVis}}"/>
                    
                    <StackPanel Grid.Row="2" Orientation="Horizontal"
                                Visibility="{Binding CanShowLicenseInfo, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{Binding ActiveLicenseKey}" FontSize="11" FontFamily="Cascadia Code, Consolas"
                                   Foreground="#A0AEC0" VerticalAlignment="Center" TextWrapping="Wrap"/>
                        <Button Style="{StaticResource SecondaryButton}"
                                Command="{Binding CopyLicenseKeyCommand}"
                                Padding="10,6" Margin="8,0,0,0" MinHeight="32">
                            <TextBlock Text="{Binding Source={x:Static local:LocalizationService.Instance}, Path=[LicCopyKeyButton]}" FontSize="10"/>
                        </Button>

                        <!-- Status Message para Licença (Copiado) -->
                        <TextBlock Text="{Binding LicenseStatusMessage}" FontSize="11" FontWeight="SemiBold"
                                   Foreground="#00FF88" VerticalAlignment="Center" Margin="8,0,0,0"
                                   Visibility="{Binding LicenseStatusMessage, Converter={StaticResource StringToVisibility}}">
                            <TextBlock.ToolTip>
                                <ToolTip Background="#00FF88" Foreground="#0C0C18" HasDropShadow="True" Padding="8,4">
                                    <TextBlock Text="{Binding LicenseStatusMessage}" FontSize="11" FontWeight="SemiBold"/>
                                </ToolTip>
                            </TextBlock.ToolTip>
                        </TextBlock>
                    </StackPanel>

                    <!-- License Info: Activation Date -->
                    <TextBlock Grid.Row="4" Text="{Binding Source={x:Static local:LocalizationService.Instance}, Path=[LicActivationDateLabel]}" FontSize="10" Foreground="#6B7280" FontWeight="SemiBold"
                               Visibility="{Binding CanShowLicenseInfo, Converter={StaticResource BoolToVis}}"/>
                    
                    <TextBlock Grid.Row="6" Text="{Binding LicenseActivationDate, StringFormat='dd/MM/yyyy HH:mm'}"
                               FontSize="12" Foreground="White"
                               Visibility="{Binding CanShowLicenseInfo, Converter={StaticResource BoolToVis}}"/>

                    <!-- License Info: Validity -->
                    <TextBlock Grid.Row="8" Text="{Binding Source={x:Static local:LocalizationService.Instance}, Path=[LicValidityLabel]}" FontSize="10" Foreground="#6B7280" FontWeight="SemiBold"
                               Visibility="{Binding CanShowLicenseInfo, Converter={StaticResource BoolToVis}}"/>
                    
                    <TextBlock Grid.Row="9" Text="{Binding LicenseValidityDisplay}" FontSize="12" Foreground="#00FF88"
                               Visibility="{Binding CanShowLicenseInfo, Converter={StaticResource BoolToVis}}"/>

                    <!-- ═════════════════════════════════════════════════════════════════ -->
                    <!-- MODO DESATIVAÇÃO: Confirmação/Cancelamento -->
                    <!-- ═════════════════════════════════════════════════════════════════ -->
                    
                    <!-- Aviso de desativação -->
                    <StackPanel Grid.Row="8" Orientation="Vertical" 
                                Visibility="{Binding ShowDeactivationDialog, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{Binding Source={x:Static local:LocalizationService.Instance}, Path=[LicDeactivationWarning]}" FontSize="14" FontWeight="Bold" Foreground="#FF4B6B" Margin="0,0,0,8"/>
                        <TextBlock Text="{Binding Source={x:Static local:LocalizationService.Instance}, Path=[LicDeactivationConfirm]}" FontSize="12" Foreground="#A0AEC0" TextWrapping="Wrap" Margin="0,0,0,4"/>
                        <TextBlock Text="{Binding Source={x:Static local:LocalizationService.Instance}, Path=[LicDeactivationLoseMessage]}" FontSize="11" Foreground="#6B7280" TextWrapping="Wrap"/>
                    </StackPanel>
                    
                    <!-- Botões de confirmação/cancelamento -->
                    <StackPanel Grid.Row="10" Orientation="Vertical"
                                Visibility="{Binding ShowDeactivationDialog, Converter={StaticResource BoolToVis}}">
                        <Button Style="{StaticResource DangerButton}" HorizontalAlignment="Stretch"
                                Command="{Binding ConfirmDeactivationCommand}" Margin="0,0,0,8" MinHeight="42">
                            <TextBlock Text="{Binding Source={x:Static local:LocalizationService.Instance}, Path=[LicYesDeactivate]}" FontSize="12"/>
                        </Button>
                        <Button Style="{StaticResource SecondaryButton}" HorizontalAlignment="Stretch"
                                Command="{Binding CancelDeactivationCommand}" MinHeight="42">
                            <TextBlock Text="{Binding Source={x:Static local:LocalizationService.Instance}, Path=[LicCancel]}" FontSize="12"/>
                        </Button>
                    </StackPanel>

                    <!-- Action Buttons (no modo gerenciamento, ficam na linha 10) -->
                    <StackPanel Grid.Row="10" Orientation="Vertical"
                                Visibility="{Binding CanShowLicenseInfo, Converter={StaticResource BoolToVis}}">
                        <Button Style="{StaticResource SecondaryButton}" HorizontalAlignment="Stretch"
                                Command="{Binding ChangeLicenseCommand}" Margin="0,0,0,8" MinHeight="40">
                            <TextBlock Text="{Binding Source={x:Static local:LocalizationService.Instance}, Path=[LicChangeButton]}" FontSize="12"/>
                        </Button>
                        <Button Style="{StaticResource DangerButton}" HorizontalAlignment="Stretch"
                                Command="{Binding DeactivateLicenseCommand}" MinHeight="40">
                            <TextBlock Text="{Binding Source={x:Static local:LocalizationService.Instance}, Path=[LicDeactivateButton]}" FontSize="12"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- ───────────────────────────────────────────────────────────────────────────────── -->
        <!-- FOOTER -->
        <!-- ───────────────────────────────────────────────────────────────────────────────── -->

        <Border Grid.Row="2" Background="#0D0D1A" BorderBrush="#1A1A28" BorderThickness="0,1,0,0" Padding="20,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Source={x:Static local:LocalizationService.Instance}, Path=[LicFooterCopyright]}"
                           FontSize="10" Foreground="#6B7280" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Source={x:Static local:LocalizationService.Instance}, Path=[LicFooterId]}" FontSize="9" Foreground="#4B5563" Margin="0,0,8,0"/>
                    <TextBlock Text="{Binding DeviceId}" FontSize="9" FontFamily="Cascadia Code, Consolas" Foreground="#6B7280"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
