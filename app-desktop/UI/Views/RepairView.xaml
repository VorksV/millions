<UserControl xmlns:services="clr-namespace:VoltrisOptimizer.Services" x:Class="VoltrisOptimizer.UI.Views.RepairView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Background="Transparent"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             d:DesignHeight="700" d:DesignWidth="1000">

    <UserControl.DataContext>
        <Binding Path="RepairVM" Source="{StaticResource Locator}"/>
    </UserControl.DataContext>

    <UserControl.Resources>
        <LinearGradientBrush x:Key="RepairGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#F59E0B" Offset="0"/>
            <GradientStop Color="#EF4444" Offset="0.5"/>
            <GradientStop Color="#8B31FF" Offset="1"/>
        </LinearGradientBrush>

        <Style x:Key="GlassCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource BgCardGlass}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderLight}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="20"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource BorderAccent}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Tool Card Button Style -->
        <Style x:Key="ToolCardButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="CardBorder" Background="#08FFFFFF" CornerRadius="14"
                                BorderBrush="{DynamicResource BorderLight}" BorderThickness="1"
                                Padding="20,16" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CardBorder" Property="Background" Value="#12FFFFFF"/>
                                <Setter TargetName="CardBorder" Property="BorderBrush" Value="{DynamicResource BorderAccent}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="CardBorder" Property="Background" Value="#0AFFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Storyboard x:Key="EntryAnimation">
            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.6">
                <DoubleAnimation.EasingFunction>
                    <ExponentialEase EasingMode="EaseOut" Exponent="5"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
    </UserControl.Resources>

    <UserControl.Triggers>
        <EventTrigger RoutedEvent="UserControl.Loaded">
            <BeginStoryboard Storyboard="{StaticResource EntryAnimation}"/>
        </EventTrigger>
    </UserControl.Triggers>

    <Grid>
        <!-- Background decorativo (GPU-friendly, sem BlurEffect) -->
        <Grid IsHitTestVisible="False" ClipToBounds="True">
            <Ellipse Width="500" Height="500" 
                     HorizontalAlignment="Right" VerticalAlignment="Top"
                     Margin="0,-180,-100,0" Opacity="0.07">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#F59E0B" Offset="0"/>
                        <GradientStop Color="Transparent" Offset="1"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
            <Ellipse Width="400" Height="400" 
                     HorizontalAlignment="Left" VerticalAlignment="Bottom"
                     Margin="-100,0,0,-100" Opacity="0.05">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#8B31FF" Offset="0"/>
                        <GradientStop Color="Transparent" Offset="1"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
        </Grid>

        <!-- Main Layout: NO ScrollViewer -->
        <Grid Margin="24,20,24,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>   <!-- Row 0: Header -->
                <RowDefinition Height="12"/>     <!-- Row 1: Spacer -->
                <RowDefinition Height="Auto"/>   <!-- Row 2: Actions -->
                <RowDefinition Height="12"/>     <!-- Row 3: Spacer -->
                <RowDefinition Height="*"/>      <!-- Row 4: Tools (fills remaining) -->
                <RowDefinition Height="12"/>     <!-- Row 5: Spacer -->
                <RowDefinition Height="100"/>    <!-- Row 6: Log Console -->
            </Grid.RowDefinitions>

            <!-- ROW 0: HEADER -->
            <Border Grid.Row="0" Style="{StaticResource GlassCard}" Padding="20,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="42" Height="42" CornerRadius="10" Margin="0,0,14,0">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#F59E0B" Offset="0"/>
                                    <GradientStop Color="#EF4444" Offset="0.5"/>
                                    <GradientStop Color="#8B31FF" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Path Data="{StaticResource RepairIcon}" 
                                  Fill="White" Width="20" Height="20" Stretch="Uniform" 
                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding [Loc_Repair], Source={x:Static services:LocalizationService.Instance}}" 
                                       FontFamily="Segoe UI Variable Display, Segoe UI"
                                       FontSize="20" FontWeight="Bold">
                                <TextBlock.Foreground>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#F59E0B" Offset="0"/>
                                        <GradientStop Color="#EF4444" Offset="0.5"/>
                                        <GradientStop Color="#8B31FF" Offset="1"/>
                                    </LinearGradientBrush>
                                </TextBlock.Foreground>
                            </TextBlock>
                            <TextBlock Text="{Binding [Loc_IndepthMaintenanceAndSystemBug], Source={x:Static services:LocalizationService.Instance}}" 
                                       FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Opacity="0.7" Margin="0,2,0,0"/>
                        </StackPanel>
                    </StackPanel>

                    <WrapPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="#0AFFFFFF" CornerRadius="8" Padding="12,6" Margin="0,0,8,0">
                            <StackPanel>
                                <TextBlock Text="{Binding [Loc_System_2], Source={x:Static services:LocalizationService.Instance}}" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" Opacity="0.7"/>
                                <TextBlock x:Name="OsVersionText" Text="{Binding OsVersion}" FontSize="12" FontWeight="Medium" 
                                           Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Border>
                        <Border Background="#0AFFFFFF" CornerRadius="8" Padding="12,6">
                            <StackPanel>
                                <TextBlock Text="{Binding [Loc_Status], Source={x:Static services:LocalizationService.Instance}}" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" Opacity="0.7"/>
                                <TextBlock x:Name="RepairStatusText" Text="{Binding ProgressStatus}" FontSize="12" FontWeight="Medium" 
                                           Foreground="#10B981"/>
                            </StackPanel>
                        </Border>
                    </WrapPanel>
                </Grid>
            </Border>

            <!-- ROW 2: ACTION BUTTONS -->
            <Border Grid.Row="2" Style="{StaticResource GlassCard}" Padding="20,10">
                <Grid VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding [Loc_RepairAndMaintenance], Source={x:Static services:LocalizationService.Instance}}" FontSize="13" FontWeight="Bold" 
                                   Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,2"/>
                        <TextBlock Text="{Binding [Loc_ChooseARepairActionFull], Source={x:Static services:LocalizationService.Instance}}" 
                                   FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Opacity="0.7"/>
                    </StackPanel>

                    <WrapPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                        <Button x:Name="FullRepairButton" Command="{Binding FullRepairCommand}" Cursor="Hand" MinWidth="180" MinHeight="36" Margin="0,0,8,0">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
                                    <Setter Property="Padding" Value="16,8"/>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal">
                                <Path Data="M11,15H6L13,1V9H18L11,23V15Z" Fill="#FFFFFF" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding [Loc_CompleteRepair], Source={x:Static services:LocalizationService.Instance}}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="RepairSystemButton" Command="{Binding RepairSystemCommand}" Cursor="Hand" MinWidth="180" MinHeight="36">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource NeonButtonStyle}">
                                    <Setter Property="Padding" Value="16,8"/>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal">
                                <Path Data="M13.78,15.3L19.78,21.3L21.89,19.14L15.89,13.14L13.78,15.3M17.5,10C17.5,10 15.55,12.43 14.21,11.24C12.87,10.05 15.35,8.12 15.35,8.12L16.4,7.05C15.69,6.33 14.67,5.88 13.55,5.88C11.23,5.88 9.35,7.76 9.35,10.08C9.35,11.21 9.8,12.22 10.53,12.92L9.36,14.09C8.36,13.23 7.04,12.7 5.61,12.7C2.51,12.7 0,15.21 0,18.31C0,19.86 0.63,21.26 1.64,22.27L3.71,20.21L4.85,21.34L2.78,23.41C3.79,24.42 5.19,25.05 6.74,25.05C9.84,25.05 12.35,22.54 12.35,19.44C12.35,18.01 11.82,16.69 10.96,15.69L12.13,14.52C12.83,15.25 13.84,15.7 14.97,15.7C17.29,15.7 19.17,13.82 19.17,11.5C19.17,10.38 18.72,9.36 18,8.65L17.5,10Z" Fill="#FFFFFF" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding [Loc_DismsfcRepair], Source={x:Static services:LocalizationService.Instance}}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </WrapPanel>
                </Grid>
            </Border>

            <!-- ROW 4: TOOLS AREA (fills remaining space) -->
            <Border Grid.Row="4" Style="{StaticResource GlassCard}" Padding="16" ClipToBounds="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>  <!-- Section Title -->
                        <RowDefinition Height="12"/>    <!-- Spacer -->
                        <RowDefinition Height="*"/>     <!-- Cards Grid -->
                    </Grid.RowDefinitions>

                    <!-- Section Title -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal">
                        <Border Width="30" Height="30" CornerRadius="8" Margin="0,0,10,0">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#EC4899" Offset="0"/>
                                    <GradientStop Color="#BE185D" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Path Data="M19.34,14.04C19.38,13.7 19.41,13.36 19.41,13C19.41,12.64 19.38,12.3 19.34,11.96L21.36,10.38C21.54,10.24 21.6,10 21.5,9.81L19.59,6.5C19.47,6.31 19.23,6.23 19.03,6.3L16.66,7.25C16.16,6.87 15.62,6.55 15.04,6.31L14.68,3.79C14.65,3.58 14.47,3.42 14.26,3.42H10.45C10.23,3.42 10.05,3.58 10.02,3.79L9.66,6.31C9.08,6.55 8.54,6.87 8.04,7.25L5.67,6.3C5.47,6.23 5.23,6.31 5.11,6.5L3.2,9.81C3.1,10 3.16,10.24 3.34,10.38L5.36,11.96C5.32,12.3 5.29,12.64 5.29,13C5.29,13.36 5.32,13.7 5.36,14.04L3.34,15.62C3.16,15.76 3.1,16 3.2,16.19L5.11,19.5C5.23,19.69 5.47,19.77 5.67,19.7L8.04,18.75C8.54,19.13 9.08,19.45 9.66,19.69L10.02,22.21C10.05,22.42 10.23,22.58 10.45,22.58H14.26C14.47,22.58 14.65,22.42 14.68,22.21L15.04,19.69C15.62,19.45 16.16,19.13 16.66,18.75L19.03,19.7C19.23,19.77 19.47,19.69 19.59,19.5L21.5,16.19C21.6,16 21.54,15.76 21.36,15.62L19.34,14.04M12.35,16.29C10.53,16.29 9.06,14.81 9.06,13C9.06,11.19 10.53,9.71 12.35,9.71C14.17,9.71 15.64,11.19 15.64,13C15.64,14.81 14.17,16.29 12.35,16.29M12.35,11A2,2 0 0,0 10.35,13A2,2 0 0,0 12.35,15A2,2 0 0,0 14.35,13A2,2 0 0,0 12.35,11Z" Fill="#FFFFFF" Width="14" Height="14" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding [Loc_WindowsTools], Source={x:Static services:LocalizationService.Instance}}" FontSize="14" FontWeight="SemiBold" 
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="{Binding [Loc_NativeToolsForMaintenanceAnd], Source={x:Static services:LocalizationService.Instance}}" 
                                       FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Opacity="0.6"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Tool Cards Grid — fills remaining space evenly -->
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Limpeza de Disco Card -->
                        <Button Grid.Column="0" x:Name="DiskCleanupButton" Command="{Binding DiskCleanupCommand}" Style="{StaticResource ToolCardButtonStyle}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Icon + Title -->
                                <StackPanel Grid.Row="0" Orientation="Horizontal">
                                    <Border Width="40" Height="40" CornerRadius="10" Margin="0,0,12,0">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                <GradientStop Color="#00C6FF" Offset="0"/>
                                                <GradientStop Color="#0072FF" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                        <Viewbox Width="20" Height="20" Margin="10">
                                            <Path Data="M19.36,2.72L20.78,4.14L15.06,9.85C16.13,11.39 16.28,13.24 15.38,14.44L9.06,8.12C10.26,7.22 12.11,7.37 13.65,8.44L19.36,2.72M5.93,17.57C3.92,15.56 2.69,13.16 2.35,10.92L7.23,8.83L14.67,16.27L12.58,21.15C10.34,20.81 7.94,19.58 5.93,17.57Z" Fill="White"/>
                                        </Viewbox>
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding [Loc_DiskCleanup], Source={x:Static services:LocalizationService.Instance}}" FontSize="14" FontWeight="SemiBold" 
                                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        <TextBlock Text="{Binding [Loc_Cleanmgrexe], Source={x:Static services:LocalizationService.Instance}}" FontSize="10" FontFamily="Consolas" 
                                                   Foreground="{DynamicResource TextMutedBrush}" Opacity="0.5"/>
                                    </StackPanel>
                                </StackPanel>

                                <!-- Description -->
                                <TextBlock Grid.Row="1" 
                                           Text="{Binding [Loc_RemovesTemporaryFilesCacheAnd], Source={x:Static services:LocalizationService.Instance}}" 
                                           FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Opacity="0.7" 
                                           TextWrapping="Wrap" Margin="0,10,0,0" VerticalAlignment="Top"/>

                                <!-- Footer -->
                                <Border Grid.Row="2" Background="#0AFFFFFF" CornerRadius="8" Padding="0,8" Margin="0,10,0,0">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <TextBlock Text="{Binding [Loc_OpenTool], Source={x:Static services:LocalizationService.Instance}}" FontSize="12" FontWeight="SemiBold" 
                                                   Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                        <Path Data="M8.59,16.58L13.17,12L8.59,7.41L10,6L16,12L10,18L8.59,16.58Z" 
                                              Fill="#3B82F6" Width="14" Height="14" 
                                              Stretch="Uniform" Margin="6,0,0,0" VerticalAlignment="Center" Opacity="0.8"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Button>

                        <!-- Desfragmentar Card -->
                        <Button Grid.Column="2" x:Name="DefragButton" Command="{Binding StartDefragCommand}" Style="{StaticResource ToolCardButtonStyle}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Icon + Title -->
                                <StackPanel Grid.Row="0" Orientation="Horizontal">
                                    <Border Width="40" Height="40" CornerRadius="10" Margin="0,0,12,0">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                <GradientStop Color="#F59E0B" Offset="0"/>
                                                <GradientStop Color="#EF4444" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                        <Viewbox Width="22" Height="22" Margin="9">
                                            <Path Data="M4,4C2.89,4 2,4.89 2,6V10C2,11.11 2.89,12 4,12H20C21.11,12 22,11.11 22,10V6C22,4.89 21.11,4 20,4H4M4,6H20V10H4V6M5,7V9H7V7H5M8,7V9H10V7H8M4,14C2.89,14 2,14.89 2,16V20C2,21.11 2.89,22 4,22H20C21.11,22 22,21.11 22,20V16C22,14.89 21.11,14 20,14H4M4,16H20V20H4V16M5,17V19H7V17H5M8,17V19H10V17H8Z" Fill="White"/>
                                        </Viewbox>
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding [Loc_OptimizeUnits], Source={x:Static services:LocalizationService.Instance}}" FontSize="14" FontWeight="SemiBold" 
                                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        <TextBlock Text="{Binding [Loc_SsdTrimHddDefrag], Source={x:Static services:LocalizationService.Instance}}" FontSize="10" FontFamily="Consolas" 
                                                   Foreground="{DynamicResource TextMutedBrush}" Opacity="0.5"/>
                                    </StackPanel>
                                </StackPanel>

                                <!-- Description -->
                                <TextBlock Grid.Row="1" 
                                           Text="{Binding [Loc_AutomaticallyDetectsSsdAndHdd], Source={x:Static services:LocalizationService.Instance}}" 
                                           FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Opacity="0.7" 
                                           TextWrapping="Wrap" Margin="0,10,0,0" VerticalAlignment="Top"/>

                                <!-- Footer -->
                                <Border Grid.Row="2" Background="#0AFFFFFF" CornerRadius="8" Padding="0,8" Margin="0,10,0,0">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <TextBlock Text="{Binding [Loc_StartOptimization], Source={x:Static services:LocalizationService.Instance}}" FontSize="12" FontWeight="SemiBold" 
                                                   Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                        <Path Data="M8.59,16.58L13.17,12L8.59,7.41L10,6L16,12L10,18L8.59,16.58Z" 
                                              Fill="#F59E0B" Width="14" Height="14" 
                                              Stretch="Uniform" Margin="6,0,0,0" VerticalAlignment="Center" Opacity="0.8"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Button>
                    </Grid>
                </Grid>
            </Border>

            <!-- ROW 6: LOG CONSOLE -->
            <Border Grid.Row="6" Style="{StaticResource GlassCard}" Padding="14,10" ClipToBounds="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="{Binding [Loc_RepairConsole], Source={x:Static services:LocalizationService.Instance}}" FontSize="9" FontWeight="Bold" 
                               Foreground="{DynamicResource TextMutedBrush}" Opacity="0.5" Margin="0,0,0,6"/>

                    <ScrollViewer Grid.Row="1" x:Name="LogScrollViewer" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="LogViewerItems" Focusable="False" ItemsSource="{Binding Logs}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Message}" Foreground="{Binding Color}" 
                                               FontFamily="Consolas, Courier New" FontSize="11" Margin="0,1" 
                                               TextTrimming="CharacterEllipsis"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
