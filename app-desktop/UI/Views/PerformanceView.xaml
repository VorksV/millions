<UserControl xmlns:services="clr-namespace:VoltrisOptimizer.Services" x:Class="VoltrisOptimizer.UI.Views.PerformanceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:VoltrisOptimizer.UI.ViewModels"
             xmlns:conv="clr-namespace:VoltrisOptimizer.UI.Converters"
             xmlns:views="clr-namespace:VoltrisOptimizer.UI.Views"
             xmlns:controls="clr-namespace:VoltrisOptimizer.UI.Controls"
             xmlns:license="clr-namespace:VoltrisOptimizer.Services.License"
             Background="{DynamicResource DarkBrush}"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch">
    <UserControl.DataContext>
        <Binding Source="{StaticResource Locator}" Path="PerformanceVM" />
    </UserControl.DataContext>

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <conv:ColorToBrushConverter x:Key="ColorToBrushConverter"/>
    </UserControl.Resources>

    <UserControl.Triggers>
        <EventTrigger RoutedEvent="Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.4"/>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </UserControl.Triggers>

    <Grid>
        <!-- Background decorativo -->
        <Grid IsHitTestVisible="False" ClipToBounds="True">
            <Ellipse Width="450" Height="450"
                     Fill="{DynamicResource AccentBlurBrush}"
                     HorizontalAlignment="Right" VerticalAlignment="Top"
                     Margin="0,-100,-180,0">
                <Ellipse.Effect>
                    <BlurEffect Radius="100"/>
                </Ellipse.Effect>
            </Ellipse>
            <Ellipse Width="350" Height="350"
                     Fill="{DynamicResource PrimaryBlurBrush}"
                     HorizontalAlignment="Left" VerticalAlignment="Bottom"
                     Margin="-100,0,0,-100">
                <Ellipse.Effect>
                    <BlurEffect Radius="80"/>
                </Ellipse.Effect>
            </Ellipse>
        </Grid>

        <Grid Margin="28,12,28,16" ClipToBounds="True">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Header -->
                <RowDefinition Height="12"/>
                <RowDefinition Height="*"/>    <!-- Content: preenche o viewport, sem scroll -->
            </Grid.RowDefinitions>

            <!-- HEADER COMPACTO -->
            <StackPanel Grid.Row="0" Orientation="Horizontal">
                <Border Width="40" Height="40" CornerRadius="10" Margin="0,0,14,0" VerticalAlignment="Center">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#FF4B6B" Offset="0"/>
                            <GradientStop Color="#8B31FF" Offset="0.55"/>
                            <GradientStop Color="#31A8FF" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="12" ShadowDepth="0" Color="#FF4B6B" Opacity="0.4"/>
                    </Border.Effect>
                    <Path Data="{StaticResource PerformanceIcon}"
                          Fill="White"
                          Width="20" Height="20"
                          Stretch="Uniform"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"/>
                </Border>

                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding [PerformanceUltraTitle], Source={x:Static services:LocalizationService.Instance}}"
                               FontFamily="Segoe UI Variable Display, Segoe UI"
                               FontSize="20"
                               FontWeight="Bold"
                               TextOptions.TextFormattingMode="Display"
                               TextOptions.TextRenderingMode="ClearType"
                               Foreground="{StaticResource VoltrisGradientHorizontalBrush}"/>
                    <TextBlock Text="{Binding [PerformanceUltraDesc], Source={x:Static services:LocalizationService.Instance}}"
                               FontSize="11"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                </StackPanel>
            </StackPanel>

            <!-- CONTEÚDO -->
            <Grid Grid.Row="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Perfil -->
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="Auto"/> <!-- Ações Rápidas -->
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="*"/>    <!-- Categorias: scroll interno -->
                </Grid.RowDefinitions>

                <!-- ============================================ -->
                <!-- CARD DE PERFIL DO SISTEMA -->
                <!-- ============================================ -->
                <Border Grid.Row="0" Background="{DynamicResource DarkPanelBrush}">
                    <Border.BorderBrush>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#40FF4B6B" Offset="0"/>
                            <GradientStop Color="#388B31FF" Offset="0.5"/>
                            <GradientStop Color="#3000A8FF" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.BorderBrush>
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="BorderThickness" Value="1"/>
                            <Setter Property="CornerRadius" Value="14"/>
                            <Setter Property="Padding" Value="16,12"/>
                        </Style>
                    </Border.Style>
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="18" ShadowDepth="0" Color="#8B31FF" Opacity="0.15"/>
                    </Border.Effect>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <Border Width="38" Height="38" CornerRadius="9" Margin="0,0,12,0">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#FF4B6B" Offset="0"/>
                                            <GradientStop Color="#8B31FF" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="12" ShadowDepth="0" Color="#FF4B6B" Opacity="0.35"/>
                                    </Border.Effect>
                                    <Path Data="M21,16H3V4H21V16M21,18H3A2,2 0 0,1 1,16V4A2,2 0 0,1 3,2H21A2,2 0 0,1 23,4V16A2,2 0 0,1 21,18M3,20H21V22H3V20Z" Fill="White" Width="18" Height="18" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding [PerformanceSystemProfile], Source={x:Static services:LocalizationService.Instance}}"
                                               FontSize="14"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBlock Text="{Binding [PerformanceAutoDetected], Source={x:Static services:LocalizationService.Instance}}"
                                               FontSize="10"
                                               Foreground="{DynamicResource TextMutedBrush}"/>
                                </StackPanel>
                            </StackPanel>

                            <!-- Informações do Sistema -->
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- CPU -->
                                <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,12,6">
                                    <TextBlock Text="{Binding ProfileCpu}"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               TextTrimming="CharacterEllipsis">
                                        <TextBlock.ToolTip>
                                            <ToolTip Background="#1A1A20" BorderBrush="#303040" BorderThickness="1" Padding="12,8" Placement="Mouse">
                                                <TextBlock Text="{Binding FullProfileCpu}" Foreground="{DynamicResource TextPrimary}" FontSize="12" TextWrapping="Wrap" MaxWidth="350"/>
                                            </ToolTip>
                                        </TextBlock.ToolTip>
                                    </TextBlock>
                                    <TextBlock Text="{Binding [PerformanceProcessor], Source={x:Static services:LocalizationService.Instance}}" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" Opacity="0.6"/>
                                </StackPanel>

                                <!-- RAM -->
                                <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,6">
                                    <TextBlock Text="{Binding ProfileRam}"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               TextTrimming="CharacterEllipsis">
                                        <TextBlock.ToolTip>
                                            <ToolTip Background="#1A1A20" BorderBrush="#303040" BorderThickness="1" Padding="12,8" Placement="Mouse">
                                                <TextBlock Text="{Binding FullProfileRam}" Foreground="{DynamicResource TextPrimary}" FontSize="12" TextWrapping="Wrap" MaxWidth="350"/>
                                            </ToolTip>
                                        </TextBlock.ToolTip>
                                    </TextBlock>
                                    <TextBlock Text="{Binding [PerformanceRam], Source={x:Static services:LocalizationService.Instance}}" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" Opacity="0.6"/>
                                </StackPanel>

                                <!-- Disco -->
                                <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,12,0">
                                    <TextBlock Text="{Binding ProfileStorage}"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               TextTrimming="CharacterEllipsis">
                                        <TextBlock.ToolTip>
                                            <ToolTip Background="#1A1A20" BorderBrush="#303040" BorderThickness="1" Padding="12,8" Placement="Mouse">
                                                <TextBlock Text="{Binding FullProfileStorage}" Foreground="{DynamicResource TextPrimary}" FontSize="12" TextWrapping="Wrap" MaxWidth="350"/>
                                            </ToolTip>
                                        </TextBlock.ToolTip>
                                    </TextBlock>
                                    <TextBlock Text="{Binding [PerformanceStorage], Source={x:Static services:LocalizationService.Instance}}" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" Opacity="0.6"/>
                                </StackPanel>

                                <!-- GPU -->
                                <StackPanel Grid.Row="1" Grid.Column="1">
                                    <TextBlock Text="{Binding ProfileGpu}"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               TextTrimming="CharacterEllipsis">
                                        <TextBlock.ToolTip>
                                            <ToolTip Background="#1A1A20" BorderBrush="#303040" BorderThickness="1" Padding="12,8" Placement="Mouse">
                                                <TextBlock Text="{Binding FullProfileGpu}" Foreground="{DynamicResource TextPrimary}" FontSize="12" TextWrapping="Wrap" MaxWidth="350"/>
                                            </ToolTip>
                                        </TextBlock.ToolTip>
                                    </TextBlock>
                                    <TextBlock Text="{Binding [PerformanceGpu], Source={x:Static services:LocalizationService.Instance}}" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" Opacity="0.6"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>

                        <!-- Badge de Tipo de PC -->
                        <Border Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right" Padding="12,7" CornerRadius="9">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#FF4B6B" Offset="0"/>
                                    <GradientStop Color="#8B31FF" Offset="0.5"/>
                                    <GradientStop Color="#31A8FF" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding ProfileTypeIcon}" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding ProfileType}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- ============================================ -->
                <!-- AÇÕES RÁPIDAS -->
                <!-- ============================================ -->
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Botão Otimização Automática -->
                    <Border Grid.Column="0"
                            Background="{DynamicResource DarkPanelBrush}"
                            BorderBrush="{DynamicResource DarkBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="14,10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                                <Border Width="36" Height="36" CornerRadius="9" Margin="0,0,10,0">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#FF4B6B" Offset="0"/>
                                            <GradientStop Color="#8B31FF" Offset="0.55"/>
                                            <GradientStop Color="#31A8FF" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <Path Data="M7,2V13H10V22L17,10H13L17,2H7Z" Fill="White" Width="16" Height="16" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding [PerformanceIntelligentOptimization], Source={x:Static services:LocalizationService.Instance}}"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBlock Text="{Binding [PerformanceIntelligentOptimizationDesc], Source={x:Static services:LocalizationService.Instance}}"
                                               FontSize="10"
                                               Foreground="{DynamicResource TextMutedBrush}"/>
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Grid.Row="1" x:Name="AutoProgressPanel" Margin="0,0,0,8">
                                <TextBlock x:Name="AutoProgressText" Text="{Binding IntelligentStatusMessage}" FontSize="11" Foreground="{DynamicResource PrimaryBrush}" Margin="0,0,0,5" TextWrapping="Wrap"/>
                                <ProgressBar x:Name="AutoProgress" Height="4" Background="{DynamicResource DarkBorderBrush}" Foreground="{DynamicResource PrimaryBrush}" BorderThickness="0" Maximum="100" IsIndeterminate="True" Visibility="{Binding IsOptimizing, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                            </StackPanel>

                            <Button Grid.Row="2"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Bottom"
                                    MinHeight="38"
                                    Padding="14,8"
                                    FontWeight="SemiBold"
                                    FontSize="12"
                                    Cursor="Hand"
                                    Command="{Binding IntelligentOptimizeCommand}"
                                    >
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="border" CornerRadius="9" Padding="16,10">
                                                        <Border.Background>
                                                            <DynamicResource ResourceKey="VoltrisGradientBrush"/>
                                                        </Border.Background>
                                                        <Border.Effect>
                                                            <DropShadowEffect BlurRadius="15" ShadowDepth="0" Color="#8B31FF" Opacity="0.3"/>
                                                        </Border.Effect>
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="border" Property="Effect">
<Setter.Value>
                                                                     <DropShadowEffect BlurRadius="25" ShadowDepth="0" Color="#FF4B6B" Opacity="0.5"/>
                                                                 </Setter.Value>
                                                            </Setter>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                                    </Style>
                                </Button.Style>
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="M7,2V13H10V22L17,10H13L17,2H7Z" Fill="White" Width="13" Height="13" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding [PerformanceApplyIntelligent], Source={x:Static services:LocalizationService.Instance}}" VerticalAlignment="Center"/>
                                    <controls:ProBadge Margin="8,0,0,0" Tip="{Binding [ProBadgeTip], Source={x:Static services:LocalizationService.Instance}}"
                                                      Visibility="{Binding Source={x:Static license:LicenseTokenStore.IsProActive}, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Botão Reverter -->
                    <Border Grid.Column="2"
                            Background="{DynamicResource DarkPanelBrush}"
                            BorderBrush="{DynamicResource DarkBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="14,10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                                <Border Width="36" Height="36" CornerRadius="9" Margin="0,0,10,0">
                                    <Border.Background>
                                        <SolidColorBrush Color="#F59E0B" Opacity="0.2"/>
                                    </Border.Background>
                                    <Path Data="M13.5,8H12V13L16.28,15.54L17,14.33L13.5,12.25V8M13,3A9,9 0 0,0 4,12H1L4.96,16.03L9,12H6A7,7 0 0,1 13,5A7,7 0 0,1 20,12A7,7 0 0,1 13,19C11.07,19 9.32,18.21 8.06,16.94L6.64,18.36C8.27,20 10.5,21 13,21A9,9 0 0,0 22,12A9,9 0 0,0 13,3" Fill="#F59E0B" Width="16" Height="16" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding [PerformanceRevertAll], Source={x:Static services:LocalizationService.Instance}}"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBlock Text="{Binding [PerformanceRevertAllDesc], Source={x:Static services:LocalizationService.Instance}}"
                                               FontSize="10"
                                               Foreground="{DynamicResource TextMutedBrush}"/>
                                </StackPanel>
                            </StackPanel>

                            <Button Grid.Row="1"
                                    Style="{StaticResource NeonSecondaryButtonStyle}"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Bottom"
                                    MinHeight="38"
                                    Padding="14,8"
                                    FontWeight="SemiBold"
                                    FontSize="12"
                                    Command="{Binding RevertAllCommand}"
                                    >
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="M12,18A6,6 0 0,1 6,12C6,11 6.25,10.03 6.7,9.2L5.24,7.74C4.46,8.97 4,10.43 4,12A8,8 0 0,0 12,20V23L16,19L12,15M12,4V1L8,5L12,9V6A6,6 0 0,1 18,12C18,13 17.75,13.97 17.3,14.8L18.76,16.26C19.54,15.03 20,13.57 20,12A8,8 0 0,0 12,4Z" Fill="White" Width="13" Height="13" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding [PerformanceRevertButton], Source={x:Static services:LocalizationService.Instance}}"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>
                </Grid>

                <!-- ============================================ -->
                <!-- CATEGORIAS DE OTIMIZAÇÃO (scroll interno) -->
                <!-- ============================================ -->
                <ScrollViewer Grid.Row="4"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              CanContentScroll="True"
                              Padding="0,0,4,0">
                    <ItemsControl ItemsSource="{Binding Categories}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{DynamicResource PremiumCard}"
                                        Padding="14"
                                        Margin="0,0,0,10">
                                    <StackPanel>
                                        <!-- Header da Categoria -->
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                                <Border Width="36" Height="36" CornerRadius="9" Margin="0,0,10,0">
                                                    <Border.Background>
                                                        <SolidColorBrush Color="{Binding CategoryColor}" Opacity="0.2"/>
                                                    </Border.Background>
                                                    <Path Data="{Binding IconPath}" Width="17" Height="17" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <Path.Fill>
                                                            <SolidColorBrush Color="{Binding CategoryColor}"/>
                                                        </Path.Fill>
                                                    </Path>
                                                </Border>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}"
                                                              FontSize="13"
                                                              FontWeight="SemiBold"
                                                              Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                    <TextBlock Text="{Binding Description}"
                                                              FontSize="10"
                                                              Foreground="{DynamicResource TextMutedBrush}"
                                                              TextWrapping="NoWrap"
                                                              TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                            </StackPanel>

                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                <!-- Status de Trabalho -->
                                                <TextBlock Text="{Binding StatusText}"
                                                          FontSize="10"
                                                          Foreground="{Binding CategoryColor, Converter={StaticResource ColorToBrushConverter}}"
                                                          VerticalAlignment="Center"
                                                          Margin="0,0,10,0"
                                                          Visibility="{Binding IsWorking, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                    <TextBlock.Effect>
                                                        <DropShadowEffect BlurRadius="8" ShadowDepth="0" Color="{Binding CategoryColor}" Opacity="0.5"/>
                                                    </TextBlock.Effect>
                                                </TextBlock>

                                                <!-- Botões de Ação Modernos (SaaS Design) -->
                                                <StackPanel Orientation="Horizontal" Visibility="{Binding IsNotWorking, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                    <!-- Botão Aplicar (Premium) -->
                                                    <Button Command="{Binding ApplyCommand}"
                                                            Margin="0,0,10,0"
                                                            Cursor="Hand">
                                                        <Button.Style>
                                                            <Style TargetType="Button">
                                                                <Setter Property="Template">
                                                                    <Setter.Value>
                                                                        <ControlTemplate TargetType="Button">
                                                                            <Border x:Name="border" CornerRadius="8" Padding="13,5" RenderTransformOrigin="0.5,0.5">
                                                                                <Border.RenderTransform>
                                                                                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                                                                                </Border.RenderTransform>
                                                                                <Border.Background>
                                                                                    <SolidColorBrush Color="{Binding CategoryColor}"/>
                                                                                </Border.Background>
                                                                                <Border.Effect>
                                                                                    <DropShadowEffect x:Name="glow" BlurRadius="10" ShadowDepth="0" Color="{Binding CategoryColor}" Opacity="0.3"/>
                                                                                </Border.Effect>
                                                                                <StackPanel Orientation="Horizontal">
                                                                                    <Path Data="M21,7L9,19L3.5,13.5L4.91,12.09L9,16.17L19.59,5.59L21,7Z" Fill="White" Width="10" Height="10" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center" Opacity="0.95"/>
                                                                                    <TextBlock Text="{Binding [PerformanceApplyButton], Source={x:Static services:LocalizationService.Instance}}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                                                                                </StackPanel>
                                                                            </Border>
                                                                            <ControlTemplate.Triggers>
                                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                                    <Trigger.EnterActions>
                                                                                        <BeginStoryboard>
                                                                                            <Storyboard>
                                                                                                <DoubleAnimation Storyboard.TargetName="border" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1.05" Duration="0:0:0.2">
                                                                                                    <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                                                                                </DoubleAnimation>
                                                                                                <DoubleAnimation Storyboard.TargetName="border" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1.05" Duration="0:0:0.2">
                                                                                                    <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                                                                                </DoubleAnimation>
                                                                                                <DoubleAnimation Storyboard.TargetName="glow" Storyboard.TargetProperty="Opacity" To="0.55" Duration="0:0:0.2"/>
                                                                                                <DoubleAnimation Storyboard.TargetName="glow" Storyboard.TargetProperty="BlurRadius" To="20" Duration="0:0:0.2"/>
                                                                                            </Storyboard>
                                                                                        </BeginStoryboard>
                                                                                    </Trigger.EnterActions>
                                                                                    <Trigger.ExitActions>
                                                                                        <BeginStoryboard>
                                                                                            <Storyboard>
                                                                                                <DoubleAnimation Storyboard.TargetName="border" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.2"/>
                                                                                                <DoubleAnimation Storyboard.TargetName="border" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.2"/>
                                                                                                <DoubleAnimation Storyboard.TargetName="glow" Storyboard.TargetProperty="Opacity" To="0.3" Duration="0:0:0.2"/>
                                                                                                <DoubleAnimation Storyboard.TargetName="glow" Storyboard.TargetProperty="BlurRadius" To="10" Duration="0:0:0.2"/>
                                                                                            </Storyboard>
                                                                                        </BeginStoryboard>
                                                                                    </Trigger.ExitActions>
                                                                                </Trigger>
                                                                                <Trigger Property="IsPressed" Value="True">
                                                                                    <Setter TargetName="border" Property="RenderTransform">
                                                                                        <Setter.Value>
                                                                                            <ScaleTransform ScaleX="0.95" ScaleY="0.95"/>
                                                                                        </Setter.Value>
                                                                                    </Setter>
                                                                                </Trigger>
                                                                            </ControlTemplate.Triggers>
                                                                        </ControlTemplate>
                                                                    </Setter.Value>
                                                                </Setter>
                                                            </Style>
                                                        </Button.Style>
                                                    </Button>

                                                    <!-- Botão Reverter (Sutil/Outline) -->
                                                    <Button Command="{Binding RevertCommand}"
                                                            Margin="0,0,14,0"
                                                            Cursor="Hand">
                                                        <Button.Style>
                                                            <Style TargetType="Button">
                                                                <Setter Property="Template">
                                                                    <Setter.Value>
                                                                        <ControlTemplate TargetType="Button">
                                                                            <Border x:Name="border" CornerRadius="8" Padding="11,5" Background="Transparent" BorderBrush="#30FFFFFF" BorderThickness="1.2" RenderTransformOrigin="0.5,0.5">
                                                                                <Border.RenderTransform>
                                                                                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                                                                                </Border.RenderTransform>
                                                                                <TextBlock x:Name="text" Text="{Binding [PerformanceRevertButton], Source={x:Static services:LocalizationService.Instance}}" FontSize="11" FontWeight="SemiBold" Foreground="#A0FFFFFF" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                                                            </Border>
                                                                            <ControlTemplate.Triggers>
                                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                                    <Setter TargetName="border" Property="Background" Value="#15FFFFFF"/>
                                                                                    <Setter TargetName="border" Property="BorderBrush" Value="#60FFFFFF"/>
                                                                                    <Setter TargetName="text" Property="Foreground" Value="White"/>
                                                                                    <Trigger.EnterActions>
                                                                                        <BeginStoryboard>
                                                                                            <Storyboard>
                                                                                                <DoubleAnimation Storyboard.TargetName="border" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1.03" Duration="0:0:0.2"/>
                                                                                                <DoubleAnimation Storyboard.TargetName="border" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1.03" Duration="0:0:0.2"/>
                                                                                            </Storyboard>
                                                                                        </BeginStoryboard>
                                                                                    </Trigger.EnterActions>
                                                                                    <Trigger.ExitActions>
                                                                                        <BeginStoryboard>
                                                                                            <Storyboard>
                                                                                                <DoubleAnimation Storyboard.TargetName="border" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.2"/>
                                                                                                <DoubleAnimation Storyboard.TargetName="border" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.2"/>
                                                                                            </Storyboard>
                                                                                        </BeginStoryboard>
                                                                                    </Trigger.ExitActions>
                                                                                </Trigger>
                                                                            </ControlTemplate.Triggers>
                                                                        </ControlTemplate>
                                                                    </Setter.Value>
                                                                </Setter>
                                                            </Style>
                                                        </Button.Style>
                                                    </Button>
                                                </StackPanel>

                                                <!-- Checkbox de Seleção Geral (Sempre visível e destacado) -->
                                                <CheckBox IsChecked="{Binding IsSelectedAll, Mode=TwoWay}"
                                                          ToolTip="{Binding [PerformanceSelectAllTooltip], Source={x:Static services:LocalizationService.Instance}}"
                                                          Style="{DynamicResource ModernCheckBoxStyle}"
                                                          VerticalAlignment="Center"
                                                          Margin="0,0,10,0"/>

                                                <!-- Alternar Expansão (Chevron) -->
                                                <ToggleButton IsChecked="{Binding IsExpanded, Mode=TwoWay}"
                                                             Cursor="Hand">
                                                    <ToggleButton.Template>
                                                        <ControlTemplate TargetType="ToggleButton">
                                                            <Border x:Name="border" Width="26" Height="26" CornerRadius="8" Background="#12FFFFFF">
                                                                <Viewbox Width="11" Height="11" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                    <Path x:Name="chevron"
                                                                          Data="M 0 0 L 5 5 L 10 0"
                                                                          Stroke="{DynamicResource TextMutedBrush}"
                                                                          StrokeThickness="2"
                                                                          StrokeStartLineCap="Round"
                                                                          StrokeEndLineCap="Round"
                                                                          RenderTransformOrigin="0.5,0.5">
                                                                        <Path.RenderTransform>
                                                                            <RotateTransform Angle="0"/>
                                                                        </Path.RenderTransform>
                                                                    </Path>
                                                                </Viewbox>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsChecked" Value="True">
                                                                    <Setter TargetName="chevron" Property="RenderTransform">
                                                                        <Setter.Value>
                                                                            <RotateTransform Angle="180"/>
                                                                        </Setter.Value>
                                                                    </Setter>
                                                                    <Setter TargetName="border" Property="Background" Value="#20FFFFFF"/>
                                                                </Trigger>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="border" Property="Background" Value="#30FFFFFF"/>
                                                                    <Setter TargetName="chevron" Property="Stroke" Value="White"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </ToggleButton.Template>
                                                </ToggleButton>
                                            </StackPanel>
                                        </Grid>

                                        <!-- Lista de Otimizações -->
                                        <ItemsControl ItemsSource="{Binding Optimizations}"
                                                      Visibility="{Binding ExpandedVisibility}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="#08FFFFFF"
                                                            CornerRadius="10"
                                                            Padding="13,11"
                                                            Margin="0,0,0,6">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>

                                                            <CheckBox Grid.Column="0"
                                                                     IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                                     ToolTip="{Binding IncompatibilityReason}"
                                                                     Margin="0,0,12,0"
                                                                     VerticalAlignment="Center"/>

                                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding Name}"
                                                                          FontSize="12"
                                                                          FontWeight="Medium"
                                                                          Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                                <TextBlock Text="{Binding Description}"
                                                                          FontSize="10"
                                                                          Foreground="{DynamicResource TextMutedBrush}"/>
                                                            </StackPanel>

                                                            <!-- Impacto -->
                                                            <Border Grid.Column="2"
                                                                   Background="{Binding ImpactColor}"
                                                                   CornerRadius="6"
                                                                   Padding="8,4"
                                                                   Margin="0,0,8,0"
                                                                   VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding ImpactText}"
                                                                          FontSize="9"
                                                                          FontWeight="Bold"
                                                                          Foreground="{DynamicResource TextPrimary}"/>
                                                            </Border>

                                                            <!-- Recomendado -->
                                                            <Border Grid.Column="3"
                                                                   Visibility="{Binding RecommendedVisibility}"
                                                                   Background="#1510B981"
                                                                   CornerRadius="6"
                                                                   Padding="8,4"
                                                                   Margin="0,0,6,0"
                                                                   VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding [Loc_Rec], Source={x:Static services:LocalizationService.Instance}}"
                                                                          FontSize="9"
                                                                          FontWeight="Bold"
                                                                          Foreground="#10B981"/>
                                                            </Border>

                                                            <!-- Botão Aplicar Individual -->
                                                            <Button Grid.Column="4"
                                                                    Command="{Binding ApplyIndividualCommand}"
                                                                    ToolTip="{Binding [PerformanceApplyTooltip], Source={x:Static services:LocalizationService.Instance}}"
                                                                    Cursor="Hand"
                                                                    Margin="0,0,4,0"
                                                                    VerticalAlignment="Center">
                                                                <Button.Style>
                                                                    <Style TargetType="Button">
                                                                        <Setter Property="Template">
                                                                            <Setter.Value>
                                                                                <ControlTemplate TargetType="Button">
                                                                                    <Border x:Name="applyBorder" Background="#1510B981" CornerRadius="6" Padding="8,4" BorderBrush="#3010B981" BorderThickness="1">
                                                                                        <Path Data="M21,7L9,19L3.5,13.5L4.91,12.09L9,16.17L19.59,5.59L21,7Z" Fill="#10B981" Width="9" Height="9" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                                    </Border>
                                                                                    <ControlTemplate.Triggers>
                                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                                            <Setter TargetName="applyBorder" Property="Background" Value="#2510B981"/>
                                                                                        </Trigger>
                                                                                    </ControlTemplate.Triggers>
                                                                                </ControlTemplate>
                                                                            </Setter.Value>
                                                                        </Setter>
                                                                    </Style>
                                                                </Button.Style>
                                                            </Button>

                                                            <!-- Botão Reverter Individual -->
                                                            <Button Grid.Column="5"
                                                                    Command="{Binding RevertIndividualCommand}"
                                                                    ToolTip="{Binding [PerformanceRevertTooltip], Source={x:Static services:LocalizationService.Instance}}"
                                                                    Cursor="Hand"
                                                                    VerticalAlignment="Center">
                                                                <Button.Style>
                                                                    <Style TargetType="Button">
                                                                        <Setter Property="Template">
                                                                            <Setter.Value>
                                                                                <ControlTemplate TargetType="Button">
                                                                                    <Border x:Name="revertBorder" Background="#15F59E0B" CornerRadius="6" Padding="8,4" BorderBrush="#30F59E0B" BorderThickness="1">
                                                                                        <Path Data="M19,6.41L17.59,5L12,10.59L6.41,5L5,6.41L10.59,12L5,17.59L6.41,19L12,13.41L17.59,19L19,17.59L13.41,12L19,6.41Z" Fill="#F59E0B" Width="9" Height="9" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                                    </Border>
                                                                                    <ControlTemplate.Triggers>
                                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                                            <Setter TargetName="revertBorder" Property="Background" Value="#25F59E0B"/>
                                                                                        </Trigger>
                                                                                    </ControlTemplate.Triggers>
                                                                                </ControlTemplate>
                                                                            </Setter.Value>
                                                                        </Setter>
                                                                    </Style>
                                                                </Button.Style>
                                                            </Button>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</UserControl>