<UserControl xmlns:services="clr-namespace:VoltrisOptimizer.Services" x:Class="VoltrisOptimizer.UI.Views.LicenseManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             Background="{DynamicResource WindowBackgroundBrush}"
             d:DesignHeight="520" d:DesignWidth="720"
             FontFamily="Segoe UI Variable, Segoe UI, Inter, Sans-Serif"
             UseLayoutRounding="True" SnapsToDevicePixels="True"
             ScrollViewer.VerticalScrollBarVisibility="Disabled"
             ScrollViewer.HorizontalScrollBarVisibility="Disabled">

    <UserControl.Resources>
        <SolidColorBrush x:Key="CheckColor" Color="#10B981"/>
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#94A3B8"/>

        <!-- Botão Selecionar -->
        <Style x:Key="SelectButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#00F0FF"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="BorderBrush" Value="#00F0FF"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="8" SnapsToDevicePixels="True" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1500F0FF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#2500F0FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Botão Selecionar Purple PRO -->
        <Style x:Key="SelectButtonProStyle" TargetType="Button">
            <Setter Property="Background" Value="#8B31FF"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="8" SnapsToDevicePixels="True" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#A855F7"/>
                                <Setter TargetName="border" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect BlurRadius="15" ShadowDepth="0" Color="#8B31FF" Opacity="0.6"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border Background="{DynamicResource WindowBackgroundBrush}" BorderBrush="{DynamicResource DarkBorderBrush}" BorderThickness="1.5" CornerRadius="20">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- FECHAR BUTTON -->
            <Button Grid.Row="0" Click="CloseWindow_Click" 
                    Width="32" Height="32" 
                    Background="Transparent" BorderThickness="0" 
                    Cursor="Hand"
                    HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,12,12,0" Panel.ZIndex="10">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder" Background="Transparent" CornerRadius="16">
                            <Path Data="M19,6.41L17.59,5L12,10.59L6.41,5L5,6.41L10.59,12L5,17.59L6.41,19L12,13.41L17.59,19L19,17.59L13.41,12L19,6.41Z" 
                                  Fill="#60FFFFFF" Stretch="Uniform" Width="10" Height="10" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#25FF4B6B"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <!-- HEADER SECTION -->
            <StackPanel Grid.Row="0" Margin="40,20,40,16" VerticalAlignment="Top">
                <!-- Ícone Lock -->
                <Grid Width="60" Height="60" Margin="0,0,0,16" HorizontalAlignment="Center">
                    <Ellipse Fill="#FF5566" Opacity="0.2" Margin="-15"/>
                    <Ellipse Fill="#FF5566" Opacity="0.35" Margin="-8"/>
                    <Ellipse Fill="#FF5566" Opacity="0.5" Margin="0"/>
                    <Viewbox>
                        <Path Data="M12,1L9,5H9A7,7 0 0,0 2,12V21A2,2 0 0,0 4,23H20A2,2 0 0,0 22,21V12A7,7 0 0,0 15,5H15L12,1M12,5A2,2 0 0,1 14,7H10A2,2 0 0,1 12,5Z"
                              Fill="#FF5566" Stretch="Uniform"/>
                    </Viewbox>
                </Grid>

                <!-- Título Principal -->
                <TextBlock Text="{Binding [LicenseMgmtTitle], Source={x:Static services:LocalizationService.Instance}}" 
                           FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"
                           TextAlignment="Center" Margin="0,0,0,6"/>
                
                <!-- Subtítulo -->
                <TextBlock Text="{Binding [LicenseMgmtSubtitle], Source={x:Static services:LocalizationService.Instance}}" 
                           FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                           TextAlignment="Center"/>
            </StackPanel>

            <!-- PLANOS SECTION -->
            <StackPanel Grid.Row="1" Margin="24,0,24,24" VerticalAlignment="Top">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- STANDARD PLAN -->
                    <Border Grid.Column="0" CornerRadius="12" BorderThickness="1.5" Padding="16,14" Background="#0A0A10" BorderBrush="#1F1F2F">
                        <StackPanel>
                            <TextBlock Text="STANDARD" FontSize="9" FontWeight="Bold" Foreground="#10B981" Margin="0,0,0,4"/>
                            <TextBlock Text="{Binding [LicenseStandardDesc], Source={x:Static services:LocalizationService.Instance}}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8"/>
                            <TextBlock Text="{Binding [LicenseStandardFeatures], Source={x:Static services:LocalizationService.Instance}}" 
                                       FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,16"/>
                            <Button Click="BuyLicense_Click" Style="{StaticResource SelectButtonStyle}" HorizontalAlignment="Stretch" Content="{Binding [LicenseSelect], Source={x:Static services:LocalizationService.Instance}}"/>
                        </StackPanel>
                    </Border>

                    <!-- PRO PLAN (DESTAQUE) -->
                    <Border Grid.Column="2" CornerRadius="14" BorderThickness="2" Padding="18,16" 
                            Background="#1A0A2E" BorderBrush="#8B31FF">
                        <StackPanel>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="PRO" FontSize="10" FontWeight="Bold" Foreground="#8B31FF"/>
                                <Border Grid.Column="1" Background="#8B31FF" CornerRadius="4" Padding="6,2">
                                    <TextBlock Text="{Binding [LicenseMostPopular], Source={x:Static services:LocalizationService.Instance}}" FontSize="8" FontWeight="Bold" Foreground="White"/>
                                </Border>
                            </Grid>
                            <TextBlock Text="{Binding [LicenseProTitle], Source={x:Static services:LocalizationService.Instance}}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8"/>
                            <TextBlock Text="{Binding [LicenseProFeatures], Source={x:Static services:LocalizationService.Instance}}" 
                                       FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,16"/>
                            <Button Click="BuyLicense_Click" Style="{StaticResource SelectButtonProStyle}" HorizontalAlignment="Stretch" Content="{Binding [LicenseSelect], Source={x:Static services:LocalizationService.Instance}}"/>
                        </StackPanel>
                    </Border>

                    <!-- ENTERPRISE PLAN -->
                    <Border Grid.Column="4" CornerRadius="12" BorderThickness="1.5" Padding="16,14" Background="#0A0A10" BorderBrush="#1F1F2F">
                        <StackPanel>
                            <TextBlock Text="ENTERPRISE" FontSize="9" FontWeight="Bold" Foreground="#00F0FF" Margin="0,0,0,4"/>
                            <TextBlock Text="{Binding [LicenseEnterpriseTitle], Source={x:Static services:LocalizationService.Instance}}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8"/>
                            <TextBlock Text="{Binding [LicenseEnterpriseFeatures], Source={x:Static services:LocalizationService.Instance}}" 
                                       FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,16"/>
                            <Button Click="BuyLicense_Click" Style="{StaticResource SelectButtonStyle}" HorizontalAlignment="Stretch" Content="{Binding [LicenseSelect], Source={x:Static services:LocalizationService.Instance}}"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>

            <!-- FOOTER SECTION -->
            <Border Grid.Row="2" Margin="24,0,24,20" Padding="16" Background="#0AFFFFFF" CornerRadius="10" BorderThickness="1" BorderBrush="#15FFFFFF">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Viewbox Width="16" Height="16" Margin="0,0,12,0" VerticalAlignment="Top">
                        <Path Data="M12,1L3,5V11C3,16.55 6.84,21.74 12,23C17.16,21.74 21,16.55 21,11V5L12,1M12,11.99H7V10.99H12V11.99M17,10.99C17,10.99 17,10.99 17,10.99H13V11.99H17V10.99Z" 
                              Fill="#10B981"/>
                    </Viewbox>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="{Binding [LicenseSecureTitle], Source={x:Static services:LocalizationService.Instance}}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,2"/>
                        <TextBlock Text="{Binding [LicenseSecureDesc], Source={x:Static services:LocalizationService.Instance}}" 
                                   FontSize="10" Foreground="{StaticResource TextSecondaryBrush}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>
