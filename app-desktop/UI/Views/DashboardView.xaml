                        <Ellipse x:Name="pw2" Width="212" Height="212" Stroke="#3A3B82F6" StrokeThickness="2"
                                 RenderTransformOrigin="0.5,0.5">
                            <Ellipse.RenderTransform>
                                <ScaleTransform/>
                            </Ellipse.RenderTransform>
