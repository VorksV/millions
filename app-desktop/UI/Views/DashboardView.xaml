                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="#FF8B31FF" Offset="0"/>
                            <GradientStop Color="#558B31FF" Offset="0.5"/>
                            <GradientStop Color="#008B31FF" Offset="1"/>
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                    <Ellipse.RenderTransform>
                        <TranslateTransform/>
                    </Ellipse.RenderTransform>
                </Ellipse>
                <Ellipse x:Name="ifOrb3" CacheMode="BitmapCache" Width="64" Height="60" Opacity="0.13"
                         HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="84,0,0,120">
                    <Ellipse.Effect>
                        <BlurEffect Radius="22"/>
                    </Ellipse.Effect>
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="#FF3B82F6" Offset="0"/>
                            <GradientStop Color="#553B82F6" Offset="0.5"/>
                            <GradientStop Color="#003B82F6" Offset="1"/>
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                    <Ellipse.RenderTransform>
                        <TranslateTransform/>
