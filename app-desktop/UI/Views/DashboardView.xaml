                <Ellipse x:Name="ifSp5" Width="4" Height="4" Opacity="0.28"
                         HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,300,0,0">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="#FFFFFFFF" Offset="0"/>
                            <GradientStop Color="#3355FFEE" Offset="0.7"/>
                            <GradientStop Color="#0055FFEE" Offset="1"/>
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                    <Ellipse.RenderTransform>
                        <TranslateTransform/>
                    </Ellipse.RenderTransform>
                </Ellipse>
            </Grid>

            <!-- Viewbox responsivo: o conteúdo 320x320 escala proporcionalmente à janela (item 15) -->
            <Viewbox Grid.Row="0" Stretch="Uniform" MaxWidth="420" MaxHeight="420"
                     HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid Width="320" Height="320">

                    <!-- Glow ambiental proporcional: vive DENTRO do Viewbox, então escala junto com o botão (item 11).
                         Respiração sutil no idle (sem valor falso — apenas ânimo visual). -->
                    <Ellipse Width="306" Height="306" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Ellipse.Fill>
                            <RadialGradientBrush>
                                <GradientStop Color="#3D4C8B" Offset="0"/>
                                <GradientStop Color="#2A3A6B" Offset="0.55"/>
                                <GradientStop Color="Transparent" Offset="0.75"/>
                            </RadialGradientBrush>
                        </Ellipse.Fill>
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Opacity" Value="0.5"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsMasterRunning}" Value="False">
                                        <DataTrigger.EnterActions>
                                            <BeginStoryboard x:Name="GlowBreath">
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                     From="0.35" To="0.62"
                                                                     Duration="0:0:2" AutoReverse="True" RepeatBehavior="Forever"/>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </DataTrigger.EnterActions>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsMasterRunning}" Value="True">
                                        <DataTrigger.EnterActions>
                                            <StopStoryboard BeginStoryboardName="GlowBreath"/>
                                        </DataTrigger.EnterActions>
                                        <Setter Property="Opacity" Value="0.5"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>

                    <!-- Anel de trilha (fundo sutil) -->
                    <Ellipse Width="301" Height="301" Stroke="#26FFFFFF" StrokeThickness="7"
                             StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                             RenderTransformOrigin="0.5,0.5">
                        <Ellipse.RenderTransform>
                            <RotateTransform Angle="0"/>
                        </Ellipse.RenderTransform>
                    </Ellipse>

                    <!-- Anel secundário subliminar (item 9) — sugere segmentação sem virar relógio -->
                    <Ellipse Width="240" Height="240" Stroke="#12FFFFFF" StrokeThickness="4"
                             StrokeStartLineCap="Round" StrokeEndLineCap="Round" RenderTransformOrigin="0.5,0.5">
                        <Ellipse.RenderTransform>
                            <RotateTransform Angle="0"/>
                        </Ellipse.RenderTransform>
                    </Ellipse>
                    <!-- Pontos de fase REAIS (análise → limpeza → memória → otimização → finalização):
                     acendem conforme a fase efetivamente avança (MasterPhase). -->
                    <Canvas>
                        <Ellipse Width="8" Height="8" Canvas.Left="157" Canvas.Top="38">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="#66FFFFFF"/>
                                    <Setter Property="Opacity" Value="0.8"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding PhaseDot1}" Value="True">
                                            <Setter Property="Fill" Value="#22D3EE"/>
                                            <Setter Property="Opacity" Value="1"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <Ellipse Width="8" Height="8" Canvas.Left="247" Canvas.Top="126">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="#667799FF"/>
                                    <Setter Property="Opacity" Value="0.8"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding PhaseDot2}" Value="True">
                                            <Setter Property="Fill" Value="#22D3EE"/>
                                            <Setter Property="Opacity" Value="1"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <Ellipse Width="8" Height="8" Canvas.Left="184" Canvas.Top="241">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="#66FF77FF"/>
                                    <Setter Property="Opacity" Value="0.8"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding PhaseDot3}" Value="True">
                                            <Setter Property="Fill" Value="#22D3EE"/>
                                            <Setter Property="Opacity" Value="1"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <Ellipse Width="8" Height="8" Canvas.Left="113" Canvas.Top="241">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="#66FFFFFF"/>
                                    <Setter Property="Opacity" Value="0.8"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding PhaseDot4}" Value="True">
                                            <Setter Property="Fill" Value="#22D3EE"/>
                                            <Setter Property="Opacity" Value="1"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <Ellipse Width="8" Height="8" Canvas.Left="59" Canvas.Top="126">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="#6699FF"/>
                                    <Setter Property="Opacity" Value="0.8"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding PhaseDot5}" Value="True">
                                            <Setter Property="Fill" Value="#10B981"/>
                                            <Setter Property="Opacity" Value="1"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                    </Canvas>

                    <!-- HALO VERMELHO RESPIRANDO (atrás do botão) — só aceso com Modo Gamer -->
                    <Ellipse Width="330" Height="330" HorizontalAlignment="Center" VerticalAlignment="Center"
                             IsHitTestVisible="False">
                        <Ellipse.Fill>
                            <RadialGradientBrush Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
                                <GradientStop Color="#4DFF3B30" Offset="0"/>
                                <GradientStop Color="#24FF3B30" Offset="0.55"/>
                                <GradientStop Color="Transparent" Offset="0.8"/>
                            </RadialGradientBrush>
                        </Ellipse.Fill>
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Opacity" Value="0"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsGamerModeActive}" Value="True">
                                        <DataTrigger.EnterActions>
                                            <BeginStoryboard x:Name="gamerHaloAnim">
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                     From="0.4" To="0.9" Duration="0:0:2.2" AutoReverse="True" RepeatBehavior="Forever"/>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </DataTrigger.EnterActions>
                                        <DataTrigger.ExitActions>
                                            <RemoveStoryboard BeginStoryboardName="gamerHaloAnim"/>
                                        </DataTrigger.ExitActions>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>

                    <!-- NÚCLEO (botão central clicável com estados animados) -->
                    <Button Command="{Binding MasterActionCommand}" Cursor="Hand" Width="290" Height="290"
                            HorizontalAlignment="Center" VerticalAlignment="Center"
                            FocusVisualStyle="{x:Null}"
                            ToolTip="{Binding MasterStatusTooltip}"
                            Background="Transparent" BorderThickness="0">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Grid x:Name="ring" RenderTransformOrigin="0.5,0.5">
                                     <Grid.RenderTransform>
                                            <ScaleTransform x:Name="ringScale" ScaleX="1" ScaleY="1"/>
                                     </Grid.RenderTransform>
<Border CornerRadius="145" BorderThickness="1">
                                    <Border.BorderBrush>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#4DFFFFFF" Offset="0"/>
                                            <GradientStop Color="#0AFFFFFF" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.BorderBrush>
                                    <Border.Background>
                                        <RadialGradientBrush Center="0.5,0.45" GradientOrigin="0.5,0.45" RadiusX="0.9" RadiusY="0.9">
                                            <GradientStop Color="#FF252E42" Offset="0"/>
                                            <GradientStop Color="#FF0C0F19" Offset="0.75"/>
                                            <GradientStop Color="#FF06080F" Offset="1"/>
                                        </RadialGradientBrush>
                                    </Border.Background>
                                    <Border.Effect>
                                        <DropShadowEffect x:Name="ringShadow" BlurRadius="20" ShadowDepth="0" Opacity="0.42" Color="#0A84FF"/>
                                    </Border.Effect>
                                        <Grid>
                                            <!-- Conteúdo central com estados (item 4/5) -->
                                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">

                                                <!-- [FIX:FACE-RUN] ROSTO DA IA ACIMA DA %
                                                     [FIX:FACE-MOOD] E COM O HUMOR DA FASE.

                                                     Este bloco ANTES vivia abaixo da
                                                     porcentagem e com o gatilho
                                                     INVERTIDO (visível só quando
                                                     IsMasterRunning = False), ou seja:
                                                     durante a otimização o rosto era
                                                     Collapsed e só aparecia a %. Como
                                                     as duas camadas nunca coexistiam, a
                                                     ordem no StackPanel era irrelevante.

                                                     Agora o rosto aparece durante a
                                                     execução, então a ordem importa:
                                                     estar ANTES da % é o que produz
                                                     "rosto pequeno em cima da
                                                     porcentagem". Se ficasse depois,
                                                     a % subiria por cima do rosto.

                                                     [FIX:FACE-CROP] O QUE REALMENTE
                                                     CAUSAVA O CORTE
                                                     =================================
                                                     A tentativa anterior encolheu o
                                                     AiFaceView para 56x56. ERRADO: o
                                                     UserControl declara
                                                     `Width="104" Height="104"` e tem
                                                     dentro um Viewbox que escala um
                                                     Stage de 100x100, e esse Stage
                                                     TRANSBORDA (bloom, 3 auras em
                                                     anel, tremor do Furious). Em 104
                                                     existe folga; em 56 não existe.

                                                     A segunda tentativa errou de novo,
                                                     por um motivo mais sutil e que vale
                                                     registrar: pôs `Width="66"
                                                     Height="66"` NO GRID **e** um
                                                     LayoutTransform de 0.64. No WPF o
                                                     LayoutTransform é aplicado ao
                                                     PRÓPRIO tamanho de layout do
                                                     elemento — logo a pegada passou a
                                                     ser 66 × 0.64 = **42px**, e o
                                                     filho de 104px foi espremido e
                                                     cortado dentro disso. Era esse o
                                                     corte, e não o tamanho do
                                                     AiFaceView.

                                                     A CORREÇÃO: o Grid NÃO declara
                                                     Width/Height. Ele mede o filho
                                                     (104x104) e o LayoutTransform
                                                     escala o resultado inteiro — pegada
                                                     final de 104 × 0.64 ≈ 66.5px,
                                                     desenho escalado por igual, glow e
                                                     tremor incluídos, nada cortado.

                                                     Não há ancestral com
                                                     ClipToBounds=True sobre o botão
                                                     (o Grid da linha 363 é o fundo
                                                     decorativo, irmão do conteúdo), o
                                                     que também foi verificado. -->
                                                <Grid HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"
                                                      Margin="0,-2,0,6"
                                                      ClipToBounds="False"
                                                      IsHitTestVisible="False">
                                                    <Grid.Style>
                                                        <Style TargetType="Grid">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsMasterRunning}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                                <!-- [UPDATE-FLUXO] Exibe durante a atualizacao, como na otimizacao. -->
                                                                <DataTrigger Binding="{Binding IsUpdateFlowActive}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Grid.Style>

                                                    <Grid.LayoutTransform>
                                                        <ScaleTransform ScaleX="0.64" ScaleY="0.64"/>
                                                    </Grid.LayoutTransform>

                                                    <controls:AiFaceView x:Name="RunningFaceHost"
                                                                         Width="104" Height="104"
                                                                         Mood="{Binding EffectiveFaceMood}"
                                                                         EffortBoost="{Binding MasterFaceEffortBoost}"
                                                                         AnimationsEnabled="{Binding ShouldAnimationsRun}"/>
                                                </Grid>

                                                <!-- [FIX:AI-BADGE-POS] Badge "VOLTRIS IA" DURANTE
                                                     A EXECUÇÃO, logo abaixo do rosto.
                                                    
                                                    O badge original (mais abaixo,
                                                    junto do total liberado) fica
                                                    abaixo da PORCENTAGEM, porque
                                                    no StackPanel ele vem depois
                                                    dela. Durante a execução o
                                                    rosto é pequeno e está no
                                                    topo, então o nome da IA
                                                    ficava solto, longe da cara
                                                    que ele nomeia.
                                                    
                                                    Esta é a segunda instância do
                                                    MESMO badge, colocada entre o
                                                    rosto e a %, e visível
                                                    SOMENTE com IsMasterRunning =
                                                    True. A de baixo esconde-se
                                                    durante a execução (para não
                                                    duplicar). Em repouso continua
                                                    valendo só a de baixo, embaixo
                                                    do rosto grande — que é a
                                                    posição original e a correta
                                                    para o estado ocioso. -->
                                                <TextBlock Text="{Binding [AiBadge], Source={x:Static services:LocalizationService.Instance}}"
                                                           FontFamily="Segoe UI Variable Display, Segoe UI"
                                                           FontSize="9.5" FontWeight="SemiBold"
                                                           Foreground="#B8FFFFFF"
                                                           TextOptions.TextFormattingMode="Ideal"
                                                           HorizontalAlignment="Center"
                                                           Margin="0,-4,0,0">
                                                    <TextBlock.LayoutTransform>
                                                        <ScaleTransform ScaleX="1.18" ScaleY="1"/>
                                                    </TextBlock.LayoutTransform>
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsMasterRunning}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                                <!-- [UPDATE-FLUXO] Exibe durante a atualizacao, como na otimizacao. -->
                                                                <DataTrigger Binding="{Binding IsUpdateFlowActive}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>

                                                <!-- [UPDATE-FLUXO] "ATUALIZANDO" + VERSÃO, DENTRO DO CÍRCULO.
                                                ===========================================================
                                                [FIX:ONDE-TEXTO-MORA] ESTE É O LUGAR CERTO.
                                                O botão circular JÁ TEM um texto padrão: o badge de IA
                                                acima, com `FontSize 9.5` e `ScaleTransform
                                                1.18/1`, dentro do painel que tem `0.64`. Esse é
                                                o padrão do botão, e é ele que este texto copia.

                                                [FIX:TEXTO-ENORME] A PRIMEIRA TENTATIVA USOU
                                                `FontSize 22` e a frase completa. Erro duplo:

                                                1. A fonte. 22 contra 9.5 do badge é mais que
                                                o dobro do padrão — daí o bloco gigante.
                                                2. A frase. "Atualização detectada: versão
                                                1.0.3.9" com `TextWrapping` quebrava em três
                                                linhas dentro de um círculo de 290px.

                                                Aqui a fonte é a MESMA do badge, a frase é a CURTA
                                                (`UpdateBtnDetected` = "Atualizando v{0}") e o
                                                corte é por `TextTrimming`, que nunca quebra
                                                linha. A versão vai em {0} para a tradução
                                                decidir a posição dela na frase, e não o código.

                                                `IsHitTestVisible="False"` é obrigatório: o
                                                círculo é um botão, e um texto que captura o
                                                clique deixaria o usuário clicar em cima dele
                                                sem a trava de atualização responder. -->
                                                <TextBlock Text="{Binding UpdateFlowStatusText}"
                                                           FontFamily="Segoe UI Variable Display, Segoe UI"
                                                           FontSize="9.5"
                                                           FontWeight="SemiBold"
                                                           TextOptions.TextFormattingMode="Ideal"
                                                           TextOptions.TextRenderingMode="ClearType"
                                                           HorizontalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis"
                                                           MaxWidth="250"
                                                           IsHitTestVisible="False"
                                                           Margin="0,-2,0,0">
                                                    <!-- [UPDATE-FLUXO] MESMA COR DO TÍTULO "VOLTRIS OPTIMIZER".
                                                    A brush é a mesma do title bar do header
                                                    (`VoltrisGradientHorizontalBrush`), e não uma cor
                                                    escolhida aqui: é a identidade visual da marca, e
                                                    escolher uma cor parecida seria uma cópia que
                                                    diverge na primeira mudança de tema.

                                                    O botão circular já usa essa identidade no
                                                    "Clique para Otimizar" e no botão de reinício. -->
                                                    <TextBlock.Foreground>
                                                        <StaticResource ResourceKey="VoltrisGradientHorizontalBrush"/>
                                                    </TextBlock.Foreground>
                                                    <TextBlock.LayoutTransform>
                                                        <ScaleTransform ScaleX="1.18" ScaleY="1"/>
                                                    </TextBlock.LayoutTransform>
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsUpdateFlowActive}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>

                                                <!-- Grande porcentagem real do progresso (item 5) -->
                                                <TextBlock Text="{Binding MasterProgress, StringFormat={}{0:0}%}" FontSize="62"
                                                           FontWeight="Bold" Foreground="White" HorizontalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsMasterRunning}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                                <!-- [UPDATE-FLUXO] A PORCENTAGEM também aparece durante a
                                                                ATUALIZAÇÃO. Sem este gatilho, o número fica invisível
                                                                durante o download: `IsMasterRunning` só é true para a
                                                                otimização, e o usuário via um download acontecendo sem
                                                                ver um único número.

                                                                O gatilho traz também a COR DA MARCA, a mesma do
                                                                título "VOLTRIS OPTIMIZER" do header. Na otimização a
                                                                porcentagem continua branca: o gatilho é do fluxo
                                                                de atualização, e não geral, para não alterar a
                                                                aparência de um estado que já estava aprovado. -->
                                                                <DataTrigger Binding="{Binding IsUpdateFlowActive}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                    <Setter Property="Foreground">
                                                                        <Setter.Value>
                                                                            <StaticResource ResourceKey="VoltrisGradientHorizontalBrush"/>
                                                                        </Setter.Value>
                                                                    </Setter>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>

                                                <!-- [UPDATE-FLUXO] O BOTÃO CIRCULAR NÃO MOSTRA TEXTO.
                                                ==================================================
                                                [FIX:TEXTO-GIGANTE] A PRIMEIRA VERSÃO COLOCAVA AQUI
                                                UM `TextBlock` com o texto da atualização, e o resultado
                                                foi um bloco enorme e ilegível no meio do botão.

                                                O erro foi de padrão, não de medida. O botão circular
                                                NÃO mostra texto descritivo em momento nenhum:
                                                durante a otimização ele mostra SÓ a
                                                porcentagem (esta linha de cima), e a
                                                descrição do que está acontecendo fica na
                                                barra de baixo, no `StatusLabel`.

                                                Seguir o mesmo padrão é o que faz o
                                                usuário reconhecer a atualização como
                                                parte do mesmo sistema — e é o que
                                                impede o círculo de virar um amontoado
                                                de números e frases.

                                                A descrição da atualização é publicada
                                                em `UpdateFlowStatusText` e consumida
                                                pela `MainWindow`, que a escreve no
                                                `StatusLabel` da barra inferior. -->


                                                <!-- SCORE DA 1ª OTIMIZAÇÃO (aparece só na 1ª vez)
                                                     Fica acima do rosto, discreto. -->
                                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                                            IsHitTestVisible="False">
                                                    <StackPanel.Style>
                                                        <Style TargetType="StackPanel">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding MasterShowScoreLine}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </StackPanel.Style>

                                                    <TextBlock Text="{Binding MasterRealScore, StringFormat={}{0:0}}"
                                                               FontSize="30" FontWeight="Bold"
                                                               Foreground="#7DF9C6" HorizontalAlignment="Center"/>
                                                    <TextBlock Text="{Binding [ProfilerKernelEfficiencyScore], Source={x:Static services:LocalizationService.Instance}}"
                                                               FontSize="8" Foreground="#B8FFFFFF"
                                                               HorizontalAlignment="Center" Margin="0,-2,0,0"/>
                                                </StackPanel>

                                                <!-- ANIMAÇÃO DE FESTA (halo pulsante)
                                                     Width/Height = 0 de propósito: o halo
                                                     desenha 232px centrados nesse ponto sem
                                                     ocupar espaço no layout. Se tivesse
                                                     232px de altura, empurraria o conteúdo
                                                     para fora dos 290px do botão.
                                                     Some sozinha. -->
                                                <Grid x:Name="CelebrationFx" IsHitTestVisible="False"
                                                      Width="0" Height="0"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                                      Opacity="0" Visibility="Collapsed">
                                                    <Grid.Style>
                                                        <Style TargetType="Grid">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding MasterConfettiActive}" Value="True">
                                                                    <DataTrigger.EnterActions>
                                                                        <BeginStoryboard x:Name="ConfettiFade">
                                                                            <Storyboard>
                                                                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                                                 From="0" To="1" Duration="0:0:0.18"/>
                                                                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                                                 From="1" To="0" BeginTime="0:0:3.6" Duration="0:0:0.7"/>
                                                                            </Storyboard>
                                                                        </BeginStoryboard>
                                                                    </DataTrigger.EnterActions>
                                                                    <DataTrigger.ExitActions>
                                                                        <StopStoryboard BeginStoryboardName="ConfettiFade"/>
                                                                    </DataTrigger.ExitActions>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Grid.Style>

                                                    <Ellipse Width="232" Height="232" Stroke="#4D7DF9C6" StrokeThickness="2" Opacity="0">
                                                        <Ellipse.RenderTransform>
                                                            <ScaleTransform x:Name="HaloScale" ScaleX="1" ScaleY="1"/>
                                                        </Ellipse.RenderTransform>
                                                        <Ellipse.Style>
                                                            <Style TargetType="Ellipse">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding MasterConfettiActive}" Value="True">
                                                                        <DataTrigger.EnterActions>
                                                                            <BeginStoryboard>
                                                                                <Storyboard RepeatBehavior="Forever">
                                                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                                                     From="0.8" To="0.05" Duration="0:0:1.1"
                                                                                                     AutoReverse="True"/>
                                                                                    <DoubleAnimation Storyboard.TargetProperty="(RenderTransform).(ScaleTransform.ScaleX)"
                                                                                                     From="0.94" To="1.16" Duration="0:0:1.5"
                                                                                                     AutoReverse="True"/>
                                                                                    <DoubleAnimation Storyboard.TargetProperty="(RenderTransform).(ScaleTransform.ScaleY)"
                                                                                                     From="0.94" To="1.16" Duration="0:0:1.5"
                                                                                                     AutoReverse="True"/>
                                                                                </Storyboard>
                                                                            </BeginStoryboard>
                                                                        </DataTrigger.EnterActions>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Ellipse.Style>
                                                    </Ellipse>
                                                </Grid>

                                                <!-- CAMADA IDLE: rosto da IA (AiFaceView)
                                                     18 expressões compostas por parâmetros
                                                     (AiFaceExpression), não 18 desenhos.
                                                     A troca rosto -> raio no hover é feita
                                                     DENTRO do próprio controle, cruzando a
                                                     opacidade de duas camadas irmãs; aqui
                                                     não se mexe em nada.

                                                     [FIX:FACE-RUN] Este é o rosto de
                                                     REPOUSO, e só aparece com
                                                     IsMasterRunning = False. Durante a
                                                     execução quem aparece é o
                                                     RunningFaceLayer, acima da %.

                                                     [FIX:FACE-MOOD] EffectiveFaceMood, e
                                                     não BrainMood direto: se ficasse no
                                                     Brain, o rosto de repouso ignoraria
                                                     o override da fase. Aqui ele é
                                                     igual ao Brain na prática (o
                                                     override é limpo ao fim da
                                                     operação), mas a ligação é
                                                     explícita e não depende dessa
                                                     coincidência. -->
                                                <!-- [UPDATE-FLUXO] CAMADA IDLE DO ROSTO.
                                                Este é o rosto de REPOUSO — o de 104px, sem
                                                escala. O gatilho original é
                                                `IsMasterRunning = False`, e ele é a razão
                                                do nome "FaceHost" (host de repouso) contra
                                                `RunningFaceHost`, que é o pequeno e escalado
                                                que fica no topo.

                                                [FIX:ROSTO-IDLE-SUMIU] ESTE GATILHO FOI
                                                QUEBRADO POR MIM, E VOLTOU AO ORIGINAL.
                                                Uma inserção automática colocou aqui
                                                `IsMasterRunning = True`, que é o gatilho
                                                do OUTRO rosto. O efeito: em repouso os dois
                                                rostos ficavam ocultos ao mesmo tempo, e o
                                                botão ficava sem rosto nenhum com o programa
                                                parado.

                                                A conferência foi feita contra a cópia de
                                                trabalho (`APLICATIVO VOLTRIS - Copia`), onde
                                                o bloco está comentado como "CAMADA IDLE" e o
                                                gatilho é `False`. Comparar com uma cópia que
                                                funcionava é o que transformou uma suposição
                                                em um fato.

                                                O segundo gatilho esconde esta camada durante
                                                a atualização, para que o usuário veja só o
                                                rosto pequeno de execução — o mesmo da
                                                otimização. -->
                                                <Grid Width="104" Height="104" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-4,0,0">
                                                    <Grid.Style>
                                                        <Style TargetType="Grid">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsMasterRunning}" Value="False">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                                <!-- [UPDATE-FLUXO] some durante a atualizacao -->
                                                                <DataTrigger Binding="{Binding IsUpdateFlowActive}" Value="True">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Grid.Style>

                                                    <controls:AiFaceView x:Name="FaceHost"
                                                                         Width="104" Height="104"
                                                                         Mood="{Binding EffectiveFaceMood}"
                                                                         AnimationsEnabled="{Binding ShouldAnimationsRun}"/>
                                                </Grid>

                                                <!-- TOTAL LIBERADO — DENTRO DO CÍRCULO
                                                     Aparece ao final de TODAS as limpezas,
                                                     com o rosto da IA feliz acima e a
                                                     animação de festa. O número vem do
                                                     CleanResult (espaço realmente apagado). -->
                                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                                            IsHitTestVisible="False" Margin="0,-10,0,0">
                                                    <StackPanel.Style>
                                                        <Style TargetType="StackPanel">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding MasterCelebrationVisible}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </StackPanel.Style>

                                                    <!-- o total real liberado -->
                                                    <TextBlock Text="{Binding MasterFreedDisplay}"
                                                               FontSize="40" FontWeight="Bold"
                                                               Foreground="#7DF9C6" HorizontalAlignment="Center"
                                                               TextOptions.TextFormattingMode="Ideal"/>
                                                    <!-- Memória devolvida: grandeza SEPARADA do espaço em disco.
                                                         String vazia quando não houve ganho >= 1 MB, então o
                                                         item fica com altura zero e não empurra o layout. -->
                                                    <TextBlock Text="{Binding MasterRamReclaimedDisplay}"
                                                               FontSize="13" FontWeight="SemiBold"
                                                               Foreground="#8B5CF6" HorizontalAlignment="Center"
                                                               Margin="0,2,0,0"/>
                                                    <!-- rótulo "Liberado" -->
                                                    <TextBlock Text="{Binding MasterCelebrationTitle}"
                                                               FontSize="10" FontWeight="SemiBold"
                                                               Foreground="White" HorizontalAlignment="Center"
                                                               Margin="0,-4,0,0" TextAlignment="Center"/>
                                                    <!-- na 1ª otimização: quantas foram verificadas -->
                                                    <TextBlock Text="{Binding MasterCelebrationDetail}"
                                                               FontSize="8.5" Foreground="#CCFFFFFF"
                                                               HorizontalAlignment="Center" TextAlignment="Center"
                                                               Margin="0,3,0,0"/>
                                                </StackPanel>

                                                <!-- Badge da IA: uppercase + SemiBold + traçado aberto.
                                                     Durante a comemoração some: o número
                                                     do total liberado já ocupa o centro.

                                                     WPF TextBlock NAO tem letterspacing
                                                     (existe no Silverlight/UWP, não no WPF).
                                                     A aproximação fiel é um LayoutTransform
                                                     horizontal:|escalar os glifos afasta um do
                                                     outro exatamente como o tracking faria.
                                                     HorizontalAlignment=Center continua
                                                     correto porque o LayoutTransform participa
                                                     do cálculo do slot. -->
                                                <TextBlock Text="{Binding [AiBadge], Source={x:Static services:LocalizationService.Instance}}"
                                                           FontFamily="Segoe UI Variable Display, Segoe UI"
                                                           FontSize="9.5" FontWeight="SemiBold"
                                                           Foreground="#B8FFFFFF"
                                                           TextOptions.TextFormattingMode="Ideal"
                                                           HorizontalAlignment="Center" Margin="0,-8,0,0">
                                                    <TextBlock.LayoutTransform>
                                                        <ScaleTransform ScaleX="1.18" ScaleY="1"/>
                                                    </TextBlock.LayoutTransform>
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding MasterCelebrationVisible}" Value="True">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                                <!-- [FIX:AI-BADGE-POS] Esconde durante a execução:
                                                                     quem aparece embaixo do rosto pequeno é a
                                                                     segunda instância, colocada acima da %. -->
                                                                <DataTrigger Binding="{Binding IsMasterRunning}" Value="True">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                                <!-- [FIX:AI-BADGE-DUPLICADO-NA-ATUALIZACAO] ESTE ERA O BUG.
                                                                     [FIX:ONDE-TEXTO-MORA] A DEDUPLICACAO ESTAVA SÓ NA METADE.

                                                                     Existem DOIS TextBlocks com o mesmo binding `[AiBadge]`
                                                                     dentro do mesmo botão circular: este, aqui embaixo
                                                                     (L1276), e outro entre o rosto e a porcentagem (L913).

                                                                     A intenção era que apenas um deles aparecesse por vez: o
                                                                     de cima durante a otimização, o de baixo em repouso.
                                                                     E isso funcionava — mas só para a otimização, porque SÓ o
                                                                     de cima foi ligado a `IsUpdateFlowActive`, e SÓ o de
                                                                     baixo foi ligado a `IsMasterRunning`.

                                                                     Na atualização, o gatilho que o de baixo escuta
                                                                     (`IsMasterRunning`) nunca fica verdadeiro, porque
                                                                     durante o download o programa não está otimizando —
                                                                     está baixando. Resultado: os dois ficavam
                                                                     visíveis ao mesmo tempo, e o usuário lia
                                                                     "VOLTRIS IA" duas vezes, uma colada no rosto e
                                                                     outra perdida no meio do círculo.

                                                                     A correção é fechar a paridade, não apagar o
                                                                     duplicado: o de baixo passa a esconder também
                                                                     quando a atualização está ativa, exatamente como
                                                                     o de cima aparece quando ela está.
                                                                     -->
                                                                <DataTrigger Binding="{Binding IsUpdateFlowActive}" Value="True">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>

                                                <!-- Subtexto abaixo (item 5) — escondido durante a execução (só a porcentagem fica visível) -->
                                                <TextBlock Text="{Binding MasterSubText}" FontSize="12" Foreground="#CCFFFFFF"
                                                           HorizontalAlignment="Center" TextWrapping="Wrap" MaxWidth="230" Margin="0,6,0,0">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsMasterRunning}" Value="False">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                          <!-- [UPDATE-FLUXO] Hide during update: same rule as optimization. -->
                                                          <DataTrigger Binding="{Binding IsUpdateFlowActive}" Value="True">
                                                              <Setter Property="Visibility" Value="Collapsed"/>
                                                          </DataTrigger>
                                                                <DataTrigger Binding="{Binding MasterCelebrationVisible}" Value="True">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>

                                                <!-- Última otimização (apenas idle) -->
                                                <TextBlock Text="{Binding MasterLastRunText}" FontSize="10" Foreground="#88FFFFFF"
                                                           HorizontalAlignment="Center" TextWrapping="Wrap" MaxWidth="230">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsMasterRunning}" Value="False">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                          <!-- [UPDATE-FLUXO] Hide during update: same rule as optimization. -->
                                                          <DataTrigger Binding="{Binding IsUpdateFlowActive}" Value="True">
                                                              <Setter Property="Visibility" Value="Collapsed"/>
                                                          </DataTrigger>
                                                                <DataTrigger Binding="{Binding MasterCelebrationVisible}" Value="True">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>

                                                <!-- "Clique para Otimizar" — mesma identidade visual do header (VOLTRIS OPTIMIZER) -->
                                                <TextBlock Text="{Binding [ClickToOptimize], Source={x:Static services:LocalizationService.Instance}}"
                                                           FontFamily="Segoe UI Variable Display, Segoe UI"
                                                           FontSize="12" FontWeight="SemiBold"
                                                           HorizontalAlignment="Center" TextWrapping="Wrap" MaxWidth="230"
                                                           Margin="0,10,0,0" TextOptions.TextFormattingMode="Display"
                                                           TextOptions.TextRenderingMode="ClearType">
                                                    <TextBlock.Foreground>
                                                        <StaticResource ResourceKey="VoltrisGradientHorizontalBrush"/>
                                                    </TextBlock.Foreground>
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsMasterRunning}" Value="False">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                          <!-- [UPDATE-FLUXO] Hide during update: same rule as optimization. -->
                                                          <DataTrigger Binding="{Binding IsUpdateFlowActive}" Value="True">
                                                              <Setter Property="Visibility" Value="Collapsed"/>
                                                          </DataTrigger>
                                                                <DataTrigger Binding="{Binding MasterCelebrationVisible}" Value="True">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>

                                                <TextBlock Text="{Binding [ClickToCancel], Source={x:Static services:LocalizationService.Instance}}" FontSize="10" FontWeight="SemiBold" Foreground="#99FFFFFF"
                                                           HorizontalAlignment="Center" Margin="0,4,0,0">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <MultiDataTrigger>
                                                                    <MultiDataTrigger.Conditions>
                                                                        <Condition Binding="{Binding IsMasterRunning}" Value="True"/>
                                                                        <Condition Binding="{Binding IsCancelling}" Value="False"/>
                                                                    </MultiDataTrigger.Conditions>
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </MultiDataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>

                                                <!-- "Cancelando..." — surge ao clicar para cancelar, traduzido (PT/ES/EN) -->
                                                <TextBlock Text="{Binding [MasterCanceling], Source={x:Static services:LocalizationService.Instance}}" FontSize="12" FontWeight="Bold" Foreground="#FFFF6B5E"
                                                           HorizontalAlignment="Center" Margin="0,4,0,0">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsCancelling}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>

                                            <!-- Anel interno de acabamento -->
                                            <Ellipse Stroke="#2EFFFFFF" StrokeThickness="3" Margin="3"/>
                                        </Grid>
                                    </Border>
                                </Grid>
                                <ControlTemplate.Triggers>
                                    <!-- Hover do botão (item 7 do pedido).
                                         O que o hover faz AQUI é só uma leve elevação
                                         de contraste do núcleo. A troca rosto -> ícone
                                         de raio é feita dentro da AiFaceView, porque
                                         ela precisa continuar TEMENDO o estado do
                                         Brain durante o hover - se o XAML escondesse o
                                         rosto, o Binding continuaria Evaluando mas o
                                         controle pararia de desenhar, e a expressao
                                         "corrigida" ao sair do hover seria uma
                                         reconstituicao, nao o estado vivo.

                                         ALVO: Grid x:Name="ring" — FrameworkElement
                                         DENTRO do ControlTemplate (regra: Setter de
                                         template resolve só FrameworkElements do
                                         namescope do template). DP: Opacity, que é
                                         propriedade do próprio Grid — usar
                                         StrokeThickness daria MC4109 (Grid não tem
                                         essa DP) e Effect/Transform dariam
                                         MC4109/MC4111 (não são FrameworkElement). -->
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="ring" Property="Opacity" Value="0.92"/>
                                        <!-- O raio pertence ao BOTAO de 290px, nao ao
                                             rosto de 104px. O IsMouseOver acima e do
                                             Button, entao o portao cobre a superficie
                                             inteira do nucleo: passar o mouse na
                                             coroa, na borda, no "clique para
                                             otimizar" - tudo troca o rosto pelo
                                             raio. FaceHost esta no namescope
                                             deste ControlTemplate, entao o
                                             TargetName resolve. -->
                                        <Setter TargetName="FaceHost" Property="IsHoverArmed" Value="True"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- PARTÍCULAS DE EXECUÇÃO (ultra profissional): COMETA de energia varrendo o
                         núcleo com cauda em gradiente + detritos cintilantes orbitando —
                         vista de console de alta tecnologia enquanto a otimização roda. -->
                <Canvas x:Name="OrbitCanvas" Width="320" Height="320" IsHitTestVisible="False"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        CacheMode="BitmapCache"
                        RenderTransformOrigin="0.5,0.5">
                        <Canvas.RenderTransform>
                            <RotateTransform x:Name="OrbitRotate" Angle="0"/>
                        </Canvas.RenderTransform>
                        <Canvas.Triggers>
                            <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="OrbitRotate" Storyboard.TargetProperty="Angle" From="0" To="360" Duration="0:0:14" RepeatBehavior="Forever"/>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="eo1" Storyboard.TargetProperty="Opacity" Duration="0:0:3" RepeatBehavior="Forever">
                                            <LinearDoubleKeyFrame Value="0.2" KeyTime="0%"/>
                                            <LinearDoubleKeyFrame Value="0.9" KeyTime="50%"/>
                                            <LinearDoubleKeyFrame Value="0.2" KeyTime="100%"/>
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="eo2" Storyboard.TargetProperty="Opacity" Duration="0:0:3" RepeatBehavior="Forever" BeginTime="-0:0:0.75">
                                            <LinearDoubleKeyFrame Value="0.2" KeyTime="0%"/>
                                            <LinearDoubleKeyFrame Value="0.9" KeyTime="50%"/>
                                            <LinearDoubleKeyFrame Value="0.2" KeyTime="100%"/>
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="eo3" Storyboard.TargetProperty="Opacity" Duration="0:0:3" RepeatBehavior="Forever" BeginTime="-0:0:1.5">
                                            <LinearDoubleKeyFrame Value="0.2" KeyTime="0%"/>
