                                <ScaleTransform/>
                            </Ellipse.RenderTransform>
                        </Ellipse>
                    </Canvas>

                    <!-- ARCO DE PROGRESSO REAL (item 2/15): desenhado ACIMA do botão, girando
                         EXATAMENTE na borda azul do NÚCLEO (raio 145 = contorno do botão de
                         290px; geometria absoluta 320x320, Stretch=None). Traço fino (4.5) e
                         tocando a borda — nem pra dentro, nem pra fora, nem maior que ela.
                         Fica verde quando o progresso chega a 100%. -->
                    <Path x:Name="ring" Width="320" Height="320" StrokeThickness="4.5" Stretch="None"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          HorizontalAlignment="Center" VerticalAlignment="Center"
                          IsHitTestVisible="False"
                          CacheMode="BitmapCache"
                          Data="{Binding MasterProgress, Converter={StaticResource ArcProgressConverter}}">
                        <Path.Style>
                            <Style TargetType="Path">
                                <Setter Property="Stroke" Value="{StaticResource MainGradient}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding MasterProgress}" Value="100">
                                        <Setter Property="Stroke" Value="#10B981"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Path.Style>
                    </Path>

                    <!-- [FIX:RING] ANEL NEON DO BOTÃO CIRCULAR.
                         
                         ANTES: só visível com IsGamerModeActive=True. Era um
                         indicador de modo escondido dentro de um elemento de
                         identidade, que é a Catch-22 clássica: a coisa mais
                         bonita do botão só existia num modo que não é o padrão.

                         AGORA: sempre visível fora da operação
                         (MasterRingVisible), girando o tempo todo. Três estados:

                           repouso     -> anel colorido girando
                           otimizando  -> some (MasterRingVisible = false), fica
                                          só a barra do arco
                           comemorando -> anel VERDE, a confirmação de sucesso
                                          (MasterRingSuccess)

                         O VERDE É AMARRADO À COMEMORAÇÃO, não a um timer: ela
                         dura 4800 ms e some junto com a festa, então não há
                         dois relógios para discordar.

                         A animação de rotação e a de opacidade continuam no
                         mesmo Storyboard, e ele é iniciado por
                         MasterRingVisible em vez do Modo Gamer — assim parar
                         de girar e esconder são o mesmo evento, e o anel não
                         queima CPU escondido.

                         O badge vermelho embaixo NÃO mudou: continua sendo o
                         indicador de que o Modo Gamer está ligado, e só
                         aparece nesse caso. -->
                <Path x:Name="GamerRing" Width="320" Height="320" Stretch="None" StrokeThickness="7"
                      IsHitTestVisible="False" HorizontalAlignment="Center" VerticalAlignment="Center"
                      CacheMode="BitmapCache"
                      RenderTransformOrigin="0.5,0.5">
                        <Path.RenderTransform>
                            <RotateTransform Angle="0"/>
                        </Path.RenderTransform>
                        <Path.Stroke>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#FFFF4B6B" Offset="0"/>
                                <GradientStop Color="#FF8B31FF" Offset="0.5"/>
                                <GradientStop Color="#FF31A8FF" Offset="1"/>
                            </LinearGradientBrush>
                        </Path.Stroke>
                        <Path.Data>
                            <EllipseGeometry Center="160,160" RadiusX="156" RadiusY="156"/>
                        </Path.Data>
                        <Path.Effect>
                            <DropShadowEffect BlurRadius="16" ShadowDepth="0" Opacity="0.85" Color="#FF3B30"/>
                        </Path.Effect>
                        <Path.Style>
                            <Style TargetType="Path">
                                <Style.Triggers>
                                    <!-- Visível fora da operação: inicia giro e pulso.
                                         SÓ ISSO, sem condição de Modo Gamer. -->
                                    <DataTrigger Binding="{Binding MasterRingVisible}" Value="True">
                                        <DataTrigger.EnterActions>
                                            <BeginStoryboard x:Name="gamerRingAnim">
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                                     From="0" To="360" Duration="0:0:8" RepeatBehavior="Forever"/>
                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.55" To="1"
                                                                     Duration="0:0:2" AutoReverse="True" RepeatBehavior="Forever"/>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </DataTrigger.EnterActions>
                                        <DataTrigger.ExitActions>
                                            <StopStoryboard BeginStoryboardName="gamerRingAnim"/>
                                        </DataTrigger.ExitActions>
                                    </DataTrigger>

                                    <!-- [FIX:RING] Some durante a otimização.
                                         Um Setter, e não uma animação: no WPF o
                                         valor de um Setter de trigger tem
                                         PRECEDÊNCIA sobre a animação, então é
                                         ele que garante o Opacity 0 de verdade
                                         enquanto a barra do arco manda. -->
                                    <DataTrigger Binding="{Binding MasterRingVisible}" Value="False">
                                        <Setter Property="Opacity" Value="0"/>
                                    </DataTrigger>

                                    <!-- [FIX:RING] Verde de confirmação. Troca traço
                                         E halo juntos: trocar só a cor deixaria o
                                         brilho vermelho brigando com o verde. -->
                                    <DataTrigger Binding="{Binding MasterRingSuccess}" Value="True">
                                        <Setter Property="Stroke" Value="#10B981"/>
                                        <Setter Property="Effect">
                                            <Setter.Value>
                                                <DropShadowEffect BlurRadius="18" ShadowDepth="0" Opacity="0.9" Color="#10B981"/>
                                            </Setter.Value>
                                        </Setter>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Path.Style>
                    </Path>

                    <!-- [FIX:RGB] ANEL RGB — CAMADA SEPARADA, SOBRE O ANEL COLORIDO.
                    
                    POR QUE UM PATH SEPARADO, E NÃO MUDAR O GamerRing
                    ======================================================
                    O GamerRing é a borda normal, e ela tem que continuar
                    exatamente como é: gradiente vermelho→roxo→azul girando,
                    presente sempre fora da otimização. Se o RGB fosse um
                    trigger dentro dele, cada mudança de cor/setter brigaria
                    com a animação de rotação e com o verde de sucesso — três
                   _animações separadas: cada uma tem UM dono, e nenhuma cancela a outra.

                    POR QUE NENHUM GRADIENTE É ANIMADO
                    ===================================
                    Animar `GradientStop.Offset` ou `Color` obriga o WPF a
                    redesenhar o traço a CADA QUADRO, e isso INVALIDA o
                    `CacheMode="BitmapCache"` — o bitmap é jogado fora 60x por
                    segundo. É exatamente o custo que o usuário não quer em
                    segundo plano, e é o tipo de detalhe que se paga caro sem
                    parecer diferente.

                    O efeito vem de DUAS rotações com velocidades DIFERENTES
                    sobre o mesmo gradiente RGB:
                      anel base  -> 8s  (o lento, o "corpo" da borda)
                      anel RGB   -> 5s  (o rápido, o brilho que "flui" por cima)
                    A diferença de ritmo é o que produz a leitura de modernidade
                    — e custa exatamente o mesmo que o anel base já custava,
                    porque é só `RotateTransform` + `Opacity`, ambos servidos
                    pelo cache de bitmap.

                    GATILHO DUPLO, E POR QUÊ
                    ========================
                    A animação só roda com o Modo Gamer LIGADO **E** as
                    animações habilitadas (`ShouldAnimationsRun`, que é
                    `foreground && viewVisible` e já existia no projeto com o
                    log [GFX]). Reutilizar esse gate em vez de criar um terceiro
                    é o que garante que nenhuma animação fique rodando em
                    segundo plano: o MultiDataTrigger desliga nos dois casos e
                    o `StopStoryboard` garante que o relógio pare de verdade. -->
                <Path x:Name="GamerRgbRing" Width="320" Height="320" Stretch="None" StrokeThickness="9"
                      IsHitTestVisible="False" HorizontalAlignment="Center" VerticalAlignment="Center"
                      CacheMode="BitmapCache"
                      RenderTransformOrigin="0.5,0.5" Opacity="0">
                    <Path.RenderTransform>
                        <RotateTransform Angle="0"/>
                    </Path.RenderTransform>
                    <Path.Stroke>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#FF2D55" Offset="0"/>
                            <GradientStop Color="#00E676" Offset="0.34"/>
                            <GradientStop Color="#2979FF" Offset="0.67"/>
                            <GradientStop Color="#FF2D55" Offset="1"/>
                        </LinearGradientBrush>
                    </Path.Stroke>
                    <Path.Data>
                        <EllipseGeometry Center="160,160" RadiusX="156" RadiusY="156"/>
                    </Path.Data>
                    <Path.Effect>
                        <DropShadowEffect BlurRadius="20" ShadowDepth="0" Opacity="0.9" Color="#FF2D55"/>
                    </Path.Effect>
                    <Path.Style>
                        <Style TargetType="Path">
                            <Setter Property="Opacity" Value="0"/>
                            <Style.Triggers>
                                <!-- Sobe/desce com o RGB ligado E animação habilitada. -->
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding IsGamerModeActive}" Value="True"/>
                                        <Condition Binding="{Binding ShouldAnimationsRun}" Value="True"/>
                                    </MultiDataTrigger.Conditions>
                                    <MultiDataTrigger.EnterActions>
                                        <BeginStoryboard x:Name="gamerRgbAnim">
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                                 From="0" To="360" Duration="0:0:5" RepeatBehavior="Forever"/>
                                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.35" To="0.95"
                                                                 Duration="0:0:0.9" AutoReverse="True" RepeatBehavior="Forever"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </MultiDataTrigger.EnterActions>
                                    <MultiDataTrigger.ExitActions>
                                        <!-- Para o relógio, e some: um StopStoryboard
                                             sem o qual a animação continuaria
                                             consumindo CompositionTarget mesmo
                                             com o gatilho desligado. -->
                                        <StopStoryboard BeginStoryboardName="gamerRgbAnim"/>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.25"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </MultiDataTrigger.ExitActions>
                                </MultiDataTrigger>

                                <!-- Rede de segurança: se o Modo Gamer cair, o
                                     Setter 0 vence QUALQUER animação em curso
                                     (no WPF, Setter de trigger tem precedência
                                     sobre animação). -->
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding IsGamerModeActive}" Value="False"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Opacity" Value="0"/>
                                </MultiDataTrigger>

                                <!-- Idem para o caso de pausa por segundo plano/
                                     view oculta. O ExitActions acima já parou o
                                     relógio; isto garante o pixels. -->
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding ShouldAnimationsRun}" Value="False"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Opacity" Value="0"/>
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Path.Style>
                </Path>

                    <!-- BADGE FLUTUANTE DO MODO GAMER: pílula de vidro com glow vermelho,
                         ancorada na borda inferior do anel. Visível apenas com o modo ativo. -->
                    <Border x:Name="GamerBadge"
                            HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,6"
                            CornerRadius="18" Padding="16,7" IsHitTestVisible="False">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#E6181216" Offset="0"/>
                                <GradientStop Color="#EF3A0D0D" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <Border.BorderBrush>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#66FF5A5A" Offset="0"/>
                                <GradientStop Color="#0FFF5A5A" Offset="0.6"/>
                                <GradientStop Color="#FFE53B3B" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.BorderBrush>
                        <Border.BorderThickness>1</Border.BorderThickness>
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="22" ShadowDepth="3" Direction="270" Opacity="0.7" Color="#FF3B30"/>
                        </Border.Effect>
                        <StackPanel Orientation="Horizontal">
                            <Grid Width="12" Height="12" Margin="0,0,9,0" VerticalAlignment="Center">
                                <Ellipse x:Name="GamerDotHalo" Width="12" Height="12" Fill="#55FF5A5A">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsGamerModeActive}" Value="True">
                                                    <DataTrigger.EnterActions>
                                                        <BeginStoryboard x:Name="gamerDotHaloPulse">
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                                 From="0.85" To="0.2" Duration="0:0:1.3" AutoReverse="True" RepeatBehavior="Forever"/>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </DataTrigger.EnterActions>
                                                    <DataTrigger.ExitActions>
                                                        <RemoveStoryboard BeginStoryboardName="gamerDotHaloPulse"/>
                                                    </DataTrigger.ExitActions>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <Ellipse x:Name="GamerDot" Width="6" Height="6" Fill="#FFFF3B30"
                                         HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsGamerModeActive}" Value="True">
                                                    <DataTrigger.EnterActions>
                                                        <BeginStoryboard x:Name="gamerDotPulse">
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                                 From="1" To="0.4" Duration="0:0:0.8" AutoReverse="True" RepeatBehavior="Forever"/>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </DataTrigger.EnterActions>
                                                    <DataTrigger.ExitActions>
                                                        <RemoveStoryboard BeginStoryboardName="gamerDotPulse"/>
                                                    </DataTrigger.ExitActions>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                            </Grid>
                            <Path Data="M21.58 16.09l-1.09-7.66C20.21 6.46 18.52 5 16.53 5H7.47C5.48 5 3.79 6.46 3.51 8.43l-1.09 7.66C2.2 17.63 3.39 19 4.94 19c.68 0 1.32-.27 1.8-.75L9 16h6l2.25 2.25c.48.48 1.13.75 1.8.75 1.56 0 2.75-1.37 2.53-2.91zM11 11H9v2H8v-2H6v-1h2V8h1v2h2v1zm4-1c-.55 0-1-.45-1-1s.45-1 1-1 1 .45 1 1-.45 1-1 1zm2 3c-.55 0-1-.45-1-1s.45-1 1-1 1 .45 1 1-.45 1-1 1z"
                                  Fill="#FFFF5A5A" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding [GamerModeActiveBadge], Source={x:Static services:LocalizationService.Instance}}"
                                       FontSize="11" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"
                                       Typography.Capitals="AllSmallCaps"/>
                        </StackPanel>
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsGamerModeActive}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <DataTrigger.EnterActions>
                                            <BeginStoryboard x:Name="gamerBadgePulse">
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                     From="0.92" To="1" Duration="0:0:1.6" AutoReverse="True" RepeatBehavior="Forever"/>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </DataTrigger.EnterActions>
                                        <DataTrigger.ExitActions>
                                            <RemoveStoryboard BeginStoryboardName="gamerBadgePulse"/>
                                        </DataTrigger.ExitActions>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                    </Border>

                    <!-- PARTÍCULAS DO NÚCLEO (idle): motes de luz subindo por dentro do botão.
                         RECONSTRUÍDO: eram 18 elementos com 68 animações concorrentes
                         (12 com deriva lateral), o que compete com a expressão facial
                         - exatamente o oposto do que um rosto de IA precisa. E o
                         Canvas NÃO respeitava ShouldAnimationsRun, então continuava
                         animando com o app minimizado (18 elementos * 68 tweens).

                         Agora: 5 motes, 5 animações de subida + 2 de deriva, todos
                         com durações longas e próximas (nada piscando rápido), e
                         Visibility=Collapsed quando ShouldAnimationsRun = false.
                         Colapsar a Visibility é o que realmente PARA a animação —
                         Opacity=0 continuaria compositando. -->
                    <Canvas x:Name="CoreParticlesCanvas" Width="230" Height="230"
                            HorizontalAlignment="Center" VerticalAlignment="Center"
                            IsHitTestVisible="False">
                        <Canvas.Triggers>
                            <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="cp1" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" From="0" To="-270" Duration="0:0:11.5" RepeatBehavior="Forever"/>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="cp1" Storyboard.TargetProperty="Opacity" Duration="0:0:11.5" RepeatBehavior="Forever">
                                            <LinearDoubleKeyFrame Value="0" KeyTime="0%"/>
                                            <LinearDoubleKeyFrame Value="0.55" KeyTime="20%"/>
                                            <LinearDoubleKeyFrame Value="0" KeyTime="100%"/>
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimation Storyboard.TargetName="cp1" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" From="0" To="-26" Duration="0:0:6" AutoReverse="True" RepeatBehavior="Forever" BeginTime="-0:0:2.1"/>

                                        <DoubleAnimation Storyboard.TargetName="cp2" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" From="0" To="-270" Duration="0:0:13.2" RepeatBehavior="Forever" BeginTime="-0:0:4.4"/>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="cp2" Storyboard.TargetProperty="Opacity" Duration="0:0:13.2" RepeatBehavior="Forever" BeginTime="-0:0:4.4">
                                            <LinearDoubleKeyFrame Value="0" KeyTime="0%"/>
                                            <LinearDoubleKeyFrame Value="0.5" KeyTime="20%"/>
                                            <LinearDoubleKeyFrame Value="0" KeyTime="100%"/>
                                        </DoubleAnimationUsingKeyFrames>

                                        <DoubleAnimation Storyboard.TargetName="cp3" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" From="0" To="-270" Duration="0:0:9.8" RepeatBehavior="Forever" BeginTime="-0:0:7.2"/>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="cp3" Storyboard.TargetProperty="Opacity" Duration="0:0:9.8" RepeatBehavior="Forever" BeginTime="-0:0:7.2">
                                            <LinearDoubleKeyFrame Value="0" KeyTime="0%"/>
                                            <LinearDoubleKeyFrame Value="0.45" KeyTime="20%"/>
                                            <LinearDoubleKeyFrame Value="0" KeyTime="100%"/>
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimation Storyboard.TargetName="cp3" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" From="0" To="30" Duration="0:0:7.4" AutoReverse="True" RepeatBehavior="Forever" BeginTime="-0:0:1.3"/>

                                        <DoubleAnimation Storyboard.TargetName="cp4" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" From="0" To="-270" Duration="0:0:12.1" RepeatBehavior="Forever" BeginTime="-0:0:2.8"/>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="cp4" Storyboard.TargetProperty="Opacity" Duration="0:0:12.1" RepeatBehavior="Forever" BeginTime="-0:0:2.8">
                                            <LinearDoubleKeyFrame Value="0" KeyTime="0%"/>
                                            <LinearDoubleKeyFrame Value="0.4" KeyTime="20%"/>
                                            <LinearDoubleKeyFrame Value="0" KeyTime="100%"/>
                                        </DoubleAnimationUsingKeyFrames>

                                        <DoubleAnimation Storyboard.TargetName="cp5" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" From="0" To="-270" Duration="0:0:14.6" RepeatBehavior="Forever" BeginTime="-0:0:9.6"/>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="cp5" Storyboard.TargetProperty="Opacity" Duration="0:0:14.6" RepeatBehavior="Forever" BeginTime="-0:0:9.6">
                                            <LinearDoubleKeyFrame Value="0" KeyTime="0%"/>
                                            <LinearDoubleKeyFrame Value="0.35" KeyTime="20%"/>
                                            <LinearDoubleKeyFrame Value="0" KeyTime="100%"/>
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Canvas.Triggers>
                        <Canvas.Style>
                            <Style TargetType="Canvas">
                                <Setter Property="Opacity" Value="0"/>
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding IsMasterRunning}" Value="False"/>
                                            <Condition Binding="{Binding IsGamerModeActive}" Value="False"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Opacity" Value="0.75"/>
                                    </MultiDataTrigger>
                                    <!-- PERFORMANCE: colapsar (e não esvaziar) é o que
                                         realmente interrompe a animação das 5 partículas
                                         quando o app sai do primeiro plano. -->
                                    <DataTrigger Binding="{Binding ShouldAnimationsRun}" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Canvas.Style>
                        <Ellipse x:Name="cp1" Width="5" Height="5" Canvas.Left="58" Canvas.Top="250" Opacity="0.5" RenderTransformOrigin="0.5,0.5">
                            <Ellipse.RenderTransform><TranslateTransform/></Ellipse.RenderTransform>
                            <Ellipse.Fill>
                                <RadialGradientBrush>
                                    <GradientStop Color="#E6FFFFFF" Offset="0"/>
                                    <GradientStop Color="#5A22D3EE" Offset="0.55"/>
                                    <GradientStop Color="#0022D3EE" Offset="1"/>
                                </RadialGradientBrush>
                            </Ellipse.Fill>
                        </Ellipse>
                        <Ellipse x:Name="cp2" Width="7" Height="7" Canvas.Left="128" Canvas.Top="250" Opacity="0.5" RenderTransformOrigin="0.5,0.5">
                            <Ellipse.RenderTransform><TranslateTransform/></Ellipse.RenderTransform>
                            <Ellipse.Fill>
                                <RadialGradientBrush>
                                    <GradientStop Color="#CCFFFFFF" Offset="0"/>
                                    <GradientStop Color="#33FFFFFF" Offset="0.6"/>
                                    <GradientStop Color="#00FFFFFF" Offset="1"/>
                                </RadialGradientBrush>
                            </Ellipse.Fill>
                        </Ellipse>
                        <Ellipse x:Name="cp3" Width="4" Height="4" Canvas.Left="92" Canvas.Top="250" Opacity="0.45" RenderTransformOrigin="0.5,0.5">
                            <Ellipse.RenderTransform><TranslateTransform/></Ellipse.RenderTransform>
                            <Ellipse.Fill>
                                <RadialGradientBrush>
                                    <GradientStop Color="#E6FFFFFF" Offset="0"/>
                                    <GradientStop Color="#558B31FF" Offset="0.55"/>
                                    <GradientStop Color="#008B31FF" Offset="1"/>
                                </RadialGradientBrush>
                            </Ellipse.Fill>
                        </Ellipse>
                        <Ellipse x:Name="cp4" Width="4" Height="4" Canvas.Left="164" Canvas.Top="250" Opacity="0.4" RenderTransformOrigin="0.5,0.5">
                            <Ellipse.RenderTransform><TranslateTransform/></Ellipse.RenderTransform>
                            <Ellipse.Fill>
                                <RadialGradientBrush>
                                    <GradientStop Color="#E6FFFFFF" Offset="0"/>
                                    <GradientStop Color="#553B82F6" Offset="0.55"/>
                                    <GradientStop Color="#003B82F6" Offset="1"/>
                                </RadialGradientBrush>
                            </Ellipse.Fill>
                        </Ellipse>
                        <Ellipse x:Name="cp5" Width="3" Height="3" Canvas.Left="108" Canvas.Top="250" Opacity="0.4" RenderTransformOrigin="0.5,0.5">
                            <Ellipse.RenderTransform><TranslateTransform/></Ellipse.RenderTransform>
                            <Ellipse.Fill>
                                <RadialGradientBrush>
                                    <GradientStop Color="#E6FFFFFF" Offset="0"/>
                                    <GradientStop Color="#5522D3EE" Offset="0.55"/>
                                    <GradientStop Color="#0022D3EE" Offset="1"/>
                                </RadialGradientBrush>
                            </Ellipse.Fill>
                        </Ellipse>
                    </Canvas>

                </Grid>
            </Viewbox>

            <!-- SAÚDE — topo esquerdo (mesmo estilo do cabeçalho clássico) -->
            <Border Grid.Row="0" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="28,20,0,0"
                    MinWidth="120" MaxWidth="170" CornerRadius="12" BorderThickness="1" Padding="10,8"
                    Background="{DynamicResource BgCardGlass}" BorderBrush="{DynamicResource BorderLight}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="32" Height="32" CornerRadius="8" Margin="0,0,10,0" VerticalAlignment="Center">
                        <Border.Effect>
                            <!-- A cor da sombra foi para a cor do miocárdio: o
                                 brilho externo do tile precisa ser da cor do
                                 órgão que ilumina, senão o roxo da marca faz
                                 uma orla falsa em volta de um coração
                                 carmim. -->
                            <DropShadowEffect BlurRadius="12" ShadowDepth="0" Opacity="0.35" Color="#FF3B54"/>
                        </Border.Effect>
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#1AFF4B6B" Offset="0"/>
                                <GradientStop Color="#1A8B31FF" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <!-- ══ ÍCONE DE SAÚDE ══════════════════════════════════
                             O coração e o batimento saem do controle
                             (HealthHeartIcon), e nao daqui. O motivo e
                             PERFORMANCE e FIDELIDADE: o batimento e um ciclo
                             cardiaco modelado em codigo (sistole, recoil
                             elastico, onda dicrotica, sistole auricular) com
                             4 eventos que mexem em 5 propriedades diferentes.
                             Em XAML isso seria um Storyboard de Opacity - que
                             e exatamente o que o icone antigo fazia, e Opacity
                             piscando NAO e um batimento.

                             Tudo que o XAML ainda decide e o que e layout: o
                             tile, o gradiente de fundo e a sombra. O
                             controle expoe So o estado (que vem do score
                             real) e o portao de animacao. -->
                        <controls:HealthHeartIcon State="{Binding HealthIconState}"
                                                  AnimationsEnabled="{Binding ShouldAnimationsRun}"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding [DashboardHealth], Source={x:Static services:LocalizationService.Instance}}" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource TextTertiary}"
                                   Typography.Capitals="AllSmallCaps" Margin="0,0,0,1"/>
                        <TextBlock Text="{Binding HealthStatusText}" FontSize="15" FontWeight="Bold" Foreground="{Binding HealthStatusColor}"/>
                        <Grid Height="4" Width="92" HorizontalAlignment="Left" Margin="0,4,0,0">
                            <Border Background="#1AFFFFFF" CornerRadius="2"/>
                            <ProgressBar Value="{Binding OverallScore, Mode=OneWay}" Maximum="100" Foreground="{Binding HealthStatusColor}" Background="Transparent" BorderThickness="0" Height="4"/>
                        </Grid>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- REPARO INTELIGENTE agora fica ao lado do toggle "INTERFACE CLÁSSICA" no rodapé (row 3, centralizado). -->

            <!-- Chip de informações reais da rodada (tempo decorrido + bytes liberados) — moderno apenas -->
            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,8,0,0">
                <Border Padding="14,6" MinWidth="160">
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource GlassCard}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsMasterRunning}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="{Binding MasterRunSummary}" FontSize="11" Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Center"/>
                </Border>
            </StackPanel>

            <!-- Indicadores secundários REAIS ao redor/abaixo do núcleo (item 12): CPU, RAM, GPU, DISCO, REDE.
                 Mesmo estilo dos cards clássicos (ícones + cores + barras). REDE mede download/upload reais — nunca valor fictício. -->
            <Grid Grid.Row="2" MaxWidth="840" HorizontalAlignment="Center" Margin="24,8,24,28">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <!-- CPU Metric (mesmo estilo do clássico) -->
                <Border Grid.Column="0" Style="{StaticResource GlassCard}" Padding="12,10" MinWidth="118" MinHeight="75" Margin="0,0,8,0">
                    <StackPanel VerticalAlignment="Center">
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Style="{StaticResource MetricIconFrame}" Background="#1A3B82F6">
                                    <Path Data="{StaticResource IconCpu}" Fill="{StaticResource BrushPrimary}" Width="13" Height="13" Stretch="Uniform"/>
                                </Border>
                                <TextBlock Text="{Binding [DashboardCpu], Source={x:Static services:LocalizationService.Instance}}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextDim}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                            <TextBlock Grid.Column="2" Text="{Binding CpuUsage, StringFormat={}{0:F0}%}" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="22" FontWeight="Bold" TextTrimming="CharacterEllipsis" Foreground="{StaticResource BrushPrimary}"/>
                        </Grid>
                        <ProgressBar Height="4" Value="{Binding CpuUsage, Mode=OneWay}" Maximum="100" Foreground="{StaticResource BrushPrimary}" Background="#1AFFFFFF" BorderThickness="0"/>
                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding [GamerDashCpuTemp], Source={x:Static services:LocalizationService.Instance}}" FontSize="10" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,6,0"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="M14,14.76 V5.5 A4.5,4.5 0 0,0 10,5.5 V14.76 A6.5,6.5 0 1,0 14,14.76 Z M12,2 A1.5,1.5 0 0,0 10.5,3.5 V15.32 A4.5,4.5 0 1,0 13.5,15.32 V3.5 A1.5,1.5 0 0,0 12,2 Z"
                                      Width="10" Height="10" Stretch="Uniform" VerticalAlignment="Center" Opacity="0.85">
                                    <Path.Fill>
                                        <MultiBinding Converter="{StaticResource ThermalIndicator}" ConverterParameter="Brush">
                                            <Binding Path="CpuTemperature"/>
                                            <Binding Path="CpuTemperature"/>
                                        </MultiBinding>
                                    </Path.Fill>
                                </Path>
                                <TextBlock Margin="4,0,0,0" FontSize="10" FontWeight="Bold" VerticalAlignment="Center">
                                    <TextBlock.Foreground>
                                        <MultiBinding Converter="{StaticResource ThermalIndicator}" ConverterParameter="Brush">
                                            <Binding Path="CpuTemperature"/>
                                            <Binding Path="CpuTemperature"/>
                                        </MultiBinding>
                                    </TextBlock.Foreground>
                                    <TextBlock.Text>
                                        <MultiBinding Converter="{StaticResource ThermalIndicator}">
                                            <Binding Path="CpuTemperature"/>
                                            <Binding Path="CpuTemperature"/>
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                                <TextBlock Text="~" FontSize="10" FontWeight="Bold" VerticalAlignment="Center"
                                           Visibility="{Binding IsTemperatureEstimated, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <TextBlock.Foreground>
                                        <MultiBinding Converter="{StaticResource ThermalIndicator}" ConverterParameter="Brush">
                                            <Binding Path="CpuTemperature"/>
                                            <Binding Path="CpuTemperature"/>
                                        </MultiBinding>
                                    </TextBlock.Foreground>
                                </TextBlock>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- RAM Metric (mesmo estilo do clássico) -->
                <Border Grid.Column="1" Style="{StaticResource GlassCard}" Padding="12,10" MinWidth="118" MinHeight="75" Margin="0,0,8,0">
                    <StackPanel VerticalAlignment="Center">
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Style="{StaticResource MetricIconFrame}" Background="#1A8B31FF">
                                    <Path Data="{StaticResource IconRam}" Fill="{StaticResource BrushAccent2}" Width="13" Height="13" Stretch="Uniform"/>
                                </Border>
                                <TextBlock Text="{Binding [DashboardRam], Source={x:Static services:LocalizationService.Instance}}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextDim}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Grid.Column="2" Text="{Binding RamUsage, StringFormat={}{0:F0}%}" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="22" FontWeight="Bold" TextTrimming="CharacterEllipsis" Foreground="{StaticResource BrushAccent2}"/>
                        </Grid>
                        <ProgressBar Height="4" Value="{Binding RamUsage, Mode=OneWay}" Maximum="100" Foreground="{StaticResource BrushAccent2}" Background="#1AFFFFFF" BorderThickness="0"/>
                        <TextBlock Text="{Binding RamInfo}" FontSize="10" Foreground="{DynamicResource TextMuted}" Margin="0,6,0,0" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Border>

                <!-- GPU Metric (mesmo estilo do clássico) -->
                <Border Grid.Column="2" Style="{StaticResource GlassCard}" Padding="12,10" MinWidth="118" MinHeight="75" Margin="0,0,8,0">
                    <StackPanel VerticalAlignment="Center">
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Style="{StaticResource MetricIconFrame}" Background="#1A31A8FF">
                                    <Path Data="{StaticResource IconGpu}" Fill="{StaticResource BrushAccent3}" Width="13" Height="13" Stretch="Uniform"/>
                                </Border>
                                <TextBlock Text="{Binding [DashboardGpu], Source={x:Static services:LocalizationService.Instance}}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextDim}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                            <TextBlock Grid.Column="2" Text="{Binding GpuUsage, StringFormat={}{0:F0}%}" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="22" FontWeight="Bold" TextTrimming="CharacterEllipsis" Foreground="{StaticResource BrushAccent3}"/>
                        </Grid>
                        <ProgressBar Height="4" Value="{Binding GpuUsage, Mode=OneWay}" Maximum="100" Foreground="{StaticResource BrushAccent3}" Background="#1AFFFFFF" BorderThickness="0"/>
                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding [GamerDashGpuTemp], Source={x:Static services:LocalizationService.Instance}}" FontSize="10" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,6,0"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="M14,14.76 V5.5 A4.5,4.5 0 0,0 10,5.5 V14.76 A6.5,6.5 0 1,0 14,14.76 Z M12,2 A1.5,1.5 0 0,0 10.5,3.5 V15.32 A4.5,4.5 0 1,0 13.5,15.32 V3.5 A1.5,1.5 0 0,0 12,2 Z"
                                      Width="10" Height="10" Stretch="Uniform" VerticalAlignment="Center" Opacity="0.85">
                                    <Path.Fill>
                                        <MultiBinding Converter="{StaticResource ThermalIndicator}" ConverterParameter="Brush">
                                            <Binding Path="GpuTemperature"/>
                                            <Binding Path="GpuTemperature"/>
                                        </MultiBinding>
                                    </Path.Fill>
                                </Path>
                                <TextBlock Margin="4,0,0,0" FontSize="10" FontWeight="Bold" VerticalAlignment="Center">
                                    <TextBlock.Foreground>
                                        <MultiBinding Converter="{StaticResource ThermalIndicator}" ConverterParameter="Brush">
                                            <Binding Path="GpuTemperature"/>
                                            <Binding Path="GpuTemperature"/>
                                        </MultiBinding>
                                    </TextBlock.Foreground>
                                    <TextBlock.Text>
                                        <MultiBinding Converter="{StaticResource ThermalIndicator}">
                                            <Binding Path="GpuTemperature"/>
                                            <Binding Path="GpuTemperature"/>
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                                <TextBlock Text="~" FontSize="10" FontWeight="Bold" VerticalAlignment="Center"
                                           Visibility="{Binding IsTemperatureEstimated, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <TextBlock.Foreground>
                                        <MultiBinding Converter="{StaticResource ThermalIndicator}" ConverterParameter="Brush">
                                            <Binding Path="GpuTemperature"/>
                                            <Binding Path="GpuTemperature"/>
                                        </MultiBinding>
                                    </TextBlock.Foreground>
                                </TextBlock>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- DISCO Metric (mesmo estilo do clássico) -->
                <Border Grid.Column="3" Style="{StaticResource GlassCard}" Padding="12,10" MinWidth="118" MinHeight="75" Margin="0,0,8,0">
                    <StackPanel VerticalAlignment="Center">
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Style="{StaticResource MetricIconFrame}" Background="#1AFF4B6B">
                                    <Path Data="{StaticResource IconDisk}" Fill="{StaticResource BrushAccent1}" Width="13" Height="13" Stretch="Uniform"/>
                                </Border>
                                <TextBlock Text="{Binding [DashboardDisk], Source={x:Static services:LocalizationService.Instance}}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextDim}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                            <TextBlock Grid.Column="2" Text="{Binding DiskUsage, StringFormat={}{0:F0}%}" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="22" FontWeight="Bold" TextTrimming="CharacterEllipsis" Foreground="{StaticResource BrushAccent1}"/>
                        </Grid>
                        <ProgressBar Height="4" Value="{Binding DiskUsage, Mode=OneWay}" Maximum="100" Foreground="{StaticResource BrushAccent1}" Background="#1AFFFFFF" BorderThickness="0"/>
                        <TextBlock Text="{Binding DiskInfo}" FontSize="10" Foreground="{DynamicResource TextMuted}" Margin="0,6,0,0" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Border>

                <!-- REDE Metric (mesmo estilo do clássico, taxas reais em vez de %) -->
                <Border Grid.Column="4" Style="{StaticResource GlassCard}" Padding="12,10" MinWidth="142" MinHeight="75">
                    <StackPanel VerticalAlignment="Center">
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Style="{StaticResource MetricIconFrame}" Background="#1A10B981">
                                    <Path Data="{StaticResource IconNetwork}" Fill="{StaticResource BrushNetwork}" Width="13" Height="13" Stretch="Uniform"/>
                                </Border>
                                <TextBlock Text="{Binding [DashboardNetwork], Source={x:Static services:LocalizationService.Instance}}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextDim}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Grid.Column="2" Text="{Binding NetworkDownText}" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="18" FontWeight="Bold" TextTrimming="CharacterEllipsis" Foreground="{StaticResource BrushNetwork}"/>
                        </Grid>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                            <Path Data="{StaticResource IconNetwork}" Fill="{StaticResource BrushNetwork}" Width="8" Height="8" Stretch="Uniform" Margin="0,0,4,0" VerticalAlignment="Center" Opacity="0.6"/>
                            <TextBlock Text="{Binding NetworkUpText}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Ações rápidas -->
            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,16">
                <Button Command="{Binding OpenProfileCommand}"
                        Style="{StaticResource ProfileButton}"
                        Padding="16,8" MinHeight="34" Margin="20,0,0,0" VerticalAlignment="Center" Cursor="Hand"
                        ToolTip="{Binding [IntelligentProfileDesc], Source={x:Static services:LocalizationService.Instance}}">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="M12,2.5 L20,5.5 V11.5 C20,16.5 16.8,20.8 12,22 C7.2,20.8 4,16.5 4,11.5 V5.5 Z M8.5,11.8 L11,14.3 L15.5,9.4"
                              Fill="{StaticResource VoltrisGradientHorizontalBrush}" Width="13" Height="13" Stretch="Uniform" Margin="0,0,5,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding [IntelligentProfile], Source={x:Static services:LocalizationService.Instance}}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                        <Border Style="{StaticResource ProfileNamePill}">
                            <TextBlock Text="{Binding ActiveProfileName}" FontSize="10" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" MaxWidth="130"/>
                        </Border>
                        <!-- Badge PRO: MESMO binding do Smart Repair (logo abaixo).
                             Aparece SO sem licenca e some com ela, porque
                             IsProActive notifica. O botao fica clicavel nos
                             dois casos - quem bloqueia e o LicensedCommand,
                             nao um IsEnabled=false. -->
                        <controls:ProBadge Margin="7,0,0,0" Tip="{Binding [ProBadgeTip], Source={x:Static services:LocalizationService.Instance}}"
                                            Visibility="{Binding Source={x:Static license:LicenseTokenStore.IsProActive}, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>
                    </StackPanel>
                </Button>
                <Button Command="{Binding SmartRepairCommand}" Style="{StaticResource SmartRepairButton}"
                        Padding="16,8" MinHeight="34" Margin="8,0,0,0" VerticalAlignment="Center" Cursor="Hand">
                    <Button.Content>
                        <ContentControl>
                            <ContentControl.Style>
                                <Style TargetType="ContentControl">
                                    <Setter Property="Content">
                                        <Setter.Value>
                                            <StackPanel Orientation="Horizontal">
                                                <Path Data="M19.34,14.04C19.38,13.7 19.41,13.36 19.41,13C19.41,12.64 19.38,12.3 19.34,11.96L21.36,10.38C21.54,10.24 21.6,10 21.5,9.81L19.59,6.5C19.47,6.31 19.23,6.23 19.03,6.3L16.66,7.25C16.16,6.87 15.62,6.55 15.04,6.31L14.68,3.79C14.65,3.58 14.47,3.42 14.26,3.42H10.45C10.23,3.42 10.05,3.58 10.02,3.79L9.66,6.31C9.08,6.55 8.54,6.87 8.04,7.25L5.67,6.3C5.47,6.23 5.23,6.31 5.11,6.5L3.2,9.81C3.1,10 3.16,10.24 3.34,10.38L5.36,11.96C5.32,12.3 5.29,12.64 5.29,13C5.29,13.36 5.32,13.7 5.36,14.04L3.34,15.62C3.16,15.76 3.1,16 3.2,16.19L5.11,19.5C5.23,19.69 5.47,19.77 5.67,19.7L8.04,18.75C8.54,19.13 9.08,19.45 9.66,19.69L10.02,22.21C10.05,22.42 10.23,22.58 10.45,22.58H14.26C14.47,22.58 14.65,22.42 14.68,22.21L15.04,19.69C15.62,19.45 16.16,19.13 16.66,18.75L19.03,19.7C19.23,19.77 19.47,19.69 19.59,19.5L21.5,16.19C21.6,16 21.54,15.76 21.36,15.62L19.34,14.04M12.35,16.29C10.53,16.29 9.06,14.81 9.06,13C9.06,11.19 10.53,9.71 12.35,9.71C14.17,9.71 15.64,11.19 15.64,13C15.64,14.81 14.17,16.29 12.35,16.29M12.35,11A2,2 0 0,0 10.35,13A2,2 0 0,0 12.35,15A2,2 0 0,0 14.35,13A2,2 0 0,0 12.35,11Z" Fill="{DynamicResource TextPrimary}" Width="13" Height="13" Stretch="Uniform" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding [DashboardSmartRepair], Source={x:Static services:LocalizationService.Instance}}" FontSize="13" FontWeight="Bold" VerticalAlignment="Center"/>
                                                <controls:ProBadge Margin="7,0,0,0" Tip="{Binding [ProBadgeTip], Source={x:Static services:LocalizationService.Instance}}"
                                                                  Visibility="{Binding Source={x:Static license:LicenseTokenStore.IsProActive}, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>
                                            </StackPanel>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding DataContext.IsSmartRepairRunning, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                                            <Setter Property="Content">
                                                <Setter.Value>
                                                    <StackPanel Orientation="Horizontal">
                                                        <Path Data="M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2M16.2,16.2L11,13V7H12.5V12.2L17,14.9L16.2,16.2Z" Fill="{DynamicResource TextPrimary}" Width="13" Height="13" Stretch="Uniform" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                                        <TextBlock Text="{Binding [DashboardTrackRepair], Source={x:Static services:LocalizationService.Instance}}" FontSize="13" FontWeight="Bold" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Setter.Value>
                                            </Setter>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ContentControl.Style>
                        </ContentControl>
                    </Button.Content>
                </Button>
                <Button Command="{Binding QuickOptimizeCommand}"
                        Style="{StaticResource AccentButton}"
                        Padding="16,8"
                        MinHeight="34"
                        Margin="8,0,0,0"
                        VerticalAlignment="Center" Cursor="Hand">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="M11,15H6L13,1V9H18L11,23V15Z" Fill="#FFFFFF" Width="13" Height="13" Stretch="Uniform" Margin="0,0,5,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding [DashboardQuickOptimize], Source={x:Static services:LocalizationService.Instance}}" FontSize="13" FontWeight="Bold" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Command="{Binding QuickCleanupCommand}"
                        Style="{StaticResource ModernButton}"
                        Padding="16,8"
                        MinHeight="34"
                        Margin="8,0,0,0"
                        VerticalAlignment="Center" Cursor="Hand">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="M19.36,2.72L20.78,4.14L15.06,9.85C16.13,11.39 16.28,13.24 15.38,14.44L9.06,8.12C10.26,7.22 12.11,7.37 13.65,8.44L19.36,2.72M5.93,17.57C3.92,15.56 2.69,13.16 2.35,10.92L7.23,8.83L14.67,16.27L12.58,21.15C10.34,20.81 7.94,19.58 5.93,17.57Z" Fill="{DynamicResource TextPrimary}" Width="13" Height="13" Stretch="Uniform" Margin="0,0,5,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding [DashboardQuickCleanup], Source={x:Static services:LocalizationService.Instance}}" FontSize="13" FontWeight="Bold" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- ============================================ -->
        <!-- CHIP DE CONTA VOLTRIS CLOUD                     -->
        <!-- Canto superior direito do Dashboard.              -->
        <!-- É o ÚNICO login primário do app: o ícone de nuvem -->
        <!-- do title bar foi removido por ser redundante.     -->
        <!--                                                  -->
        <!--   DESLOGADO -> pill com gradiente da marca (CTA)  -->
        <!--   LOGADO    -> avatar + email + menu de conta     -->
        <!-- ============================================ -->
        <Grid x:Name="AccountChipHost"
              HorizontalAlignment="Right"
              VerticalAlignment="Top"
              Margin="0,20,28,0"
              UseLayoutRounding="True"
              SnapsToDevicePixels="True">

            <!-- ─────────── ESTADO 1: DESLOGADO (CTA) ───────────
                 Mesmo padrão EXATO do card SAÚDE: CornerRadius 12, BgCardGlass,
                 BorderLight, 48px de altura. A diferença é só o conteúdo — o
                 card de licença foi removido do Dashboard, e este é o único
                 elemento no topo direito. -->
            <Button x:Name="AccountSignInButton"
                    Height="48"
                    MinWidth="228"
                    Cursor="Hand"
                    Focusable="True"
                    Click="AccountSignIn_Click">
                <Button.ToolTip>
                    <TextBlock Text="{Binding [AccountChipSignInCloud], Source={x:Static services:LocalizationService.Instance}}"/>
                </Button.ToolTip>
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="SignInRoot" RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <ScaleTransform ScaleX="1" ScaleY="1"/>
                            </Grid.RenderTransform>
                            <Border x:Name="SignInSurface"
                                    CornerRadius="12"
                                    Padding="16,0"
                                    Background="{DynamicResource BgCardGlass}"
                                    BorderBrush="{DynamicResource BorderLight}"
                                    BorderThickness="1"
                                    SnapsToDevicePixels="True">
                                <Border.Effect>
                                    <!-- Halo roxo SÓ no hover.
                                         BUG CORRIGIDO: este efeito NÃO tinha x:Name, e a
                                         animação usava o caminho
                                         "Effect.(DropShadowEffect).Opacity".
                                         Essa sintaxe de type-cast só é válida para
                                         ATTACHED properties (ex.: "(Grid.Row)"); para um
                                         Effect o WPF não resolve e estourava
                                         InvalidOperationException dentro de um EventTrigger
                                         de hover — uma exceção NÃO TRATADA no Dispatcher
                                         (log: "DispatcherUnhandledException: Não é possível
                                         resolver todas as referências de propriedade no
                                         caminho da propriedade 'Effect.(DropShadowEffect).Opacity'").
                                         A forma correta é nomear o Freezable e animar a
                                         propriedade nele diretamente. -->
                                    <DropShadowEffect x:Name="SignInSurfaceShadow"
                                                     BlurRadius="18" ShadowDepth="0"
                                                     Color="#8B31FF" Opacity="0"/>
                                </Border.Effect>
                                <!-- Centralizado: num CTA, conteudo a esquerda com
                                     folga a direita parece desalinhado. -->
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Path x:Name="SignInCloudIcon"
                                          Data="M19.35 10.04C18.67 6.59 15.64 4 12 4 9.11 4 6.6 5.64 5.35 8.04 2.34 8.36 0 10.91 0 14c0 3.31 2.69 6 6 6h13c2.76 0 5-2.24 5-5 0-2.64-2.05-4.78-4.65-4.96z"
                                          Fill="{StaticResource VoltrisGradientHorizontalBrush}"
                                          Width="18" Height="18"
                                          Stretch="Uniform"
                                          RenderTransformOrigin="0.5,0.5"
                                          VerticalAlignment="Center" Margin="0,0,11,0">
                                        <Path.RenderTransform>
                                            <ScaleTransform ScaleX="1" ScaleY="1"/>
                                        </Path.RenderTransform>
                                    </Path>
                                    <TextBlock x:Name="SignInLabel"
                                               Text="{Binding [AccountChipSignInCloud], Source={x:Static services:LocalizationService.Instance}}"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               FontFamily="Segoe UI Variable Display, Segoe UI"
                                               FontSize="13.5"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center"
                                               TextOptions.TextFormattingMode="Display"
                                               TextOptions.TextRenderingMode="ClearType"/>
                            </StackPanel>
                            </Border>
                        </Grid>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="SignInSurface" Property="BorderBrush" Value="#4DFFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="SignInSurface" Property="BorderBrush" Value="#66FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="SignInSurface" Property="Opacity" Value="0.45"/>
                            </Trigger>
                            <EventTrigger RoutedEvent="MouseEnter">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="SignInRoot"
                                                         Storyboard.TargetProperty="RenderTransform.ScaleX"
                                                         To="1.025" Duration="0:0:0.16"/>
                                        <DoubleAnimation Storyboard.TargetName="SignInRoot"
                                                         Storyboard.TargetProperty="RenderTransform.ScaleY"
                                                         To="1.025" Duration="0:0:0.16"/>
                                        <DoubleAnimation Storyboard.TargetName="SignInCloudIcon"
                                                         Storyboard.TargetProperty="RenderTransform.ScaleX"
                                                         To="1.12" Duration="0:0:0.18"/>
                                        <DoubleAnimation Storyboard.TargetName="SignInCloudIcon"
                                                         Storyboard.TargetProperty="RenderTransform.ScaleY"
                                                         To="1.12" Duration="0:0:0.18"/>
                                        <DoubleAnimation Storyboard.TargetName="SignInSurfaceShadow"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0.55" Duration="0:0:0.18"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <EventTrigger RoutedEvent="MouseLeave">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="SignInRoot"
                                                         Storyboard.TargetProperty="RenderTransform.ScaleX"
                                                         To="1.0" Duration="0:0:0.16"/>
                                        <DoubleAnimation Storyboard.TargetName="SignInRoot"
                                                         Storyboard.TargetProperty="RenderTransform.ScaleY"
                                                         To="1.0" Duration="0:0:0.16"/>
                                        <DoubleAnimation Storyboard.TargetName="SignInCloudIcon"
                                                         Storyboard.TargetProperty="RenderTransform.ScaleX"
                                                         To="1.0" Duration="0:0:0.18"/>
                                        <DoubleAnimation Storyboard.TargetName="SignInCloudIcon"
                                                         Storyboard.TargetProperty="RenderTransform.ScaleY"
                                                         To="1.0" Duration="0:0:0.18"/>
                                        <DoubleAnimation Storyboard.TargetName="SignInSurfaceShadow"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="0:0:0.18"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <!-- ─────────── ESTADO 2: LOGADO ───────────
                 Mesmo padrão do card SAÚDE e do estado deslogado.
                 O chip identifica o USUÁRIO (nome amigável do Windows). A CONTA
                 (email) fica no cabeçalho do dropdown — cada informação no
                 lugar onde o usuário procura por ela. -->
            <Button x:Name="AccountLinkedButton"
                    Height="48"
                    MinWidth="206"
                    Cursor="Hand"
                    Focusable="True"
                    Click="AccountMenu_Click"
                    Visibility="Collapsed">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="LinkedRoot" RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <ScaleTransform ScaleX="1" ScaleY="1"/>
                            </Grid.RenderTransform>
                            <Border x:Name="LinkedSurface"
                                    CornerRadius="12"
                                    Padding="10,0,14,0"
                                    Background="{DynamicResource BgCardGlass}"
                                    BorderBrush="{DynamicResource BorderLight}"
                                    BorderThickness="1"
                                    SnapsToDevicePixels="True">
                                <Border.Effect>
                                    <!-- Mesmo bug corrigido em SignInSurface: o efeito
                                         precisa de x:Name para ser alvo de Storyboard. -->
                                    <DropShadowEffect x:Name="LinkedSurfaceShadow"
                                                     BlurRadius="16" ShadowDepth="0"
                                                     Color="#000000" Opacity="0"/>
                                </Border.Effect>
                                <!-- Grid, e não StackPanel horizontal: o painel
                     empilhava o conteúdo à esquerda e o chevron ficava
                     grudado no nome, com espaço vazio sobrando à direita.
                     A coluna "*" absorve a folga e empurra o chevron
                     para a borda direita do card. -->
                                <Grid VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Avatar: ícone real de CONTA LOGADA (pessoa + check).
                                         Antes eram iniciais; o ícone comunica o estado
                                         sem depender de texto. -->
                                    <Grid Grid.Column="0" Width="32" Height="32" HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <Ellipse Width="32" Height="32" Fill="{StaticResource VoltrisGradientHorizontalBrush}"/>
                                        <!-- Canvas 24x24 DENTRO do Viewbox: fixa a
                                             coordenada do glifo. Sem ele, o Viewbox
                                             mede o Path pelo bbox da geometria e o
                                             centramento fica implícito. -->
                                        <Viewbox Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Canvas Width="24" Height="24">
                                                <Path Data="M12,12C14.21,12 16,10.21 16,8C16,5.79 14.21,4 12,4C9.79,4 8,5.79 8,8C8,10.21 9.79,12 12,12M12,14C9.33,14 4,15.34 4,18V20H20V18C20,15.33 14.67,14 12,14Z"
                                                      Fill="#FFFFFFFF"/>
                                            </Canvas>
                                        </Viewbox>
                                        <!-- Selo de "logado": check verde com contorno
                                             na cor do card, que faz o recorte. -->
                                        <Grid x:Name="AccountVerifiedBadge"
                                              Width="13" Height="13"
                                              HorizontalAlignment="Right"
                                              VerticalAlignment="Bottom"
                                              Margin="0,0,-1,-1">
                                            <Ellipse Fill="#FF10B981"
                                                     Stroke="{DynamicResource BgCardGlass}"
                                                     StrokeThickness="2"/>
                                            <Viewbox Width="8" Height="8" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Canvas Width="24" Height="24">
                                                    <Path Data="M9,16.17L4.83,12L3.41,13.41L9,19L21,7L19.59,5.59L9,16.17Z"
                                                          Fill="#FFFFFFFF"/>
                                                </Canvas>
                                            </Viewbox>
                                        </Grid>
                                    </Grid>
                                    <!-- Nome do usuário + status -->
                                    <StackPanel Grid.Column="1" Margin="11,0,10,0" VerticalAlignment="Center">
                                        <TextBlock x:Name="AccountMachineText"
                                                   Text=""
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   FontFamily="Segoe UI Variable Display, Segoe UI"
                                                   FontSize="12.5"
                                                   FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis"
                                                   TextOptions.TextFormattingMode="Display"
                                                   TextOptions.TextRenderingMode="ClearType"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,1,0,0">
                                            <Ellipse x:Name="AccountStatusDot"
                                                     Width="5.5" Height="5.5"
                                                     Fill="#FF10B981"
                                                     VerticalAlignment="Center"
                                                     Margin="0,0,5,0">
                                                <Ellipse.Effect>
                                                    <DropShadowEffect BlurRadius="6" ShadowDepth="0" Color="#10B981" Opacity="0.9"/>
                                                </Ellipse.Effect>
                                            </Ellipse>
                                            <TextBlock x:Name="AccountStatusText"
                                                       Text="{Binding [AccountChipSynced], Source={x:Static services:LocalizationService.Instance}}"
                                                       Foreground="{DynamicResource TextMutedBrush}"
                                                       FontFamily="Segoe UI Variable Text, Segoe UI"
                                                       FontSize="10.5"
                                                       FontWeight="Medium"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </StackPanel>
                                    <Path x:Name="AccountChevron"
                                          Grid.Column="2"
                                          Data="M7 10L12 15L17 10"
                                          Stroke="{DynamicResource TextMutedBrush}"
                                          StrokeThickness="1.8"
                                          StrokeEndLineCap="Round"
                                          StrokeStartLineCap="Round"
                                          StrokeLineJoin="Round"
                                          Width="15" Height="15"
                                          Stretch="Uniform"
                                          VerticalAlignment="Center"
                                          Margin="0"
                                          Opacity="0.7"/>
                                </Grid>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="LinkedSurface" Property="BorderBrush" Value="#4DFFFFFF"/>
                                <Setter TargetName="AccountChevron" Property="Opacity" Value="1"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="LinkedSurface" Property="BorderBrush" Value="#66FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="LinkedSurface" Property="Opacity" Value="0.45"/>
                            </Trigger>
                            <EventTrigger RoutedEvent="MouseEnter">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="LinkedRoot"
                                                         Storyboard.TargetProperty="RenderTransform.ScaleX"
                                                         To="1.02" Duration="0:0:0.16"/>
                                        <DoubleAnimation Storyboard.TargetName="LinkedRoot"
                                                         Storyboard.TargetProperty="RenderTransform.ScaleY"
                                                         To="1.02" Duration="0:0:0.16"/>
                                        <DoubleAnimation Storyboard.TargetName="LinkedSurfaceShadow"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0.3" Duration="0:0:0.18"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <EventTrigger RoutedEvent="MouseLeave">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="LinkedRoot"
                                                         Storyboard.TargetProperty="RenderTransform.ScaleX"
                                                         To="1.0" Duration="0:0:0.16"/>
                                        <DoubleAnimation Storyboard.TargetName="LinkedRoot"
                                                         Storyboard.TargetProperty="RenderTransform.ScaleY"
                                                         To="1.0" Duration="0:0:0.16"/>
                                        <DoubleAnimation Storyboard.TargetName="LinkedSurfaceShadow"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="0:0:0.18"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>

                <!-- Menu de conta: cabeçalho com a CONTA, itens à esquerda com tile, título + subtítulo -->
                <Button.ContextMenu>
                    <ContextMenu x:Name="AccountContextMenu" Style="{StaticResource ModernContextMenuStyle}">
                        <!-- ══ CABEÇALHO: conta (email vive aqui, não no chip) ══
                             O conteúdo vai em <MenuItem.Header>, e não direto
                             dentro do MenuItem: direto vira Content, e o
                             template renderiza Header — o item saía vazio. -->
                        <MenuItem x:Name="MenuAccountHeader" Style="{StaticResource AccountMenuHeaderStyle}" IsEnabled="False" Focusable="False">
                            <MenuItem.Header>
                            <StackPanel Orientation="Horizontal">
                                <!-- Tile de conta: mesmo glifo, forma quadrada —
                                     distinto do círculo do chip, para o menu ter
                                     identidade própria sem repetir o avatar. -->
                                <Border Width="34" Height="34" CornerRadius="10"
                                        HorizontalAlignment="Left" VerticalAlignment="Center">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="12" ShadowDepth="0" Opacity="0.32" Color="#8B31FF"/>
                                    </Border.Effect>
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#FF4B6B" Offset="0"/>
                                            <GradientStop Color="#8B31FF" Offset="0.5"/>
                                            <GradientStop Color="#31A8FF" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <Viewbox Width="19" Height="19" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Canvas Width="24" Height="24">
                                            <Path Data="M12,12C14.21,12 16,10.21 16,8C16,5.79 14.21,4 12,4C9.79,4 8,5.79 8,8C8,10.21 9.79,12 12,12M12,14C9.33,14 4,15.34 4,18V20H20V18C20,15.33 14.67,14 12,14Z"
                                                  Fill="#FFFFFFFF"/>
                                        </Canvas>
                                    </Viewbox>
                                </Border>
                                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding [AccountChipMyAccount], Source={x:Static services:LocalizationService.Instance}}"
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               FontSize="9.5" FontWeight="Bold" FontFamily="Segoe UI Variable, Segoe UI"
