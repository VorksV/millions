                                        <DoubleAnimation Storyboard.TargetName="pw1" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" From="0.12" To="1" Duration="0:0:2.2" RepeatBehavior="Forever"/>
                                        <DoubleAnimation Storyboard.TargetName="pw1" Storyboard.TargetProperty="Opacity" From="0.7" To="0" Duration="0:0:2.2" RepeatBehavior="Forever"/>
                                        <DoubleAnimation Storyboard.TargetName="pw2" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" From="0.12" To="1" Duration="0:0:2.2" RepeatBehavior="Forever" BeginTime="-0:0:0.73"/>
                                        <DoubleAnimation Storyboard.TargetName="pw2" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" From="0.12" To="1" Duration="0:0:2.2" RepeatBehavior="Forever" BeginTime="-0:0:0.73"/>
                                        <DoubleAnimation Storyboard.TargetName="pw2" Storyboard.TargetProperty="Opacity" From="0.7" To="0" Duration="0:0:2.2" RepeatBehavior="Forever" BeginTime="-0:0:0.73"/>
                                        <DoubleAnimation Storyboard.TargetName="pw3" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" From="0.12" To="1" Duration="0:0:2.2" RepeatBehavior="Forever" BeginTime="-0:0:1.46"/>
                                        <DoubleAnimation Storyboard.TargetName="pw3" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" From="0.12" To="1" Duration="0:0:2.2" RepeatBehavior="Forever" BeginTime="-0:0:1.46"/>
                                        <DoubleAnimation Storyboard.TargetName="pw3" Storyboard.TargetProperty="Opacity" From="0.7" To="0" Duration="0:0:2.2" RepeatBehavior="Forever" BeginTime="-0:0:1.46"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Canvas.Triggers>
                        <Canvas.Style>
