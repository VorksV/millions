<UserControl xmlns:services="clr-namespace:VoltrisOptimizer.Services" xmlns:license="clr-namespace:VoltrisOptimizer.Services.License" x:Class="VoltrisOptimizer.UI.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:VoltrisOptimizer.UI.ViewModels"
             xmlns:controls="clr-namespace:VoltrisOptimizer.UI.Controls"
             xmlns:local="clr-namespace:VoltrisOptimizer.UI.Views"
             Background="Transparent"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType"
             TextOptions.TextHintingMode="Fixed"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
    
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        
        <!-- Cores do Branding -->
        <Color x:Key="ColorPrimary">#3b82f6</Color>
        <Color x:Key="ColorAccent1">#FF4B6B</Color>
        <Color x:Key="ColorAccent2">#8B31FF</Color>
        <Color x:Key="ColorAccent3">#31A8FF</Color>
        
        <SolidColorBrush x:Key="BrushPrimary" Color="{StaticResource ColorPrimary}"/>
        <SolidColorBrush x:Key="BrushAccent1" Color="{StaticResource ColorAccent1}"/>
        <SolidColorBrush x:Key="BrushAccent2" Color="{StaticResource ColorAccent2}"/>
        <SolidColorBrush x:Key="BrushAccent3" Color="{StaticResource ColorAccent3}"/>
        <SolidColorBrush x:Key="BrushNetwork" Color="#10B981"/>
        
        <!-- Gradientes de Marca -->
        <LinearGradientBrush x:Key="MainGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FF4B6B" Offset="0"/>
            <GradientStop Color="#8B31FF" Offset="0.5"/>
            <GradientStop Color="#31A8FF" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="BlueGradient" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#4facfe" Offset="0"/>
            <GradientStop Color="#00f2fe" Offset="1"/>
        </LinearGradientBrush>

        <!-- ============================================ -->
        <!-- MENU DE CONTA — ESTILO PRÓPRIO                -->
        <!--                                              -->
        <!-- O ModernMenuItemStyle global centraliza o     -->
        <!-- conteúdo (HorizontalContentAlignment=Center).  -->
        <!-- Aqui o item é à ESQUERDA, com ícone em tile   -->
        <!-- 30x30, título + subtítulo e hover arredondado. -->
        <!--                                              -->
        <!-- Vive aqui, e não em Styles.xaml, de propósito: -->
        <!-- o estilo global é usado por outros menus do   -->
        <!-- app e mudar a centralização quebraria todos.   -->
        <!-- ============================================ -->
        <Style x:Key="AccountMenuItemStyle" TargetType="MenuItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="MinWidth" Value="252"/>
            <Setter Property="Cursor" Value="Hand"/>
            <!-- A correção do "centralizado": tudo à esquerda. -->
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontFamily" Value="Segoe UI Variable, Segoe UI"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="ItemBorder"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}"
                                CornerRadius="10"
                                SnapsToDevicePixels="True">
                            <ContentPresenter x:Name="HeaderPresenter"
                                              ContentSource="Header"
                                              HorizontalAlignment="Left"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#14FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#14FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Separador do menu de conta: linha fina e discreta -->
        <Style x:Key="AccountMenuSeparatorStyle" TargetType="Separator">
            <Setter Property="Height" Value="1"/>
            <Setter Property="Margin" Value="10,5"/>
            <Setter Property="Background" Value="{DynamicResource DarkBorderBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Separator">
                        <Border Height="1"
                                Background="{TemplateBinding Background}"
                                SnapsToDevicePixels="True"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Cabeçalho do menu: identifica a CONTA (o chip identifica a MÁQUINA).
             Desabilitado e sem hover: é apresentação, não comando. -->
        <Style x:Key="AccountMenuHeaderStyle" TargetType="MenuItem">
            <Setter Property="IsEnabled" Value="False"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border Background="Transparent" Padding="13,11,13,12" CornerRadius="10">
                            <ContentPresenter ContentSource="Header"
                                              HorizontalAlignment="Left"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Faixa de LICENÇA: mostra o plano exato (Standard / Pro / Enterprise).
             Sem hover e sem comando — só leitura. A cor vem do plano e segue a
             identidade que o LicenseShieldIcon já define: Standard ciano,
             Pro magenta, Enterprise dourado. -->
        <Style x:Key="AccountLicenseStripStyle" TargetType="MenuItem">
            <Setter Property="IsEnabled" Value="False"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="StripBorder"
                                Background="#0FFFFFFF"
                                CornerRadius="10"
                                Padding="9,8"
                                Margin="3,2"
                                SnapsToDevicePixels="True">
                            <Border.Effect>
                                <DropShadowEffect x:Name="StripGlow"
                                                  BlurRadius="14" ShadowDepth="0"
                                                  Opacity="0.45" Color="#8B31FF"/>
                            </Border.Effect>
                            <ContentPresenter ContentSource="Header"
                                              HorizontalAlignment="Left"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <!-- Glass Card Style -->
        <Style x:Key="GlassCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource BgCardGlass}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderLight}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="24"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource BorderAccent}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        
        <!-- Modern Action Button -->
        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource DarkPanelBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource DefaultTextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderLight}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="10" 
                                SnapsToDevicePixels="true">
                            <ContentPresenter x:Name="contentPresenter" Focusable="False" 
                                              HorizontalAlignment="Center" 
                                              Margin="{TemplateBinding Padding}" 
                                              RecognizesAccessKey="True" 
                                              SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" 
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="true">
                                <Setter Property="Background" TargetName="border" Value="{DynamicResource BgHover}"/>
                                <Setter Property="BorderBrush" TargetName="border" Value="{StaticResource BrushPrimary}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="true">
                                <Setter Property="Background" TargetName="border" Value="#2AFFFFFF"/>
                                <Setter Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.98" ScaleY="0.98"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Accent Button -->
        <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Background" Value="{StaticResource MainGradient}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <!-- Smart Repair Button -->
        <LinearGradientBrush x:Key="SmartRepairGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#3B82F6" Offset="0"/>
            <GradientStop Color="#8B5CF6" Offset="1"/>
        </LinearGradientBrush>

        <Style x:Key="SmartRepairButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Background" Value="{StaticResource SmartRepairGradient}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <!-- BORDA do botão de Perfil no hover. Antes era um gradiente
             DIAGONAL roxo->rosa (#8B31FF -> #FF4B6B), que e a paleta "rosa"
             que o usuario pediu para tirar. Agora usa as MESMAS cores do
             titulo "Voltris Optimizer", em diagonal. Os valores sao
             litterais (nao via StaticResource) porque a diagonal exige
             StartPoint/EndPoint proprios - um recurso compartilhado
             apontaria para o eixo do titulo. -->
        <LinearGradientBrush x:Key="ProfileGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="{StaticResource AccentColor}" Offset="0"/>
            <GradientStop Color="{StaticResource SecondaryColor}" Offset="0.5"/>
            <GradientStop Color="{StaticResource PrimaryColor}" Offset="1"/>
        </LinearGradientBrush>

        <!-- Preenchimento do hover: mesmas cores, so que translucidas, para o
             botao ganhar cor sem virar um bloco solido. -->
        <LinearGradientBrush x:Key="ProfileGradientHover" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#26FF4B6B" Offset="0"/>
            <GradientStop Color="#268B31FF" Offset="0.5"/>
            <GradientStop Color="#2631A8FF" Offset="1"/>
        </LinearGradientBrush>

        <Style x:Key="ProfileButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="#408B31FF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="hoverFill" CornerRadius="11" Background="{StaticResource ProfileGradientHover}" Opacity="0"/>
                            <Border x:Name="border" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="11"
                                    SnapsToDevicePixels="true">
                                <ContentPresenter x:Name="contentPresenter" Focusable="False"
                                                  HorizontalAlignment="Center"
                                                  Margin="{TemplateBinding Padding}"
                                                  RecognizesAccessKey="True"
                                                  SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"
                                                  VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="true">
                                <Setter Property="Opacity" TargetName="hoverFill" Value="1"/>
                                <Setter Property="BorderBrush" TargetName="border" Value="{StaticResource ProfileGradient}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="true">
                                <Setter Property="RenderTransform" TargetName="border">
                                    <Setter.Value><ScaleTransform ScaleX="0.98" ScaleY="0.98"/></Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Pílula do nome do perfil: a "brush do titulo", LITERAL.
             Este e o fundo que o usuario apontou como rosa. Apontar para
             VoltrisGradientHorizontalBrush (e nao para uma copia) garante que
             a pilha nunca dessincronize do titulo do header: se o tema
             trocar a assinatura, as duas trocam juntas. E o mesmo
             mecanismo ja usado no raio do AiFaceView. -->
        <Style x:Key="ProfileNamePill" TargetType="Border">
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Background" Value="{StaticResource VoltrisGradientHorizontalBrush}"/>
            <Setter Property="Padding" Value="10,3"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="10,0,0,0"/>
        </Style>
        
        <!-- Status Badge -->
        <Style x:Key="StatusBadge" TargetType="Border">
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Metric Icon Frame (estilo Gamer: caixa translúcida arredondada + ícone vívido) -->
        <Style x:Key="MetricIconFrame" TargetType="Border">
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="CornerRadius" Value="7"/>
            <Setter Property="Margin" Value="0,0,7,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Ícones (SVG Path Data) -->
        <Geometry x:Key="IconCpu">M17,6H7A2,2 0 0,0 5,8V16A2,2 0 0,0 7,18H17A2,2 0 0,0 19,16V8A2,2 0 0,0 17,6M11,2V4H13V2H11M7,2V4H9V2H7M15,2V4H17V2H15M2,7V9H4V7H2M2,11V13H4V11H2M2,15V17H4V15H2M20,7V9H22V7H20M20,11V13H22V11H20M20,15V17H22V15H20M11,20V22H13V20H11M7,20V22H9V20H7M15,20V22H17V20H15Z</Geometry>
        <Geometry x:Key="IconRam">M2,6H22V18H2M5,8V16H7V8H5M9,8V16H11V8H9M13,8V16H15V8H13M17,8V16H19V8H17Z</Geometry>
        <Geometry x:Key="IconDisk">M4,3H20A2,2 0 0,1 22,5V9A2,2 0 0,1 20,11H4A2,2 0 0,1 2,9V5A2,2 0 0,1 4,3M4,7H20V5H4V7M4,13H20A2,2 0 0,1 22,15V19A2,2 0 0,1 20,21H4A2,2 0 0,1 2,19V15A2,2 0 0,1 4,13M4,17H20V15H4V17M6,6H8V6H6M6,16H8V16H6Z</Geometry>
        <Geometry x:Key="IconShield">M12,1L3,5V11C3,16.55 6.84,21.74 12,23C17.16,21.74 21,16.55 21,11V5L12,1M12,7C13.4,7 14.8,8.6 14.8,11V11.5H16V17H8V11.5H9.2V11C9.2,8.6 10.6,7 12,7</Geometry>
        <Geometry x:Key="IconTemperature">M15,13V5A3,3 0 0,0 9,5V13A5,5 0 1,0 15,13M12,4A1,1 0 0,1 13,5V8H11V5A1,1 0 0,1 12,4Z</Geometry>
        <Geometry x:Key="IconGpu">M4,2A2,2 0 0,0 2,4V14A2,2 0 0,0 4,16H20A2,2 0 0,0 22,14V4A2,2 0 0,0 20,2H4M4,4H20V14H4V4M5,6V8H7V6H5M8,6V8H10V6H8M11,6V8H13V6H11M14,6V8H16V6H14M4,18H20V20H4V18Z</Geometry>
        <Geometry x:Key="IconNetwork">M12,21L15.6,16.2C14.6,15.45 13.35,15 12,15C10.65,15 9.4,15.45 8.4,16.2L12,21M12,3C7.95,3 4.21,4.34 1.2,6.6L3,9C5.5,7.12 8.62,6 12,6C15.38,6 18.5,7.12 21,9L22.8,6.6C19.79,4.34 16.05,3 12,3M12,7C9.07,7 6.45,7.94 4.35,9.6L6.15,12C7.75,10.74 9.71,10 12,10C14.29,10 16.25,10.74 17.85,12L19.65,9.6C17.55,7.94 14.93,7 12,7M12,11C10.03,11 8.3,11.85 7.05,13.2L8.85,15.6C9.65,14.75 10.75,14.25 12,14.25C13.25,14.25 14.35,14.75 15.15,15.6L16.95,13.2C15.7,11.85 13.97,11 12,11Z</Geometry>

        <!-- ⚠️ ANIMAÇÃO DE ENTRADA REMOVIDA: Causava flash visual durante o fade-in
             A animação de opacity 0→1 em 800ms fazia elementos renderizarem em ordem diferente,
             criando a impressão de "interface antiga" aparecendo antes da moderna.
             Dashboard agora aparece instantaneamente sem transição. -->
        <!-- Animations 
        <Storyboard x:Key="EntryAnimation">
            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.8">
                <DoubleAnimation.EasingFunction>
                    <ExponentialEase EasingMode="EaseOut" Exponent="5"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" From="30" To="0" Duration="0:0:0.8">
                <DoubleAnimation.EasingFunction>
                    <ExponentialEase EasingMode="EaseOut" Exponent="5"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
        -->
    </UserControl.Resources>

    <!-- ⚠️ TRIGGER DE ANIMAÇÃO REMOVIDO: Causava flash visual
    <UserControl.Triggers>
        <EventTrigger RoutedEvent="UserControl.Loaded">
            <BeginStoryboard Storyboard="{StaticResource EntryAnimation}"/>
        </EventTrigger>
    </UserControl.Triggers>
    -->

    <Grid>
        <!-- Background decorativo (fora do ScrollViewer, não rola) -->
        <Grid IsHitTestVisible="False" ClipToBounds="True">
            <Ellipse Width="600" Height="600" 
                     HorizontalAlignment="Left" VerticalAlignment="Top"
                     Margin="-200,-200,0,0"
                     Opacity="0.08">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#3b82f6" Offset="0"/>
                        <GradientStop Color="Transparent" Offset="1"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
            <Ellipse Width="500" Height="500" 
                     HorizontalAlignment="Right" VerticalAlignment="Bottom"
                     Margin="0,0,-150,-150"
                     Opacity="0.06">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#8B31FF" Offset="0"/>
                        <GradientStop Color="Transparent" Offset="1"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
        </Grid>
        
        <!-- OVERLAY TELA CHEIA — NÚCLEO DE OTIMIZAÇÃO PREMIUM (item 1-16):
             anel de progresso REAL + núcleo com estados + indicadores reais + microinterações.
             Responsivo via Viewbox (item 15): o círculo adapta ao tamanho da janela sem cortar/desalinhar. -->
        <Grid x:Name="CircularLayoutGrid" 
              Visibility="Visible"
              UseLayoutRounding="True"
              SnapsToDevicePixels="True">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Background premium: iluminação radial suave e partículas discretas atrás do núcleo (item 11) -->
            <Grid Grid.RowSpan="4" IsHitTestVisible="False">
                <!-- PERFORMANCE: Colapsado quando app está em background/minimizado/tray -->
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ShouldAnimationsRun}" Value="False">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <!-- Partículas discretas (soft glow dots) -->
                <Ellipse Width="10" Height="10" Fill="#66FFFFFF" Opacity="0.35" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="130,190,0,0"/>
                <Ellipse Width="7" Height="7" Fill="#6699FF" Opacity="0.3" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,150"/>
                <Ellipse Width="12" Height="12" Fill="#FF77FF" Opacity="0.18" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,150,120,0"/>
                <Ellipse Width="6" Height="6" Fill="#66FFFFFF" Opacity="0.3" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="90,0,0,120"/>
            </Grid>

            <!-- PARTÍCULAS DE FUNDO DO DASHBOARD (estilo NÉVOA): orbes nebulosos borrados derivando devagar
                 + poeira em deriva diagonal. Estilo DIFERENTE dos motes de luz do botão circular (item 23). -->
            <Grid Grid.RowSpan="4" IsHitTestVisible="False">
                <!-- PERFORMANCE: Colapsado quando app está em background/minimizado/tray -->
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ShouldAnimationsRun}" Value="False">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Grid.Triggers>
                    <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                        <BeginStoryboard>
                            <Storyboard>
                                <!-- Orbes nebulosos (deriva lenta, autonreverse) -->
                                <DoubleAnimation Storyboard.TargetName="ifOrb1" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" From="-34" To="34" Duration="0:0:16" AutoReverse="True" RepeatBehavior="Forever" BeginTime="-0:0:3"/>
                                <DoubleAnimation Storyboard.TargetName="ifOrb1" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" From="-18" To="18" Duration="0:0:21" AutoReverse="True" RepeatBehavior="Forever" BeginTime="-0:0:7"/>
                                <DoubleAnimation Storyboard.TargetName="ifOrb2" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" From="28" To="-28" Duration="0:0:19" AutoReverse="True" RepeatBehavior="Forever" BeginTime="-0:0:5"/>
                                <DoubleAnimation Storyboard.TargetName="ifOrb2" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" From="-12" To="12" Duration="0:0:24" AutoReverse="True" RepeatBehavior="Forever" BeginTime="-0:0:11"/>
                                <DoubleAnimation Storyboard.TargetName="ifOrb3" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" From="-22" To="22" Duration="0:0:18" AutoReverse="True" RepeatBehavior="Forever" BeginTime="-0:0:8"/>
                                <DoubleAnimation Storyboard.TargetName="ifOrb3" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" From="16" To="-16" Duration="0:0:25" AutoReverse="True" RepeatBehavior="Forever" BeginTime="-0:0:2"/>
                                <DoubleAnimation Storyboard.TargetName="ifOrb4" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" From="18" To="-18" Duration="0:0:14" AutoReverse="True" RepeatBehavior="Forever" BeginTime="-0:0:1"/>
                                <DoubleAnimation Storyboard.TargetName="ifOrb4" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" From="12" To="-12" Duration="0:0:20" AutoReverse="True" RepeatBehavior="Forever" BeginTime="-0:0:6"/>
                                <!-- Poeira em deriva diagonal -->
                                <DoubleAnimation Storyboard.TargetName="ifSp1" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" From="-26" To="30" Duration="0:0:13" AutoReverse="True" RepeatBehavior="Forever" BeginTime="-0:0:2"/>
                                <DoubleAnimation Storyboard.TargetName="ifSp1" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" From="-12" To="14" Duration="0:0:15" AutoReverse="True" RepeatBehavior="Forever" BeginTime="-0:0:9"/>
                                <DoubleAnimation Storyboard.TargetName="ifSp2" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" From="22" To="-26" Duration="0:0:11" AutoReverse="True" RepeatBehavior="Forever" BeginTime="-0:0:4"/>
                                <DoubleAnimation Storyboard.TargetName="ifSp2" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" From="10" To="-16" Duration="0:0:17" AutoReverse="True" RepeatBehavior="Forever" BeginTime="-0:0:12"/>
                                <DoubleAnimation Storyboard.TargetName="ifSp3" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" From="-18" To="24" Duration="0:0:14" AutoReverse="True" RepeatBehavior="Forever" BeginTime="-0:0:6"/>
                                <DoubleAnimation Storyboard.TargetName="ifSp3" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" From="8" To="-12" Duration="0:0:19" AutoReverse="True" RepeatBehavior="Forever" BeginTime="-0:0:3"/>
                                <DoubleAnimation Storyboard.TargetName="ifSp4" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" From="20" To="-22" Duration="0:0:12" AutoReverse="True" RepeatBehavior="Forever" BeginTime="-0:0:7"/>
                                <DoubleAnimation Storyboard.TargetName="ifSp4" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" From="-10" To="14" Duration="0:0:18" AutoReverse="True" RepeatBehavior="Forever" BeginTime="-0:0:1"/>
                                <DoubleAnimation Storyboard.TargetName="ifSp5" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" From="-24" To="28" Duration="0:0:16" AutoReverse="True" RepeatBehavior="Forever" BeginTime="-0:0:5"/>
                                <DoubleAnimation Storyboard.TargetName="ifSp5" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" From="-14" To="10" Duration="0:0:22" AutoReverse="True" RepeatBehavior="Forever" BeginTime="-0:0:14"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </Grid.Triggers>
                <Ellipse x:Name="ifOrb1" CacheMode="BitmapCache" Width="96" Height="88" Opacity="0.16"
                         HorizontalAlignment="Left" VerticalAlignment="Top" Margin="28,96,0,0">
                    <Ellipse.Effect>
                        <BlurEffect Radius="30"/>
                    </Ellipse.Effect>
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="#FF22D3EE" Offset="0"/>
                            <GradientStop Color="#5522D3EE" Offset="0.5"/>
                            <GradientStop Color="#0022D3EE" Offset="1"/>
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                    <Ellipse.RenderTransform>
                        <TranslateTransform/>
                    </Ellipse.RenderTransform>
                    <!-- CacheMode="BitmapCache": o BlurEffect NUNCA é acelerado
                         por GPU no WPF (é rasterizado em software). Sem cache,
                         este orbe — que se move a cada quadro — refazia o blur
                         60x por segundo. O cache calcula o blur UMA vez; o
                         RenderTransform continua aplicado DEPOIS dele, então o
                         orbe se move igual. Visual idêntico. -->
                </Ellipse>
                <Ellipse x:Name="ifOrb2" CacheMode="BitmapCache" Width="84" Height="80" Opacity="0.14"
                         HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,70,52,0">
                    <Ellipse.Effect>
                        <BlurEffect Radius="26"/>
