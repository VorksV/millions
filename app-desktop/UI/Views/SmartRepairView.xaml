<UserControl xmlns:services="clr-namespace:VoltrisOptimizer.Services"
             x:Class="VoltrisOptimizer.UI.Views.SmartRepairView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:sr="clr-namespace:VoltrisOptimizer.Services.SmartRepair"
             mc:Ignorable="d"
             Background="Transparent"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             d:DesignHeight="900" d:DesignWidth="1400">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

        <!-- Shared Brushes (Frozen for performance) -->
        <SolidColorBrush x:Key="BrushPrimary" Color="#3b82f6" PresentationOptions:Freeze="True" xmlns:PresentationOptions="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"/>
        <SolidColorBrush x:Key="BrushSuccess" Color="#3fb950" PresentationOptions:Freeze="True" xmlns:PresentationOptions="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"/>
        <SolidColorBrush x:Key="BrushWarning" Color="#d29922" PresentationOptions:Freeze="True" xmlns:PresentationOptions="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"/>
        <SolidColorBrush x:Key="BrushError" Color="#f85149" PresentationOptions:Freeze="True" xmlns:PresentationOptions="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"/>
        <SolidColorBrush x:Key="BrushInfo" Color="#8b949e" PresentationOptions:Freeze="True" xmlns:PresentationOptions="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"/>
        <SolidColorBrush x:Key="BrushPending" Color="#484f58" PresentationOptions:Freeze="True" xmlns:PresentationOptions="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"/>
        
        <LinearGradientBrush x:Key="MainGradient" StartPoint="0,0" EndPoint="1,1" PresentationOptions:Freeze="True" xmlns:PresentationOptions="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options">
            <GradientStop Color="#FF6A00" Offset="0"/>
            <GradientStop Color="#FF8C00" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="SmartRepairGradient" StartPoint="0,0" EndPoint="1,1" PresentationOptions:Freeze="True" xmlns:PresentationOptions="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options">
            <GradientStop Color="#3B82F6" Offset="0"/>
            <GradientStop Color="#8B5CF6" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="ProgressGradient" StartPoint="0,0" EndPoint="1,0" PresentationOptions:Freeze="True" xmlns:PresentationOptions="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options">
            <GradientStop Color="#3B82F6" Offset="0"/>
            <GradientStop Color="#8B5CF6" Offset="0.5"/>
            <GradientStop Color="#60A5FA" Offset="1"/>
        </LinearGradientBrush>

        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource DarkPanelBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource DefaultTextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderLight}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10" SnapsToDevicePixels="true">
                            <ContentPresenter Focusable="False" HorizontalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"
                                              RecognizesAccessKey="True"
                                              SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="true">
                                <Setter Property="Background" TargetName="border" Value="{DynamicResource BgHover}"/>
                                <Setter Property="BorderBrush" TargetName="border" Value="{StaticResource BrushPrimary}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="true">
                                <Setter Property="Background" TargetName="border" Value="#2AFFFFFF"/>
                                <Setter Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.98" ScaleY="0.98"/>
                                    </Setter.Value>
                                </Setter>
                                <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Background" Value="{StaticResource MainGradient}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <Style x:Key="CancelButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#10f85149"/>
            <Setter Property="Foreground" Value="{StaticResource BrushError}"/>
            <Setter Property="BorderBrush" Value="#30f85149"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10" SnapsToDevicePixels="true">
                            <ContentPresenter Focusable="False" HorizontalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"
                                              RecognizesAccessKey="True"
                                              SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="true">
                                <Setter Property="Background" TargetName="border" Value="#25f85149"/>
                                <Setter Property="BorderBrush" TargetName="border" Value="{StaticResource BrushError}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="true">
                                <Setter Property="Background" TargetName="border" Value="#40f85149"/>
                                <Setter Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.95" ScaleY="0.95"/>
                                    </Setter.Value>
                                </Setter>
                                <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GlassCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource BgCardGlass}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderLight}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="20,16"/>
        </Style>

        <Style x:Key="StatValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMain}"/>
        </Style>

        <Style x:Key="StatLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{DynamicResource TextDim}"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>

        <Style x:Key="LogTextBlock" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{StaticResource BrushInfo}"/>
            <Setter Property="Margin" Value="8,1,4,1"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style x:Key="StepItemBorder" TargetType="Border">
            <Setter Property="BorderBrush" Value="{DynamicResource BorderLight}"/>
            <Setter Property="BorderThickness" Value="0,0,0,0.5"/>
            <Setter Property="Padding" Value="12,6"/>
        </Style>

        <Style x:Key="NoSelectListViewItem" TargetType="ListViewItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <Border Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ========== HEADER ========== -->
        <Border Grid.Row="0" Background="{DynamicResource BgDark}"
                BorderBrush="{DynamicResource BorderLight}" BorderThickness="0,0,0,1"
                Padding="24,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="36" Height="36" CornerRadius="8"
                            Background="{StaticResource SmartRepairGradient}" Margin="0,0,12,0">
                        <Path Data="M 14.707 3.293 c -0.391 -0.391 -1.023 -0.391 -1.414 0 l -4.5 4.5 c -0.391 0.391 -0.391 1.023 0 1.414 l 1.293 1.293 l -6.793 6.793 c -1.172 1.171 -1.172 3.071 0 4.243 c 1.171 1.171 3.071 1.171 4.243 0 l 6.793 -6.793 l 1.293 1.293 c 0.391 0.391 1.023 0.391 1.414 0 l 4.5 -4.5 c 0.391 -0.391 0.391 -1.023 0 -1.414 l -1.293 -1.293 l 2.5 -2.5 c 0.781 -0.781 0.781 -2.047 0 -2.828 s -2.047 -0.781 -2.828 0 l -2.5 2.5 L 14.707 3.293 z" 
                              Fill="White" Stretch="Uniform" Width="18" Height="18" 
                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel>
                        <TextBlock Text="{Binding [SmartRepairTitle], Source={x:Static services:LocalizationService.Instance}}"
                                   FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextMain}"/>
                        <TextBlock Text="{Binding [SmartRepairSubtitle], Source={x:Static services:LocalizationService.Instance}}"
                                   FontSize="11" Foreground="{DynamicResource TextDim}"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Confirm button removed -->
                    <Button Command="{Binding CancelCommand}"
                            Margin="0,0,8,0">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource CancelButtonStyle}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsScanning}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsExecuting}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <Path Data="M 4.293 4.293 a 1 1 0 0 1 1.414 0 L 10 8.586 l 4.293 -4.293 a 1 1 0 1 1 1.414 1.414 L 11.414 10 l 4.293 4.293 a 1 1 0 0 1 -1.414 1.414 L 10 11.414 l -4.293 4.293 a 1 1 0 0 1 -1.414 -1.414 L 8.586 10 L 4.293 5.707 a 1 1 0 0 1 0 -1.414 Z" 
                                  Fill="{StaticResource BrushError}" Stretch="Uniform" Width="10" Height="10" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding [SmartRepairCancel], Source={x:Static services:LocalizationService.Instance}}" FontSize="12" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding CloseCommand}" Style="{StaticResource ModernButton}" Padding="14,6"
                            Visibility="{Binding IsCompleted, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="M20,11V13H8L13.5,18.5L12.08,19.92L4.16,12L12.08,4.08L13.5,5.5L8,11H20Z" Fill="{DynamicResource TextPrimary}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding [SmartRepairBackDashboard], Source={x:Static services:LocalizationService.Instance}}" FontSize="12"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ========== PROGRESS CARD ========== -->
        <Border Grid.Row="1" Style="{StaticResource GlassCard}" Margin="24,16,24,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <ProgressBar Grid.Row="0" Height="6" Value="{Binding OverallPercent, Mode=OneWay}" Maximum="100" BorderThickness="0" Background="#1a1a2e" Foreground="{StaticResource ProgressGradient}"/>

                <Grid Grid.Row="1" Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding OverallPercent, StringFormat='{}{0}%'}"
                               FontSize="28" FontWeight="Light" Foreground="{DynamicResource TextMain}"
                               Margin="0,0,16,0"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding CurrentStepName}" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextMain}" TextTrimming="CharacterEllipsis" ToolTip="{Binding CurrentStepName}"/>
                        <TextBlock Text="{Binding CurrentStepDescription}" FontSize="11"
                                   Foreground="{DynamicResource TextDim}" Margin="0,1,0,0" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <TextBlock Grid.Column="2" Text="{Binding TotalElapsedLabel}" FontSize="11"
                               Foreground="{DynamicResource TextDim}" VerticalAlignment="Center"
                               Margin="0,0,12,0"/>
                </Grid>
            </Grid>
        </Border>

        <!-- ========== STATS ROW (Responsive Grid) ========== -->
        <UniformGrid Grid.Row="2" Margin="24,12,24,0" Columns="5">
            <Border Style="{StaticResource GlassCard}" Padding="14,10" Margin="0,0,8,8" MinWidth="160">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource StatValue}" Foreground="{StaticResource BrushPrimary}">
                        <Run Text="{Binding CompletedSteps, Mode=OneWay}"/><Run Text="/"/><Run Text="{Binding TotalSteps, Mode=OneWay}"/>
                    </TextBlock>
                    <TextBlock Style="{StaticResource StatLabel}" Text="{Binding StepCountLabel}"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource GlassCard}" Padding="14,10" Margin="0,0,8,8" MinWidth="160">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding TotalFilesChecked, StringFormat='{}{0:N0}'}" Style="{StaticResource StatValue}"/>
                    <TextBlock Style="{StaticResource StatLabel}"
                               Text="{Binding [SmartRepairFilesChecked], Source={x:Static services:LocalizationService.Instance}}"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource GlassCard}" Padding="14,10" Margin="0,0,8,8" MinWidth="160">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding TotalFilesFixed, StringFormat='{}{0:N0}'}" Foreground="{StaticResource BrushSuccess}"
                               Style="{StaticResource StatValue}"/>
                    <TextBlock Style="{StaticResource StatLabel}"
                               Text="{Binding [SmartRepairFixes], Source={x:Static services:LocalizationService.Instance}}"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource GlassCard}" Padding="14,10" Margin="0,0,8,8" MinWidth="160">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding TotalSpaceRecovered}" Foreground="{StaticResource BrushPrimary}"
                               Style="{StaticResource StatValue}"/>
                    <TextBlock Style="{StaticResource StatLabel}"
                               Text="{Binding [SmartRepairSpaceRecovered], Source={x:Static services:LocalizationService.Instance}}"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource GlassCard}" Padding="14,10" Margin="0,0,0,8" MinWidth="160">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding ProblemsFound, StringFormat='{}{0}'}" Foreground="{StaticResource BrushWarning}"
                               Style="{StaticResource StatValue}"/>
                    <TextBlock Style="{StaticResource StatLabel}"
                               Text="{Binding [SmartRepairProblemsFound], Source={x:Static services:LocalizationService.Instance}}"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- ========== MAIN CONTENT (STEP LIST + LOG) ========== -->
        <Grid Grid.Row="3" Margin="24,4,24,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>

            <!-- Step List -->
            <Border Grid.Column="0" Style="{StaticResource GlassCard}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" BorderBrush="{DynamicResource BorderLight}"
                            BorderThickness="0,0,0,1" Padding="16,10">
                        <TextBlock Text="{Binding [SmartRepairSteps], Source={x:Static services:LocalizationService.Instance}}"
                                   FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextMain}"/>
                    </Border>
                    <ListView Grid.Row="1" ItemsSource="{Binding Modules}" x:Name="StepsListView"
                              VirtualizingStackPanel.IsVirtualizing="True" 
                              VirtualizingStackPanel.VirtualizationMode="Recycling"
                              ScrollViewer.CanContentScroll="True"
                              ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              BorderThickness="0" Background="Transparent"
                              Padding="0" Margin="0,0,4,8" HorizontalContentAlignment="Stretch"
                              ItemContainerStyle="{StaticResource NoSelectListViewItem}">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource StepItemBorder}" Width="{Binding ViewportWidth, RelativeSource={RelativeSource AncestorType=ScrollViewer}}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        
                                        <Path Grid.Column="0" Margin="0,0,8,0" VerticalAlignment="Center" x:Name="StatusIconPath" 
                                              Data="M 12 2 A 10 10 0 1 0 22 12 A 10 10 0 0 0 12 2 Z M 12 20 A 8 8 0 1 1 20 12 A 8 8 0 0 1 12 20 Z" 
                                              Fill="{StaticResource BrushPending}" Stretch="Uniform" Width="14" Height="14"
                                              RenderTransformOrigin="0.5,0.5">
                                            <Path.RenderTransform>
                                                <RotateTransform Angle="0"/>
                                            </Path.RenderTransform>
                                        </Path>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding Name}" FontSize="12" Foreground="{DynamicResource TextMain}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/>
                                            <StackPanel Orientation="Horizontal" x:Name="StatusContainer">
                                                <TextBlock FontSize="10" Foreground="{DynamicResource TextDim}" x:Name="StatusDescText" Text="{Binding [SmartRepairStatusPending], Source={x:Static services:LocalizationService.Instance}}"/>
                                                <Grid x:Name="DotsGrid" Visibility="Collapsed" ClipToBounds="True" Width="0" HorizontalAlignment="Left" Margin="1,0,0,0">
                                                    <TextBlock FontSize="10" Foreground="{StaticResource BrushPrimary}" Text="..."/>
                                                </Grid>
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding Status}" Value="Running">
                                        <Setter TargetName="StatusIconPath" Property="Data" Value="M12,4V1L8,5l4,4V6c3.31,0,6,2.69,6,6c0,1.01-0.25,1.97-0.7,2.8l1.46,1.46C19.54,15.03,20,13.57,20,12C20,7.58,16.42,4,12,4z M12,18c-3.31,0-6-2.69-6-6c0-1.01,0.25-1.97,0.7-2.8L5.24,7.74C4.46,8.97,4,10.43,4,12c0,4.42,3.58,8,8,8v3l4-4l-4-4V18z"/>
                                        <Setter TargetName="StatusIconPath" Property="Fill" Value="{StaticResource BrushPrimary}"/>
                                        <Setter TargetName="StatusDescText" Property="Text" Value="{Binding [SmartRepairStatusRunning], Source={x:Static services:LocalizationService.Instance}}"/>
                                        <Setter TargetName="StatusDescText" Property="Foreground" Value="{StaticResource BrushPrimary}"/>
                                        <Setter TargetName="DotsGrid" Property="Visibility" Value="Visible"/>
                                        <DataTrigger.EnterActions>
                                            <BeginStoryboard Name="SpinAnimation">
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetName="StatusIconPath"
                                                                     Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                                     From="0" To="360" Duration="0:0:1" RepeatBehavior="Forever"/>
                                                    
                                                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="DotsGrid" 
                                                                                   Storyboard.TargetProperty="Width" 
                                                                                   Duration="0:0:1.6" RepeatBehavior="Forever">
                                                        <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0"/>
                                                        <DiscreteDoubleKeyFrame KeyTime="0:0:0.4" Value="4"/>
                                                        <DiscreteDoubleKeyFrame KeyTime="0:0:0.8" Value="8"/>
                                                        <DiscreteDoubleKeyFrame KeyTime="0:0:1.2" Value="12"/>
                                                    </DoubleAnimationUsingKeyFrames>

                                                    <DoubleAnimation Storyboard.TargetName="StatusDescText"
                                                                     Storyboard.TargetProperty="Opacity"
                                                                     From="0.6" To="1.0" Duration="0:0:0.8" AutoReverse="True" RepeatBehavior="Forever"/>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </DataTrigger.EnterActions>
                                        <DataTrigger.ExitActions>
                                            <StopStoryboard BeginStoryboardName="SpinAnimation"/>
                                        </DataTrigger.ExitActions>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Status}" Value="Completed">
                                        <Setter TargetName="StatusIconPath" Property="Data" Value="M 9 16.17 L 4.83 12 l -1.42 1.41 L 9 19 L 21 7 l -1.41 -1.41 Z"/>
                                        <Setter TargetName="StatusIconPath" Property="Fill" Value="{StaticResource BrushSuccess}"/>
                                        <Setter TargetName="StatusDescText" Property="Text" Value="{Binding [SmartRepairStatusCompleted], Source={x:Static services:LocalizationService.Instance}}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Status}" Value="Failed">
                                        <Setter TargetName="StatusIconPath" Property="Data" Value="M 19 6.41 L 17.59 5 L 12 10.59 L 6.41 5 L 5 6.41 L 10.59 12 L 5 17.59 L 6.41 19 L 12 13.41 L 17.59 19 L 19 17.59 L 13.41 12 Z"/>
                                        <Setter TargetName="StatusIconPath" Property="Fill" Value="{StaticResource BrushError}"/>
                                        <Setter TargetName="StatusDescText" Property="Text" Value="{Binding [SmartRepairStatusFailed], Source={x:Static services:LocalizationService.Instance}}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Status}" Value="Warning">
                                        <Setter TargetName="StatusIconPath" Property="Data" Value="M 1 21 h 22 L 12 2 Z m 12 -3 h -2 v -2 h 2 Z m 0 -4 h -2 v -4 h 2 Z"/>
                                        <Setter TargetName="StatusIconPath" Property="Fill" Value="{StaticResource BrushWarning}"/>
                                        <Setter TargetName="StatusDescText" Property="Text" Value="{Binding [SmartRepairStatusWarning], Source={x:Static services:LocalizationService.Instance}}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Status}" Value="Skipped">
                                        <Setter TargetName="StatusIconPath" Property="Data" Value="M 6 18 l 8.5 -6 L 6 6 v 12 z M 16 6 v 12 h 2 V 6 h -2 z"/>
                                        <Setter TargetName="StatusIconPath" Property="Fill" Value="{StaticResource BrushInfo}"/>
                                        <Setter TargetName="StatusDescText" Property="Text" Value="{Binding [SmartRepairStatusSkipped], Source={x:Static services:LocalizationService.Instance}}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Status}" Value="Cancelled">
                                        <Setter TargetName="StatusIconPath" Property="Data" Value="M 12 2 C 6.47 2 2 6.47 2 12 s 4.47 10 10 10 s 10 -4.47 10 -10 S 17.53 2 12 2 Z m 5 11 H 7 v -2 h 10 v 2 Z"/>
                                        <Setter TargetName="StatusIconPath" Property="Fill" Value="{StaticResource BrushInfo}"/>
                                        <Setter TargetName="StatusDescText" Property="Text" Value="{Binding [SmartRepairStatusCancelled], Source={x:Static services:LocalizationService.Instance}}"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>

            <!-- Log Panel -->
            <Border Grid.Column="2" Style="{StaticResource GlassCard}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" BorderBrush="{DynamicResource BorderLight}"
                            BorderThickness="0,0,0,1" Padding="16,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="{Binding [SmartRepairRealtimeLog], Source={x:Static services:LocalizationService.Instance}}"
                                       FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextMain}"/>
                            <TextBlock Grid.Column="1" FontSize="10" Foreground="{DynamicResource TextDim}"
                                       VerticalAlignment="Center" Text="{Binding LogCountLabel}"/>
                        </Grid>
                    </Border>
                    <!-- Log ListView with true Virtualization -->
                    <ListView Grid.Row="1" ItemsSource="{Binding LogEntries}" x:Name="LogListView"
                              Background="Transparent" BorderThickness="0" Padding="0" Margin="0,0,4,8"
                              HorizontalContentAlignment="Stretch"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              ScrollViewer.VerticalScrollBarVisibility="Visible"
                              ScrollViewer.CanContentScroll="True"
                              VirtualizingStackPanel.IsVirtualizing="True"
                              VirtualizingStackPanel.VirtualizationMode="Recycling"
                              ItemContainerStyle="{StaticResource NoSelectListViewItem}">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Width="{Binding ViewportWidth, RelativeSource={RelativeSource AncestorType=ScrollViewer}}">
                                    <TextBlock Style="{StaticResource LogTextBlock}" x:Name="LogText" TextWrapping="Wrap"
                                               HorizontalAlignment="Stretch" Margin="16,2,16,2">
                                        <Run Text="{Binding FormattedTimestamp, Mode=OneWay}"/><Run Text=" "/><Run Text="{Binding Message, Mode=OneWay}"/>
                                    </TextBlock>
                                </Grid>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding LogType}" Value="Info">
                                        <Setter TargetName="LogText" Property="Foreground" Value="{StaticResource BrushInfo}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding LogType}" Value="Success">
                                        <Setter TargetName="LogText" Property="Foreground" Value="{StaticResource BrushSuccess}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding LogType}" Value="Warning">
                                        <Setter TargetName="LogText" Property="Foreground" Value="{StaticResource BrushWarning}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding LogType}" Value="Error">
                                        <Setter TargetName="LogText" Property="Foreground" Value="{StaticResource BrushError}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding LogType}" Value="Focus">
                                        <Setter TargetName="LogText" Property="Foreground" Value="{StaticResource BrushPrimary}"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>
        </Grid>

        <!-- ========== COMPLETION SUMMARY (overlays when done) ========== -->
        <Border Grid.Row="1" Grid.RowSpan="3" Style="{StaticResource GlassCard}" Margin="24,12,24,24"
                Background="#0D1117"
                Visibility="{Binding IsCompleted, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}">
            <Grid VerticalAlignment="Center" HorizontalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Width="56" Height="56" CornerRadius="28" BorderThickness="2" Margin="0,0,20,0">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="#1A3fb950"/>
                            <Setter Property="BorderBrush" Value="{StaticResource BrushSuccess}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SummaryIcon}" Value="Warning">
                                    <Setter Property="Background" Value="#1Ad29922"/>
                                    <Setter Property="BorderBrush" Value="{StaticResource BrushWarning}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding SummaryIcon}" Value="Error">
                                    <Setter Property="Background" Value="#1Af85149"/>
                                    <Setter Property="BorderBrush" Value="{StaticResource BrushError}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Path Stretch="Uniform" Width="24" Height="24" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Path.Style>
                            <Style TargetType="Path">
                                <Setter Property="Data" Value="M 9 16.17 L 4.83 12 l -1.42 1.41 L 9 19 L 21 7 l -1.41 -1.41 Z"/>
                                <Setter Property="Fill" Value="{StaticResource BrushSuccess}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SummaryIcon}" Value="Warning">
                                        <Setter Property="Data" Value="M 1 21 h 22 L 12 2 Z m 12 -3 h -2 v -2 h 2 Z m 0 -4 h -2 v -4 h 2 Z"/>
                                        <Setter Property="Fill" Value="{StaticResource BrushWarning}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding SummaryIcon}" Value="Error">
                                        <Setter Property="Data" Value="M 19 6.41 L 17.59 5 L 12 10.59 L 6.41 5 L 5 6.41 L 10.59 12 L 5 17.59 L 6.41 19 L 12 13.41 L 17.59 19 L 19 17.59 L 13.41 12 Z"/>
                                        <Setter Property="Fill" Value="{StaticResource BrushError}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Path.Style>
                    </Path>
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding SummaryTitle}" FontSize="18" FontWeight="Bold">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{StaticResource BrushSuccess}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SummaryIcon}" Value="Warning">
                                        <Setter Property="Foreground" Value="{StaticResource BrushWarning}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding SummaryIcon}" Value="Error">
                                        <Setter Property="Foreground" Value="{StaticResource BrushError}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Text="{Binding SummaryMessage}" FontSize="12" Foreground="{DynamicResource TextDim}" Margin="0,4,0,0" TextWrapping="Wrap" MaxWidth="500"/>
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Command="{Binding ViewReportCommand}" Style="{StaticResource AccentButton}"
                                Padding="14,6" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="M 14 2 H 6 c -1.1 0 -1.99 0.9 -1.99 2 L 4 20 c 0 1.1 0.89 2 1.99 2 H 18 c 1.1 0 2 -0.9 2 -2 V 8 l -6 -6 z M 16 18 H 8 v -2 h 8 v 2 z m 0 -4 H 8 v -2 h 8 v 2 z m -3 -5 V 3.5 L 18.5 9 H 13 z" 
                                      Fill="White" Stretch="Uniform" Width="12" Height="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding [SmartRepairOpenReport], Source={x:Static services:LocalizationService.Instance}}" FontSize="12" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding CopySummaryCommand}" Style="{StaticResource ModernButton}"
                                Padding="14,6" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="M 16 1 H 4 c -1.1 0 -2 0.9 -2 2 v 14 h 2 V 3 h 12 V 1 z m 3 4 H 8 c -1.1 0 -2 0.9 -2 2 v 14 c 0 1.1 0.9 2 2 2 h 11 c 1.1 0 2 -0.9 2 -2 V 7 c 0 -1.1 -0.9 -2 -2 -2 z m 0 16 H 8 V 7 h 11 v 14 z" 
                                      Fill="{DynamicResource DefaultTextBrush}" Stretch="Uniform" Width="12" Height="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding [SmartRepairCopySummary], Source={x:Static services:LocalizationService.Instance}}" FontSize="12" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding CloseCommand}" Style="{StaticResource ModernButton}" Padding="14,6">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="M 20 11 H 7.83 l 5.59 -5.59 L 12 4 l -8 8 l 8 8 l 1.41 -1.41 L 7.83 13 H 20 v -2 Z" 
                                      Fill="{DynamicResource DefaultTextBrush}" Stretch="Uniform" Width="12" Height="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding [SmartRepairBack], Source={x:Static services:LocalizationService.Instance}}" FontSize="12" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
