<UserControl xmlns:services="clr-namespace:VoltrisOptimizer.Services" x:Class="VoltrisOptimizer.UI.Views.PrivacyView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:VoltrisOptimizer.UI.ViewModels"
             mc:Ignorable="d"
             Background="Transparent"
             DataContext="{Binding PrivacyVM, Source={x:Static vm:ViewModelLocator.Instance}}"
             d:DesignHeight="900" d:DesignWidth="1100">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/UI/Themes/Icons.xaml" />
            </ResourceDictionary.MergedDictionaries>
            
            <Storyboard x:Key="EntryAnimation">
                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.6"/>
                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" From="20" To="0" Duration="0:0:0.6">
                    <DoubleAnimation.EasingFunction>
                        <PowerEase EasingMode="EaseOut" Power="5"/>
                    </DoubleAnimation.EasingFunction>
                </DoubleAnimation>
            </Storyboard>
        </ResourceDictionary>
    </UserControl.Resources>

    <UserControl.RenderTransform>
        <TranslateTransform/>
    </UserControl.RenderTransform>

    <UserControl.Triggers>
        <EventTrigger RoutedEvent="UserControl.Loaded">
            <BeginStoryboard Storyboard="{StaticResource EntryAnimation}"/>
        </EventTrigger>
    </UserControl.Triggers>

    <Grid>
        <Grid IsHitTestVisible="False" ClipToBounds="True">
            <Ellipse Width="600" Height="600" Fill="#0D31A8FF" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-300,-200,0">
                <Ellipse.Effect><BlurEffect Radius="120"/></Ellipse.Effect>
            </Ellipse>
        </Grid>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid Margin="32,40,10,40">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                
                <!-- HEADER CENTRALIZADO (Grid.Row=0) -->
                <StackPanel Grid.Row="0" Margin="0,0,0,40" HorizontalAlignment="Center">
                    <Grid HorizontalAlignment="Center" Margin="0,0,0,16">
                        <ContentControl Style="{StaticResource ModernPageHeaderIconStyle}">
                            <Path Data="{DynamicResource PrivacyIcon}" 
                                  Fill="White" 
                                  Width="20" Height="20" 
                                  Stretch="Uniform" 
                                  HorizontalAlignment="Center" 
                                  VerticalAlignment="Center"/>
                        </ContentControl>
                    </Grid>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,8">
                        <Path Data="{DynamicResource PrivacyIcon}" Fill="{DynamicResource BrandBlue}" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding [PrivacySubTitle], Source={x:Static services:LocalizationService.Instance}}" 
                                   FontFamily="Segoe UI Variable Display, Segoe UI"
                                   FontSize="12" FontWeight="Black"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource BrandBlue}"/>
                    </StackPanel>
                    
                    <TextBlock Text="{Binding [PrivacyTitle], Source={x:Static services:LocalizationService.Instance}}" 
                               Style="{DynamicResource PageTitleTextStyle}"
                               HorizontalAlignment="Center"/>
                    
                    <TextBlock Text="{Binding [PrivacyDesc], Source={x:Static services:LocalizationService.Instance}}" 
                               Style="{DynamicResource BodyTextStyle}"
                               HorizontalAlignment="Center"
                               Margin="0,8,0,0" Opacity="0.7"/>
                </StackPanel>

                <!-- CONTEÚDE EM CARD VERTICAL (Grid.Row=1) -->
                <Border Grid.Row="1" Style="{DynamicResource CardBorderStyle}" HorizontalAlignment="Stretch" Margin="0,0,0,20">
                    <StackPanel Margin="32">
                        
                        <!-- SEÇÃO 1: DADOS E RASTREIO -->
                        <StackPanel Margin="0,0,0,32">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,24">
                                <Path Data="{DynamicResource SettingsIcon}" Fill="{DynamicResource BrandBlue}" Width="20" Height="20" Stretch="Uniform" Margin="0,0,12,0" Opacity="0.8"/>
                                <TextBlock Text="{Binding [PrivacyDataTracking], Source={x:Static services:LocalizationService.Instance}}" Style="{DynamicResource CardHeaderStyle}"/>
                            </StackPanel>

                            <UniformGrid Columns="2">
                                <!-- Telemetria -->
                                <Grid Margin="0,0,24,20">
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,50,0">
                                        <TextBlock Text="{Binding [PrivacyTelemetry], Source={x:Static services:LocalizationService.Instance}}" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" FontSize="14" Margin="0,0,0,2"/>
                                        <TextBlock Text="{Binding [PrivacyTelemetryDesc], Source={x:Static services:LocalizationService.Instance}}" Style="{DynamicResource BodyTextStyle}" Opacity="0.5" FontSize="12" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <CheckBox IsChecked="{Binding IsTelemetryDisabled}" Style="{DynamicResource PremiumCheckBoxStyle}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>

                                <!-- Localização -->
                                <Grid Margin="0,0,0,20">
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,50,0">
                                        <TextBlock Text="{Binding [PrivacyLocation], Source={x:Static services:LocalizationService.Instance}}" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" FontSize="14" Margin="0,0,0,2"/>
                                        <TextBlock Text="{Binding [PrivacyLocationDesc], Source={x:Static services:LocalizationService.Instance}}" Style="{DynamicResource BodyTextStyle}" Opacity="0.5" FontSize="12" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <CheckBox IsChecked="{Binding IsLocationDisabled}" Style="{DynamicResource PremiumCheckBoxStyle}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>

                                <!-- ID Anúncios -->
                                <Grid Margin="0,0,24,20">
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,50,0">
                                        <TextBlock Text="{Binding [PrivacyAdvertisingId], Source={x:Static services:LocalizationService.Instance}}" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" FontSize="14" Margin="0,0,0,2"/>
                                        <TextBlock Text="{Binding [PrivacyAdvertisingIdDesc], Source={x:Static services:LocalizationService.Instance}}" Style="{DynamicResource BodyTextStyle}" Opacity="0.5" FontSize="12" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <CheckBox IsChecked="{Binding IsAdvertisingIdDisabled}" Style="{DynamicResource PremiumCheckBoxStyle}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>

                                <!-- Histórico de Atividades -->
                                <Grid Margin="0,0,0,20">
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,50,0">
                                        <TextBlock Text="{Binding [PrivacyTimeline], Source={x:Static services:LocalizationService.Instance}}" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" FontSize="14" Margin="0,0,0,2"/>
                                        <TextBlock Text="{Binding [PrivacyTimelineDesc], Source={x:Static services:LocalizationService.Instance}}" Style="{DynamicResource BodyTextStyle}" Opacity="0.5" FontSize="12" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <CheckBox IsChecked="{Binding IsActivityFeedDisabled}" Style="{DynamicResource PremiumCheckBoxStyle}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                                
                                <!-- Recall/CoPilot -->
                                <Grid Margin="0,0,24,0">
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,50,0">
                                        <TextBlock Text="{Binding [PrivacyRecall], Source={x:Static services:LocalizationService.Instance}}" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" FontSize="14" Margin="0,0,0,2"/>
                                        <TextBlock Text="{Binding [PrivacyRecallDesc], Source={x:Static services:LocalizationService.Instance}}" Style="{DynamicResource BodyTextStyle}" Opacity="0.5" FontSize="12" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <CheckBox IsChecked="{Binding IsRecallDisabled}" Style="{DynamicResource PremiumCheckBoxStyle}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                            </UniformGrid>
                        </StackPanel>

                        <Separator Background="#1AFFFFFF" Margin="0,0,0,32"/>

                        <!-- SEÇÃO 2: ENTRADA E ESCRITA -->
                        <StackPanel Margin="0,0,0,32">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,24">
                                <Path Data="{DynamicResource DiagnosticsIcon}" Fill="{DynamicResource BrandBlue}" Width="20" Height="20" Stretch="Uniform" Margin="0,0,12,0" Opacity="0.8"/>
                                <TextBlock Text="{Binding [PrivacyInputWriting], Source={x:Static services:LocalizationService.Instance}}" Style="{DynamicResource CardHeaderStyle}"/>
                            </StackPanel>

                            <UniformGrid Columns="2">
                                <!-- Escrita à Mão -->
                                <Grid Margin="0,0,24,20">
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,50,0">
                                        <TextBlock Text="{Binding [PrivacyHandwriting], Source={x:Static services:LocalizationService.Instance}}" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" FontSize="14" Margin="0,0,0,2"/>
                                        <TextBlock Text="{Binding [PrivacyHandwritingDesc], Source={x:Static services:LocalizationService.Instance}}" Style="{DynamicResource BodyTextStyle}" Opacity="0.5" FontSize="12" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <CheckBox IsChecked="{Binding IsHandwritingDisabled}" Style="{DynamicResource PremiumCheckBoxStyle}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>

                                <!-- Coleta Linguística -->
                                <Grid Margin="0,0,0,20">
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,50,0">
                                        <TextBlock Text="{Binding [PrivacyTextCollection], Source={x:Static services:LocalizationService.Instance}}" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" FontSize="14" Margin="0,0,0,2"/>
                                        <TextBlock Text="{Binding [PrivacyTextCollectionDesc], Source={x:Static services:LocalizationService.Instance}}" Style="{DynamicResource BodyTextStyle}" Opacity="0.5" FontSize="12" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <CheckBox IsChecked="{Binding IsTextInputDisabled}" Style="{DynamicResource PremiumCheckBoxStyle}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>

                                <!-- Personalização de Entrada -->
                                <Grid Margin="0,0,24,20">
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,50,0">
                                        <TextBlock Text="{Binding [PrivacyPersonalization], Source={x:Static services:LocalizationService.Instance}}" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" FontSize="14" Margin="0,0,0,2"/>
                                        <TextBlock Text="{Binding [PrivacyPersonalizationDesc], Source={x:Static services:LocalizationService.Instance}}" Style="{DynamicResource BodyTextStyle}" Opacity="0.5" FontSize="12" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <CheckBox IsChecked="{Binding IsPersonalizationDisabled}" Style="{DynamicResource PremiumCheckBoxStyle}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>

                                <!-- Fala Online -->
                                <Grid Margin="0,0,0,20">
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,50,0">
                                        <TextBlock Text="{Binding [PrivacyOnlineSpeech], Source={x:Static services:LocalizationService.Instance}}" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" FontSize="14" Margin="0,0,0,2"/>
                                        <TextBlock Text="{Binding [PrivacyOnlineSpeechDesc], Source={x:Static services:LocalizationService.Instance}}" Style="{DynamicResource BodyTextStyle}" Opacity="0.5" FontSize="12" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <CheckBox IsChecked="{Binding IsOnlineSpeechDisabled}" Style="{DynamicResource PremiumCheckBoxStyle}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                            </UniformGrid>
                        </StackPanel>

                        <Separator Background="#1AFFFFFF" Margin="0,0,0,32"/>

                        <!-- SEÇÃO 3: SERVIÇOS E NUVEM -->
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,24">
                                <Path Data="{DynamicResource SystemIcon}" Fill="{DynamicResource BrandBlue}" Width="20" Height="20" Stretch="Uniform" Margin="0,0,12,0" Opacity="0.8"/>
                                <TextBlock Text="{Binding [PrivacyServicesCloud], Source={x:Static services:LocalizationService.Instance}}" Style="{DynamicResource CardHeaderStyle}"/>
                            </StackPanel>

                            <UniformGrid Columns="2">
                                <!-- OneDrive -->
                                <Grid Margin="0,0,24,20">
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,50,0">
                                        <TextBlock Text="{Binding [PrivacyOneDrive], Source={x:Static services:LocalizationService.Instance}}" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" FontSize="14" Margin="0,0,0,2"/>
                                        <TextBlock Text="{Binding [PrivacyOneDriveDesc], Source={x:Static services:LocalizationService.Instance}}" Style="{DynamicResource BodyTextStyle}" Opacity="0.5" FontSize="12" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <CheckBox IsChecked="{Binding IsOneDriveDisabled}" Style="{DynamicResource PremiumCheckBoxStyle}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>

                                <!-- Cortana/Copilot -->
                                <Grid Margin="0,0,0,20">
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,50,0">
                                        <TextBlock Text="{Binding [PrivacyCortanaCopilot], Source={x:Static services:LocalizationService.Instance}}" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" FontSize="14" Margin="0,0,0,2"/>
                                        <TextBlock Text="{Binding [PrivacyCortanaCopilotDesc], Source={x:Static services:LocalizationService.Instance}}" Style="{DynamicResource BodyTextStyle}" Opacity="0.5" FontSize="12" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <CheckBox IsChecked="{Binding IsCoPilotDisabled}" Style="{DynamicResource PremiumCheckBoxStyle}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>

                                <!-- Bluetooth Ad -->
                                <Grid Margin="0,0,24,20">
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,50,0">
                                        <TextBlock Text="{Binding [PrivacyBluetoothAds], Source={x:Static services:LocalizationService.Instance}}" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" FontSize="14" Margin="0,0,0,2"/>
                                        <TextBlock Text="{Binding [PrivacyBluetoothAdsDesc], Source={x:Static services:LocalizationService.Instance}}" Style="{DynamicResource BodyTextStyle}" Opacity="0.5" FontSize="12" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <CheckBox IsChecked="{Binding IsBluetoothDisabled}" Style="{DynamicResource PremiumCheckBoxStyle}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>

                                <!-- Clipboard Sync -->
                                <Grid Margin="0,0,0,20">
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,50,0">
                                        <TextBlock Text="{Binding [PrivacyClipboard], Source={x:Static services:LocalizationService.Instance}}" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" FontSize="14" Margin="0,0,0,2"/>
                                        <TextBlock Text="{Binding [PrivacyClipboardDesc], Source={x:Static services:LocalizationService.Instance}}" Style="{DynamicResource BodyTextStyle}" Opacity="0.5" FontSize="12" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <CheckBox IsChecked="{Binding IsClipboardSyncDisabled}" Style="{DynamicResource PremiumCheckBoxStyle}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>

                                <!-- Diag Toasts -->
                                <Grid Margin="0,0,24,0">
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,50,0">
                                        <TextBlock Text="{Binding [PrivacyDiagFeedback], Source={x:Static services:LocalizationService.Instance}}" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" FontSize="14" Margin="0,0,0,2"/>
                                        <TextBlock Text="{Binding [PrivacyDiagFeedbackDesc], Source={x:Static services:LocalizationService.Instance}}" Style="{DynamicResource BodyTextStyle}" Opacity="0.5" FontSize="12" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <CheckBox IsChecked="{Binding IsDiagToastDisabled}" Style="{DynamicResource PremiumCheckBoxStyle}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                            </UniformGrid>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <TextBlock Grid.Row="2" Text="{Binding [PrivacyRestartNote], Source={x:Static services:LocalizationService.Instance}}" 
                           Style="{DynamicResource BodyTextStyle}" Opacity="0.4" FontSize="11" Margin="0,32,0,0" TextAlignment="Center" FontStyle="Italic"/>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>


