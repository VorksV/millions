                        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                            <!-- Ícone de cursor (path SVG) -->
                            <Path Data="M13.64,21.97C13.14,22.21 12.54,22 12.31,21.5L10.13,16.76L7.62,18.78C7.45,18.92 7.24,19 7,19A1,1 0 0,1 6,18V3A1,1 0 0,1 7,2C7.24,2 7.47,2.09 7.64,2.23L7.65,2.22L7.76,2.33L19.14,13.72C19.57,14.15 19.57,14.86 19.14,15.29C18.7,15.72 18,15.72 17.56,15.29L15.04,12.78L13.8,15.07L16.32,20.11C16.57,20.62 16.35,21.22 15.84,21.46L13.64,21.97Z"
                                  Fill="#CC88FF" Width="18" Height="18" Stretch="Uniform"
                                  VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="{Binding [Loc_CustomCursors], Source={x:Static services:LocalizationService.Instance}}" Style="{StaticResource STitle}" Margin="0"/>
                            <Border CornerRadius="4" Padding="6,2" Margin="10,0,0,0"
                                    Background="#1ACC88FF" BorderBrush="#30CC88FF" BorderThickness="1">
                                <TextBlock Text="{Binding [Loc_RealTime], Source={x:Static services:LocalizationService.Instance}}" FontSize="9" Foreground="#CC88FF" FontWeight="SemiBold"/>
                            </Border>
                        </StackPanel>

                        <TextBlock Text="{Binding [Loc_SelectACursorThemeAnd], Source={x:Static services:LocalizationService.Instance}}"
                                   Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"
                                   TextWrapping="Wrap" Margin="0,0,0,16"/>

                        <!-- Seção de Seleção de Cursor -->
                        <Grid Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding [Loc_ChooseYourStyle], Source={x:Static services:LocalizationService.Instance}}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="14" FontWeight="Bold" Margin="0,0,0,2"/>
                                <TextBlock Text="{Binding [Loc_ApplicationIsInstantaneousClickOn], Source={x:Static services:LocalizationService.Instance}}" Foreground="{DynamicResource TextMutedBrush}" FontSize="11"/>
                            </StackPanel>

                            <!-- Restaurar Padrão (Agora como botão secundário discreto) -->
                            <Button Grid.Column="1"
                                    Command="{Binding RestoreCursorCommand}"
                                    FocusVisualStyle="{x:Null}"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Cursor="Hand">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="#15FF4466"/>
                                        <Setter Property="BorderBrush" Value="#40FF4466"/>
                                        <Setter Property="BorderThickness" Value="1"/>
                                        <Setter Property="Foreground" Value="#FF99AA"/>
                                        <Setter Property="FontSize" Value="12"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="Padding" Value="16,10"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="btnBorder" 
                                                            Background="{TemplateBinding Background}" 
                                                            BorderBrush="{TemplateBinding BorderBrush}" 
                                                            BorderThickness="{TemplateBinding BorderThickness}" 
                                                            CornerRadius="10" 
                                                            Padding="{TemplateBinding Padding}"
                                                            SnapsToDevicePixels="True">
                                                        <Grid>
                                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                                <Path Data="M12.5,8C9.85,8 7.45,9 5.6,10.6L2,7V16H11L7.38,12.38C8.77,11.22 10.54,10.5 12.5,10.5C16.04,10.5 19.05,12.81 20.1,16L22.47,15.22C21.08,11.03 17.15,8 12.5,8Z" Fill="{TemplateBinding Foreground}" Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                                                <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="True"/>
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="btnBorder" Property="Background" Value="#25FF4466"/>
                                                            <Setter TargetName="btnBorder" Property="BorderBrush" Value="#80FF4466"/>
                                                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                                        </Trigger>
                                                        <Trigger Property="IsPressed" Value="True">
                                                            <Setter TargetName="btnBorder" Property="Opacity" Value="0.8"/>
                                                            <Setter TargetName="btnBorder" Property="RenderTransform">
                                                                <Setter.Value>
                                                                    <ScaleTransform ScaleX="0.97" ScaleY="0.97"/>
                                                                </Setter.Value>
                                                            </Setter>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Button.Style>
                                <TextBlock Text="{Binding [Loc_RestoreOriginal], Source={x:Static services:LocalizationService.Instance}}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            </Button>
                        </Grid>

                        <ItemsControl ItemsSource="{Binding AvailableCursorThemes}" Margin="0,0,0,20">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="4"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border x:Name="CardBorder"
                                            Margin="0,0,10,12"
                                            CornerRadius="14" Padding="16,18"
                                            Cursor="Hand"
                                            BorderThickness="2"
                                            Background="#0AFFFFFF"
                                            BorderBrush="#10FFFFFF">
                                        <Border.InputBindings>
                                            <MouseBinding MouseAction="LeftClick"
                                                          Command="{Binding DataContext.ApplyCursorThemeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                          CommandParameter="{Binding}"/>
                                        </Border.InputBindings>
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Style.Triggers>
                                                    <DataTrigger Value="True">
                                                        <DataTrigger.Binding>
                                                            <MultiBinding Converter="{StaticResource ObjEq}">
                                                                <Binding Path="."/>
                                                                <Binding Path="DataContext.SelectedCursorTheme" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                                            </MultiBinding>
                                                        </DataTrigger.Binding>
                                                        <Setter Property="Background" Value="#20CC88FF"/>
                                                        <Setter Property="BorderBrush" Value="#80CC88FF"/>
                                                    </DataTrigger>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#15FFFFFF"/>
                                                        <Setter Property="BorderBrush" Value="#30CC88FF"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>

                                        <StackPanel>
                                            <Border Width="46" Height="46" CornerRadius="23" Background="#12CC88FF" Margin="0,0,0,12">
                                                <TextBlock Text="{Binding Emoji}" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <TextBlock Text="{Binding DisplayName}" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4"/>
                                            <TextBlock Text="{Binding Description}" FontSize="9.5" HorizontalAlignment="Center" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="140"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Status do Cursor -->
                        <Border Background="#10000000" CornerRadius="10" Padding="12,8" Visibility="{Binding CursorStatusMessage, Converter={StaticResource StringVis}}">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="8" Height="8" Fill="{Binding CursorStatusColor, Converter={StaticResource HexBrush}}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding CursorStatusMessage}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="11" FontWeight="Medium" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </Border>

                <!-- ── RODAPÉ: Restaurar Padrões ──────────────────────────────────────── -->


                <Border Style="{StaticResource PCard}" Margin="0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding [Loc_RestoreDefaultSettings], Source={x:Static services:LocalizationService.Instance}}" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{DynamicResource DefaultTextBrush}"/>
                            <TextBlock Text="{Binding [Loc_RevertsAllCustomizationsToTheir], Source={x:Static services:LocalizationService.Instance}}"
                                       Foreground="{DynamicResource TextMutedBrush}" FontSize="11" Margin="0,3,0,0"/>
                        </StackPanel>
                        <Button Grid.Column="1" Content="{Binding [Loc_RestoreDefaults], Source={x:Static services:LocalizationService.Instance}}"
                                Command="{Binding RestoreDefaultsCommand}"
                                Cursor="Hand" Padding="16,9"
                                ToolTip="{Binding [Loc_RestoresAllPersonalizationSettingsTo], Source={x:Static services:LocalizationService.Instance}}">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="#1AFF4466"/>
                                    <Setter Property="BorderBrush" Value="#30FF4466"/>
                                    <Setter Property="BorderThickness" Value="1"/>
                                    <Setter Property="Foreground" Value="#FF4466"/>
                                    <Setter Property="FontSize" Value="12"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="bd" Background="{TemplateBinding Background}"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                        CornerRadius="10" Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="bd" Property="Background" Value="#25FF4466"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                        </Button>
                    </Grid>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>

