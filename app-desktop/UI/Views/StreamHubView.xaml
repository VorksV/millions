<UserControl xmlns:services="clr-namespace:VoltrisOptimizer.Services" xmlns:license="clr-namespace:VoltrisOptimizer.Services.License" x:Class="VoltrisOptimizer.UI.Views.StreamHubView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:VoltrisOptimizer.UI.ViewModels"
             xmlns:controls="clr-namespace:VoltrisOptimizer.UI.Controls"
             mc:Ignorable="d" 
             DataContext="{Binding StreamHubVM, Source={x:Static vm:ViewModelLocator.Instance}}"
             Background="Transparent">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        
        <Storyboard x:Key="EntryAnimation">
            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.6">
                <DoubleAnimation.EasingFunction>
                    <ExponentialEase EasingMode="EaseOut" Exponent="5"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <Style x:Key="PremiumStatCard" TargetType="Border">
            <Setter Property="Background" Value="#10FFFFFF"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="18,16"/>
            <Setter Property="BorderBrush" Value="#25FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#18FFFFFF"/>
                    <Setter Property="BorderBrush" Value="#45FFFFFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <UserControl.Triggers>
        <EventTrigger RoutedEvent="UserControl.Loaded">
            <BeginStoryboard Storyboard="{StaticResource EntryAnimation}"/>
        </EventTrigger>
    </UserControl.Triggers>

    <Grid>
        <!-- Background Ambient Glows -->
        <Canvas IsHitTestVisible="False">
            <Ellipse Width="600" Height="600" Fill="#8B31FF" Opacity="0.06" Canvas.Top="-250" Canvas.Right="-200">
                <Ellipse.Effect>
                    <BlurEffect Radius="180"/>
                </Ellipse.Effect>
            </Ellipse>
            <Ellipse Width="500" Height="500" Fill="#00FF94" Opacity="0.04" Canvas.Bottom="-200" Canvas.Left="-150">
                <Ellipse.Effect>
                    <BlurEffect Radius="150"/>
                </Ellipse.Effect>
            </Ellipse>
        </Canvas>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid Margin="24,20,24,24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- 1. Header & Live Indicator -->
                    <RowDefinition Height="Auto"/> <!-- 2. Simulation Banner -->
                    <RowDefinition Height="Auto"/> <!-- 3. Metrics Cards -->
                    <RowDefinition Height="*"/>    <!-- 4. Main Control Dashboard -->
                </Grid.RowDefinitions>

                <!-- 1. HEADER & LIVE STATE INDICATOR -->
                <Border Grid.Row="0" Margin="0,0,0,16" Background="{DynamicResource BgCardGlass}" CornerRadius="16" Padding="24,20" BorderBrush="{DynamicResource BorderLight}" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Icon with premium gradient background -->
                        <Border Grid.Column="0" Width="52" Height="52" CornerRadius="12" Margin="0,0,18,0">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#8B31FF" Offset="0"/>
                                    <GradientStop Color="#00FF94" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Path Data="{DynamicResource StreamHubIcon}" Fill="White" Width="26" Height="26" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <!-- Title and subtitle localized -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding [Loc_StreamHub], Source={x:Static services:LocalizationService.Instance}}" FontSize="11" FontWeight="Black" Foreground="#8B31FF" Margin="0,0,0,4" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding [Loc_TransmissionOptimizer], Source={x:Static services:LocalizationService.Instance}}" FontSize="26" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap"/>
                        </StackPanel>

                        <!-- Control buttons (Start/Stop stream mode) -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Background="#108B31FF" CornerRadius="8" Padding="12,8" Margin="0,0,12,0" BorderBrush="#208B31FF" BorderThickness="1">
                                <TextBlock FontSize="11" FontWeight="Bold" Foreground="#8B31FF" VerticalAlignment="Center">
                                    <InlineUIContainer BaselineAlignment="Center">
                                        <Border Width="8" Height="8" CornerRadius="4" Background="#8B31FF" Margin="0,0,6,0"/>
                                    </InlineUIContainer>
                                    <Run Text="{Binding [Loc_ReadyToStream], Source={x:Static services:LocalizationService.Instance}, Mode=OneWay}"/>
                                </TextBlock>
                            </Border>

                            <Button Style="{DynamicResource NeonButtonStyle}" 
                                    Command="{Binding StartCommand}" 
                                    Padding="18,10"
                                    Visibility="{Binding IsRunning, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding [Loc_StartStreamMode], Source={x:Static services:LocalizationService.Instance}}" VerticalAlignment="Center"/>
                                    <controls:ProBadge Margin="8,0,0,0" Tip="{Binding [ProBadgeTip], Source={x:Static services:LocalizationService.Instance}}"
                                                      Visibility="{Binding Source={x:Static license:LicenseTokenStore.IsProActive}, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>
                                </StackPanel>
                            </Button>
                            
                            <Button Style="{DynamicResource SecondaryButtonStyle}" 
                                    Content="{Binding [Loc_StopStreamMode], Source={x:Static services:LocalizationService.Instance}}" 
                                    Command="{Binding StopCommand}" 
                                    Padding="18,10"
                                    Visibility="{Binding IsRunning, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 2. SIMULATION & ACTIVE STATE BANNER -->
                <Border Grid.Row="1" CornerRadius="12" Background="#15FFFFFF" BorderBrush="#25FFFFFF" BorderThickness="1" Margin="0,0,0,16" Padding="20,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Simulated or live label status -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="10" Height="10" CornerRadius="5" Background="#10B981" Margin="0,0,12,0" VerticalAlignment="Center"
                                    Visibility="{Binding IsLive, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Border.Triggers>
                                    <EventTrigger RoutedEvent="Loaded">
                                        <BeginStoryboard>
                                            <Storyboard RepeatBehavior="Forever">
                                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0.3" Duration="0:0:0.8" AutoReverse="True"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </Border.Triggers>
                            </Border>
                            <TextBlock Text="{Binding LiveStatusText}" FontSize="13" FontWeight="Bold" Foreground="{Binding LiveStatusColor, Converter={StaticResource HexStringToBrushConverter}}" VerticalAlignment="Center"/>
                            
                            <Border Width="1" Height="14" Background="#30FFFFFF" Margin="16,0" Visibility="{Binding IsDemoMode, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                            <Border Background="#1500FF94" CornerRadius="4" Padding="6,3" Visibility="{Binding IsDemoMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock Text="{Binding [Loc_ActiveMotorcycleSimulation], Source={x:Static services:LocalizationService.Instance}}" FontSize="10" FontWeight="Bold" Foreground="#00FF94"/>
                            </Border>
                        </StackPanel>

                        <!-- Telemetry duration & viewers summary -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Visibility="{Binding IsRunning, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Text="{Binding [Loc_Duration_3], Source={x:Static services:LocalizationService.Instance}}" FontSize="13" Foreground="#9CA3AF"/>
                            <TextBlock Text="{Binding StreamDuration}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,24,0"/>
                            
                            <TextBlock Text="{Binding [StreamViewers], Source={x:Static services:LocalizationService.Instance}}" FontSize="13" Foreground="#9CA3AF"/>
                            <TextBlock Text="{Binding ViewerCountText}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </StackPanel>

                        <!-- Simulation switch toggle (AAA Fallback standard) -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{Binding [Loc_PanelDemonstrationDemo], Source={x:Static services:LocalizationService.Instance}}" FontSize="11" Foreground="#9CA3AF" Margin="0,0,12,0" VerticalAlignment="Center"/>
                            <CheckBox IsChecked="{Binding IsDemoMode}" Style="{DynamicResource PremiumCheckBoxStyle}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 3. REALTIME METRICS CARDS Grid -->
                <Grid Grid.Row="2" Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Card 1: FPS -->
                    <Border Grid.Column="0" Style="{StaticResource PremiumStatCard}" Margin="0,0,8,0">
                        <StackPanel>
                            <TextBlock Text="{Binding [Loc_FpsRate], Source={x:Static services:LocalizationService.Instance}}" FontSize="9" FontWeight="Bold" Foreground="#9CA3AF" Margin="0,0,0,8"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding OutputFps}" FontSize="26" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Grid.Column="0"/>
                                <Border Width="8" Height="8" CornerRadius="4" Background="#00FF94" VerticalAlignment="Center" Grid.Column="1" Margin="8,0,0,0">
                                    <Border.Effect>
                                        <DropShadowEffect Color="#00FF94" BlurRadius="8" ShadowDepth="0"/>
                                    </Border.Effect>
                                </Border>
                            </Grid>
                            <TextBlock Text="{Binding [Loc_StableOutputForPlatforms], Source={x:Static services:LocalizationService.Instance}}" FontSize="10" Foreground="#00FF94" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Card 2: Bitrate -->
                    <Border Grid.Column="1" Style="{StaticResource PremiumStatCard}" Margin="8,0">
                        <StackPanel>
                            <TextBlock Text="{Binding [Loc_BitrateRate], Source={x:Static services:LocalizationService.Instance}}" FontSize="9" FontWeight="Bold" Foreground="#9CA3AF" Margin="0,0,0,8"/>
                            <TextBlock Text="{Binding Bitrate}" FontSize="26" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="{Binding NetworkStatus}" FontSize="10" Foreground="#00FF94" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Card 3: Uso do codificador.
                         O valor só aparece quando existe uma fonte real. Sem telemetria
                         do OBS, exibe "N/D" em vez de exibir um número fixo. -->
                    <Border Grid.Column="2" Style="{StaticResource PremiumStatCard}" Margin="8,0">
                        <StackPanel>
                            <TextBlock Text="{Binding [Loc_UseOfTheEncoder], Source={x:Static services:LocalizationService.Instance}}" FontSize="9" FontWeight="Bold" Foreground="#9CA3AF" Margin="0,0,0,8"/>
                            <TextBlock Text="{Binding GpuEncoderUsageText}" FontSize="26" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <!-- BUG CORRIGIDO: ProgressBar.Value herda de RangeBase.Value,
                             que tem BindsTwoWayByDefault=true. Ligar a uma propriedade
                             somente-leitura do ViewModel lancava
                             InvalidOperationException no InitializeComponent e a
                             pagina inteira nao carregava. Este valor e somente
                             exibicao, entao OneWay e o modo correto. -->
                        <ProgressBar Value="{Binding GpuEncoderUsagePercent, Mode=OneWay}" Height="4" Margin="0,10,0,0" Foreground="#00FF94" Background="#15FFFFFF" BorderThickness="0"/>
                            <TextBlock Text="{Binding GpuEncoderUsageHintVisibility}" FontSize="9" Foreground="#94A3B8" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Card 4: Dropped Frames -->
                    <Border Grid.Column="3" Style="{StaticResource PremiumStatCard}" Margin="8,0,0,0">
                        <StackPanel>
                            <TextBlock Text="{Binding [Loc_MissingFrames], Source={x:Static services:LocalizationService.Instance}}" FontSize="9" FontWeight="Bold" Foreground="#9CA3AF" Margin="0,0,0,8"/>
                            <TextBlock Text="{Binding DroppedFrames}" FontSize="26" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="{Binding [Loc_00AccumulatedLoss], Source={x:Static services:LocalizationService.Instance}}" FontSize="10" Foreground="#9CA3AF" Opacity="0.6" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- 4. MAIN SPLIT CONTROL DASHBOARD -->
                <Grid Grid.Row="3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.2*"/> <!-- Optimization Toggles & Advanced Controls -->
                        <ColumnDefinition Width="*"/>    <!-- AI Engagement, Live Chat & Timeline Monitor -->
                    </Grid.ColumnDefinitions>

                    <!-- COLUMN 0: SYSTEM OPTIMIZATIONS (Left Side) -->
                    <StackPanel Grid.Column="0" Margin="0,0,20,0">
                        <TextBlock Text="{Binding [Loc_SystemOptimizations], Source={x:Static services:LocalizationService.Instance}}" FontSize="17" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" Margin="4,0,0,14"/>

                        <!-- Toggle 1: CPU Thread affinity priority -->
                        <Border Style="{DynamicResource GlassCardStyle}" Margin="0,0,0,12" Padding="20">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                
                                <Border Width="40" Height="40" CornerRadius="10" Background="#128B31FF" Margin="0,0,16,0" BorderBrush="#208B31FF" BorderThickness="1">
                                    <Path Data="M13.13,22.19L11.5,18.36C13.07,17.78 14.54,17 15.9,16.09L13.13,22.19M5.64,12.5L1.81,10.87L7.91,8.1C7,9.46 6.22,10.93 5.64,12.5M19.22,4C19.5,4 19.75,4 19.96,4.05C20.13,5.44 19.94,8.3 16.66,11.58C14.96,13.29 12.93,14.6 10.65,15.47L8.5,13.37C9.42,11.06 10.73,9.03 12.42,7.34C14.73,5.03 17.3,4.08 19.22,4M4.15,17.54C5,18.38 5.96,18.5 6.47,18.5C7.16,18.5 7.69,18.24 7.86,18.07L9.7,16.22C9.19,16.39 8.66,16.5 8.11,16.55L7.63,16.59L7.17,16.95C6.64,17.36 6.36,17.5 6.08,17.5C5.77,17.5 5.37,17.35 5.05,17.03C4.5,16.47 4.41,15.88 4.97,15.33L6.32,13.97L6.61,14.25C6.62,13.95 6.66,13.66 6.71,13.36L4.15,15.93C3.59,16.5 3.29,16.69 4.15,17.54M21.56,2.46C21.56,2.46 19.37,0.28 11.32,8.34C9.75,9.91 8.5,11.77 7.6,13.87L10.14,16.41C12.24,15.5 14.1,14.26 15.66,12.68C23.72,4.63 21.56,2.46 21.56,2.46Z" Fill="#FFFFFF" Width="18" Height="18" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding [Loc_TransmissionProcessPriority], Source={x:Static services:LocalizationService.Instance}}" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding [Loc_ConfigureObsstreamlabsAtHighCpu], Source={x:Static services:LocalizationService.Instance}}" FontSize="11" Foreground="{DynamicResource TextSecondary}" Opacity="0.6" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                                
                                <CheckBox Grid.Column="2" IsChecked="{Binding HighPriorityStream}" Style="{DynamicResource PremiumCheckBoxStyle}" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <!-- Toggle 2: Network latency optimizer -->
                        <Border Style="{DynamicResource GlassCardStyle}" Margin="0,0,0,12" Padding="20">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                
                                <Border Width="40" Height="40" CornerRadius="10" Background="#1200FF94" Margin="0,0,16,0" BorderBrush="#2000FF94" BorderThickness="1">
                                    <Path Data="M12,21A8,8 0 0,0 20,13A8,8 0 0,0 12,5A8,8 0 0,0 4,13A8,8 0 0,0 12,21M12,19A6,6 0 0,1 6,13A6,6 0 0,1 12,7A6,6 0 0,1 18,13A6,6 0 0,1 12,19M12,17A4,4 0 0,0 16,13A4,4 0 0,0 12,9A4,4 0 0,0 8,13A4,4 0 0,0 12,17M12,15A2,2 0 0,1 10,13A2,2 0 0,1 12,11A2,2 0 0,1 14,13A2,2 0 0,1 12,15Z" Fill="#FFFFFF" Width="18" Height="18" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding [Loc_NetworkLatencyReductionMode], Source={x:Static services:LocalizationService.Instance}}" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding [Loc_PrioritizesStreamingPacketsInThe], Source={x:Static services:LocalizationService.Instance}}" FontSize="11" Foreground="{DynamicResource TextSecondary}" Opacity="0.6" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                                
                                <CheckBox Grid.Column="2" IsChecked="{Binding LowLatencyMode}" Style="{DynamicResource PremiumCheckBoxStyle}" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <!-- Toggle 3: Pause Windows Updates during live -->
                        <Border Style="{DynamicResource GlassCardStyle}" Margin="0,0,0,12" Padding="20">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                
                                <Border Width="40" Height="40" CornerRadius="10" Background="#12FF4B6B" Margin="0,0,16,0" BorderBrush="#20FF4B6B" BorderThickness="1">
                                    <Path Data="M12,2C17.5,2 22,6.5 22,12C22,17.5 17.5,22 12,22C6.5,22 2,17.5 2,12C2,6.5 6.5,2 12,2M12,4C7.58,4 4,7.58 4,12C4,16.42 7.58,20 12,20C16.42,20 20,16.42 20,12C20,7.58 16.42,4 12,4M15,16H9V8H15V16Z" Fill="#FFFFFF" Width="18" Height="18" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,10,0">
                                    <TextBlock Text="{Binding [Loc_SuspendWindowsUpdateOnBroadcast], Source={x:Static services:LocalizationService.Instance}}" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding [Loc_PausesWindowsUpdateServicesWuauserv], Source={x:Static services:LocalizationService.Instance}}" FontSize="11" Foreground="{DynamicResource TextSecondary}" Opacity="0.6" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                                
                                <CheckBox Grid.Column="2" IsChecked="{Binding DisableUpdateInStream}" Style="{DynamicResource PremiumCheckBoxStyle}" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <!-- Fine-tuning advanced settings panel -->
                        <Border Style="{DynamicResource GlassCardStyle}" Padding="20">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                
                                <Border Width="40" Height="40" CornerRadius="10" Background="#1200D4FF" Margin="0,0,16,0" BorderBrush="#2000D4FF" BorderThickness="1">
                                    <Path Data="M12,15.5A3.5,3.5 0 0,1 8.5,12A3.5,3.5 0 0,1 12,8.5A3.5,3.5 0 0,1 15.5,12A3.5,3.5 0 0,1 12,15.5M19.43,12.97C19.47,12.65 19.5,12.33 19.5,12C19.5,11.67 19.47,11.34 19.43,11L21.54,9.37C21.73,9.22 21.78,8.95 21.66,8.73L19.66,5.27C19.54,5.05 19.27,4.96 19.05,5.05L16.56,6.05C16.04,5.66 15.5,5.32 14.87,5.07L14.5,2.42C14.46,2.18 14.25,2 14,2H10C9.75,2 9.54,2.18 9.5,2.42L9.13,5.07C8.5,5.32 7.96,5.66 7.44,6.05L4.95,5.05C4.73,4.96 4.46,5.05 4.34,5.27L2.34,8.73C2.21,8.95 2.27,9.22 2.46,9.37L4.57,11C4.53,11.34 4.5,11.67 4.5,12C4.5,12.33 4.53,12.65 4.57,12.97L2.46,14.63C2.27,14.78 2.21,15.05 2.34,15.27L4.34,18.73C4.46,18.95 4.73,19.03 4.95,18.95L7.44,17.94C7.96,18.34 8.5,18.68 9.13,18.93L9.5,21.58C9.54,21.82 9.75,22 10,22H14C14.25,22 14.46,21.82 14.5,21.58L14.87,18.93C15.5,18.67 16.04,18.34 16.56,17.94L19.05,18.95C19.27,19.03 19.54,18.95 19.66,18.73L21.66,15.27C21.78,15.05 21.73,14.78 21.54,14.63L19.43,12.97Z" Fill="#FFFFFF" Width="18" Height="18" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,10,0">
                                    <TextBlock Text="{Binding [Loc_AdvancedIntegrationSettings], Source={x:Static services:LocalizationService.Instance}}" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding [Loc_ConfigureObsWebsocketPortsTwitchyoutube], Source={x:Static services:LocalizationService.Instance}}" FontSize="11" Foreground="{DynamicResource TextSecondary}" Opacity="0.6" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                                
                                <Button Grid.Column="2" Style="{DynamicResource SecondaryButtonStyle}" Content="{Binding [Loc_Configure], Source={x:Static services:LocalizationService.Instance}}" Command="{Binding OpenAdvancedSettingsCommand}" Padding="16,8" FontSize="11" HorizontalAlignment="Right"/>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- COLUMN 1: AI ASSISTANT, LIVE CHAT & TIMELINE (Right Side) -->
                    <Grid Grid.Column="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/> <!-- AI Suggestions Box -->
                            <RowDefinition Height="*"/>    <!-- Live Chat & Timeline Monitor -->
                        </Grid.RowDefinitions>

                        <!-- AI Suggestions Box -->
                        <Border Grid.Row="0" Style="{DynamicResource GlassCardStyle}" Padding="20" Margin="0,0,0,16">
                            <StackPanel>
                                <Border Background="#108B31FF" CornerRadius="10" Padding="14,10" Margin="0,0,0,14" BorderBrush="#258B31FF" BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock Text="{Binding [Loc_AiVoltrisSuggestion], Source={x:Static services:LocalizationService.Instance}}" FontSize="10" FontWeight="Black" Foreground="#8B31FF" Margin="0,0,0,6"/>
                                        <TextBlock Text="{Binding AiSuggestion}" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" LineHeight="17"/>
                                    </StackPanel>
                                </Border>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding [Loc_RapidHardwareOptimizations], Source={x:Static services:LocalizationService.Instance}}" FontSize="11" FontWeight="Bold" Foreground="#9CA3AF" Margin="0,0,0,4"/>
                                        <TextBlock Text="{Binding [Loc_FlushRamOrResetNetwork], Source={x:Static services:LocalizationService.Instance}}" FontSize="10" Foreground="#9CA3AF" Opacity="0.6" TextWrapping="Wrap"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <Button Style="{DynamicResource OutlineButtonStyle}" Content="{Binding [Loc_ClearRam], Source={x:Static services:LocalizationService.Instance}}" Command="{Binding EmergencyRamCleanupCommand}" Padding="10,6" Margin="0,0,6,0" FontSize="10"/>
                                        <Button Style="{DynamicResource OutlineButtonStyle}" Content="{Binding [Loc_OptimizeNetwork], Source={x:Static services:LocalizationService.Instance}}" Command="{Binding EmergencyNetworkResetCommand}" Padding="10,6" FontSize="10"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Tabbed / Double Panel for Live Chat & Timeline -->
                        <Border Grid.Row="1" Style="{DynamicResource GlassCardStyle}" Padding="20">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/> <!-- Title / Platform indicators -->
                                    <RowDefinition Height="*"/>    <!-- Scrollable content lists -->
                                </Grid.RowDefinitions>

                                <!-- Title and platform markers -->
                                <Grid Grid.Row="0" Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <TextBlock Text="{Binding [Loc_ChatEventMonitor], Source={x:Static services:LocalizationService.Instance}}" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" Grid.Column="0"/>
                                    
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <Ellipse Width="6" Height="6" Fill="#9146FF" Margin="0,0,4,0" ToolTip="{Binding [Loc_Twitch], Source={x:Static services:LocalizationService.Instance}}"/>
                                        <Ellipse Width="6" Height="6" Fill="#FF0000" Margin="4,0,4,0" ToolTip="{Binding [Loc_Youtube], Source={x:Static services:LocalizationService.Instance}}"/>
                                        <Ellipse Width="6" Height="6" Fill="#00FF94" Margin="4,0,0,0" ToolTip="{Binding [Loc_ObsStudio], Source={x:Static services:LocalizationService.Instance}}"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Scrollable lists side by side / split -->
                                <Grid Grid.Row="1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.2*"/> <!-- Chat Messages List -->
                                        <ColumnDefinition Width="*"/>    <!-- Highlight Moments Timeline -->
                                    </Grid.ColumnDefinitions>

                                    <!-- Left Side: Chat log list -->
                                    <Border Grid.Column="0" Background="#06FFFFFF" CornerRadius="8" BorderBrush="#15FFFFFF" BorderThickness="1" Padding="8" Margin="0,0,10,0">
                                        <Grid>
                                            <TextBlock Text="{Binding [Loc_WaitingForMessages], Source={x:Static services:LocalizationService.Instance}}" FontSize="11" Foreground="#9CA3AF" Opacity="0.5" 
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       Visibility="{Binding ChatMessages.Count, Converter={StaticResource IntToVisibilityConverter}, ConverterParameter=Invert}"/>
                                            
                                            <ListBox ItemsSource="{Binding ChatMessages}" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Margin="0,2,0,4">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/> <!-- Platform marker -->
                                                                <ColumnDefinition Width="*"/>    <!-- Message payload -->
                                                            </Grid.ColumnDefinitions>

                                                            <!-- Small dot matching the username color -->
                                                            <Border Width="6" Height="6" CornerRadius="3" Background="{Binding UsernameColor}" VerticalAlignment="Top" Margin="2,5,8,0" Grid.Column="0"/>

                                                            <TextBlock TextWrapping="Wrap" Grid.Column="1" FontSize="11" LineHeight="15">
                                                                <Run Text="{Binding DisplayName}" FontWeight="Bold" Foreground="{Binding UsernameColor}"/>
                                                                <Run Text=": " Foreground="#80FFFFFF"/>
                                                                <Run Text="{Binding Content}" Foreground="#F3F4F6"/>
                                                            </TextBlock>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>
                                        </Grid>
                                    </Border>

                                    <!-- Right Side: Highlight moments timeline -->
                                    <Border Grid.Column="1" Background="#06FFFFFF" CornerRadius="8" BorderBrush="#15FFFFFF" BorderThickness="1" Padding="8">
                                        <Grid>
                                            <TextBlock Text="{Binding [Loc_NoRecordedHighlights], Source={x:Static services:LocalizationService.Instance}}" FontSize="10" Foreground="#9CA3AF" Opacity="0.5" 
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       Visibility="{Binding Highlights.Count, Converter={StaticResource IntToVisibilityConverter}, ConverterParameter=Invert}"/>
                                            
                                            <ListBox ItemsSource="{Binding Highlights}" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Margin="0,2,0,6">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/> <!-- Icon -->
                                                                <ColumnDefinition Width="*"/>    <!-- Details -->
                                                            </Grid.ColumnDefinitions>

                                                            <TextBlock Text="{Binding TriggerIcon}" FontSize="13" VerticalAlignment="Top" Margin="0,0,8,0" Grid.Column="0"/>

                                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding Description}" FontSize="10" Foreground="#F3F4F6" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                                                <StackPanel Orientation="Horizontal" Margin="0,1,0,0">
                                                                    <TextBlock Text="{Binding [StreamTime], Source={x:Static services:LocalizationService.Instance}}" FontSize="9" Foreground="#9CA3AF" Opacity="0.6"/>
                                                                    <TextBlock Text="{Binding StreamTimestamp, StringFormat={}{0:hh\\:mm\\:ss}}" FontSize="9" Foreground="#00FF94" FontWeight="Bold"/>
                                                                </StackPanel>
                                                            </StackPanel>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
