<UserControl xmlns:services="clr-namespace:VoltrisOptimizer.Services" x:Class="VoltrisOptimizer.UI.Views.DisplayView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:VoltrisOptimizer.UI.Converters"
             Background="Transparent"
             UseLayoutRounding="True" SnapsToDevicePixels="True"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVis"/>
        <conv:InverseBooleanConverter x:Key="InverseBool"/>
        <conv:HexStringToBrushConverter x:Key="HexBrush"/>
        <Style x:Key="DCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource BgCardGlass}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderLight}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>
        <Style x:Key="MetricCard" TargetType="Border">
            <Setter Property="Background" Value="#0DFFFFFF"/>
            <Setter Property="BorderBrush" Value="#1AFFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="14,12"/>
        </Style>
        <Style x:Key="STitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource DefaultTextBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
        </Style>
        <Style x:Key="MetricVal" TargetType="TextBlock">
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource DefaultTextBrush}"/>
        </Style>
        <Style x:Key="MetricLbl" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
            <Setter Property="Margin" Value="0,3,0,0"/>
        </Style>
        <Style x:Key="ApplyBtn" TargetType="Button">
            <Setter Property="Background" Value="#1A31A8FF"/>
            <Setter Property="BorderBrush" Value="#3031A8FF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#31A8FF"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#2531A8FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <!-- Busy overlay -->
        <Grid Visibility="{Binding IsBusy, Converter={StaticResource BoolVis}}"
              Panel.ZIndex="99" Background="#80000000">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="🖥" FontSize="32" HorizontalAlignment="Center"/>
                <TextBlock Text="{Binding BusyMessage}" Foreground="{DynamicResource TextPrimaryBrush}"
                           FontSize="13" Margin="0,8,0,0" HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="24,20,24,24">

                <!-- ── HEADER ─────────────────────────────────────────────────── -->
                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource DisplayIcon}"
                                  Fill="#06B6D4" Width="22" Height="22" Stretch="Uniform"
                                  VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBlock Text="{Binding [Loc_Screen], Source={x:Static services:LocalizationService.Instance}}" FontSize="22" FontWeight="Bold"
                                       Foreground="{DynamicResource DefaultTextBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="{Binding [Loc_AdvancedDisplayControlCenterFar], Source={x:Static services:LocalizationService.Instance}}"
                                   Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="32,4,0,0"/>
                    </StackPanel>
                    <!-- Status + Monitor selector -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <ComboBox ItemsSource="{Binding Monitors}"
                                  SelectedItem="{Binding SelectedMonitor}"
                                  DisplayMemberPath="Name"
                                  MinWidth="180" Margin="0,0,10,0"
                                  ToolTip="{Binding [Loc_SelectTheMonitorToControl], Source={x:Static services:LocalizationService.Instance}}"
                                  Style="{DynamicResource ModernComboBoxStyle}"/>
                        <Border CornerRadius="8" Padding="10,6" Background="#1A000000" BorderThickness="1"
                                BorderBrush="{Binding StatusColor, Converter={StaticResource HexBrush}}">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="7" Height="7" VerticalAlignment="Center" Margin="0,0,6,0"
                                         Fill="{Binding StatusColor, Converter={StaticResource HexBrush}}"/>
                                <TextBlock Text="{Binding StatusMessage}" FontSize="11"
                                           Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- ── MÉTRICAS EM TEMPO REAL ─────────────────────────────────── -->
                <Border Style="{StaticResource DCard}">
                    <StackPanel>
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal">
                                <Path Data="M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2M12,4A8,8 0 0,1 20,12A8,8 0 0,1 12,20A8,8 0 0,1 4,12A8,8 0 0,1 12,4M12,6A6,6 0 0,0 6,12A6,6 0 0,0 12,18A6,6 0 0,0 18,12A6,6 0 0,0 12,6M12,8A4,4 0 0,1 16,12A4,4 0 0,1 12,16A4,4 0 0,1 8,12A4,4 0 0,1 12,8Z"
                                      Fill="#00FF88" Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="{Binding [Loc_RealtimeMetrics], Source={x:Static services:LocalizationService.Instance}}" Style="{StaticResource STitle}" Margin="0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button Content="{Binding [Loc_Start], Source={x:Static services:LocalizationService.Instance}}" Command="{Binding StartMonitoringCommand}"
                                        Style="{StaticResource ApplyBtn}" Margin="0,0,8,0"
                                        ToolTip="{Binding [Loc_StartsContinuousMonitoringOfDisplay], Source={x:Static services:LocalizationService.Instance}}"/>
                                <Button Content="{Binding [Loc_Stop], Source={x:Static services:LocalizationService.Instance}}" Command="{Binding StopMonitoringCommand}"
                                        Padding="16,8" Cursor="Hand" FontSize="12"
                                        ToolTip="{Binding [Loc_ForRealtimeMonitoring], Source={x:Static services:LocalizationService.Instance}}">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Background" Value="#1AFF4466"/>
                                            <Setter Property="BorderBrush" Value="#30FF4466"/>
                                            <Setter Property="BorderThickness" Value="1"/>
                                            <Setter Property="Foreground" Value="#FF4466"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                                CornerRadius="10" Padding="{TemplateBinding Padding}">
                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="bd" Property="Background" Value="#25FF4466"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </StackPanel>
                        </Grid>

                        <UniformGrid Columns="4" Margin="0,0,0,4">
                            <!-- Hz Real -->
                            <Border Style="{StaticResource MetricCard}" Margin="0,0,8,0">
                                <StackPanel>
                                    <TextBlock Text="{Binding CurrentHz, StringFormat={}{0:F0} Hz}"
                                               Style="{StaticResource MetricVal}"
                                               Foreground="{DynamicResource PrimaryBrush}"/>
                                    <TextBlock Text="{Binding [Loc_ActualUpdateRate], Source={x:Static services:LocalizationService.Instance}}" Style="{StaticResource MetricLbl}"/>
                                    <TextBlock Text="{Binding [Loc_CurrentMonitorFrequency], Source={x:Static services:LocalizationService.Instance}}" FontSize="9"
                                               Foreground="{DynamicResource TextMutedBrush}" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>
                            <!-- Input Lag -->
                            <Border Style="{StaticResource MetricCard}" Margin="0,0,8,0">
                                <StackPanel>
                                    <TextBlock Text="{Binding EstimatedInputLagMs, StringFormat={}{0:F2} ms}"
                                               Style="{StaticResource MetricVal}"
                                               Foreground="{Binding InputLagColor, Converter={StaticResource HexBrush}}"/>
                                    <TextBlock Text="{Binding [Loc_EstimatedInputLag], Source={x:Static services:LocalizationService.Instance}}" Style="{StaticResource MetricLbl}"/>
                                    <TextBlock Text="{Binding [Loc_LatencyPerFrame1000hz], Source={x:Static services:LocalizationService.Instance}}" FontSize="9"
                                               Foreground="{DynamicResource TextMutedBrush}" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>
                            <!-- Tearing -->
                            <Border Style="{StaticResource MetricCard}" Margin="0,0,8,0">
                                <StackPanel>
                                    <TextBlock FontSize="22" FontWeight="Bold"
                                               Text="{Binding TearingDetected}"
                                               Foreground="{Binding TearingColor, Converter={StaticResource HexBrush}}"/>
                                    <TextBlock Text="{Binding [Loc_Tearing], Source={x:Static services:LocalizationService.Instance}}" Style="{StaticResource MetricLbl}"/>
                                    <TextBlock Text="{Binding [Loc_BasedOnDwmState], Source={x:Static services:LocalizationService.Instance}}" FontSize="9"
                                               Foreground="{DynamicResource TextMutedBrush}" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>
                            <!-- Frame Pacing -->
                            <Border Style="{StaticResource MetricCard}">
                                <StackPanel>
                                    <TextBlock Text="{Binding FramePacingMs, StringFormat={}{0:F2} ms}"
                                               Style="{StaticResource MetricVal}"
                                               Foreground="{Binding StutterColor, Converter={StaticResource HexBrush}}"/>
                                    <TextBlock Text="{Binding [Loc_FramePacing], Source={x:Static services:LocalizationService.Instance}}" Style="{StaticResource MetricLbl}"/>
                                    <TextBlock Text="{Binding [Loc_VariationBetweenFrames], Source={x:Static services:LocalizationService.Instance}}" FontSize="9"
                                               Foreground="{DynamicResource TextMutedBrush}" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>
                    </StackPanel>
                </Border>

                <!-- ── CONTROLE AVANÇADO: Hz + Resolução ──────────────────────── -->
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Taxa de Atualização -->
                    <Border Grid.Column="0" Style="{StaticResource DCard}" Margin="0">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                <Path Data="M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2M16.2,16.2L11,13V7H12.5V12.2L17,14.9L16.2,16.2Z"
                                      Fill="#31A8FF" Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="{Binding [Loc_UpdateRate], Source={x:Static services:LocalizationService.Instance}}" Style="{StaticResource STitle}" Margin="0"/>
                            </StackPanel>
                            <TextBlock Text="{Binding [Loc_SelectTheRefreshRateSupported], Source={x:Static services:LocalizationService.Instance}}"
                                       Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,10"/>
                            <ComboBox ItemsSource="{Binding AvailableHz}"
                                      SelectedItem="{Binding SelectedHz}"
                                      Margin="0,0,0,12"
                                      ToolTip="{Binding [Loc_RefreshRatesSupportedByThe], Source={x:Static services:LocalizationService.Instance}}"
                                      Style="{DynamicResource ModernComboBoxStyle}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding StringFormat={}{0} Hz}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <Button Content="{Binding [Loc_ApplyRefreshRate], Source={x:Static services:LocalizationService.Instance}}"
                                    Command="{Binding ApplyRefreshRateCommand}"
                                    Style="{StaticResource ApplyBtn}"
                                    ToolTip="{Binding [Loc_AppliesTheRefreshRateSelected], Source={x:Static services:LocalizationService.Instance}}"/>
                            <TextBlock Text="{Binding [Loc_UnsupportedRatesWillBeAutomatically], Source={x:Static services:LocalizationService.Instance}}"
                                       Foreground="{DynamicResource TextMutedBrush}" FontSize="10" Margin="0,8,0,0"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <!-- Resolução -->
                    <Border Grid.Column="2" Style="{StaticResource DCard}" Margin="0">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                <Path Data="M1,1H23V17H13V19H15V21H9V19H11V17H1V1M3,3V15H21V3H3Z"
                                      Fill="#8B31FF" Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="{Binding [Loc_Resolution], Source={x:Static services:LocalizationService.Instance}}" Style="{StaticResource STitle}" Margin="0"/>
                            </StackPanel>
                            <TextBlock Text="{Binding [Loc_SelectTheDesiredResolution], Source={x:Static services:LocalizationService.Instance}}"
                                       Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,10"/>
                            <ComboBox ItemsSource="{Binding AvailableResolutions}"
                                      SelectedItem="{Binding SelectedResolution}"
                                      Margin="0,0,0,12"
                                      ToolTip="{Binding [Loc_ResolutionsSupportedByTheSelected], Source={x:Static services:LocalizationService.Instance}}"
                                      Style="{DynamicResource ModernComboBoxStyle}"/>
                            <Button Content="{Binding [Loc_ApplyResolution], Source={x:Static services:LocalizationService.Instance}}"
                                    Command="{Binding ApplyResolutionCommand}"
                                    Style="{StaticResource ApplyBtn}"
                                    ToolTip="{Binding [Loc_AppliesTheSelectedResolutionVia], Source={x:Static services:LocalizationService.Instance}}"/>
                            <TextBlock Text="{Binding [Loc_CustomResolutionsCanBeAdded], Source={x:Static services:LocalizationService.Instance}}"
                                       Foreground="{DynamicResource TextMutedBrush}" FontSize="10" Margin="0,8,0,0"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- ── VSync + Gamma ───────────────────────────────────────────── -->
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- VSync -->
                    <Border Grid.Column="0" Style="{StaticResource DCard}" Margin="0">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                <Path Data="M12,1L3,5V11C3,16.55 6.84,21.74 12,23C17.16,21.74 21,16.55 21,11V5L12,1Z"
                                      Fill="#00FF88" Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="{Binding [Loc_VerticalSyncVsync], Source={x:Static services:LocalizationService.Instance}}" Style="{StaticResource STitle}" Margin="0"/>
                            </StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{Binding [Loc_VsyncViaDwm], Source={x:Static services:LocalizationService.Instance}}" Foreground="{DynamicResource DefaultTextBrush}"
                                               FontSize="12" FontWeight="SemiBold"
                                               ToolTip="{Binding [Loc_ControlsVsyncThroughDwmDesktop], Source={x:Static services:LocalizationService.Instance}}"/>
                                    <TextBlock Text="{Binding [Loc_EliminatesTearingCanIncreaseInput], Source={x:Static services:LocalizationService.Instance}}"
                                               Foreground="{DynamicResource TextMutedBrush}" FontSize="10" Margin="0,3,0,0"/>
                                </StackPanel>
                                <CheckBox Grid.Column="1" IsChecked="{Binding VSyncEnabled}" VerticalAlignment="Center"
                                          Style="{StaticResource PremiumCheckBoxStyle}"/>
                            </Grid>
                            <TextBlock Text="{Binding [Loc_ForGamingPreferVsyncIn], Source={x:Static services:LocalizationService.Instance}}"
                                       Foreground="{DynamicResource TextMutedBrush}" FontSize="10" Margin="0,12,0,0"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <!-- Gamma -->
                    <Border Grid.Column="2" Style="{StaticResource DCard}" Margin="0">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                <Path Data="M12,6A6,6 0 0,0 6,12A6,6 0 0,0 12,18A6,6 0 0,0 18,12A6,6 0 0,0 12,6M12,16A4,4 0 0,1 8,12A4,4 0 0,1 12,8A4,4 0 0,1 16,12A4,4 0 0,1 12,16M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2Z"
                                      Fill="#FFAA00" Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="{Binding [Loc_Gammabrightness], Source={x:Static services:LocalizationService.Instance}}" Style="{StaticResource STitle}" Margin="0"/>
                            </StackPanel>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="50"/>
                                </Grid.ColumnDefinitions>
                                <Slider Minimum="0.5" Maximum="2.5" Value="{Binding PendingGammaValue, UpdateSourceTrigger=PropertyChanged}"
                                        TickFrequency="0.1" IsSnapToTickEnabled="True"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource ModernSlider}"
                                        ToolTip="{Binding [Loc_GammaAdjustmentViaWindowsColor], Source={x:Static services:LocalizationService.Instance}}"
                                        />
                                <TextBlock Grid.Column="1" Text="{Binding PendingGammaValue, StringFormat={}{0:F1}}"
                                           Foreground="{DynamicResource DefaultTextBrush}"
                                           FontSize="13" FontWeight="Bold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                            <Button Content="{Binding [Loc_ApplyGamma], Source={x:Static services:LocalizationService.Instance}}"
                                    Command="{Binding ApplyGammaCommand}"
                                    IsEnabled="{Binding ApplyGammaEnabled}"
                                    Style="{StaticResource ApplyBtn}"
                                    ToolTip="{Binding [Loc_ApplyGammaValueViaWindows], Source={x:Static services:LocalizationService.Instance}}"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- ── FERRAMENTAS DE TESTE ───────────────────────────────────── -->
                <Border Style="{StaticResource DCard}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                            <Path Data="M14.5,2.5C14.5,3.88 12,7 12,7C12,7 9.5,3.88 9.5,2.5A2.5,2.5 0 0,1 12,0A2.5,2.5 0 0,1 14.5,2.5M12,8C13.1,8 14,8.9 14,10C14,11.1 13.1,12 12,12C10.9,12 10,11.1 10,10C10,8.9 10.9,8 12,8M21,10C21,14.42 17.5,18.07 12.97,18.5L14,22H10L11.03,18.5C6.5,18.07 3,14.42 3,10A9,9 0 0,1 12,1A9,9 0 0,1 21,10Z"
                                  Fill="#FF4B6B" Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="{Binding [Loc_DiagnosticTools], Source={x:Static services:LocalizationService.Instance}}" Style="{StaticResource STitle}" Margin="0"/>
                        </StackPanel>
                        <TextBlock Text="{Binding [Loc_RunVisualTestsToDiagnose], Source={x:Static services:LocalizationService.Instance}}"
                                   Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,14"/>

                        <UniformGrid Columns="3" Margin="0,0,0,14">
                            <!-- Ghosting -->
                            <Border Background="#0DFFFFFF" BorderBrush="#1AFFFFFF" BorderThickness="1"
                                    CornerRadius="12" Padding="16,14" Margin="0,0,8,0">
                                <StackPanel>
                                    <Border Width="40" Height="40" CornerRadius="10" Background="#15FFAA00" BorderBrush="#30FFAA00" BorderThickness="1"
                                            HorizontalAlignment="Center" Margin="0,0,0,8">
                                        <Path Data="M3,3H21V5H3V3M3,7H15V9H3V7M3,11H21V13H3V11M3,15H17V17H3V15M3,19H9V21H3V19Z"
                                              Fill="#FFAA00" Width="22" Height="22" Stretch="Uniform"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="{Binding [Loc_GhostingTest], Source={x:Static services:LocalizationService.Instance}}" FontSize="12" FontWeight="SemiBold"
                                               HorizontalAlignment="Center" Margin="0,0,0,4"
                                               Foreground="{DynamicResource DefaultTextBrush}"/>
                                    <TextBlock Text="{Binding [Loc_DetectFastmovingTracksViaFrame], Source={x:Static services:LocalizationService.Instance}}"
                                               FontSize="10" Foreground="{DynamicResource TextMutedBrush}"
                                               TextWrapping="Wrap" HorizontalAlignment="Center" TextAlignment="Center"
                                               Margin="0,0,0,10"/>
                                    <Button Content="{Binding [Loc_RunTest], Source={x:Static services:LocalizationService.Instance}}"
                                            Command="{Binding RunGhostingTestCommand}"
                                            IsEnabled="{Binding IsTestRunning, Converter={StaticResource InverseBool}}"
                                            Style="{StaticResource ApplyBtn}" HorizontalAlignment="Center"
                                            ToolTip="{Binding [Loc_AnalyzesFramePacingToDetect], Source={x:Static services:LocalizationService.Instance}}"/>
                                    <Button Content="{Binding [Loc_Fix], Source={x:Static services:LocalizationService.Instance}}"
                                            Command="{Binding FixGhostingCommand}"
                                            Style="{StaticResource ApplyBtn}" HorizontalAlignment="Center" Margin="0,6,0,0"
                                            Visibility="{Binding HasGhostingProblem, Converter={StaticResource BoolVis}}"
                                            ToolTip="{Binding [Loc_FixGhostingIssue], Source={x:Static services:LocalizationService.Instance}}"/>
                                </StackPanel>
                            </Border>
                            <!-- Tearing -->
                            <Border Background="#0DFFFFFF" BorderBrush="#1AFFFFFF" BorderThickness="1"
                                    CornerRadius="12" Padding="16,14" Margin="0,0,8,0">
                                <StackPanel>
                                    <Border Width="40" Height="40" CornerRadius="10" Background="#15FF4466" BorderBrush="#30FF4466" BorderThickness="1"
                                            HorizontalAlignment="Center" Margin="0,0,0,8">
                                        <Path Data="M21,16H3V4H21V16M21,18H3A2,2 0 0,1 1,16V4A2,2 0 0,1 3,2H21A2,2 0 0,1 23,4V16A2,2 0 0,1 21,18M3,20H21V22H3V20Z"
                                              Fill="#FF4466" Width="22" Height="22" Stretch="Uniform"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="{Binding [Loc_TearingTest], Source={x:Static services:LocalizationService.Instance}}" FontSize="12" FontWeight="SemiBold"
                                               HorizontalAlignment="Center" Margin="0,0,0,4"
                                               Foreground="{DynamicResource DefaultTextBrush}"/>
                                    <TextBlock Text="{Binding [Loc_ChecksIfDwmCompositionIs], Source={x:Static services:LocalizationService.Instance}}"
                                               FontSize="10" Foreground="{DynamicResource TextMutedBrush}"
                                               TextWrapping="Wrap" HorizontalAlignment="Center" TextAlignment="Center"
                                               Margin="0,0,0,10"/>
                                    <Button Content="{Binding [Loc_RunTest], Source={x:Static services:LocalizationService.Instance}}"
                                            Command="{Binding RunTearingTestCommand}"
                                            IsEnabled="{Binding IsTestRunning, Converter={StaticResource InverseBool}}"
                                            Style="{StaticResource ApplyBtn}" HorizontalAlignment="Center"
                                            ToolTip="{Binding [Loc_ChecksDwmStatusToDetect], Source={x:Static services:LocalizationService.Instance}}"/>
                                    <Button Content="{Binding [Loc_Fix], Source={x:Static services:LocalizationService.Instance}}"
                                            Command="{Binding FixTearingCommand}"
                                            Style="{StaticResource ApplyBtn}" HorizontalAlignment="Center" Margin="0,6,0,0"
                                            Visibility="{Binding HasTearingProblem, Converter={StaticResource BoolVis}}"
                                            ToolTip="{Binding [Loc_FixTearingIssue], Source={x:Static services:LocalizationService.Instance}}"/>
                                </StackPanel>
                            </Border>
                            <!-- Input Lag -->
                            <Border Background="#0DFFFFFF" BorderBrush="#1AFFFFFF" BorderThickness="1"
                                    CornerRadius="12" Padding="16,14">
                                <StackPanel>
                                    <Border Width="40" Height="40" CornerRadius="10" Background="#1500D4FF" BorderBrush="#3000D4FF" BorderThickness="1"
                                            HorizontalAlignment="Center" Margin="0,0,0,8">
                                        <Path Data="M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2M12,20A8,8 0 0,1 4,12A8,8 0 0,1 12,4A8,8 0 0,1 20,12A8,8 0 0,1 12,20M12,6A6,6 0 0,0 6,12A6,6 0 0,0 12,18A6,6 0 0,0 18,12A6,6 0 0,0 12,6M11,7H12.5V12.25L17,14.92L16.25,16.15L11,13V7Z"
                                              Fill="#00D4FF" Width="22" Height="22" Stretch="Uniform"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="{Binding [Loc_InputLagTest], Source={x:Static services:LocalizationService.Instance}}" FontSize="12" FontWeight="SemiBold"
                                               HorizontalAlignment="Center" Margin="0,0,0,4"
                                               Foreground="{DynamicResource DefaultTextBrush}"/>
                                    <TextBlock Text="{Binding [Loc_EstimatesInputLagBasedOn], Source={x:Static services:LocalizationService.Instance}}"
                                               FontSize="10" Foreground="{DynamicResource TextMutedBrush}"
                                               TextWrapping="Wrap" HorizontalAlignment="Center" TextAlignment="Center"
                                               Margin="0,0,0,10"/>
                                    <Button Content="{Binding [Loc_RunTest], Source={x:Static services:LocalizationService.Instance}}"
                                            Command="{Binding RunInputLagTestCommand}"
                                            IsEnabled="{Binding IsTestRunning, Converter={StaticResource InverseBool}}"
                                            Style="{StaticResource ApplyBtn}" HorizontalAlignment="Center"
                                            ToolTip="{Binding [Loc_MeasuresEstimatedInputLagBased], Source={x:Static services:LocalizationService.Instance}}"/>
                                    <Button Content="{Binding [Loc_Fix], Source={x:Static services:LocalizationService.Instance}}"
                                            Command="{Binding FixInputLagCommand}"
                                            Style="{StaticResource ApplyBtn}" HorizontalAlignment="Center" Margin="0,6,0,0"
                                            Visibility="{Binding HasInputLagProblem, Converter={StaticResource BoolVis}}"
                                            ToolTip="{Binding [Loc_FixInputLagIssue], Source={x:Static services:LocalizationService.Instance}}"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <!-- Resultado do teste -->
                        <Border Background="#0DFFFFFF" BorderBrush="#1AFFFFFF" BorderThickness="1"
                                CornerRadius="10" Padding="14,10"
                                Visibility="{Binding IsTestRunning, Converter={StaticResource BoolVis}}">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="M6,2V8H6V8L10,12L6,16V16H6V22H18V16H18V16L14,12L18,8V8H18V2H6M16,16.5V20H8V16.5L12,12.5L16,16.5M12,11.5L8,7.5V4H16V7.5L12,11.5Z" Fill="#FFAA00" Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="{Binding TestResult}" FontSize="12"
                                           Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <Border Background="#0DFFFFFF" BorderBrush="#1AFFFFFF" BorderThickness="1"
                                CornerRadius="10" Padding="14,10" Margin="0,4,0,0">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="8" Height="8" VerticalAlignment="Center" Margin="0,0,8,0"
                                         Fill="{Binding TestResultColor, Converter={StaticResource HexBrush}}"/>
                                <TextBlock Text="{Binding TestResult}" FontSize="12"
                                           Foreground="{Binding TestResultColor, Converter={StaticResource HexBrush}}"
                                           VerticalAlignment="Center" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- ── RESTAURAR PADRÕES ───────────────────────────────────────── -->
                <Border Style="{StaticResource DCard}" Margin="0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding [Loc_RestoreDisplaySettings], Source={x:Static services:LocalizationService.Instance}}" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{DynamicResource DefaultTextBrush}"/>
                            <TextBlock Text="{Binding [Loc_RevertResolutionAndRefreshRate], Source={x:Static services:LocalizationService.Instance}}"
                                       Foreground="{DynamicResource TextMutedBrush}" FontSize="11" Margin="0,3,0,0"/>
                        </StackPanel>
                        <Button Grid.Column="1" Content="{Binding [Loc_RestoreDefaults], Source={x:Static services:LocalizationService.Instance}}"
                                Command="{Binding RestoreDefaultsCommand}"
                                Cursor="Hand" Padding="16,9" FontSize="12"
                                ToolTip="{Binding [Loc_RestoresDisplaySettingsToValues], Source={x:Static services:LocalizationService.Instance}}">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="#1AFF4466"/>
                                    <Setter Property="BorderBrush" Value="#30FF4466"/>
                                    <Setter Property="BorderThickness" Value="1"/>
                                    <Setter Property="Foreground" Value="#FF4466"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="bd" Background="{TemplateBinding Background}"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                        CornerRadius="10" Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="bd" Property="Background" Value="#25FF4466"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                        </Button>
                    </Grid>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
