<UserControl xmlns:services="clr-namespace:VoltrisOptimizer.Services"
             xmlns:converters="clr-namespace:VoltrisOptimizer.UI.Converters"
             x:Class="VoltrisOptimizer.UI.Views.DriversView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             Background="Transparent"
             UseLayoutRounding="True" SnapsToDevicePixels="True"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType"
             FontFamily="Segoe UI"
             d:DesignHeight="820" d:DesignWidth="1180">

    <UserControl.Resources>
        <converters:DriverStateToBrushConverter x:Key="StateBrush" />
        <converters:BoolToDimConverter x:Key="BoolDim" />
        <converters:ProgressToVisibilityConverter x:Key="ProgressVisible" />

        <!-- ===================== Design system (identidade VOLTRIS) ===================== -->
        <Style x:Key="DCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource BgCardGlass}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderLight}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="Padding" Value="20" />
        </Style>

        <Style x:Key="SecTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="ABtn" TargetType="Button">
            <Setter Property="Background" Value="#1AFFFFFF" />
            <Setter Property="Foreground" Value="{DynamicResource DefaultTextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderLight}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#2AFFFFFF" />
                                <Setter TargetName="bd" Property="BorderBrush" Value="#31A8FF" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.45" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PBtn" TargetType="Button" BasedOn="{StaticResource ABtn}">
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#4B6BFF" Offset="0" />
                        <GradientStop Color="#8B31FF" Offset="1" />
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <!-- Botão de ação da linha: NUNCA some. Quando desabilitado, apenas esmaece. -->
        <Style x:Key="ActionBtn" TargetType="Button" BasedOn="{StaticResource PBtn}">
            <Setter Property="Padding" Value="14,7" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="MinWidth" Value="112" />
            <Setter Property="Opacity" Value="{Binding IsActionEnabled, Converter={StaticResource BoolDim}}" />
            <Setter Property="Cursor" Value="Hand" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsTerminalSuccess}" Value="True">
                    <Setter Property="Background" Value="#1A00E58F" />
                    <Setter Property="Foreground" Value="#00E58F" />
                    <Setter Property="BorderBrush" Value="#4000E58F" />
                    <Setter Property="BorderThickness" Value="1" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsBusy}" Value="True">
                    <Setter Property="Cursor" Value="Wait" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      ScrollViewer.IsDeferredScrollingEnabled="False"
                      CanContentScroll="False"
                      PanningMode="VerticalOnly">
            <Grid Margin="24,20,24,24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- ============================ 1. HEADER ============================ -->
                <Grid Grid.Row="0" Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="0" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="42" Height="42" CornerRadius="12" Margin="0,0,16,0">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#4B6BFF" Offset="0" />
                                    <GradientStop Color="#8B31FF" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <Path Data="{StaticResource DriversIcon}" Fill="White" Width="21" Height="21"
                                  Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding [Loc_DriversUpdate], Source={x:Static services:LocalizationService.Instance}}"
                                       FontSize="24" FontWeight="Bold"
                                       Foreground="{DynamicResource DefaultTextBrush}"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding [Loc_RealtimeHardwareHealthMonitoring], Source={x:Static services:LocalizationService.Instance}}"
                                       FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                        <Button x:Name="BtnScan" Click="ScanButton_Click" MinWidth="120"
                                Content="{Binding [Loc_StartScan], Source={x:Static services:LocalizationService.Instance}}"
                                Style="{StaticResource ABtn}" Margin="0,0,10,0" Padding="16,10" />
                        <Button x:Name="BtnUpdateAll" Click="UpdateAllButton_Click" IsEnabled="False" MinWidth="130"
                                Content="{Binding [Loc_UpdateAll], Source={x:Static services:LocalizationService.Instance}}"
                                Style="{StaticResource PBtn}" Padding="18,10" />
                    </StackPanel>
                </Grid>

                <!-- ============================ 2. STATS ============================ -->
                <UniformGrid Grid.Row="1" Columns="3" Margin="0,0,0,16">
                    <Border Style="{StaticResource DCard}" Margin="0,0,6,0" Padding="18">
                        <StackPanel>
                            <TextBlock Text="{Binding [Loc_Devices], Source={x:Static services:LocalizationService.Instance}}"
                                       Style="{StaticResource SecTitle}" />
                            <TextBlock x:Name="TxtTotalDevices" Text="—"
                                       FontSize="22" FontWeight="Bold"
                                       Foreground="{DynamicResource DefaultTextBrush}" Margin="0,2,0,0" />
                            <TextBlock Text="{Binding [DriversPnpDetected], Source={x:Static services:LocalizationService.Instance}}"
                                       FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource DCard}" Margin="6,0" Padding="18">
                        <StackPanel>
                            <TextBlock Text="{Binding [Loc_Updates], Source={x:Static services:LocalizationService.Instance}}"
                                       Style="{StaticResource SecTitle}" />
                            <TextBlock x:Name="TxtUpdatesFound" Text="—"
                                       FontSize="22" FontWeight="Bold" Foreground="#31A8FF" Margin="0,2,0,0" />
                            <TextBlock Text="{Binding [DriversUpdatesChecked], Source={x:Static services:LocalizationService.Instance}}"
                                       FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource DCard}" Margin="6,0,0,0" Padding="18">
                        <StackPanel>
                            <TextBlock Text="{Binding [DriversIntegrity], Source={x:Static services:LocalizationService.Instance}}"
                                       Style="{StaticResource SecTitle}" />
                            <TextBlock x:Name="TxtHealthStatus" Text="—"
                                       FontSize="22" FontWeight="Bold" Foreground="#00E58F" Margin="0,2,0,0" />
                            <TextBlock Text="{Binding [DriversProblemDevices], Source={x:Static services:LocalizationService.Instance}}"
                                       FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <!-- ============================ 3. LISTA ============================ -->
                <Border Grid.Row="2" Style="{StaticResource DCard}" Padding="0" MinHeight="240">
                    <Grid>

                        <!-- Overlay de operação -->
                        <Grid x:Name="SpnlLoading" Visibility="Collapsed" Panel.ZIndex="20">
                            <Border Background="#B3000000" CornerRadius="16" />
                            <Border Background="#14FFFFFF" CornerRadius="14" Padding="28,20"
                                    HorizontalAlignment="Center" VerticalAlignment="Center"
                                    BorderBrush="{DynamicResource BorderLight}" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock x:Name="TxtLoadingIcon" Text="⚙" FontSize="32" TextAlignment="Center"
                                               Foreground="#8B31FF" Margin="0,0,0,10" />
                                    <TextBlock x:Name="TxtLoadingTitle" Text="{Binding [DriversProcessing], Source={x:Static services:LocalizationService.Instance}}" FontSize="15" FontWeight="Bold"
                                               Foreground="{DynamicResource DefaultTextBrush}" TextAlignment="Center" />
                                    <TextBlock Text="{Binding [DriversProgressHint], Source={x:Static services:LocalizationService.Instance}}"
                                               FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                                               TextAlignment="Center" Margin="0,6,0,0" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Estado vazio -->
                        <StackPanel x:Name="SpnlEmptyState" VerticalAlignment="Center" HorizontalAlignment="Center"
                                    Margin="24,48" MaxWidth="520">
                            <Path Data="{StaticResource DriversIcon}" Fill="{DynamicResource TextSecondaryBrush}"
                                  Opacity="0.35" Width="44" Height="44" Stretch="Uniform"
                                  HorizontalAlignment="Center" />
                            <TextBlock Text="{Binding [Loc_NoHardwareDataAvailable], Source={x:Static services:LocalizationService.Instance}}"
                                       Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,14,0,0"
                                       FontSize="14" TextAlignment="Center" TextWrapping="Wrap" />
                            <TextBlock x:Name="TxtEmptyMessage" Text="" Margin="0,8,0,0"
                                       Foreground="{DynamicResource TextMutedBrush}" FontSize="11"
                                       TextAlignment="Center" TextWrapping="Wrap" />
                            <Button Content="{Binding [Loc_StartScan], Source={x:Static services:LocalizationService.Instance}}"
                                    Style="{StaticResource PBtn}" Padding="20,9" Margin="0,18,0,0"
                                    HorizontalAlignment="Center" Click="ScanButton_Click" />
                        </StackPanel>

                        <!-- Lista de dispositivos -->
                        <ItemsControl x:Name="IcDevices" Margin="8,6,8,8"
                                      VirtualizingStackPanel.IsVirtualizing="True"
                                      VirtualizingStackPanel.VirtualizationMode="Recycling"
                                      ScrollViewer.CanContentScroll="True">
                            <ItemsControl.GroupStyle>
                                <GroupStyle>
                                    <GroupStyle.HeaderTemplate>
                                        <DataTemplate>
                                            <Grid Margin="12,14,12,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Height="1" Margin="0,0,12,0"
                                                        VerticalAlignment="Center" Opacity="0.25"
                                                        Background="{DynamicResource BorderLight}" />
                                                <TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="Bold" FontSize="10"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                                           Opacity="0.75" Typography.Capitals="AllSmallCaps" />
                                                <Border Grid.Column="2" Height="1" Margin="12,0,0,0"
                                                        VerticalAlignment="Center" Opacity="0.25"
                                                        Background="{DynamicResource BorderLight}" />
                                            </Grid>
                                        </DataTemplate>
                                    </GroupStyle.HeaderTemplate>
                                </GroupStyle>
                            </ItemsControl.GroupStyle>

                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="Transparent"
                                            BorderBrush="{DynamicResource BorderLight}"
                                            BorderThickness="0,0,0,1" Padding="12,11" CornerRadius="10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="44" />
                                                <ColumnDefinition Width="*" MinWidth="0" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <!-- ============ ÍCONE: camada base vetorial + ícone nativo por cima ============ -->
                                            <Border Grid.Column="0" Width="34" Height="34" CornerRadius="9"
                                                    Background="#15FFFFFF" VerticalAlignment="Top"
                                                    HorizontalAlignment="Left" Margin="0,1,0,0">
                                                <Path Data="{Binding CategoryIcon}" Stretch="Uniform"
                                                      Width="21" Height="21"
                                                      Fill="{DynamicResource PrimaryBrush}"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                                      ToolTip="{Binding DeviceName}" />
                                            </Border>

                                            <!-- ============ INFORMAÇÕES ============ -->
                                            <Grid Grid.Column="1" Margin="12,0,14,0">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>

                                                <!-- Nome + fabricante + categoria -->
                                                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,4">
                                                    <TextBlock Text="{Binding DeviceName}" FontSize="13" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource DefaultTextBrush}"
                                                               MaxWidth="420" TextTrimming="CharacterEllipsis"
                                                               ToolTip="{Binding DeviceName}" />
                                                    <Border Background="#20FFFFFF" CornerRadius="4" Padding="6,1" Margin="8,1,0,0"
                                                            VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Vendor}" FontSize="9"
                                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                                   FontWeight="Bold" MaxWidth="120"
                                                                   TextTrimming="CharacterEllipsis" />
                                                    </Border>
                                                </StackPanel>

                                                <!-- Status / progresso da operação -->
                                                <TextBlock Grid.Row="1" Text="{Binding EffectiveStatusText}" FontSize="11"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                                           TextWrapping="Wrap" MaxHeight="34" />

                                                <!-- Barra de progresso (somente quando há download/instalação) -->
                                                <StackPanel Grid.Row="2" Margin="0,6,0,0"
                                                            Visibility="{Binding ShowDownloadProgress, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <ProgressBar Grid.Column="0" Height="4" Minimum="0" Maximum="1"
                                                                     Value="{Binding DownloadProgress, Mode=OneWay}"
                                                                     IsIndeterminate="{Binding IsIndeterminateProgress}"
                                                                     Foreground="#8B31FF" Background="#18FFFFFF"
                                                                     BorderThickness="0" />
                                                        <TextBlock Grid.Column="1" Text="{Binding DownloadProgressText}" FontSize="9"
                                                                   Margin="8,0,0,0" VerticalAlignment="Center"
                                                                   Foreground="#8B31FF" MinWidth="30"
                                                                   TextAlignment="Right" />
                                                    </Grid>
                                                </StackPanel>

                                                <!-- Versões / datas / problema -->
                                                <Border Grid.Row="3" BorderBrush="#18FFFFFF" BorderThickness="0,1,0,0"
                                                        Padding="0,6,0,0" Margin="0,6,0,0">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>

                                                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                                            <TextBlock Text="{Binding [DriversManufacturer], Source={x:Static services:LocalizationService.Instance}}" Style="{StaticResource SecTitle}" />
                                                            <TextBlock Text="{Binding Provider}" FontSize="10" FontWeight="SemiBold"
                                                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                                                       Margin="0,1,0,0" TextTrimming="CharacterEllipsis" />
                                                        </StackPanel>

                                                        <StackPanel Grid.Column="1" Margin="0,0,10,0">
                                                            <TextBlock Text="{Binding [DriversInstalledVersion], Source={x:Static services:LocalizationService.Instance}}" Style="{StaticResource SecTitle}" />
                                                            <TextBlock Text="{Binding DriverVersion}" FontSize="10" FontWeight="SemiBold"
                                                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                                                       Margin="0,1,0,0" TextTrimming="CharacterEllipsis" />
                                                        </StackPanel>

                                                        <StackPanel Grid.Column="2" Margin="0,0,10,0"
                                                                    Visibility="{Binding ShowVersionBlock, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                            <TextBlock Text="{Binding [DriversAvailableVersion], Source={x:Static services:LocalizationService.Instance}}" Style="{StaticResource SecTitle}" />
                                                            <TextBlock Text="{Binding AvailableVersion}" FontSize="10" FontWeight="SemiBold"
                                                                       Foreground="#FFB020" Margin="0,1,0,0"
                                                                       TextTrimming="CharacterEllipsis" />
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>

                                                <!-- Fonte da informação (auditoria): nunca hide a procedência -->
                                                <Border Grid.Row="3" Margin="0,6,0,0"
                                                        Visibility="{Binding ProvenanceLabel, Converter={StaticResource StringToVisibilityConverter}}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Border Background="#14FFFFFF" CornerRadius="4" Padding="7,2" VerticalAlignment="Center">
                                                            <TextBlock FontSize="9" FontWeight="Bold"
                                                                       Foreground="{DynamicResource PrimaryBrush}"
                                                                       Text="{Binding ProvenanceLabel}" />
                                                        </Border>
                                                        <TextBlock Text="{Binding ProvenanceDetail}" FontSize="9" Margin="8,0,0,0"
                                                                   TextWrapping="Wrap" MaxHeight="30"
                                                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                                                    </StackPanel>
                                                </Border>

                                                <!-- Motivo real do problema (CM_PROB) -->
                                                <TextBlock Grid.Row="3" Margin="0,6,0,0" FontSize="10"
                                                           Foreground="#FF6B6B" TextWrapping="Wrap"
                                                           Text="{Binding ProblemDescription}"
                                                           Visibility="{Binding ProblemDescription, Converter={StaticResource StringToVisibilityConverter}}" />

                                                <!-- Auditoria: por que tem/não tem atualização -->
                                                <Border Grid.Row="3" Margin="0,6,0,0"
                                                        Visibility="{Binding AuditNote, Converter={StaticResource StringToVisibilityConverter}}">
                                                    <TextBlock Text="{Binding AuditNote}" FontSize="9" TextWrapping="Wrap"
                                                               MaxHeight="42" Foreground="{DynamicResource TextMutedBrush}" />
                                                </Border>
                                            </Grid>

                                            <!-- ============ AÇÕES ============ -->
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                <!-- Etiqueta de estado: cor derivada do enum, nunca de texto -->
                                                <Border x:Name="BrdTag" CornerRadius="6" Padding="9,4" Margin="0,0,8,0"
                                                        VerticalAlignment="Center"
                                                        Background="{Binding State, Converter={StaticResource StateBrush}, ConverterParameter=Background}">
                                                    <TextBlock Text="{Binding StateText}" FontSize="10" FontWeight="Bold"
                                                               Foreground="{Binding State, Converter={StaticResource StateBrush}}"
                                                               VerticalAlignment="Center" />
                                                </Border>

                                                <Button x:Name="BtnDetails" Click="DetailsButton_Click" Tag="{Binding}"
                                                        Content="{Binding [Loc_Details_2], Source={x:Static services:LocalizationService.Instance}}"
                                                        Style="{StaticResource ABtn}" Padding="10,6" FontSize="10"
                                                        MinWidth="64" Margin="0,0,6,0" VerticalAlignment="Center" />

                                                <!-- BOTÃO DE INSTALAÇÃO: sempre visível; o estado real define
                                                     texto, cor e habilitação. Nunca desaparece por binding. -->
                                                <Button x:Name="BtnInstall" Click="InstallButton_Click" Tag="{Binding}"
                                                        Content="{Binding ActionText}"
                                                        IsEnabled="{Binding IsActionEnabled}"
                                                        Style="{StaticResource ActionBtn}" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </Border>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
