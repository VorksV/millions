<UserControl xmlns:services="clr-namespace:VoltrisOptimizer.Services" 
             x:Class="VoltrisOptimizer.UI.Views.LicensePurchaseModal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             Background="Transparent"
             FontFamily="Segoe UI"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">

    <UserControl.Resources>
        <DropShadowEffect x:Key="PremiumShadow" BlurRadius="20" ShadowDepth="0" Opacity="0.35" Color="Black"/>
        
        <!-- Cores do Branding (DO DASHBOARD) -->
        <Color x:Key="ColorPrimary">#3b82f6</Color>
        <Color x:Key="ColorAccent1">#FF4B6B</Color>
        <Color x:Key="ColorAccent2">#8B31FF</Color>
        <Color x:Key="ColorAccent3">#31A8FF</Color>
        
        <SolidColorBrush x:Key="BrushPrimary" Color="{StaticResource ColorPrimary}"/>
        
        <!-- Smart Repair Gradient (STANDARD & ENTERPRISE) -->
        <LinearGradientBrush x:Key="SmartRepairGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#3B82F6" Offset="0"/>
            <GradientStop Color="#8B5CF6" Offset="1"/>
        </LinearGradientBrush>

        <!-- Main Gradient (PRO - ACCENT) -->
        <LinearGradientBrush x:Key="MainGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FF4B6B" Offset="0"/>
            <GradientStop Color="#8B31FF" Offset="0.5"/>
            <GradientStop Color="#31A8FF" Offset="1"/>
        </LinearGradientBrush>

        <!-- Modern Button Base (DO DASHBOARD) -->
        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource DarkPanelBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource DefaultTextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderLight}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="10" 
                                SnapsToDevicePixels="true">
                            <ContentPresenter x:Name="contentPresenter" 
                                              Focusable="False" 
                                              HorizontalAlignment="Center" 
                                              Margin="{TemplateBinding Padding}" 
                                              RecognizesAccessKey="True" 
                                              SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" 
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="true">
                                <Setter Property="Background" TargetName="border" Value="{DynamicResource BgHover}"/>
                                <Setter Property="BorderBrush" TargetName="border" Value="{StaticResource BrushPrimary}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="true">
                                <Setter Property="Background" TargetName="border" Value="#2AFFFFFF"/>
                                <Setter Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.98" ScaleY="0.98"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Smart Repair Button (STANDARD & ENTERPRISE) -->
        <Style x:Key="SmartRepairButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Background" Value="{StaticResource SmartRepairGradient}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="MinHeight" Value="34"/>
        </Style>

        <!-- Accent Button (PRO) -->
        <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Background" Value="{StaticResource MainGradient}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="MinHeight" Value="34"/>
        </Style>
    </UserControl.Resources>

    <!-- Fade-in animation -->
    <UserControl.Triggers>
        <EventTrigger RoutedEvent="Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.3">
                        <DoubleAnimation.EasingFunction>
                            <CubicEase EasingMode="EaseOut"/>
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </UserControl.Triggers>

    <!-- Root container para centralização -->
    <Grid Background="Transparent" ClipToBounds="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Modal Border - Profissional e Limpo -->
        <Border Grid.Row="1"
                x:Name="MainModalBorder"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Width="520"
                Background="{DynamicResource DarkPanelBrush}"
                BorderBrush="{DynamicResource BorderDefault}"
                BorderThickness="1"
                CornerRadius="16"
                Effect="{StaticResource PremiumShadow}"
                ClipToBounds="True">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- ╔════════════════════════════════════╗ -->
                <!-- ║ HEADER COM ÍCONE E TÍTULO          ║ -->
                <!-- ╚════════════════════════════════════╝ -->
                <Border Grid.Row="0" 
                        Padding="24,24,24,24"
                        BorderThickness="0,0,0,1"
                        BorderBrush="{DynamicResource BorderSubtle}"
                        Background="Transparent">
                    <Grid>
                        <!-- Content - CENTRALIZADO -->
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <!-- Lock Icon - CENTRALIZADO -->
                            <Border Width="64" Height="64"
                                    HorizontalAlignment="Center"
                                    Margin="0,0,0,16"
                                    CornerRadius="14"
                                    Background="{StaticResource VoltrisGradientBrush}"
                                    Effect="{StaticResource PremiumShadow}">
                                <Path Data="M12,17A2,2 0 0,0 14,15C14,13.89 13.1,13 12,13A2,2 0 0,0 10,15A2,2 0 0,0 12,17M18,8A2,2 0 0,1 20,10V20A2,2 0 0,1 18,22H6A2,2 0 0,1 4,20V10C4,8.89 4.9,8 6,8H7V6A5,5 0 0,1 12,1A5,5 0 0,1 17,6V8H18M12,3A3,3 0 0,0 9,6V8H15V6A3,3 0 0,0 12,3Z"
                                      Fill="White" Width="38" Height="38" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>

                            <!-- Title - Grande e Legível -->
                            <TextBlock Text="{Binding [LicenseModalTitle], Source={x:Static services:LocalizationService.Instance}}"
                                     FontSize="28" FontWeight="Bold" Foreground="White"
                                     TextAlignment="Center" TextWrapping="Wrap"
                                     Margin="0,0,0,8"/>

                            <!-- Subtitle -->
                            <TextBlock Text="{Binding [LicenseModalSubtitle], Source={x:Static services:LocalizationService.Instance}}"
                                     FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}"
                                     TextAlignment="Center" TextWrapping="Wrap"/>
                        </StackPanel>

                        <!-- Close Button - Positioned Absolutely at Top Right -->
                        <Button x:Name="CloseButton"
                                Width="24" Height="24"
                                Background="Transparent"
                                BorderThickness="0"
                                Cursor="Hand"
                                Click="CloseButton_Click"
                                Padding="0"
                                VerticalAlignment="Top"
                                HorizontalAlignment="Right"
                                Margin="0,0,0,0">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Path Data="M19,6.41L17.59,5L12,10.59L6.41,5L5,6.41L10.59,12L5,17.59L6.41,19L12,13.41L17.59,19L19,17.59L13.41,12L19,6.41Z"
                                          Fill="{DynamicResource TextSecondaryBrush}"
                                          Stretch="Uniform" Width="24" Height="24"/>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>
                </Border>

                <!-- ╔════════════════════════════════════╗ -->
                <!-- ║ PLANS CONTAINER - Sem Scroll       ║ -->
                <!-- ╚════════════════════════════════════╝ -->
                <StackPanel Grid.Row="1" Orientation="Vertical" Margin="24,0,24,24">

                    <!-- PLAN 1: STANDARD -->
                    <Border Margin="0,0,0,12"
                            CornerRadius="12"
                            BorderThickness="1"
                            BorderBrush="{DynamicResource BorderDefault}"
                            Background="{DynamicResource BgCardGlass}"
                            Padding="18,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="100"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                                <TextBlock Text="STANDARD" 
                                         FontSize="10" FontWeight="Bold" 
                                         Foreground="{StaticResource PrimaryBrush}"
                                         Margin="0,0,0,4"/>
                                <TextBlock Text="{Binding [LicensePlanStandardName], Source={x:Static services:LocalizationService.Instance}}"
                                         FontSize="15" FontWeight="SemiBold" Foreground="White"
                                         Margin="0,0,0,3"/>
                                <TextBlock Text="{Binding [LicensePlanStandardDesc], Source={x:Static services:LocalizationService.Instance}}"
                                         FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                                         TextWrapping="Wrap"/>
                            </StackPanel>

                            <Button Grid.Column="1"
                                    Style="{StaticResource SmartRepairButton}"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Right"
                                    Content="{Binding [LicenseChoose], Source={x:Static services:LocalizationService.Instance}}"
                                    Click="StandardPlan_Click"/>
                        </Grid>
                    </Border>

                    <!-- PLAN 2: PRO - DESTAQUE -->
                    <Border Margin="0,0,0,12"
                            CornerRadius="12"
                            BorderThickness="1.5"
                            BorderBrush="#FF4B6B"
                            Background="{DynamicResource DarkPanelBrush}"
                            Padding="18,16">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10" Height="18">
                                <TextBlock Text="⭐ PRO" 
                                         FontSize="11" FontWeight="Bold"
                                         Foreground="#FF4B6B"
                                         Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <Border Background="#26FF4B6B" CornerRadius="4" Padding="6,2">
                                    <TextBlock Text="{Binding [LicenseBadgeMostPopular], Source={x:Static services:LocalizationService.Instance}}"
                                             FontSize="9" FontWeight="Bold" Foreground="#FF4B6B"/>
                                </Border>
                            </StackPanel>

                            <Grid Margin="0,0,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="100"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                                    <TextBlock Text="{Binding [LicensePlanProName], Source={x:Static services:LocalizationService.Instance}}"
                                             FontSize="15" FontWeight="SemiBold" Foreground="White"
                                             Margin="0,0,0,3"/>
                                    <TextBlock Text="{Binding [LicensePlanProDesc], Source={x:Static services:LocalizationService.Instance}}"
                                             FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                                             TextWrapping="Wrap"/>
                                </StackPanel>

                                <Button Grid.Column="1"
                                        Style="{StaticResource AccentButton}"
                                        VerticalAlignment="Center"
                                        HorizontalAlignment="Right"
                                        Content="{Binding [LicenseChoose], Source={x:Static services:LocalizationService.Instance}}"
                                        Click="ProPlan_Click"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- PLAN 3: ENTERPRISE -->
                    <Border CornerRadius="12"
                            BorderThickness="1"
                            BorderBrush="{DynamicResource BorderDefault}"
                            Background="{DynamicResource BgCardGlass}"
                            Padding="18,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="100"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                                <TextBlock Text="ENTERPRISE"
                                         FontSize="10" FontWeight="Bold"
                                         Foreground="{StaticResource PrimaryBrush}"
                                         Margin="0,0,0,4"/>
                                <TextBlock Text="{Binding [LicensePlanEnterpriseName], Source={x:Static services:LocalizationService.Instance}}"
                                         FontSize="15" FontWeight="SemiBold" Foreground="White"
                                         Margin="0,0,0,3"/>
                                <TextBlock Text="{Binding [LicensePlanEnterpriseDesc], Source={x:Static services:LocalizationService.Instance}}"
                                         FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                                         TextWrapping="Wrap"/>
                            </StackPanel>

                            <Button Grid.Column="1"
                                    Style="{StaticResource SmartRepairButton}"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Right"
                                    Content="{Binding [LicenseChoose], Source={x:Static services:LocalizationService.Instance}}"
                                    Click="EnterprisePlan_Click"/>
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- ╔════════════════════════════════════╗ -->
                <!-- ║ FOOTER - Já possuo uma licença    ║ -->
                <!-- ╚════════════════════════════════════╝ -->
                <Border Grid.Row="2"
                        Padding="24,12"
                        BorderThickness="0,1,0,0"
                        BorderBrush="{DynamicResource BorderSubtle}"
                        Background="Transparent">
                    <Button x:Name="HaveLicenseButton"
                            Height="40"
                            Background="Transparent"
                            BorderThickness="1"
                            BorderBrush="{DynamicResource BorderDefault}"
                            Foreground="{DynamicResource TextSecondaryBrush}"
                            Cursor="Hand"
                            FontSize="12"
                            FontWeight="SemiBold"
                            Click="HaveLicenseButton_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="8">
                                    <StackPanel Orientation="Horizontal"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center">
                                        <Path Data="M7,14A2,2 0 0,0 5,16V20A2,2 0 0,0 7,22H17A2,2 0 0,0 19,20V16A2,2 0 0,0 17,14H16V12A4,4 0 0,0 12,8A4,4 0 0,0 8,12V14H7M9,12A2,2 0 0,1 11,10H13A2,2 0 0,1 15,12V14H9V12M12,17A1,1 0 0,1 13,18A1,1 0 0,1 12,19A1,1 0 0,1 11,18A1,1 0 0,1 12,17Z"
                                              Stretch="Uniform"
                                              Width="16" Height="16"
                                              Fill="{DynamicResource TextSecondaryBrush}"
                                              Margin="0,0,8,0"/>
                                        <TextBlock Text="{Binding [LicenseHaveKeyButton], Source={x:Static services:LocalizationService.Instance}}"
                                                 Foreground="{DynamicResource TextSecondaryBrush}"
                                                 VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource BgHover}"/>
                                        <Setter Property="BorderBrush" Value="{DynamicResource BorderHover}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
