<UserControl xmlns:services="clr-namespace:VoltrisOptimizer.Services" x:Class="VoltrisOptimizer.UI.Views.SchedulerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource DarkBrush}"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch">
    
    <UserControl.Triggers>
        <EventTrigger RoutedEvent="Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.4"/>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </UserControl.Triggers>
    
    <Grid>
        <!-- Background decorativo -->
        <Grid IsHitTestVisible="False" ClipToBounds="True">
            <Ellipse Width="400" Height="400" 
                     Fill="{DynamicResource AccentBlurBrush}"
                     HorizontalAlignment="Right" VerticalAlignment="Top"
                     Margin="0,-80,-150,0">
                <Ellipse.Effect>
                    <BlurEffect Radius="100"/>
                </Ellipse.Effect>
            </Ellipse>
            <Ellipse Width="300" Height="300" 
                     Fill="{DynamicResource PrimaryBlurBrush}"
                     HorizontalAlignment="Left" VerticalAlignment="Bottom"
                     Margin="-80,0,0,-80">
                <Ellipse.Effect>
                    <BlurEffect Radius="80"/>
                </Ellipse.Effect>
            </Ellipse>
        </Grid>
        
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid Margin="28,24,28,28">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                
                <!-- Header Centralizado -->
                <StackPanel Grid.Row="0" Margin="0,0,0,24" HorizontalAlignment="Center" Orientation="Horizontal">
                    <StackPanel.RenderTransform>
                        <TranslateTransform/>
                    </StackPanel.RenderTransform>
                    <StackPanel.Triggers>
                        <EventTrigger RoutedEvent="Loaded">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.5"/>
                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" From="-20" To="0" Duration="0:0:0.5">
                                        <DoubleAnimation.EasingFunction>
                                            <CubicEase EasingMode="EaseOut"/>
                                        </DoubleAnimation.EasingFunction>
                                    </DoubleAnimation>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </StackPanel.Triggers>
                    
                    <!-- Ícone moderno com gradiente -->
                    <Border Width="48" Height="48" CornerRadius="12" Margin="0,0,16,0" VerticalAlignment="Center">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#F59E0B" Offset="0"/>
                                <GradientStop Color="#EF4444" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="16" ShadowDepth="0" Color="#F59E0B" Opacity="0.5"/>
                        </Border.Effect>
                        <Path Data="M12,20A8,8 0 0,0 20,12A8,8 0 0,0 12,4A8,8 0 0,0 4,12A8,8 0 0,0 12,20M12,2A10,10 0 0,1 22,12A10,10 0 0,1 12,22C6.47,22 2,17.5 2,12A10,10 0 0,1 12,2M12.5,7V12.25L17,14.92L16.25,16.15L11,13V7H12.5Z" 
                              Fill="White"
                              Width="22" Height="22"
                              Stretch="Uniform"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"/>
                    </Border>
                    
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding [Loc_SmartScheduling], Source={x:Static services:LocalizationService.Instance}}"
                                  FontFamily="Segoe UI Variable Display, Segoe UI"
                                  FontSize="26"
                                  FontWeight="Bold">
                            <TextBlock.Foreground>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#F59E0B" Offset="0"/>
                                    <GradientStop Color="#EF4444" Offset="0.5"/>
                                    <GradientStop Color="#8B31FF" Offset="1"/>
                                </LinearGradientBrush>
                            </TextBlock.Foreground>
                        </TextBlock>
                        <TextBlock Text="{Binding [Loc_AutomateYourOptimizationsProfessionally], Source={x:Static services:LocalizationService.Instance}}"
                                  FontSize="12"
                                  Foreground="{DynamicResource TextSecondaryBrush}"
                                  Margin="0,4,0,0"/>
                    </StackPanel>
                </StackPanel>
                
                <!-- ============================================ -->
                <!-- CRIAR NOVA TAREFA -->
                <!-- ============================================ -->
                <Border Grid.Row="1" Margin="0,0,0,20">
                    <Border.Background>
                        <SolidColorBrush Color="{DynamicResource DarkPanelColor}"/>
                    </Border.Background>
                    <Border.BorderBrush>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#40F59E0B" Offset="0"/>
                            <GradientStop Color="#30EF4444" Offset="0.5"/>
                            <GradientStop Color="#208B31FF" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.BorderBrush>
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="BorderThickness" Value="1"/>
                            <Setter Property="CornerRadius" Value="18"/>
                            <Setter Property="Padding" Value="28,24"/>
                        </Style>
                    </Border.Style>
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="25" ShadowDepth="0" Color="#F59E0B" Opacity="0.15"/>
                    </Border.Effect>
                    
                    <StackPanel>
                        <!-- Header do Card -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,24">
                            <Border Width="44" Height="44" CornerRadius="12" Margin="0,0,16,0">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#10B981" Offset="0"/>
                                        <GradientStop Color="#059669" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="10" ShadowDepth="0" Color="#10B981" Opacity="0.4"/>
                                </Border.Effect>
                                <Path Data="M19,13H13V19H11V13H5V11H11V5H13V11H19V13Z" Fill="White" Width="20" Height="20" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding [Loc_CreateNewTask], Source={x:Static services:LocalizationService.Instance}}"
                                          FontWeight="Bold"
                                          FontSize="18"
                                          Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <TextBlock Text="{Binding [Loc_ConfigureWhenAndWhatTo], Source={x:Static services:LocalizationService.Instance}}"
                                          FontSize="12"
                                          Foreground="{DynamicResource TextMutedBrush}"
                                          Margin="0,2,0,0"/>
                            </StackPanel>
                        </StackPanel>
                        
                        <!-- Formulário -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            
                            <!-- Nome da Tarefa -->
                            <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,20">
                                <TextBlock Text="{Binding [Loc_TaskName], Source={x:Static services:LocalizationService.Instance}}"
                                          FontSize="13"
                                          FontWeight="SemiBold"
                                          Foreground="{DynamicResource TextSecondaryBrush}"
                                          Margin="0,0,0,10"/>
                                <TextBox x:Name="TaskNameTextBox"
                                        Style="{StaticResource ModernTextBoxStyle}"
                                        Height="48"
                                        FontSize="14"/>
                            </StackPanel>
                            
                            <!-- Tipo de Agendamento -->
                            <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,20">
                                <TextBlock Text="{Binding [Loc_Frequency], Source={x:Static services:LocalizationService.Instance}}"
                                          FontSize="13"
                                          FontWeight="SemiBold"
                                          Foreground="{DynamicResource TextSecondaryBrush}"
                                          Margin="0,0,0,10"/>
                                <ComboBox x:Name="ScheduleTypeComboBox"
                                         Style="{StaticResource ModernComboBoxStyle}"
                                         Height="48"
                                         FontSize="14"
                                         SelectionChanged="ScheduleTypeComboBox_SelectionChanged">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>
                            
                            <!-- Seleção de Horário -->
                            <StackPanel x:Name="TimePickerPanel" Grid.Row="1" Grid.Column="0" Margin="0,0,0,20">
                                <TextBlock Text="{Binding [Loc_ExecutionHours], Source={x:Static services:LocalizationService.Instance}}"
                                          FontSize="13"
                                          FontWeight="SemiBold"
                                          Foreground="{DynamicResource TextSecondaryBrush}"
                                          Margin="0,0,0,10"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <ComboBox x:Name="HourComboBox" Grid.Column="0"
                                             Style="{StaticResource ModernComboBoxStyle}"
                                             Height="48" MinWidth="90" FontSize="14"/>
                                    
                                    <TextBlock Grid.Column="1" Text=":" FontSize="22" FontWeight="Bold"
                                              Foreground="{DynamicResource PrimaryBrush}"
                                              VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                    
                                    <ComboBox x:Name="MinuteComboBox" Grid.Column="2"
                                             Style="{StaticResource ModernComboBoxStyle}"
                                             Height="48" MinWidth="90" FontSize="14"/>
                                </Grid>
                            </StackPanel>
                            
                            <!-- Seleção de Data (execução única) -->
                            <!-- Usa o mesmo padrão de ComboBoxes (Dia/Mês/Ano) já usado por
                                 Horário, evitando introduzir um DatePicker sem tema na UI escura. -->
                            <StackPanel x:Name="DatePickerPanel" Grid.Row="1" Grid.Column="0" Margin="0,0,0,20" Visibility="Collapsed">
                                <TextBlock Text="{Binding [Scheduler_ExecutionDate], Source={x:Static services:LocalizationService.Instance}}"
                                          FontSize="13"
                                          FontWeight="SemiBold"
                                          Foreground="{DynamicResource TextSecondaryBrush}"
                                          Margin="0,0,0,10"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <ComboBox x:Name="DayComboBox" Grid.Column="0"
                                             Style="{StaticResource ModernComboBoxStyle}"
                                             Height="48" MinWidth="70" FontSize="14"/>
                                    <ComboBox x:Name="MonthComboBox" Grid.Column="2"
                                             Style="{StaticResource ModernComboBoxStyle}"
                                             Height="48" MinWidth="150" FontSize="14"/>
                                    <ComboBox x:Name="YearComboBox" Grid.Column="4"
                                             Style="{StaticResource ModernComboBoxStyle}"
                                             Height="48" MinWidth="100" FontSize="14"/>
                                </Grid>
                            </StackPanel>
                            
                            <!-- Seleção de Dias (para Semanal) -->
                            <StackPanel x:Name="DaysPickerPanel" Grid.Row="1" Grid.Column="2" Margin="0,0,0,20" Visibility="Collapsed">
                                <TextBlock Text="{Binding [Loc_DaysOfTheWeek], Source={x:Static services:LocalizationService.Instance}}"
                                          FontSize="13"
                                          FontWeight="SemiBold"
                                          Foreground="{DynamicResource TextSecondaryBrush}"
                                          Margin="0,0,0,10"/>
                                <WrapPanel Orientation="Horizontal">
                                    <CheckBox x:Name="DaySun" Content="{Binding [Loc_Sun], Source={x:Static services:LocalizationService.Instance}}" Style="{StaticResource ModernCheckBoxStyle}" Margin="0,0,10,8" FontSize="12"/>
                                    <CheckBox x:Name="DayMon" Content="{Binding [Loc_Mon], Source={x:Static services:LocalizationService.Instance}}" Style="{StaticResource ModernCheckBoxStyle}" Margin="0,0,10,8" FontSize="12"/>
                                    <CheckBox x:Name="DayTue" Content="{Binding [Loc_Tue], Source={x:Static services:LocalizationService.Instance}}" Style="{StaticResource ModernCheckBoxStyle}" Margin="0,0,10,8" FontSize="12"/>
                                    <CheckBox x:Name="DayWed" Content="{Binding [Loc_Wed], Source={x:Static services:LocalizationService.Instance}}" Style="{StaticResource ModernCheckBoxStyle}" Margin="0,0,10,8" FontSize="12"/>
                                    <CheckBox x:Name="DayThu" Content="{Binding [Loc_Thu], Source={x:Static services:LocalizationService.Instance}}" Style="{StaticResource ModernCheckBoxStyle}" Margin="0,0,10,8" FontSize="12"/>
                                    <CheckBox x:Name="DayFri" Content="{Binding [Loc_Fri], Source={x:Static services:LocalizationService.Instance}}" Style="{StaticResource ModernCheckBoxStyle}" Margin="0,0,10,8" FontSize="12"/>
                                    <CheckBox x:Name="DaySat" Content="{Binding [Loc_Sat], Source={x:Static services:LocalizationService.Instance}}" Style="{StaticResource ModernCheckBoxStyle}" Margin="0,0,0,8" FontSize="12"/>
                                </WrapPanel>
                            </StackPanel>
                            
                            <!-- Seleção de Dias do Mês (para Mensal) -->
                            <StackPanel x:Name="MonthDayPickerPanel" Grid.Row="1" Grid.Column="2" Margin="0,0,0,20" Visibility="Collapsed">
                                <TextBlock Text="{Binding [Loc_DayOfTheMonth], Source={x:Static services:LocalizationService.Instance}}"
                                          FontSize="13"
                                          FontWeight="SemiBold"
                                          Foreground="{DynamicResource TextSecondaryBrush}"
                                          Margin="0,0,0,10"/>
                                <ItemsControl x:Name="MonthDaysPanel">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <CheckBox Content="{Binding}" Style="{StaticResource ModernCheckBoxStyle}"
                                                      Margin="0,0,6,6" FontSize="12"
                                                      IsChecked="{Binding IsChecked, Mode=TwoWay}"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                            
                            <!-- Ações a Executar -->
                            <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,0,0,24">
                                <TextBlock Text="{Binding [Loc_ActionsToTake], Source={x:Static services:LocalizationService.Instance}}"
                                          FontSize="13"
                                          FontWeight="SemiBold"
                                          Foreground="{DynamicResource TextSecondaryBrush}"
                                          Margin="0,0,0,14"/>
                                <UniformGrid Columns="3" Rows="3">
                                    <Border Height="80" Margin="0,0,10,10" Padding="14,12" CornerRadius="12" Cursor="Hand" MouseLeftButtonUp="ActionCleanup_Click">
                                        <Border.Style><Style TargetType="Border"><Setter Property="Background"><Setter.Value><SolidColorBrush Color="#10B981" Opacity="0.1"/></Setter.Value></Setter><Setter Property="BorderBrush"><Setter.Value><SolidColorBrush Color="#10B981" Opacity="0.3"/></Setter.Value></Setter><Setter Property="BorderThickness" Value="1"/><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background"><Setter.Value><SolidColorBrush Color="#10B981" Opacity="0.2"/></Setter.Value></Setter></Trigger></Style.Triggers></Style></Border.Style>
                                        <StackPanel HorizontalAlignment="Center">
                                            <Path Data="{StaticResource CleanupIcon}" Fill="White" Width="20" Height="20" Stretch="Uniform" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                                            <CheckBox x:Name="ActionCleanup" Content="{Binding [Loc_CleaningBasic], Source={x:Static services:LocalizationService.Instance}}" Style="{StaticResource ModernCheckBoxStyle}" FontSize="12" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Height="80" Margin="5,0,5,10" Padding="14,12" CornerRadius="12" Cursor="Hand" MouseLeftButtonUp="ActionDeepClean_Click">
                                        <Border.Style><Style TargetType="Border"><Setter Property="Background"><Setter.Value><SolidColorBrush Color="#059669" Opacity="0.1"/></Setter.Value></Setter><Setter Property="BorderBrush"><Setter.Value><SolidColorBrush Color="#059669" Opacity="0.3"/></Setter.Value></Setter><Setter Property="BorderThickness" Value="1"/><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background"><Setter.Value><SolidColorBrush Color="#059669" Opacity="0.2"/></Setter.Value></Setter></Trigger></Style.Triggers></Style></Border.Style>
                                        <StackPanel HorizontalAlignment="Center">
                                            <Path Data="{StaticResource CleanupIcon}" Fill="White" Width="20" Height="20" Stretch="Uniform" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                                            <CheckBox x:Name="ActionDeepClean" Content="{Binding [Loc_DeepCleaning], Source={x:Static services:LocalizationService.Instance}}" Style="{StaticResource ModernCheckBoxStyle}" FontSize="12" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Height="80" Margin="10,0,0,10" Padding="14,12" CornerRadius="12" Cursor="Hand" MouseLeftButtonUp="ActionPerformance_Click">
                                        <Border.Style><Style TargetType="Border"><Setter Property="Background"><Setter.Value><SolidColorBrush Color="#8B5CF6" Opacity="0.1"/></Setter.Value></Setter><Setter Property="BorderBrush"><Setter.Value><SolidColorBrush Color="#8B5CF6" Opacity="0.3"/></Setter.Value></Setter><Setter Property="BorderThickness" Value="1"/><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background"><Setter.Value><SolidColorBrush Color="#8B5CF6" Opacity="0.2"/></Setter.Value></Setter></Trigger></Style.Triggers></Style></Border.Style>
                                        <StackPanel HorizontalAlignment="Center">
                                            <Path Data="{StaticResource BoltIcon}" Fill="White" Width="20" Height="20" Stretch="Uniform" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                                            <CheckBox x:Name="ActionPerformance" Content="{Binding [Loc_Performance], Source={x:Static services:LocalizationService.Instance}}" Style="{StaticResource ModernCheckBoxStyle}" FontSize="12" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Height="80" Margin="0,0,10,0" Padding="14,12" CornerRadius="12" Cursor="Hand" MouseLeftButtonUp="ActionNetwork_Click">
                                        <Border.Style><Style TargetType="Border"><Setter Property="Background"><Setter.Value><SolidColorBrush Color="#3B82F6" Opacity="0.1"/></Setter.Value></Setter><Setter Property="BorderBrush"><Setter.Value><SolidColorBrush Color="#3B82F6" Opacity="0.3"/></Setter.Value></Setter><Setter Property="BorderThickness" Value="1"/><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background"><Setter.Value><SolidColorBrush Color="#3B82F6" Opacity="0.2"/></Setter.Value></Setter></Trigger></Style.Triggers></Style></Border.Style>
                                        <StackPanel HorizontalAlignment="Center">
                                            <Path Data="{StaticResource NetworkIcon}" Fill="White" Width="20" Height="20" Stretch="Uniform" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                                            <CheckBox x:Name="ActionNetwork" Content="{Binding [Loc_Network], Source={x:Static services:LocalizationService.Instance}}" Style="{StaticResource ModernCheckBoxStyle}" FontSize="12" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Height="80" Margin="5,0" Padding="14,12" CornerRadius="12" Cursor="Hand" MouseLeftButtonUp="ActionAdvanced_Click">
                                        <Border.Style><Style TargetType="Border"><Setter Property="Background"><Setter.Value><SolidColorBrush Color="#EF4444" Opacity="0.1"/></Setter.Value></Setter><Setter Property="BorderBrush"><Setter.Value><SolidColorBrush Color="#EF4444" Opacity="0.3"/></Setter.Value></Setter><Setter Property="BorderThickness" Value="1"/><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background"><Setter.Value><SolidColorBrush Color="#EF4444" Opacity="0.2"/></Setter.Value></Setter></Trigger></Style.Triggers></Style></Border.Style>
                                        <StackPanel HorizontalAlignment="Center">
                                            <Path Data="{StaticResource SettingsIcon}" Fill="White" Width="20" Height="20" Stretch="Uniform" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                                            <CheckBox x:Name="ActionAdvanced" Content="{Binding [Loc_Advanced], Source={x:Static services:LocalizationService.Instance}}" Style="{StaticResource ModernCheckBoxStyle}" FontSize="12" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Height="80" Margin="10,0,0,0" Padding="14,12" CornerRadius="12" Cursor="Hand" MouseLeftButtonUp="ActionRepair_Click">
                                        <Border.Style><Style TargetType="Border"><Setter Property="Background"><Setter.Value><SolidColorBrush Color="#F59E0B" Opacity="0.1"/></Setter.Value></Setter><Setter Property="BorderBrush"><Setter.Value><SolidColorBrush Color="#F59E0B" Opacity="0.3"/></Setter.Value></Setter><Setter Property="BorderThickness" Value="1"/><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background"><Setter.Value><SolidColorBrush Color="#F59E0B" Opacity="0.2"/></Setter.Value></Setter></Trigger></Style.Triggers></Style></Border.Style>
                                        <StackPanel HorizontalAlignment="Center">
                                            <Path Data="{StaticResource RepairIcon}" Fill="White" Width="20" Height="20" Stretch="Uniform" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                                            <CheckBox x:Name="ActionRepair" Content="{Binding [Loc_CompleteRepair_2], Source={x:Static services:LocalizationService.Instance}}" Style="{StaticResource ModernCheckBoxStyle}" FontSize="12" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Height="80" Margin="0,10,10,0" Padding="14,12" CornerRadius="12" Cursor="Hand" MouseLeftButtonUp="ActionGamer_Click">
                                        <Border.Style><Style TargetType="Border"><Setter Property="Background"><Setter.Value><SolidColorBrush Color="#8B5CF6" Opacity="0.1"/></Setter.Value></Setter><Setter Property="BorderBrush"><Setter.Value><SolidColorBrush Color="#8B5CF6" Opacity="0.3"/></Setter.Value></Setter><Setter Property="BorderThickness" Value="1"/><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background"><Setter.Value><SolidColorBrush Color="#8B5CF6" Opacity="0.2"/></Setter.Value></Setter></Trigger></Style.Triggers></Style></Border.Style>
                                        <StackPanel HorizontalAlignment="Center">
                                            <Path Data="{StaticResource BoltIcon}" Fill="White" Width="20" Height="20" Stretch="Uniform" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                                            <CheckBox x:Name="ActionGamer" Content="{Binding [Loc_GamerMode], Source={x:Static services:LocalizationService.Instance}}" Style="{StaticResource ModernCheckBoxStyle}" FontSize="12" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Height="80" Margin="5,10,5,0" Padding="14,12" CornerRadius="12" Cursor="Hand" MouseLeftButtonUp="ActionStream_Click">
                                        <Border.Style><Style TargetType="Border"><Setter Property="Background"><Setter.Value><SolidColorBrush Color="#EF4444" Opacity="0.1"/></Setter.Value></Setter><Setter Property="BorderBrush"><Setter.Value><SolidColorBrush Color="#EF4444" Opacity="0.3"/></Setter.Value></Setter><Setter Property="BorderThickness" Value="1"/><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background"><Setter.Value><SolidColorBrush Color="#EF4444" Opacity="0.2"/></Setter.Value></Setter></Trigger></Style.Triggers></Style></Border.Style>
                                        <StackPanel HorizontalAlignment="Center">
                                            <Path Data="{StaticResource NetworkIcon}" Fill="White" Width="20" Height="20" Stretch="Uniform" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                                            <CheckBox x:Name="ActionStream" Content="{Binding [Loc_StreamHub], Source={x:Static services:LocalizationService.Instance}}" Style="{StaticResource ModernCheckBoxStyle}" FontSize="12" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                </UniformGrid>
                            </StackPanel>
                            
                            <!-- Botão Adicionar -->
                            <Button Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3"
                                   Click="AddTaskButton_Click"
                                   MinHeight="56"
                                   FontSize="15"
                                   FontWeight="Bold"
                                   Cursor="Hand">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="border" CornerRadius="14" Padding="24,16">
                                                        <Border.Background>
                                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                                <GradientStop Color="#10B981" Offset="0"/>
                                                                <GradientStop Color="#059669" Offset="1"/>
                                                            </LinearGradientBrush>
                                                        </Border.Background>
                                                        <Border.Effect>
                                                            <DropShadowEffect BlurRadius="20" ShadowDepth="0" Color="#10B981" Opacity="0.4"/>
                                                        </Border.Effect>
                                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                            <Path Data="M19,13H13V19H11V13H5V11H11V5H13V11H19V13Z" Fill="#10B981" Width="18" Height="18" Stretch="Uniform" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding [Loc_AddScheduledTask], Source={x:Static services:LocalizationService.Instance}}" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimary}"/>
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="border" Property="Effect">
                                                <Setter.Value>
                                                    <DropShadowEffect BlurRadius="30" ShadowDepth="0" Color="#10B981" Opacity="0.6"/>
                                                </Setter.Value>
                                            </Setter>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                    </Style>
                </Button.Style>
            </Button>

            <!-- Botão Cancelar Edição (visível somente durante a edição) -->
            <Button x:Name="CancelEditButton"
                    Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3"
                    Click="CancelEditButton_Click"
                    Visibility="Collapsed"
                    Content="{Binding [Scheduler_EditTitle], Source={x:Static services:LocalizationService.Instance}}"
                    Style="{StaticResource NeonSecondaryButtonStyle}"
                    MinHeight="46"
                    Margin="0,10,0,0"
                    FontSize="14"
                    Cursor="Hand"/>
        </Grid>
    </StackPanel>
</Border>
                
                <!-- ============================================ -->
                <!-- LISTA DE TAREFAS AGENDADAS -->
                <!-- ============================================ -->
                <Border Grid.Row="2"
                        Background="{DynamicResource DarkPanelBrush}"
                        BorderBrush="{DynamicResource DarkBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="18"
                        Padding="24">
                    <Border.RenderTransform>
                        <TranslateTransform/>
                    </Border.RenderTransform>
                    <Border.Triggers>
                        <EventTrigger RoutedEvent="Loaded">
                            <BeginStoryboard>
                                <Storyboard BeginTime="0:0:0.2">
                                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.5"/>
                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" From="20" To="0" Duration="0:0:0.5">
                                        <DoubleAnimation.EasingFunction>
                                            <CubicEase EasingMode="EaseOut"/>
                                        </DoubleAnimation.EasingFunction>
                                    </DoubleAnimation>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </Border.Triggers>
                    
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        
                        <!-- Header da Lista -->
                        <Grid Grid.Row="0" Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            
                            <StackPanel Orientation="Horizontal">
                                <Border Width="44" Height="44" CornerRadius="12" Margin="0,0,16,0">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#3B82F6" Offset="0"/>
                                            <GradientStop Color="#1D4ED8" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="10" ShadowDepth="0" Color="#3B82F6" Opacity="0.4"/>
                                    </Border.Effect>
                                    <Path Data="{StaticResource SchedulerIcon}" Fill="White" Width="20" Height="20" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding [Loc_ScheduledTasks], Source={x:Static services:LocalizationService.Instance}}"
                                              FontWeight="Bold"
                                              FontSize="18"
                                              Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBlock x:Name="TaskCountText" Text="{Binding [Loc_0TasksConfigured], Source={x:Static services:LocalizationService.Instance}}"
                                              FontSize="12"
                                              Foreground="{DynamicResource TextMutedBrush}"
                                              Margin="0,2,0,0"/>
                                </StackPanel>
                            </StackPanel>
                            
                            <Button Grid.Column="1"
                                   Content="{Binding [Loc_Update_2], Source={x:Static services:LocalizationService.Instance}}"
                                   Style="{StaticResource NeonSecondaryButtonStyle}"
                                   MinHeight="44"
                                   Padding="20,0"
                                   Click="RefreshTasks_Click"/>
                        </Grid>
                        
                        <!-- Lista -->
                        <ScrollViewer Grid.Row="1"
                                    VerticalScrollBarVisibility="Auto"
                                    HorizontalScrollBarVisibility="Disabled">
                            <StackPanel x:Name="TasksContainer">
                                <!-- Mensagem quando não há tarefas -->
                                <Border x:Name="EmptyMessage"
                                       Background="{DynamicResource DarkHoverBrush}"
                                       CornerRadius="14"
                                       Padding="40,50"
                                       Visibility="Visible">
                                    <StackPanel HorizontalAlignment="Center">
                                        <Path Data="{StaticResource SchedulerIcon}" Fill="#0EA5E9" Width="48" Height="48" Stretch="Uniform" HorizontalAlignment="Center" Margin="0,0,0,16" Opacity="0.8"/>
                                        <TextBlock Text="{Binding [Loc_NoScheduledTasks], Source={x:Static services:LocalizationService.Instance}}"
                                                  FontSize="16"
                                                  FontWeight="SemiBold"
                                                  Foreground="{DynamicResource TextSecondaryBrush}"
                                                  HorizontalAlignment="Center"/>
                                        <TextBlock Text="{Binding [Loc_CreateYourFirstTaskUsing], Source={x:Static services:LocalizationService.Instance}}"
                                                  FontSize="13"
                                                  Foreground="{DynamicResource TextMutedBrush}"
                                                  HorizontalAlignment="Center"
                                                  Margin="0,6,0,0"/>
                                    </StackPanel>
                                </Border>
                                
                                <ItemsControl x:Name="TasksListBox">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
