                                <Setter Property="BorderBrush" Value="#2AFFFFFF"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#15FFFFFF"/>
                                        <Setter Property="BorderBrush" Value="#80FFFFFF"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>

                <!-- ========== DIAGNÓSTICO AVANÇADO ========== -->
                <Border Margin="0,0,0,24" Padding="1" CornerRadius="16">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#2AFFFFFF" Offset="0"/>
                            <GradientStop Color="#05FFFFFF" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="15" ShadowDepth="0" Color="Black" Opacity="0.4"/>
                    </Border.Effect>
                    <Border CornerRadius="15" Background="#0A000000" Padding="20">
                        <StackPanel>
                            <!-- Header -->
                            <Grid Margin="0,0,0,20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="40" Height="40" CornerRadius="10" Background="#1A31A8FF" Margin="0,0,16,0">
                                    <TextBlock Text="&#xE90F;" FontFamily="Segoe MDL2 Assets" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#FB923C"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding [GamerAdvDiagnosticsTitle], Source={x:Static services:LocalizationService.Instance}}"
                                              FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBlock Text="{Binding [GamerAdvDiagnosticsDesc], Source={x:Static services:LocalizationService.Instance}}"
                                              FontSize="13" Foreground="#94A3B8" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Grid>
                            
                            <!-- GPU Info -->
                            <Border Background="#05FFFFFF" BorderBrush="#1AFFFFFF" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="{Binding [Loc_Gpu], Source={x:Static services:LocalizationService.Instance}}" FontSize="11" Foreground="#94A3B8" Margin="0,0,0,6"/>
                                    <TextBlock Text="{Binding GpuInfoText}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,12"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        
                                        <Button Grid.Column="0" Content="{Binding [GamerOptimizeBtn], Source={x:Static services:LocalizationService.Instance}}" Command="{Binding OptimizeGpuCommand}" MinHeight="42" FontSize="12">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource ModernButtonStyle}">
                                                    <Setter Property="Background" Value="#0F000000"/>
                                                    <Setter Property="BorderThickness" Value="1"/>
                                                    <Setter Property="BorderBrush" Value="#2A31A8FF"/>
                                                    <Style.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="#1531A8FF"/>
                                                            <Setter Property="BorderBrush" Value="#8031A8FF"/>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                        <Button Grid.Column="2" Content="{Binding [GamerTemperatureBtn], Source={x:Static services:LocalizationService.Instance}}" Command="{Binding CheckGpuTempCommand}" MinHeight="42" FontSize="12">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource ModernButtonStyle}">
                                                    <Setter Property="Background" Value="#0F000000"/>
                                                    <Setter Property="BorderThickness" Value="1"/>
                                                    <Setter Property="BorderBrush" Value="#2AFFFFFF"/>
                                                    <Style.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="#15FFFFFF"/>
                                                            <Setter Property="BorderBrush" Value="#80FFFFFF"/>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </Grid>
                                    <TextBlock Text="{Binding GpuTempText}" Foreground="#10B981" FontSize="12" FontWeight="SemiBold" Margin="0,12,0,0" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            
                            <!-- Painel Térmico e Throttling -->
                            <Border Background="#05FFFFFF" BorderBrush="#1AFFFFFF" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,0,16">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <!-- CPU Temperature -->
                                    <StackPanel Grid.Column="0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding [GamerCpuTempLabel], Source={x:Static services:LocalizationService.Instance}}" FontSize="11" Foreground="#94A3B8"/>
                                            <TextBlock Text="~" FontSize="11" FontWeight="Bold" Foreground="#F59E0B" Margin="4,0,0,0" ToolTip="{Binding [GamerEstimatedTempTooltip], Source={x:Static services:LocalizationService.Instance}}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsTemperatureEstimated}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                        <TextBlock Text="{Binding CpuTemperature, StringFormat={}{0:F1}°C}" FontSize="18" FontWeight="Bold" Foreground="{Binding ThermalStatusColor}" Margin="0,4,0,0"/>
                                        <Border Height="4" Background="#0FFFFFFF" CornerRadius="2" Margin="0,8,0,0">
                                            <Border Width="{Binding CpuTemperature, Converter={StaticResource TemperatureToWidthConverter}}" HorizontalAlignment="Left" Background="{Binding ThermalStatusColor}" CornerRadius="2"/>
                                        </Border>
                                    </StackPanel>

                                    <!-- GPU Temperature -->
                                    <StackPanel Grid.Column="1" Margin="16,0">
                                        <TextBlock Text="{Binding [GamerGpuTempLabel], Source={x:Static services:LocalizationService.Instance}}" FontSize="11" Foreground="#94A3B8"/>
                                        <TextBlock Text="{Binding GpuTemperature, StringFormat={}{0:F1}°C}" FontSize="18" FontWeight="Bold" Foreground="{Binding ThermalStatusColor}" Margin="0,4,0,0"/>
                                        <Border Height="4" Background="#0FFFFFFF" CornerRadius="2" Margin="0,8,0,0">
                                            <Border Width="{Binding GpuTemperature, Converter={StaticResource TemperatureToWidthConverter}}" HorizontalAlignment="Left" Background="{Binding ThermalStatusColor}" CornerRadius="2"/>
                                        </Border>
                                    </StackPanel>

                                    <!-- Thermal Status -->
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="{Binding [GamerThermalStatusLabel], Source={x:Static services:LocalizationService.Instance}}" FontSize="11" Foreground="#94A3B8"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                            <Border Width="8" Height="8" CornerRadius="4" VerticalAlignment="Center" Background="{Binding ThermalStatusColor}"/>
                                            <TextBlock Text="{Binding ThermalStatus}" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" Margin="6,0,0,0" VerticalAlignment="Center" FontWeight="Bold"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding [GamerMonitoringActive], Source={x:Static services:LocalizationService.Instance}}" FontSize="9" FontWeight="Bold" Foreground="#10B981" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                            
                            <Button Content="{Binding [GamerOpenFullDiagBtn], Source={x:Static services:LocalizationService.Instance}}" Command="{Binding OpenDiagnosticsCommand}" MinHeight="48" FontSize="13">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource ModernButtonStyle}">
                                        <Setter Property="Background" Value="#0F000000"/>
                                        <Setter Property="BorderThickness" Value="1"/>
                                        <Setter Property="BorderBrush" Value="#2AFFFFFF"/>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#15FFFFFF"/>
                                                <Setter Property="BorderBrush" Value="#80FFFFFF"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </StackPanel>
                    </Border>
                </Border>


                <!-- ========== PERFORMANCE MONITOR ========== -->
                <Border Margin="0,0,0,24" Padding="1" CornerRadius="16">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#2AFFFFFF" Offset="0"/>
                            <GradientStop Color="#05FFFFFF" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="15" ShadowDepth="0" Color="Black" Opacity="0.4"/>
                    </Border.Effect>
                    <Border CornerRadius="15" Background="#0A000000" Padding="20">
                        <StackPanel>
                            <!-- Header -->
                            <Grid Margin="0,0,0,20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="40" Height="40" CornerRadius="10" Background="#1AFF4B6B" Margin="0,0,16,0">
                                    <TextBlock Text="&#xE9D2;" FontFamily="Segoe MDL2 Assets" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#FF4B6B"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding [GamerPerfMonitorTitle], Source={x:Static services:LocalizationService.Instance}}"
                                              FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBlock Text="{Binding [GamerPerfMonitorDesc], Source={x:Static services:LocalizationService.Instance}}"
                                              FontSize="13" Foreground="#94A3B8" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Grid>

                        <!-- Op&#231;&#227;o: Ligar com o Modo Gamer -->
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" 
                                      Text="{Binding [GamerAutoStartPerfMonitor], Source={x:Static services:LocalizationService.Instance}}"
                                      FontSize="13" FontWeight="Medium"
                                      Foreground="{DynamicResource TextPrimaryBrush}"
                                      VerticalAlignment="Center"
                                      TextWrapping="Wrap"
                                      ToolTip="{Binding [GamerAutoStartPerfMonitorTooltip], Source={x:Static services:LocalizationService.Instance}}"/>
                            <CheckBox Grid.Column="1"
                                     Style="{DynamicResource PremiumCheckBoxStyle}"
                                     IsChecked="{Binding OverlayAutoStartWithGamerMode, Mode=TwoWay}"
                                     VerticalAlignment="Center"
                                     Margin="12,0,0,0"
                                     ToolTip="{Binding [GamerAutoStartPerfMonitorTooltip], Source={x:Static services:LocalizationService.Instance}}"/>
                        </Grid>

                        <!-- Controle do Performance Monitor -->
                        <TextBlock Text="{Binding [GamerMonitorControlLabel], Source={x:Static services:LocalizationService.Instance}}" 
                                  FontSize="13" 
                                  FontWeight="SemiBold"
                                  Foreground="#A5B4FC" 
                                  Margin="0,0,0,10"/>
                        
                        <!-- Bot&#245;es Ativar/Desativar -->
                        <Grid Margin="0,0,0,18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <!-- Botão ATIVAR -->
                            <Button x:Name="BtnActivateOverlay"
                                    Grid.Column="0"
                                    Command="{Binding ActivateOverlayCommand}"
                                    IsEnabled="{Binding OverlayEnabled, Converter={StaticResource InverseBooleanConverter}}"
                                    Height="46"
                                    FontSize="14"
                                    FontWeight="Bold">
                                <Button.Background>
                                    <SolidColorBrush Color="#1A31A8FF"/>
                                </Button.Background>
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource ModernButtonStyle}">
                                        <Setter Property="Cursor" Value="Hand"/>
                                        <Setter Property="BorderThickness" Value="1"/>
                                        <Setter Property="BorderBrush" Value="#3031A8FF"/>
                                        <Style.Triggers>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter Property="Opacity" Value="0.5"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Path Data="{StaticResource PerformanceIcon}" Fill="#31A8FF" Margin="0,0,8,0" Width="16" Height="16" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding [GamerActivate], Source={x:Static services:LocalizationService.Instance}}" FontSize="14" FontWeight="Bold" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                </StackPanel>
                            </Button>

                            <!-- Botão DESATIVAR -->
                            <Button x:Name="BtnDeactivateOverlay"
                                    Grid.Column="2"
                                    Command="{Binding DeactivateOverlayCommand}"
                                    IsEnabled="{Binding OverlayEnabled}"
                                    Height="46"
                                    FontSize="14"
                                    FontWeight="Bold">
                                <Button.Background>
                                    <SolidColorBrush Color="#1AEF4444"/>
                                </Button.Background>
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource ModernButtonStyle}">
                                        <Setter Property="Cursor" Value="Hand"/>
                                        <Setter Property="BorderThickness" Value="1"/>
                                        <Setter Property="BorderBrush" Value="#30EF4444"/>
                                        <Style.Triggers>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter Property="Opacity" Value="0.5"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Path Data="{StaticResource IconError}" Fill="#EF4444" Margin="0,0,8,0" Width="16" Height="16" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding [GamerDeactivate], Source={x:Static services:LocalizationService.Instance}}" FontSize="14" FontWeight="Bold" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                </StackPanel>
                            </Button>
                        </Grid>

                        <!-- M&#233;tricas a exibir -->
                        <TextBlock Text="{Binding [GamerMetricsToShowLabel], Source={x:Static services:LocalizationService.Instance}}" 
                                  FontSize="13" 
                                  FontWeight="SemiBold"
                                  Foreground="#A5B4FC" 
                                  Margin="0,0,0,12"/>
                        
                        <UniformGrid Columns="2" Margin="0,0,0,18">
                            <!-- FPS -->
                            <Border Margin="0,0,12,12" Padding="12,10" CornerRadius="10" Background="#05FFFFFF" BorderThickness="1" BorderBrush="#1AFFFFFF">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="&#xE709;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="#10B981" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    <TextBlock Grid.Column="1" Text="{Binding [Loc_Spf], Source={x:Static services:LocalizationService.Instance}}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13" VerticalAlignment="Center" Margin="0,0,12,0" TextWrapping="Wrap"/>
                                    <CheckBox Grid.Column="2" IsChecked="{Binding OverlayShowFps, Mode=TwoWay}" Style="{DynamicResource PremiumCheckBoxStyle}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                </Grid>
                            </Border>

                            <!-- FrameTime -->
                            <Border Margin="12,0,0,12" Padding="12,10" CornerRadius="10" Background="#05FFFFFF" BorderThickness="1" BorderBrush="#1AFFFFFF">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="&#xE91E;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="#F59E0B" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    <TextBlock Grid.Column="1" Text="{Binding [GamerMetricFrameTime], Source={x:Static services:LocalizationService.Instance}}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13" VerticalAlignment="Center" Margin="0,0,12,0" TextWrapping="Wrap"/>
                                    <CheckBox Grid.Column="2" IsChecked="{Binding OverlayShowFrameTime, Mode=TwoWay}" Style="{DynamicResource PremiumCheckBoxStyle}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                </Grid>
                            </Border>

                            <!-- CPU % -->
                            <Border Margin="0,0,12,12" Padding="12,10" CornerRadius="10" Background="#05FFFFFF" BorderThickness="1" BorderBrush="#1AFFFFFF">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="&#xE945;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="#31A8FF" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    <TextBlock Grid.Column="1" Text="{Binding [GamerMetricCpu], Source={x:Static services:LocalizationService.Instance}}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13" VerticalAlignment="Center" Margin="0,0,12,0" TextWrapping="Wrap"/>
                                    <CheckBox Grid.Column="2" IsChecked="{Binding OverlayShowCpuUsage, Mode=TwoWay}" Style="{DynamicResource PremiumCheckBoxStyle}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                </Grid>
                            </Border>

                            <!-- GPU % -->
                            <Border Margin="12,0,0,12" Padding="12,10" CornerRadius="10" Background="#05FFFFFF" BorderThickness="1" BorderBrush="#1AFFFFFF">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="&#xE9D2;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="#8B31FF" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    <TextBlock Grid.Column="1" Text="{Binding [GamerMetricGpu], Source={x:Static services:LocalizationService.Instance}}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13" VerticalAlignment="Center" Margin="0,0,12,0" TextWrapping="Wrap"/>
                                    <CheckBox Grid.Column="2" IsChecked="{Binding OverlayShowGpuUsage, Mode=TwoWay}" Style="{DynamicResource PremiumCheckBoxStyle}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                </Grid>
                            </Border>

                            <!-- RAM % -->
                            <Border Margin="0,0,12,12" Padding="12,10" CornerRadius="10" Background="#05FFFFFF" BorderThickness="1" BorderBrush="#1AFFFFFF">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="&#xE105;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="#FF4B6B" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    <TextBlock Grid.Column="1" Text="{Binding [GamerMetricRam], Source={x:Static services:LocalizationService.Instance}}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13" VerticalAlignment="Center" Margin="0,0,12,0" TextWrapping="Wrap"/>
                                    <CheckBox Grid.Column="2" IsChecked="{Binding OverlayShowRamUsage, Mode=TwoWay}" Style="{DynamicResource PremiumCheckBoxStyle}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                </Grid>
                            </Border>

                            <!-- VRAM % -->
                            <Border Margin="12,0,0,12" Padding="12,10" CornerRadius="10" Background="#05FFFFFF" BorderThickness="1" BorderBrush="#1AFFFFFF">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="&#xE105;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="#FB923C" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    <TextBlock Grid.Column="1" Text="{Binding [GamerMetricVRam], Source={x:Static services:LocalizationService.Instance}}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13" VerticalAlignment="Center" Margin="0,0,12,0" TextWrapping="Wrap"/>
                                    <CheckBox Grid.Column="2" IsChecked="{Binding OverlayShowVramUsage, Mode=TwoWay}" Style="{DynamicResource PremiumCheckBoxStyle}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                </Grid>
                            </Border>

                            <!-- CPU Temp -->
                            <Border Margin="0,0,12,12" Padding="12,10" CornerRadius="10" Background="#05FFFFFF" BorderThickness="1" BorderBrush="#1AFFFFFF">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="&#xE945;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="#EF4444" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    <TextBlock Grid.Column="1" Text="{Binding [GamerMetricCpuTemp], Source={x:Static services:LocalizationService.Instance}}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13" VerticalAlignment="Center" Margin="0,0,12,0" TextWrapping="Wrap"/>
                                    <CheckBox Grid.Column="2" IsChecked="{Binding OverlayShowCpuTemp, Mode=TwoWay}" Style="{DynamicResource PremiumCheckBoxStyle}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                </Grid>
                            </Border>

                            <!-- GPU Temp -->
                            <Border Margin="12,0,0,12" Padding="12,10" CornerRadius="10" Background="#05FFFFFF" BorderThickness="1" BorderBrush="#1AFFFFFF">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="&#xE9D2;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="#EF4444" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    <TextBlock Grid.Column="1" Text="{Binding [GamerMetricGpuTemp], Source={x:Static services:LocalizationService.Instance}}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13" VerticalAlignment="Center" Margin="0,0,12,0" TextWrapping="Wrap"/>
                                    <CheckBox Grid.Column="2" IsChecked="{Binding OverlayShowGpuTemp, Mode=TwoWay}" Style="{DynamicResource PremiumCheckBoxStyle}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                </Grid>
                            </Border>

                            <!-- CPU Clock -->
                            <Border Margin="0,0,12,12" Padding="12,10" CornerRadius="10" Background="#05FFFFFF" BorderThickness="1" BorderBrush="#1AFFFFFF">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="&#xE945;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="#00D4FF" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    <TextBlock Grid.Column="1" Text="{Binding [GamerMetricCpuClock], Source={x:Static services:LocalizationService.Instance}}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13" VerticalAlignment="Center" Margin="0,0,12,0" TextWrapping="Wrap"/>
                                    <CheckBox Grid.Column="2" IsChecked="{Binding OverlayShowCpuClock, Mode=TwoWay}" Style="{DynamicResource PremiumCheckBoxStyle}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                </Grid>
                            </Border>

                            <!-- GPU Clock -->
                            <Border Margin="12,0,0,12" Padding="12,10" CornerRadius="10" Background="#05FFFFFF" BorderThickness="1" BorderBrush="#1AFFFFFF">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="&#xE9D2;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="#00D4FF" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    <TextBlock Grid.Column="1" Text="{Binding [GamerMetricGpuClock], Source={x:Static services:LocalizationService.Instance}}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13" VerticalAlignment="Center" Margin="0,0,12,0" TextWrapping="Wrap"/>
                                    <CheckBox Grid.Column="2" IsChecked="{Binding OverlayShowGpuClock, Mode=TwoWay}" Style="{DynamicResource PremiumCheckBoxStyle}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                </Grid>
                            </Border>

                            <!-- Latency -->
                            <Border Margin="0,0,12,0" Padding="12,10" CornerRadius="10" Background="#05FFFFFF" BorderThickness="1" BorderBrush="#1AFFFFFF">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="&#xE91E;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="#FF6B35" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    <TextBlock Grid.Column="1" Text="{Binding [GamerMetricLatency], Source={x:Static services:LocalizationService.Instance}}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13" VerticalAlignment="Center" Margin="0,0,12,0" TextWrapping="Wrap"/>
                                    <CheckBox Grid.Column="2" IsChecked="{Binding OverlayShowInputLatency, Mode=TwoWay}" Style="{DynamicResource PremiumCheckBoxStyle}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                </Grid>
                            </Border>
                        </UniformGrid>

                        <!-- Personaliza&#231;&#227;o Visual e Cores do Overlay -->
                        <TextBlock Text="{Binding [GamerVisualPersonalizationLabel], Source={x:Static services:LocalizationService.Instance}}" 
                                  FontSize="13" 
                                  FontWeight="SemiBold"
                                  Foreground="#A5B4FC" 
                                  Margin="0,0,0,12"/>
                        
                        <Grid Margin="0,0,0,18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{Binding [GamerHighlightTextColorLabel], Source={x:Static services:LocalizationService.Instance}}" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,6"/>
                                <ComboBox SelectedValue="{Binding OverlayTextColor, Mode=TwoWay}" SelectedValuePath="Tag" Height="36" Cursor="Hand" Padding="8,4">
                                    <ComboBoxItem Tag="#00E5FF">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="12" Height="12" Fill="#00E5FF" Margin="0,0,8,0"/>
                                            <TextBlock Text="{Binding [GamerColorCyan], Source={x:Static services:LocalizationService.Instance}}" Foreground="#00E5FF"/>
                                        </StackPanel>
                                    </ComboBoxItem>
                                    <ComboBoxItem Tag="#10B981">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="12" Height="12" Fill="#10B981" Margin="0,0,8,0"/>
                                            <TextBlock Text="{Binding [GamerColorNeonGreen], Source={x:Static services:LocalizationService.Instance}}" Foreground="#10B981"/>
                                        </StackPanel>
                                    </ComboBoxItem>
                                    <ComboBoxItem Tag="#EF4444">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="12" Height="12" Fill="#EF4444" Margin="0,0,8,0"/>
                                            <TextBlock Text="{Binding [GamerColorBloodRed], Source={x:Static services:LocalizationService.Instance}}" Foreground="#EF4444"/>
                                        </StackPanel>
                                    </ComboBoxItem>
                                    <ComboBoxItem Tag="#F59E0B">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="12" Height="12" Fill="#F59E0B" Margin="0,0,8,0"/>
                                            <TextBlock Text="{Binding [GamerColorVibrantOrange], Source={x:Static services:LocalizationService.Instance}}" Foreground="#F59E0B"/>
                                        </StackPanel>
                                    </ComboBoxItem>
                                    <ComboBoxItem Tag="#8B5CF6">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="12" Height="12" Fill="#8B5CF6" Margin="0,0,8,0"/>
                                            <TextBlock Text="{Binding [GamerColorGamerPurple], Source={x:Static services:LocalizationService.Instance}}" Foreground="#8B5CF6"/>
                                        </StackPanel>
                                    </ComboBoxItem>
                                    <ComboBoxItem Tag="#FFFFFF">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="12" Height="12" Fill="#FFFFFF" Margin="0,0,8,0"/>
                                            <TextBlock Text="{Binding [GamerColorPureWhite], Source={x:Static services:LocalizationService.Instance}}" Foreground="#FFFFFF"/>
                                        </StackPanel>
                                    </ComboBoxItem>
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="{Binding [GamerPanelBackgroundColorLabel], Source={x:Static services:LocalizationService.Instance}}" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,6"/>
                                <ComboBox SelectedValue="{Binding OverlayBackgroundColor, Mode=TwoWay}" SelectedValuePath="Tag" Height="36" Cursor="Hand" Padding="8,4">
                                    <ComboBoxItem Tag="#B2000000">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="12" Height="12" Fill="#000000" Opacity="0.5" Margin="0,0,8,0"/>
                                            <TextBlock Text="{Binding [GamerBgMatteBlack], Source={x:Static services:LocalizationService.Instance}}" Foreground="#8B31FF"/>
                                        </StackPanel>
                                    </ComboBoxItem>
                                    <ComboBoxItem Tag="#F2000000">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="12" Height="12" Fill="#000000" Margin="0,0,8,0"/>
                                            <TextBlock Text="{Binding [GamerBgSolidBlack], Source={x:Static services:LocalizationService.Instance}}" Foreground="#8B31FF"/>
                                        </StackPanel>
                                    </ComboBoxItem>
                                    <ComboBoxItem Tag="#B2111827">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="12" Height="12" Fill="#111827" Margin="0,0,8,0"/>
                                            <TextBlock Text="{Binding [GamerBgDarkBlue], Source={x:Static services:LocalizationService.Instance}}" Foreground="#8B31FF"/>
                                        </StackPanel>
                                    </ComboBoxItem>
                                    <ComboBoxItem Tag="#996D28D9">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="12" Height="12" Fill="#6D28D9" Margin="0,0,8,0"/>
                                            <TextBlock Text="{Binding [GamerBgDarkPurple], Source={x:Static services:LocalizationService.Instance}}" Foreground="#8B31FF"/>
                                        </StackPanel>
                                    </ComboBoxItem>
                                    <ComboBoxItem Tag="#00000000">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="12" Height="12" Fill="Transparent" Stroke="White" StrokeThickness="1" Margin="0,0,8,0"/>
                                            <TextBlock Text="{Binding [GamerBgInvisible], Source={x:Static services:LocalizationService.Instance}}" Foreground="#8B31FF"/>
                                        </StackPanel>
                                    </ComboBoxItem>
                                </ComboBox>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="{Binding BusyMessage}" 
                                  Foreground="#A5B4FC"
                                  FontSize="13" 
                                  Margin="0,12,0,0" 
                                  HorizontalAlignment="Center"
                                  TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </Border>

                <!-- ========== GAME OPTIMIZATION & REPAIR ========== -->
                <Border Margin="0,0,0,24" Padding="1" CornerRadius="16">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#2AFFFFFF" Offset="0"/>
                            <GradientStop Color="#05FFFFFF" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="15" ShadowDepth="0" Color="Black" Opacity="0.4"/>
                    </Border.Effect>
                    <Border CornerRadius="15" Background="#0A000000" Padding="20">
                        <StackPanel>
                            <!-- Header -->
                            <Grid Margin="0,0,0,20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="40" Height="40" CornerRadius="10" Background="#1A8B5CF6" Margin="0,0,16,0">
                                    <TextBlock Text="&#xE90F;" FontFamily="Segoe MDL2 Assets" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#FB923C"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding [GamerRepairTitle], Source={x:Static services:LocalizationService.Instance}}"
                                              FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBlock Text="{Binding [GamerRepairDesc], Source={x:Static services:LocalizationService.Instance}}"
                                              FontSize="13" Foreground="#94A3B8" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Grid>

                        <!-- Bot&#245;es de a&#231;&#227;o -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Botão DIAGNÓSTICO -->
                            <Button Grid.Column="0"
                                    Command="{Binding ScanGameErrorsCommand}"
                                    IsEnabled="{Binding CanStartGameRepair}"
                                    Height="48" Cursor="Hand">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource ModernButtonStyle}">
                                        <Setter Property="Background" Value="#1A8B31FF"/>
                                        <Setter Property="BorderThickness" Value="1"/>
                                        <Setter Property="BorderBrush" Value="#308B31FF"/>
                                    </Style>
                                </Button.Style>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <TextBlock Text="&#xE9D5;" FontFamily="Segoe MDL2 Assets" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center" Foreground="#8B31FF"/>
                                    <TextBlock Text="{Binding [GamerBtnDiagnose], Source={x:Static services:LocalizationService.Instance}}" FontSize="13" FontWeight="Bold" VerticalAlignment="Center" Foreground="White"/>
                                </StackPanel>
                            </Button>

                            <!-- Botão REPARAR AGORA -->
                            <Button Grid.Column="2"
                                    Command="{Binding RepairGameErrorsCommand}"
                                    IsEnabled="{Binding HasGameRepairIssues}"
                                    Height="48" Cursor="Hand">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource ModernButtonStyle}">
                                        <Setter Property="Background" Value="#1A10B981"/>
                                        <Setter Property="BorderThickness" Value="1"/>
                                        <Setter Property="BorderBrush" Value="#3010B981"/>
                                    </Style>
                                </Button.Style>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center" Foreground="#10B981"/>
                                    <TextBlock Text="{Binding [GamerBtnRepairNow], Source={x:Static services:LocalizationService.Instance}}" FontSize="13" FontWeight="Bold" VerticalAlignment="Center" Foreground="White"/>
                                </StackPanel>
                            </Button>

                            <!-- Botão CANCELAR -->
                            <Button Grid.Column="4"
                                    Command="{Binding CancelGameRepairCommand}"
                                    Height="48" Width="48" Cursor="Hand"
                                    ToolTip="{Binding [GamerCancelOperationTooltip], Source={x:Static services:LocalizationService.Instance}}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource ModernButtonStyle}">
                                        <Setter Property="Background" Value="#1AEF4444"/>
                                        <Setter Property="Foreground" Value="#EF4444"/>
                                        <Setter Property="BorderThickness" Value="1"/>
                                        <Setter Property="BorderBrush" Value="#30EF4444"/>
                                    </Style>
                                </Button.Style>
                                <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="#EF4444"/>
                            </Button>
                        </Grid>

                        <!-- Barra de progresso moderna -->
                        <Grid Margin="0,0,0,10"
                               Visibility="{Binding IsGameRepairScanning, Converter={StaticResource BoolToVis}}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" Padding="12,8" CornerRadius="8" 
                                   Background="#0A8B5CF6" BorderThickness="1" BorderBrush="#208B5CF6">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE9F3;" FontFamily="Segoe MDL2 Assets" FontSize="14" 
                                              Foreground="#8B5CF6" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding [GamerMsgAnalyzingSystem], Source={x:Static services:LocalizationService.Instance}}" FontSize="13" FontWeight="Medium"
                                              Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <ProgressBar Grid.Row="1" Height="8" Minimum="0" Maximum="100"
                                        Value="{Binding GameRepairProgress, Mode=OneWay}"
                                        Background="#1A1A1A" BorderThickness="0">
                                <ProgressBar.Foreground>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#8B5CF6" Offset="0"/>
                                        <GradientStop Color="#6366F1" Offset="1"/>
                                    </LinearGradientBrush>
                                </ProgressBar.Foreground>
                            </ProgressBar>
                        </Grid>

                        <!-- Status quando rodando reparo -->
                        <Grid Margin="0,0,0,10"
                               Visibility="{Binding IsGameRepairRunning, Converter={StaticResource BoolToVis}}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" Padding="12,8" CornerRadius="8" 
                                   Background="#0A10B981" BorderThickness="1" BorderBrush="#2010B981">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets" FontSize="14" 
                                              Foreground="#10B981" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding GameRepairStatus}" FontSize="13" FontWeight="Medium"
                                              Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <ProgressBar Grid.Row="1" Height="8" Minimum="0" Maximum="100"
                                        Value="{Binding GameRepairProgress, Mode=OneWay}"
                                        Background="#1A1A1A" BorderThickness="0">
                                <ProgressBar.Foreground>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#10B981" Offset="0"/>
                                        <GradientStop Color="#059669" Offset="1"/>
                                    </LinearGradientBrush>
                                </ProgressBar.Foreground>
                            </ProgressBar>
                        </Grid>

                        <!-- Relat&#243;rio / Status moderno -->
                        <Border Visibility="{Binding HasGameRepairReport, Converter={StaticResource BoolToVis}}"
                                Padding="16,12" CornerRadius="12" Margin="0,0,0,10"
                                BorderThickness="1">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="#0A10B981"/>
                                    <Setter Property="BorderBrush" Value="#2010B981"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding GameRepairAllOk}" Value="False">
                                            <Setter Property="Background" Value="#0AFFA500"/>
                                            <Setter Property="BorderBrush" Value="#20FFA500"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock FontSize="20" Margin="0,0,12,0" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="&#xE8FB;"/>
                                            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
                                            <Setter Property="Foreground" Value="#10B981"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding GameRepairAllOk}" Value="False">
                                                    <Setter Property="Text" Value="&#xE7BA;"/>
                                                    <Setter Property="Foreground" Value="#FFA500"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Text="{Binding GameRepairReport}"
                                          FontSize="14" FontWeight="Medium" Foreground="{DynamicResource TextPrimaryBrush}"
                                          TextWrapping="Wrap" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- Lista de problemas detectados -->
                        <ItemsControl ItemsSource="{Binding GameRepairIssues}"
                                      Visibility="{Binding HasGameRepairIssues, Converter={StaticResource BoolToVis}}"
                                      Margin="0,0,0,10">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="12,10" CornerRadius="10" Margin="0,0,0,8"
                                            Background="#0AFFFFFF" BorderThickness="1">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="BorderBrush" Value="#20FFA500"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Severity}" Value="Error">
                                                        <Setter Property="BorderBrush" Value="#20EF4444"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Severity}" Value="Info">
                                                        <Setter Property="BorderBrush" Value="#2031A8FF"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="Fixed">
                                                        <Setter Property="BorderBrush" Value="#4010B981"/>
                                                        <Setter Property="Background" Value="#0510B981"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" FontSize="16" Margin="0,0,12,0" VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
                                                        <Setter Property="Text" Value="&#xE946;"/>
                                                        <Setter Property="Foreground" Value="#FFA500"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Severity}" Value="Error">
                                                                <Setter Property="Text" Value="&#xE7BA;"/>
                                                                <Setter Property="Foreground" Value="#EF4444"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Severity}" Value="Info">
                                                                <Setter Property="Text" Value="&#xE946;"/>
                                                                <Setter Property="Foreground" Value="#31A8FF"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="Fixed">
                                                                <Setter Property="Text" Value="&#xE73E;"/>
                                                                <Setter Property="Foreground" Value="#10B981"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold"
                                                          Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                <TextBlock Text="{Binding Description}" FontSize="12"
                                                          Foreground="#A5B4FC"
                                                          TextWrapping="Wrap" Margin="0,3,0,0" Opacity="0.8"/>
                                                <TextBlock Text="{Binding FixDescription}" FontSize="12"
                                                          Foreground="#31A8FF" Margin="0,3,0,0"
                                                          Visibility="{Binding CanAutoFix, Converter={StaticResource BoolToVis}}"/>
                                            </StackPanel>
                                            <Border Grid.Column="2" Padding="8,4" CornerRadius="6" Margin="10,0,0,0" VerticalAlignment="Center">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="#20FFA500"/>
                                                        <Setter Property="BorderThickness" Value="0"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding CanAutoFix}" Value="True">
                                                                <Setter Property="Background" Value="#2010B981"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding FixTypeLabel}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Toggle: Scan autom&#225;tico ao iniciar jogos -->
                        <Border Padding="10,8" CornerRadius="8" Background="#08FFFFFF" BorderThickness="1"
                                BorderBrush="{DynamicResource BorderLight}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding [GamerAutoScanOnLaunch], Source={x:Static services:LocalizationService.Instance}}"
                                              FontSize="13" FontWeight="SemiBold"
                                              Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBlock Text="{Binding [GamerAutoScanOnLaunchDesc], Source={x:Static services:LocalizationService.Instance}}"
                                              FontSize="11" Foreground="#818CF8" Margin="0,2,0,0"/>
                                </StackPanel>
                                <CheckBox Grid.Column="1" Style="{DynamicResource PremiumCheckBoxStyle}"
                                          IsChecked="{Binding AutoScanOnGameStart, Mode=TwoWay}"
                                          VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </StackPanel>
                    </Border>
                </Border>


                
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Grid>
</UserControl>
