<UserControl xmlns:services="clr-namespace:VoltrisOptimizer.Services" xmlns:license="clr-namespace:VoltrisOptimizer.Services.License" x:Class="VoltrisOptimizer.UI.Views.GamerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:VoltrisOptimizer.UI.ViewModels"
             xmlns:controls="clr-namespace:VoltrisOptimizer.UI.Controls"
             xmlns:converters="clr-namespace:VoltrisOptimizer.UI.Converters"
             Background="{DynamicResource DarkBrush}">
    <UserControl.DataContext>
        <Binding Source="{StaticResource Locator}" Path="GamerVM" />
    </UserControl.DataContext>
    
<UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/UI/Themes/Converters.xaml" />
            </ResourceDictionary.MergedDictionaries>
            
            <!-- Cores do Branding (Dashboard Style) -->
            <Color x:Key="ColorPrimary">#3b82f6</Color>
            <Color x:Key="ColorAccent1">#FF4B6B</Color>
            <Color x:Key="ColorAccent2">#8B31FF</Color>
            <Color x:Key="ColorAccent3">#31A8FF</Color>
            
            <SolidColorBrush x:Key="BrushPrimary" Color="{StaticResource ColorPrimary}"/>
            <SolidColorBrush x:Key="BrushAccent1" Color="{StaticResource ColorAccent1}"/>
            <SolidColorBrush x:Key="BrushAccent2" Color="{StaticResource ColorAccent2}"/>
            <SolidColorBrush x:Key="BrushAccent3" Color="{StaticResource ColorAccent3}"/>
            
            <!-- Gradientes de Marca -->
            <LinearGradientBrush x:Key="MainGradient" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#FF4B6B" Offset="0"/>
                <GradientStop Color="#8B31FF" Offset="0.5"/>
                <GradientStop Color="#31A8FF" Offset="1"/>
            </LinearGradientBrush>
            
            <!-- Converter para visibilidade booleana -->
            <BooleanToVisibilityConverter x:Key="BoolToVis"/>
            <!-- Converter para booleano inverso -->
            <converters:InverseBooleanConverter x:Key="InverseBooleanConverter"/>
            
            <!-- Converters para status do Modo Gamer -->
            <converters:BoolToColorConverter x:Key="BoolToColorConverter"/>
            <converters:BoolToStatusIconConverter x:Key="BoolToStatusIconConverter"/>
            <converters:BoolToStatusTextConverter x:Key="BoolToStatusTextConverter"/>
            
            <!-- Converter para temperatura -->
            <converters:TemperatureToWidthConverter x:Key="TemperatureToWidthConverter"/>
            
            <!-- Glass Card Style (Dashboard Style) -->
            <Style x:Key="GlassCardStyle" TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource BgCardGlass}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource BorderLight}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="16"/>
                <Setter Property="Padding" Value="24"/>
                <Setter Property="Margin" Value="0,0,0,16"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="BorderBrush" Value="{DynamicResource BorderAccent}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
            
            <!-- Estilo de Header de Seção (StackPanel Style) -->
            <Style x:Key="SectionHeaderStyle" TargetType="StackPanel">
                <Setter Property="Orientation" Value="Horizontal"/>
                <Setter Property="Margin" Value="0,0,0,16"/>
            </Style>
            
            <!-- Estilo de Ícone de Seção -->
            <Style x:Key="SectionIconStyle" TargetType="Border">
                <Setter Property="Width" Value="40"/>
                <Setter Property="Height" Value="40"/>
                <Setter Property="CornerRadius" Value="10"/>
                <Setter Property="Margin" Value="0,0,12,0"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
            
            <!-- Estilos existentes para compatibilidade -->
            <Style x:Key="SectionCardStyle" TargetType="Border" BasedOn="{StaticResource GlassCardStyle}">
                <Setter Property="Background" Value="{DynamicResource CardGradientBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource BorderGradientBrush}"/>
                <Setter Property="Effect">
                    <Setter.Value>
                        <DropShadowEffect BlurRadius="24" ShadowDepth="0" Opacity="0.2" Color="Black"/>
                    </Setter.Value>
                </Setter>
            </Style>
            
            <Style x:Key="CompactCardStyle" TargetType="Border" BasedOn="{StaticResource SectionCardStyle}">
                <Setter Property="Padding" Value="16"/>
                <Setter Property="CornerRadius" Value="12"/>
            </Style>
            
            <Style x:Key="GamerCardStyle" TargetType="Border" BasedOn="{StaticResource SectionCardStyle}">
                <Setter Property="Padding" Value="14"/>
                <Setter Property="Margin" Value="0,0,0,16"/>
            </Style>
            
            <!-- Estilo de Botão Responsivo (para compatibilidade) -->
            <Style x:Key="ResponsiveGamerButtonStyle" TargetType="Button" BasedOn="{StaticResource ModernGamerButton}">
                <Setter Property="Height" Value="52"/>
                <Setter Property="MinWidth" Value="180"/>
                <Setter Property="Margin" Value="0,0,0,12"/>
                <Setter Property="HorizontalAlignment" Value="Stretch"/>
                <Setter Property="FontSize" Value="15"/>
                <Setter Property="FontWeight" Value="Bold"/>
            </Style>
            
            <!-- Modern Button (Dashboard Style) -->
            <Style x:Key="ModernGamerButton" TargetType="Button">
                <Setter Property="Background" Value="{DynamicResource DarkPanelBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource DefaultTextBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource BorderLight}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="20,10"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="border" Background="{TemplateBinding Background}" 
                                    BorderBrush="{TemplateBinding BorderBrush}" 
                                    BorderThickness="{TemplateBinding BorderThickness}" 
                                    CornerRadius="10" 
                                    SnapsToDevicePixels="true">
                                <ContentPresenter x:Name="contentPresenter" Focusable="False" 
                                                  HorizontalAlignment="Center" 
                                                  Margin="{TemplateBinding Padding}" 
                                                  RecognizesAccessKey="True" 
                                                  SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" 
                                                  VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="true">
                                    <Setter Property="Background" TargetName="border" Value="{DynamicResource BgHover}"/>
                                    <Setter Property="BorderBrush" TargetName="border" Value="{StaticResource BrushPrimary}"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="true">
                                    <Setter Property="Background" TargetName="border" Value="#2AFFFFFF"/>
                                    <Setter Property="RenderTransform">
                                        <Setter.Value>
                                            <ScaleTransform ScaleX="0.98" ScaleY="0.98"/>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            
            <!-- Accent Button (Gradient) -->
            <Style x:Key="AccentGamerButton" TargetType="Button" BasedOn="{StaticResource ModernGamerButton}">
                <Setter Property="Background" Value="{StaticResource MainGradient}"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="FontWeight" Value="Bold"/>
            </Style>
            
            <!-- Ícones (Dashboard Style) -->
            <Geometry x:Key="IconGamer">M21,6H3A2,2 0 0,0 1,8V16A2,2 0 0,0 3,18H21A2,2 0 0,0 23,16V8A2,2 0 0,0 21,6M21,16H3V8H21M6,15H8V13H10V11H8V9H6V11H4V13H6M14.5,12A1.5,1.5 0 0,1 16,13.5A1.5,1.5 0 0,1 14.5,15A1.5,1.5 0 0,1 13,13.5A1.5,1.5 0 0,1 14.5,12M18.5,9A1.5,1.5 0 0,1 20,10.5A1.5,1.5 0 0,1 18.5,12A1.5,1.5 0 0,1 17,10.5A1.5,1.5 0 0,1 18.5,9Z</Geometry>
            <Geometry x:Key="IconBolt">M13,2L3,14H12L11,22L21,10H12L13,2Z</Geometry>
            <Geometry x:Key="IconPerformance">M17,6H7A2,2 0 0,0 5,8V16A2,2 0 0,0 7,18H17A2,2 0 0,0 19,16V8A2,2 0 0,0 17,6M11,2V4H13V2H11M7,2V4H9V2H7M15,2V4H17V2H15M2,7V9H4V7H2M2,11V13H4V11H2M2,15V17H4V15H2M20,7V9H22V7H20M20,11V13H22V11H20M20,15V17H22V15H20M11,20V22H13V20H11M7,20V22H9V20H7M15,20V22H17V20H15Z</Geometry>
            <Geometry x:Key="IconShield">M12,1L3,5V11C3,16.55 6.84,21.74 12,23C17.16,21.74 21,16.55 21,11V5L12,1M12,7C13.4,7 14.8,8.6 14.8,11V11.5H16V17H8V11.5H9.2V11C9.2,8.6 10.6,7 12,7</Geometry>
            <Geometry x:Key="IconRocket">M15,13V5A3,3 0 0,0 9,5V13A5,5 0 1,0 15,13M12,4A1,1 0 0,1 13,5V8H11V5A1,1 0 0,1 12,4Z</Geometry>
            <Geometry x:Key="IconDiagnostics">M21,16.5C21,16.88 20.79,17.21 20.47,17.38L12.57,21.82C12.41,21.94 12.21,22 12,22C11.79,22 11.59,21.94 11.43,21.82L3.53,17.38C3.21,17.21 3,16.88 3,16.5V7.5C3,7.12 3.21,6.79 3.53,6.62L11.43,2.18C11.59,2.06 11.79,2 12,2C12.21,2 12.41,2.06 12.57,2.18L20.47,6.62C20.79,6.79 21,7.12 21,7.5V16.5M12,4.15L6.04,7.5L12,10.85L17.96,7.5L12,4.15M5,15.91L11,19.29V12.58L5,9.21V15.91M19,15.91V9.21L13,12.58V19.29L19,15.91Z</Geometry>
            
            <!-- Animation (Dashboard Entry) -->
            <Storyboard x:Key="GamerEntryAnimation">
                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.8">
                    <DoubleAnimation.EasingFunction>
                        <ExponentialEase EasingMode="EaseOut" Exponent="5"/>
                    </DoubleAnimation.EasingFunction>
                </DoubleAnimation>
                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" From="30" To="0" Duration="0:0:0.8">
                    <DoubleAnimation.EasingFunction>
                        <ExponentialEase EasingMode="EaseOut" Exponent="5"/>
                    </DoubleAnimation.EasingFunction>
                </DoubleAnimation>
            </Storyboard>
        </ResourceDictionary>
    </UserControl.Resources>
    
    <UserControl.Triggers>
        <EventTrigger RoutedEvent="Loaded">
            <BeginStoryboard Storyboard="{StaticResource GamerEntryAnimation}"/>
        </EventTrigger>
    </UserControl.Triggers>
    
    <Grid>
        <!-- Background decorativo -->
        <Grid IsHitTestVisible="False" ClipToBounds="True">
            <Ellipse Width="450" Height="450" 
                     Fill="{DynamicResource AccentBlurBrush}"
                     HorizontalAlignment="Right" VerticalAlignment="Top"
                     Margin="0,-100,-180,0">
                <Ellipse.Effect>
                    <BlurEffect Radius="100"/>
                </Ellipse.Effect>
            </Ellipse>
            <Ellipse Width="350" Height="350" 
                     Fill="{DynamicResource PrimaryBlurBrush}"
                     HorizontalAlignment="Left" VerticalAlignment="Bottom"
                     Margin="-100,0,0,-100">
                <Ellipse.Effect>
                    <BlurEffect Radius="80"/>
                </Ellipse.Effect>
            </Ellipse>
        </Grid>
        
        <Grid Margin="28,12,28,14" ClipToBounds="True">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Header -->
                <RowDefinition Height="12"/>
                <RowDefinition Height="*"/>    <!-- Conteúdo: scroll interno -->
            </Grid.RowDefinitions>

            <!-- HEADER COMPACTO -->
            <StackPanel Grid.Row="0" Orientation="Horizontal">
                <Border Width="40" Height="40" CornerRadius="10" Margin="0,0,14,0" VerticalAlignment="Center" Background="#0A000000">
                    <Border.Effect><DropShadowEffect BlurRadius="15" ShadowDepth="0" Color="{DynamicResource PrimaryColor}" Opacity="0.3"/></Border.Effect>
                    <Grid>
                        <Border CornerRadius="10" BorderThickness="1">
                            <Border.BorderBrush><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#FF4B6B" Offset="0"/><GradientStop Color="#00FFFFFF" Offset="1"/></LinearGradientBrush></Border.BorderBrush>
                            <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#8B31FF" Offset="0"/><GradientStop Color="#2A000000" Offset="1"/></LinearGradientBrush></Border.Background>
                        </Border>
                        <Path Data="{StaticResource GamerIcon}" Fill="#FF6B35" Width="19" Height="19" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding [GamerModeTitle], Source={x:Static services:LocalizationService.Instance}}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <TextBlock Text="{Binding [GamerModeSubtitle], Source={x:Static services:LocalizationService.Instance}}" FontSize="11" Foreground="#94A3B8"/>
                </StackPanel>
            </StackPanel>

            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,4,16">
            <StackPanel>
                
                <!-- Early Warning System (Intelig&#234;ncia Preditiva) -->
                <Border Visibility="{Binding HasWarning, Converter={StaticResource BoolToVis}}"
                        Margin="0,0,0,16"
                        Padding="14,10"
                        CornerRadius="10"
                        BorderThickness="1">
                    <Border.Background>
                        <SolidColorBrush Color="#FF441111" Opacity="0.9"/>
                    </Border.Background>
                    <Border.BorderBrush>
                        <SolidColorBrush Color="#FFFF4444" Opacity="0.5"/>
                    </Border.BorderBrush>
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="12" ShadowDepth="0" Color="Red" Opacity="0.25"/>
                    </Border.Effect>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="⚠️" FontSize="16" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="#FF4B6B"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding [GamerPredictiveWarningTitle], Source={x:Static services:LocalizationService.Instance}}" 
                                      FontSize="11" FontWeight="Bold" 
                                      Foreground="#FFFF4444"/>
                            <TextBlock Text="{Binding WarningMessage}" 
                                      FontSize="14" FontWeight="SemiBold" 
                                      Foreground="#E0E7FF" 
                                      TextWrapping="Wrap"
                                      Margin="0,2,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Adaptive Power Intelligence (Modo Adaptativo) -->
                <Border Visibility="{Binding HasAdapterMessage, Converter={StaticResource BoolToVis}}"
                        Margin="0,0,0,16"
                        Padding="14,10"
                        CornerRadius="10"
                        BorderThickness="1">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#FF112244" Offset="0"/>
                            <GradientStop Color="#FF111133" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Border.BorderBrush>
                        <SolidColorBrush Color="#FF4488FF" Opacity="0.5"/>
                    </Border.BorderBrush>
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="12" ShadowDepth="0" Color="#FF4488FF" Opacity="0.2"/>
                    </Border.Effect>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Path Data="{StaticResource BoltIcon}" Fill="#FF4B6B" Margin="0,0,10,0" Width="16" Height="16" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
<StackPanel Grid.Column="1" VerticalAlignment="Center">
    <TextBlock Text="{Binding [GamerAdaptivePowerTitle], Source={x:Static services:LocalizationService.Instance}}" 
              FontSize="11" FontWeight="Bold" 
              Foreground="#FF4488FF"/>
    <TextBlock Text="{Binding AdapterMessage}" 
              FontSize="14" FontWeight="Medium" 
              Foreground="#E0E7FF" 
              TextWrapping="Wrap"
              Margin="0,2,0,0"/>
    <TextBlock Text="{Binding [GamerAdaptivePowerDesc], Source={x:Static services:LocalizationService.Instance}}" FontSize="11" Foreground="#818CF8" Margin="0,4,0,0" TextWrapping="Wrap"/>
</StackPanel>
                    </Grid>
                </Border>
                
                <!-- ========== CONTROLE MANUAL DO MODO GAMER ========== -->
                <Border Margin="0,0,0,24" Padding="24" CornerRadius="16" Background="#0A000000" BorderThickness="1">
                    <Border.BorderBrush>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#1AFFFFFF" Offset="0"/>
                            <GradientStop Color="#05FFFFFF" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.BorderBrush>
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="20" ShadowDepth="0" Color="Black" Opacity="0.3"/>
                    </Border.Effect>
                    <StackPanel>
                        <!-- Cabeçalho -->
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="40" Height="40" CornerRadius="10" Background="#1A31A8FF" Margin="0,0,16,0">
                                <TextBlock Text="&#xE7FC;" FontFamily="Segoe MDL2 Assets" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#FF6B35"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding [GamerManualControlTitle], Source={x:Static services:LocalizationService.Instance}}" 
                                          FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <TextBlock Text="{Binding [GamerManualControlDesc], Source={x:Static services:LocalizationService.Instance}}" 
                                          FontSize="13" Foreground="#94A3B8"/>
                            </StackPanel>
                        </Grid>
                        
                        <!-- Status Badge Moderno -->
                        <Border Padding="16,12" CornerRadius="12" Margin="0,0,0,16" Background="#0F000000" BorderThickness="1" BorderBrush="#1AFFFFFF">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding IsGamerModeActive, Converter={StaticResource BoolToStatusIconConverter}}"
                                          FontSize="22" Margin="0,0,16,0" VerticalAlignment="Center" Foreground="#FF4B6B"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding IsGamerModeActive, Converter={StaticResource BoolToStatusTextConverter}}"
                                              FontSize="16" FontWeight="Bold" Foreground="#E2E8F0"/>
                                    <TextBlock Text="{Binding GamerModeStatusDescription}"
                                              FontSize="13" Foreground="#94A3B8" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Botões de Ação (SaaS Design) -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <!-- Botão ATIVAR -->
                            <Button x:Name="BtnActivateGamer" Grid.Column="0" Command="{Binding ActivateGamerModeCommand}" 
                                    IsEnabled="{Binding IsGamerModeActive, Converter={StaticResource InverseBooleanConverter}}"
                                    Height="48" Cursor="Hand">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource ModernButtonStyle}">
                                        <Setter Property="Background">
                                            <Setter.Value>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                    <GradientStop Color="#10B981" Offset="0"/>
                                                    <GradientStop Color="#059669" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Setter.Value>
                                        </Setter>
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Effect">
                                                    <Setter.Value>
                                                        <DropShadowEffect BlurRadius="15" ShadowDepth="0" Color="#10B981" Opacity="0.5"/>
                                                    </Setter.Value>
                                                </Setter>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <TextBlock Text="&#xE945;" FontFamily="Segoe MDL2 Assets" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center" Foreground="#FF4B6B"/>
                                    <TextBlock Text="{Binding [GamerActivate], Source={x:Static services:LocalizationService.Instance}}" FontSize="14" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                                    <controls:ProBadge Margin="8,0,0,0" Tip="{Binding [ProBadgeTip], Source={x:Static services:LocalizationService.Instance}}"
                                                      Visibility="{Binding Source={x:Static license:LicenseTokenStore.IsProActive}, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>
                                </StackPanel>
                            </Button>
                            
                            <!-- Botão DESATIVAR -->
                            <Button x:Name="BtnDeactivateGamer" Grid.Column="2" Command="{Binding DeactivateGamerModeCommand}"
                                    IsEnabled="{Binding IsGamerModeActive}" Height="48" Cursor="Hand">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource ModernButtonStyle}">
                                        <Setter Property="Background">
                                            <Setter.Value>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                    <GradientStop Color="#EF4444" Offset="0"/>
                                                    <GradientStop Color="#DC2626" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Setter.Value>
                                        </Setter>
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Effect">
                                                    <Setter.Value>
                                                        <DropShadowEffect BlurRadius="15" ShadowDepth="0" Color="#EF4444" Opacity="0.5"/>
                                                    </Setter.Value>
                                                </Setter>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <TextBlock Text="🛑" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding [GamerDeactivate], Source={x:Static services:LocalizationService.Instance}}" FontSize="14" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Grid>


                    </StackPanel>
                </Border>


                <!-- ========== ESTADO DO SISTEMA ========== -->
                <Border Margin="0,0,0,24" Padding="1" CornerRadius="16">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#2AFFFFFF" Offset="0"/>
                            <GradientStop Color="#05FFFFFF" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="15" ShadowDepth="0" Color="Black" Opacity="0.4"/>
                    </Border.Effect>
                    <Border CornerRadius="15" Background="#0A000000" Padding="20">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            
                            <!-- Ícone do Status -->
                            <Border Grid.Column="0" Width="48" Height="48" CornerRadius="12" Margin="0,0,16,0" Background="#0F000000" BorderThickness="1">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="BorderBrush" Value="#26EF4444"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsGamerModeActive}" Value="True">
                                                <Setter Property="BorderBrush" Value="#2610B981"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding IsGamerModeActive, Converter={StaticResource BoolToStatusIconConverter}}"
                                          FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="#EF4444"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsGamerModeActive}" Value="True">
                                                    <Setter Property="Foreground" Value="#10B981"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Border>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding [GamerSystemStatus], Source={x:Static services:LocalizationService.Instance}}" 
                                          FontSize="12" FontWeight="SemiBold" Foreground="#94A3B8" Margin="0,0,0,4"/>
                                <TextBlock FontSize="16" FontWeight="Bold" TextWrapping="Wrap">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text">
                                                <Setter.Value>
                                                    <MultiBinding Converter="{StaticResource GamerModeStatusConverter}">
