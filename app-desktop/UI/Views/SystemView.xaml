<UserControl xmlns:services="clr-namespace:VoltrisOptimizer.Services" x:Class="VoltrisOptimizer.UI.Views.SystemView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource DarkBrush}"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch">

    <UserControl.Triggers>
        <EventTrigger RoutedEvent="Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.4"/>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </UserControl.Triggers>

    <Grid>
        <!-- Background decorativo -->
        <Grid IsHitTestVisible="False" ClipToBounds="True">
            <Ellipse Width="400" Height="400" 
                     Fill="{DynamicResource SecondaryBlurBrush}"
                     HorizontalAlignment="Right" VerticalAlignment="Top"
                     Margin="0,-80,-120,0">
                <Ellipse.Effect>
                    <BlurEffect Radius="100"/>
                </Ellipse.Effect>
            </Ellipse>
            <Ellipse Width="350" Height="350" 
                     Fill="{DynamicResource AccentBlurBrush}"
                     HorizontalAlignment="Left" VerticalAlignment="Bottom"
                     Margin="-100,0,0,-100">
                <Ellipse.Effect>
                    <BlurEffect Radius="80"/>
                </Ellipse.Effect>
            </Ellipse>
        </Grid>

        <Grid Margin="28,12,28,16" ClipToBounds="True">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Header -->
                <RowDefinition Height="14"/>
                <RowDefinition Height="*"/>    <!-- Content: preenche o viewport, sem scroll -->
            </Grid.RowDefinitions>

            <!-- HEADER COMPACTO -->
            <StackPanel Grid.Row="0" Orientation="Horizontal">
                <Border Width="40" Height="40" CornerRadius="10" Margin="0,0,14,0" VerticalAlignment="Center">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#6366F1" Offset="0"/>
                            <GradientStop Color="#8B5CF6" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="12" ShadowDepth="0" Color="#6366F1" Opacity="0.4"/>
                    </Border.Effect>
                    <Path Data="{StaticResource SystemIcon}" 
                          Fill="White"
                          Width="20" Height="20"
                          Stretch="Uniform"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"/>
                </Border>

                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding [SysTitle], Source={x:Static services:LocalizationService.Instance}}"
                               FontFamily="Segoe UI Variable Display, Segoe UI"
                               FontSize="20"
                               FontWeight="Bold">
                        <TextBlock.Foreground>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#6366F1" Offset="0"/>
                                <GradientStop Color="#8B5CF6" Offset="0.5"/>
                                <GradientStop Color="#31A8FF" Offset="1"/>
                            </LinearGradientBrush>
                        </TextBlock.Foreground>
                    </TextBlock>
                    <TextBlock Text="{Binding [SysDesc], Source={x:Static services:LocalizationService.Instance}}"
                               FontSize="11"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                </StackPanel>
            </StackPanel>

            <!-- CONTEÚDO: grid de estrelas que ocupa exatamente a altura disponível -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="1*"/>
                    <RowDefinition Height="14"/>
                    <RowDefinition Height="1*"/>
                    <RowDefinition Height="14"/>
                    <RowDefinition Height="Auto"/> <!-- Controle de Energia -->
                </Grid.RowDefinitions>

                <!-- Restauração do Sistema -->
                <Border Grid.Row="0" Grid.Column="0"
                        Style="{DynamicResource PremiumCard}"
                        Padding="16"
                        VerticalAlignment="Stretch"
                        Margin="0,0,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                            <Border Width="36" Height="36" CornerRadius="9" Margin="0,0,12,0">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#10B981" Offset="0"/>
                                        <GradientStop Color="#059669" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Path Data="M6,2H18A2,2 0 0,1 20,4V20A2,2 0 0,1 18,22H6A2,2 0 0,1 4,20V4A2,2 0 0,1 6,2M12,18A3,3 0 0,0 15,15A3,3 0 0,0 12,12A3,3 0 0,0 9,15A3,3 0 0,0 12,18M14,8H6V4H14V8Z" Fill="#FFFFFF" Width="18" Height="18" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="{Binding [SysRestoreTitle], Source={x:Static services:LocalizationService.Instance}}"
                                       FontWeight="SemiBold"
                                       FontSize="15"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </StackPanel>

                        <Grid Grid.Row="1" VerticalAlignment="Bottom">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="1*"/>
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0" x:Name="CreateRestorePointButton"
                                   Content="{Binding [SysCreateRestorePoint], Source={x:Static services:LocalizationService.Instance}}"
                                   Style="{StaticResource NeonButtonStyle}"
                                   MinHeight="38"
                                   FontSize="11"
                                   Padding="10,6"
                                   HorizontalAlignment="Stretch"
                                   Click="CreateRestorePointButton_Click">
                                <Button.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#10B981" Offset="0"/>
                                        <GradientStop Color="#059669" Offset="1"/>
                                    </LinearGradientBrush>
                                </Button.Background>
                            </Button>

                            <Button Grid.Column="2" x:Name="RestoreSystemButton"
                                   Content="{Binding [SysRestoreSystem], Source={x:Static services:LocalizationService.Instance}}"
                                   Style="{StaticResource NeonSecondaryButtonStyle}"
                                   MinHeight="38"
                                   FontSize="11"
                                   Padding="10,6"
                                   HorizontalAlignment="Stretch"
                                   Click="RestoreSystemButton_Click"/>
                        </Grid>
                    </Grid>
                </Border>

                <!-- Monitoramento -->
                <Border Grid.Row="0" Grid.Column="2"
                        Style="{DynamicResource PremiumCard}"
                        Padding="16"
                        VerticalAlignment="Stretch">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                            <Border Width="36" Height="36" CornerRadius="9" Margin="0,0,12,0">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#3B82F6" Offset="0"/>
                                        <GradientStop Color="#1D4ED8" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Path Data="M3,22V8H7V22H3M10,22V2H14V22H10M17,22V14H21V22H17Z" Fill="#FFFFFF" Width="18" Height="18" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="{Binding [SysMonitorTitle], Source={x:Static services:LocalizationService.Instance}}"
                                       FontWeight="SemiBold"
                                       FontSize="15"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </StackPanel>

                        <TextBlock Grid.Row="1" Text="{Binding [SysResourceMonitorDesc], Source={x:Static services:LocalizationService.Instance}}"
                                   FontSize="11"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   TextWrapping="Wrap"
                                   VerticalAlignment="Center"
                                   Margin="0,0,0,10"/>

                        <Button Grid.Row="2" x:Name="ResourceMonitorButton"
                               Content="{Binding [SysResourceMonitor], Source={x:Static services:LocalizationService.Instance}}"
                               Style="{StaticResource NeonButtonStyle}"
                               MinHeight="44"
                               FontSize="12"
                               HorizontalAlignment="Stretch"
                               Click="ResourceMonitorButton_Click"
                               VerticalAlignment="Bottom">
                            <Button.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#3B82F6" Offset="0"/>
                                    <GradientStop Color="#1D4ED8" Offset="1"/>
                                </LinearGradientBrush>
                            </Button.Background>
                        </Button>
                    </Grid>
                </Border>

                <!-- Drivers e Hardware -->
                <Border Grid.Row="2" Grid.Column="0"
                        Style="{DynamicResource PremiumCard}"
                        Padding="16"
                        VerticalAlignment="Stretch">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                            <Border Width="36" Height="36" CornerRadius="9" Margin="0,0,12,0">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#8B5CF6" Offset="0"/>
                                        <GradientStop Color="#6D28D9" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Path Data="M12,15.5A3.5,3.5 0 0,1 8.5,12A3.5,3.5 0 0,1 12,8.5A3.5,3.5 0 0,1 15.5,12A3.5,3.5 0 0,1 12,15.5M19.43,12.97C19.47,12.65 19.5,12.33 19.5,12C19.5,11.67 19.47,11.34 19.43,11L21.54,9.37C21.73,9.22 21.78,8.95 21.66,8.73L19.66,5.27C19.54,5.05 19.27,4.96 19.05,5.05L16.56,6.05C16.04,5.66 15.5,5.32 14.87,5.07L14.5,2.42C14.46,2.18 14.25,2 14,2H10C9.75,2 9.54,2.18 9.5,2.42L9.13,5.07C8.5,5.32 7.96,5.66 7.44,6.05L4.95,5.05C4.73,4.96 4.46,5.05 4.34,5.27L2.34,8.73C2.21,8.95 2.27,9.22 2.46,9.37L4.57,11C4.53,11.34 4.5,11.67 4.5,12C4.5,12.33 4.53,12.65 4.57,12.97L2.46,14.63C2.27,14.78 2.21,15.05 2.34,15.27L4.34,18.73C4.46,18.95 4.73,19.03 4.95,18.95L7.44,17.94C7.96,18.34 8.5,18.68 9.13,18.93L9.5,21.58C9.54,21.82 9.75,22 10,22H14C14.25,22 14.46,21.82 14.5,21.58L14.87,18.93C15.5,18.67 16.04,18.34 16.56,17.94L19.05,18.95C19.27,19.03 19.54,18.95 19.66,18.73L21.66,15.27C21.78,15.05 21.73,14.78 21.54,14.63L19.43,12.97Z" Fill="#FFFFFF" Width="18" Height="18" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="{Binding [SysDriversTitle], Source={x:Static services:LocalizationService.Instance}}"
                                       FontWeight="SemiBold"
                                       FontSize="15"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </StackPanel>

                        <TextBlock Grid.Row="1" Text="{Binding [SysUpdateDriversDesc], Source={x:Static services:LocalizationService.Instance}}"
                                   FontSize="11"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   TextWrapping="Wrap"
                                   VerticalAlignment="Center"
                                   Margin="0,0,0,10"/>

                        <Button Grid.Row="2" x:Name="UpdateDriversButton"
                               Content="{Binding [SysUpdateDrivers], Source={x:Static services:LocalizationService.Instance}}"
                               Style="{StaticResource NeonButtonStyle}"
                               MinHeight="44"
                               FontSize="12"
                               HorizontalAlignment="Stretch"
                               Click="UpdateDriversButton_Click"
                               VerticalAlignment="Bottom">
                            <Button.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#8B5CF6" Offset="0"/>
                                    <GradientStop Color="#6D28D9" Offset="1"/>
                                </LinearGradientBrush>
                            </Button.Background>
                        </Button>
                    </Grid>
                </Border>

                <!-- Informações do Sistema -->
                <Border Grid.Row="2" Grid.Column="2"
                        Style="{DynamicResource PremiumCard}"
                        Padding="16"
                        VerticalAlignment="Stretch">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                            <Border Width="36" Height="36" CornerRadius="9" Margin="0,0,12,0">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#14B8A6" Offset="0"/>
                                        <GradientStop Color="#0D9488" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Path Data="M11,9H13V7H11M12,20C7.59,20 4,16.41 4,12C4,7.59 7.59,4 12,4C16.41,4 20,7.59 20,12C20,16.41 16.41,20 12,20M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2M11,17H13V11H11V17Z" Fill="#FFFFFF" Width="18" Height="18" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="{Binding [SysInfoTitle], Source={x:Static services:LocalizationService.Instance}}"
                                       FontWeight="SemiBold"
                                       FontSize="15"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </StackPanel>

                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Button x:Name="SystemInfoButton"
                                   Content="{Binding [SysAboutSystem], Source={x:Static services:LocalizationService.Instance}}"
                                   Style="{StaticResource NeonSecondaryButtonStyle}"
                                   MinHeight="42"
                                   FontSize="11"
                                   Grid.Column="0"
                                   VerticalAlignment="Bottom"
                                   Click="SystemInfoButton_Click"/>

                            <Button x:Name="TaskManagerButton"
                                   Content="{Binding [SysTaskManager], Source={x:Static services:LocalizationService.Instance}}"
                                   Style="{StaticResource NeonSecondaryButtonStyle}"
                                   MinHeight="42"
                                   FontSize="11"
                                   Grid.Column="2"
                                   VerticalAlignment="Bottom"
                                   Click="TaskManagerButton_Click"/>
                        </Grid>
                    </Grid>
                </Border>

                <!-- Controle de Energia -->
                <Border Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3"
                        Style="{DynamicResource PremiumCard}"
                        Padding="14"
                        Margin="0,0,0,0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <Border Width="32" Height="32" CornerRadius="8" Margin="0,0,10,0">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#EF4444" Offset="0"/>
                                        <GradientStop Color="#DC2626" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Path Data="M11,15H6L13,1V9H18L11,23V15Z" Fill="#FFFFFF" Width="16" Height="16" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="{Binding [SysPowerTitle], Source={x:Static services:LocalizationService.Instance}}"
                                       FontWeight="SemiBold"
                                       FontSize="14"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </StackPanel>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Button x:Name="RestartButton"
                                   Content="{Binding [SysRestartPc], Source={x:Static services:LocalizationService.Instance}}"
                                   Style="{StaticResource NeonButtonStyle}"
                                   MinHeight="42"
                                   FontSize="12"
                                   FontWeight="Bold"
                                   Grid.Column="0"
                                   Click="RestartButton_Click">
                                <Button.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#F59E0B" Offset="0"/>
                                        <GradientStop Color="#D97706" Offset="1"/>
                                    </LinearGradientBrush>
                                </Button.Background>
                            </Button>

                            <Button x:Name="ShutdownButton"
                                   Content="{Binding [SysShutdownPc], Source={x:Static services:LocalizationService.Instance}}"
                                   Style="{StaticResource NeonButtonStyle}"
                                   MinHeight="42"
                                   FontSize="12"
                                   FontWeight="Bold"
                                   Grid.Column="2"
                                   Click="ShutdownButton_Click">
                                <Button.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#EF4444" Offset="0"/>
                                        <GradientStop Color="#DC2626" Offset="1"/>
                                    </LinearGradientBrush>
                                </Button.Background>
                            </Button>
                        </Grid>

                        <TextBlock Text="{Binding [SysRemoteWarning], Source={x:Static services:LocalizationService.Instance}}"
                                   FontSize="10"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,8,0,0"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
