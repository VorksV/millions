<UserControl xmlns:services="clr-namespace:VoltrisOptimizer.Services"
             x:Class="VoltrisOptimizer.UI.Views.ShieldView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:converters="clr-namespace:VoltrisOptimizer.UI.Converters"
             xmlns:controls="clr-namespace:VoltrisOptimizer.UI.Controls"
             mc:Ignorable="d"
             Background="Transparent"
             FontFamily="Segoe UI Variable, Segoe UI"
             d:DesignHeight="900" d:DesignWidth="1400">

    <UserControl.Resources>

        <ResourceDictionary>
            <BooleanToVisibilityConverter x:Key="BoolToVis"/>
            <converters:DeviceIconConverter x:Key="DeviceIconConv"/>
        <converters:DeviceGlyphConverter x:Key="DeviceGlyphConv"/>
        <converters:DeviceAccentConverter x:Key="DeviceAccentConv"/>
            <converters:ZeroToVisibilityConverter x:Key="ZeroToVis"/>

            <!-- ================= GEOMETRIAS ================= -->
            <Geometry x:Key="SecIconShield">M12,1L3,5V11C3,16.55 6.84,21.74 12,23C17.16,21.74 21,16.55 21,11V5L12,1Z</Geometry>
            <Geometry x:Key="SecIconScan">M9.5,3A6.5,6.5 0 0,1 16,9.5C16,11.11 15.41,12.59 14.44,13.73L14.71,14H15.5L20.5,19L19,20.5L14,15.5V14.71L13.73,14.44C12.59,15.41 11.11,16 9.5,16A6.5,6.5 0 0,1 3,9.5A6.5,6.5 0 0,1 9.5,3M9.5,5C7,5 5,7 5,9.5C5,12 7,14 9.5,14C12,14 14,12 14,9.5C14,7 12,5 9.5,5Z</Geometry>
            <Geometry x:Key="SecIconAlert">M13,14H11V10H13M13,18H11V16H13M1,21H23L12,2L1,21Z</Geometry>
            <Geometry x:Key="SecIconNetwork">M16.36,14A4.36,4.36 0 0,0 16.5,12A4.36,4.36 0 0,0 16.36,10H19.74A7.21,7.21 0 0,1 20,12A7.21,7.21 0 0,1 19.74,14M14.59,19.56A7.2,7.2 0 0,0 19.56,14.59M14.34,14H9.66A7.2,7.2 0 0,0 5.44,19.56M9.66,19.56A7.2,7.2 0 0,0 14.59,19.56M12,19.96A7.96,7.96 0 0,0 14.59,19.56M8.03,16C8.35,17.25 8.81,18.45 9.41,19.56M7.57,18.93L5.08,16M4.26,14A7.2,7.2 0 0,0 8.03,16M5.08,8H8.03A7.2,7.2 0 0,0 4.26,4.44M12,4.04A7.96,7.96 0 0,0 14.59,4.44M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2Z</Geometry>
            <Geometry x:Key="SecIconRansom">M12,17A2,2 0 0,0 14,15C14,13.89 13.1,13 12,13A2,2 0 0,0 10,15A2,2 0 0,0 12,17M18,8A2,2 0 0,1 20,10V20A2,2 0 0,1 18,22H6A2,2 0 0,1 4,20V10A2,2 0 0,1 6,8H7V6A5,5 0 0,1 12,1A5,5 0 0,1 17,6V8H18M12,3A3,3 0 0,0 9,6V8H15V6A3,3 0 0,0 12,3Z</Geometry>
            <Geometry x:Key="SecIconBroom">M19.36,2.72L20.78,4.14L13.87,11.05C13.87,11.05 12.5,12.5 11.05,12.5H9.5L7.5,14.5H11.05C11.05,14.5 12.5,13.13 12.5,13.13L19.43,6.2L21.28,8.05M6.5,15.5L4.5,17.5L8,21L10,19L6.5,15.5M3,22L5,20</Geometry>
            <Geometry x:Key="SecIconBoot">M13,2H11V14H13V2M18.14,5.14L16.62,6.66C18.75,8.79 19.5,11.5 19.5,14A7.5,7.5 0 0,1 4.5,14C4.5,11.11 6,8.5 8.5,7.5L8.5,4.5L12,2L13,2V14H13V5.14L18.14,5.14Z</Geometry>
            <Geometry x:Key="SecIconEye">M12,4.5C7,4.5 2.73,7.61 1,12C2.73,16.39 7,19.5 12,19.5C17,19.5 21.27,16.39 23,12C21.27,7.61 17,4.5 12,4.5M12,17A5,5 0 0,1 7,12A5,5 0 0,1 12,7A5,5 0 0,1 17,12A5,5 0 0,1 12,17M12,9A3,3 0 0,0 9,12A3,3 0 0,0 12,15A3,3 0 0,0 15,12A3,3 0 0,0 12,9Z</Geometry>
            <Geometry x:Key="SecIconTrash">M19,4H15.5L14.5,3H9.5L8.5,4H5V6H19M6,19A2,2 0 0,0 8,21H16A2,2 0 0,0 18,19V7H6V19Z</Geometry>
            <Geometry x:Key="SecIconRestore">M13,3A9,9 0 0,0 4,12H1L5,16L9,12H6A7,7 0 1,1 13,19A7,7 0 0,1 18.92,16.92L20.84,18.84A9,9 0 1,0 13,3Z</Geometry>
            <Geometry x:Key="SecIconRefresh">M17.65,6.35A7.958,7.958 0 0,0 12,4A8,8 0 0,0 4,12A8,8 0 0,0 12,20C15.73,20 18.84,17.45 19.73,14H17.65C16.83,16.33 14.61,18 12,18A6,6 0 0,1 6,12A6,6 0 0,1 12,6C13.66,6 14.9,6.69 15.9,7.78L13,11H21V3L17.65,6.35Z</Geometry>
            <Geometry x:Key="SecIconCheck">M21,7L9,19L3.5,13.5L4.91,12.09L9,16.17L19.59,5.59L21,7Z</Geometry>
            <Geometry x:Key="SecIconBrain">M12,2A4,4 0 0,0 8,5.5A3.5,3.5 0 0,0 5,12A3.5,3.5 0 0,0 7.5,18.4A3.5,3.5 0 0,0 12,21.5A3.5,3.5 0 0,0 16.5,18.4A3.5,3.5 0 0,0 19,12A3.5,3.5 0 0,0 16,5.5A4,4 0 0,0 12,2Z</Geometry>

            <!-- Ícones outline (traço) das abas — visual moderno e consistente -->
            <Geometry x:Key="TabIconShield">M12,3 L20,6.5 V12 C20,17 16.5,20.5 12,21.5 C7.5,20.5 4,17 4,12 V6.5 Z</Geometry>
            <Geometry x:Key="TabIconScan">M17,10.5 A6.5,6.5 0 1,1 10.5,4 A6.5,6.5 0 1,1 4,10.5 A6.5,6.5 0 1,1 10.5,17 A6.5,6.5 0 1,1 17,10.5 Z M15.2,15.2 L20.5,20.5</Geometry>
            <Geometry x:Key="TabIconThreat">M12,3.2 L22,20.6 H2 Z M12,9.6 V14.4 M12,17.1 V17.4</Geometry>
            <Geometry x:Key="TabIconNetwork">M12,3.5 A2,2 0 1,1 12,7.5 A2,2 0 1,1 12,3.5 Z M5,15 A2,2 0 1,1 5,19 A2,2 0 1,1 5,15 Z M19,15 A2,2 0 1,1 19,19 A2,2 0 1,1 19,15 Z M12,7.5 V10.5 M12,10.5 L6,15 M12,10.5 L18,15</Geometry>
            <Geometry x:Key="TabIconSystem">M6.5,6.5 H17.5 V17.5 H6.5 Z M9.8,9.8 H14.2 V14.2 H9.8 Z M9.5,3.2 V6.5 M14.5,3.2 V6.5 M9.5,17.5 V20.8 M14.5,17.5 V20.8 M3.2,9.5 H6.5 M3.2,14.5 H6.5 M17.5,9.5 H20.8 M17.5,14.5 H20.8</Geometry>
            <Geometry x:Key="TabIconAdvanced">M3.5,7 H20.5 M3.5,12 H20.5 M3.5,17 H20.5 M8,4.5 V9.5 M15.5,9.5 V14.5 M10.5,14.5 V19.5</Geometry>

            <!-- ================= TOKENS LOCAIS ================= -->
            <SolidColorBrush x:Key="SecStroke" Color="#1FFFFFFF"/>
            <SolidColorBrush x:Key="SecStrokeSoft" Color="#14FFFFFF"/>
            <SolidColorBrush x:Key="SecFill" Color="#0AFFFFFF"/>
            <SolidColorBrush x:Key="SecFillStrong" Color="#14FFFFFF"/>
            <SolidColorBrush x:Key="SecOff" Color="#3A4250"/>
            <SolidColorBrush x:Key="SecOn" Color="#22C77A"/>
            <SolidColorBrush x:Key="SecWarn" Color="#F5B942"/>
            <SolidColorBrush x:Key="SecDanger" Color="#F04466"/>
            <SolidColorBrush x:Key="SecInfo" Color="#31A8FF"/>

            <LinearGradientBrush x:Key="SecBrandGradient" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#FF4B6B" Offset="0"/>
                <GradientStop Color="#8B31FF" Offset="0.5"/>
                <GradientStop Color="#31A8FF" Offset="1"/>
            </LinearGradientBrush>

            <LinearGradientBrush x:Key="SecBrandHorizontal" StartPoint="0,0" EndPoint="1,0">
                <GradientStop Color="#FF4B6B" Offset="0"/>
                <GradientStop Color="#8B31FF" Offset="0.5"/>
                <GradientStop Color="#31A8FF" Offset="1"/>
            </LinearGradientBrush>

            <!-- ================= SUPERFÍCIES ================= -->
            <Style x:Key="SecCard" TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource BgCard}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource BorderLight}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="16"/>
                <Setter Property="Padding" Value="18"/>
            </Style>

            <Style x:Key="SecTile" TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource BgInput}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource BorderLight}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="12"/>
                <Setter Property="Padding" Value="12,10"/>
            </Style>

            <Style x:Key="SecRow" TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource BgInput}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource BorderLight}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="10"/>
                <Setter Property="Padding" Value="12,9"/>
            </Style>

            <Style x:Key="SecScroll" TargetType="ScrollViewer">
                <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
                <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollViewer">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                </Grid.ColumnDefinitions>
                                <ScrollContentPresenter Grid.Column="0"/>
                                <ScrollBar Grid.Column="1" x:Name="PART_VerticalScrollBar" Orientation="Vertical"
                                           Value="{TemplateBinding VerticalOffset}"
                                           Maximum="{TemplateBinding ScrollableHeight}"
                                           ViewportSize="{TemplateBinding ViewportHeight}"
                                           Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"
                                           Background="Transparent" Width="7" MinWidth="7"/>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ================= TIPOGRAFIA ================= -->
            <Style x:Key="SecH1" TargetType="TextBlock">
                <Setter Property="FontSize" Value="17"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            </Style>

            <Style x:Key="SecH2" TargetType="TextBlock">
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            </Style>

            <Style x:Key="SecBody" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            </Style>

            <Style x:Key="SecMuted" TargetType="TextBlock">
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
            </Style>

            <Style x:Key="SecLabel" TargetType="TextBlock" BasedOn="{StaticResource SecMuted}">
                <Setter Property="FontSize" Value="10.5"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Typography.Capitals" Value="AllSmallCaps"/>
            </Style>

            <Style x:Key="SecValue" TargetType="TextBlock">
                <Setter Property="FontSize" Value="22"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            </Style>

            <!-- ================= BOTÕES ================= -->
            <Style x:Key="SecGhost" TargetType="Button">
                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                <Setter Property="Background" Value="{DynamicResource BgInput}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource BorderLight}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Height" Value="34"/>
                <Setter Property="Padding" Value="14,0"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="10" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource SecFillStrong}"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bd" Property="Opacity" Value="0.8"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Bd" Property="Opacity" Value="0.45"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="SecPrimary" TargetType="Button" BasedOn="{StaticResource SecGhost}">
                <Setter Property="Background" Value="{StaticResource SecBrandGradient}"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Foreground" Value="#FFFFFF"/>
            </Style>

            <Style x:Key="SecDangerGhost" TargetType="Button" BasedOn="{StaticResource SecGhost}">
                <Setter Property="Foreground" Value="{StaticResource SecDanger}"/>
            </Style>

            <!-- ================= ABAS ================= -->
            <Style x:Key="SecTab" TargetType="Button">
                <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="FontSize" Value="12.5"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Height" Value="42"/>
                <Setter Property="Padding" Value="6,0"/>
                <Setter Property="Margin" Value="3,0"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid Background="Transparent">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="3"/>
                                </Grid.RowDefinitions>
                                <Border x:Name="Bd" Grid.Row="0" CornerRadius="10" BorderThickness="1" BorderBrush="Transparent">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#1AFFFFFF" Offset="0"/>
                                            <GradientStop Color="#08FFFFFF" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>
                                <ContentPresenter Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <!-- Barra colorida: recuada exatamente o raio do card (10),
                                     para alinhar com o início da borda e não invadir os
                                     cantos arredondados. -->
                                <Border x:Name="Underline" Grid.Row="1" Height="3" CornerRadius="2" Background="Transparent"
                                        Margin="10,0"/>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource SecStrokeSoft}"/>
                                </Trigger>

                                <DataTrigger Binding="{Binding ShieldTabOverview}" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="#338B31FF"/>
                                    <Setter TargetName="Underline" Property="Background" Value="{StaticResource SecBrandHorizontal}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding ShieldTabScans}" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="#338B31FF"/>
                                    <Setter TargetName="Underline" Property="Background" Value="{StaticResource SecBrandHorizontal}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding ShieldTabThreats}" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="#338B31FF"/>
                                    <Setter TargetName="Underline" Property="Background" Value="{StaticResource SecBrandHorizontal}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding ShieldTabNetwork}" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="#338B31FF"/>
                                    <Setter TargetName="Underline" Property="Background" Value="{StaticResource SecBrandHorizontal}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding ShieldTabSystem}" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="#338B31FF"/>
                                    <Setter TargetName="Underline" Property="Background" Value="{StaticResource SecBrandHorizontal}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding ShieldTabAdvanced}" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="#338B31FF"/>
                                    <Setter TargetName="Underline" Property="Background" Value="{StaticResource SecBrandHorizontal}"/>
                                </DataTrigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

        </ResourceDictionary>
    </UserControl.Resources>

    <!-- ================= AMBIENTE ================= -->
    <Grid ClipToBounds="True">
        <Grid IsHitTestVisible="False">
            <Ellipse Width="620" Height="620" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-260,-260,0,0" Opacity="0.16">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#8B31FF" Offset="0"/>
                        <GradientStop Color="#00000000" Offset="1"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
            <Ellipse Width="520" Height="520" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-220,-220" Opacity="0.12">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#31A8FF" Offset="0"/>
                        <GradientStop Color="#00000000" Offset="1"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
        </Grid>

        <Grid Margin="18,14,18,14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ================= HEADER ================= -->
            <Border Grid.Row="0" Style="{StaticResource SecCard}" Padding="18,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Marca -->
                    <Border Grid.Column="0" Width="42" Height="42" CornerRadius="12" VerticalAlignment="Center">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#33FF4B6B" Offset="0"/>
                                <GradientStop Color="#338B31FF" Offset="0.5"/>
                                <GradientStop Color="#3331A8FF" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <Path Data="{StaticResource SecIconShield}" Fill="{StaticResource SecBrandHorizontal}" Width="21" Height="21"
                              Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <!-- Título + status -->
                    <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding [Loc_VoltrisShield], Source={x:Static services:LocalizationService.Instance}}"
                                   FontSize="17" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                            <Border CornerRadius="8" Padding="8,2" Background="{StaticResource SecFill}" BorderThickness="1">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="BorderBrush" Value="{StaticResource SecStrokeSoft}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsShieldBlocked}" Value="True">
                                                <Setter Property="BorderBrush" Value="#66F5B942"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsProtectionActive}" Value="True">
                                                <Setter Property="BorderBrush" Value="#6622C77A"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock FontSize="10.5" FontWeight="SemiBold">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="{Binding [ProtectionDisabled], Source={x:Static services:LocalizationService.Instance}}"/>
                                            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsShieldBlocked}" Value="True">
                                                    <Setter Property="Text" Value="{Binding [ShieldBlockedByLicense], Source={x:Static services:LocalizationService.Instance}}"/>
                                                    <Setter Property="Foreground" Value="{StaticResource SecWarn}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsProtectionActive}" Value="True">
                                                    <Setter Property="Text" Value="{Binding [ShieldProtectionEnabled], Source={x:Static services:LocalizationService.Instance}}"/>
                                                    <Setter Property="Foreground" Value="{StaticResource SecOn}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Border>
                            <TextBlock Text="{Binding LastScanDisplay}" FontSize="11" Margin="10,0,0,0"
                                       Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Ações à direita -->
                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border CornerRadius="9" Padding="9,3" Margin="0,0,10,0" Background="{StaticResource SecFill}"
                                BorderThickness="1" BorderBrush="{StaticResource SecStrokeSoft}" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="7" Height="7" CornerRadius="4" Margin="0,0,7,0" VerticalAlignment="Center">
                                <Border.Style>
                                    <Style TargetType="Border">
                                            <Setter Property="Background" Value="{StaticResource SecOff}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsDefenderEnabled}" Value="True">
                                                    <Setter Property="Background" Value="{StaticResource SecOn}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                </Border>
                                <TextBlock Text="{Binding [Loc_WindowsDefenderStatus], Source={x:Static services:LocalizationService.Instance}}"
                                           FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <controls:ProBadge VerticalAlignment="Center" Margin="0,0,10,0" Text="PRO"
                                          Tip="{Binding [ProBadgeTip], Source={x:Static services:LocalizationService.Instance}}"/>

                        <Button Command="{Binding ToggleProtectionCommand}" Height="38" Padding="18,0" FontSize="13">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource SecPrimary}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsProtectionActive}" Value="False">
                                            <Setter Property="Background">
                                                <Setter.Value>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                        <GradientStop Color="#10B981" Offset="0"/>
                                                        <GradientStop Color="#059669" Offset="1"/>
                                                    </LinearGradientBrush>
                                                </Setter.Value>
                                            </Setter>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal">
                                <Path Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center" Fill="#FFFFFF"
                                      Data="M13,3H11V14H13V3M18.14,5.14L16.62,6.66C18.75,8.79 19.5,11.5 19.5,14A7.5,7.5 0 0,1 4.5,14C4.5,11.11 6,8.5 8.5,7.5L8.5,4.5L12,2L13,2V14H13V5.14L18.14,5.14Z"/>
                                <TextBlock x:Name="ToggleLabel" Margin="8,0,0,0" FontSize="13" FontWeight="Bold"
                                           Foreground="#FFFFFF" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="{Binding [ShieldActivateProtection], Source={x:Static services:LocalizationService.Instance}}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsProtectionActive}" Value="True">
                                                    <Setter Property="Text" Value="{Binding [ShieldDeactivateProtection], Source={x:Static services:LocalizationService.Instance}}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ================= BARRA DE ABAS ================= -->
            <Border Grid.Row="1" Margin="0,12,0,0" CornerRadius="14" Padding="5,3"
                    Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource BorderLight}" BorderThickness="1">
                <UniformGrid Columns="6" Rows="1">
                    <Button Command="{Binding SelectTabCommand}" CommandParameter="0" Style="{StaticResource SecTab}">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="{Binding [ShieldTabOverview], Source={x:Static services:LocalizationService.Instance}}"
                                       FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <Path Data="{StaticResource TabIconShield}" StrokeThickness="1.7" Fill="Transparent"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="15" Height="15" Stretch="Uniform"
                                  Margin="9,0,0,0" VerticalAlignment="Center"
                                  Stroke="#FF4B6B"/>
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding SelectTabCommand}" CommandParameter="1" Style="{StaticResource SecTab}">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="{Binding [ShieldTabScans], Source={x:Static services:LocalizationService.Instance}}"
                                       FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <Path Data="{StaticResource TabIconScan}" StrokeThickness="1.7" Fill="Transparent"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="15" Height="15" Stretch="Uniform"
                                  Margin="9,0,0,0" VerticalAlignment="Center"
                                  Stroke="#F5B942"/>
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding SelectTabCommand}" CommandParameter="2" Style="{StaticResource SecTab}">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="{Binding [ShieldTabThreats], Source={x:Static services:LocalizationService.Instance}}"
                                       FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <Path Data="{StaticResource TabIconThreat}" StrokeThickness="1.7" Fill="Transparent"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="15" Height="15" Stretch="Uniform"
                                  Margin="9,0,0,0" VerticalAlignment="Center"
                                  Stroke="#F04466"/>
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding SelectTabCommand}" CommandParameter="3" Style="{StaticResource SecTab}">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="{Binding [ShieldTabNetwork], Source={x:Static services:LocalizationService.Instance}}"
                                       FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <Path Data="{StaticResource TabIconNetwork}" StrokeThickness="1.7" Fill="Transparent"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="15" Height="15" Stretch="Uniform"
                                  Margin="9,0,0,0" VerticalAlignment="Center"
                                  Stroke="#31A8FF"/>
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding SelectTabCommand}" CommandParameter="4" Style="{StaticResource SecTab}">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="{Binding [ShieldTabSystem], Source={x:Static services:LocalizationService.Instance}}"
                                       FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <Path Data="{StaticResource TabIconSystem}" StrokeThickness="1.7" Fill="Transparent"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="15" Height="15" Stretch="Uniform"
                                  Margin="9,0,0,0" VerticalAlignment="Center"
                                  Stroke="#22C77A"/>
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding SelectTabCommand}" CommandParameter="5" Style="{StaticResource SecTab}">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="{Binding [ShieldTabAdvanced], Source={x:Static services:LocalizationService.Instance}}"
                                       FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <Path Data="{StaticResource TabIconAdvanced}" StrokeThickness="1.7" Fill="Transparent"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="15" Height="15" Stretch="Uniform"
                                  Margin="9,0,0,0" VerticalAlignment="Center"
                                  Stroke="#8B31FF"/>
                        </StackPanel>
                    </Button>
                </UniformGrid>
            </Border>

            <!-- ================= CONTEÚDO DAS ABAS ================= -->
            <Grid Grid.Row="2" Margin="0,12,0,0">

                <!-- ══════════ ABA 0 — VISÃO GERAL ══════════ -->
                <Grid Visibility="{Binding ShieldTabOverview, Converter={StaticResource BoolToVis}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Núcleo -->
                        <Border Grid.Column="0" Style="{StaticResource SecCard}" Padding="16" Width="228">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SecLabel}" Text="{Binding [ShieldCoreTitle], Source={x:Static services:LocalizationService.Instance}}"/>

                                <Grid Width="112" Height="112" HorizontalAlignment="Center" Margin="0,8,0,6">
                                    <Ellipse Width="112" Height="112">
                                        <Ellipse.Fill>
                                            <RadialGradientBrush>
                                                <GradientStop Color="#338B31FF" Offset="0"/>
                                                <GradientStop Color="#00000000" Offset="1"/>
                                            </RadialGradientBrush>
                                        </Ellipse.Fill>
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="Opacity" Value="1"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsShieldBlocked}" Value="True">
                                                        <Setter Property="Opacity" Value="0.3"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                    <Ellipse x:Name="CoreRing" Width="100" Height="100">
                                        <Ellipse.Stroke>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                <GradientStop Color="#FF4B6B" Offset="0"/>
                                                <GradientStop Color="#8B31FF" Offset="0.5"/>
                                                <GradientStop Color="#31A8FF" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Ellipse.Stroke>
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="StrokeThickness" Value="2"/>
                                                <Setter Property="Opacity" Value="0.9"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsShieldBlocked}" Value="True">
                                                        <Setter Property="StrokeThickness" Value="1"/>
                                                        <Setter Property="Opacity" Value="0.35"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                    <Ellipse Width="84" Height="84" Stroke="#1FFFFFFF" StrokeThickness="1"/>
                                    <Path Data="{StaticResource SecIconShield}" Width="40" Height="40" Stretch="Uniform"
                                          HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Path.Style>
                                            <Style TargetType="Path">
                                                <Setter Property="Fill" Value="{StaticResource SecBrandHorizontal}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsShieldBlocked}" Value="True">
                                                        <Setter Property="Fill" Value="#4A5A6675"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Path.Style>
                                    </Path>
                                </Grid>

                                <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource SecBody}" TextWrapping="Wrap"
                                           TextAlignment="Center" HorizontalAlignment="Center"/>

                                <Border Margin="0,10,0,0" CornerRadius="9" Padding="10,6" Background="{StaticResource SecFill}"
                                        Visibility="{Binding IsShieldBlocked, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="{Binding LicenseTypeDisplay}" FontSize="11" FontWeight="SemiBold"
                                               Foreground="{StaticResource SecWarn}" TextAlignment="Center"/>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Módulos + estatísticas.
                             Módulos em Auto: o card recebe a altura integral do conteúdo,
                             nunca é cortado na base (foi o que sumia "Ransomware Detector",
                             "Network Guardian" e "Monitor de Conexões").
                             Estatísticas em "*": absorvem o espaço vertical restante, para que
                             esta coluna tenga a MESMA altura das colunas do núcleo e das ações
                             rápidas. Sem isso, o Sobrava espaço vazio entre o card de
                             estatísticas e o footer sempre que o "Ver Planos" do rodapé
                             desaparecia e a área de conteúdo ganhava altura. -->
                        <Grid Grid.Column="1" Margin="12,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" Style="{StaticResource SecCard}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <!-- Auto: com "*" a lista de módulos era CORTADA na base
                                             quando o card "VER PLANOS" ocupava espaço e a altura
                                             disponível diminuía. -->
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Style="{StaticResource SecLabel}"
                                               Text="{Binding [ShieldModulesTitle], Source={x:Static services:LocalizationService.Instance}}"/>
                                    <!-- WrapPanel em vez de UniformGrid: cada item ajusta o
                                         próprio tamanho ao texto, portanto nada é cortado
                                         na lateral direita. -->
                                    <WrapPanel x:Name="ModulesWrap" Grid.Row="1" Margin="0,10,0,0">
                                        <StackPanel Margin="0,0,20,6">
                                            <StackPanel Orientation="Horizontal">
                                                <Border Width="8" Height="8" CornerRadius="4" VerticalAlignment="Center">
                                <Border.Style>
                                    <Style TargetType="Border">
                                                            <Setter Property="Background" Value="{StaticResource SecOff}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsProtectionActive}" Value="True">
                                                                    <Setter Property="Background" Value="{StaticResource SecOn}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                </Border>
                                                <TextBlock Text="{Binding [ShieldModuleRealTime], Source={x:Static services:LocalizationService.Instance}}" Style="{StaticResource SecBody}" Margin="8,0,0,0"/>
                                            </StackPanel>
                                        </StackPanel>
                                        <StackPanel Margin="0,0,20,6">
                                            <StackPanel Orientation="Horizontal">
                                                <Border Width="8" Height="8" CornerRadius="4" VerticalAlignment="Center">
                                <Border.Style>
                                    <Style TargetType="Border">
                                                            <Setter Property="Background" Value="{StaticResource SecOff}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsProtectionActive}" Value="True">
                                                                    <Setter Property="Background" Value="{StaticResource SecOn}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                </Border>
                                                <TextBlock Text="{Binding [ShieldModuleStartup], Source={x:Static services:LocalizationService.Instance}}" Style="{StaticResource SecBody}" Margin="8,0,0,0"/>
                                            </StackPanel>
                                        </StackPanel>
                                        <StackPanel Margin="0,0,20,6">
                                            <StackPanel Orientation="Horizontal">
                                                <Border Width="8" Height="8" CornerRadius="4" VerticalAlignment="Center">
                                <Border.Style>
                                    <Style TargetType="Border">
                                                            <Setter Property="Background" Value="{StaticResource SecOff}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsProtectionActive}" Value="True">
                                                                    <Setter Property="Background" Value="{StaticResource SecOn}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                </Border>
                                                <TextBlock Text="{Binding [ShieldModuleBehavior], Source={x:Static services:LocalizationService.Instance}}" Style="{StaticResource SecBody}" Margin="8,0,0,0"/>
                                            </StackPanel>
                                        </StackPanel>
                                        <StackPanel Margin="0,0,20,6">
                                            <StackPanel Orientation="Horizontal">
                                                <Border Width="8" Height="8" CornerRadius="4" VerticalAlignment="Center">
                                <Border.Style>
                                    <Style TargetType="Border">
                                                            <Setter Property="Background" Value="{StaticResource SecOff}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsProtectionActive}" Value="True">
                                                                    <Setter Property="Background" Value="{StaticResource SecOn}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                </Border>
                                                <TextBlock Text="{Binding [ShieldModuleProcesses], Source={x:Static services:LocalizationService.Instance}}" Style="{StaticResource SecBody}" Margin="8,0,0,0"/>
                                            </StackPanel>
                                        </StackPanel>
                                        <StackPanel Margin="0,0,20,0">
                                            <StackPanel Orientation="Horizontal">
                                                <Border Width="8" Height="8" CornerRadius="4" VerticalAlignment="Center">
                                <Border.Style>
                                    <Style TargetType="Border">
                                                            <Setter Property="Background" Value="{StaticResource SecOff}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsRansomwareMonitoringActive}" Value="True">
                                                                    <Setter Property="Background" Value="{StaticResource SecOn}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                </Border>
                                                <TextBlock Text="{Binding [Loc_RansomwareDetector], Source={x:Static services:LocalizationService.Instance}}" Style="{StaticResource SecBody}" Margin="8,0,0,0"/>
                                            </StackPanel>
                                        </StackPanel>
                                        <StackPanel Margin="0,0,20,0">
                                            <StackPanel Orientation="Horizontal">
                                                <Border Width="8" Height="8" CornerRadius="4" VerticalAlignment="Center">
                                <Border.Style>
                                    <Style TargetType="Border">
                                                            <Setter Property="Background" Value="{StaticResource SecOff}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsNetworkMonitoringActive}" Value="True">
                                                                    <Setter Property="Background" Value="{StaticResource SecOn}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                </Border>
                                                <TextBlock Text="{Binding [Loc_Networkguardian], Source={x:Static services:LocalizationService.Instance}}" Style="{StaticResource SecBody}" Margin="8,0,0,0"/>
                                            </StackPanel>
                                        </StackPanel>
                                        <StackPanel Margin="0,0,20,0">
                                            <StackPanel Orientation="Horizontal">
                                                <Border Width="8" Height="8" CornerRadius="4" VerticalAlignment="Center">
                                <Border.Style>
                                    <Style TargetType="Border">
                                                            <Setter Property="Background" Value="{StaticResource SecOff}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsPortMonitoringActive}" Value="True">
                                                                    <Setter Property="Background" Value="{StaticResource SecOn}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                </Border>
                                                <TextBlock Text="{Binding [Loc_PortAndConnectionMonitor], Source={x:Static services:LocalizationService.Instance}}" Style="{StaticResource SecBody}" Margin="8,0,0,0"/>
                                            </StackPanel>
                                        </StackPanel>
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <Border Width="8" Height="8" CornerRadius="4" VerticalAlignment="Center">
                                <Border.Style>
                                    <Style TargetType="Border">
                                                            <Setter Property="Background" Value="{StaticResource SecOff}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsDefenderEnabled}" Value="True">
                                                                    <Setter Property="Background" Value="{StaticResource SecInfo}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                </Border>
                                                <TextBlock Text="{Binding [Loc_WindowsDefenderStatus], Source={x:Static services:LocalizationService.Instance}}" Style="{StaticResource SecBody}" Margin="8,0,0,0"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </WrapPanel>
                                </Grid>
                            </Border>

                            <Border Grid.Row="1" Style="{StaticResource SecCard}" Padding="14" Margin="0,12,0,0">
                                <Grid VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Style="{StaticResource SecLabel}" Text="{Binding [Loc_ThreatsDetected_3], Source={x:Static services:LocalizationService.Instance}}"/>
                                        <TextBlock Text="{Binding ThreatsDetected}" Style="{StaticResource SecValue}" Foreground="{StaticResource SecDanger}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                        <TextBlock Style="{StaticResource SecLabel}" Text="{Binding [Loc_Quarantine], Source={x:Static services:LocalizationService.Instance}}"/>
                                        <TextBlock Text="{Binding QuarantineCount}" Style="{StaticResource SecValue}" Foreground="{StaticResource SecWarn}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Margin="10,0,0,0">
                                        <TextBlock Style="{StaticResource SecLabel}" Text="{Binding [Loc_OnlineDevices], Source={x:Static services:LocalizationService.Instance}}"/>
                                        <TextBlock Style="{StaticResource SecValue}" Foreground="{StaticResource SecOn}">
                                            <Run Text="{Binding OnlineDevicesCount, Mode=OneWay}"/>
                                            <Run Text="/" Foreground="{DynamicResource TextMuted}"/>
                                            <Run Text="{Binding TotalDevicesCount, Mode=OneWay}"/>
                                        </TextBlock>
                                    </StackPanel>
                                    <StackPanel Grid.Column="3" Margin="10,0,0,0">
                                        <TextBlock Style="{StaticResource SecLabel}" Text="{Binding [Loc_Alerts], Source={x:Static services:LocalizationService.Instance}}"/>
                                        <TextBlock Text="{Binding RansomwareAlertsCount}" Style="{StaticResource SecValue}" Foreground="{StaticResource SecWarn}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- Ações rápidas -->
                        <Border Grid.Column="2" Style="{StaticResource SecCard}" Padding="14" Width="212">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SecLabel}" Text="{Binding [ShieldQuickActions], Source={x:Static services:LocalizationService.Instance}}"/>

                                <Button Command="{Binding RunQuickScanCommand}" Style="{StaticResource SecPrimary}" Margin="0,10,0,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource SecIconScan}" Fill="#FFFFFF" Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding [Loc_QuickScan], Source={x:Static services:LocalizationService.Instance}}" Margin="8,0,0,0"
                                                   FontSize="12" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                                        <controls:ProBadge Margin="8,0,0,0" VerticalAlignment="Center" Text="PRO" Tip="{Binding [ProBadgeTip], Source={x:Static services:LocalizationService.Instance}}"/>
                                    </StackPanel>
                                </Button>

                                <Button Command="{Binding RunFullScanCommand}" Style="{StaticResource SecGhost}" Margin="0,8,0,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource SecIconEye}" Fill="{DynamicResource TextPrimary}" Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding [Loc_FullScan], Source={x:Static services:LocalizationService.Instance}}" Margin="8,0,0,0"
                                                   FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                                        <controls:ProBadge Margin="8,0,0,0" VerticalAlignment="Center" Text="PRO" Tip="{Binding [ProBadgeTip], Source={x:Static services:LocalizationService.Instance}}"/>
                                    </StackPanel>
                                </Button>

                                <Button Command="{Binding RunAdwareScanCommand}" Style="{StaticResource SecGhost}" Margin="0,8,0,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource SecIconBroom}" Fill="{DynamicResource TextPrimary}" Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding [Loc_AdwareScan], Source={x:Static services:LocalizationService.Instance}}" Margin="8,0,0,0"
                                                   FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                                        <controls:ProBadge Margin="8,0,0,0" VerticalAlignment="Center" Text="PRO" Tip="{Binding [ProBadgeTip], Source={x:Static services:LocalizationService.Instance}}"/>
                                    </StackPanel>
                                </Button>

                                <Button Command="{Binding RefreshDefenderStatusCommand}" Style="{StaticResource SecGhost}" Margin="0,8,0,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource SecIconRefresh}" Fill="{DynamicResource TextPrimary}" Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding [Loc_UpdateStatus], Source={x:Static services:LocalizationService.Instance}}" Margin="8,0,0,0"
                                                   FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Últimas detecções -->
                    <Border Grid.Row="1" Style="{StaticResource SecCard}" Padding="14" Margin="0,12,0,0" Height="108">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Style="{StaticResource SecLabel}"
                                       Text="{Binding [ShieldLastDetections], Source={x:Static services:LocalizationService.Instance}}"/>
                            <Grid Grid.Row="1" Margin="0,8,0,0">
                                <ScrollViewer Style="{StaticResource SecScroll}" VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding ScanThreatItems}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource SecRow}" Margin="0,0,0,6">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Grid.Column="0">
                                                            <TextBlock Text="{Binding Name}" Style="{StaticResource SecH2}" TextTrimming="CharacterEllipsis"/>
                                                            <TextBlock Text="{Binding Path}" Style="{StaticResource SecMuted}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                                        </StackPanel>
                                                        <Border Grid.Column="1" CornerRadius="7" Padding="8,2" VerticalAlignment="Center">
                                                            <Border.Background>
                                                                <SolidColorBrush Color="{Binding SeverityColor.Color}" Opacity="0.18"/>
                                                            </Border.Background>
                                                            <TextBlock Text="{Binding SeverityText}" FontSize="10" FontWeight="Bold"
                                                                       Foreground="{Binding SeverityColor}"/>
                                                        </Border>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>

                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                            Visibility="{Binding ScanThreatItems.Count, Converter={StaticResource ZeroToVis}}">
                                    <Path Data="{StaticResource SecIconCheck}" Fill="{StaticResource SecOn}" Width="26" Height="26" Stretch="Uniform"/>
                                    <TextBlock Text="{Binding [ShieldNoDetections], Source={x:Static services:LocalizationService.Instance}}"
                                               Style="{StaticResource SecMuted}" Margin="0,6,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>

                <!-- ══════════ ABA 1 — SCANS ══════════ -->
                <Grid Visibility="{Binding ShieldTabScans, Converter={StaticResource BoolToVis}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <UniformGrid x:Name="ScanCardsGrid" Grid.Row="0" Columns="4">
                        <Border Style="{StaticResource SecCard}" Margin="0,0,8,0" Padding="16">
                            <StackPanel>
                                <Border Width="38" Height="38" CornerRadius="11" Background="#1A31A8FF" HorizontalAlignment="Left">
                                    <Path Data="{StaticResource SecIconScan}" Fill="{StaticResource SecInfo}" Width="19" Height="19" Stretch="Uniform"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="{Binding [Loc_QuickScan], Source={x:Static services:LocalizationService.Instance}}" Style="{StaticResource SecH1}" Margin="0,10,0,4"/>
                                <TextBlock Text="{Binding [Loc_ScansDownloadsAndTemporaryFiles], Source={x:Static services:LocalizationService.Instance}}"
                                           Style="{StaticResource SecMuted}" TextWrapping="Wrap"/>
                                <Button Command="{Binding RunQuickScanCommand}" Style="{StaticResource SecPrimary}" Margin="0,12,0,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding [Loc_ToExecute], Source={x:Static services:LocalizationService.Instance}}" FontSize="12" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                                        <controls:ProBadge Margin="7,0,0,0" VerticalAlignment="Center" Text="PRO" Tip="{Binding [ProBadgeTip], Source={x:Static services:LocalizationService.Instance}}"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SecCard}" Margin="0,0,8,0" Padding="16">
                            <StackPanel>
                                <Border Width="38" Height="38" CornerRadius="11" Background="#1A8B31FF" HorizontalAlignment="Left">
                                    <Path Data="{StaticResource SecIconEye}" Fill="{StaticResource SecBrandGradient}" Width="19" Height="19" Stretch="Uniform"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="{Binding [Loc_FullScan], Source={x:Static services:LocalizationService.Instance}}" Style="{StaticResource SecH1}" Margin="0,10,0,4"/>
                                <TextBlock Text="{Binding [Loc_DeepSystemAnalysisIncludingProgram], Source={x:Static services:LocalizationService.Instance}}"
                                           Style="{StaticResource SecMuted}" TextWrapping="Wrap"/>
                                <Button Command="{Binding RunFullScanCommand}" Style="{StaticResource SecPrimary}" Margin="0,12,0,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding [Loc_ToExecute], Source={x:Static services:LocalizationService.Instance}}" FontSize="12" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                                        <controls:ProBadge Margin="7,0,0,0" VerticalAlignment="Center" Text="PRO" Tip="{Binding [ProBadgeTip], Source={x:Static services:LocalizationService.Instance}}"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SecCard}" Margin="0,0,8,0" Padding="16">
                            <StackPanel>
                                <Border Width="38" Height="38" CornerRadius="11" Background="#1AFF4B6B" HorizontalAlignment="Left">
                                    <Path Data="{StaticResource SecIconBroom}" Fill="#FF4B6B" Width="19" Height="19" Stretch="Uniform"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="{Binding [Loc_AdwareScan], Source={x:Static services:LocalizationService.Instance}}" Style="{StaticResource SecH1}" Margin="0,10,0,4"/>
                                <TextBlock Text="{Binding [Loc_DetectsToolbarsHijackersPupsAnd], Source={x:Static services:LocalizationService.Instance}}"
                                           Style="{StaticResource SecMuted}" TextWrapping="Wrap"/>
                                <Button Command="{Binding RunAdwareScanCommand}" Style="{StaticResource SecPrimary}" Margin="0,12,0,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding [Loc_ToExecute], Source={x:Static services:LocalizationService.Instance}}" FontSize="12" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                                        <controls:ProBadge Margin="7,0,0,0" VerticalAlignment="Center" Text="PRO" Tip="{Binding [ProBadgeTip], Source={x:Static services:LocalizationService.Instance}}"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SecCard}" Padding="16">
                            <StackPanel>
                                <Border Width="38" Height="38" CornerRadius="11" Background="#1A22C77A" HorizontalAlignment="Left">
                                    <Path Data="{StaticResource SecIconShield}" Fill="{StaticResource SecOn}" Width="19" Height="19" Stretch="Uniform"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="{Binding [Loc_StartScan_2], Source={x:Static services:LocalizationService.Instance}}" Style="{StaticResource SecH1}" Margin="0,10,0,4"/>
                                <TextBlock Text="{Binding [Loc_IntegrationWithWindowsDefender], Source={x:Static services:LocalizationService.Instance}}"
                                           Style="{StaticResource SecMuted}" TextWrapping="Wrap"/>
                                <Button Command="{Binding StartDefenderScanCommand}" Style="{StaticResource SecPrimary}" Margin="0,12,0,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding [Loc_ToExecute], Source={x:Static services:LocalizationService.Instance}}" FontSize="12" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                                        <controls:ProBadge Margin="7,0,0,0" VerticalAlignment="Center" Text="PRO" Tip="{Binding [ProBadgeTip], Source={x:Static services:LocalizationService.Instance}}"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <!-- Progresso -->
                    <Border Grid.Row="1" Style="{StaticResource SecCard}" Padding="14" Margin="0,12,0,0"
                            Visibility="{Binding IsScanning, Converter={StaticResource BoolToVis}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding [ShieldScanProgressTitle], Source={x:Static services:LocalizationService.Instance}}" Style="{StaticResource SecH2}"/>
                                <TextBlock Text="{Binding ScanProgressText}" Style="{StaticResource SecMuted}" Margin="0,2,0,6" TextTrimming="CharacterEllipsis"/>
                                <ProgressBar Value="{Binding ScanProgress, Mode=OneWay}" Maximum="100" Height="5" Foreground="{StaticResource SecBrandGradient}"
                                             Background="#1AFFFFFF" BorderThickness="0"/>
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="{Binding ScanProgress, StringFormat={}{0:F0}%}" FontSize="24" FontWeight="Bold"
                                       Margin="16,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource SecInfo}"/>
                        </Grid>
                    </Border>

                    <!-- Resultados -->
                    <Border Grid.Row="2" Style="{StaticResource SecCard}" Padding="14" Margin="0,12,0,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Style="{StaticResource SecH1}" Text="{Binding ScanResultType}"/>
                                    <TextBlock Text="{Binding ScanResultSummary}" Style="{StaticResource SecMuted}" Margin="0,2,0,0"/>
                                </StackPanel>
                                <Button Grid.Column="1" Command="{Binding ClearScanResultsCommand}" Style="{StaticResource SecGhost}"
                                        Visibility="{Binding IsScanResultVisible, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="{Binding [Loc_ToClose], Source={x:Static services:LocalizationService.Instance}}" FontSize="12" FontWeight="SemiBold"/>
                                </Button>
                            </Grid>

                            <Grid Grid.Row="1" Margin="0,10,0,0">
                                <ScrollViewer Style="{StaticResource SecScroll}">
                                    <ItemsControl ItemsSource="{Binding ScanThreatItems}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource SecRow}" Margin="0,0,0,6">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Grid.Column="0">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="{Binding Name}" Style="{StaticResource SecH2}" TextTrimming="CharacterEllipsis"/>
                                                                <Border CornerRadius="7" Padding="8,2" Margin="8,0,0,0" VerticalAlignment="Center">
                                                                    <Border.Background>
                                                                        <SolidColorBrush Color="{Binding SeverityColor.Color}" Opacity="0.18"/>
                                                                    </Border.Background>
                                                                    <TextBlock Text="{Binding SeverityText}" FontSize="10" FontWeight="Bold"
                                                                               Foreground="{Binding SeverityColor}"/>
                                                                </Border>
                                                            </StackPanel>
                                                            <TextBlock Text="{Binding Path}" Style="{StaticResource SecMuted}" TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/>
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                            <Button Command="{Binding DataContext.IgnoreScanThreatCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                    CommandParameter="{Binding}" Style="{StaticResource SecGhost}" Height="30" Padding="12,0">
                                                                <TextBlock Text="{Binding [Loc_Ignore], Source={x:Static services:LocalizationService.Instance}}" FontSize="11" FontWeight="SemiBold"/>
                                                            </Button>
                                                            <Button Command="{Binding DataContext.QuarantineScanThreatCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                    CommandParameter="{Binding}" Style="{StaticResource SecPrimary}" Height="30" Padding="12,0" Margin="6,0,0,0">
                                                                <TextBlock Text="{Binding [Loc_Quarantine], Source={x:Static services:LocalizationService.Instance}}" FontSize="11" FontWeight="Bold" Foreground="#FFFFFF"/>
                                                            </Button>
                                                            <Button Command="{Binding DataContext.RemoveScanThreatCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                    CommandParameter="{Binding}" Style="{StaticResource SecDangerGhost}" Height="30" Padding="12,0" Margin="6,0,0,0">
                                                                <TextBlock Text="{Binding [Loc_Remove], Source={x:Static services:LocalizationService.Instance}}" FontSize="11" FontWeight="SemiBold"/>
                                                            </Button>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>

                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ScanThreatItems.Count}" Value="0">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <Path Data="{StaticResource SecIconCheck}" Fill="{StaticResource SecOn}" Width="30" Height="30" Stretch="Uniform"/>
                                    <TextBlock Text="{Binding [ShieldAwaitingScan], Source={x:Static services:LocalizationService.Instance}}"
                                               Style="{StaticResource SecMuted}" Margin="0,8,0,0" TextAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>

                <!-- ══════════ ABA 2 — AMEAÇAS ══════════ -->
                <Grid Visibility="{Binding ShieldTabThreats, Converter={StaticResource BoolToVis}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Style="{StaticResource SecCard}" Padding="14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Style="{StaticResource SecLabel}" Text="{Binding [Loc_ThreatsDetected_3], Source={x:Static services:LocalizationService.Instance}}"/>
                                <TextBlock Text="{Binding ThreatsDetected}" Style="{StaticResource SecValue}" Foreground="{StaticResource SecDanger}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                <TextBlock Style="{StaticResource SecLabel}" Text="{Binding [Loc_Quarantine], Source={x:Static services:LocalizationService.Instance}}"/>
                                <TextBlock Text="{Binding QuarantineCount}" Style="{StaticResource SecValue}" Foreground="{StaticResource SecWarn}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Margin="10,0,0,0">
                                <TextBlock Style="{StaticResource SecLabel}" Text="{Binding [ShieldActiveThreats], Source={x:Static services:LocalizationService.Instance}}"/>
                                <TextBlock Text="{Binding ActiveThreatsCount}" Style="{StaticResource SecValue}" Foreground="{StaticResource SecDanger}"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="1" Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Detecções com ação -->
                        <Border Grid.Column="0" Style="{StaticResource SecCard}" Padding="14" Margin="0,0,6,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Style="{StaticResource SecLabel}"
                                           Text="{Binding [ShieldLastDetections], Source={x:Static services:LocalizationService.Instance}}"/>
                                <Grid Grid.Row="1" Margin="0,8,0,0">
                                    <ScrollViewer Style="{StaticResource SecScroll}">
                                        <ItemsControl ItemsSource="{Binding ScanThreatItems}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Style="{StaticResource SecRow}" Margin="0,0,0,6">
                                                        <StackPanel>
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Grid.Column="0" Text="{Binding Name}" Style="{StaticResource SecH2}" TextTrimming="CharacterEllipsis"/>
                                                                <Border Grid.Column="1" CornerRadius="7" Padding="8,2" VerticalAlignment="Center">
                                                                    <Border.Background>
                                                                        <SolidColorBrush Color="{Binding SeverityColor.Color}" Opacity="0.18"/>
                                                                    </Border.Background>
                                                                    <TextBlock Text="{Binding SeverityText}" FontSize="10" FontWeight="Bold"
                                                                               Foreground="{Binding SeverityColor}"/>
                                                                </Border>
                                                            </Grid>
                                                            <TextBlock Text="{Binding Path}" Style="{StaticResource SecMuted}" TextTrimming="CharacterEllipsis" Margin="0,3,0,8"/>
                                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                                <Button Command="{Binding DataContext.IgnoreScanThreatCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                        CommandParameter="{Binding}" Style="{StaticResource SecGhost}" Height="28" Padding="12,0">
                                                                    <TextBlock Text="{Binding [Loc_Ignore], Source={x:Static services:LocalizationService.Instance}}" FontSize="11" FontWeight="SemiBold"/>
                                                                </Button>
                                                                <Button Command="{Binding DataContext.QuarantineScanThreatCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                        CommandParameter="{Binding}" Style="{StaticResource SecPrimary}" Height="28" Padding="12,0" Margin="6,0,0,0">
                                                                    <TextBlock Text="{Binding [Loc_Quarantine], Source={x:Static services:LocalizationService.Instance}}" FontSize="11" FontWeight="Bold" Foreground="#FFFFFF"/>
                                                                </Button>
                                                                <Button Command="{Binding DataContext.RemoveScanThreatCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                        CommandParameter="{Binding}" Style="{StaticResource SecDangerGhost}" Height="28" Padding="12,0" Margin="6,0,0,0">
                                                                    <TextBlock Text="{Binding [Loc_Remove], Source={x:Static services:LocalizationService.Instance}}" FontSize="11" FontWeight="SemiBold"/>
                                                                </Button>
                                                            </StackPanel>
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>

                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ScanThreatItems.Count}" Value="0">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <Path Data="{StaticResource SecIconCheck}" Fill="{StaticResource SecOn}" Width="32" Height="32" Stretch="Uniform"/>
                                        <TextBlock Text="{Binding [ShieldNoDetections], Source={x:Static services:LocalizationService.Instance}}"
                                                   Style="{StaticResource SecMuted}" Margin="0,8,0,0" TextAlignment="Center"/>
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Border>

                        <!-- Quarentena -->
                        <Border Grid.Column="1" Style="{StaticResource SecCard}" Padding="14" Margin="6,0,0,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Style="{StaticResource SecLabel}"
                                           Text="{Binding [ShieldQuarantineList], Source={x:Static services:LocalizationService.Instance}}"/>
                                <Button Grid.Row="0" HorizontalAlignment="Right" Style="{StaticResource SecGhost}"
                                        Height="28" Padding="10,0" VerticalAlignment="Top"
                                        Command="{Binding RefreshQuarantineCommand}">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource SecIconRefresh}" Fill="{DynamicResource TextPrimary}" Width="12" Height="12" Stretch="Uniform" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding [Loc_ToUpdate], Source={x:Static services:LocalizationService.Instance}}" Margin="6,0,0,0"
                                                   FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Grid Grid.Row="1" Margin="0,8,0,0">
                                    <ScrollViewer Style="{StaticResource SecScroll}">
                                        <ItemsControl ItemsSource="{Binding QuarantineItems}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Style="{StaticResource SecRow}" Margin="0,0,0,6">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel Grid.Column="0">
                                                                <StackPanel Orientation="Horizontal">
                                                                    <Border Width="8" Height="8" CornerRadius="4" Margin="0,0,8,0" VerticalAlignment="Center">
                                                                        <Border.Background>
                                                                            <SolidColorBrush Color="{Binding SeverityColor.Color}"/>
                                                                        </Border.Background>
                                                                    </Border>
                                                                    <TextBlock Text="{Binding OriginalName}" Style="{StaticResource SecH2}" TextTrimming="CharacterEllipsis"/>
                                                                </StackPanel>
                                                                <TextBlock Text="{Binding Reason}" Style="{StaticResource SecMuted}" TextTrimming="CharacterEllipsis" Margin="16,2,0,0"/>
                                                                <TextBlock Style="{StaticResource SecMuted}" Margin="16,2,0,0">
                                                                    <Run Text="{Binding SizeDisplay, Mode=OneWay}"/>
                                                                    <Run Text=" · "/>
                                                                    <Run Text="{Binding QuarantinedDate, Mode=OneWay}"/>
                                                                </TextBlock>
                                                            </StackPanel>
                                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
<Button Command="{Binding DataContext.RestoreQuarantineItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                        CommandParameter="{Binding}" Style="{StaticResource SecGhost}" Height="28" Padding="10,0"
                                                                        ToolTip="{Binding [ShieldOpRestoreFromQuarantine], Source={x:Static services:LocalizationService.Instance}}"
                                                                        AutomationProperties.Name="{Binding [ShieldOpRestoreFromQuarantine], Source={x:Static services:LocalizationService.Instance}}">
                                                                    <Path Data="{StaticResource SecIconRestore}" Fill="{DynamicResource TextPrimary}" Width="13" Height="13" Stretch="Uniform"/>
                                                                </Button>
<Button Command="{Binding DataContext.DeleteQuarantineItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                        CommandParameter="{Binding}" Style="{StaticResource SecDangerGhost}" Height="28" Padding="10,0" Margin="6,0,0,0"
                                                                        ToolTip="{Binding [ShieldOpDeleteForever], Source={x:Static services:LocalizationService.Instance}}"
                                                                        AutomationProperties.Name="{Binding [ShieldOpDeleteForever], Source={x:Static services:LocalizationService.Instance}}">
                                                                    <Path Data="{StaticResource SecIconTrash}" Fill="{StaticResource SecDanger}" Width="13" Height="13" Stretch="Uniform"/>
                                                                </Button>
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>

                                    <TextBlock Text="{Binding [Loc_NoItemsInQuarantineSystem], Source={x:Static services:LocalizationService.Instance}}"
                                               Style="{StaticResource SecMuted}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Visibility="{Binding QuarantineCount, Converter={StaticResource ZeroToVis}}"/>
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>

                <!-- ══════════ ABA 3 — REDE ══════════ -->
                <Grid Visibility="{Binding ShieldTabNetwork, Converter={StaticResource BoolToVis}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Style="{StaticResource SecCard}" Padding="14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Style="{StaticResource SecLabel}" Text="{Binding [Loc_OnlineDevices], Source={x:Static services:LocalizationService.Instance}}"/>
                                <TextBlock Style="{StaticResource SecValue}" Foreground="{StaticResource SecOn}">
                                    <Run Text="{Binding OnlineDevicesCount, Mode=OneWay}"/>
                                </TextBlock>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                <TextBlock Style="{StaticResource SecLabel}" Text="{Binding [Loc_Total], Source={x:Static services:LocalizationService.Instance}}"/>
                                <TextBlock Text="{Binding TotalDevicesCount}" Style="{StaticResource SecValue}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Margin="10,0,0,0">
                                <TextBlock Style="{StaticResource SecLabel}" Text="{Binding [Loc_ActiveConnections], Source={x:Static services:LocalizationService.Instance}}"/>
                                <TextBlock Text="{Binding ActiveConnectionsCount}" Style="{StaticResource SecValue}" Foreground="{StaticResource SecInfo}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="3" Margin="10,0,0,0">
                                <TextBlock Style="{StaticResource SecLabel}" Text="{Binding [Loc_SuspiciousConnections], Source={x:Static services:LocalizationService.Instance}}"/>
                                <TextBlock Text="{Binding SuspiciousConnectionsCount}" Style="{StaticResource SecValue}" Foreground="{StaticResource SecDanger}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                                <controls:ProBadge VerticalAlignment="Center" Margin="0,0,8,0" Text="PRO" Tip="{Binding [ProBadgeTip], Source={x:Static services:LocalizationService.Instance}}"/>
                                <Button Command="{Binding ToggleNetworkMonitoringCommand}" Style="{StaticResource SecPrimary}" Height="34" Padding="14,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock FontSize="12" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="{Binding [Loc_StartMonitor], Source={x:Static services:LocalizationService.Instance}}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsNetworkMonitoringActive}" Value="True">
                                                            <Setter Property="Text" Value="{Binding [Loc_StopMonitor], Source={x:Static services:LocalizationService.Instance}}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </Button>
                                <Button Command="{Binding RunNetworkScanCommand}" Style="{StaticResource SecGhost}" Height="34" Padding="14,0" Margin="8,0,0,0">
                                    <TextBlock Text="{Binding [Loc_ScanNetwork], Source={x:Static services:LocalizationService.Instance}}" FontSize="12" FontWeight="SemiBold"/>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="1" Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource SecCard}" Padding="14" Margin="0,0,6,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Style="{StaticResource SecLabel}"
                                           Text="{Binding [ShieldDevices], Source={x:Static services:LocalizationService.Instance}}"/>
                                <Grid Grid.Row="1" Margin="0,8,0,0">
                                    <ScrollViewer Style="{StaticResource SecScroll}">
                                        <ItemsControl ItemsSource="{Binding NetworkDevices}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Style="{StaticResource SecRow}" Margin="0,0,0,6" Padding="10,8">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>

                                                            <!-- Ícone moderno conforme o tipo do dispositivo:
                                                                 PC, notebook, celular, tablet, roteador, TV,
                                                                 console, câmera, impressora, caixa de som, etc. -->
                                                            <Border Grid.Column="0" Width="34" Height="34" CornerRadius="10"
                                                                    Margin="0,0,10,0" VerticalAlignment="Center">
                                                                <Border.Background>
                                                                    <SolidColorBrush Color="#338B31FF" Opacity="0.18"/>
                                                                </Border.Background>
                                                                <Viewbox Width="19" Height="19" Stretch="Uniform">
                                                                    <Canvas Width="24" Height="24">
                                                                        <Path StrokeThickness="1.8"
                                                                              StrokeStartLineCap="Round"
                                                                              StrokeEndLineCap="Round"
                                                                              StrokeLineJoin="Round"
                                                                              Fill="Transparent">
                                                                            <Path.Data>
                                                                                <MultiBinding Converter="{StaticResource DeviceGlyphConv}">
                                                                                    <Binding Path="DeviceType"/>
                                                                                    <Binding Path="OperatingSystem"/>
                                                                                    <Binding Path="Vendor"/>
