<Window xmlns:services="clr-namespace:VoltrisOptimizer.Services" x:Class="VoltrisOptimizer.UI.Views.RecoveryInfoPage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding [RecoveryCompleteGuide], Source={x:Static services:LocalizationService.Instance}}"
        Width="800" Height="860"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        MinWidth="620" MinHeight="500"
        Background="{DynamicResource DarkBrush}">

    <Window.Resources>
        <Style x:Key="TutorialCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource DarkPanelBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource DarkBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="20,16"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <Style x:Key="BodyText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="LineHeight" Value="20"/>
        </Style>

        <Style x:Key="TagBadge" TargetType="Border">
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- Background decorativo -->
        <Grid IsHitTestVisible="False" ClipToBounds="True">
            <Ellipse Width="360" Height="360"
                     Fill="{DynamicResource AccentBlurBrush}"
                     HorizontalAlignment="Right" VerticalAlignment="Top"
                     Margin="0,-100,-130,0">
                <Ellipse.Effect>
                    <BlurEffect Radius="90"/>
                </Ellipse.Effect>
            </Ellipse>
        </Grid>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="32,28,32,36">

                <!-- ======== HEADER ======== -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <Border Width="44" Height="44" CornerRadius="11" Margin="0,0,14,0" VerticalAlignment="Center">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#31A8FF" Offset="0"/>
                                <GradientStop Color="#8B31FF" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <!-- Ícone HD/Recuperação -->
                        <Path Data="M6,2H18A2,2 0 0,1 20,4V20A2,2 0 0,1 18,22H6A2,2 0 0,1 4,20V4A2,2 0 0,1 6,2M12,10A3,3 0 0,0 9,13A3,3 0 0,0 12,16A3,3 0 0,0 15,13A3,3 0 0,0 12,10M6,4V8H18V4H6M14,13A2,2 0 0,1 12,15A2,2 0 0,1 10,13A2,2 0 0,1 12,11A2,2 0 0,1 14,13Z"
                              Fill="White" Width="20" Height="20" Stretch="Uniform"
                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding [RecoveryCompleteGuide], Source={x:Static services:LocalizationService.Instance}}"
                                   FontFamily="Segoe UI Variable Display, Segoe UI"
                                   FontSize="24" FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock Text="{Binding [RecoveryUnderstandRecovery], Source={x:Static services:LocalizationService.Instance}}"
                                   FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,3,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </StackPanel>

                <Separator Background="#15FFFFFF" Margin="0,14,0,18"/>

                <!-- ======== 1. COMO FUNCIONA A RECUPERAÇÃO ======== -->
                <Border Style="{StaticResource TutorialCard}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Border Width="28" Height="28" CornerRadius="7" Background="#2531A8FF" Margin="0,0,8,0" VerticalAlignment="Center">
                                <Path Data="M11,7H13V9H11V7M11,11H13V17H11V11M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2M12,20C7.59,20 4,16.41 4,12C4,7.59 7.59,4 12,4C16.41,4 20,7.59 20,12C20,16.41 16.41,20 12,20Z"
                                      Fill="#31A8FF" Width="14" Height="14" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="{Binding [RecoveryHowItWorks], Source={x:Static services:LocalizationService.Instance}}" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" Margin="0"/>
                        </StackPanel>
                        <TextBlock Style="{StaticResource BodyText}">
                            <Run Text="{Binding [RecoveryDeleteExplanationPart1], Source={x:Static services:LocalizationService.Instance}, Mode=OneWay}"/><Bold><Run Text="{Binding [RecoveryDeleteExplanationPart2], Source={x:Static services:LocalizationService.Instance}, Mode=OneWay}"/></Bold><Run Text="{Binding [RecoveryDeleteExplanationPart3], Source={x:Static services:LocalizationService.Instance}, Mode=OneWay}"/>
                        </TextBlock>
                        <TextBlock Style="{StaticResource BodyText}" Margin="0,8,0,0">
                            <Run Text="{Binding [RecoveryEngineApproachPart1], Source={x:Static services:LocalizationService.Instance}, Mode=OneWay}"/><Bold><Run Text="{Binding [RecoveryEngineApproachPart2], Source={x:Static services:LocalizationService.Instance}, Mode=OneWay}"/></Bold><Run Text="{Binding [RecoveryEngineApproachPart3], Source={x:Static services:LocalizationService.Instance}, Mode=OneWay}"/>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- ======== 2. SCAN RÁPIDO (MFT) ======== -->
                <Border Style="{StaticResource TutorialCard}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Border Width="28" Height="28" CornerRadius="7" Background="#2531A8FF" Margin="0,0,8,0" VerticalAlignment="Center">
                                <Path Data="M13,3A9,9 0 0,0 4,12H1L4.89,15.89L4.96,16.03L9,12H6A7,7 0 0,1 13,5A7,7 0 0,1 20,12A7,7 0 0,1 13,19C11.07,19 9.32,18.21 8.06,16.94L6.64,18.36C8.27,19.99 10.51,21 13,21A9,9 0 0,0 22,12A9,9 0 0,0 13,3Z"
                                      Fill="#31A8FF" Width="14" Height="14" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="{Binding [RecoveryQuickScanMft], Source={x:Static services:LocalizationService.Instance}}" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" Margin="0"/>
                        </StackPanel>
                        <TextBlock Style="{StaticResource BodyText}" Margin="0,0,0,8">
                            <Run Text="{Binding [RecoveryQuickScanMftExplanationPart1], Source={x:Static services:LocalizationService.Instance}, Mode=OneWay}"/><Bold><Run Text="{Binding [RecoveryQuickScanMftExplanationPart2], Source={x:Static services:LocalizationService.Instance}, Mode=OneWay}"/></Bold><Run Text="{Binding [RecoveryQuickScanMftExplanationPart3], Source={x:Static services:LocalizationService.Instance}, Mode=OneWay}"/>
                        </TextBlock>
                        <TextBlock Text="{Binding [RecoveryAdvantages], Source={x:Static services:LocalizationService.Instance}}" Style="{StaticResource BodyText}" FontWeight="Medium" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,6"/>
                        <TextBlock Text="{Binding [RecoveryOriginalName], Source={x:Static services:LocalizationService.Instance}}" Style="{StaticResource BodyText}" Margin="12,0,0,4"/>
                        <TextBlock Text="{Binding [RecoveryShowsOriginalPath], Source={x:Static services:LocalizationService.Instance}}" Style="{StaticResource BodyText}" Margin="12,0,0,4"/>
                        <TextBlock Text="{Binding [RecoveryFasterThanDeepScan], Source={x:Static services:LocalizationService.Instance}}" Style="{StaticResource BodyText}" Margin="12,0,0,4"/>
                        <TextBlock Text="{Binding [RecoveryLimitations], Source={x:Static services:LocalizationService.Instance}}" Style="{StaticResource BodyText}" FontWeight="Medium" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,10,0,6"/>
                        <TextBlock Text="{Binding [RecoveryMftReused], Source={x:Static services:LocalizationService.Instance}}" Style="{StaticResource BodyText}" Margin="12,0,0,4"/>
                        <TextBlock Text="{Binding [RecoverySsdTrimZeroed], Source={x:Static services:LocalizationService.Instance}}" Style="{StaticResource BodyText}" Margin="12,0,0,4"/>
                    </StackPanel>
                </Border>

                <!-- ======== 3. DEEP SCAN ======== -->
                <Border Style="{StaticResource TutorialCard}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Border Width="28" Height="28" CornerRadius="7" Background="#258B31FF" Margin="0,0,8,0" VerticalAlignment="Center">
                                <Path Data="M9.5,3A6.5,6.5 0 0,1 16,9.5C16,11.11 15.41,12.59 14.44,13.73L14.71,14H15.5L20.5,19L19,20.5L14,15.5V14.71L13.73,14.44C12.59,15.41 11.11,16 9.5,16A6.5,6.5 0 0,1 3,9.5A6.5,6.5 0 0,1 9.5,3M9.5,5C7,5 5,7 5,9.5C5,12 7,14 9.5,14C12,14 14,12 14,9.5C14,7 12,5 9.5,5Z"
                                      Fill="#8B31FF" Width="14" Height="14" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="{Binding [RecoveryDeepScanSignature], Source={x:Static services:LocalizationService.Instance}}" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" Margin="0"/>
                        </StackPanel>
                        <TextBlock Style="{StaticResource BodyText}" Margin="0,0,0,8">
                            <Run Text="{Binding [RecoveryDeepScanExplanationPart1], Source={x:Static services:LocalizationService.Instance}, Mode=OneWay}"/><Bold><Run Text="{Binding [RecoveryDeepScanExplanationPart2], Source={x:Static services:LocalizationService.Instance}, Mode=OneWay}"/></Bold><Run Text="{Binding [RecoveryDeepScanExplanationPart3], Source={x:Static services:LocalizationService.Instance}, Mode=OneWay}"/>
                        </TextBlock>
                        <TextBlock Style="{StaticResource BodyText}" Margin="0,0,0,8">
                            <Run Text="{Binding [RecoveryDeepScanExamplePart1], Source={x:Static services:LocalizationService.Instance}, Mode=OneWay}"/><Bold><Run Text="{Binding [RecoveryDeepScanExamplePart2], Source={x:Static services:LocalizationService.Instance}, Mode=OneWay}"/></Bold><Run Text="{Binding [RecoveryDeepScanExamplePart3], Source={x:Static services:LocalizationService.Instance}, Mode=OneWay}"/>
                        </TextBlock>
                        <TextBlock Text="{Binding [RecoveryRecoveredFileName], Source={x:Static services:LocalizationService.Instance}}" Style="{StaticResource BodyText}" FontWeight="Medium" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,6"/>
                        <TextBlock Style="{StaticResource BodyText}" Margin="12,0,0,4">
                            <Run Text="{Binding [RecoveryNameExplanationPart1], Source={x:Static services:LocalizationService.Instance}, Mode=OneWay}"/><Bold><Run Text="{Binding [RecoveryNameExplanationPart2], Source={x:Static services:LocalizationService.Instance}, Mode=OneWay}"/></Bold><Run Text="{Binding [RecoveryNameExplanationPart3], Source={x:Static services:LocalizationService.Instance}, Mode=OneWay}"/><Italic><Run Text="{Binding [RecoveryNameExplanationPart4], Source={x:Static services:LocalizationService.Instance}, Mode=OneWay}"/></Italic><Run Text="{Binding [RecoveryNameExplanationPart5], Source={x:Static services:LocalizationService.Instance}, Mode=OneWay}"/>
                        </TextBlock>
                        <TextBlock Text="{Binding [RecoverySupportedFormats], Source={x:Static services:LocalizationService.Instance}}" Style="{StaticResource BodyText}" FontWeight="Medium" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,10,0,6"/>
                        <WrapPanel Margin="0,0,0,0">
                            <Border Style="{StaticResource TagBadge}" Background="#151657C0" Margin="0,0,6,6"><TextBlock Text="{Binding [RecoveryJpgJpeg], Source={x:Static services:LocalizationService.Instance}}" Foreground="#5B9CF6" FontSize="11"/></Border>
                            <Border Style="{StaticResource TagBadge}" Background="#1510B981" Margin="0,0,6,6"><TextBlock Text="{Binding [RecoveryPng], Source={x:Static services:LocalizationService.Instance}}" Foreground="#10B981" FontSize="11"/></Border>
                            <Border Style="{StaticResource TagBadge}" Background="#15EAB308" Margin="0,0,6,6"><TextBlock Text="{Binding [RecoveryGif], Source={x:Static services:LocalizationService.Instance}}" Foreground="#EAB308" FontSize="11"/></Border>
                            <Border Style="{StaticResource TagBadge}" Background="#158B31FF" Margin="0,0,6,6"><TextBlock Text="{Binding [RecoveryBmp], Source={x:Static services:LocalizationService.Instance}}" Foreground="#8B31FF" FontSize="11"/></Border>
                            <Border Style="{StaticResource TagBadge}" Background="#151657C0" Margin="0,0,6,6"><TextBlock Text="{Binding [RecoveryWebp], Source={x:Static services:LocalizationService.Instance}}" Foreground="#5B9CF6" FontSize="11"/></Border>
                            <Border Style="{StaticResource TagBadge}" Background="#15FF4B6B" Margin="0,0,6,6"><TextBlock Text="{Binding [RecoveryIco], Source={x:Static services:LocalizationService.Instance}}" Foreground="#FF4B6B" FontSize="11"/></Border>
                            <Border Style="{StaticResource TagBadge}" Background="#15FF4B6B" Margin="0,0,6,6"><TextBlock Text="{Binding [RecoveryMp4], Source={x:Static services:LocalizationService.Instance}}" Foreground="#FF4B6B" FontSize="11"/></Border>
                            <Border Style="{StaticResource TagBadge}" Background="#158B31FF" Margin="0,0,6,6"><TextBlock Text="{Binding [RecoveryMkv], Source={x:Static services:LocalizationService.Instance}}" Foreground="#8B31FF" FontSize="11"/></Border>
                            <Border Style="{StaticResource TagBadge}" Background="#1531A8FF" Margin="0,0,6,6"><TextBlock Text="{Binding [RecoveryAvi], Source={x:Static services:LocalizationService.Instance}}" Foreground="#31A8FF" FontSize="11"/></Border>
                            <Border Style="{StaticResource TagBadge}" Background="#1531A8FF" Margin="0,0,6,6"><TextBlock Text="{Binding [RecoveryMov], Source={x:Static services:LocalizationService.Instance}}" Foreground="#31A8FF" FontSize="11"/></Border>
                            <Border Style="{StaticResource TagBadge}" Background="#15EAB308" Margin="0,0,6,6"><TextBlock Text="{Binding [RecoveryMp3], Source={x:Static services:LocalizationService.Instance}}" Foreground="#EAB308" FontSize="11"/></Border>
                            <Border Style="{StaticResource TagBadge}" Background="#1510B981" Margin="0,0,6,6"><TextBlock Text="{Binding [RecoveryFlacWav], Source={x:Static services:LocalizationService.Instance}}" Foreground="#10B981" FontSize="11"/></Border>
                            <Border Style="{StaticResource TagBadge}" Background="#151657C0" Margin="0,0,6,6"><TextBlock Text="{Binding [RecoveryPdf], Source={x:Static services:LocalizationService.Instance}}" Foreground="#5B9CF6" FontSize="11"/></Border>
                            <Border Style="{StaticResource TagBadge}" Background="#15EAB308" Margin="0,0,6,6"><TextBlock Text="{Binding [RecoveryZipRar7z], Source={x:Static services:LocalizationService.Instance}}" Foreground="#EAB308" FontSize="11"/></Border>
                            <Border Style="{StaticResource TagBadge}" Background="#15FF4B6B" Margin="0,0,6,6"><TextBlock Text="{Binding [RecoveryExeDll], Source={x:Static services:LocalizationService.Instance}}" Foreground="#FF4B6B" FontSize="11"/></Border>
                            <Border Style="{StaticResource TagBadge}" Background="#158B31FF" Margin="0,0,6,6"><TextBlock Text="{Binding [RecoveryDocDocx], Source={x:Static services:LocalizationService.Instance}}" Foreground="#8B31FF" FontSize="11"/></Border>
                            <Border Style="{StaticResource TagBadge}" Background="#151657C0" Margin="0,0,6,6"><TextBlock Text="{Binding [RecoverySqliteDb], Source={x:Static services:LocalizationService.Instance}}" Foreground="#5B9CF6" FontSize="11"/></Border>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <!-- ======== 4. SSD vs HDD ======== -->
                <Border Style="{StaticResource TutorialCard}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Border Width="28" Height="28" CornerRadius="7" Background="#25EAB308" Margin="0,0,8,0" VerticalAlignment="Center">
                                <Path Data="M7,2v11h3v9l7-12h-4l4-8H7z" Fill="#EAB308" Width="14" Height="14" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="{Binding [RecoverySsdHddDifference], Source={x:Static services:LocalizationService.Instance}}" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" Margin="0"/>
                        </StackPanel>

                        <!-- HDD -->
                        <Border Background="#1010B981" CornerRadius="8" Padding="14,12" Margin="0,0,0,10">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <Path Data="M12,3A9,9 0 0,0 3,12A9,9 0 0,0 12,21A9,9 0 0,0 21,12A9,9 0 0,0 12,3M12,15A3,3 0 0,1 9,12A3,3 0 0,1 12,9A3,3 0 0,1 15,12A3,3 0 0,1 12,15M12,10.5A1.5,1.5 0 0,0 10.5,12A1.5,1.5 0 0,0 12,13.5A1.5,1.5 0 0,0 13.5,12A1.5,1.5 0 0,0 12,10.5Z" Fill="#10B981" Width="16" Height="16" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding [RecoveryHdd], Source={x:Static services:LocalizationService.Instance}}" FontSize="13" FontWeight="SemiBold" Foreground="#10B981" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Text="{Binding [RecoveryFilesPhysicallyOnDisk], Source={x:Static services:LocalizationService.Instance}}" Style="{StaticResource BodyText}" Margin="0,0,0,4"/>
                                <TextBlock Text="{Binding [RecoveryHighProbability], Source={x:Static services:LocalizationService.Instance}}" Style="{StaticResource BodyText}" Margin="12,2,0,0"/>
                                <TextBlock Text="{Binding [RecoveryDataPersists], Source={x:Static services:LocalizationService.Instance}}" Style="{StaticResource BodyText}" Margin="12,2,0,0"/>
                                <TextBlock Text="{Binding [RecoveryBothScansEffective], Source={x:Static services:LocalizationService.Instance}}" Style="{StaticResource BodyText}" Margin="12,2,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- SSD -->
                        <Border Background="#15FF4B6B" CornerRadius="8" Padding="14,12" Margin="0,0,0,0">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <Path Data="M6,2C4.89,2 4,2.89 4,4V20C4,21.11 4.89,22 6,22H18C19.11,22 20,21.11 20,20V8L14,2M12,19A3,3 0 0,1 9,16A3,3 0 0,1 12,13A3,3 0 0,1 15,16A3,3 0 0,1 12,19M15,10V5H6V10H15Z" Fill="#FF4B6B" Width="16" Height="16" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding [RecoverySsdTrimProblem], Source={x:Static services:LocalizationService.Instance}}" FontSize="13" FontWeight="SemiBold" Foreground="#FF4B6B" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Style="{StaticResource BodyText}" Margin="0,0,0,6">
                                    <Run Text="{Binding [RecoverySsdTrimExplanationPart1], Source={x:Static services:LocalizationService.Instance}, Mode=OneWay}"/><Bold><Run Text="{Binding [RecoverySsdTrimExplanationPart2], Source={x:Static services:LocalizationService.Instance}, Mode=OneWay}"/></Bold><Run Text="{Binding [RecoverySsdTrimExplanationPart3], Source={x:Static services:LocalizationService.Instance}, Mode=OneWay}"/><Bold><Run Text="{Binding [RecoverySsdTrimExplanationPart4], Source={x:Static services:LocalizationService.Instance}, Mode=OneWay}"/></Bold><Run Text="{Binding [RecoverySsdTrimExplanationPart5], Source={x:Static services:LocalizationService.Instance}, Mode=OneWay}"/>
                                </TextBlock>
                                <TextBlock Text="{Binding [RecoveryTrimDestroyedData], Source={x:Static services:LocalizationService.Instance}}" Style="{StaticResource BodyText}" Margin="12,2,0,0"/>
                                <TextBlock Text="{Binding [RecoveryTrimNoRecovery], Source={x:Static services:LocalizationService.Instance}}" Style="{StaticResource BodyText}" Margin="12,2,0,0"/>
                                <TextBlock Text="{Binding [RecoveryQuickScanNameZeroed], Source={x:Static services:LocalizationService.Instance}}" Style="{StaticResource BodyText}" Margin="12,2,0,0"/>
                                <TextBlock Text="{Binding [RecoveryVssScanIndependent], Source={x:Static services:LocalizationService.Instance}}" Style="{StaticResource BodyText}" Margin="12,2,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- ======== 5. TRIM ======== -->
                <Border Style="{StaticResource TutorialCard}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Border Width="28" Height="28" CornerRadius="7" Background="#25FF4B6B" Margin="0,0,8,0" VerticalAlignment="Center">
                                <Path Data="M19,6.41L17.59,5L12,10.59L6.41,5L5,6.41L10.59,12L5,17.59L6.41,19L12,13.41L17.59,19L19,17.59L13.41,12L19,6.41Z"
                                      Fill="#FF4B6B" Width="14" Height="14" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="{Binding [RecoveryWhatIsTrim], Source={x:Static services:LocalizationService.Instance}}" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" Margin="0"/>
                        </StackPanel>
                        <TextBlock Text="{Binding [RecoveryTrimDefault], Source={x:Static services:LocalizationService.Instance}}" Style="{StaticResource BodyText}" Margin="0,0,0,10"/>
                        <Border Background="#0F0F14" CornerRadius="8" Padding="16,12" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="{Binding [RecoveryCheckTrimStatus], Source={x:Static services:LocalizationService.Instance}}" FontSize="12" Foreground="#8B8BA0" Margin="0,0,0,4"/>
                                <TextBlock Text="{Binding [RecoveryFsutilCommand], Source={x:Static services:LocalizationService.Instance}}" FontFamily="Cascadia Code, Consolas, Courier New" FontSize="13" Foreground="#31A8FF"/>
                                <TextBlock Text="" Margin="0,8,0,0"/>
                                <TextBlock Text="{Binding [RecoveryTrimResult], Source={x:Static services:LocalizationService.Instance}}" FontSize="12" Foreground="#8B8BA0"/>
                            </StackPanel>
                        </Border>
                        <TextBlock Text="{Binding [RecoveryCanDisableTrim], Source={x:Static services:LocalizationService.Instance}}" Style="{StaticResource BodyText}" Margin="0,0,0,6" FontWeight="Medium" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock Style="{StaticResource BodyText}">
                            <Run Text="{Binding [RecoveryTrimRecommendedPart1], Source={x:Static services:LocalizationService.Instance}, Mode=OneWay}"/><Bold><Run Text="{Binding [RecoveryTrimRecommendedPart2], Source={x:Static services:LocalizationService.Instance}, Mode=OneWay}"/></Bold><Run Text="{Binding [RecoveryTrimRecommendedPart3], Source={x:Static services:LocalizationService.Instance}, Mode=OneWay}"/><Bold><Run Text="{Binding [RecoveryTrimRecommendedPart4], Source={x:Static services:LocalizationService.Instance}, Mode=OneWay}"/></Bold><Run Text="{Binding [RecoveryTrimRecommendedPart5], Source={x:Static services:LocalizationService.Instance}, Mode=OneWay}"/>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- ======== 6. SCAN VSS (SHADOW COPY) ======== -->
                <Border Margin="0,0,0,14" CornerRadius="12" Padding="20,16">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#1531A8FF" Offset="0"/>
                            <GradientStop Color="#158B31FF" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Border.BorderBrush>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#3031A8FF" Offset="0"/>
                            <GradientStop Color="#308B31FF" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.BorderBrush>
                    <Border.BorderThickness>1</Border.BorderThickness>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Border Width="28" Height="28" CornerRadius="7" Margin="0,0,8,0" VerticalAlignment="Center">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#2531A8FF" Offset="0"/>
                                        <GradientStop Color="#258B31FF" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Path Data="M12,20A7,7 0 0,1 5,13A7,7 0 0,1 12,6A7,7 0 0,1 19,13A7,7 0 0,1 12,20M19.03,7.39L20.45,5.97C20,5.46 19.55,5 19.04,4.56L17.62,6C16.07,4.74 14.12,4 12,4A9,9 0 0,0 3,13A9,9 0 0,0 12,22C17,22 21,17.97 21,13C21,10.88 20.26,8.93 19.03,7.39M11,14H13V8H11M15,1H9V3H15V1Z"
                                      Fill="White" Width="14" Height="14" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="{Binding [RecoveryVssScanSolution], Source={x:Static services:LocalizationService.Instance}}" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" Margin="0"/>
                        </StackPanel>
                        <TextBlock Style="{StaticResource BodyText}" Margin="0,0,0,8">
                            <Run Text="{Binding [RecoveryVssExplanationPart1], Source={x:Static services:LocalizationService.Instance}, Mode=OneWay}"/><Bold><Run Text="{Binding [RecoveryVssExplanationPart2], Source={x:Static services:LocalizationService.Instance}, Mode=OneWay}"/></Bold><Run Text="{Binding [RecoveryVssExplanationPart3], Source={x:Static services:LocalizationService.Instance}, Mode=OneWay}"/><Bold><Run Text="{Binding [RecoveryVssExplanationPart4], Source={x:Static services:LocalizationService.Instance}, Mode=OneWay}"/></Bold><Run Text="{Binding [RecoveryVssExplanationPart5], Source={x:Static services:LocalizationService.Instance}, Mode=OneWay}"/>
                        </TextBlock>
                        <TextBlock Style="{StaticResource BodyText}" Margin="0,0,0,8">
                            <Run Text="{Binding [RecoveryVssSnapshotExplanationPart1], Source={x:Static services:LocalizationService.Instance}, Mode=OneWay}"/><Bold><Run Text="{Binding [RecoveryVssSnapshotExplanationPart2], Source={x:Static services:LocalizationService.Instance}, Mode=OneWay}"/></Bold><Run Text="{Binding [RecoveryVssSnapshotExplanationPart3], Source={x:Static services:LocalizationService.Instance}, Mode=OneWay}"/>
                        </TextBlock>
                        <TextBlock Text="{Binding [RecoveryVssAdvantages], Source={x:Static services:LocalizationService.Instance}}" Style="{StaticResource BodyText}" FontWeight="Medium" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,6"/>
                        <TextBlock Text="{Binding [RecoveryVssWorksOnSsd], Source={x:Static services:LocalizationService.Instance}}" Style="{StaticResource BodyText}" Margin="12,0,0,4"/>
                        <TextBlock Text="{Binding [RecoveryVssOriginalStructure], Source={x:Static services:LocalizationService.Instance}}" Style="{StaticResource BodyText}" Margin="12,0,0,4"/>
                        <TextBlock Text="{Binding [RecoveryFileContentIntact], Source={x:Static services:LocalizationService.Instance}}" Style="{StaticResource BodyText}" Margin="12,0,0,4"/>
                        <TextBlock Text="{Binding [RecoveryVssLimitation], Source={x:Static services:LocalizationService.Instance}}" Style="{StaticResource BodyText}" FontWeight="Medium" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,10,0,6"/>
                        <TextBlock Text="{Binding [RecoveryVssOnlyAfterSnapshot], Source={x:Static services:LocalizationService.Instance}}" Style="{StaticResource BodyText}" Margin="12,0,0,4"/>
                    </StackPanel>
                </Border>

                <!-- ======== 7. PROTEÇÃO DO SISTEMA ======== -->
                <Border Style="{StaticResource TutorialCard}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Border Width="28" Height="28" CornerRadius="7" Background="#258B31FF" Margin="0,0,8,0" VerticalAlignment="Center">
                                <Path Data="M12,1L3,5V11C3,16.55 6.84,21.74 12,23C17.16,21.74 21,16.55 21,11V5L12,1M12,5A3,3 0 0,1 15,8A3,3 0 0,1 12,11A3,3 0 0,1 9,8A3,3 0 0,1 12,5M17.13,17C15.92,18.85 14.11,20.24 12,20.92C9.89,20.24 8.08,18.85 6.87,17C6.53,16.5 6.24,15.97 6,15.43C6,13.82 8.71,12.5 12,12.5C15.29,12.5 18,13.82 18,15.43C17.76,15.97 17.47,16.5 17.13,17Z"
                                      Fill="#8B31FF" Width="14" Height="14" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="{Binding [RecoverySystemProtection], Source={x:Static services:LocalizationService.Instance}}" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" Margin="0"/>
                        </StackPanel>
                        <TextBlock Style="{StaticResource BodyText}" Margin="0,0,0,10">
                            <Run Text="{Binding [RecoverySystemProtectionExplanationPart1], Source={x:Static services:LocalizationService.Instance}, Mode=OneWay}"/><Bold><Run Text="{Binding [RecoverySystemProtectionExplanationPart2], Source={x:Static services:LocalizationService.Instance}, Mode=OneWay}"/></Bold><Run Text="{Binding [RecoverySystemProtectionExplanationPart3], Source={x:Static services:LocalizationService.Instance}, Mode=OneWay}"/>
                        </TextBlock>
                        <TextBlock Text="{Binding [RecoveryEnableSystemProtection], Source={x:Static services:LocalizationService.Instance}}" Style="{StaticResource BodyText}" FontWeight="Medium" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,6"/>
                        <TextBlock Style="{StaticResource BodyText}" Margin="12,0,0,4">
                            <Run Text="{Binding [RecoverySystemProtectionStepsPart1], Source={x:Static services:LocalizationService.Instance}, Mode=OneWay}"/><Bold><Run Text="{Binding [RecoverySystemProtectionStepsPart2], Source={x:Static services:LocalizationService.Instance}, Mode=OneWay}"/></Bold><Run Text="{Binding [RecoverySystemProtectionStepsPart3], Source={x:Static services:LocalizationService.Instance}, Mode=OneWay}"/><Bold><Run Text="{Binding [RecoverySystemProtectionStepsPart4], Source={x:Static services:LocalizationService.Instance}, Mode=OneWay}"/></Bold><Run Text="{Binding [RecoverySystemProtectionStepsPart5], Source={x:Static services:LocalizationService.Instance}, Mode=OneWay}"/>
                        </TextBlock>
                        <TextBlock Style="{StaticResource BodyText}" Margin="12,0,0,4">
                            <Run Text="{Binding [RecoverySystemProtectionStepsPart6], Source={x:Static services:LocalizationService.Instance}, Mode=OneWay}"/><Bold><Run Text="{Binding [RecoverySystemProtectionStepsPart7], Source={x:Static services:LocalizationService.Instance}, Mode=OneWay}"/></Bold>
                        </TextBlock>
                        <TextBlock Text="{Binding [RecoverySelectDisk], Source={x:Static services:LocalizationService.Instance}}" Style="{StaticResource BodyText}" Margin="12,0,0,4"/>
                        <TextBlock Style="{StaticResource BodyText}" Margin="12,0,0,4">
                            <Run Text="{Binding [RecoverySystemProtectionStepsPart8], Source={x:Static services:LocalizationService.Instance}, Mode=OneWay}"/><Bold><Run Text="{Binding [RecoverySystemProtectionStepsPart9], Source={x:Static services:LocalizationService.Instance}, Mode=OneWay}"/></Bold><Run Text="{Binding [RecoverySystemProtectionStepsPart10], Source={x:Static services:LocalizationService.Instance}, Mode=OneWay}"/><Bold><Run Text="{Binding [RecoverySystemProtectionStepsPart11], Source={x:Static services:LocalizationService.Instance}, Mode=OneWay}"/></Bold>
                        </TextBlock>
                        <TextBlock Text="{Binding [RecoveryDiskSpace], Source={x:Static services:LocalizationService.Instance}}" Style="{StaticResource BodyText}" Margin="12,0,0,4"/>
                        <TextBlock Style="{StaticResource BodyText}" Margin="12,0,0,8">
                            <Run Text="{Binding [RecoverySystemProtectionStepsPart12], Source={x:Static services:LocalizationService.Instance}, Mode=OneWay}"/><Bold><Run Text="{Binding [RecoverySystemProtectionStepsPart13], Source={x:Static services:LocalizationService.Instance}, Mode=OneWay}"/></Bold>
                        </TextBlock>
                        <Border Background="#15EAB308" CornerRadius="8" Padding="12,10" Margin="0,4,0,0" BorderBrush="#25EAB308" BorderThickness="1">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="M12,2A7,7 0 0,0 5,9C5,11.38 6.19,13.47 8,14.74V17A1,1 0 0,0 9,18H15A1,1 0 0,0 16,17V14.74C17.81,13.47 19,11.38 19,9A7,7 0 0,0 12,2M9,21A1,1 0 0,0 10,22H14A1,1 0 0,0 15,21V20H9V21Z" Fill="#EAB308" Width="16" Height="16" Stretch="Uniform" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <TextBlock Style="{StaticResource BodyText}" TextWrapping="Wrap">
                                    <Bold><Run Text="{Binding [RecoverySystemProtectionTipPart1], Source={x:Static services:LocalizationService.Instance}, Mode=OneWay}"/></Bold><Run Text="{Binding [RecoverySystemProtectionTipPart2], Source={x:Static services:LocalizationService.Instance}, Mode=OneWay}"/>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- ======== 8. QUAL SCAN USAR? ======== -->
                <Border Style="{StaticResource TutorialCard}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Border Width="28" Height="28" CornerRadius="7" Background="#2510B981" Margin="0,0,8,0" VerticalAlignment="Center">
                                <Path Data="M9,3L5,6.99H8V14H10V6.99H13L9,3M16,17.01V10H14V17.01H11L15,21L19,17.01H16Z"
                                      Fill="#10B981" Width="14" Height="14" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="{Binding [RecoveryWhichScanMode], Source={x:Static services:LocalizationService.Instance}}" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" Margin="0"/>
                        </StackPanel>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Background="#1031A8FF" CornerRadius="10" Padding="14,12" BorderBrush="#2031A8FF" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="{Binding [RecoveryQuickScanTitle], Source={x:Static services:LocalizationService.Instance}}" FontSize="13" FontWeight="Bold" Foreground="#31A8FF" Margin="0,0,0,6"/>
                                    <TextBlock Text="{Binding [RecoveryRecentlyDeleted], Source={x:Static services:LocalizationService.Instance}}" Style="{StaticResource BodyText}" FontSize="12"/>
                                    <TextBlock Text="{Binding [RecoveryUseFirstAlways], Source={x:Static services:LocalizationService.Instance}}" FontSize="11" Foreground="#31A8FF" Margin="0,8,0,0" FontWeight="Medium"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="2" Background="#108B31FF" CornerRadius="10" Padding="14,12" BorderBrush="#208B31FF" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="{Binding [RecoveryDeepScan], Source={x:Static services:LocalizationService.Instance}}" FontSize="13" FontWeight="Bold" Foreground="#8B31FF" Margin="0,0,0,6"/>
                                    <TextBlock Text="{Binding [RecoveryFileNotInQuickScan], Source={x:Static services:LocalizationService.Instance}}" Style="{StaticResource BodyText}" FontSize="12"/>
                                    <TextBlock Text="{Binding [RecoveryUseAsSecondStep], Source={x:Static services:LocalizationService.Instance}}" FontSize="11" Foreground="#8B31FF" Margin="0,8,0,0" FontWeight="Medium"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="4" Background="#158B31FF" CornerRadius="10" Padding="14,12" BorderBrush="#2810B981" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="{Binding [RecoveryVssScan], Source={x:Static services:LocalizationService.Instance}}" FontSize="13" FontWeight="Bold" Foreground="#10B981" Margin="0,0,0,6"/>
                                    <TextBlock Text="{Binding [RecoverySsdTrimActive], Source={x:Static services:LocalizationService.Instance}}" Style="{StaticResource BodyText}" FontSize="12"/>
                                    <TextBlock Text="{Binding [RecoveryBestForSsd], Source={x:Static services:LocalizationService.Instance}}" FontSize="11" Foreground="#10B981" Margin="0,8,0,0" FontWeight="Medium"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ======== BOTÃO FECHAR ======== -->
                <Button x:Name="BtnClose" Click="BtnClose_Click" HorizontalAlignment="Center"
                        Cursor="Hand" Margin="0,4,0,0">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="bd" CornerRadius="10" Padding="36,11"
                                                Background="#1531A8FF" BorderBrush="#3031A8FF" BorderThickness="1">
                                            <TextBlock Text="{Binding [RecoveryUnderstoodBack], Source={x:Static services:LocalizationService.Instance}}" FontSize="13" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bd" Property="Background" Value="#2531A8FF"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
