<Window xmlns:services="clr-namespace:VoltrisOptimizer.Services" x:Class="VoltrisOptimizer.UI.Windows.CustomToastWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding [ToastNotificationTitle], Source={x:Static services:LocalizationService.Instance}}" Height="96" Width="384"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize"
        ShowActivated="False"
        Opacity="0" Loaded="Window_Loaded"
        MouseEnter="Window_MouseEnter"
        MouseLeave="Window_MouseLeave">

    <Window.Resources>
        <!-- Header Icon Frame (Gamer Style: 24x24, raio 7, translúcido + glow) -->
        <Style x:Key="ToastIconFrameStyle" TargetType="Border">
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="CornerRadius" Value="7"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#1A8B31FF" Offset="0"/>
                        <GradientStop Color="#1AFF4B6B" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="BorderBrush">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#4D8B31FF" Offset="0"/>
                        <GradientStop Color="#4DFF4B6B" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="8" ShadowDepth="0" Color="#8B31FF" Opacity="0.45"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Success Icon Frame -->
        <Style x:Key="ToastIconSuccessStyle" TargetType="Border" BasedOn="{StaticResource ToastIconFrameStyle}">
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#1A10B981" Offset="0"/>
                        <GradientStop Color="#1A059669" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="BorderBrush">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#4D10B981" Offset="0"/>
                        <GradientStop Color="#4D059669" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="8" ShadowDepth="0" Color="#10B981" Opacity="0.5"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Warning Icon Frame -->
        <Style x:Key="ToastIconWarningStyle" TargetType="Border" BasedOn="{StaticResource ToastIconFrameStyle}">
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#1AF59E0B" Offset="0"/>
                        <GradientStop Color="#1AB45309" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="BorderBrush">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#4DF59E0B" Offset="0"/>
                        <GradientStop Color="#4DB45309" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="8" ShadowDepth="0" Color="#F59E0B" Opacity="0.5"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Error Icon Frame -->
        <Style x:Key="ToastIconErrorStyle" TargetType="Border" BasedOn="{StaticResource ToastIconFrameStyle}">
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#1AEF4444" Offset="0"/>
                        <GradientStop Color="#1AD23B3B" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="BorderBrush">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#4DEF4444" Offset="0"/>
                        <GradientStop Color="#4DD23B3B" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="8" ShadowDepth="0" Color="#EF4444" Opacity="0.5"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Info Icon Frame -->
        <Style x:Key="ToastIconInfoStyle" TargetType="Border" BasedOn="{StaticResource ToastIconFrameStyle}">
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#1A31A8FF" Offset="0"/>
                        <GradientStop Color="#1A1E40AF" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="BorderBrush">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#4D31A8FF" Offset="0"/>
                        <GradientStop Color="#4D1E40AF" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="8" ShadowDepth="0" Color="#31A8FF" Opacity="0.5"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Button Style for Toast -->
        <Style x:Key="ToastButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="26"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder" Background="#14FFFFFF"
                                CornerRadius="13" Padding="4"
                                BorderBrush="Transparent" BorderThickness="1">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="6" ShadowDepth="0" Color="Black" Opacity="0.12"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#24FFFFFF"/>
                                <Setter TargetName="BtnBorder" Property="BorderBrush" Value="#30FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#30FFFFFF"/>
                                <Setter Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.95" ScaleY="0.95"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Glass Toast Background -->
        <LinearGradientBrush x:Key="ToastGlassBackground" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#1E1E2E" Offset="0"/>
            <GradientStop Color="#151522" Offset="0.5"/>
            <GradientStop Color="#0D0D15" Offset="1"/>
        </LinearGradientBrush>

        <!-- Glass Border Brush -->
        <LinearGradientBrush x:Key="ToastGlassBorder" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#30FFFFFF" Offset="0"/>
            <GradientStop Color="#0EFFFFFF" Offset="0.5"/>
            <GradientStop Color="#04FFFFFF" Offset="1"/>
        </LinearGradientBrush>
    </Window.Resources>

    <Border x:Name="ToastBorder" CornerRadius="14"
            Background="{StaticResource ToastGlassBackground}"
            BorderThickness="1"
            BorderBrush="{StaticResource ToastGlassBorder}"
            Margin="6"
            MouseLeftButtonDown="Border_MouseLeftButtonDown">
        <Border.Effect>
            <DropShadowEffect BlurRadius="10" ShadowDepth="0" Color="Black" Opacity="0.35"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="3"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/> <!-- Icon -->
                <ColumnDefinition Width="*"/>    <!-- Title/Message -->
                <ColumnDefinition Width="Auto"/> <!-- Buttons -->
            </Grid.ColumnDefinitions>

            <!-- Single header icon (Gamer style, inline with title) -->
            <Grid Grid.Row="0" Grid.Column="0" Margin="14,0,0,0" VerticalAlignment="Center">
                <Border x:Name="IconBorder" Style="{StaticResource ToastIconFrameStyle}">
                    <!-- Icon glyphs (one Grid child so the Border frame has a single child) -->
                    <Grid>
                    <!-- Success Icon (Checkmark Circle) -->
                    <Path x:Name="SuccessIcon" Visibility="Collapsed"
                          Data="M12,2A10,10 0 0,1 22,12A10,10 0 0,1 12,22A10,10 0 0,1 2,12A10,10 0 0,1 12,2M10,17L5,12L6.41,10.58L10,14.17L17.59,6.41L19,8L10,17Z"
                          Fill="#10B981" Width="14" Height="14" Stretch="Uniform"
                          HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Path.Effect>
                            <DropShadowEffect BlurRadius="8" ShadowDepth="0" Color="#10B981" Opacity="0.7"/>
                        </Path.Effect>
                    </Path>

                    <!-- Warning Icon (Alert Triangle) -->
                    <Path x:Name="WarningIcon" Visibility="Collapsed"
                          Data="M12,2L1,21H23M12,6L19.5,18H4.5M11,10V14H13V10H11M11,16V18H13V16H11Z"
                          Fill="#F59E0B" Width="14" Height="14" Stretch="Uniform"
                          HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Path.Effect>
                            <DropShadowEffect BlurRadius="8" ShadowDepth="0" Color="#F59E0B" Opacity="0.7"/>
                        </Path.Effect>
                    </Path>

                    <!-- Error Icon (Close Circle) -->
                    <Path x:Name="ErrorIcon" Visibility="Collapsed"
                          Data="M12,2A10,10 0 0,1 22,12A10,10 0 0,1 12,22A10,10 0 0,1 2,12A10,10 0 0,1 12,2M15.59,7L12,10.59L8.41,7L7,8.41L10.59,12L7,15.59L8.41,17L12,13.41L15.59,17L17,15.59L13.41,12L17,8.41L15.59,7Z"
                          Fill="#EF4444" Width="14" Height="14" Stretch="Uniform"
                          HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Path.Effect>
                            <DropShadowEffect BlurRadius="8" ShadowDepth="0" Color="#EF4444" Opacity="0.7"/>
                        </Path.Effect>
                    </Path>

                    <!-- Info Icon (Rounded Info Dot) -->
                    <Path x:Name="InfoIcon" Visibility="Collapsed"
                          Data="M12,2A10,10 0 0,1 22,12A10,10 0 0,1 12,22A10,10 0 0,1 2,12A10,10 0 0,1 12,2M11,7H13V9H11V7M11,11H13V17H11V11Z"
                           Fill="#31A8FF" Width="14" Height="14" Stretch="Uniform"
                           HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Path.Effect>
                            <DropShadowEffect BlurRadius="8" ShadowDepth="0" Color="#31A8FF" Opacity="0.7"/>
                        </Path.Effect>
                    </Path>

                    <!-- Ícone contextual (ex.: dispositivo da rede) — mesmos glifos da aba Rede.
                         Data/Stroke são preenchidos por código via SetContextualIcon(Geometry, Color). -->
                    <Viewbox x:Name="ContextualIconHost" Visibility="Collapsed"
                             Width="16" Height="16" Stretch="Uniform"
                             HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Canvas Width="24" Height="24">
                            <Path x:Name="ContextualIcon"
                                  StrokeThickness="2.4"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  Fill="Transparent"/>
                        </Canvas>
                    </Viewbox>
                    </Grid>
                </Border>
            </Grid>

            <!-- Content (Title + Message) -->
            <StackPanel Grid.Row="0" Grid.Column="1" VerticalAlignment="Center" Margin="0,9,12,9">
                <TextBlock x:Name="TitleText"
                            FontFamily="Segoe UI Variable Display, Segoe UI"
                            FontWeight="Bold"
                            Foreground="{DynamicResource TextPrimary}"
                            FontSize="14"
                            Margin="0,0,0,3"/>
                <TextBlock x:Name="MessageText"
                            FontFamily="Segoe UI Variable Text, Segoe UI"
                            Foreground="{DynamicResource TextSecondary}"
                            FontSize="11.5"
                            TextWrapping="Wrap"
                            TextTrimming="CharacterEllipsis"
                            LineHeight="16"
                            MaxHeight="32"/>
            </StackPanel>

            <!-- Buttons (Modern Glass Style) -->
            <StackPanel Grid.Row="0" Grid.Column="2" VerticalAlignment="Center" Margin="0,0,10,0" Orientation="Horizontal">
                <Button x:Name="MuteButton" Style="{StaticResource ToastButtonStyle}"
                        Margin="0,0,4,0" Click="MuteButton_Click" Cursor="Hand"
                        ToolTip="{Binding [ToastTooltipMute], Source={x:Static services:LocalizationService.Instance}}">
                    <Path x:Name="MuteIcon" Stretch="Uniform" Width="13" Height="13" Fill="{DynamicResource TextTertiary}">
                        <Path.Data>
                            <PathGeometry Figures="M3 9v6h4l5 5V4L7 9H3z M14 5l5 5M19 5l-5 5"/>
                        </Path.Data>
                    </Path>
                </Button>
                <Button x:Name="CloseButton" Style="{StaticResource ToastButtonStyle}"
                        Click="CloseButton_Click" Cursor="Hand"
                        ToolTip="{Binding [ToastTooltipClose], Source={x:Static services:LocalizationService.Instance}}">
                    <Path x:Name="CloseIconPath" Data="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"
                          Fill="{DynamicResource TextTertiary}" Width="11" Height="11" Stretch="Uniform"/>
                </Button>
            </StackPanel>

            <!-- Progress Bar (Animated Gradient) -->
            <Border x:Name="ProgressBarContainerBorder" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3"
                    Height="3" Background="Transparent"
                    CornerRadius="0,0,14,14" ClipToBounds="True">
                <Border x:Name="ProgressBar" HorizontalAlignment="Left" Width="372" Opacity="0.9" CornerRadius="0,0,14,14">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#FF4B6B" Offset="0"/>
                            <GradientStop Color="#8B31FF" Offset="0.5"/>
                            <GradientStop Color="#31A8FF" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Border.RenderTransform>
                        <TranslateTransform x:Name="ProgressTranslate" X="-372"/>
                    </Border.RenderTransform>
                </Border>
            </Border>
        </Grid>
    </Border>
</Window>