<Window xmlns:services="clr-namespace:VoltrisOptimizer.Services"
        xmlns:converters="clr-namespace:VoltrisOptimizer.UI.Converters"
        x:Class="VoltrisOptimizer.UI.Windows.ProfileSelectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding [IntelligentProfile], Source={x:Static services:LocalizationService.Instance}}"
        Width="760"
        SizeToContent="Height"
        MinWidth="680"
        MaxWidth="900"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        WindowStyle="None"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="False"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        SourceInitialized="Window_SourceInitialized"
        Loaded="Window_Loaded"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <converters:ProfileIconConverter x:Key="ProfileIcon"/>
        <converters:OsCornerRadiusConverter x:Key="OsCorner"/>

        <LinearGradientBrush x:Key="BrandGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FF4B6B" Offset="0"/>
            <GradientStop Color="#8B31FF" Offset="0.52"/>
            <GradientStop Color="#31A8FF" Offset="1"/>
        </LinearGradientBrush>

        <RadialGradientBrush x:Key="ProfilePinkGlow" Center="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
            <GradientStop Color="{DynamicResource AccentColor}" Offset="0"/>
            <GradientStop Color="Transparent" Offset="1"/>
        </RadialGradientBrush>
        <RadialGradientBrush x:Key="ProfilePurpleGlow" Center="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
            <GradientStop Color="{DynamicResource SecondaryColor}" Offset="0"/>
            <GradientStop Color="Transparent" Offset="1"/>
        </RadialGradientBrush>
        <RadialGradientBrush x:Key="ProfileBlueGlow" Center="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
            <GradientStop Color="{DynamicResource PrimaryColor}" Offset="0"/>
            <GradientStop Color="Transparent" Offset="1"/>
        </RadialGradientBrush>

        <Style x:Key="CloseButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="#12FFFFFF"/>
            <Setter Property="BorderBrush" Value="#24FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#C6CDDD"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="17">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#2AEF4444"/>
                                <Setter TargetName="Surface" Property="BorderBrush" Value="#66EF4444"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#3AEF4444"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Surface" Property="BorderBrush" Value="#B0FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ProfileCardStyle" TargetType="Button">
            <Setter Property="MinHeight" Value="70"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="#A3161C2B"/>
            <Setter Property="BorderBrush" Value="#263D4A61"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#F5F7FC"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="16" SnapsToDevicePixels="True">
                            <Grid>
                                <Border x:Name="AccentLine" Width="4" HorizontalAlignment="Left" Background="#00FFFFFF" CornerRadius="16,0,0,16"/>
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" Margin="{TemplateBinding Padding}"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#1CFFFFFF"/>
                                <Setter TargetName="Surface" Property="BorderBrush" Value="#598B31FF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#24FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Surface" Property="BorderBrush" Value="#B0FFFFFF"/>
                            </Trigger>
                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                <Setter TargetName="Surface" Property="BorderBrush" Value="{Binding AccentBrush}"/>
                                <Setter TargetName="AccentLine" Property="Background" Value="{Binding AccentBrush}"/>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="ProfileDetailsTemplate">
            <Border Width="430" Padding="0" Background="#D90B0F1C" BorderBrush="{DynamicResource DarkBorderBrush}" BorderThickness="1" ClipToBounds="True" CornerRadius="{Binding RelativeSource={RelativeSource Self}, Converter={StaticResource OsCorner}, ConverterParameter=18}">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="28" ShadowDepth="8" Opacity="0.55" Color="#000000"/>
                </Border.Effect>
                <Grid>
                    <Grid IsHitTestVisible="False" ClipToBounds="True">
                    <Ellipse Width="270" Height="230" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-80,-90,0,0" Fill="{StaticResource ProfilePinkGlow}" Opacity="0.24"/>
                    <Ellipse Width="250" Height="220" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-80,-80" Fill="{StaticResource ProfilePurpleGlow}" Opacity="0.20"/>
                    <Ellipse Width="190" Height="170" HorizontalAlignment="Center" VerticalAlignment="Center" Fill="{StaticResource ProfileBlueGlow}" Opacity="0.15"/>
                </Grid>
                <Grid Margin="18">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="40" Height="40" CornerRadius="12" Background="#1FFFFFFF" BorderBrush="#28FFFFFF" BorderThickness="1">
                            <Grid>
                                <Border Background="{Binding AccentBrush}" Opacity="0.2" CornerRadius="12"/>
                                <Border BorderBrush="{Binding AccentBrush}" BorderThickness="1" CornerRadius="12" Opacity="0.7"/>
                                <Path Data="{Binding Type, Converter={StaticResource ProfileIcon}}" Stroke="{Binding AccentBrush}" StrokeThickness="1.8" Fill="Transparent" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="19" Height="19" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="11,0,10,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding DisplayName}" FontSize="14" FontWeight="SemiBold" Foreground="#F5F7FC"/>
                        </StackPanel>
                        <Border Grid.Column="2" CornerRadius="14" Padding="9,4" Background="#1A10B981" BorderBrush="#5A10B981" BorderThickness="1" VerticalAlignment="Center">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding [ProfileActiveBadge], Source={x:Static services:LocalizationService.Instance}}" FontSize="10" FontWeight="Bold" Foreground="#34D399"/>
                        </Border>
                    </Grid>

                    <Border Grid.Row="1" Height="1" Background="#24FFFFFF" Margin="0,14"/>

                    <StackPanel Grid.Row="2" Margin="0,13,0,0">
                        <TextBlock Text="{Binding [ProfileTooltipWhatItDoes], Source={x:Static services:LocalizationService.Instance}}" FontSize="10" FontWeight="Bold" Typography.Capitals="AllSmallCaps" Foreground="{Binding AccentBrush}"/>
                        <TextBlock Text="{Binding Description}" FontSize="12.5" LineHeight="19" TextWrapping="Wrap" Foreground="#C5CCDC" Margin="0,7,0,0"/>
                    </StackPanel>

                    <Border Grid.Row="3" Background="#14FFFFFF" BorderBrush="#1FFFFFFF" BorderThickness="1" CornerRadius="12" Padding="13,10" Margin="0,14,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Path Data="M13.5,2 L4,13.5 H10.5 L9.5,24 L20,11.5 H13.2 Z" Fill="{Binding AccentBrush}" Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" Margin="9,0,0,0">
                                <TextBlock Text="{Binding [ProfileTooltipExpectedGain], Source={x:Static services:LocalizationService.Instance}}" FontSize="10" FontWeight="Bold" Typography.Capitals="AllSmallCaps" Foreground="#8F9BAE"/>
                                <TextBlock Text="{Binding GainText}" FontSize="12" FontWeight="SemiBold" Foreground="{Binding AccentBrush}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Grid.Row="4" Background="#10FFFFFF" CornerRadius="10" Padding="11,8" Margin="0,11,0,0">
                        <TextBlock FontSize="11" TextWrapping="Wrap" LineHeight="16" Foreground="#A6B0C4">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="{Binding [ProfileTooltipClickToApply], Source={x:Static services:LocalizationService.Instance}}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                                            <Setter Property="Text" Value="{Binding [ProfileTooltipAlreadyActive], Source={x:Static services:LocalizationService.Instance}}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>
                </Grid>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Border x:Name="ModalSurface" Background="{DynamicResource WindowBackgroundBrush}" BorderBrush="{DynamicResource DarkBorderBrush}" BorderThickness="1" CornerRadius="28">
            <Border.Effect>
                <DropShadowEffect BlurRadius="46" ShadowDepth="14" Opacity="0.72" Color="#000000"/>
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.RowSpan="4" IsHitTestVisible="False" ClipToBounds="True">
                    <Ellipse Width="360" Height="300" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-120,-110,0,0" Fill="{StaticResource ProfilePinkGlow}" Opacity="0.30"/>
                    <Ellipse Width="320" Height="280" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-100,-100" Fill="{StaticResource ProfilePurpleGlow}" Opacity="0.26"/>
                    <Ellipse Width="250" Height="220" HorizontalAlignment="Center" VerticalAlignment="Center" Fill="{StaticResource ProfileBlueGlow}" Opacity="0.20"/>
                </Grid>

                <Grid Grid.Row="0" Margin="24,20,18,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="46" Height="46" CornerRadius="14" Background="{StaticResource BrandGradient}">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="16" ShadowDepth="0" Opacity="0.5" Color="#8B31FF"/>
                        </Border.Effect>
                        <Path Data="M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2M12,4A8,8 0 0,1 20,12A8,8 0 0,1 12,20A8,8 0 0,1 4,12A8,8 0 0,1 12,4M13,14H11V10H13M13,18H11V16H13M19,13H5V11H19M19,15H5V17H19M21,12V14H23V12M1,12V14H3V12" Fill="White" Width="22" Height="22" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="13,0,16,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding [IntelligentProfile], Source={x:Static services:LocalizationService.Instance}}" FontSize="18" FontWeight="Bold" Foreground="#F5F7FC"/>
                        <TextBlock Text="{Binding [IntelligentProfileDesc], Source={x:Static services:LocalizationService.Instance}}" FontSize="11" Foreground="#8F9BAE" TextWrapping="Wrap" Margin="0,3,0,0"/>
                    </StackPanel>
                    <Button x:Name="CloseButton" Grid.Column="2" Style="{StaticResource CloseButtonStyle}" VerticalAlignment="Top" Click="CloseButton_Click">
                        <Button.ToolTip>
                            <ToolTip Placement="Bottom" HorizontalOffset="12" VerticalOffset="10" Background="Transparent" BorderThickness="0" HasDropShadow="False">
                                <Border Background="#D90B0F1C" BorderBrush="{DynamicResource DarkBorderBrush}" BorderThickness="1" Padding="11,6" CornerRadius="8">
                                    <TextBlock Text="{Binding [ProfileModalClose], Source={x:Static services:LocalizationService.Instance}}" FontSize="11.5" FontWeight="SemiBold" Foreground="#E8ECF5"/>
                                </Border>
                            </ToolTip>
                        </Button.ToolTip>
                        <Path Data="M6,6 L18,18 M18,6 L6,18" Stroke="#C8D0E0" StrokeThickness="1.9" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="14" Height="14" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>
                </Grid>

                <Border x:Name="CurrentProfileStrip" Grid.Row="1" Margin="24,0,24,12" Padding="12,9" Background="#121A2638" BorderBrush="#24445C78" BorderThickness="1" CornerRadius="14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="30" Height="30" CornerRadius="10" Background="#1A10B981" BorderBrush="#4A10B981" BorderThickness="1" VerticalAlignment="Center">
                            <Path Data="M12,2 L20,5.5 V11.5 C20,16.5 16.8,20.8 12,22 C7.2,20.8 4,16.5 4,11.5 V5.5 Z M8.5,11.8 L11,14.3 L15.5,9.4" Stroke="#34D399" StrokeThickness="1.6" Fill="Transparent" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="17" Height="17" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding [ProfileActiveBadge], Source={x:Static services:LocalizationService.Instance}}" FontSize="9.5" FontWeight="Bold" Foreground="#34D399"/>
                            <TextBlock x:Name="CurrentProfileNameText" Text="" FontSize="12.5" FontWeight="SemiBold" Foreground="#F0F3FA" Margin="0,2,0,0"/>
                        </StackPanel>
                        <Border Grid.Column="2" Width="8" Height="8" CornerRadius="4" Background="#10B981" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <ItemsControl x:Name="ProfileItems" Grid.Row="2" Margin="24,0,16,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="2"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Tag="{Binding Type}" Style="{StaticResource ProfileCardStyle}" Click="CardOption_Click" MouseEnter="ProfileCard_MouseEnter" MouseLeave="ProfileCard_MouseLeave" GotKeyboardFocus="ProfileCard_GotKeyboardFocus" LostKeyboardFocus="ProfileCard_LostKeyboardFocus">
                                <Grid Margin="13,9,11,9">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid Width="36" Height="36" VerticalAlignment="Center">
                                        <Border Background="{Binding AccentBrush}" Opacity="0.16" CornerRadius="11"/>
                                        <Border BorderBrush="{Binding AccentBrush}" BorderThickness="1" CornerRadius="11" Opacity="0.55"/>
                                        <Path Data="{Binding Type, Converter={StaticResource ProfileIcon}}" Stroke="{Binding AccentBrush}" StrokeThickness="1.6" Fill="Transparent" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="19" Height="19" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Grid>
                                    <StackPanel Grid.Column="1" Margin="10,0,7,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding DisplayName}" FontSize="12" FontWeight="SemiBold" Foreground="#F1F4FA"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                            <Path Data="M13.5,2 L4,13.5 H10.5 L9.5,24 L20,11.5 H13.2 Z" Fill="{Binding AccentBrush}" Width="9" Height="9" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                            <TextBlock Text="{Binding GainText}" FontSize="9.5" Foreground="{Binding AccentBrush}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                                        <Border CornerRadius="12" Padding="7,2.5" Background="#1A10B981" BorderBrush="#4810B981" BorderThickness="1" HorizontalAlignment="Center">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding [ProfileActiveBadge], Source={x:Static services:LocalizationService.Instance}}" FontSize="8.5" FontWeight="Bold" Foreground="#34D399"/>
                                        </Border>
                                        <Path Data="M8.59,16.58L13.17,12L8.59,7.41L10,6L16,12L10,18L8.59,16.58Z" Fill="#7E8BA0" Width="11" Height="11" Stretch="Uniform" HorizontalAlignment="Center" Margin="0,3,0,0">
                                            <Path.Style>
                                                <Style TargetType="Path">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Path.Style>
                                        </Path>
                                    </StackPanel>
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Border x:Name="FooterBorder" Grid.Row="3" Background="#10000000" BorderBrush="#2239485A" BorderThickness="0,1,0,0" CornerRadius="0,0,28,28">
                    <Grid Margin="24,9,24,10">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="20" Height="20" CornerRadius="6" Background="#161A2438" BorderBrush="#2C445C78" BorderThickness="1">
                                <Path Data="M12,2L1,21H23L12,2M12,6.3L19.35,19H4.65L12,6.3M11,10V15H13V10H11M11,17V19H13V17H11Z" Fill="#8A98AF" Width="12" Height="12" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="{Binding [ProfileSelectHint], Source={x:Static services:LocalizationService.Instance}}" FontSize="10.5" Foreground="#8A98AF" TextWrapping="Wrap" VerticalAlignment="Center" Margin="8,0,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <Popup x:Name="ProfileDetailsPopup" Placement="Top" HorizontalOffset="0" VerticalOffset="0" AllowsTransparency="True" StaysOpen="True" IsOpen="False" IsHitTestVisible="True" Focusable="False" PopupAnimation="Fade" Opened="ProfileDetailsPopup_Opened" Closed="ProfileDetailsPopup_Closed">
            <ContentControl x:Name="ProfileDetailsContent" Content="{Binding}" ContentTemplate="{StaticResource ProfileDetailsTemplate}" Background="Transparent" BorderThickness="0" Focusable="False" MouseEnter="ProfileDetailsPopup_MouseEnter" MouseLeave="ProfileDetailsPopup_MouseLeave"/>
        </Popup>
    </Grid>
</Window>
