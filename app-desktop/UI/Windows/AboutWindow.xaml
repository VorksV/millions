<Window xmlns:services="clr-namespace:VoltrisOptimizer.Services" x:Class="VoltrisOptimizer.UI.Windows.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:properties="clr-namespace:VoltrisOptimizer.Properties"
        Title="{Binding [AboutWindowTitle], Source={x:Static services:LocalizationService.Instance}}"
        Width="580" Height="520"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        MouseDown="Window_MouseDown"
        Icon="/Images/favicon.ico">
    
    <Window.Resources>
        <Style x:Key="AboutCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource BgCardGlass}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderLight}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="15"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
        
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Background" Value="#1A31A8FF"/>
            <Setter Property="BorderBrush" Value="#3031A8FF"/>
            <Setter Property="Foreground" Value="#31A8FF"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="15,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#2531A8FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryActionButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
            <Setter Property="Background" Value="#0DFFFFFF"/>
            <Setter Property="BorderBrush" Value="#1AFFFFFF"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#1AFFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    
    <Border CornerRadius="16" BorderThickness="1" BorderBrush="{DynamicResource BorderLight}" ClipToBounds="True">
        <Grid>
            <!-- Fundo base dinâmico — transparente quando acrylic ativo, sólido caso contrário -->
            <Border Background="{DynamicResource WindowBackgroundBrush}"/>
            
            <!-- Overlay para legibilidade — semi-transparente quando acrylic ativo -->
            <Border Opacity="0.45" IsHitTestVisible="False"
                    Background="{DynamicResource WindowBackgroundBrush}"/>

            <Grid Margin="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
            
            <!-- HEADER / TITLE BAR -->
            <Grid Grid.Row="0" Margin="20,15,20,10">
                <TextBlock Text="{Binding [AboutSystem], Source={x:Static services:LocalizationService.Instance}}" Foreground="{DynamicResource TextMutedBrush}" 
                           FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <Button HorizontalAlignment="Right" VerticalAlignment="Center"
                        Width="30" Height="30" Cursor="Hand" Click="CloseButton_Click"
                        ToolTip="{Binding [TooltipClose], Source={x:Static services:LocalizationService.Instance}}">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="15">
                                            <Path Data="M0,0 L10,10 M10,0 L0,10" Stroke="{DynamicResource TextSecondaryBrush}" 
                                                  StrokeThickness="1.5" HorizontalAlignment="Center" VerticalAlignment="Center" Width="10" Height="10"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bd" Property="Background" Value="#1AFF0000"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>

            <!-- CONTENT -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="20,0,20,0">
                <StackPanel>
                    <!-- APP INFO HEADER -->
                    <Border Style="{StaticResource AboutCard}" Background="Transparent" BorderThickness="0" Padding="0,10,0,20">
                        <StackPanel HorizontalAlignment="Center">
                            <Image Source="/Images/voltris.png" Width="64" Height="64" Margin="0,0,0,15">
                                <Image.Effect>
                                    <DropShadowEffect BlurRadius="15" ShadowDepth="0" Color="{DynamicResource PrimaryBlurColor}" Opacity="0.5"/>
                                </Image.Effect>
                            </Image>
                            <TextBlock Text="{Binding [Loc_VoltrisOptimizer], Source={x:Static services:LocalizationService.Instance}}" FontSize="26" FontWeight="Bold" HorizontalAlignment="Center">
                                <TextBlock.Foreground>
                                    <StaticResource ResourceKey="VoltrisGradientHorizontalBrush"/>
                                </TextBlock.Foreground>
                            </TextBlock>
                            <TextBlock Text="{x:Static properties:VersionInfo.Version}" FontSize="14" 
                                       Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                        </StackPanel>
                    </Border>
                    
                    <!-- COMPANY INFO -->
                    <Border Style="{StaticResource AboutCard}">
                        <StackPanel>
                            <TextBlock Text="{Binding [AboutCompany], Source={x:Static services:LocalizationService.Instance}}" FontWeight="SemiBold" FontSize="13" 
                                       Foreground="{DynamicResource PrimaryBrush}" Margin="0,0,0,10"/>
                            <UniformGrid Columns="2">
                                <StackPanel Margin="0,0,10,0">
                                    <TextBlock Text="{Binding [AboutDeveloper], Source={x:Static services:LocalizationService.Instance}}" FontSize="10" Foreground="{DynamicResource TextMutedBrush}"/>
                                    <TextBlock Text="{x:Static properties:VersionInfo.Company}" FontSize="12" Foreground="{DynamicResource DefaultTextBrush}"/>
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="{Binding [AboutCopyright], Source={x:Static services:LocalizationService.Instance}}" FontSize="10" Foreground="{DynamicResource TextMutedBrush}"/>
                                    <TextBlock Text="{x:Static properties:VersionInfo.Copyright}" FontSize="12" Foreground="{DynamicResource DefaultTextBrush}"/>
                                </StackPanel>
                            </UniformGrid>
                        </StackPanel>
                    </Border>

                    <!-- DESCRIPTION -->
                    <Border Style="{StaticResource AboutCard}">
                        <StackPanel>
                            <TextBlock Text="{Binding [AboutDescription], Source={x:Static services:LocalizationService.Instance}}" FontWeight="SemiBold" FontSize="13" 
                                       Foreground="{DynamicResource PrimaryBrush}" Margin="0,0,0,10"/>
                            <TextBlock Text="{x:Static properties:VersionInfo.Description}" 
                                       TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
                                       LineHeight="18"/>
                        </StackPanel>
                    </Border>

                    <!-- SECURITY & LICENSE -->
                    <UniformGrid Columns="2">
                        <Border Style="{StaticResource AboutCard}" Margin="0,0,5,10">
                            <StackPanel>
                                <TextBlock Text="{Binding [Security], Source={x:Static services:LocalizationService.Instance}}" FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource PrimaryBrush}"/>
                                <TextBlock Text="{x:Static properties:VersionInfo.SecurityLevel}" FontSize="11" Foreground="{DynamicResource DefaultTextBrush}" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource AboutCard}" Margin="5,0,0,10">
                            <StackPanel>
                                <TextBlock Text="{Binding [AboutLicensing], Source={x:Static services:LocalizationService.Instance}}" FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource PrimaryBrush}"/>
                                <TextBlock Text="{x:Static properties:VersionInfo.LicenseType}" FontSize="11" Foreground="{DynamicResource DefaultTextBrush}" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <Border Style="{StaticResource AboutCard}">
                        <StackPanel>
                            <TextBlock Text="{Binding [AboutDigitalSignature], Source={x:Static services:LocalizationService.Instance}}" FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource PrimaryBrush}"/>
                            <TextBlock Text="{x:Static properties:VersionInfo.DigitalSignature}" FontSize="11" Foreground="{DynamicResource DefaultTextBrush}" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
            
            <!-- FOOTER BUTTONS -->
            <Border Grid.Row="2" Padding="20,15,20,20" Background="#0AFFFFFF" CornerRadius="0,0,16,16">
                <StackPanel>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="{Binding [AboutAccessWebsite], Source={x:Static services:LocalizationService.Instance}}" Style="{StaticResource ActionButton}" Click="WebsiteButton_Click"/>
                        <Button Grid.Column="2" Content="{Binding [AboutTechnicalSupport], Source={x:Static services:LocalizationService.Instance}}" Style="{StaticResource ActionButton}" Click="SupportButton_Click"/>
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="{Binding [Privacy], Source={x:Static services:LocalizationService.Instance}}" Style="{StaticResource SecondaryActionButton}" Click="PrivacyButton_Click"/>
                        <Button Grid.Column="2" Content="{Binding [AboutTermsOfUse], Source={x:Static services:LocalizationService.Instance}}" Style="{StaticResource SecondaryActionButton}" Click="TermsButton_Click"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Border>
</Window>
