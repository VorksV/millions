<Window xmlns:services="clr-namespace:VoltrisOptimizer.Services" 
        x:Class="VoltrisOptimizer.UI.Windows.SmartRepairConfirmationModal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="{Binding [SmartRepairConfirmTitle], Source={x:Static services:LocalizationService.Instance}}" 
        Height="600" Width="700" MinHeight="550" MinWidth="650"
        WindowStartupLocation="CenterOwner"
        AllowsTransparency="True" 
        WindowStyle="None"
        Background="Transparent"
        Topmost="False"
        ShowInTaskbar="False"
        Loaded="Window_Loaded"
        MouseDown="Window_MouseDown">

    <Window.Resources>
        <!-- Brush dinâmico do Voltris -->
        <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#0A0A0F"/>
        <SolidColorBrush x:Key="DarkBorderBrush" Color="#2A2A3A"/>
        
        <LinearGradientBrush x:Key="VoltrisGradient" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#FF4B6B" Offset="0"/>
            <GradientStop Color="#8B31FF" Offset="0.5"/>
            <GradientStop Color="#31A8FF" Offset="1"/>
        </LinearGradientBrush>

        <Style x:Key="ModalButton" TargetType="Button">
            <Setter Property="Background" Value="#1A1A24"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#2A2A3A"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#252535"/>
                    <Setter Property="BorderBrush" Value="#3A3A4A"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PrimaryModalButton" TargetType="Button" BasedOn="{StaticResource ModalButton}">
            <Setter Property="Background" Value="{StaticResource VoltrisGradient}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="0.9"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ModuleItem" TargetType="Border">
            <Setter Property="Background" Value="#1A1A24"/>
            <Setter Property="BorderBrush" Value="#2A2A3A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Margin" Value="0,4"/>
        </Style>

        <!-- Checkbox Profissional Voltris -->
        <Style x:Key="VoltrisCheckBox" TargetType="CheckBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Background="{TemplateBinding Background}" Margin="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <!-- Borda do Checkbox -->
                            <Border x:Name="CheckBoxBorder"
                                    Grid.Column="0"
                                    Width="20"
                                    Height="20"
                                    Background="#1A1A24"
                                    BorderBrush="#2A2A3A"
                                    BorderThickness="1.5"
                                    CornerRadius="5"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                                <Grid>
                                    <!-- Check Mark -->
                                    <Path x:Name="CheckMark"
                                          Data="M9 16.17L4.83 12l-1.41 1.41L9 19 21 7l-1.41-1.41z"
                                          Fill="#31A8FF"
                                          Stretch="Uniform"
                                          Width="14"
                                          Height="14"
                                          Opacity="0"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                                    <!-- Indeterminate Mark -->
                                    <Rectangle x:Name="IndeterminateMark"
                                               Width="12"
                                               Height="3"
                                               Fill="#31A8FF"
                                               Opacity="0"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               RadiusX="1.5"
                                               RadiusY="1.5"/>
                                </Grid>
                            </Border>
                            
                            <!-- Content -->
                            <ContentPresenter Grid.Column="1"
                                              Margin="8,0,0,0"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </Grid>
                        
                        <ControlTemplate.Triggers>
                            <!-- Checked State -->
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CheckBoxBorder" Property="BorderBrush" Value="#31A8FF"/>
                                <Setter TargetName="CheckBoxBorder" Property="Background" Value="#0A2A3A"/>
                                <Setter TargetName="CheckMark" Property="Opacity" Value="1"/>
                            </Trigger>
                            
                            <!-- Indeterminate State -->
                            <Trigger Property="IsChecked" Value="{x:Null}">
                                <Setter TargetName="CheckBoxBorder" Property="BorderBrush" Value="#31A8FF"/>
                                <Setter TargetName="CheckBoxBorder" Property="Background" Value="#0A2A3A"/>
                                <Setter TargetName="IndeterminateMark" Property="Opacity" Value="1"/>
                            </Trigger>
                            
                            <!-- Mouse Over -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CheckBoxBorder" Property="BorderBrush" Value="#8B31FF"/>
                                <Setter TargetName="CheckBoxBorder" Property="Background" Value="#1F1F2E"/>
                            </Trigger>
                            
                            <!-- Disabled -->
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="CheckBoxBorder" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Container com efeito Acrylic -->
    <Border x:Name="AcrylicBorder"
            Background="#0A0A0F"
            CornerRadius="16"
            BorderBrush="#2A2A3A"
            BorderThickness="1">
        
        <!-- Borda decorativa -->
        <Border CornerRadius="16" BorderBrush="#3A3A4A" BorderThickness="1">
            <Grid>
                <!-- Atmospheric Glow -->
                <Ellipse Fill="#31A8FF" Width="400" Height="400" Margin="-200,-200,0,0" 
                         Opacity="0.08" HorizontalAlignment="Left" VerticalAlignment="Top">
                    <Ellipse.Effect>
                        <BlurEffect Radius="100"/>
                    </Ellipse.Effect>
                </Ellipse>
                <Ellipse Fill="#FF4B6B" Width="350" Height="350" Margin="0,0,-175,-175" 
                         Opacity="0.08" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                    <Ellipse.Effect>
                        <BlurEffect Radius="100"/>
                    </Ellipse.Effect>
                </Ellipse>

                <Grid Margin="28,24">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Header Compacto -->
                    <Grid Grid.Row="0" Margin="0,0,0,16">
                        <StackPanel>
                            <Viewbox Width="48" Height="48" Margin="0,0,0,12" HorizontalAlignment="Center">
                                <Grid>
                                    <Ellipse Width="48" Height="48">
                                        <Ellipse.Fill>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                <GradientStop Color="#FF4B6B" Offset="0"/>
                                                <GradientStop Color="#8B31FF" Offset="0.5"/>
                                                <GradientStop Color="#31A8FF" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Ellipse.Fill>
                                        <Ellipse.Effect>
                                            <DropShadowEffect BlurRadius="16" ShadowDepth="0" Color="#8B31FF" Opacity="0.4"/>
                                        </Ellipse.Effect>
                                    </Ellipse>
                                    <Path Data="M27 8L12.5 22.5L8.5 18.5L12.5 14.5L27 29L49.5 6.5L53.5 10.5L27 37Z" 
                                          Fill="White" Stretch="Uniform" Width="24" Height="24"/>
                                </Grid>
                            </Viewbox>

                            <TextBlock x:Name="TitleTextBlock"
                            Text="{Binding [SmartRepairConfirmTitle], Source={x:Static services:LocalizationService.Instance}}" 
                            FontSize="20" 
                            FontWeight="Bold" 
                            Foreground="White"
                            HorizontalAlignment="Center"/>
                            
                            <TextBlock x:Name="SubtitleTextBlock"
                            Text="{Binding [SmartRepairConfirmSubtitle], Source={x:Static services:LocalizationService.Instance}}" 
                            FontSize="12" 
                            Foreground="#A0A0B0"
                            HorizontalAlignment="Center"
                            Margin="0,4,0,0"/>

                            <Border x:Name="SafetyNoteBorder"
                                    Background="#2A1A1A"
                                    BorderBrush="#8B3131"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="10,7"
                                    Margin="0,10,0,0">
                                <TextBlock x:Name="SafetyNoteTextBlock"
                                           Text=""
                                           FontSize="11"
                                           Foreground="#FFB0B0"
                                           TextWrapping="Wrap"
                                           HorizontalAlignment="Center"
                                           TextAlignment="Center"/>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <!-- Conteúdo Compacto -->
                    <Grid Grid.Row="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Resumo Compacto -->
                        <Border Grid.Row="0" 
                                Background="#1A1A24" 
                                CornerRadius="10" 
                                Padding="16,12"
                                Margin="0,0,0,12"
                                BorderBrush="#2A2A3A"
                                BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                    <TextBlock x:Name="ModulesLabel"
                                              Text="{Binding [SmartRepairConfirmModules], Source={x:Static services:LocalizationService.Instance}}"
                                              FontSize="11" 
                                              Foreground="#A0A0B0" 
                                              HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="ModuleCountText" 
                                              Text="0" 
                                              FontSize="22" 
                                              FontWeight="Bold" 
                                              Foreground="White"
                                              HorizontalAlignment="Center"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                                    <TextBlock x:Name="SpaceLabel"
                                              Text="{Binding [SmartRepairConfirmSpace], Source={x:Static services:LocalizationService.Instance}}"
                                              FontSize="11" 
                                              Foreground="#A0A0B0" 
                                              HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="SpaceText" 
                                              Text="0 MB" 
                                              FontSize="22" 
                                              FontWeight="Bold" 
                                              Foreground="#00D9A5"
                                              HorizontalAlignment="Center"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                                    <TextBlock x:Name="ItemsLabel"
                                              Text="{Binding [SmartRepairConfirmItems], Source={x:Static services:LocalizationService.Instance}}"
                                              FontSize="11" 
                                              Foreground="#A0A0B0" 
                                              HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="ItemsText" 
                                              Text="0" 
                                              FontSize="22" 
                                              FontWeight="Bold" 
                                              Foreground="#31A8FF"
                                              HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Lista Compacta -->
                        <Border Grid.Row="1" 
                                Background="#0F0F16" 
                                CornerRadius="10" 
                                BorderBrush="#2A2A3A"
                                BorderThickness="1">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

<!-- Header -->
                                <Grid Grid.Row="0" Margin="12,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="28"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="70"/>
                                    </Grid.ColumnDefinitions>

                                    <CheckBox Grid.Column="0" 
                                             x:Name="SelectAllCheckbox"
                                             Style="{StaticResource VoltrisCheckBox}"
                                             VerticalAlignment="Center"
                                             Checked="SelectAllCheckbox_Checked"
                                             Unchecked="SelectAllCheckbox_Unchecked"/>
                                    <TextBlock x:Name="OperationLabel"
                                              Grid.Column="1" 
                                              Text="{Binding [SmartRepairConfirmOperation], Source={x:Static services:LocalizationService.Instance}}"
                                              FontSize="12" 
                                              FontWeight="SemiBold" 
                                              Foreground="#A0A0B0" 
                                              VerticalAlignment="Center"/>
                                    <TextBlock x:Name="ImpactLabel"
                                              Grid.Column="2" 
                                              Text="{Binding [SmartRepairConfirmImpact], Source={x:Static services:LocalizationService.Instance}}"
                                              FontSize="12" 
                                              FontWeight="SemiBold" 
                                              Foreground="#A0A0B0" 
                                              VerticalAlignment="Center" 
                                              HorizontalAlignment="Center"/>
                                </Grid>

                                <!-- Lista -->
                                <ScrollViewer Grid.Row="1" 
                                             VerticalScrollBarVisibility="Auto"
                                             HorizontalScrollBarVisibility="Disabled">
                                    <ItemsControl x:Name="ModulesList">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource ModuleItem}">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="28"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="70"/>
                                                        </Grid.ColumnDefinitions>

                                                        <CheckBox Grid.Column="0" 
                                                                 IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                                 Style="{StaticResource VoltrisCheckBox}"
                                                                 VerticalAlignment="Center"
                                                                 HorizontalAlignment="Center"/>
                                                        
                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding ModuleName}" 
                                                                      FontSize="12" 
                                                                      FontWeight="Medium" 
                                                                      Foreground="White"/>
                                                            <TextBlock Text="{Binding Description}" 
                                                                      FontSize="10" 
                                                                      Foreground="#808090"
                                                                      TextTrimming="CharacterEllipsis"
                                                                      Margin="0,2,0,0"/>
                                                        </StackPanel>

                                                        <Border Grid.Column="2" 
                                                               CornerRadius="4" 
                                                               Padding="6,3" 
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"
                                                               BorderThickness="1">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding ImpactLevel}" Value="High">
                                                                            <Setter Property="Background" Value="#2A1A1F"/>
                                                                            <Setter Property="BorderBrush" Value="#FF4B6B"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding ImpactLevel}" Value="Medium">
                                                                            <Setter Property="Background" Value="#2A2510"/>
                                                                            <Setter Property="BorderBrush" Value="#FFB800"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding ImpactLevel}" Value="Low">
                                                                            <Setter Property="Background" Value="#102520"/>
                                                                            <Setter Property="BorderBrush" Value="#00D9A5"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <TextBlock Text="{Binding ImpactLevel}" 
                                                                      FontSize="9" 
                                                                      FontWeight="SemiBold">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Foreground" Value="#00D9A5"/> <!-- Default: Low -->
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding ImpactLevel}" Value="High">
                                                                                <Setter Property="Foreground" Value="#FF4B6B"/>
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding ImpactLevel}" Value="Medium">
                                                                                <Setter Property="Foreground" Value="#FFB800"/>
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding ImpactLevel}" Value="Low">
                                                                                <Setter Property="Foreground" Value="#00D9A5"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </Border>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- Alerta Compacto -->
                    <Border Grid.Row="2" 
                            Background="#2A1A1F" 
                            CornerRadius="6" 
                            Padding="12"
                            Margin="0,12,0,0"
                            BorderBrush="#FF4B6B"
                            BorderThickness="1">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-2h2v2zm0-4h-2V7h2v6z" 
                                  Fill="#FF4B6B" 
                                  Stretch="Uniform" 
                                  Width="16" 
                                  Height="16"
                                  Margin="0,0,10,0"/>
                            <TextBlock x:Name="AlertTextBlock"
                                      FontSize="11" 
                                      Foreground="#FFB0B0"
                                      TextWrapping="Wrap"
                                      VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Botões -->
                    <Grid Grid.Row="3" Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="1" 
                                x:Name="CancelButton"
                                Style="{StaticResource ModalButton}"
                                Width="120"
                                Height="40"
                                Click="CancelButton_Click"
                                Margin="0,0,12,0"/>

                        <Button Grid.Column="2" 
                                x:Name="ConfirmButton"
                                Style="{StaticResource PrimaryModalButton}"
                                Width="160"
                                Height="40"
                                Click="ConfirmButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="M9 16.17L4.83 12l-1.41 1.41L9 19 21 7l-1.41-1.41z" 
                                      Fill="White" 
                                      Stretch="Uniform" 
                                      Width="14" 
                                      Height="14"
                                      Margin="0,0,8,0"/>
                                <TextBlock x:Name="ConfirmButtonText"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Grid>
            </Grid>
        </Border>
    </Border>
</Window>