<Window xmlns:services="clr-namespace:VoltrisOptimizer.Services" x:Class="VoltrisOptimizer.UI.Windows.OnboardingWizard"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding [OnbTitle], Source={x:Static services:LocalizationService.Instance}}"
        Width="640" Height="560"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterScreen"
        Topmost="False" ShowInTaskbar="True"
        ResizeMode="NoResize"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">

    <Window.Resources>
        <!-- Futuristic Brand Color Gradients -->
        <LinearGradientBrush x:Key="BrandGradient" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#FF2D55" Offset="0"/>
            <GradientStop Color="#8B31FF" Offset="0.5"/>
            <GradientStop Color="#00E5FF" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="GlassBorderGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FF4E4E6E" Offset="0"/>
            <GradientStop Color="#FF1A1A2E" Offset="0.3"/>
            <GradientStop Color="#FF141424" Offset="0.7"/>
            <GradientStop Color="#FF00E5FF" Offset="1"/>
        </LinearGradientBrush>

        <!-- Animations -->
        <Storyboard x:Key="FadeIn">
            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.6">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <!-- Dynamic Pulsing Ring Animation -->
        <Storyboard x:Key="PulseGlow" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="PulseRing" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                              From="0.95" To="1.05" Duration="0:0:1.8" AutoReverse="True"/>
            <DoubleAnimation Storyboard.TargetName="PulseRing" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                              From="0.95" To="1.05" Duration="0:0:1.8" AutoReverse="True"/>
            <DoubleAnimation Storyboard.TargetName="PulseRing" Storyboard.TargetProperty="Opacity"
                              From="0.25" To="0.55" Duration="0:0:1.8" AutoReverse="True"/>
        </Storyboard>

        <!-- Success Indicator Pop-in Animation -->
        <Storyboard x:Key="SuccessPop">
            <DoubleAnimation Storyboard.TargetName="SuccessIndicator" Storyboard.TargetProperty="Opacity"
                             From="0" To="1" Duration="0:0:0.4">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="SuccessScale" Storyboard.TargetProperty="ScaleX"
                             From="0.6" To="1.0" Duration="0:0:0.5">
                <DoubleAnimation.EasingFunction>
                    <ElasticEase EasingMode="EaseOut" Oscillations="1" Springiness="4"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="SuccessScale" Storyboard.TargetProperty="ScaleY"
                             From="0.6" To="1.0" Duration="0:0:0.5">
                <DoubleAnimation.EasingFunction>
                    <ElasticEase EasingMode="EaseOut" Oscillations="1" Springiness="4"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <!-- Styles for Custom Buttons -->
        <Style x:Key="GlassButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#0F0F1A"/>
            <Setter Property="BorderBrush" Value="#2A2A3E"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#6B7280"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#1A1A2E"/>
                                <Setter Property="BorderBrush" Value="#3F3F5E"/>
                                <Setter Property="Foreground" Value="#9CA3AF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AccentButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#8B31FF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="24,11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#FF8B31FF" Offset="0"/>
                                    <GradientStop Color="#FF7A1FFF" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="#FFA855F7" Offset="0"/>
                                            <GradientStop Color="#FF8B31FF" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Window.Triggers>
        <EventTrigger RoutedEvent="Window.Loaded">
            <BeginStoryboard Storyboard="{StaticResource FadeIn}"/>
            <BeginStoryboard Storyboard="{StaticResource PulseGlow}"/>
        </EventTrigger>
    </Window.Triggers>

    <Grid>
        <!-- Background Radial Glow Effect -->
        <Border CornerRadius="8" Background="{DynamicResource WindowBackgroundBrush}">
            <Border.Effect>
                <DropShadowEffect BlurRadius="50" ShadowDepth="10" Opacity="0.6" Color="#8B31FF"/>
            </Border.Effect>
        </Border>

        <!-- Futuristic Cyber Grid Pattern -->
        <Border CornerRadius="8" BorderThickness="1" BorderBrush="{StaticResource GlassBorderGradient}">
            <Border.Background>
                <RadialGradientBrush Center="0.5,0" RadiusX="0.8" RadiusY="0.8">
                    <GradientStop Color="#4D18102B" Offset="0"/>
                    <GradientStop Color="#1D06060A" Offset="0.9"/>
                </RadialGradientBrush>
            </Border.Background>

            <!-- Holographic Scan Lines Sweep Element -->
            <Grid Margin="32">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header System HUD -->
                <Grid Grid.Row="0" Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <StackPanel Grid.Column="0">
                        <TextBlock FontSize="10" FontWeight="Bold" Foreground="#6B7280"
                                   Typography.Capitals="AllSmallCaps"
                                   Text="{Binding [OnbHeaderHUD], Source={x:Static services:LocalizationService.Instance}}"/>
                        
                        <TextBlock x:Name="StepTitle" FontSize="24" FontWeight="Bold" Margin="0,6,0,0">
                            <TextBlock.Foreground>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#FF2D55" Offset="0"/>
                                    <GradientStop Color="#8B31FF" Offset="0.5"/>
                                    <GradientStop Color="#00E5FF" Offset="1"/>
                                </LinearGradientBrush>
                            </TextBlock.Foreground>
                        </TextBlock>
                        
                        <TextBlock x:Name="StepDescription" Text="" FontSize="12" Foreground="#9CA3AF" Margin="0,4,0,0" TextWrapping="Wrap"/>
                    </StackPanel>

                    <!-- Status Indicator Host (Grid.Column="1") -->
                    <Grid Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <!-- Pulse Orb Indicator (UI Status Visual - Steps 0 & 1) -->
                        <Border x:Name="PulseRing" Width="44" Height="44" CornerRadius="22" BorderThickness="1" BorderBrush="#00E5FF" Background="Transparent">
                            <Border.RenderTransform>
                                <ScaleTransform ScaleX="1" ScaleY="1" CenterX="22" CenterY="22"/>
                            </Border.RenderTransform>
                            <Border.Effect>
                                <BlurEffect Radius="6"/>
                            </Border.Effect>
                            <Ellipse Width="10" Height="10" Fill="#00E5FF"/>
                        </Border>

                        <!-- Success Checkmark Indicator (Step 2) -->
                        <Grid x:Name="SuccessIndicator" Width="44" Height="44" Visibility="Collapsed" RenderTransformOrigin="0.5,0.5" Opacity="0">
                            <Grid.RenderTransform>
                                <ScaleTransform x:Name="SuccessScale" ScaleX="1" ScaleY="1"/>
                            </Grid.RenderTransform>

                            <!-- Background Pulse Glow -->
                            <Ellipse Fill="#10B981" Opacity="0.25">
                                <Ellipse.Effect>
                                    <BlurEffect Radius="12"/>
                                </Ellipse.Effect>
                            </Ellipse>
                            
                            <!-- Green Border Ring -->
                            <Ellipse Stroke="#10B981" StrokeThickness="1.5"/>
                            
                            <!-- Small Green Inner Ring -->
                            <Ellipse Fill="#0D10B981" Margin="3"/>
                            
                            <!-- Checkmark Path -->
                            <Path Data="M16,23 L21,28 L30,17" 
                                  Stroke="#10B981" 
                                  StrokeThickness="2.5" 
                                  StrokeStartLineCap="Round" 
                                  StrokeEndLineCap="Round" 
                                  StrokeLineJoin="Round" 
                                  HorizontalAlignment="Center" 
                                  VerticalAlignment="Center"
                                  Width="15" Height="15"
                                  Stretch="Uniform"
                                  Margin="1,0,0,0"/>
                        </Grid>
                    </Grid>
                </Grid>

                <!-- Content Render Host (Obsidian Layer) -->
                <ContentControl x:Name="StepContent" Grid.Row="1"/>

                <!-- Footer Navigation Deck -->
                <Grid Grid.Row="2" Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Glassy Skip Deck -->
                    <Button x:Name="SkipButton" Grid.Column="0"
                            Style="{StaticResource GlassButtonStyle}"
                            Click="SkipButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding [OnbSkipBtn], Source={x:Static services:LocalizationService.Instance}}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>

                    <!-- Neon Primary Next Button -->
                    <Button x:Name="NextButton" Grid.Column="2"
                            Style="{StaticResource AccentButtonStyle}"
                            Click="NextButton_Click">
                        <TextBlock Text="{Binding [OnbNextBtn], Source={x:Static services:LocalizationService.Instance}}" VerticalAlignment="Center"/>
                    </Button>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>