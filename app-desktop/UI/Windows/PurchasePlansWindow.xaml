<Window xmlns:services="clr-namespace:VoltrisOptimizer.Services" x:Class="VoltrisOptimizer.UI.Windows.PurchasePlansWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding [PlansTitle], Source={x:Static services:LocalizationService.Instance}}"
        Height="550" Width="850"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">

    <Window.Resources>
        <SolidColorBrush x:Key="CardBackground" Color="#12121A"/>
        <SolidColorBrush x:Key="PrimaryText" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="SecondaryText" Color="#A0A0B0"/>
    </Window.Resources>

    <Border CornerRadius="16" Background="#0A0A0F" BorderBrush="{DynamicResource DarkBorderBrush}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="40" ShadowDepth="0" Opacity="0.6"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Header -->
                <RowDefinition Height="*"/>    <!-- Plans -->
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="24">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding [PlansHeaderTitle], Source={x:Static services:LocalizationService.Instance}}" FontSize="26" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding [PlansHeaderSubtitle], Source={x:Static services:LocalizationService.Instance}}" FontSize="14" Foreground="#808090" Margin="0,4,0,0" HorizontalAlignment="Center"/>
                </StackPanel>
                
                <Button HorizontalAlignment="Right" VerticalAlignment="Top" Click="CloseButton_Click" Background="Transparent" BorderThickness="0" Cursor="Hand" Width="32" Height="32">
                    <Path Data="M19,6.41L17.59,5L12,10.59L6.41,5L5,6.41L10.59,12L5,17.59L6.41,19L12,13.41L17.59,19L19,17.59L13.41,12L19,6.41Z" Fill="#808090" Stretch="Uniform" Margin="8"/>
                </Button>
            </Grid>
            

            <!-- Plans Container -->
            <Grid Grid.Row="1" Margin="48,12,48,36">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="32"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Licença de Ativação -->
                <Border Grid.Column="0" Background="{DynamicResource GlassmorphismCard}" CornerRadius="16" Padding="28" BorderBrush="#3A3A4A" BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        
                        <StackPanel>
                            <Border Background="#20FFAA00" CornerRadius="4" Padding="8,4" HorizontalAlignment="Left" Margin="0,0,0,12">
                                <TextBlock Text="{Binding [PlansCommercialLicense], Source={x:Static services:LocalizationService.Instance}}" FontSize="11" FontWeight="Bold" Foreground="#FFAA00"/>
                            </Border>
                            <TextBlock Text="{Binding [PlansActivationLicense], Source={x:Static services:LocalizationService.Instance}}" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="{Binding [PlansActivationPrice], Source={x:Static services:LocalizationService.Instance}}" FontSize="36" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,16,0,4"/>
                            <TextBlock Text="{Binding [PlansActivationPriceDesc], Source={x:Static services:LocalizationService.Instance}}" FontSize="13" Foreground="#808090"/>
                        </StackPanel>
                        
                        <StackPanel Grid.Row="1" Margin="0,24,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding [PlansActivationFeature1], Source={x:Static services:LocalizationService.Instance}}" Foreground="#C0C0D0" FontSize="14" Margin="0,0,0,10"/>
                            <TextBlock Text="{Binding [PlansActivationFeature2], Source={x:Static services:LocalizationService.Instance}}" Foreground="#C0C0D0" FontSize="14" Margin="0,0,0,10"/>
                            <TextBlock Text="{Binding [PlansActivationFeature3], Source={x:Static services:LocalizationService.Instance}}" Foreground="#C0C0D0" FontSize="14" Margin="0,0,0,10"/>
                            <TextBlock Text="{Binding [PlansActivationFeature4], Source={x:Static services:LocalizationService.Instance}}" Foreground="#C0C0D0" FontSize="14" Margin="0,0,0,10"/>
                        </StackPanel>
                        
                        <Button Grid.Row="2" Content="{Binding [PlansBtnChooseActivation], Source={x:Static services:LocalizationService.Instance}}" Click="BuyLicenseActivation_Click" Style="{DynamicResource OrangeButtonStyle}" Height="48"/>
                    </Grid>
                </Border>

                <!-- Voltris Premium (Highlight) -->
                <Border Grid.Column="2" Background="{DynamicResource GlassmorphismCard}" CornerRadius="16" Padding="28" BorderBrush="#FFAE00" BorderThickness="2">
                    <Border.Effect>
                        <DropShadowEffect Color="#FF5E00" BlurRadius="25" ShadowDepth="0" Opacity="0.3"/>
                    </Border.Effect>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        
                        <Border VerticalAlignment="Top" HorizontalAlignment="Right" Background="#FFAE00" CornerRadius="4" Padding="8,4" Margin="0,-40,-16,0">
                            <TextBlock Text="{Binding [PlansMostPopular], Source={x:Static services:LocalizationService.Instance}}" FontSize="10" FontWeight="Bold" Foreground="Black"/>
                        </Border>

                        <StackPanel>
                            <Border Background="#20FFAE00" CornerRadius="4" Padding="8,4" HorizontalAlignment="Left" Margin="0,0,0,12">
                                <TextBlock Text="{Binding [PlansRecommended], Source={x:Static services:LocalizationService.Instance}}" FontSize="11" FontWeight="Bold" Foreground="#FFAE00"/>
                            </Border>
                            <TextBlock Text="{Binding [PlansPremiumLicense], Source={x:Static services:LocalizationService.Instance}}" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="{Binding [PlansPremiumPrice], Source={x:Static services:LocalizationService.Instance}}" FontSize="36" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,16,0,4"/>
                            <TextBlock Text="{Binding [PlansPremiumPriceDesc], Source={x:Static services:LocalizationService.Instance}}" FontSize="13" Foreground="#808090"/>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Margin="0,24,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding [PlansPremiumFeature1], Source={x:Static services:LocalizationService.Instance}}" Foreground="#C0C0D0" FontSize="14" Margin="0,0,0,10"/>
                            <TextBlock Text="{Binding [PlansPremiumFeature2], Source={x:Static services:LocalizationService.Instance}}" Foreground="#C0C0D0" FontSize="14" Margin="0,0,0,10"/>
                            <TextBlock Text="{Binding [PlansPremiumFeature3], Source={x:Static services:LocalizationService.Instance}}" Foreground="#C0C0D0" FontSize="14" Margin="0,0,0,10"/>
                            <TextBlock Text="{Binding [PlansPremiumFeature4], Source={x:Static services:LocalizationService.Instance}}" Foreground="#C0C0D0" FontSize="14" Margin="0,0,0,10"/>
                            <TextBlock Text="{Binding [PlansPremiumFeature5], Source={x:Static services:LocalizationService.Instance}}" Foreground="#C0C0D0" FontSize="14" Margin="0,0,0,10"/>
                        </StackPanel>

                        <Button Grid.Row="2" Content="{Binding [PlansBtnBuyPremium], Source={x:Static services:LocalizationService.Instance}}" Click="BuyPremium_Click" Style="{DynamicResource OrangeButtonStyle}" Height="48"/>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
