<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    
    <!-- Recursos Locais para Garantir Sincronização de Cor -->
    <LinearGradientBrush x:Key="SidebarBrandGradient" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#FF4B6B" Offset="0"/>
        <GradientStop Color="#8B31FF" Offset="0.5"/>
        <GradientStop Color="#31A8FF" Offset="1"/>
    </LinearGradientBrush>
    
    <!-- ============================================ -->
    <!-- VOLTRIS PREMIUM SIDEBAR - DESIGN MODERNO    -->
    <!-- Glassmorphism + Neon + Animações Suaves     -->
    <!-- ============================================ -->
    
    <!-- ============================================ -->
    <!-- ESTILO DO SIDEBAR CONTAINER                 -->
    <!-- ============================================ -->
    <Style x:Key="PremiumSidebarContainerStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource SidebarBackgroundBrush}"/>
        <Setter Property="BorderThickness" Value="0,0,1,0"/>
        <Setter Property="BorderBrush" Value="{DynamicResource DarkBorderBrush}"/>
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect BlurRadius="40" 
                                  ShadowDepth="0" 
                                  Color="#000000" 
                                  Opacity="0.5"/>
            </Setter.Value>
        </Setter>
    </Style>
    
    <!-- ============================================ -->
    <!-- ESTILO DO HEADER (LOGO SECTION)             -->
    <!-- ============================================ -->
    <Style x:Key="PremiumSidebarHeaderStyle" TargetType="Border">
        <Setter Property="Padding" Value="0,32,0,24"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Setter Property="BorderBrush">
            <Setter.Value>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="Transparent" Offset="0"/>
                    <GradientStop Color="#20A855F7" Offset="0.3"/>
                    <GradientStop Color="#30A855F7" Offset="0.5"/>
                    <GradientStop Color="#20A855F7" Offset="0.7"/>
                    <GradientStop Color="Transparent" Offset="1"/>
                </LinearGradientBrush>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="VersionBadgeStyle" TargetType="Border">
        <Setter Property="Background" Value="#12FFFFFF"/>
        <Setter Property="BorderBrush" Value="#1AFFFFFF"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="10,3"/>
        <Setter Property="CornerRadius" Value="20"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Style.Triggers>
            <!-- OTIMIZAÇÃO PERFORMANCE: Removida animação Forever Bloom/Opacity -->
        </Style.Triggers>
    </Style>

    <Style x:Key="StatusDotStyle" TargetType="Ellipse">
        <Setter Property="Width" Value="6"/>
        <Setter Property="Height" Value="6"/>
        <Setter Property="Fill" Value="#10B981"/>
        <Setter Property="Margin" Value="0,0,6,0"/>
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect BlurRadius="8" ShadowDepth="0" Color="#10B981" Opacity="0.8"/>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <!-- OTIMIZAÇÃO PERFORMANCE: Removida animação de BlurRadius no DropShadow (caro d+) -->
        </Style.Triggers>
    </Style>
    
    <!-- ============================================ -->
    <!-- ESTILO DO FOOTER (STATUS SECTION)           -->
    <!-- ============================================ -->
    <Style x:Key="PremiumSidebarFooterStyle" TargetType="Border">
        <Setter Property="Padding" Value="20,16,20,16"/>
        <Setter Property="Background" Value="{DynamicResource DarkPanelBrush}"/>
        <Setter Property="BorderBrush">
            <Setter.Value>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#20FF007A" Offset="0"/>
                    <GradientStop Color="#308B31FF" Offset="0.5"/>
                    <GradientStop Color="#4000D4FF" Offset="1"/>
                </LinearGradientBrush>
            </Setter.Value>
        </Setter>
        <Setter Property="BorderThickness" Value="0,1,0,0"/>
    </Style>
    
    <!-- ============================================ -->
    <!-- ESTILO DOS RÓTULOS DE GRUPO (SAAS STYLE)    -->
    <!-- ============================================ -->
    <Style x:Key="SidebarGroupLabelStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Opacity" Value="0.7"/>
        <Setter Property="Margin" Value="24,24,16,8"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        <Setter Property="Typography.Capitals" Value="AllSmallCaps"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsSidebarExpanded, RelativeSource={RelativeSource AncestorType=Window}}" Value="False">
                <Setter Property="Visibility" Value="Collapsed"/>
                <Setter Property="Margin" Value="0"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- ============================================ -->
    <!-- BOTÃO DE NAVEGAÇÃO PREMIUM MODERNO          -->
    <!-- CORREÇÃO: Height="Auto" + MinHeight + Padding adequado para evitar corte de texto -->
    <!-- ============================================ -->
    <Style x:Key="PremiumNavButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource DefaultTextBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="16,12,16,12"/>
        <Setter Property="Margin" Value="12,3,12,3"/>
        <Setter Property="Height" Value="Auto"/>
        <Setter Property="MinHeight" Value="48"/>
        <Setter Property="FontFamily" Value="Segoe UI Variable Display, Segoe UI"/>
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="UseLayoutRounding" Value="True"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <ControlTemplate.Resources>
                        <Style TargetType="TextBlock">
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Setter Property="TextWrapping" Value="NoWrap"/>
                            <Setter Property="TextTrimming" Value="None"/>
                            <Setter Property="UseLayoutRounding" Value="True"/>
                            <Setter Property="SnapsToDevicePixels" Value="True"/>
                            <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
                            <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
                            <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                            <Setter Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect ShadowDepth="0" Color="Black" BlurRadius="0" Opacity="0"/>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <!-- Modo rail: oculta o texto do botão -->
                                <DataTrigger Binding="{Binding IsSidebarExpanded, RelativeSource={RelativeSource AncestorType=Window}}" Value="False">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ControlTemplate.Resources>
                    <Grid Background="Transparent">
                        <!-- Background Elevation -->
                        <Border x:Name="BackgroundBorder"
                                Background="Transparent"
                                CornerRadius="12"
                                Margin="0,0,0,0"
                                UseLayoutRounding="True"
                                SnapsToDevicePixels="True">
                            <ContentPresenter x:Name="Presenter" 
                                              HorizontalAlignment="Left" 
                                              VerticalAlignment="Center"
                                              Margin="14,0,14,0">
                                <ContentPresenter.Tag>
                                    <Binding Path="Tag" RelativeSource="{RelativeSource TemplatedParent}"/>
                                </ContentPresenter.Tag>
                            </ContentPresenter>
                        </Border>
                    </Grid>
                    
                    <ControlTemplate.Triggers>
                        <!-- Hover State -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="BackgroundBorder" Property="Background" Value="#12FFFFFF"/>
                            <Setter Property="Foreground" Value="{DynamicResource DefaultTextBrush}"/>
                        </Trigger>
                        
                        <!-- Modo rail: remove margens laterais e centraliza o ícone -->
                        <DataTrigger Binding="{Binding IsSidebarExpanded, RelativeSource={RelativeSource AncestorType=Window}}" Value="False">
                            <Setter TargetName="Presenter" Property="Margin" Value="0"/>
                            <Setter TargetName="Presenter" Property="HorizontalAlignment" Value="Center"/>
                            <Setter TargetName="BackgroundBorder" Property="CornerRadius" Value="8"/>
                        </DataTrigger>
                        
                        <!-- Categorized Icon Colors -->
                        <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="Dashboard">
                             <!-- This trigger is inside Template, so 'Self' is the Button -->
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Resources>
            <Style TargetType="Path">
                <!-- HIERARQUIA DE TAMANHO DO SIDEBAR
                     ================================
                     A caixa de LAYOUT do ícone é 22x22 nos DOIS estados, e a
                     diferença visual vem SÓ do ScaleTransform (0.93 vs 1.0).

                     Por que ScaleTransform e não Width/Height diferentes:
                       - RenderTransform NÃO participa do layout. Trocar de página
                         não mede, não reflui e não empurra nenhum item vizinho
                         (exigência de LAYOUT do pedido).
                       - Sobrevive ao modo rail. Antes o rail fixava 20x20 nos
                         DOIS estados e a hierarquia achatava (20 = 20); com a
                         escala, rail fica 18.6 vs 20 e o destaque continua.
                       - É independente de DPI: 0.93 de 22 é 20.5px lógicos em
                         100%, 125% e 150% com a mesma proporção.

                     Por que 0.93: o pedido situa o item normal entre 90% e 95%
                     do selecionado. 0.93 dá 20.5px contra 22px do ativo.

                     GANHO DE LEGIBILIDADE: o item não selecionado era 16x16
                     (73% do ativo — bem acima da faixa pedida, e o pedido
                     proíbe deixar os não selecionados pequenos demais).
                     Agora é 20.5px: 28% maior do que era.

                     ESTABILIDADE DE LAYOUT: como a caixa é 22x22 nos dois
                     estados, o rótulo de texto do item selecionado fica
                     exatamente na mesma coluna dos demais. Antes ele saltava
                     8px a cada navegação. -->
                <Setter Property="Width" Value="22"/>
                <Setter Property="Height" Value="22"/>
                <Setter Property="Stretch" Value="Uniform"/>
                <Setter Property="Margin" Value="0,0,12,0"/>
                <Setter Property="Fill" Value="#707085"/>
                <Setter Property="Stroke" Value="Transparent"/>
                <Setter Property="StrokeThickness" Value="0"/>
                <Setter Property="UseLayoutRounding" Value="True"/>
                <Setter Property="SnapsToDevicePixels" Value="True"/>
                <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
                <Setter Property="RenderTransform">
                    <Setter.Value>
                        <ScaleTransform ScaleX="0.93" ScaleY="0.93"/>
                    </Setter.Value>
                </Setter>
                <Setter Property="Effect">
                    <Setter.Value>
                        <DropShadowEffect BlurRadius="0" ShadowDepth="0" Opacity="0"/>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <!-- VOLTA SUAVE AO TAMANHO NORMAL.
                         A seleção troca o Button.Style inteiro, o que recria o
                         ControlTemplate e portanto cria um Path NOVO. Assim, este
                         é o único ponto honesto onde a animação pode existir:
                         o elemento anterior já foi destruído.

                         Os itens que NÃO mudaram de estado recebem o mesmo Style
                         (mesma instância), o WPF ignora o SetValue e o template
                         NÃO é recriado — logo o Loaded não dispara para eles e
                         eles ficam parados em 0.93. Só os dois itens que
                         realmente trocaram de estado animam.

                         No primeiro carregamento todos partem de 1.0 e assentam
                         em 0.93: 2,5px em 0,20s, simultâneo. É o mesmo
                         mecanismo que o estado ativo já usava, com 1/4 do
                         deslocamento. -->
                    <EventTrigger RoutedEvent="Loaded">
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                 From="1" To="0.93" Duration="0:0:0.2">
                                    <DoubleAnimation.EasingFunction>
                                        <CubicEase EasingMode="EaseOut"/>
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                 From="1" To="0.93" Duration="0:0:0.2">
                                    <DoubleAnimation.EasingFunction>
                                        <CubicEase EasingMode="EaseOut"/>
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                    <!-- Levanta levemente ao passar o mouse, sinalizando que o
                         item está disponível mas ainda não é o atual.
                         TETO IMPORTANTE: 0.985, abaixo de 1.0. O hover antigo
                         ia até 1.12 e deixaria um item NÃO SELECIONADO maior
                         que o selecionado — o hover apagando o estado de
                         seleção, que o pedido proíbe explicitamente. -->
                    <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}}" Value="True">
                        <DataTrigger.EnterActions>
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                     To="0.985" Duration="0:0:0.16">
                                        <DoubleAnimation.EasingFunction>
                                            <CubicEase EasingMode="EaseOut"/>
                                        </DoubleAnimation.EasingFunction>
                                    </DoubleAnimation>
                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                     To="0.985" Duration="0:0:0.16">
                                        <DoubleAnimation.EasingFunction>
                                            <CubicEase EasingMode="EaseOut"/>
                                        </DoubleAnimation.EasingFunction>
                                    </DoubleAnimation>
                                </Storyboard>
                            </BeginStoryboard>
                        </DataTrigger.EnterActions>
                        <DataTrigger.ExitActions>
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                     To="0.93" Duration="0:0:0.16">
                                        <DoubleAnimation.EasingFunction>
                                            <CubicEase EasingMode="EaseOut"/>
                                        </DoubleAnimation.EasingFunction>
                                    </DoubleAnimation>
                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                     To="0.93" Duration="0:0:0.16">
                                        <DoubleAnimation.EasingFunction>
                                            <CubicEase EasingMode="EaseOut"/>
                                        </DoubleAnimation.EasingFunction>
                                    </DoubleAnimation>
                                </Storyboard>
                            </BeginStoryboard>
                        </DataTrigger.ExitActions>
                    </DataTrigger>
                    <!-- Ícones Coloridos Baseados no Tag do Botão -->
                    <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=Button}}" Value="Dashboard">
                        <Setter Property="Fill" Value="#31A8FF"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=Button}}" Value="Performance">
                        <Setter Property="Fill" Value="#8B31FF"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=Button}}" Value="Cleanup">
                        <Setter Property="Fill" Value="#10B981"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=Button}}" Value="Network">
                        <Setter Property="Fill" Value="#00D4FF"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=Button}}" Value="Gamer">
                        <Setter Property="Fill" Value="#FF4B6B"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=Button}}" Value="Diagnostics">
                        <Setter Property="Fill" Value="#F59E0B"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=Button}}" Value="History">
                        <Setter Property="Fill" Value="#6366F1"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=Button}}" Value="Logs">
                        <Setter Property="Fill" Value="#94A3B8"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=Button}}" Value="Scheduler">
                        <Setter Property="Fill" Value="#EC4899"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=Button}}" Value="System">
                        <Setter Property="Fill" Value="#3B82F6"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=Button}}" Value="Repair">
                        <Setter Property="Fill" Value="#F97316"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=Button}}" Value="Security">
                        <Setter Property="Fill" Value="#EF4444"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=Button}}" Value="Privacy">
                        <Setter Property="Fill" Value="#06B6D4"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=Button}}" Value="Debloat">
                        <Setter Property="Fill" Value="#84CC16"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=Button}}" Value="Recovery">
                        <Setter Property="Fill" Value="#10B981"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=Button}}" Value="DeviceInfo">
                        <Setter Property="Fill" Value="#F59E0B"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=Button}}" Value="Shield">
                        <Setter Property="Fill" Value="#8B31FF"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=Button}}" Value="Benchmark">
                        <Setter Property="Fill" Value="#F97316"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=Button}}" Value="Personalize">
                        <Setter Property="Fill" Value="#F59E0B"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=Button}}" Value="Display">
                        <Setter Property="Fill" Value="#06B6D4"/>
                    </DataTrigger>

<DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=Button}}" Value="StreamHub">
                        <Setter Property="Fill" Value="#9146FF"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=Button}}" Value="Shortcuts">
                        <Setter Property="Fill" Value="#F59E0B"/>
                    </DataTrigger>

                    <!-- Glow no Hover -->
                    <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}}" Value="True">
                        <Setter Property="Effect">
                            <Setter.Value>
                                <DropShadowEffect BlurRadius="12" ShadowDepth="0" Opacity="0.4" Color="{Binding Fill.Color, RelativeSource={RelativeSource Self}}"/>
                            </Setter.Value>
                        </Setter>
                    </DataTrigger>

                    <!-- Modo rail: remove a margem direita e reduz a caixa para 20.
                         A escala NÃO é tocada, e é por isso que a hierarquia
                         sobrevive ao rail: 20 x 0.93 = 18.6 (normal) contra
                         20 x 1.0 = 20 (ativo). Antes ambos ficavam em 20 e o
                         destaque desaparecia ao colapsar o menu. -->
                    <DataTrigger Binding="{Binding IsSidebarExpanded, RelativeSource={RelativeSource AncestorType=Window}}" Value="False">
                        <Setter Property="Margin" Value="0,0,0,0"/>
                        <Setter Property="Width" Value="20"/>
                        <Setter Property="Height" Value="20"/>
                        <Setter Property="Effect">
                            <Setter.Value>
                                <DropShadowEffect BlurRadius="6" ShadowDepth="0" Opacity="0.35" Color="{Binding Fill.Color, RelativeSource={RelativeSource Self}}"/>
                            </Setter.Value>
                        </Setter>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Style.Resources>
        <Style.Triggers>
             <Trigger Property="IsMouseOver" Value="True">
                 <Setter Property="Foreground" Value="{DynamicResource DefaultTextBrush}"/>
             </Trigger>
<!-- Modo rail: encolhe o botão para apenas o ícone centralizado com distância adequada da borda -->
              <DataTrigger Binding="{Binding IsSidebarExpanded, RelativeSource={RelativeSource AncestorType=Window}}" Value="False">
                  <Setter Property="Margin" Value="8,3,8,3"/>
                  <Setter Property="Padding" Value="0,12,0,12"/>
                  <Setter Property="HorizontalContentAlignment" Value="Center"/>
              </DataTrigger>
        </Style.Triggers>
    </Style>
    
    <!-- ============================================ -->
    <!-- BOTÃO DE NAVEGAÇÃO ATIVO (PREMIUM)          -->
    <!-- CORREÇÃO: Height="Auto" + MinHeight + Padding adequado -->
    <!-- ============================================ -->
    <Style x:Key="PremiumNavButtonActiveStyle" TargetType="Button" BasedOn="{StaticResource PremiumNavButtonStyle}">
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Height" Value="Auto"/>
        <Setter Property="MinHeight" Value="48"/>
        <Setter Property="Padding" Value="16,12,16,12"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="UseLayoutRounding" Value="True"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid Background="Transparent">
                        <!-- Background Ativo com Gradiente Voltris -->
                        <Border x:Name="BackgroundBorder"
                                CornerRadius="12"
                                UseLayoutRounding="True"
                                SnapsToDevicePixels="True">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0" Opacity="0.15">
                                    <GradientStop Color="#FF4B6B" Offset="0"/>
                                    <GradientStop Color="#8B31FF" Offset="0.5"/>
                                    <GradientStop Color="#31A8FF" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Border.BorderThickness>0</Border.BorderThickness>
                            
                            <ContentPresenter x:Name="ActivePresenter" HorizontalAlignment="Left" 
                                              VerticalAlignment="Center"
                                              Margin="14,0,14,0"/>
                        </Border>
                        
                        <!-- Indicador Ativo (Melhorado estilo SaaS) -->
                        <Border x:Name="LeftIndicator"
                                Width="4"
                                Opacity="1"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Height="22"
                                Margin="0,0,0,0"
                                CornerRadius="0,3,3,0"
                                Background="{StaticResource SidebarBrandGradient}"
                                UseLayoutRounding="True"
                                SnapsToDevicePixels="True">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="12" ShadowDepth="0" Color="#8B31FF" Opacity="0.6"/>
                            </Border.Effect>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsSidebarExpanded, RelativeSource={RelativeSource AncestorType=Window}}" Value="False">
                            <Setter TargetName="ActivePresenter" Property="Margin" Value="0"/>
                            <Setter TargetName="ActivePresenter" Property="HorizontalAlignment" Value="Center"/>
                            <Setter TargetName="BackgroundBorder" Property="CornerRadius" Value="8"/>
                            <Setter TargetName="LeftIndicator" Property="Height" Value="30"/>
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Resources>
            <!-- Sobrescrever o Estilo de Path para o estado ATIVO -->
            <Style TargetType="Path">
                <!-- Ícone selecionado: mesma caixa de layout do não selecionado
                     (22x22) e escala 1.0 contra 0.93. É a MESMA caixa para os
                     dois estados de propósito — assim o rótulo de texto não
                     salta de coluna quando a página muda, e o RenderTransform
                     garante que nada reflui. -->
                <Setter Property="Width" Value="22"/>
                <Setter Property="Height" Value="22"/>
                <Setter Property="Stretch" Value="Uniform"/>
                <Setter Property="Margin" Value="0,0,12,0"/>
                <Setter Property="UseLayoutRounding" Value="True"/>
                <Setter Property="SnapsToDevicePixels" Value="True"/>
                <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
                <Setter Property="RenderTransform">
                    <Setter.Value>
                        <ScaleTransform ScaleX="1" ScaleY="1"/>
                    </Setter.Value>
                </Setter>
                <!-- No estado ativo, o ícone brilha com sua cor temática -->
                <Setter Property="Effect">
                    <Setter.Value>
                        <DropShadowEffect BlurRadius="15" ShadowDepth="0" Opacity="0.5" Color="{Binding Fill.Color, RelativeSource={RelativeSource Self}}"/>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <!-- AUMENTA SUAVEMENTE AO SER SELECIONADO.
                         A seleção troca o Button.Style, o template é recriado, o
                         Path é novo e o Loaded dispara esta animação.

                         De 0.5 para 1.0 (o valor antigo) era um zoom de 2x — o
                         "zoom exagerado" que o pedido proíbe. Agora parte de
                         0.93, que é a escala exata de onde o item saiu: o
                         usuário vê o ícone crescer da posição de origem para a
                         de destino, e não um salto de brilho.

                         0,22s com CubicEase EaseOut: curta, sem bounce, sem
                         elasticidade. Sem RepeatBehavior, o Storyboard termina
                         e não deixa nenhum trabalho contínuo. -->
                    <EventTrigger RoutedEvent="Loaded">
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                 From="0.93" To="1" Duration="0:0:0.22">
