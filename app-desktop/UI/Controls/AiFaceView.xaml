<UserControl x:Class="VoltrisOptimizer.UI.Controls.AiFaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="104" Height="104"
             TextOptions.TextFormattingMode="Ideal"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">

    <!--
        ROSTO DA IA - reconstrucao visual completa.

        CONCEITO: um rosto humano ESTILIZIZADO desenhado com luz, nao com cimento.
        Nao e visor de capacete, nao e robo, nao e emoji. E um rosto de verdade -
        com palpebra, cilio, sobrancelha afilada, nariz e boca que muda de curva -
        renderizado em linhas finas sobre um campo escuro, o que da a sensacao de
        inteligencia em vez de substancia.

        TRES REGRAS DE DESENHO (o que separa "desenhado" de "rabiscado"):

          1. PESO DE TRACO. O olho humano e definido pela PALPEBRA, nao pelo
             globo. Entao a fenda e preenchida E tem a linha de cilio por cima,
             traco 1.55. A boca e traco 2.2. A sobrancelha e a mais grossa de
             todas (forma preenchida) porque e ela que ancora o rosto.

          2. ASSIMETRIA VIVA. A versao anterior desenhava olho esquerdo e direito
             como copias espelhadas. Aqui a expressao e uma funcao de numeros, e
             os dois olhos recebem parametros LEVEMENTE diferentes (ver
             BrowAsymmetry em AiFaceExpression). Rosto humano nao e simetrico.

          3. POUCO, E PRECISO. Nenhum Effect, nenhum Blur, nenhum bitmap. O
             volume vem de gradiente radial estatico + 3 auras em anel. Brilho e
             uma mudanca de alpha, que a GPU resolve de graca.

        NESTE ARQUIVO NAO HA NENHUM Binding de mood nem DataTrigger - de
        proposito. Ler o mood via Source={x:Reference Face} de dentro do proprio
        conteudo da UserControl e uma dependencia ciclica e estoura em runtime.
        Quem aplica a expressao e AiFaceView.xaml.cs, usando AiFaceExpression
        (numeros) + AiFaceGeometry (numeros -> Bezier).
    -->

    <!-- O Viewbox NAO tem Width/Height fixos de propósito.
         Com "104x104" cravado, o Viewbox desenhava sempre em 104px e o
         Width/Height do UserControl era ignorado: instanciar o rosto com
         190px (como na tela de Perfil Inteligente) renderizava um rosto de
         104px, com respiracao, tilt e piscada comprimidos ao ponto de
         parecer estatico. Sem tamanho, ele ocupa o controle e escala o
         Stage de 100x100 uniformemente — o botao do Dashboard (104x104)
         continua exatamente igual, porque o controle la mantem 104. -->
    <Viewbox Stretch="Uniform">
        <Grid x:Name="Stage" Width="100" Height="100" RenderTransformOrigin="0.5,0.5">

            <!-- ══ CAMADA 1: ICONE DE RAIO (hover) ══════════════════════════
                 Vive ATRAS do rosto e com opacidade 0 no repouso. O codigo
                 cruza a opacidade das duas camadas; como o raio esta atras,
                 ele "aparece por tras" do rosto em vez de cruzar por cima.

                 COR: usa a MESMA brush do titulo "Voltris Optimizer" do
                 header (MainWindow.xaml:181 -> VoltrisGradientHorizontalBrush,
                 #FF4B6B -> #8B31FF -> #31A8FF). Nao e uma copia das cores: e
                 a propria brush, via DynamicResource. Consequencias praticas:
                 (a) o raio nunca pode dessincronizar do titulo, porque sao o
                 mesmo objeto; (b) se o tema trocar a assinatura, o raio troca
                 junto. DynamicResource e obrigatorio aqui - StaticResource
                 congelaria no load e o titulo (que usa StaticResource) ficaria
                 desatualizado em troca de tema, mas o raio nao. -->
            <Grid x:Name="BoltLayer" Width="100" Height="100" Opacity="0" IsHitTestVisible="False"
                  RenderTransformOrigin="0.5,0.5">
                <Grid.RenderTransform>
                    <ScaleTransform x:Name="BoltScale" ScaleX="0.92" ScaleY="0.92"/>
                </Grid.RenderTransform>

                <!-- Blooms de energia: dois halos radiais SEM borda. Nao sao
                     circulos - sao luz. E o que da "peso" ao raio sem
                     desenhar um anel em volta dele. -->
                <Ellipse x:Name="BoltBloom" Width="86" Height="86" HorizontalAlignment="Center" VerticalAlignment="Center"
                         Opacity="0" RenderTransformOrigin="0.5,0.5">
                    <Ellipse.Fill>
                        <RadialGradientBrush x:Name="BoltBloomBrush" GradientOrigin="0.5,0.5" Center="0.5,0.5"
                                             RadiusX="0.5" RadiusY="0.5">
                            <GradientStop Color="#668B31FF" Offset="0.30"/>
                            <GradientStop Color="#338B31FF" Offset="0.62"/>
                            <GradientStop Color="#008B31FF" Offset="1"/>
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                    <Ellipse.RenderTransform>
                        <ScaleTransform x:Name="BoltBloomScale" ScaleX="1" ScaleY="1"/>
                    </Ellipse.RenderTransform>
                </Ellipse>

                <!-- PULSO DE ENERGIA: substitui o arco que GIRAVA em volta do
                     botao. O arco rodava continuamente e lia como "uma bola
                     circular dando a volta" - era o efeito que o usuario nao
                     queria. O pulso EXPANDE a partir do raio e some, com
                     ciclos defasados: a energia nasce, se abre e morre, sem
                     nada percorrendo o contorno. -->
                <Ellipse x:Name="BoltPulse" Width="64" Height="64" HorizontalAlignment="Center" VerticalAlignment="Center"
                         StrokeThickness="1.1" Fill="Transparent" Opacity="0"
                         RenderTransformOrigin="0.5,0.5">
                    <Ellipse.Stroke>
                        <SolidColorBrush x:Name="BoltPulseBrush" Color="#FF31A8FF"/>
                    </Ellipse.Stroke>
                    <Ellipse.RenderTransform>
                        <ScaleTransform x:Name="BoltPulseScale" ScaleX="0.7" ScaleY="0.7"/>
                    </Ellipse.RenderTransform>
                </Ellipse>

                <!-- SEGUNDO PULSO, defasado em 180 graus de ciclo. Dois pulsos
                     alternados dao a sensacao de respiracao sem nunca mover
                     um objeto solido pelo botao. -->
                <Ellipse x:Name="BoltPulse2" Width="64" Height="64" HorizontalAlignment="Center" VerticalAlignment="Center"
                         StrokeThickness="0.9" Fill="Transparent" Opacity="0"
                         RenderTransformOrigin="0.5,0.5">
                    <Ellipse.Stroke>
                        <SolidColorBrush x:Name="BoltPulse2Brush" Color="#FF8B31FF"/>
                    </Ellipse.Stroke>
                    <Ellipse.RenderTransform>
                        <ScaleTransform x:Name="BoltPulse2Scale" ScaleX="0.7" ScaleY="0.7"/>
                    </Ellipse.RenderTransform>
                </Ellipse>

                <!-- CORPO DO RAIO: a brush do titulo, literal. -->
                <Path x:Name="BoltBody" Stretch="None" Width="100" Height="100" StrokeThickness="0" Opacity="0">
                    <Path.Fill>
                        <DynamicResource ResourceKey="VoltrisGradientHorizontalBrush"/>
                    </Path.Fill>
                </Path>

                <!-- NUCLEO: fatia clara ao longo da espinha. E o que faz o
                     simbolo parecer METAL e nao "desenho preenchido de cor".
                     Fica por cima do corpo, entao o gradiente da marca
                     continua visivel nas laterais. -->
                <Path x:Name="BoltCore" Stretch="None" Width="100" Height="100" Opacity="0">
                    <Path.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#E6FFFFFF" Offset="0"/>
                            <GradientStop Color="#40FFFFFF" Offset="0.55"/>
                            <GradientStop Color="#00FFFFFF" Offset="1"/>
                        </LinearGradientBrush>
                    </Path.Fill>
                </Path>

                <!-- Contorno: fio de 1 unidade no azul da marca. Dá a borda
                     nítida que separa o raio do fundo escuro sem engrossar. -->
                <Path x:Name="BoltOutline" Stretch="None" Width="100" Height="100" Opacity="0"
                      StrokeThickness="0.85" StrokeStartLineCap="Round" StrokeLineJoin="Round" Fill="Transparent">
                    <Path.Stroke>
                        <SolidColorBrush x:Name="BoltOutlineBrush" Color="#B331A8FF"/>
                    </Path.Stroke>
                </Path>

                <!-- PARTÍCULAS MODERNAS (hover): 4 ESTRIAS de luz em vez de
                     pontos circulares. As faiscas antigas (Spark1..3) eram
                     Ellipse - 3,0 / 2,4 / 2,0 px de diametro - e saiam do
                     raio como se fossem bolas. Agora cada particula e um
                     filete de 1,6 x 17 unidades, com a cauda transparente e
                     a cabeca acesa, apontado para fora e viajando para
                     longe. A silhueta e olinear: o olho le "raio de
                     energia", nao "bolinha". Gradiente na vertical porque o
                     filete ja nasce vertical (Angle 0 = para cima) e cada
                     estria so e ROTACIONADO, nunca reescrito. -->
                <Rectangle x:Name="Ray1" Width="1.6" Height="17" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="49.2,41.5,0,0" Opacity="0" RenderTransformOrigin="0.5,0.5">
                    <Rectangle.RenderTransform>
                        <TransformGroup>
                            <RotateTransform x:Name="RayRotate1" Angle="28"/>
                            <TranslateTransform x:Name="RayMove1"/>
                        </TransformGroup>
                    </Rectangle.RenderTransform>
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,1" EndPoint="0,0" x:Name="RayBrush1">
                            <GradientStop Color="#00FFFFFF" Offset="0"/>
                            <GradientStop Color="#59FFFFFF" Offset="0.45"/>
                            <GradientStop Color="#E6FFFFFF" Offset="1"/>
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
                <Rectangle x:Name="Ray2" Width="1.6" Height="17" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="49.2,41.5,0,0" Opacity="0" RenderTransformOrigin="0.5,0.5">
                    <Rectangle.RenderTransform>
                        <TransformGroup>
                            <RotateTransform x:Name="RayRotate2" Angle="152"/>
                            <TranslateTransform x:Name="RayMove2"/>
                        </TransformGroup>
                    </Rectangle.RenderTransform>
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,1" EndPoint="0,0" x:Name="RayBrush2">
                            <GradientStop Color="#00FFFFFF" Offset="0"/>
                            <GradientStop Color="#59FFFFFF" Offset="0.45"/>
                            <GradientStop Color="#E6FFFFFF" Offset="1"/>
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
                <Rectangle x:Name="Ray3" Width="1.6" Height="17" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="49.2,41.5,0,0" Opacity="0" RenderTransformOrigin="0.5,0.5">
                    <Rectangle.RenderTransform>
                        <TransformGroup>
                            <RotateTransform x:Name="RayRotate3" Angle="208"/>
                            <TranslateTransform x:Name="RayMove3"/>
                        </TransformGroup>
                    </Rectangle.RenderTransform>
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,1" EndPoint="0,0" x:Name="RayBrush3">
                            <GradientStop Color="#00FFFFFF" Offset="0"/>
                            <GradientStop Color="#59FFFFFF" Offset="0.45"/>
                            <GradientStop Color="#E6FFFFFF" Offset="1"/>
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
                <Rectangle x:Name="Ray4" Width="1.6" Height="17" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="49.2,41.5,0,0" Opacity="0" RenderTransformOrigin="0.5,0.5">
                    <Rectangle.RenderTransform>
                        <TransformGroup>
                            <RotateTransform x:Name="RayRotate4" Angle="332"/>
                            <TranslateTransform x:Name="RayMove4"/>
                        </TransformGroup>
                    </Rectangle.RenderTransform>
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,1" EndPoint="0,0" x:Name="RayBrush4">
                            <GradientStop Color="#00FFFFFF" Offset="0"/>
                            <GradientStop Color="#59FFFFFF" Offset="0.45"/>
                            <GradientStop Color="#E6FFFFFF" Offset="1"/>
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
            </Grid>

            <!-- ══ CAMADA 1b: PARTÍCULAS DE REPOUSO ═══════════════════════
                 5 motes que sobem em torno do rosto, com deriva lateral
                 senoidal e periods DESIGUAIS entre si. Periodos iguais
                 fariam o conjunto subir em bloco, e o olho le "fumaça"
                 mesmo com 5 elementos. São Ellipse + Transform: sem
                 geometria, sem Effect, resolvido na GPU. Pausam juntas com
                 o relogio (item 10). -->
            <Canvas x:Name="MotesCanvas" Width="100" Height="100" IsHitTestVisible="False" Opacity="0">
                <Ellipse x:Name="Mote1" Width="3.4" Height="3.4" RenderTransformOrigin="0.5,0.5">
                    <Ellipse.Fill><SolidColorBrush x:Name="MoteBrush1" Color="#B331A8FF"/></Ellipse.Fill>
                    <Ellipse.RenderTransform>
                        <TranslateTransform x:Name="MoteMove1" X="0" Y="0"/>
                    </Ellipse.RenderTransform>
                </Ellipse>
                <Ellipse x:Name="Mote2" Width="2.6" Height="2.6" RenderTransformOrigin="0.5,0.5">
                    <Ellipse.Fill><SolidColorBrush x:Name="MoteBrush2" Color="#9931A8FF"/></Ellipse.Fill>
                    <Ellipse.RenderTransform>
                        <TranslateTransform x:Name="MoteMove2" X="0" Y="0"/>
                    </Ellipse.RenderTransform>
                </Ellipse>
                <Ellipse x:Name="Mote3" Width="2.2" Height="2.2" RenderTransformOrigin="0.5,0.5">
                    <Ellipse.Fill><SolidColorBrush x:Name="MoteBrush3" Color="#808B31FF"/></Ellipse.Fill>
                    <Ellipse.RenderTransform>
                        <TranslateTransform x:Name="MoteMove3" X="0" Y="0"/>
                    </Ellipse.RenderTransform>
                </Ellipse>
                <Ellipse x:Name="Mote4" Width="3.0" Height="3.0" RenderTransformOrigin="0.5,0.5">
                    <Ellipse.Fill><SolidColorBrush x:Name="MoteBrush4" Color="#8AFF4B6B"/></Ellipse.Fill>
                    <Ellipse.RenderTransform>
                        <TranslateTransform x:Name="MoteMove4" X="0" Y="0"/>
                    </Ellipse.RenderTransform>
                </Ellipse>
                <Ellipse x:Name="Mote5" Width="2.0" Height="2.0" RenderTransformOrigin="0.5,0.5">
                    <Ellipse.Fill><SolidColorBrush x:Name="MoteBrush5" Color="#B3FFFFFF"/></Ellipse.Fill>
                    <Ellipse.RenderTransform>
                        <TranslateTransform x:Name="MoteMove5" X="0" Y="0"/>
                    </Ellipse.RenderTransform>
                </Ellipse>
            </Canvas>


            <!-- ══ CAMADA 2: O ROSTO ══════════════════════════════════════
                 Tudo aqui esta dentro de Root, que recebe respiro, inclinacao
                 e tranco. Os transforms sao todos declarados no XAML para que
                 o codigo nao precise criar nenhum em runtime. -->
            <Grid x:Name="Root" Width="100" Height="100" RenderTransformOrigin="0.5,0.5">
                <Grid.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform x:Name="Breath" ScaleX="1" ScaleY="1" CenterX="50" CenterY="51.5"/>
                        <RotateTransform x:Name="Tilt" Angle="0" CenterX="50" CenterY="51.5"/>
                        <TranslateTransform x:Name="Bob" X="0" Y="0"/>
                    </TransformGroup>
                </Grid.RenderTransform>

                <!-- ── LUZ (sem círculo) ──
                     O pedido foi "só o rosto": saem o anel externo (LensRing)
                     e a auréola com traço (AuraTight), que eram os dois
                     círculos concêntricos em volta da face. O que fica é UM
                     bloom radial sem borda, menor que a face e mais escuro no
                     miolo: ele dá profundidade sem desenhar nenhuma forma
                     circular. O brilho é alpha, então não custa GPU. -->
                <Ellipse x:Name="AuraWide" Width="104" Height="104" HorizontalAlignment="Center" VerticalAlignment="Center"
                         Opacity="0.18" RenderTransformOrigin="0.5,0.5">
                    <Ellipse.RenderTransform>
                        <ScaleTransform x:Name="AuraWideScale" ScaleX="1" ScaleY="1"/>
                    </Ellipse.RenderTransform>
                </Ellipse>

                <!-- ── CAMPO DA FACE: disco escuro opaco. Faz o rosto existir
                     como superficie em vez de flutuar. ── -->
                <Path x:Name="FaceField" Stretch="None" Width="100" Height="100" Opacity="0.94">
                    <Path.Fill>
                        <RadialGradientBrush GradientOrigin="0.40,0.28" Center="0.5,0.5" RadiusX="0.78" RadiusY="0.82">
                            <GradientStop Color="#FF1A2136" Offset="0"/>
                            <GradientStop Color="#FF0E1322" Offset="0.58"/>
                            <GradientStop Color="#FF05070E" Offset="1"/>
                        </RadialGradientBrush>
                    </Path.Fill>
                </Path>

                <!-- Silhueta: o contorno fino que da a forma facial elegante.
                     E o unico elemento cuja opacidade muda com o humor
                     (AiFaceExpression.Contour) - e ele carrega a "presenca". -->
                <Path x:Name="FaceContour" Stretch="None" Width="100" Height="100"
                      StrokeThickness="1.15" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                      StrokeLineJoin="Round" Fill="Transparent"/>

                <!-- Brilho de vidro: da volume sem custar nada. -->
                <Ellipse Width="46" Height="22" HorizontalAlignment="Center" VerticalAlignment="Center"
                         Margin="0,-22,0,0" Fill="#FFFFFFFF" Opacity="0.045" RenderTransformOrigin="0.5,0.5">
                    <Ellipse.RenderTransform>
                        <RotateTransform Angle="-16"/>
                    </Ellipse.RenderTransform>
                </Ellipse>

                <!-- ── BOCHECHAS: duas massas de luz que sobem com o humor.
                     Ellipse + Transform, nunca geometria. ── -->
                <Ellipse x:Name="CheekL" Width="17" Height="10" HorizontalAlignment="Left" VerticalAlignment="Top"
                         Margin="27.5,52,0,0" Opacity="0" RenderTransformOrigin="0.5,0.5">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="#FFFFFFFF" Offset="0"/>
                            <GradientStop Color="#00FFFFFF" Offset="1"/>
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                    <Ellipse.RenderTransform>
                        <TranslateTransform x:Name="CheekLiftL" X="0" Y="0"/>
                    </Ellipse.RenderTransform>
                </Ellipse>
                <Ellipse x:Name="CheekR" Width="17" Height="10" HorizontalAlignment="Right" VerticalAlignment="Top"
                         Margin="0,52,27.5,0" Opacity="0" RenderTransformOrigin="0.5,0.5">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="#FFFFFFFF" Offset="0"/>
                            <GradientStop Color="#00FFFFFF" Offset="1"/>
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                    <Ellipse.RenderTransform>
                        <TranslateTransform x:Name="CheekLiftR" X="0" Y="0"/>
                    </Ellipse.RenderTransform>
                </Ellipse>

                <!-- ══ EXPRESSÃO ═══════════════════════════════════════════ -->

                <!-- Nariz: duas tracos minimos. Opacidade 0.14..0.34 - o
                     detalhe que mais humaniza, e por isso que existe mesmo no
                     rosto "tecnologico". -->
                <Path x:Name="Nose" Stretch="None" Width="100" Height="100"
                      StrokeThickness="0.9" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                      Fill="Transparent" Opacity="0"/>

                <!-- ─────── OLHO ESQUERDO ───────
                     O TransformGroup e deliberado: Translate (olhar) ANTES de
                     Scale (abertura). Assim a piscada achata em espaco local, no
                     centro do olho, e o alcance do olhar NAO encolhe quando ela
                     pisca - que e o erro classico de quem faz esse efeito. -->
                <Grid x:Name="EyeL" Width="100" Height="100">
                    <Grid.RenderTransform>
                        <TransformGroup>
                            <TranslateTransform x:Name="GazeL" X="0" Y="0"/>
                            <ScaleTransform x:Name="ApertureL" ScaleX="1" ScaleY="1" CenterX="36.5" CenterY="46"/>
                        </TransformGroup>
                    </Grid.RenderTransform>
<Ellipse x:Name="IrisL" Width="12.6" Height="12.6" HorizontalAlignment="Left" VerticalAlignment="Top"
                             Margin="30.2,39.7,0,0" RenderTransformOrigin="0.5,0.5">
                        <Ellipse.RenderTransform>
                            <ScaleTransform x:Name="IrisScaleL" ScaleX="1" ScaleY="1"/>
                        </Ellipse.RenderTransform>
                        <Ellipse.Fill>
                            <RadialGradientBrush GradientOrigin="0.42,0.34" Center="0.5,0.5" RadiusX="0.72" RadiusY="0.72">
                                <GradientStop x:Name="IrisStopInL" Color="#FFFFFFFF" Offset="0"/>
                                <GradientStop x:Name="IrisStopOutL" Color="#FF4B6BFF" Offset="1"/>
                            </RadialGradientBrush>
                        </Ellipse.Fill>
                    </Ellipse>
                    <!-- Anel da iris: Le "esta olhando com atencao" sem mudar
                         a forma do olho. Sobe com BrainMood.Furious/Errored. -->
                    <Ellipse x:Name="IrisRingL" Width="17.2" Height="17.2" HorizontalAlignment="Left" VerticalAlignment="Top"
                             Margin="27.9,37.4,0,0" RenderTransformOrigin="0.5,0.5"
                             StrokeThickness="0.9" Opacity="0">
                        <Ellipse.Stroke>
                            <SolidColorBrush x:Name="IrisRingBrushL" Color="#FFFFFFFF"/>
                        </Ellipse.Stroke>
                    </Ellipse>
                    <Ellipse x:Name="PupilL" Width="5.4" Height="5.4" HorizontalAlignment="Left" VerticalAlignment="Top"
                             Margin="33.8,43.3,0,0" RenderTransformOrigin="0.5,0.5">
                        <Ellipse.RenderTransform>
                            <ScaleTransform x:Name="PupilScaleL" ScaleX="1" ScaleY="1"/>
                        </Ellipse.RenderTransform>
                        <Ellipse.Fill>
                            <SolidColorBrush Color="#FF04060C"/>
                        </Ellipse.Fill>
                    </Ellipse>
                    <!-- Brilho especular: a luz vem de UMA direcao, entao o
                         reflexo fica no canto superior-esquerdo dos DOIS olhos. -->
                    <Ellipse x:Name="GlintL" Width="2.5" Height="2.5" HorizontalAlignment="Left" VerticalAlignment="Top"
                             Margin="33.2,41.6,0,0" Opacity="0.9"/>

                    <Path x:Name="EyeShapeL" Stretch="None" Width="100" Height="100" Visibility="Collapsed" Fill="#FF060A14"/>
                    <Path x:Name="EyeLidL" Stretch="None" Width="100" Height="100" Visibility="Collapsed"
                          StrokeThickness="1.55" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="Transparent"/>
                    <Path x:Name="EyeLidLowL" Stretch="None" Width="100" Height="100" Visibility="Collapsed"
                          StrokeThickness="0.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          Fill="Transparent" Opacity="0.32"/>
                    <Path x:Name="EyeShutL" Stretch="None" Width="100" Height="100" Visibility="Collapsed"
                          StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="Transparent"/>


                </Grid>

                <!-- ─────── OLHO DIREITO ─────── -->
                <Grid x:Name="EyeR" Width="100" Height="100">
                    <Grid.RenderTransform>
                        <TransformGroup>
                            <TranslateTransform x:Name="GazeR" X="0" Y="0"/>
                            <ScaleTransform x:Name="ApertureR" ScaleX="1" ScaleY="1" CenterX="63.5" CenterY="46"/>
                        </TransformGroup>
                    </Grid.RenderTransform>
<Ellipse x:Name="IrisR" Width="12.6" Height="12.6" HorizontalAlignment="Right" VerticalAlignment="Top"
                             Margin="0,39.7,30.2,0" RenderTransformOrigin="0.5,0.5">
                        <Ellipse.RenderTransform>
                            <ScaleTransform x:Name="IrisScaleR" ScaleX="1" ScaleY="1"/>
                        </Ellipse.RenderTransform>
                        <Ellipse.Fill>
                            <RadialGradientBrush GradientOrigin="0.42,0.34" Center="0.5,0.5" RadiusX="0.72" RadiusY="0.72">
                                <GradientStop x:Name="IrisStopInR" Color="#FFFFFFFF" Offset="0"/>
                                <GradientStop x:Name="IrisStopOutR" Color="#FF4B6BFF" Offset="1"/>
                            </RadialGradientBrush>
                        </Ellipse.Fill>
                    </Ellipse>
                    <Ellipse x:Name="IrisRingR" Width="17.2" Height="17.2" HorizontalAlignment="Right" VerticalAlignment="Top"
                             Margin="0,37.4,27.9,0" RenderTransformOrigin="0.5,0.5"
                             StrokeThickness="0.9" Opacity="0">
                        <Ellipse.Stroke>
                            <SolidColorBrush x:Name="IrisRingBrushR" Color="#FFFFFFFF"/>
                        </Ellipse.Stroke>
                    </Ellipse>
                    <Ellipse x:Name="PupilR" Width="5.4" Height="5.4" HorizontalAlignment="Right" VerticalAlignment="Top"
                             Margin="0,43.3,33.8,0" RenderTransformOrigin="0.5,0.5">
                        <Ellipse.RenderTransform>
                            <ScaleTransform x:Name="PupilScaleR" ScaleX="1" ScaleY="1"/>
                        </Ellipse.RenderTransform>
                        <Ellipse.Fill>
                            <SolidColorBrush Color="#FF04060C"/>
                        </Ellipse.Fill>
                    </Ellipse>
                    <Ellipse x:Name="GlintR" Width="2.5" Height="2.5" HorizontalAlignment="Right" VerticalAlignment="Top"
                             Margin="0,41.6,33.2,0" Opacity="0.9"/>

                    <Path x:Name="EyeShapeR" Stretch="None" Width="100" Height="100" Visibility="Collapsed" Fill="#FF060A14"/>
                    <Path x:Name="EyeLidR" Stretch="None" Width="100" Height="100" Visibility="Collapsed"
                          StrokeThickness="1.55" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="Transparent"/>
                    <Path x:Name="EyeLidLowR" Stretch="None" Width="100" Height="100" Visibility="Collapsed"
                          StrokeThickness="0.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          Fill="Transparent" Opacity="0.32"/>
                    <Path x:Name="EyeShutR" Stretch="None" Width="100" Height="100" Visibility="Collapsed"
                          StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="Transparent"/>


                </Grid>

                <!-- ── SOBRANCELHAS: formas preenchidas e afiladas.
                     Desenhadas DEPOIS dos olhos de proposito - uma sobrancelha
                     humana passa por cima da borda superior do olho, e essa
                     sobreposicao e o que da leitura de profundidade. ── -->
                <Path x:Name="BrowL" Stretch="None" Width="100" Height="100" Opacity="0"/>
                <Path x:Name="BrowR" Stretch="None" Width="100" Height="100" Opacity="0"/>

                <!-- ── LÁGRIMAS ──
                     Moram AQUI, e não dentro de EyeL/EyeR. De dentro do grupo
                     de piscada elas seriam achatadas pela ScaleTransform da
                     pálpebra - e lágrima é da face, não do globo ocular. Só
                     aparecem com Tear > 0 (único estado: CHORANDO). -->
                <Path x:Name="TearL" Stretch="None" Width="100" Height="100" Visibility="Collapsed" Opacity="0">
                    <Path.RenderTransform>
                        <TranslateTransform x:Name="TearFallL" X="0" Y="0"/>
                    </Path.RenderTransform>
                </Path>
                <Path x:Name="TearR" Stretch="None" Width="100" Height="100" Visibility="Collapsed" Opacity="0">
                    <Path.RenderTransform>
                        <TranslateTransform x:Name="TearFallR" X="0" Y="0"/>
                    </Path.RenderTransform>
                </Path>


                <!-- ── BOCA: o selo labial e a forma aberta nunca coexistem
                     abertos ao mesmo tempo. ── -->
                <Path x:Name="MouthSeam" Stretch="None" Width="100" Height="100" Visibility="Collapsed"
                      StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="Transparent"/>
                <Path x:Name="MouthShape" Stretch="None" Width="100" Height="100" Visibility="Collapsed" Fill="#FF050810"/>
                <Path x:Name="MouthTeeth" Stretch="None" Width="100" Height="100" Visibility="Collapsed"
                      Stroke="#FFFFF6F4" StrokeThickness="1.1" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                      Fill="Transparent" Opacity="0.9"/>

                <!-- ── ACENTO 1: PENSANDO. Tres pontos de carga andando pela
                     diagonal. Nao e "bolha de pensamento" - e leitura de
                     dado, coerente com o que a IA esta fazendo. ── -->
                <Grid x:Name="ThinkDots" Width="100" Height="100" Opacity="0" IsHitTestVisible="False">
                    <Ellipse x:Name="ThinkDot1" Width="5.0" Height="5.0" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="79,20,0,0"/>
                    <Ellipse x:Name="ThinkDot2" Width="3.8" Height="3.8" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="73,13,0,0" Opacity="0.7"/>
                    <Ellipse x:Name="ThinkDot3" Width="2.8" Height="2.8" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="67.5,7.5,0,0" Opacity="0.45"/>
                </Grid>

                <!-- ── ACENTO 2: PROCESSANDO. Tres barras com um brilho
                     viajando. Le "trabalho em andamento" sem texto. ── -->
                <Grid x:Name="WorkBars" Width="100" Height="100" Opacity="0" IsHitTestVisible="False">
                    <Rectangle x:Name="Bar1" Width="9" Height="3.2" RadiusX="1.6" RadiusY="1.6" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="36,79.5,0,0" Opacity="0.25"/>
                    <Rectangle x:Name="Bar2" Width="9" Height="3.2" RadiusX="1.6" RadiusY="1.6" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="45.5,79.5,0,0" Opacity="0.25"/>
                    <Rectangle x:Name="Bar3" Width="9" Height="3.2" RadiusX="1.6" RadiusY="1.6" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="55,79.5,0,0" Opacity="0.25"/>
                </Grid>

                <!-- ── ACENTO 3: ALERTA. Um unico arco fino acima da testa que
                     so aparece em Concerned/Frustrated/Errored/Furious. E o
                     "aviso" sem sair do registro de expressao facial. ── -->
                <Path x:Name="AlertArc" Stretch="None" Width="100" Height="100" Opacity="0"
                      StrokeThickness="1.2" StrokeStartLineCap="Round" Fill="Transparent"
                      Data="M42,24.5 Q50,19.5 58,24.5"/>
            </Grid>

            <!-- ══ CAMADA 3: nada ═══════════════════════════════════════════
                 Aqui vivia o LensRing - o anel de 98/98 que "amarrava" o rosto
                 ao círculo do Dashboard. Foi REMOVIDO a pedido: com ele, o
                 elemento lia como "um rosto dentro de um disco", e não como
                 o rosto. A face já se separa sozinha do fundo escuro do botão
                 pelo seu próprio contorno (FaceContour) e pelo bloom sem
                 borda da Camada 2. Sem círculo, sobra só o rosto. -->
        </Grid>
    </Viewbox>
</UserControl>
