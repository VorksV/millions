<UserControl x:Class="VoltrisOptimizer.UI.Controls.LicenseShieldIcon"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="20" Height="20"
             Background="Transparent"
             TextOptions.TextFormattingMode="Ideal"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">

    <!--
        ESCUDO DE LICENÇA - metal, luz e estado.

        O QUE MUDOU EM RELAÇÃO AO ÍCONE ANTIGO: antes havia um Path de escudo
        com um gradiente diagonal e um glifo branco por cima, tudo PARADO. Um
        gradiente diagonal estático não é metal: metal é um material cujo
        reflexo se MOVE. Aqui o escudo tem três coisas que o gradiente fixo
        não tinha:

          1. BEVEL DE VERDADE - uma casca externa escura, uma face interna mais
             clara e um par de traços (claro em cima, escuro embaixo) na
             borda. É o par claro/escuro na MESMA aresta que faz o olho ler
             "chanfrado" em vez de "desenhado".

          2. SHEEN DE VARREDURA - duas faixas de luz (uma larga e fraca, uma
             estreita e forte) que atravessam o escudo e voltam, em direções
             opostas. Metal anisotrópico tem reflexo alongado; um gradiente
             radial não teria.

          3. BALANÇO - rotação e torção lentas e defasadas. A luz "anda" sobre
             o escudo mesmo quando a varredura está no fim do curso.

        Os glifos por estado entram com animação própria, não com um corte:
        o tracejado do Standard se DESENHA, a estrela do Pro entra com
        overshoot de mola, as camadas do Enterprise sobem em cascata.

        NENHUM Binding de ViewModel aqui dentro: cor, brilho e ritmo saem de
        <see cref="LicenseIconState"/> em código, para que a troca de plano
        troque paleta E animação no mesmo quadro.
    -->

    <!-- O Viewbox SEM Width/Height fixo: esticado pelo pai, ele escala o palco
         de 140 unidades para whatever o controle medir. No Dashboard ele mede
         20px (dentro do tile de 32) e dá o tamanho pretendido. -->
    <Viewbox>
        <!-- Palco de 140x140: o escudo ocupa 100x100 e a aura 116, para o halo
             não ser cortado pela borda do ícone. -->
        <Grid x:Name="Stage" Width="140" Height="140" RenderTransformOrigin="0.5,0.5">
            <Grid.RenderTransform>
                <ScaleTransform x:Name="HoverScale" ScaleX="1" ScaleY="1"/>
            </Grid.RenderTransform>

            <!-- Balanço: escala, rotação, torção e flutuação num TransformGroup.
                 A escala é a PRIMEIRA de propósito: é ela que dá a este ícone a
                 presença viva do cartão de saúde, porque um metal só com
                 reflexo é bonito mas sutil demais para 20px. -->
            <Grid x:Name="Sway" Width="100" Height="100"
                  HorizontalAlignment="Center" VerticalAlignment="Center"
                  RenderTransformOrigin="0.5,0.5">
                <Grid.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform x:Name="SwayScale" ScaleX="1" ScaleY="1"/>
                        <RotateTransform x:Name="SwayRotate" Angle="0"/>
                        <SkewTransform x:Name="SwaySkew" AngleX="0"/>
                        <TranslateTransform x:Name="SwayFloat" X="0" Y="0"/>
                    </TransformGroup>
                </Grid.RenderTransform>

                <!-- AURA: a casca do escudo dilatada, com a cor do plano. É o
                     "glow" de fundo; o DropShadowEffect do tile é o rebote
                     externo, este é a dispersão colorida. -->
                <Path x:Name="Aura" Width="100" Height="100"
                      HorizontalAlignment="Center" VerticalAlignment="Center"
                      RenderTransformOrigin="0.5,0.5" Opacity="0.22" IsHitTestVisible="False"
                     >
                    <Path.RenderTransform>
                        <ScaleTransform x:Name="AuraScale" ScaleX="1.14" ScaleY="1.14"/>
                    </Path.RenderTransform>
                </Path>

                <!-- CASCA: a borda do escudo. Escura e chanfrada. -->
                <Path x:Name="Shell" Width="100" Height="100"
                      HorizontalAlignment="Center" VerticalAlignment="Center"
                      IsHitTestVisible="False"/>

                <!-- FACE: o campo interno, recuado 4,5 unidades. É aqui que o
                     gradiente do plano entra. -->
                <Path x:Name="Face" Width="100" Height="100"
                      HorizontalAlignment="Center" VerticalAlignment="Center"
                      IsHitTestVisible="False"/>

                <!-- SHEEN: a varredura de luz. O Fill é um LinearGradientBrush
                     cujo Transform é animado em código - como o brush é o
                     PREENCHIMENTO do próprio Path do escudo, a faixa de luz já
                     nasce recortada na silhueta, sem Clip e sem máscara. -->
                <Path x:Name="SheenBroad" Width="100" Height="100"
                      HorizontalAlignment="Center" VerticalAlignment="Center"
                      Opacity="0.5" IsHitTestVisible="False"/>
                <Path x:Name="SheenSharp" Width="100" Height="100"
                      HorizontalAlignment="Center" VerticalAlignment="Center"
                      Opacity="0.7" IsHitTestVisible="False"/>

                <!-- Chanfro gravado: traço claro no topo-esquerda e escuro embaixo
                     - o par que dá a leitura de "entalhado". -->
                <Path x:Name="EngraveLight" Width="100" Height="100"
                      HorizontalAlignment="Center" VerticalAlignment="Center"
                      IsHitTestVisible="False"/>

                <!-- Reflexo especular do rebordo superior: um arco curto no
                     topo, que é onde a luz bate primeiro num escudo deitado. -->
                <Path x:Name="TopGlint" Width="100" Height="100"
                      HorizontalAlignment="Center" VerticalAlignment="Center"
                      IsHitTestVisible="False"/>

                <!-- ══ GLIFOS ═════════════════════════════════════════════════ -->
                <Grid x:Name="GlyphHost" Width="100" Height="100"
                      HorizontalAlignment="Center" VerticalAlignment="Center"
                      IsHitTestVisible="False">

                    <!-- INACTIVE: um traço. Sem licencia ativa não há nada a
                         dizer além de "não há" - e o aço fica sem cor. -->
                    <Grid x:Name="GlyphInactive" Width="100" Height="100"
                          HorizontalAlignment="Center" VerticalAlignment="Center"
                          Opacity="0">
                        <Path x:Name="DashMain" Width="100" Height="100"/>
                        <Path x:Name="DashGhost" Width="100" Height="100" Opacity="0.5"/>
                    </Grid>

                    <!-- STANDARD: visto. O traço se DESENHA (StrokeDashOffset
                         animado em código), o que é a animação de "ativação"
                         que um corte não transmite. -->
                    <Grid x:Name="GlyphStandard" Width="100" Height="100"
                          HorizontalAlignment="Center" VerticalAlignment="Center"
                          Opacity="0">
                        <Path x:Name="CheckGlow" Width="100" Height="100"/>
                        <Path x:Name="Check" Width="100" Height="100"/>
                    </Grid>

                    <!-- PRO: estrela de 5 pontas + duas faíscas que cintilam
                         fora de fase. A estrela entra com mola (overshoot). -->
                    <Grid x:Name="GlyphPro" Width="100" Height="100"
                          HorizontalAlignment="Center" VerticalAlignment="Center"
                          Opacity="0" RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform>
                            <ScaleTransform x:Name="StarScale" ScaleX="1" ScaleY="1"/>
                        </Grid.RenderTransform>
                        <Path x:Name="StarGlow" Width="100" Height="100"/>
                        <Path x:Name="Star" Width="100" Height="100"/>
                        <Path x:Name="Spark1" Width="100" Height="100" Opacity="0.55"/>
                        <Path x:Name="Spark2" Width="100" Height="100" Opacity="0.40"/>
                    </Grid>

                    <!-- ENTERPRISE: duas camadas em perspectiva, que sobem em
                         cascata (a de baixo primeiro, como num escalonamento). -->
                    <Grid x:Name="GlyphEnterprise" Width="100" Height="100"
                          HorizontalAlignment="Center" VerticalAlignment="Center"
                          Opacity="0">
                        <Path x:Name="TierBack" Width="100" Height="100"/>
                        <Path x:Name="TierFront" Width="100" Height="100"/>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </Viewbox>
</UserControl>
