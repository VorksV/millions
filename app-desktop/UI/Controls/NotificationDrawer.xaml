<UserControl xmlns:services="clr-namespace:VoltrisOptimizer.Services" x:Class="VoltrisOptimizer.UI.Controls.NotificationDrawer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="800" d:DesignWidth="400"
             x:Name="Root">

    <UserControl.Resources>
        <!-- ===== CORES LOCAIS COESAS PARA EFEITO GLASSMORPHISM ACRYLIC ===== -->
        <SolidColorBrush x:Key="DrawerBackground" Color="#D90E0E14"/>
        <SolidColorBrush x:Key="DrawerHeaderBackground" Color="#9909090D"/>
        <SolidColorBrush x:Key="DrawerItemBackground"  Color="#4D1D1D2C"/>
        <SolidColorBrush x:Key="DrawerItemHover"   Color="#73252538"/>
        <SolidColorBrush x:Key="DrawerBorderDefault"   Color="#3D2A2A3A"/>
        <SolidColorBrush x:Key="DrawerBorderSubtle" Color="#2A1E1E2A"/>
        <SolidColorBrush x:Key="DrawerBorderHover" Color="#FF303040"/>
        <SolidColorBrush x:Key="DrawerTextPrimary" Color="#FFE5E5E5"/>
        <SolidColorBrush x:Key="DrawerTextSecondary"   Color="#FFB0B0C0"/>
        <SolidColorBrush x:Key="DrawerTextTertiary" Color="#FF808090"/>
        <SolidColorBrush x:Key="DrawerTextMuted"   Color="#FF606070"/>
        <SolidColorBrush x:Key="DrawerPrimaryBrush" Color="#FF31A8FF"/>
        <SolidColorBrush x:Key="DrawerErrorBrush"  Color="#FFE53935"/>
        <SolidColorBrush x:Key="DrawerBgGlowBlue" Color="#FF31A8FF"/>

        <!-- Estilo do item de notificação — APENAS StaticResource local -->
        <Style x:Key="NotificationItemStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource DrawerItemBackground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource DrawerBorderSubtle}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="16,6"/>
            <Setter Property="Opacity" Value="1"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource DrawerItemHover}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource DrawerBorderHover}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Conversor de visibilidade -->
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <Grid x:Name="DrawerRoot"
          HorizontalAlignment="Right"
          Width="400"
          Visibility="Collapsed">
        <Grid.RenderTransform>
            <TranslateTransform x:Name="DrawerTransform" X="400"/>
        </Grid.RenderTransform>

        <Border x:Name="DrawerBorder"
                Background="{DynamicResource DrawerBackground}"
                BorderBrush="{DynamicResource DrawerBorderDefault}"
                BorderThickness="1,0,0,0"
            CornerRadius="24,0,0,24">
            <Border Padding="0,0,16,0">
                <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header Premium -->
                <Border Grid.Row="0"
                        Background="{DynamicResource DrawerHeaderBackground}"
                        BorderBrush="{DynamicResource DrawerBorderSubtle}"
                        BorderThickness="0,0,0,1"
                    CornerRadius="24,0,0,0"
                        Padding="24,20">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Ícone de sino com badge -->
                        <Grid Grid.Column="0" Width="40" Height="40" Margin="0,0,12,0">
                            <Ellipse Fill="{DynamicResource DrawerBgGlowBlue}" Opacity="0.3"/>
                            <Path Data="{DynamicResource IconBell}"
                                  Fill="{DynamicResource DrawerPrimaryBrush}"
                                  Width="20" Height="20"
                                  Stretch="Uniform"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"/>
                            <Border Background="{DynamicResource DrawerErrorBrush}"
                                CornerRadius="8"
                                    MinWidth="16" Height="16"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Top"
                                    Margin="0,-2,-2,0"
                                    Visibility="{Binding HasUnread, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{Binding UnreadCount}"
                                           Foreground="White"
                                           FontSize="9"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Margin="3,0"/>
                            </Border>
                        </Grid>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding [DrawerTitle], Source={x:Static services:LocalizationService.Instance}}"
                                       FontFamily="Segoe UI Variable Display, Segoe UI"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource DrawerTextPrimary}"/>
                            <TextBlock Text="{Binding Subtitle}"
                                       FontFamily="Segoe UI Variable Text, Segoe UI"
                                       FontSize="12"
                                       Foreground="{DynamicResource DrawerTextTertiary}"
                                       Margin="0,2,0,0"/>
                        </StackPanel>

                        <Button Grid.Column="2"
                                Width="32" Height="32"
                                Background="Transparent"
                                BorderThickness="0"
                            Cursor="Hand"
                            Command="{Binding CloseCommand}">
                            <Path Data="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"
                                  Fill="{DynamicResource DrawerTextSecondary}"
                                  Width="14" Height="14"
                                  Stretch="Uniform"/>
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}"
                                        CornerRadius="16"
                                            Padding="4">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource DrawerBorderHover}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>
                </Border>

                <!-- Toolbar -->
                <Border Grid.Row="1"
                        BorderBrush="{DynamicResource DrawerBorderSubtle}"
                        BorderThickness="0,0,0,1"
                        Padding="16,10">
                    <Grid>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                            <Button Content="{Binding [DrawerMarkAllRead], Source={x:Static services:LocalizationService.Instance}}"
                                    Style="{DynamicResource GhostLinkButton}"
                                    FontSize="12"
                                Command="{Binding MarkAllAsReadCommand}"
                                    Visibility="{Binding HasUnread, Converter={StaticResource BoolToVis}}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="{Binding [DrawerClearAll], Source={x:Static services:LocalizationService.Instance}}"
                                    Style="{DynamicResource GhostLinkButton}"
                                    FontSize="12"
                                Command="{Binding ClearAllCommand}"
                                    Visibility="{Binding HasNotifications, Converter={StaticResource BoolToVis}}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Lista de Notificações -->
                <ListBox Grid.Row="2"
                         ItemsSource="{Binding Notifications}"
                         BorderThickness="0"
                         Background="Transparent"
                         Padding="0"
                         Margin="0,8"
                         VirtualizingStackPanel.IsVirtualizing="True"
                         VirtualizingStackPanel.VirtualizationMode="Recycling">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="IsHitTestVisible" Value="True"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                             <Border Style="{DynamicResource NotificationItemStyle}"
                                 Cursor="Hand"
                                     MouseLeftButtonDown="NotificationItem_Click">
                                 <Grid>
                                     <Grid.ColumnDefinitions>
                                         <ColumnDefinition Width="Auto"/> <!-- Col 0: Accent Bar -->
                                         <ColumnDefinition Width="Auto"/> <!-- Col 1: Status Icon -->
                                         <ColumnDefinition Width="*"/>    <!-- Col 2: Content -->
                                         <ColumnDefinition Width="Auto"/> <!-- Col 3: Metadata -->
                                     </Grid.ColumnDefinitions>

                                     <!-- Accent Bar lateral com glow sutil matching -->
                                     <Border Grid.Column="0" Width="4" Height="32" CornerRadius="2" 
                                             Background="{Binding StatusColor}" VerticalAlignment="Center" Margin="-6,0,12,0">
                                         <Border.Effect>
                                             <DropShadowEffect Color="{Binding StatusColor.Color}" BlurRadius="8" ShadowDepth="0" Opacity="0.5"/>
                                         </Border.Effect>
                                     </Border>

                                     <!-- Status Icon Capsula Dupla com Neon Ring -->
                                     <Grid Grid.Column="1" Width="38" Height="38" Margin="0,0,14,0" VerticalAlignment="Center">
                                         <Ellipse Fill="{Binding StatusColor}" Opacity="0.12">
                                             <Ellipse.Effect>
                                                 <BlurEffect Radius="8"/>
                                             </Ellipse.Effect>
                                         </Ellipse>
                                         <Ellipse Stroke="{Binding StatusColor}" StrokeThickness="1.2" Opacity="0.45"/>
                                         <Ellipse Fill="{Binding StatusBackground}" Opacity="0.2"/>
                                         <Path Data="{Binding IconGeometry}"
                                               Fill="{Binding StatusColor}"
                                               Width="16" Height="16"
                                               Stretch="Uniform"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center">
                                             <Path.Style>
                                                 <Style TargetType="Path">
                                                     <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
                                                     <Setter Property="RenderTransform">
                                                         <Setter.Value>
                                                             <RotateTransform Angle="0"/>
                                                         </Setter.Value>
                                                     </Setter>
                                                     <Style.Triggers>
                                                         <DataTrigger Binding="{Binding SourceMessage.Type}" Value="Processing">
                                                             <DataTrigger.EnterActions>
                                                                 <BeginStoryboard>
                                                                     <Storyboard>
                                                                         <DoubleAnimation Storyboard.TargetProperty="(Path.RenderTransform).(RotateTransform.Angle)"
                                                                                          From="0" To="360" Duration="0:0:1.8" RepeatBehavior="Forever"/>
                                                                     </Storyboard>
                                                                 </BeginStoryboard>
                                                             </DataTrigger.EnterActions>
                                                         </DataTrigger>
                                                     </Style.Triggers>
                                                 </Style>
                                             </Path.Style>
                                         </Path>
                                     </Grid>

                                     <!-- Content Stack -->
                                     <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                         <TextBlock Text="{Binding Title}"
                                                    FontFamily="Segoe UI Variable Display, Segoe UI"
                                                    FontWeight="Bold"
                                                    FontSize="13.5"
                                                    Foreground="{DynamicResource DrawerTextPrimary}"
                                                    TextTrimming="CharacterEllipsis"
                                                    ToolTip="{Binding Title}"
                                                    Margin="0,0,0,3"/>
                                         <TextBlock Text="{Binding Message}"
                                                    FontFamily="Segoe UI Variable Text, Segoe UI"
                                                    FontSize="12"
                                                    Foreground="{DynamicResource DrawerTextSecondary}"
                                                    TextWrapping="Wrap"
                                                    LineHeight="17"/>
                                     </StackPanel>

                                     <!-- Metadata Stack (Time + Unread Dot) -->
                                     <StackPanel Grid.Column="3" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="12,0,0,0">
                                         <TextBlock Text="{Binding TimeGroup}"
                                                    FontFamily="Segoe UI Variable Text, Segoe UI"
                                                    FontSize="10.5"
                                                    FontWeight="SemiBold"
                                                    Foreground="{DynamicResource DrawerTextTertiary}"
                                                    HorizontalAlignment="Right"
                                                    Margin="0,0,0,6"/>
                                         <!-- Glowing Unread Indicator -->
                                         <Ellipse Width="8" Height="8"
                                                  Fill="{DynamicResource DrawerPrimaryBrush}"
                                                  HorizontalAlignment="Right">
                                             <Ellipse.Effect>
                                                 <DropShadowEffect Color="#FF31A8FF" BlurRadius="6" ShadowDepth="0" Opacity="0.8"/>
                                             </Ellipse.Effect>
                                             <Ellipse.Style>
                                                 <Style TargetType="Ellipse">
                                                     <Setter Property="Visibility" Value="Collapsed"/>
                                                     <Style.Triggers>
                                                         <DataTrigger Binding="{Binding IsRead}" Value="False">
                                                             <Setter Property="Visibility" Value="Visible"/>
                                                         </DataTrigger>
                                                     </Style.Triggers>
                                                 </Style>
                                             </Ellipse.Style>
                                         </Ellipse>
                                     </StackPanel>
                                 </Grid>
                              </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>

                    <ListBox.Style>
                        <Style TargetType="ListBox">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBox">
                                        <Border Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}">
                                            <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                                                          VerticalScrollBarVisibility="Auto"
                                                      CanContentScroll="True">
                                                <ItemsPresenter/>
                                            </ScrollViewer>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasNotifications}" Value="False">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate>
                                                <Grid Margin="0,60">
                                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <Path Data="{DynamicResource IconBell}"
                                                              Fill="{DynamicResource DrawerTextMuted}"
                                                              Width="48" Height="48"
                                                              Stretch="Uniform"
                                                              HorizontalAlignment="Center"
                                                              Opacity="0.3"/>
                                                        <TextBlock Text="{Binding [DrawerNoNotifications], Source={x:Static services:LocalizationService.Instance}}"
                                                                   FontFamily="Segoe UI Variable Display, Segoe UI"
                                                                   FontSize="16"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource DrawerTextTertiary}"
                                                                   HorizontalAlignment="Center"
                                                                   Margin="0,16,0,4"/>
                                                        <TextBlock Text="{Binding [DrawerNoNotificationsDesc], Source={x:Static services:LocalizationService.Instance}}"
                                                                   FontFamily="Segoe UI Variable Text, Segoe UI"
                                                                   FontSize="13"
                                                                   Foreground="{DynamicResource DrawerTextMuted}"
                                                                   HorizontalAlignment="Center"
                                                                   TextWrapping="Wrap"
                                                                   TextAlignment="Center"
                                                                   MaxWidth="280"/>
                                                    </StackPanel>
                                                </Grid>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ListBox.Style>
                </ListBox>

                <!-- Footer -->
                <Border Grid.Row="3"
                        BorderBrush="{DynamicResource DrawerBorderSubtle}"
                        BorderThickness="0,1,0,0"
                        Padding="16,12"
                    CornerRadius="0,0,0,24">
                    <TextBlock Text="{Binding [Loc_VoltrisOptimizer], Source={x:Static services:LocalizationService.Instance}}"
                               FontFamily="Segoe UI Variable Text, Segoe UI"
                               FontSize="11"
                               Foreground="{DynamicResource DrawerTextMuted}"
                               HorizontalAlignment="Center"/>
                </Border>
            </Grid>
            </Border>
        </Border>
    </Grid>
</UserControl>