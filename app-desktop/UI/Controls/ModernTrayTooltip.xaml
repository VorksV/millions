  <Window xmlns:services="clr-namespace:VoltrisOptimizer.Services" x:Class="VoltrisOptimizer.UI.Controls.ModernTrayTooltip"
          xmlns:controls="clr-namespace:VoltrisOptimizer.UI.Controls"
          xmlns:license="clr-namespace:VoltrisOptimizer.Services.License"
          xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding [TrayTooltipTitle], Source={x:Static services:LocalizationService.Instance}}"
        Width="300"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="False"
        ResizeMode="NoResize"
        Focusable="False">

    <Window.Resources>
        <RadialGradientBrush x:Key="ModernTooltipPinkGlow" Center="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
            <GradientStop Color="#FF4B6B" Offset="0"/>
            <GradientStop Color="Transparent" Offset="1"/>
        </RadialGradientBrush>
        <RadialGradientBrush x:Key="ModernTooltipPurpleGlow" Center="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
            <GradientStop Color="#8B31FF" Offset="0"/>
            <GradientStop Color="Transparent" Offset="1"/>
        </RadialGradientBrush>
        <RadialGradientBrush x:Key="ModernTooltipBlueGlow" Center="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
            <GradientStop Color="#31A8FF" Offset="0"/>
            <GradientStop Color="Transparent" Offset="1"/>
        </RadialGradientBrush>

        <Storyboard x:Key="FadeInStoryboard">
            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.25">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" From="0.95" To="1" Duration="0:0:0.25">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" From="0.95" To="1" Duration="0:0:0.25">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
        <Storyboard x:Key="FadeOutStoryboard">
            <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseIn"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="0.95" Duration="0:0:0.2">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseIn"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="0.95" Duration="0:0:0.2">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseIn"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
    </Window.Resources>

    <Window.RenderTransform>
        <ScaleTransform CenterX="150" CenterY="80"/>
    </Window.RenderTransform>

    <Border x:Name="RootBorder"
            CornerRadius="8"
            Padding="0"
            Background="{DynamicResource WindowBackgroundBrush}"
            ClipToBounds="True">
        <Border.BorderBrush>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#3A2060" Offset="0"/>
                <GradientStop Color="#1A2A50" Offset="1"/>
            </LinearGradientBrush>
        </Border.BorderBrush>
        <Border.BorderThickness>1</Border.BorderThickness>
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="4" Opacity="0.65" Color="Black"/>
        </Border.Effect>

        <Grid>
            <Canvas IsHitTestVisible="False" ClipToBounds="True">
                <Ellipse Width="280" Height="240" Canvas.Left="-90" Canvas.Top="-100" Fill="{StaticResource ModernTooltipPinkGlow}" Opacity="0.26"/>
                <Ellipse Width="250" Height="220" Canvas.Right="-80" Canvas.Bottom="-90" Fill="{StaticResource ModernTooltipPurpleGlow}" Opacity="0.22"/>
                <Ellipse Width="190" Height="170" Canvas.Left="55" Canvas.Top="-20" Fill="{StaticResource ModernTooltipBlueGlow}" Opacity="0.16"/>
            </Canvas>
            <StackPanel Margin="18,16">
            <!-- Header: Ícone + Nome + Versão -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                <!-- Logo Voltris (imagem PNG) sem bordas -->
                <Image Width="36" Height="36" Margin="0,0,12,0"
                       VerticalAlignment="Center"
                       Source="pack://application:,,,/Images/voltris.png"
                       Stretch="Uniform"
                       RenderOptions.BitmapScalingMode="HighQuality"
                       SnapsToDevicePixels="True"
                       UseLayoutRounding="True"/>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding [Loc_VoltrisOptimizer], Source={x:Static services:LocalizationService.Instance}}" FontSize="13.5" FontWeight="Bold"
                               FontFamily="Segoe UI Variable Display, Segoe UI">
                        <TextBlock.Foreground>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#FF4B6B" Offset="0"/>
                                <GradientStop Color="#8B31FF" Offset="0.5"/>
                                <GradientStop Color="#31A8FF" Offset="1"/>
                            </LinearGradientBrush>
                        </TextBlock.Foreground>
                    </TextBlock>
                    <TextBlock x:Name="VersionText" Text="{Binding [Loc_V100], Source={x:Static services:LocalizationService.Instance}}" FontSize="10"
                               Foreground="#5A6070" Margin="0,2,0,0"
                               FontFamily="Segoe UI Variable Text, Segoe UI"/>
                </StackPanel>
            </StackPanel>

            <!-- Separador gradiente -->
            <Border Height="1" Margin="0,0,0,12" Opacity="0.35">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#FF4B6B" Offset="0"/>
                        <GradientStop Color="#8B31FF" Offset="0.5"/>
                        <GradientStop Color="#31A8FF" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
            </Border>



            <!-- Widget Flutuante -->
            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <!-- Ícone Widget (cor #3B82F6 - Blue) -->
                <Border Grid.Column="0" Width="26" Height="26" CornerRadius="7"
                        Background="#1A3B82F6" Margin="0,0,10,0" VerticalAlignment="Center">
                    <Path Data="M3,3H21V21H3V3M5,5V19H19V5H5M11,7H17V11H11V7M7,7H9V17H7V7M11,13H17V17H11V13Z"
                          Stretch="Uniform" Width="14" Height="14"
                          HorizontalAlignment="Center" VerticalAlignment="Center"
                          Fill="#3B82F6"/>
                </Border>
                <TextBlock Grid.Column="1" Text="{Binding [TrayWidget], Source={x:Static services:LocalizationService.Instance}}" FontSize="12"
                            Foreground="#9CA3AF" VerticalAlignment="Center"
                            FontFamily="Segoe UI Variable Text, Segoe UI"/>
                <!-- Badge status clicável -->
                <Border Grid.Column="2" x:Name="WidgetBadge" CornerRadius="8" Padding="9,3"
                        VerticalAlignment="Center" Cursor="Hand"
                        MouseLeftButtonDown="WidgetBadge_MouseLeftButtonDown">
                    <Border.Background>
                        <SolidColorBrush x:Name="WidgetBadgeBg" Color="#1A3B82F6"/>
                    </Border.Background>
                    <TextBlock x:Name="WidgetStatusText" Text="{Binding [TrayWidgetBadgeOff], Source={x:Static services:LocalizationService.Instance}}" FontSize="10.5"
                               FontWeight="SemiBold" VerticalAlignment="Center"
                               FontFamily="Segoe UI Variable Text, Segoe UI">
                        <TextBlock.Foreground>
                            <SolidColorBrush x:Name="WidgetStatusFg" Color="#64748B"/>
                        </TextBlock.Foreground>
                    </TextBlock>
                </Border>
            </Grid>

            <!-- Perfil Inteligente -->
            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <!-- Ícone Perfil Inteligente (cor #8B31FF = Purple) -->
                <Border Grid.Column="0" Width="26" Height="26" CornerRadius="7"
                        Background="#1A8B31FF" Margin="0,0,10,0" VerticalAlignment="Center">
                    <Path Data="M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2M12,4A8,8 0 0,1 20,12A8,8 0 0,1 12,20A8,8 0 0,1 4,12A8,8 0 0,1 12,4M13,14H11V10H13M13,18H11V16H13M19,13H5V11H19M19,15H5V17H19M21,12V14H23V12"
                          Stretch="Uniform" Width="14" Height="14"
                          HorizontalAlignment="Center" VerticalAlignment="Center"
                          Fill="#8B31FF"/>
                </Border>
                <TextBlock Grid.Column="1" Text="{Binding [TrayProfile], Source={x:Static services:LocalizationService.Instance}}" FontSize="12"
                            Foreground="#9CA3AF" VerticalAlignment="Center"
                            FontFamily="Segoe UI Variable Text, Segoe UI"/>
                <!-- Perfil + badge PRO: mesmo controle e mesmo binding do
                     "Reparo Inteligente" do Dashboard. Aparece SO sem licenca
                     e some com ela, porque IsProActive notifica. -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="ProfileText" Text="-" FontSize="11.5"
                               FontWeight="SemiBold" Foreground="#E5E7EB" VerticalAlignment="Center"
                               FontFamily="Segoe UI Variable Text, Segoe UI"/>
                    <controls:ProBadge Margin="7,0,0,0"
                                       Tip="{Binding [ProBadgeTip], Source={x:Static services:LocalizationService.Instance}}"
                                       Visibility="{Binding Source={x:Static license:LicenseTokenStore.IsProActive}, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>
                </StackPanel>
            </Grid>

            <!-- Plano de Energia -->
            <Grid Margin="0,0,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <!-- Ícone Plano de Energia (cor #F59E0B = Orange) -->
                <Border Grid.Column="0" Width="26" Height="26" CornerRadius="7"
                        Background="#1AF59E0B" Margin="0,0,10,0" VerticalAlignment="Center">
                    <Path Data="M7,2V13H10V22L17,10H13L17,2H7Z"
                          Stretch="Uniform" Width="13" Height="13"
                          HorizontalAlignment="Center" VerticalAlignment="Center"
                          Fill="#F59E0B"/>
                </Border>
                <TextBlock Grid.Column="1" Text="{Binding [TrayPower], Source={x:Static services:LocalizationService.Instance}}" FontSize="12"
                            Foreground="#9CA3AF" VerticalAlignment="Center"
                            FontFamily="Segoe UI Variable Text, Segoe UI"/>
                <TextBlock Grid.Column="2" x:Name="PowerPlanText" Text="—" FontSize="11.5"
                           FontWeight="SemiBold" Foreground="#E5E7EB" VerticalAlignment="Center"
                           MaxWidth="120" TextTrimming="CharacterEllipsis"
                           FontFamily="Segoe UI Variable Text, Segoe UI"/>
            </Grid>
        </StackPanel>
        </Grid>
    </Border>
</Window>
