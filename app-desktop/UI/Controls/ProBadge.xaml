<UserControl x:Class="VoltrisOptimizer.UI.Controls.ProBadge"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="Auto" Height="Auto">
    <Border x:Name="BadgeBorder"
            CornerRadius="9"
            Padding="7,2"
            VerticalAlignment="Center">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#FFD76A" Offset="0"/>
                <GradientStop Color="#F7A325" Offset="1"/>
            </LinearGradientBrush>
        </Border.Background>
        <Border.Effect>
            <DropShadowEffect BlurRadius="8" ShadowDepth="0" Color="#F7A325" Opacity="0.5"/>
        </Border.Effect>
        <TextBlock x:Name="BadgeText"
                   Text="PRO"
                   FontSize="9"
                   FontWeight="Black"
                   Foreground="#1A1200"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"/>
    </Border>
</UserControl>
