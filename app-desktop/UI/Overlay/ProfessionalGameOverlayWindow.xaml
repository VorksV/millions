<Window xmlns:services="clr-namespace:VoltrisOptimizer.Services" x:Class="VoltrisOptimizer.UI.Overlay.ProfessionalGameOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        Opacity="0.95"
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize">

    <Window.Resources>
        <!-- Brand Colors – VOLTRIS Performance Purple -->
        <Color x:Key="VoltrisAccent">#8B31FF</Color>
        <Color x:Key="VoltrisAccentGlow">#B86AFE</Color>
        <Color x:Key="VoltrisGreen">#00E676</Color>
        <Color x:Key="VoltrisYellow">#FFD740</Color>
        <Color x:Key="VoltrisRed">#FF5252</Color>
        <Color x:Key="VoltrisOrange">#FF9100</Color>
        <Color x:Key="VoltrisCyan">#00E5FF</Color>

        <SolidColorBrush x:Key="VoltrisCyanBrush" Color="{StaticResource VoltrisCyan}" />
        <SolidColorBrush x:Key="VoltrisOrangeBrush" Color="{StaticResource VoltrisOrange}" />
        <SolidColorBrush x:Key="VoltrisYellowBrush" Color="{StaticResource VoltrisYellow}" />

        <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource VoltrisAccent}" />
        <SolidColorBrush x:Key="AccentGlowBrush" Color="{StaticResource VoltrisAccentGlow}" />
        <SolidColorBrush x:Key="FpsGoodBrush" Color="{StaticResource VoltrisGreen}" />
        <SolidColorBrush x:Key="FpsWarnBrush" Color="{StaticResource VoltrisYellow}" />
        <SolidColorBrush x:Key="FpsBadBrush" Color="{StaticResource VoltrisRed}" />
        <SolidColorBrush x:Key="CpuBrush" Color="{StaticResource VoltrisCyan}" />
        <SolidColorBrush x:Key="GpuBrush" Color="{StaticResource VoltrisGreen}" />
        <SolidColorBrush x:Key="TempWarnBrush" Color="{StaticResource VoltrisOrange}" />
        <SolidColorBrush x:Key="TempCritBrush" Color="{StaticResource VoltrisRed}" />
        <SolidColorBrush x:Key="StableBrush" Color="{StaticResource VoltrisGreen}" />
        <SolidColorBrush x:Key="UnstableBrush" Color="{StaticResource VoltrisYellow}" />
        <SolidColorBrush x:Key="CriticalBrush" Color="{StaticResource VoltrisRed}" />

        <!-- Background Layers -->
        <SolidColorBrush x:Key="BgRootBrush" Color="#CC0D0D1A" />
        <SolidColorBrush x:Key="BgBorderBrush" Color="#1AFFFFFF" />
        <SolidColorBrush x:Key="BgMetricBar" Color="#15FFFFFF" />

        <!-- Shared Styles -->
        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI Variable, Segoe UI" />
            <Setter Property="FontSize" Value="8" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#809098" />
            <Setter Property="Margin" Value="0" />
        </Style>

        <Style x:Key="ValueStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI Variable, Segoe UI" />
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="#E0E0E0" />
            <Setter Property="Margin" Value="0" />
        </Style>

        <Style x:Key="MiniValueStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI Variable, Segoe UI" />
            <Setter Property="FontSize" Value="9" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#B0B8C0" />
        </Style>

        <!-- Mini Progress Bar Template -->
        <Style x:Key="MiniBarStyle" TargetType="Border">
            <Setter Property="Height" Value="2" />
            <Setter Property="CornerRadius" Value="1" />
            <Setter Property="Background" Value="{StaticResource BgMetricBar}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <!-- Main Container – Glass-dark panel -->
    <Border CornerRadius="6"
            Background="{StaticResource BgRootBrush}"
            BorderBrush="{StaticResource BgBorderBrush}"
            BorderThickness="1">

        <Border.Effect>
            <DropShadowEffect Color="#8B31FF" BlurRadius="8" ShadowDepth="0" Opacity="0.15" />
        </Border.Effect>

        <StackPanel Margin="8,6,8,6" VerticalAlignment="Top">

            <!-- ═══════ BLOCK 1: CORE PERFORMANCE ═══════ -->
            <Grid Name="FpsPanel" Margin="0,0,0,3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="6" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- FPS – large dominant number -->
                <Grid Grid.Column="0" VerticalAlignment="Center">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Name="FpsText"
                               Grid.Row="0"
                               FontFamily="Segoe UI Variable, Segoe UI"
                               FontSize="28"
                               FontWeight="ExtraLight"
                               Foreground="{StaticResource FpsGoodBrush}"
                               VerticalAlignment="Center" />
                    <TextBlock Name="EtwBadge"
                               Grid.Row="1"
                               Style="{StaticResource LabelStyle}"
                               Text="ETW"
                               Foreground="{StaticResource VoltrisCyanBrush}"
                               Margin="2,0,0,0"
                               Visibility="Collapsed" />
                </Grid>

                <!-- Stutter / Stability Indicator -->
                <Grid Grid.Column="2" VerticalAlignment="Center">
                    <Ellipse Name="StutterDot"
                             Width="6" Height="6"
                             Fill="{StaticResource StableBrush}"
                             HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Ellipse.Effect>
                            <DropShadowEffect BlurRadius="4" ShadowDepth="0" Color="#00E676" Opacity="0.6" />
                        </Ellipse.Effect>
                    </Ellipse>
                    <TextBlock Name="StutterLabel"
                               FontSize="6"
                               Foreground="#608090"
                               Text="{Binding [OK], Source={x:Static services:LocalizationService.Instance}}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Visibility="Collapsed" />
                </Grid>

                <!-- Frame Time + FPS average (compact) -->
                <StackPanel Grid.Column="3" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <TextBlock Name="FrameTimeText"
                               Style="{StaticResource MiniValueStyle}"
                               TextAlignment="Right"
                               Foreground="{StaticResource VoltrisCyanBrush}" />
                    <TextBlock Name="AvgFpsText"
                               Style="{StaticResource LabelStyle}"
                               TextAlignment="Right" />
                </StackPanel>
            </Grid>

            <!-- ═══════ BLOCK 2: CPU / GPU ═══════ -->
            <Grid Name="HardwareGrid" Margin="0,2,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- CPU Column -->
                <StackPanel Name="CpuPanel" Grid.Column="0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="{Binding [CPU], Source={x:Static services:LocalizationService.Instance}}"
                                   Style="{StaticResource LabelStyle}"
                                   Foreground="{StaticResource CpuBrush}" />

                        <Border Name="CpuBar"
                                Grid.Column="1"
                                Style="{StaticResource MiniBarStyle}"
                                Margin="4,0,4,0">
                            <Border Name="CpuBarFill"
                                    HorizontalAlignment="Left"
                                    Width="0"
                                    Background="{StaticResource CpuBrush}"
                                    CornerRadius="1" />
                        </Border>

                        <TextBlock Name="CpuUsageText"
                                   Grid.Column="2"
                                   Style="{StaticResource MiniValueStyle}" />
                    </Grid>

                    <Grid Margin="0,1,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Name="CpuTempText"
                                   Grid.Column="0"
                                   Style="{StaticResource MiniValueStyle}"
                                   FontSize="8"
                                   Foreground="{StaticResource TempWarnBrush}" />
                        <TextBlock Grid.Column="1"
                                   Style="{StaticResource LabelStyle}"
                                   Text=" · "
                                   Margin="1,0" />
                        <TextBlock Name="CpuClockText"
                                   Grid.Column="2"
                                   Style="{StaticResource MiniValueStyle}"
                                   FontSize="8"
                                   Foreground="{StaticResource VoltrisCyanBrush}" />
                        <TextBlock Name="CpuClockSep"
                                   Grid.Column="3"
                                   Style="{StaticResource LabelStyle}"
                                   Text=" / "
                                   Margin="0,0,0,0"
                                   Visibility="Collapsed" />
                        <TextBlock Name="CpuMaxClockText"
                                   Grid.Column="4"
                                   Style="{StaticResource MiniValueStyle}"
                                   FontSize="8"
                                   Foreground="{StaticResource VoltrisCyanBrush}"
                                   Opacity="0.6"
                                   Visibility="Collapsed" />
                    </Grid>
                </StackPanel>

                <!-- GPU Column -->
                <StackPanel Name="GpuPanel" Grid.Column="2">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="{Binding [GPU], Source={x:Static services:LocalizationService.Instance}}"
                                   Style="{StaticResource LabelStyle}"
                                   Foreground="{StaticResource GpuBrush}" />

                        <Border Name="GpuBar"
                                Grid.Column="1"
                                Style="{StaticResource MiniBarStyle}"
                                Margin="4,0,4,0">
                            <Border Name="GpuBarFill"
                                    HorizontalAlignment="Left"
                                    Width="0"
                                    Background="{StaticResource GpuBrush}"
                                    CornerRadius="1" />
                        </Border>

                        <TextBlock Name="GpuUsageText"
                                   Grid.Column="2"
                                   Style="{StaticResource MiniValueStyle}" />
                    </Grid>

                    <Grid Margin="0,1,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Name="GpuTempText"
                                   Grid.Column="0"
                                   Style="{StaticResource MiniValueStyle}"
                                   FontSize="8"
                                   Foreground="{StaticResource TempWarnBrush}" />
                        <TextBlock Grid.Column="1"
                                   Style="{StaticResource LabelStyle}"
                                   Text=" · "
                                   Margin="1,0" />
                        <TextBlock Name="GpuClockText"
                                   Grid.Column="2"
                                   Style="{StaticResource MiniValueStyle}"
                                   FontSize="10"
                                   Foreground="{StaticResource GpuBrush}" />
                    </Grid>
                </StackPanel>
            </Grid>

            <!-- ═══════ BLOCK 3: MEMORY ═══════ -->
            <Grid Name="MemoryGrid" Margin="0,4,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- RAM -->
                <StackPanel Name="RamPanel" Grid.Column="0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="{Binding [RAM], Source={x:Static services:LocalizationService.Instance}}"
                                   Style="{StaticResource LabelStyle}" />

                        <Border Name="RamBar"
                                Grid.Column="1"
                                Style="{StaticResource MiniBarStyle}"
                                Margin="4,0,4,0">
                            <Border Name="RamBarFill"
                                    HorizontalAlignment="Left"
                                    Width="0"
                                    Background="{StaticResource VoltrisYellowBrush}"
                                    CornerRadius="1" />
                        </Border>

                        <TextBlock Name="RamUsageText"
                                   Grid.Column="2"
                                   Style="{StaticResource MiniValueStyle}" />
                    </Grid>
                </StackPanel>

                <!-- VRAM -->
                <StackPanel Name="VramPanel" Grid.Column="2">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="{Binding [VRAM], Source={x:Static services:LocalizationService.Instance}}"
                                   Style="{StaticResource LabelStyle}" />

                        <Border Name="VramBar"
                                Grid.Column="1"
                                Style="{StaticResource MiniBarStyle}"
                                Margin="4,0,4,0">
                            <Border Name="VramBarFill"
                                    HorizontalAlignment="Left"
                                    Width="0"
                                    Background="{StaticResource AccentGlowBrush}"
                                    CornerRadius="1" />
                        </Border>

                        <TextBlock Name="VramUsageText"
                                   Grid.Column="2"
                                   Style="{StaticResource MiniValueStyle}" />
                    </Grid>
                </StackPanel>
            </Grid>

            <!-- ═══════ BLOCK 4: STATUS + LATENCY (optional footer) ═══════ -->
            <Grid Name="StatusPanel" Margin="0,4,0,0" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock Name="InputLatencyText"
                           Grid.Column="0"
                           Style="{StaticResource MiniValueStyle}"
                           FontSize="8"
                           Foreground="{StaticResource VoltrisOrangeBrush}" />
                <TextBlock Grid.Column="1"
                           Style="{StaticResource LabelStyle}"
                           Text=" · "
                           Margin="2,0" />
                <TextBlock Name="CaptureInfoText"
                           Grid.Column="2"
                           Style="{StaticResource LabelStyle}"
                           FontSize="7" />
            </Grid>
        </StackPanel>
    </Border>
</Window>
