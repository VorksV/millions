        /// <summary>
        /// CARREGA EFEITOS DECORATIVOS EM BACKGROUND APÓS RENDERIZAÇÃO INICIAL
        /// Isso evita congelamento da UI thread durante o InitializeComponent()
        /// </summary>
        private async Task LoadDecorativeEffectsAsync()
        {
            await Task.Yield(); // Volta para o dispatcher após o Loaded
            
            try
            {
                // Aguardar 500ms para garantir que a janela já está renderizada
                await Task.Delay(500);
                
                Dispatcher.BeginInvoke(() =>
                {
                    // Mostrar efeitos decorativos gradualmente
                    if (DecorativeBlurBorder != null)
                    {
                        DecorativeBlurBorder.Visibility = Visibility.Visible;
                        LogToFile("[MAINWINDOW] Efeitos decorativos carregados em background");
                    }
                }, System.Windows.Threading.DispatcherPriority.Background);
            }
            catch (Exception ex)
            {
                App.LoggingService?.LogWarning($"[MainWindow] Erro ao carregar efeitos decorativos: {ex.Message}");
            }
        }
        
        // ============================================
        // OTIMIZAÇÕES DE PERFORMANCE
        // ============================================
        
        // Debounce para eventos de resize/mouse (evita chamadas excessivas)
        private readonly System.Collections.Concurrent.ConcurrentDictionary<string, DateTime> _lastEventTime = new();
        private const int DEBOUNCE_MS = 50; // 50ms entre eventos
        
        /// <summary>
        /// Verifica se evento deve ser processado (debounce)
        /// </summary>
        private bool ShouldProcessEvent(string eventName)
        {
            var now = DateTime.Now;
            var lastTime = _lastEventTime.GetOrAdd(eventName, now);
            
            if ((now - lastTime).TotalMilliseconds < DEBOUNCE_MS)
                return false;
                
            _lastEventTime[eventName] = now;
            return true;
        }
        
        // Cache de brushes para evitar criação repetida
        private static readonly System.Collections.Concurrent.ConcurrentDictionary<string, System.Windows.Media.Brush> _brushCache = new();
        
        /// <summary>
        /// Obtém brush do cache ou cria nova
        /// </summary>
        private System.Windows.Media.Brush GetCachedBrush(string key, Func<System.Windows.Media.Brush> factory)
        {
            return _brushCache.GetOrAdd(key, _ => factory());
        }
        
    }
}





