                (IntelligentProfileType.GamerStrategy, "M21,6H3C1.9,6,1,6.9,1,8v8c0,1.1,0.9,2,2,2h18c1.1,0,2-0.9,2-2V8C23,6.9,22.1,6,21,6z M6,15c-1.1,0-2-0.9-2-2s0.9-2,2-2s2,0.9,2,2S7.1,15,6,15z M13,10h-2v2h-2v-2H7V8h2V6h2v2h2V10z M18,15c-1.1,0-2-0.9-2-2s0.9-2,2-2s2,0.9,2,2S19.1,15,18,15z", LocalizationService.Instance.GetString("ProfileGamerStrategy")),
                (IntelligentProfileType.WorkOffice, "M14,6V4H10V6H14M14,19H10V14H14V19M20,6H16V4C16,2.89 15.1,2 14,2H10C8.89,2 8,2.89 8,4V6H4C2.89,6 2,6.89 2,8V19C2,20.11 2.89,21 4,21H20C21.11,21 22,20.11 22,19V8C22,6.89 21.11,6 20,6Z", LocalizationService.Instance.GetString("TrayProfileWorkOffice")),
                (IntelligentProfileType.CreativeVideoEditing, "M17.5,12A1.5,1.5 0 0,1 16,10.5A1.5,1.5 0 0,1 17.5,9A1.5,1.5 0 0,1 19,10.5A1.5,1.5 0 0,1 17.5,12M14.5,8A1.5,1.5 0 0,1 13,6.5A1.5,1.5 0 0,1 14.5,5A1.5,1.5 0 0,1 16,6.5A1.5,1.5 0 0,1 14.5,8M9.5,8A1.5,1.5 0 0,1 8,6.5A1.5,1.5 0 0,1 9.5,5A1.5,1.5 0 0,1 11,6.5A1.5,1.5 0 0,1 9.5,8M6.5,12A1.5,1.5 0 0,1 5,10.5A1.5,1.5 0 0,1 6.5,9A1.5,1.5 0 0,1 8,10.5A1.5,1.5 0 0,1 6.5,12M12,3A9,9 0 0,0 3,12A9,9 0 0,0 12,21A1.5,1.5 0 0,0 13.5,19.5C13.5,19.11 13.35,18.76 13.11,18.5C12.88,18.23 12.73,17.88 12.73,17.5A0.77,0.77 0 0,1 13.5,16.73H15.27C18.91,16.73 21.86,13.78 21.86,10.14C21.86,6.2 17.43,3 12,3Z", LocalizationService.Instance.GetString("TrayProfileVideoDesign")),
                (IntelligentProfileType.DeveloperProgramming, "M14.6,16.6L19.2,12L14.6,7.4L16,6L22,12L16,18L14.6,16.6M9.4,16.6L4.8,12L9.4,7.4L8,6L2,12L8,18L9.4,16.6", LocalizationService.Instance.GetString("TrayProfileDevProgramming")),
                (IntelligentProfileType.EnterpriseSecure, "M12,1L3,5V11C3,16.55 6.84,21.74 12,23C17.16,21.74 21,16.55 21,11V5L12,1M12,5A3,3 0 0,1 15,8A3,3 0 0,1 12,11A3,3 0 0,1 9,8A3,3 0 0,1 12,5M17.13,17C15.92,18.85 14.11,20.24 12,20.92C9.89,20.24 8.08,18.85 6.87,17C6.53,16.5 6.24,16 6,15.47C6,13.82 8.71,12.47 12,12.47C15.29,12.47 18,13.79 18,15.47C17.76,16 17.47,16.5 17.13,17Z", LocalizationService.Instance.GetString("TrayProfileEnterpriseSecure")),
                (IntelligentProfileType.GeneralBalanced, "M9,2V8H11V11H13V8H15V2H13V5H11V2M2,9V15H5V13H8V11H5V9M16,9V11H19V13H22V9H19V11H16V9M11,13V19H13V16H15V22H17V13H15V14H13V13M5,16V22H7V19H9V16H7V18H5V16", LocalizationService.Instance.GetString("TrayProfileGeneralBalanced"))
            };
            foreach (var (profileType, profileIcon, profileLabel) in profileEntries) {
    string iconColor = profileType switch
    {
        IntelligentProfileType.GamerCompetitive => "#FF8C00",
        IntelligentProfileType.GamerSinglePlayer => "#008080",
        IntelligentProfileType.GamerSimulation => "#800080",
        IntelligentProfileType.GamerMMO => "#FFD700",
        IntelligentProfileType.GamerStrategy => "#B22222",
        IntelligentProfileType.WorkOffice => "#1E90FF",
        IntelligentProfileType.CreativeVideoEditing => "#FF00FF",
        IntelligentProfileType.DeveloperProgramming => "#00CED1",
        IntelligentProfileType.EnterpriseSecure => "#8B0000",
        _ => "#8B31FF"
    };

                bool isActive = currentProfile == profileType;

                // [FIX:PRO-SYSTRAY] O selo PRO DECIDE PELA LICENÇA, NÃO PELO ITEM ATIVO
                // ============================================================
                // A condição original era `if (!isActive)`, e ela estava errada por
                // um motivo simples: confundia "este item não é o perfil atual"
                // com "este item exige licença". São coisas sem nenhuma relação.
                //
                // O efeito era o que o usuário reportou: com a licença ativa,
                // o cabeçalho do submenu escondia o selo (porque usa
                // `profileIsPro = !ProFeatureGuard.IsPaidActive()`, linha acima),
                // mas TODOS os perfis dentro do submenu continuavam mostrando
                // PRO. Ou seja, o mesmo app, na mesma tela, discordando de si
                // mesmo — e o botão do Dashboard, que usa o controle `ProBadge`,
                // discordava dos dois.
                //
                // `ProFeatureGuard.IsPaidActive()` é a MESMA fonte de verdade do
                // controle `ProBadge` da UI: ambas passam por
                // `LicenseTokenStore.IsProActive` (ProFeatureGuard.cs linha 27).
                // Usar a mesma função é o que impede as telas de divergirem de
                // novo, e é mais importante do que parecer certo hoje.
                //
                // Por que não se usa o controle `ProBadge` aqui também: ele é um
                // UserControl, e o item de menu precisa do selo com métrica
                // própria para caber na linha. A CORREÇÃO fica na condição; o
                // visual continua idêntico ao de antes.
                //
                // E o menu do tray é RECRIADO a cada abertura (linha ~3206, "Sempre
                // recriar para refletir estado atual"), então esta leitura já
                // reflete o estado da licença no momento em que o usuário abre o menu
                // — não existe estado velho preso num menu construído no startup.
                var itemHeader = new System.Windows.Controls.StackPanel
                {
                    Orientation = Orientation.Horizontal,
                    VerticalAlignment = VerticalAlignment.Center
                };
                itemHeader.Children.Add(new System.Windows.Controls.TextBlock
                {
                    Text = isActive ? "✔ " + profileLabel : profileLabel,
                    VerticalAlignment = VerticalAlignment.Center
                });
                if (!isActive && !ProFeatureGuard.IsPaidActive())
                {
                    itemHeader.Children.Add(CreateProBadgePill());
                }

                var pItem = new MenuItem
                {
                    Header = itemHeader,
                    Icon = CreateSvgIcon(profileIcon, iconColor),
                    FontWeight = isActive ? FontWeights.SemiBold : FontWeights.Normal,
                    IsEnabled = !isActive
                };
                pItem.Click += (s, e) =>
                {
                    try
                    {
                        if (SettingsService.Instance.Settings.IntelligentProfile == profileType) return;
                        if (!ProFeatureGuard.IsPaidActive())
                        {
                            ProFeatureGuard.RequirePaid("intelligent_profile");
                            return;
                        }
                        SettingsService.Instance.Settings.IntelligentProfile = profileType;
                        SettingsService.Instance.SaveSettings();
                        SettingsService.Instance.NotifyProfileChanged(profileType);
                    }
                    catch { }
                };
                profileMenu.Items.Add(pItem);
            }
            menu.Items.Add(profileMenu);



            menu.Items.Add(CreateFullWidthSeparator());
            
            // FECHAR (ícone: sair - cor vermelha #EF4444)
            var exitItem = new MenuItem
            {
                Header = LocalizationService.Instance.GetString("TrayCloseApp"),
                Icon = CreateSvgIcon("M19,6.41L17.59,5L12,10.59L6.41,5L5,6.41L10.59,12L5,17.59L6.41,19L12,13.41L17.59,19L19,17.59L13.41,12L19,6.41Z", "#EF4444"),
                Foreground = new SolidColorBrush(MediaColor.FromRgb(0xEF, 0x44, 0x44)),
                FontWeight = FontWeights.Bold
            };
            exitItem.Click += (s, e) => ExitApplication();
            menu.Items.Add(exitItem);
            
            return menu;
        }

        private FrameworkElement CreateHeaderContent(string title, string version)
        {
            var container = new StackPanel
            {
                Orientation = Orientation.Horizontal,
                HorizontalAlignment = HorizontalAlignment.Center,
                VerticalAlignment = VerticalAlignment.Center
            };

            // ícone  36px, centralizado verticalmente com o bloco de texto
            bool iconLoaded = false;
            var icon = new System.Windows.Controls.Image
            {
                Width = 36,
                Height = 36,
                VerticalAlignment = VerticalAlignment.Center,
                Margin = new Thickness(0, 0, 12, 0),
                SnapsToDevicePixels = true,
                UseLayoutRounding = true
            };
            try
            {
                var pngUri = new Uri("pack://application:,,/Images/voltris.png", UriKind.Absolute);
                icon.Source = new BitmapImage(pngUri);
                RenderOptions.SetBitmapScalingMode(icon, BitmapScalingMode.HighQuality);
                iconLoaded = true;
            }
            catch { }

            if (iconLoaded)
            {
                container.Children.Add(icon);
            }
            else
            {
                var gradient = new LinearGradientBrush
                {
                    StartPoint = new System.Windows.Point(0, 0),
                    EndPoint = new System.Windows.Point(1, 0)
                };
                gradient.GradientStops.Add(new GradientStop((MediaColor)Application.Current.Resources["AccentColor"], 0));
                gradient.GradientStops.Add(new GradientStop((MediaColor)Application.Current.Resources["SecondaryColor"], 0.5));
                gradient.GradientStops.Add(new GradientStop((MediaColor)Application.Current.Resources["PrimaryColor"], 1));
                container.Children.Add(new TextBlock
                {
                    Text = "?",
                    FontSize = 28,
                    VerticalAlignment = VerticalAlignment.Center,
                    Margin = new Thickness(0, 0, 12, 0),
                    Foreground = gradient
                });
            }

            // Bloco de texto: ttulo + verso
            var textGradient = new LinearGradientBrush
            {
                StartPoint = new System.Windows.Point(0, 0),
                EndPoint = new System.Windows.Point(1, 0)
            };
            textGradient.GradientStops.Add(new GradientStop((MediaColor)Application.Current.Resources["AccentColor"], 0));
            textGradient.GradientStops.Add(new GradientStop((MediaColor)Application.Current.Resources["SecondaryColor"], 0.5));
            textGradient.GradientStops.Add(new GradientStop((MediaColor)Application.Current.Resources["PrimaryColor"], 1));

            var textStack = new StackPanel
            {
                VerticalAlignment = VerticalAlignment.Center,
                Orientation = Orientation.Vertical
            };
            var titleBlock = new TextBlock
            {
                Text = title,
                FontSize = 14,
                FontWeight = FontWeights.SemiBold,
                Foreground = textGradient
            };
            TextOptions.SetTextRenderingMode(titleBlock, System.Windows.Media.TextRenderingMode.ClearType);
            textStack.Children.Add(titleBlock);
            textStack.Children.Add(new TextBlock
            {
                Text = version,
                FontSize = 11,
                Foreground = new SolidColorBrush(MediaColor.FromRgb(0x94, 0xA3, 0xB8)),
                Margin = new Thickness(0, 2, 0, 0)
            });

            container.Children.Add(textStack);
            return container;
        }

        private MenuItem CreateSectionHeader(string title)
        {
            var text = new TextBlock
            {
                Text = title.ToUpperInvariant(),
                FontSize = 10,
                FontWeight = FontWeights.SemiBold,
                Foreground = new SolidColorBrush((MediaColor)Application.Current.Resources["TextSecondaryColor"]),
                HorizontalAlignment = HorizontalAlignment.Center,
                VerticalAlignment = VerticalAlignment.Center,
                TextAlignment = TextAlignment.Center
            };
            var item = new MenuItem
            {
                Header = text,
                IsEnabled = false,
                Padding = new Thickness(8, 5, 8, 5),
                HorizontalContentAlignment = HorizontalAlignment.Stretch
            };
            return item;
        }

        private MenuItem CreateFullWidthSeparator()
        {
            var gradient = new LinearGradientBrush
            {
                StartPoint = new System.Windows.Point(0, 0),
                EndPoint = new System.Windows.Point(1, 0)
            };
            gradient.GradientStops.Add(new GradientStop((MediaColor)Application.Current.Resources["AccentColor"], 0));
            gradient.GradientStops.Add(new GradientStop((MediaColor)Application.Current.Resources["SecondaryColor"], 0.5));
            gradient.GradientStops.Add(new GradientStop((MediaColor)Application.Current.Resources["PrimaryColor"], 1));
            var border = new Border
            {
                Height = 1,
                HorizontalAlignment = HorizontalAlignment.Stretch,
                Background = gradient,
                // Margem negativa horizontal para compensar o padding interno do MenuItem
                Margin = new Thickness(-12, 4, -12, 4)
            };
            var item = new MenuItem
            {
                Header = border,
                IsEnabled = false,
                Padding = new Thickness(12, 0, 12, 0),
                HorizontalContentAlignment = HorizontalAlignment.Stretch
            };
            return item;
        }
        
        /// <summary>
        /// Cria um ícone SVG colorido para o menu de contexto do systray,
        /// seguindo o MESMO padro visual dos ícones do sidebar.
        /// </summary>
        private static FrameworkElement CreateSvgIcon(string pathData, string colorHex)
        {
            var brush = new SolidColorBrush(
                (System.Windows.Media.Color)System.Windows.Media.ColorConverter.ConvertFromString(colorHex));
            return new System.Windows.Shapes.Path
            {
                Data = System.Windows.Media.Geometry.Parse(pathData),
                Fill = brush,
                Width = 16,
                Height = 16,
                Stretch = System.Windows.Media.Stretch.Uniform,
                Margin = new Thickness(0, 0, 8, 0),
                SnapsToDevicePixels = true,
                UseLayoutRounding = true
            };
        }

        /// <summary>
        /// Pill "PRO" para menus construídos por código. Mesmas cores e peso do
        /// controle ProBadge da UI (gradiente dourado + texto quase preto), para
        /// o usuário ver exatamente o mesmo selo em qualquer lugar do app.
        /// </summary>
        private static FrameworkElement CreateProBadgePill(double fontSize = 8.5)
        {
            var border = new System.Windows.Controls.Border
            {
                CornerRadius = new CornerRadius(7),
                Padding = new Thickness(5, 1, 5, 1),
                Margin = new Thickness(6, 0, 0, 0),
                VerticalAlignment = VerticalAlignment.Center,
                SnapsToDevicePixels = true,
                Background = new System.Windows.Media.LinearGradientBrush(
                    (System.Windows.Media.Color)System.Windows.Media.ColorConverter.ConvertFromString("#FFD76A"),
                    (System.Windows.Media.Color)System.Windows.Media.ColorConverter.ConvertFromString("#F7A325"),
                    new System.Windows.Point(0, 0), new System.Windows.Point(1, 1))
            };
            border.Child = new System.Windows.Controls.TextBlock
            {
                Text = "PRO",
                FontSize = fontSize,
                FontWeight = FontWeights.Black,
                Foreground = new System.Windows.Media.SolidColorBrush(
                    (System.Windows.Media.Color)System.Windows.Media.ColorConverter.ConvertFromString("#1A1200"))
            };
            return border;
        }

        /// <summary>
        /// Cabeçalho de item de menu com texto + selo PRO opcional, alinhados
        /// na horizontal e centralizados verticalmente.
        /// </summary>
        private static FrameworkElement CreateMenuHeaderWithPro(string label, bool showPro)
        {
            var panel = new System.Windows.Controls.StackPanel
            {
                Orientation = Orientation.Horizontal,
                VerticalAlignment = VerticalAlignment.Center
            };
            panel.Children.Add(new System.Windows.Controls.TextBlock
            {
                Text = label,
                VerticalAlignment = VerticalAlignment.Center
            });
            if (showPro)
            {
                panel.Children.Add(CreateProBadgePill());
            }
            return panel;
        }

        private System.Drawing.Icon GetApplicationIcon()
        {
            try
            {
                int iconSize = 128;
                try
                {
                    // Tentar obter DPI, mas no falhar se no conseguir
                    if (Application.Current.MainWindow != null)
                    {
                        var dpi = VisualTreeHelper.GetDpi(Application.Current.MainWindow);
                        iconSize = (int)Math.Round(48 * dpi.DpiScaleX);
                        iconSize = Math.Min(Math.Max(iconSize, 128), 256);
                    }
                }
                catch { }
                
                try
                {
                    App.LoggingService?.LogInfo($"Systray icon size selected: {iconSize}px");
                }
                catch { }

                var icoPath = Path.Combine(AppDomain.CurrentDomain.BaseDirectory, "Images", "favicon.ico");
                if (File.Exists(icoPath))
                {
                    try
                    {
                        using (var iconStream = File.OpenRead(icoPath))
                        {
                            var ico = new System.Drawing.Icon(iconStream);
                            try
                            {
                                return new System.Drawing.Icon(ico, new System.Drawing.Size(iconSize, iconSize));
                            }
                            catch
                            {
                                return ico;
                            }
                        }
                    }
                    catch (Exception ex)
                    {
                        App.LoggingService?.LogWarning($"Erro ao carregar favicon.ico: {ex.Message}");
                    }
                }

                var pngPath = Path.Combine(AppDomain.CurrentDomain.BaseDirectory, "Images", "logo.png");
                if (File.Exists(pngPath))
                {
                    try
                    {
                        using (var bitmap = new Bitmap(pngPath))
                        {
                            using (var resizedBitmap = new Bitmap(bitmap, iconSize, iconSize))
                            {
                                var iconHandle = resizedBitmap.GetHicon();
                                var icon = (System.Drawing.Icon)System.Drawing.Icon.FromHandle(iconHandle).Clone();
                                Win32.DestroyIcon(iconHandle);
                                return icon;
                            }
                        }
                    }
                    catch (Exception ex)
                    {
                        App.LoggingService?.LogWarning($"Erro ao carregar logo.png: {ex.Message}");
                    }
                }
            }
            catch (Exception ex)
            {
                App.LoggingService?.LogError($"Erro ao obter ícone do aplicativo: {ex.Message}", ex);
            }

            // Fallback: usar ícone padro do sistema
            try
            {
                return System.Drawing.SystemIcons.Application;
            }
            catch
            {
                // Último recurso: criar um íícone simples
                return new System.Drawing.Icon(System.Drawing.SystemIcons.Application, 16, 16);
            }
        }
        
        // Helper class para liberar handles de ícones e APIs DWM
        private static class Win32
        {
            [DllImport("user32.dll", CharSet = CharSet.Auto)]
            public static extern bool DestroyIcon(IntPtr handle);
            
            [DllImport("user32.dll")]
            public static extern bool SetForegroundWindow(IntPtr hWnd);
            
            // APIs para definir ícone da janela
            [DllImport("user32.dll", CharSet = CharSet.Auto)]
            internal static extern IntPtr SendMessage(IntPtr hWnd, uint Msg, IntPtr wParam, IntPtr lParam);
            
            [DllImport("user32.dll", SetLastError = true)]
            internal static extern IntPtr SetClassLongPtr(IntPtr hWnd, int nIndex, IntPtr dwNewLong);
            
            [DllImport("user32.dll", SetLastError = true, EntryPoint = "SetClassLong")]
            internal static extern IntPtr SetClassLong32(IntPtr hWnd, int nIndex, IntPtr dwNewLong);
            
            // APIs para regio arredondada
            [DllImport("gdi32.dll")]
            public static extern IntPtr CreateRoundRectRgn(int x1, int y1, int x2, int y2, int cx, int cy);
            
            [DllImport("user32.dll")]
            public static extern int SetWindowRgn(IntPtr hWnd, IntPtr hRgn, bool bRedraw);
            
            // Constantes para mensagens e ndices
            internal const uint WM_SETICON = 0x0080;
            internal const int GCL_HICON = -14;
            internal const int GCL_HICONSM = -34;
            
            // DWM APIs para bordas arredondadas nativas do Windows 11
            [DllImport("dwmapi.dll", CharSet = CharSet.Unicode, PreserveSig = false)]
            internal static extern void DwmSetWindowAttribute(IntPtr hwnd, DWMWINDOWATTRIBUTE attribute, ref int pvAttribute, uint cbAttribute);
            
            [DllImport("dwmapi.dll", CharSet = CharSet.Unicode, PreserveSig = false)]
            internal static extern void DwmExtendFrameIntoClientArea(IntPtr hwnd, ref MARGINS margins);
            
            [DllImport("gdi32.dll")]
            internal static extern bool DeleteObject(IntPtr hObject);
            
            // Helper para SetClassLongPtr (compatvel com 32-bit e 64-bit)
            internal static IntPtr SetClassLongPtrSafe(IntPtr hWnd, int nIndex, IntPtr dwNewLong)
            {
                if (IntPtr.Size == 8) // 64-bit
                    return SetClassLongPtr(hWnd, nIndex, dwNewLong);
                else // 32-bit
                    return SetClassLong32(hWnd, nIndex, dwNewLong);
            }
            
            internal enum DWMWINDOWATTRIBUTE
            {
                DWMWA_WINDOW_CORNER_PREFERENCE = 33,
                DWMWA_BORDER_COLOR = 34,
                DWMWA_CAPTION_COLOR = 35,
                DWMWA_TEXT_COLOR = 36,
                DWMWA_VISIBLE_FRAME_BORDER_THICKNESS = 37,
                DWMWA_SYSTEMBACKDROP_TYPE = 38,
                DWMWA_MICA_EFFECT = 1029
            }
            
            internal enum DWM_WINDOW_CORNER_PREFERENCE
            {
                DWMWCP_DEFAULT = 0,
                DWMWCP_DONOTROUND = 1,
                DWMWCP_ROUND = 2,
                DWMWCP_ROUNDSMALL = 3
            }
            
            [StructLayout(LayoutKind.Sequential)]
            internal struct MARGINS
            {
                public int Left;
                public int Right;
                public int Top;
                public int Bottom;
            }

            // Structs e P/Invoke para WM_GETMINMAXINFO (maximizao correta)
            [StructLayout(LayoutKind.Sequential)]
            internal struct POINT
            {
                public int X;
                public int Y;
            }

            [StructLayout(LayoutKind.Sequential)]
            internal struct RECT
            {
                public int Left;
                public int Top;
                public int Right;
                public int Bottom;
            }

            [StructLayout(LayoutKind.Sequential)]
            internal struct MONITORINFO
            {
                public int cbSize;
                public RECT rcMonitor;
                public RECT rcWork;
                public uint dwFlags;
            }

            [DllImport("user32.dll")]
            internal static extern IntPtr MonitorFromWindow(IntPtr hwnd, uint dwFlags);

            [DllImport("user32.dll")]
            internal static extern bool GetMonitorInfo(IntPtr hMonitor, ref MONITORINFO lpmi);

            [DllImport("user32.dll")]
            [return: MarshalAs(UnmanagedType.Bool)]
            internal static extern bool GetWindowPlacement(IntPtr hWnd, ref WINDOWPLACEMENT lpwndpl);

            [DllImport("user32.dll")]
            internal static extern bool ReleaseCapture();

            [StructLayout(LayoutKind.Sequential)]
            internal struct WINDOWPLACEMENT
            {
                public int length;
                public int flags;
                public int showCmd;
                public POINT ptMinPosition;
                public POINT ptMaxPosition;
                public RECT rcNormalPosition;
            }
        }
        
        private void ShowWindow()
        {
            RestoreFromTray();
            Win32WindowHelper.ForceForegroundWindow(_hwnd);
        }

        /// <summary>
        /// Restaura a janela do systray e traz para o foco (usado por atalhos globais).
        /// </summary>
        public void ShowAndFocus()
        {
            ShowWindow();
        }

        /// <summary>
        /// Executa a limpeza profunda — a MESMA ação do botão circular do Dashboard moderno — via atalho global.
        /// </summary>
        public async Task RunDeepCleanFromHotkeyAsync(string origin = "Hotkey")
        {
            try
            {
                App.LoggingService?.LogInfo($"[Hotkey] Limpeza profunda (ação do botão circular) iniciada via atalho — origin: {origin}");
                ShowWindow();
                await NavigateToPageSafeAsync("Dashboard");
                await VoltrisOptimizer.UI.ViewModels.TransientDashboard.RunAsync(vm => vm.MasterActionAsync(origin));
            }
            catch (Exception ex)
            {
                App.LoggingService?.LogError($"[Hotkey] Erro ao executar limpeza profunda via atalho: {ex.Message}");
            }
        }

        /// <summary>
        /// Executa a LIMPEZA RÁPIDA via atalho global.
        ///
        /// Antes, o atalho "Limpeza Rápida" (CTRL+ALT+C) chamava
        /// <see cref="RunDeepCleanFromHotkeyAsync"/> — ou seja, rodava a limpeza
        /// PROFUNDA, idêntica ao ALT+2. Agora executa a função de verdade.
        /// </summary>
        public async Task RunQuickCleanupFromHotkeyAsync(string origin = "Hotkey")
        {
            try
            {
                App.LoggingService?.LogInfo($"[Hotkey] Limpeza rápida iniciada via atalho — origin: {origin}");
                ShowWindow();
                await NavigateToPageSafeAsync("Dashboard");
                await VoltrisOptimizer.UI.ViewModels.TransientDashboard.RunAsync(vm => vm.QuickCleanupAsync(origin));
            }
            catch (Exception ex)
            {
                App.LoggingService?.LogError($"[Hotkey] Erro ao executar limpeza rápida via atalho: {ex.Message}", ex);
            }
        }

        /// <summary>
        /// Chamado pelo menu de contexto do desktop (/show) para restaurar a janela do systray.
        /// </summary>
        public void ShowFromContextMenu()
        {
            try
            {
                if (_hwnd == IntPtr.Zero) _hwnd = new WindowInteropHelper(this).Handle;
                RestoreFromTray();
                Win32WindowHelper.ForceForegroundWindow(_hwnd);
                LogToFile("[MainWindow] ShowFromContextMenu - janela restaurada do systray");
            }
            catch (Exception ex)
            {
                LogToFile($"[MainWindow] ShowFromContextMenu erro: {ex.Message}");
            }
        }
        
        private async Task RunCleanupAsync()
        {
            try
            {
                App.LoggingService?.LogInfo("[ModernMenu] Limpeza Rpida iniciada via ModernMenu");
                ShowWindow();
                await NavigateToPageSafeAsync("Dashboard");
                await VoltrisOptimizer.UI.ViewModels.TransientDashboard.RunAsync(vm => vm.QuickCleanupAsync("ModernMenu"));
            }
            catch { }
        }

        /// <summary>
        /// Executa a otimização rápida de RAM via atalho global.
        /// </summary>
        public async Task RunQuickOptimizeFromHotkeyAsync(string origin = "Hotkey")
        {
            try
            {
                App.LoggingService?.LogInfo($"[Hotkey] Otimização rápida de RAM iniciada via atalho — origin: {origin}");
                ShowWindow();
                await NavigateToPageSafeAsync("Dashboard");
                await VoltrisOptimizer.UI.ViewModels.TransientDashboard.RunAsync(vm => vm.QuickOptimizeAsync(origin));
            }
            catch (Exception ex)
            {
                App.LoggingService?.LogError($"[Hotkey] Erro ao executar otimização rápida via atalho: {ex.Message}");
            }
        }

        private async Task RunQuickOptimizeAsync()
        {
            try
            {
                App.LoggingService?.LogInfo("[ModernMenu] Otimizar Agora iniciado via ModernMenu");
                ShowWindow();
                await NavigateToPageSafeAsync("Dashboard");
                await VoltrisOptimizer.UI.ViewModels.TransientDashboard.RunAsync(vm => vm.QuickOptimizeAsync("ModernMenu"));
            }
            catch { }
        }

        /// <summary>
        /// Fecha a aplicação completamente, liberando todos os recursos.
        /// Estratgia: ocultar janela IMEDIATAMENTE, disparar cleanup em background,
        /// e forar Environment.Exit aps timeout curto para nunca travar.
        /// </summary>
        private async void ExitApplication()
        {
            try
            {
                if (_isClosing) return;
                _isClosing = true;
                
                App.LoggingService?.LogInfo("[ExitApplication] Iniciando fechamento seguro (Enterprise Shutdown)...");
                
                // FAILSAFE ABSOLUTO: Thread de segurança que GARANTE que o processo morre em no máximo 20s.
                // Se qualquer cleanup travar (deadlock no Dispatcher, serviço que não responde, etc.),
                // esta thread força o encerramento, impedindo processos fantasma (MSB3027/MSB3021).
                var failsafeThread = new Thread(() =>
                {
                    try
                    {
                        Thread.Sleep(20_000); // 20s — tempo mais que suficiente para cleanup normal
                        App.LoggingService?.LogWarning("[ExitApplication] FAILSAFE: Timeout de 20s atingido! Forçando encerramento do processo.");
                    }
                    catch { }
                    finally
                    {
                        // Environment.Exit é thread-safe e funciona de qualquer thread
                        Environment.Exit(1);
                    }
                })
                {
                    Name = "ExitFailsafe",
                    IsBackground = true, // Não impede o processo de fechar se o main thread terminar
                    Priority = ThreadPriority.Highest
                };
                failsafeThread.Start();
                
                // 0. CANCELAR TODOS OS LOOPS DE BACKGROUND (polling, etc.)
                try { _backgroundCts.Cancel(); } catch { }

                // 1. OCULTAR TUDO IMEDIATAMENTE  percepo de fechamento instantneo
                try { this.Hide(); } catch { }
                if (_notifyIcon != null)
                {
                    _notifyIcon.Visible = false;
                    _notifyIcon.Dispose();
                    _notifyIcon = null;
                }
                
                // 1.1 Fechar tooltip e widget para liberar janelas/timers WPF que mantêm o processo vivo
                try { if (_modernTooltip != null) { _modernTooltip.Close(); _modernTooltip = null; } } catch { }
                try 
                { 
                    var widgetMgr = App.Services?.GetService<VoltrisOptimizer.UI.Widgets.WidgetManagerService>();
                    widgetMgr?.Dispose();
                } catch { }

                // 2. Desinscrever eventos (rpido, sem IO)
                try { if (_gamerViewModel != null) _gamerViewModel.PropertyChanged -= OnGamerViewModelPropertyChanged; } catch { }
                try { if (_dummySource != null) { _dummySource.Dispose(); _dummySource = null; } } catch { }
                try 
                {
                    if (_hwnd != IntPtr.Zero)
                    {
                        var source = System.Windows.Interop.HwndSource.FromHwnd(_hwnd);
                        source?.RemoveHook(WndProc);
                    }
                } 
                catch (Exception ex) { App.LoggingService?.LogWarning($"Erro ao remover WndProc hook: {ex.Message}"); }

                // 3. Remover menu de contexto AGORA (antes do shutdown)
                try
                {
                    var ctxMenu = App.Services?.GetService<VoltrisOptimizer.Services.Shell.DesktopContextMenuService>();
                    if (ctxMenu != null)
                    {
                        ctxMenu.Unregister();
                        App.LoggingService?.LogInfo("[ExitApplication] Menu de contexto removido antes do shutdown");
                    }
                }
                catch (Exception ex)
                {
                    App.LoggingService?.LogWarning($"[ExitApplication] Erro ao remover menu de contexto: {ex.Message}");
                }

                // 4. Disparar cleanup de backend com aguardo e timeout rgido
                try
                {
                    using var cts = new CancellationTokenSource(TimeSpan.FromSeconds(15));
                    var tasks = new List<Task>();

                    // 4.1 Gamer Mode deactivation (Garante desligamento 100% profissional)
                    tasks.Add(Task.Run(() =>
                    {
                        try
                        {
                                    VoltrisOptimizer.Services.Gamer.GamerModeShutdownHelper.ShutdownAllBlocking(
                                App.Services, 
                                App.LoggingService, 
                                "MainWindowExit", 
                                30000);
                        }
                        catch (Exception ex)
                        {
                            App.LoggingService?.LogWarning($"[ExitApplication] Falha no GamerModeShutdownHelper: {ex.Message}");
                        }
                    }));

                    // 4.2 Spine Rollback (Crucial para no deixar o sistema com otimizaes parciais)
                    if (App.Spine != null)
                    {
                        tasks.Add(Task.Run(async () =>
                        {
                            try { await App.Spine.RollbackAllAsync(); }
                            catch { }
                        }));
                    }

                    // 4.3 Parar IA BrainV2
                    if (App.BrainV2 != null)
                    {
                        tasks.Add(Task.Run(async () =>
                        {
                            try { await App.BrainV2.StopAsync(); }
                            catch { }
                        }));
                    }

                    // Aguarda todas as tarefas pesadas de finalização com segurança
                    await Task.WhenAll(tasks).WaitAsync(cts.Token);
                    App.LoggingService?.LogInfo("[ExitApplication] Limpeza de backend concluída com sucesso.");
                }
                catch (Exception ex)
                {
                    App.LoggingService?.LogWarning($"[ExitApplication] Timeout ou erro durante a limpeza de backend: {ex.Message}");
                }

                // 6. Forçar encerramento absoluto do processo imediatamente
                // Isso garante que NUNCA trave, impedindo DLLs presas (MSB3061) e processos zumbis
                
                // Dispara Telegram ANTES de matar o processo — fire-and-forget com await seguro.
                // CORREÇÃO CRÍTICA: Removido .Wait(TimeSpan.FromSeconds(3)) que bloqueava
                // a UI Thread por até 3 segundos, causando freeze detectado no UIFreeze log.
                try 
                {
                    var telegramTask = Task.Run(async () => await VoltrisOptimizer.Services.TelegramLogger.SendMessageAsync(
                        $"🛑 <b>Voltris Optimizer Fechado</b>\n<b>Máquina:</b> {Environment.MachineName}\n<b>Versão:</b> {VoltrisOptimizer.Properties.VersionInfo.Version}",
                        isHtml: true
                    ));
                    // Aguarda no máximo 2s sem bloquear o SynchronizationContext do WPF
                    await Task.WhenAny(telegramTask, Task.Delay(TimeSpan.FromSeconds(2))).ConfigureAwait(false);
                } 
                catch (Exception ex)
                {
                    App.LoggingService?.LogWarning($"[ExitApplication] Telegram send falhou ao encerrar: {ex.Message}");
                }

                App.LoggingService?.LogInfo("[ExitApplication] Encerrando processo agora (Environment.Exit).");
                Environment.Exit(0);
            }
            catch
            {
                // Fallback absoluto
                try { Environment.Exit(0); } catch { }
            }
        }
        
        private void UpdateLocalizedTexts()
        {
            // Os botes de navegao agora usam ícones vetoriais, no precisam de atualização de texto aqui
            // A localizao do texto  feita via binding ou diretamente no XAML
            
            // Atualizar status
            if (StatusLabel != null) StatusLabel.Text = _localization.GetString("Ready");
            
            // Atualizar tooltips dos botes de janela
            if (SettingsButton != null) SettingsButton.ToolTip = _localization.GetString("Settings");
            if (MinimizeButton != null) MinimizeButton.ToolTip = _localization.GetString("Minimize");
            if (MaximizeButton != null) MaximizeButton.ToolTip = _localization.GetString("Maximize");
            if (CloseButton != null) CloseButton.ToolTip = _localization.GetString("Close");

            // Atualizar tooltip do toggle do sidebar e dos botões de navegação
            UpdateSidebarToggleToolTip();
            UpdateSidebarNavToolTips();

            // Atualizar tooltips dinmicos do header (tema, transparncia, cloud)
            bool isLight = _settings.Settings.Theme?.Equals("Light", StringComparison.OrdinalIgnoreCase) == true;
            if (ThemeToggleButton != null)
                ThemeToggleButton.ToolTip = isLight ? _localization.GetString("TooltipThemeDark") : _localization.GetString("TooltipThemeLight");
            if (TransparencyToggleButton != null)
                TransparencyToggleButton.ToolTip = _settings.Settings.EnableTransparency ? _localization.GetString("TooltipTranspDisable") : _localization.GetString("TooltipTranspEnable");

            // O tooltip da conta mora no chip do Dashboard (que mostra o email
            // em texto, então dispensa tooltip) — nada a atualizar aqui.
        }



        // ============================================================
        // SIDEBAR RESPONSIVO (MODO RAIL)
        // ============================================================

        private void ApplyInitialSidebarState()
        {
            if (_sidebarStateInitialized)
                return;
            _sidebarStateInitialized = true;

            try
            {
                UpdateSidebarToggleToolTip();
                UpdateSidebarNavToolTips();

                var persistedCollapsed = _settings.Settings.SidebarCollapsed;
                if (persistedCollapsed)
                {
                    _sidebarUserOverride = true;
                    IsSidebarExpanded = false;
                    UpdateSidebarLogoVisibility(false);
                    ApplyRailStateToButtons(false);
                    SidebarColumn.Width = new GridLength(SideNavRailWidthBounds, GridUnitType.Pixel);
                }
                else
                {
                    SidebarColumn.Width = new GridLength(SideNavExpandedWidthBounds, GridUnitType.Pixel);
                    UpdateSidebarLogoVisibility(true);
                    ApplyRailStateToButtons(true);
                }

                // Se a janela iniciar estreita, aplicar colapso automático sem animação
                if (ActualWidth > 0 && ActualWidth < SideNavCollapseWidthThreshold)
                {
                    IsSidebarExpanded = false;
                    UpdateSidebarLogoVisibility(false);
                    ApplyRailStateToButtons(false);
                    SidebarColumn.Width = new GridLength(SideNavRailWidthBounds, GridUnitType.Pixel);
                    _sidebarAutoCollapsed = true;
                }
            }
            catch (Exception ex)
            {
                LogToFile($"[Sidebar] Erro ao aplicar estado inicial: {ex.Message}");
            }
        }

        private void SetSidebarExpanded(bool expanded, bool animate = true)
        {
            if (SidebarColumn == null)
                return;

            if (IsSidebarExpanded == expanded)
            {
                UpdateSidebarToggleToolTip();
                return;
            }

            IsSidebarExpanded = expanded;
            UpdateSidebarToggleToolTip();
            UpdateSidebarLogoVisibility(expanded);
            ApplyRailStateToButtons(expanded);

            var targetWidth = expanded ? SideNavExpandedWidthBounds : SideNavRailWidthBounds;

            if (animate)
            {
                var fromWidth = SidebarColumn.ActualWidth > 0 ? SidebarColumn.ActualWidth : SidebarColumn.Width.Value;
                var anim = new GridLengthAnimation
                {
                    From = new GridLength(fromWidth, GridUnitType.Pixel),
                    To = new GridLength(targetWidth, GridUnitType.Pixel),
                    Duration = new System.Windows.Duration(TimeSpan.FromMilliseconds(220)),
                    EasingFunction = new System.Windows.Media.Animation.CubicEase
                    {
                        EasingMode = System.Windows.Media.Animation.EasingMode.EaseInOut
                    }
                };
                SidebarColumn.BeginAnimation(ColumnDefinition.WidthProperty, anim);
            }
            else
            {
                SidebarColumn.BeginAnimation(ColumnDefinition.WidthProperty, null);
                SidebarColumn.Width = new GridLength(targetWidth, GridUnitType.Pixel);
            }
        }

        private void SidebarToggleButton_Click(object sender, RoutedEventArgs e)
        {
            _sidebarUserOverride = true;
            _sidebarAutoCollapsed = false;

            SetSidebarExpanded(!IsSidebarExpanded);

            try
            {
                _settings.Settings.SidebarCollapsed = !IsSidebarExpanded;
                _settings.SaveSettings();
            }
            catch (Exception ex)
            {
                LogToFile($"[Sidebar] Erro ao persistir estado: {ex.Message}");
            }
        }

        private void MainWindow_SizeChanged(object sender, SizeChangedEventArgs e)
        {
            if (!_sidebarStateInitialized || e.NewSize.Width <= 0)
                return;

            // Se o usuário definiu explicitamente, respeitar a escolha
            if (_sidebarUserOverride)
                return;

            bool shouldAutoCollapse = e.NewSize.Width < SideNavCollapseWidthThreshold;
            if (shouldAutoCollapse != _sidebarAutoCollapsed)
            {
                _sidebarAutoCollapsed = shouldAutoCollapse;
                SetSidebarExpanded(!shouldAutoCollapse);
            }
        }

        private void UpdateSidebarToggleToolTip()
        {
            try
            {
                if (SidebarToggleButton == null)
                    return;
                SidebarToggleButton.ToolTip = IsSidebarExpanded
                    ? _localization.GetString("SidebarToggleCollapse")
                    : _localization.GetString("SidebarToggleExpand");
            }
            catch { }
        }

        private void UpdateSidebarLogoVisibility(bool isExpanded)
        {
            try
            {
                var visibility = isExpanded ? Visibility.Visible : Visibility.Collapsed;
                if (SidebarLogo != null)
                    SidebarLogo.Visibility = visibility;
                if (SidebarVersionBadge != null)
                    SidebarVersionBadge.Visibility = visibility;
            }
            catch { }
        }

        /// <summary>
        /// Reforço determinístico do modo rail: oculta os rótulos de texto e centraliza os
        /// ícones dos botões de navegação (independe dos DataTriggers de estilo).
        /// </summary>
        private void ApplyRailStateToButtons(bool isExpanded)
        {
            try
            {
                if (SidebarScrollViewer?.Content is not System.Windows.Controls.Panel menu)
                    return;

                var labelVisibility = isExpanded ? Visibility.Visible : Visibility.Collapsed;
                // 12 (e não 10) para bater com o Margin dos estilos. Este código
                // escreve um VALOR LOCAL no Path, que tem precedência sobre o
                // setter do Style — se aqui ficasse 10, o 12 do estilo seria
                // código morto e o rótulo do item selecionado andaria 2px fora
                // da coluna dos demais.
                var iconMargin = isExpanded ? new Thickness(0, 0, 12, 0) : new Thickness(0);

                foreach (var child in menu.Children)
                {
                    // Rótulos de grupo (TextBlocks filhos diretos do menu)
                    if (child is TextBlock groupLabel)
                    {
                        groupLabel.Visibility = labelVisibility;
                        continue;
                    }

                    if (child is not Button b)
                        continue;

                    if (b.Content is System.Windows.Controls.StackPanel sp)
                    {
                        sp.HorizontalAlignment = isExpanded
                            ? System.Windows.HorizontalAlignment.Stretch
                            : System.Windows.HorizontalAlignment.Center;

                        foreach (var contentChild in sp.Children)
                        {
                            switch (contentChild)
                            {
                                case TextBlock label:
                                    label.Visibility = labelVisibility;
                                    break;
                                case System.Windows.Shapes.Path icon:
                                    icon.Margin = iconMargin;
                                    break;
                            }
                        }
                    }
                }
            }
            catch { }
        }

        private void UpdateSidebarNavToolTips()
        {
            try
            {
                if (SidebarScrollViewer?.Content is not System.Windows.Controls.Panel menu)
                    return;

                foreach (var child in menu.Children)
                {
                    if (child is Button b && b.Tag is string tag)
                        b.ToolTip = _localization.GetString(tag);
                }
            }
            catch { }
        }

        private async void NavButton_Click(object sender, RoutedEventArgs e)
        {
            App.LoggingService?.LogInfo($"[MainWindow] NavButton_Click disparado - verificando licença para navegao");
            
            // Verificar trava de onboarding
            if (_isLockedForOnboarding)
            {
                App.LoggingService?.LogWarning("[MainWindow] Navegao bloqueada - onboarding em andamento");
                LockModal.Show();
                return;
            }

            // Re-declarar variveis no escopo correto para evitar erros de compilao
            if (!(sender is Button navButton) || !(navButton.Tag is string pageName))
            {
                App.LoggingService?.LogError("[MainWindow] Parmetros invlidos no NavButton_Click");
                return;
            }

            // VERIFICAO PROFISSIONAL DE LICENA - NVEL SaaS
            try
            {
                var licenseService = App.Services?.GetService(typeof(VoltrisOptimizer.Services.License.Interfaces.ILicenseService)) as VoltrisOptimizer.Services.License.Interfaces.ILicenseService;
                if (licenseService != null)
                {
                    App.LoggingService?.LogInfo("[MainWindow] Verificando acesso à navegação via LicenseService");
                    
                    // Permitir sempre Dashboard (página inicial), License Activation e Gamer (visualização livre no modelo Freemium)
                    if (pageName == "Dashboard" || pageName == "LicenseActivation" || pageName == "Gamer")
                    {
                        App.LoggingService?.LogInfo($"[MainWindow] Página '{pageName}' permitida (visualização livre)");
                    }
                    else
                    {
                        // Verificar licença para outras pginas
                        var checkResult = await licenseService.CheckFeatureAccessAsync("navigation", forceRefresh: false); // ?? CORREO: Removido .Result
                        if (!checkResult.IsAllowed)
                        {
                            App.LoggingService?.LogWarning($"[MainWindow] Navegao BLOQUEADA para '{pageName}': {checkResult.BlockReason}");
                            
                            // Mostrar modal de compra existente
                            ShowLicensePurchaseModal(checkResult.BlockReason);
                            return;
                        }
                        else
                        {
                            App.LoggingService?.LogInfo($"[MainWindow] Navegao PERMITIDA para '{pageName}': licença válida");
                        }
                    }
                }
                else
                {
                    App.LoggingService?.LogError("[MainWindow] LicenseService no encontrado - permitindo navegao (fail-open)");
                }
            }
            catch (Exception ex)
            {
                App.LoggingService?.LogError($"[MainWindow] Erro ao verificar licença para navegao: {ex.Message}", ex);
                // CORREÇÃO: FAIL-OPEN em caso de erro (antes era FAIL-CLOSED e bloqueava navegação)
                // O CheckLicenseStatus no boot j faz a verificação definitiva
                App.LoggingService?.LogWarning("[MainWindow] Permitindo navegao (fail-open) - erro na verificação de licença");
            }

            // Proteção absoluta contra navegações concorrentes
            if (_isNavigating)
            {
                App.LoggingService?.LogWarning("[MainWindow] Navegao ignorada - j em andamento");
                return;
            }

            // Verificar se já está na página atual (se não for null)
            if (_currentSelectedButton != null && navButton == _currentSelectedButton)
                return;

            // Bloquear navegação para páginas Beta desativadas
            if ((pageName == "Recovery" && !SettingsService.Instance.Settings.ShowRecoveryPage) ||
                (pageName == "Drivers" && !SettingsService.Instance.Settings.ShowDriversPage))
            {
                App.LoggingService?.LogWarning($"[MainWindow] Navegao bloqueada - página Beta '{pageName}' desativada nas configurações");
                return;
            }

            Button? previousButton = null;
            try
            {
                _isNavigating = true;
                
                // Desabilitar todos os botes temporariamente
                DisableNavigationButtons();
                
                // Armazenar boto selecionado ANTES de navegar (evita loops)
                previousButton = _currentSelectedButton;
                _currentSelectedButton = navButton;
                
                // Navegar PRIMEIRO
                NavigateToPageSafe(pageName);
                
                // Registrar telemetria de navegao
                _ = Task.Run(async () =>
                {
                    try
                    {
                        await VoltrisOptimizer.Services.Enterprise.TelemetryService.Instance.LogNavigationAsync(pageName);
                    }
                    catch { }
                });
                
                // Atualizar seleo visual
                Dispatcher.BeginInvoke(new System.Action(() =>
                {
                    try
                    {
                        if (_currentSelectedButton == navButton && navButton != null)
                        {
                            UpdateButtonSelectionSafe(navButton);
                        }
                    }
                    catch { }
                }), System.Windows.Threading.DispatcherPriority.Normal);
            }
            catch (Exception ex)
            {
                // Restaurar botão anterior em caso de erro
                _currentSelectedButton = previousButton;
                MessageBox.Show(string.Format(LocalizationService.Instance.GetString("MainWindowNavigationError"), pageName) + ": " + ex.Message, LocalizationService.Instance.GetString("Error"), MessageBoxButton.OK, MessageBoxImage.Error);
            }
            finally
            {
                // Reabilitar botões IMEDIATAMENTE após a navegação (mas ainda via Dispatcher para evitar flickering)
                Dispatcher.BeginInvoke(new System.Action(() =>
                {
                    try
                    {
                        _isNavigating = false;
                        EnableNavigationButtons();
                    }
                    catch
                    {
                        _isNavigating = false;
                    }
                }), System.Windows.Threading.DispatcherPriority.Send); // Prioridade bem alta para reabilitar rápido
            }
        }

        private void DisableNavigationButtons()
        {
            var buttons = new[] { NavDashboard, NavPerformance, NavNetwork, NavSystem, NavGamer, NavDiagnostics, NavHistory, NavScheduler, NavShield, NavRepair, NavPersonalize, NavDisplay, NavSecurity, NavPrivacy, NavDebloat, NavRecovery, NavDrivers, NavDeviceInfo, NavBenchmark, NavStreamHub, NavShortcuts };
            foreach (var btn in buttons.Where(b => b != null))
            {
                btn.IsEnabled = false;
            }
        }
        
        /// <summary>
        /// Desabilita visualmente botes do sidebar quando trial expirar
        /// Deixa apenas o boto de licença habilitado
        /// </summary>
        private void DisableSidebarButtonsForExpiredTrial()
        {
            try
            {
                App.LoggingService?.LogInfo("[LICENSE-BLOCK] Desabilitando botes do sidebar - trial expirado");
                
                // Lista de todos os botes exceto o de licença
                var buttons = new[] { 
                    NavDashboard, NavPerformance, NavNetwork, NavSystem, NavGamer, 
                    NavDiagnostics, NavHistory, NavScheduler,
                    NavShield, NavRepair, NavPersonalize, NavDisplay, NavSecurity,
                    NavPrivacy, NavDebloat, NavRecovery, NavDrivers, NavDeviceInfo, NavBenchmark, NavStreamHub,
                    // NavShortcuts estava ausente: ficava habilitado após o trial
                    // expirar e só era bloqueado depois, pelo gate de navegação.
                    NavShortcuts
                };
                
                foreach (var btn in buttons.Where(b => b != null))
                {
                    btn.IsEnabled = false;
                    btn.Opacity = 0.5; // Indicao visual de bloqueio
                    App.LoggingService?.LogInfo($"[LICENSE-BLOCK] Boto desabilitado: {btn.Name}");
                }
                
                // Manter o botão de licença habilitado e destacado
                if (ActivateLicenseHeaderButton != null)
                {
                    ActivateLicenseHeaderButton.IsEnabled = true;
                    ActivateLicenseHeaderButton.Opacity = 1.0;
                    ActivateLicenseHeaderButton.Background = new SolidColorBrush(Colors.Orange); // Destaque visual
                    App.LoggingService?.LogInfo("[LICENSE-BLOCK] Botão de licença destacado");
                }

                App.LoggingService?.LogInfo("[LICENSE-BLOCK] Sidebar bloqueado com sucesso");
            }
            catch (Exception ex)
            {
                App.LoggingService?.LogError("[LICENSE-BLOCK] Erro ao desabilitar sidebar", ex);
            }
        }

        private void EnableNavigationButtons()
        {
            var buttons = new[] { NavDashboard, NavPerformance, NavNetwork, NavSystem, NavGamer, NavDiagnostics, NavHistory, NavScheduler, NavShield, NavRepair, NavPersonalize, NavDisplay, NavSecurity, NavPrivacy, NavDebloat, NavRecovery, NavDrivers, NavDeviceInfo, NavBenchmark, NavStreamHub, NavShortcuts };
            foreach (var btn in buttons.Where(b => b != null))
            {
                btn.IsEnabled = true;
                btn.Opacity = 1.0; // Restaurar opacidade normal
            }

            // Restaurar botão de licença para estado normal
            if (ActivateLicenseHeaderButton != null)
            {
                ActivateLicenseHeaderButton.Background = null; // Remover destaque laranja
            }
        }
        
        /// <summary>
        /// Reabilita todos os botes do sidebar quando licença for ativada
        /// </summary>
        private void EnableSidebarButtonsForActiveLicense()
        {
            try
            {
                App.LoggingService?.LogInfo("[LICENSE-BLOCK] Reabilitando botes do sidebar - licença ativada");
                
                // Lista de todos os botes
                var buttons = new[] { 
                    NavDashboard, NavPerformance, NavNetwork, NavSystem, NavGamer, 
                    NavDiagnostics, NavHistory, NavScheduler, 
                    NavShield, NavRepair, NavPersonalize, NavDisplay, NavSecurity, 
                    NavPrivacy, NavDebloat, NavRecovery, NavDrivers, NavDeviceInfo, NavBenchmark, NavStreamHub
                };
                
                foreach (var btn in buttons.Where(b => b != null))
                {
                    btn.IsEnabled = true;
                    btn.Opacity = 1.0; // Restaurar opacidade normal
                    App.LoggingService?.LogInfo($"[LICENSE-BLOCK] Botão reabilitado: {btn.Name}");
                }

                // Restaurar botão de licença para estado normal
                if (ActivateLicenseHeaderButton != null)
                {
                    ActivateLicenseHeaderButton.Background = null; // Remover destaque laranja
                    App.LoggingService?.LogInfo("[LICENSE-BLOCK] Botão de licença restaurado");
                }

                // Esconder overlay de lockdown
                if (LicenseLockdownOverlay != null)
                {
                    LicenseLockdownOverlay.Visibility = Visibility.Collapsed;
                    App.LoggingService?.LogInfo("[LICENSE-BLOCK] Overlay de lockdown escondido");
                }

                _isLicenseBlocked = false;
                App.LoggingService?.LogInfo("[LICENSE-BLOCK] Sidebar reabilitado com sucesso");
            }
            catch (Exception ex)
            {
                App.LoggingService?.LogError("[LICENSE-BLOCK] Erro ao reabilitar sidebar", ex);
            }
        }
        
        /// <summary>
        /// Timer tick para verificação peridica do status do trial
        /// </summary>
        private async void LicenseStatusTimer_Tick(object? sender, EventArgs e)
        {
            try
            {
                App.LoggingService?.LogTrace("[LICENSE-TIMER] Verificao peridica do status da licença");
                
                // Usar o novo LicenseService profissional em vez do LicenseManager antigo
                var licenseService = App.Services?.GetService(typeof(VoltrisOptimizer.Services.License.Interfaces.ILicenseService)) as VoltrisOptimizer.Services.License.Interfaces.ILicenseService;
                if (licenseService != null)
                {
                    // Obter estado atual da licença
                    var licenseState = await licenseService.GetCurrentStateAsync(); // ?? CORREÇÃO: Removido .Result
                    App.LoggingService?.LogInfo($"[LICENSE-TIMER] Estado atual - Type: {licenseState.LicenseType}, Days: {licenseState.DaysRemaining}, Active: {licenseState.IsActive}");

                    // FREEMIUM: nenhum estado de licença bloqueia o app.
                    // O app é 100% gratuito; recursos PRO são bloqueados individualmente.
                    bool isBlocked = false;

                    // Se o sidebar estiver bloqueado (ex.: resquício de ativação antiga), reabilitar
                    if (_isLicenseBlocked)
                    {
                        App.LoggingService?.LogSuccess($"[LICENSE-TIMER] Freemium - modo gratuito ativo, reabilitando sidebar. Type: {licenseState.LicenseType}");
                        EnableSidebar();
                        _ = licenseService.InvalidateCacheAsync();
                    }
                }
                else
                {
                    App.LoggingService?.LogError("[LICENSE-TIMER] LicenseService não encontrado - fallback para LicenseManager");

                    // Freemium: apenas verificar se é Pro
                    var isPro = VoltrisOptimizer.Services.LicenseManager.IsPro;
                    
                    App.LoggingService?.LogInfo($"[LICENSE-TIMER] Fallback - IsPro: {isPro}");
                    
                    // FREEMIUM: nunca bloquear; apenas reabilitar se estiver bloqueado.
                    if (_isLicenseBlocked)
                    {
                        App.LoggingService?.LogInfo("[LICENSE-TIMER] Fallback - modo gratuito ativo, desbloqueando sidebar");
                        EnableSidebar();
                    }
                }
            }
            catch (Exception ex)
            {
                App.LoggingService?.LogError("[LICENSE-TIMER] Erro na verificação peridica do status", ex);
                
                // Em caso de erro, manter estado atual para não bloquear indevidamente
                App.LoggingService?.LogWarning("[LICENSE-TIMER] Erro detectado - mantendo estado atual do sidebar");
            }
        }
        
        /// <summary>
        /// Inicia o timer de verificação de licença
        /// </summary>
        private void StartLicenseStatusTimer()
        {
            try
            {
                if (_licenseStatusTimer != null && !_licenseStatusTimer.IsEnabled)
                {
                    _licenseStatusTimer.Start();
                    App.LoggingService?.LogInfo("[LICENSE-TIMER] Timer de verificação de licença iniciado");
                }
            }
            catch (Exception ex)
            {
                App.LoggingService?.LogError("[LICENSE-TIMER] Erro ao iniciar timer", ex);
            }
        }
        
        /// <summary>
        /// Para o timer de verificação de licença
        /// </summary>
        private void StopLicenseStatusTimer()
        {
            try
            {
                if (_licenseStatusTimer != null && _licenseStatusTimer.IsEnabled)
                {
                    _licenseStatusTimer.Stop();
                    App.LoggingService?.LogInfo("[LICENSE-TIMER] Timer de verificação de licença parado");
                }
            }
            catch (Exception ex)
            {
                App.LoggingService?.LogError("[LICENSE-TIMER] Erro ao parar timer", ex);
            }
        }

        private void UpdateButtonSelectionSafe(Button? selectedButton)
        {
            // Proteção absoluta contra loops recursivos
            if (_isUpdatingSelection)
                return;
            
            // Permitir null para limpar seleo

            try
            {
                // Ativar flag de proteo
                _isUpdatingSelection = true;

                // Armazenar boto selecionado
                _currentSelectedButton = selectedButton;

                var buttons = new[] { NavDashboard, NavPerformance, NavNetwork, NavSystem, NavGamer, NavDiagnostics, NavHistory, NavScheduler, NavShield, NavRepair, NavPersonalize, NavDisplay, NavSecurity, NavPrivacy, NavDebloat, NavRecovery, NavDrivers, NavDeviceInfo, NavBenchmark, NavStreamHub, NavShortcuts };
                
                // Verificar se os brushes no so nulos antes de aplicar
                if (_primaryBrush == null || _secondaryTextBrush == null)
                {
                    _isUpdatingSelection = false;
                    return;
                }

                // Aplicar estilos e cores para indicar seleção
                foreach (var btn in buttons.Where(b => b != null))
                {
                    try
                    {
                        bool isSelected = btn == selectedButton;

                        // Aplicar estilo visual
                        if (isSelected)
                        {
                            btn.Style = (Style)Application.Current.Resources["PremiumNavButtonActiveStyle"];
                            btn.Foreground = _primaryBrush;
                            btn.FontWeight = FontWeights.SemiBold;
                        }
                        else
                        {
                            btn.Style = (Style)Application.Current.Resources["PremiumNavButtonStyle"];
                            btn.Foreground = _secondaryTextBrush;
                            btn.FontWeight = FontWeights.Medium;
                        }
                        
                        // O preenchimento (Fill) do ícone agora  controlado puramente pelo XAML (DataTriggers)
                        // para garantir que as cores originais (Azul, Roxo, Verde, etc) sejam mantidas.
                    }
                    catch
                    {
                        // Ignorar erro individual de cada boto
                        continue;
                    }
                }
            }
            catch
            {
                // Se houver erro, restaurar referência anterior
                _currentSelectedButton = null;
            }
            finally
            {
                // Sempre desativar flag de proteo
                _isUpdatingSelection = false;
            }
        }



        /// <summary>
        /// Mtodo pblico para navegao externa (chamado por outras views)
        /// </summary>
        public void NavigateToPageFromOutside(string pageName)
        {
            if (_isNavigating)
                return;

            try
            {
                _isNavigating = true;
                if (_gateLocked && pageName != "Settings")
                {
                    LockModal.Show();
                    return;
                }
                
                // Atualizar boto da sidebar se necessário
                Button? targetButton = pageName switch
                {
                    "Dashboard" => NavDashboard,
                    "Performance" => NavPerformance,
                    "Network" => NavNetwork,
                    "System" => NavSystem,
                    "Gamer" => NavGamer,
                    "History" => NavHistory,
                    "Diagnostics" => NavDiagnostics,
                    "Scheduler" => NavScheduler,
                    "Recovery" => NavRecovery,
                    "Drivers" => NavDrivers,
                    "Shield" => NavShield,
                    _ => null
                };

                if (targetButton != null)
                {
                    UpdateButtonSelectionSafe(targetButton);
                }

                NavigateToPageSafe(pageName);
            }
            finally
            {
                _isNavigating = false;
            }
        }

