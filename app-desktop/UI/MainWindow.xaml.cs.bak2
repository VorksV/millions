        /// <summary>
        /// Abre a janela de ativao de licença de forma segura e trata o resultado do bloqueio
        /// </summary>
        /// <summary>
        /// Mostra modal de compra de licença quando trial expirou ou acesso negado
        /// Implementao profissional nvel SaaS com logging detalhado
        /// </summary>
        /// <param name="reason">Motivo do bloqueio</param>
        public void ShowLicensePurchaseModal(string reason)
        {
            App.LoggingService?.LogInfo($"[MainWindow] ShowLicensePurchaseModal chamado - reason: {reason}");

            try
            {
                // Bloquear navegação adicional enquanto modal está aberto
                _isLicenseBlocked = true;
                App.LoggingService?.LogInfo("[MainWindow] Sidebar bloqueado - aguardando ativação de licença");

                // Mostrar o novo modal de compra (UserControl overlay)
                if (LicensePurchaseModalOverlay != null && LicensePurchaseModalControl != null)
                {
                    LicensePurchaseModalOverlay.Visibility = Visibility.Visible;
                    
                    // Subscrever eventos do modal
                    LicensePurchaseModalControl.HaveLicenseClicked += OnHaveLicenseClicked;
                    LicensePurchaseModalControl.Closed += OnLicensePurchaseModalClosed;
                    LicensePurchaseModalControl.PlanSelected += OnPlanSelected;
                    
                    App.LoggingService?.LogInfo("[MainWindow] Exibindo modal de compra de licença (3 planos)");
                }
            }
            catch (Exception ex)
            {
                App.LoggingService?.LogError($"[MainWindow] Erro crítico ao mostrar modal de compra de licença: {ex.Message}", ex);
            }
        }

        private void OnHaveLicenseClicked(object? sender, EventArgs e)
        {
            App.LoggingService?.LogInfo("[MainWindow] Usuário clicou em 'Já possuo uma licença' - navegando para página de ativação");
            
            // Esconder o modal de compra
            HideLicensePurchaseModal();
            
            // Navegar para a página de ativação de licença
            NavigateToPageSafe("LicenseActivationView");
        }

        private void OnPlanSelected(object? sender, EventArgs e)
        {
            App.LoggingService?.LogInfo("[MainWindow] Plano selecionado - abrindo página de compra no navegador");
            // O modal já abre o navegador, apenas fechamos o overlay
            HideLicensePurchaseModal();
        }

        private void OnLicensePurchaseModalClosed(object? sender, EventArgs e)
        {
            App.LoggingService?.LogInfo("[MainWindow] Modal de compra fechado - desbloqueando sidebar");
            HideLicensePurchaseModal();
        }

        private void HideLicensePurchaseModal()
        {
            if (LicensePurchaseModalOverlay != null)
            {
                LicensePurchaseModalOverlay.Visibility = Visibility.Collapsed;
            }
            
            if (LicensePurchaseModalControl != null)
            {
                LicensePurchaseModalControl.HaveLicenseClicked -= OnHaveLicenseClicked;
                LicensePurchaseModalControl.Closed -= OnLicensePurchaseModalClosed;
                LicensePurchaseModalControl.PlanSelected -= OnPlanSelected;
            }
            
            _isLicenseBlocked = false;
            EnableSidebar();
        }

        private void UpdateFooterPromoCardVisibility()
        {
            try
            {
                if (FooterPromoCard == null)
                    return;

                // Esconder o card quando licença PRO está ativa, mostrar caso contrário
                bool isProActive = VoltrisOptimizer.Services.License.LicenseTokenStore.IsProActive;
                
                FooterPromoCard.Visibility = isProActive ? Visibility.Collapsed : Visibility.Visible;
                
                LogToFile($"[FOOTER-PROMO] Card de marketing visibilidade atualizada: IsProActive={isProActive}, Visibility={FooterPromoCard.Visibility}");
            }
            catch (Exception ex)
            {
                LogToFile($"[FOOTER-PROMO] Erro ao atualizar visibilidade do card: {ex.Message}");
            }
        }

        private void BuyLicense_Click(object sender, RoutedEventArgs e)
        {
            try
            {
                App.LoggingService?.LogInfo("[MainWindow] BuyLicense_Click - redirecionando para pgina de compra");
                var buyUrl = VoltrisOptimizer.Services.SiteConfig.PurchaseLicenseUrl;
                System.Diagnostics.Process.Start(new System.Diagnostics.ProcessStartInfo
                {
                    FileName = buyUrl,
                    UseShellExecute = true
                });
            }
            catch (Exception ex)
            {
                App.LoggingService?.LogError($"[MainWindow] Erro ao abrir pgina de compra: {ex.Message}", ex);
            }
        }

        private void ReopenActivation_Click(object sender, RoutedEventArgs e)
        {
            NavigateToPageSafe("LicenseActivationView");
        }

        /// <summary>
        /// Inicializa a integrao com o Modo Gamer para atualizar o status na sidebar
        /// </summary>
        private async Task InitializeGamerModeIntegrationAsync()
        {
            try
            {
                LogToFile("[GamerMode] Iniciando integrao com Modo Gamer...");
                
                var serviceProvider = App.Services;
                if (serviceProvider != null)
                {
                    var (viewModel, orchestrator) = await Task.Run(() => 
                    {
                        var vm = serviceProvider.GetService(typeof(GamerViewModel)) as GamerViewModel;
                        var orch = serviceProvider.GetService(typeof(IGamerModeOrchestrator)) as IGamerModeOrchestrator;
                        return (vm, orch);
                    }).ConfigureAwait(false);

                    if (viewModel != null)
                    {
                        _gamerViewModel = viewModel;
                        _gamerViewModel.PropertyChanged += OnGamerViewModelPropertyChanged;
                        
                        Dispatcher.InvokeAsync(() => UpdateGamerModeStatus(_gamerViewModel.IsGamerModeActive));
                        LogToFile("[GamerMode] GamerViewModel vinculado com sucesso");
                    }

                    if (orchestrator != null)
                    {
                        _gamerOrchestrator = orchestrator;
                        _gamerOrchestrator.StatusChanged += OnGamerorchestratorStatusChanged;
                        LogToFile("[GamerMode] GamerModeOrchestrator vinculado com sucesso");
                    }
                }
            }
            catch (Exception ex)
            {
                LogToFile($"[GamerMode] Erro na integrao: {ex.Message}");
            }
        }
        
        /// <summary>
        /// Handler para eventos de mudana de propriedades no GamerViewModel
        /// </summary>
        private void OnGamerViewModelPropertyChanged(object? sender, System.ComponentModel.PropertyChangedEventArgs e)
        {
            if (e.PropertyName == nameof(GamerViewModel.IsGamerModeActive))
            {
                Dispatcher.BeginInvoke(() =>
                {
                    if (_gamerViewModel != null)
                    {
                        UpdateGamerModeStatus(_gamerViewModel.IsGamerModeActive);
                    }
                });
            }
        }
        
        /// <summary>
        /// Handler para eventos StatusChanged do GamerModeOrchestrator
        /// </summary>
        private void OnGamerorchestratorStatusChanged(object? sender, VoltrisOptimizer.Services.Gamer.Models.GamerModeStatus status)
        {
            Dispatcher.BeginInvoke(() =>
            {
                UpdateGamerModeStatus(status.IsActive);
            });
        }
        
        /// <summary>
        /// Atualiza o status do modo gamer na sidebar com cores apropriadas
        /// </summary>
        private void UpdateGamerModeStatus(bool isActive)
        {
            try
            {
                // Status visual removido do shell global para manter design limpo
                // O status do Modo Gamer agora reside apenas na Dashboard e na View Gamer
                LogToFile($"[GamerMode] Status atualizado internamente - Ativo: {isActive}");
            }
            catch (Exception ex)
            {
                LogToFile($"[GamerMode] Erro ao atualizar status: {ex.Message}");
            }
        }
        
        /// <summary>
        /// CORREÇÃO CRÍTICA: Limpeza de recursos ao fechar a janela
        /// </summary>
        protected override void OnClosed(EventArgs e)
        {
            try
            {
                // Remover event handlers do GlobalProgressService
                GlobalProgressService.Instance.ProgressChanged -= OnGlobalProgressChanged;
                GlobalProgressService.Instance.StatusChanged -= OnGlobalStatusChanged;
                
                // Limpar cache de views e chamar Dispose em cada uma
                foreach (var view in _viewCache.Values)
                {
                    if (view is IDisposable disposable)
                    {
                        try { disposable.Dispose(); } catch { }
                    }
                }
                _viewCache.Clear();
                
                // Limpar NotifyIcon
                if (_notifyIcon != null)
                {
                    _notifyIcon.Visible = false;
                    _notifyIcon.Dispose();
                    _notifyIcon = null;
                }
                
                // Parar timer de status
                _statusTimer?.Stop();
                
                LogToFile("[MainWindow] Recursos limpos com sucesso");
            }
            catch (Exception ex)
            {
                LogToFile($"[MainWindow] Erro ao limpar recursos: {ex.Message}");
            }
            base.OnClosed(e);
        }
        
        
        /// <summary>
        /// Aplica regio arredondada  janela via CreateRoundRectRgn (Windows 11)
        /// CORRIGIDO PARA DPI: Usa pixels fsicos em vez de lgicos
        /// </summary>
        private void ApplyRoundedRegion(IntPtr hwnd)
        {
            try
            {
                // Obter fator de escala DPI atual
                var dpi = VisualTreeHelper.GetDpi(this);
                
                // Converter pixels lgicos (WPF) para pixels fsicos (Device)
                // Usamos Floor/Ceiling para garantir que cobrimos toda a rea
                int width = (int)Math.Ceiling(ActualWidth * dpi.DpiScaleX);
                int height = (int)Math.Ceiling(ActualHeight * dpi.DpiScaleY);
                
                // Ajustar raio para DPI tambm (tamanho visual consistente)
                int cornerRadius = (int)Math.Round(16 * dpi.DpiScaleX);
                
                if (width > 0 && height > 0)
                {
                    // NÃO aplicar região se a janela estiver maximizada (evita o corte do layout em desktops grandes)
                    var placement = new Win32.WINDOWPLACEMENT();
                    placement.length = Marshal.SizeOf(typeof(Win32.WINDOWPLACEMENT));
                    Win32.GetWindowPlacement(hwnd, ref placement);
                    if (placement.showCmd == 3 /* Maximized */ || WindowState == WindowState.Maximized)
                    {
                        Win32.SetWindowRgn(hwnd, IntPtr.Zero, true);
                        return;
                    }

                    // CreateRoundRectRgn usa coordenadas fsicas
                    IntPtr rgn = Win32.CreateRoundRectRgn(0, 0, width + 1, height + 1, cornerRadius, cornerRadius);
                    Win32.SetWindowRgn(hwnd, rgn, true);
                }
            }
            catch (Exception ex)
            {
                // Log safe para debug se necessrio
                try { System.Diagnostics.Debug.WriteLine($"ApplyRoundedRegion Error: {ex.Message}"); } catch {}
            }
        }
        
        // -------------------------------------------------------------------------
        [StructLayout(LayoutKind.Sequential)]
        private struct MINMAXINFO
        {
            public Win32.POINT ptReserved;
            public Win32.POINT ptMaxSize;
            public Win32.POINT ptMaxPosition;
            public Win32.POINT ptMinTrackSize;
            public Win32.POINT ptMaxTrackSize;
        }

        private IntPtr WndProc(IntPtr hwnd, int msg, IntPtr wParam, IntPtr lParam, ref bool handled)
        {
            const int WM_SIZE = 0x0005;
            const int WM_SIZING = 0x0214;
            const int WM_EXITSIZEMOVE = 0x0232;
            const int WM_ENTERSIZEMOVE = 0x0231;
            const int WM_MOVING = 0x0216;
            const int WM_GETMINMAXINFO = 0x0024;

            // [DRAG-DIAG] Instrumentao do arasto nativo: mede intervalo entre mensagens
            // WM_MOVING (emitidas pelo sistema durante o move-loop) para provar se a janela
            // anda em tempo real no nivel do OS e onde o tempo esta sendo perdido.
            if (msg == WM_ENTERSIZEMOVE && _isDraggingTitleBar)
            {
                _dragLastMovingTick = Environment.TickCount64;
                _dragLastMovingLogTick = 0;
                LogToFile("[DRAG-DIAG] WM_ENTERSIZEMOVE - loop de movimentao nativo iniciado");
            }

            if (msg == WM_MOVING && _isDraggingTitleBar)
            {
                long now = Environment.TickCount64;
                long gap = now - _dragLastMovingTick;
                _dragLastMovingTick = now;
                if (now - _dragLastMovingLogTick >= 120)
                {
                    _dragLastMovingLogTick = now;
                    var r = System.Runtime.InteropServices.Marshal.PtrToStructure<VoltrisOptimizer.UI.Helpers.Win32WindowHelper.RECT>(lParam);
                    string mouse = "?";
                    try { VoltrisOptimizer.UI.Helpers.Win32WindowHelper.GetCursorPos(out var pt); mouse = pt.X + "," + pt.Y; } catch { }
                    LogToFile(string.Format("[DRAG-DIAG] WM_MOVING gap={0}ms rect=L{1},T{2},R{3},B{4} cursor={5}", gap, r.Left, r.Top, r.Right, r.Bottom, mouse));
                }
            }

            if (msg == WM_EXITSIZEMOVE && _isDraggingTitleBar)
            {
                VoltrisOptimizer.UI.Helpers.Win32WindowHelper.GetWindowRect(hwnd, out var rEnd);
                LogToFile(string.Format("[DRAG-DIAG] WM_EXITSIZEMOVE rectNow=L{0},T{1},R{2},B{3}", rEnd.Left, rEnd.Top, rEnd.Right, rEnd.Bottom));
            }
            
            if (msg == WM_GETMINMAXINFO)
            {
                // Corrigir maximizao para WindowStyle=None + AllowsTransparency=True
                // Sem isso, a janela ultrapassa a área de trabalho e o conteúdo fica cortado
                handled = true;
                var mmi = Marshal.PtrToStructure<MINMAXINFO>(lParam);

                var monitor = Win32.MonitorFromWindow(hwnd, 0x00000002 /* MONITOR_DEFAULTTONEAREST */);
                if (monitor != IntPtr.Zero)
                {
                    var monitorInfo = new Win32.MONITORINFO();
                    monitorInfo.cbSize = Marshal.SizeOf(typeof(Win32.MONITORINFO));
                    if (Win32.GetMonitorInfo(monitor, ref monitorInfo))
                    {
                        var workArea = monitorInfo.rcWork;
                        var monitorArea = monitorInfo.rcMonitor;

                        mmi.ptMaxPosition.X = workArea.Left - monitorArea.Left;
                        mmi.ptMaxPosition.Y = workArea.Top - monitorArea.Top;
                        mmi.ptMaxSize.X = workArea.Right - workArea.Left;
                        mmi.ptMaxSize.Y = workArea.Bottom - workArea.Top;
                        
                        // ptMaxTrackSize deve ser igual ou maior que ptMaxSize para permitir a maximização total
                        mmi.ptMaxTrackSize.X = mmi.ptMaxSize.X;
                        mmi.ptMaxTrackSize.Y = mmi.ptMaxSize.Y;

                        // Respeitar MinWidth/MinHeight em pixels fsicos
                        var dpi = VisualTreeHelper.GetDpi(this);
                        mmi.ptMinTrackSize.X = (int)(MinWidth * dpi.DpiScaleX);
                        mmi.ptMinTrackSize.Y = (int)(MinHeight * dpi.DpiScaleY);
                    }
                }

                Marshal.StructureToPtr(mmi, lParam, true);
                return IntPtr.Zero;
            }

            if (msg == WM_SIZE || msg == WM_EXITSIZEMOVE)
            {
                // Obter estado atual de forma síncrona para evitar delays do WPF
                var placement = new Win32.WINDOWPLACEMENT();
                placement.length = Marshal.SizeOf(typeof(Win32.WINDOWPLACEMENT));
                Win32.GetWindowPlacement(hwnd, ref placement);
                bool isMaximized = placement.showCmd == 3; // SW_SHOWMAXIMIZED

                // [REPARO] Sincronizar o Clip do RootContainer imediatamente usando estado Win32
                // try { UpdateClipGeometry(); } catch { }

                if (Environment.OSVersion.Version.Build >= 22000)
                {
                    Dispatcher.BeginInvoke(new Action(() =>
                    {
                        try
                        {
                            if (!isMaximized)
                                ApplyRoundedRegion(hwnd);
                            else
                                Win32.SetWindowRgn(hwnd, IntPtr.Zero, true);
                        }
                        catch { }
                    }), System.Windows.Threading.DispatcherPriority.Render);
                }
            }
            
            return IntPtr.Zero;
        }

        private async void IntelligenceHeaderButton_Click(object sender, RoutedEventArgs e)
        {
            if (_isLockedForOnboarding)
            {
                App.LoggingService?.LogWarning("[MainWindow] Clique em Inteligncia bloqueado - onboarding em andamento");
                LockModal.Show();
                return;
            }

            try
            {
                var licenseService = App.Services?.GetService(typeof(VoltrisOptimizer.Services.License.Interfaces.ILicenseService)) as VoltrisOptimizer.Services.License.Interfaces.ILicenseService;
                if (licenseService != null)
                {
                    App.LoggingService?.LogInfo("[MainWindow] Verificando acesso à Inteligência via LicenseService");
                    var checkResult = await licenseService.CheckFeatureAccessAsync("navigation", forceRefresh: false);
                    if (!checkResult.IsAllowed)
                    {
                        App.LoggingService?.LogWarning($"[MainWindow] Acesso à Inteligência BLOQUEADO: {checkResult.BlockReason}");
                        ShowLicensePurchaseModal(checkResult.BlockReason);
                        return;
                    }
                }
                
                App.LoggingService?.LogInfo("[MainWindow] Abrindo página Intelligence via header button");
                NavigateToPageSafe("Intelligence");
            }
            catch (Exception ex)
            {
                App.LoggingService?.LogError("[MainWindow] Erro ao abrir página Intelligence", ex);
                MessageBox.Show(LocalizationService.Instance["Loc_NaoFoiPossivelAbrirAPaginaIntelligence"] + ex.Message, 
                              LocalizationService.Instance.GetString("Error"), MessageBoxButton.OK, MessageBoxImage.Error);
            }
        }

