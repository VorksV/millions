            bool gamerIsPro = !ProFeatureGuard.IsPaidActive();
            var gamerMenu = new MenuItem
            {
                Header = CreateMenuHeaderWithPro(
                    isGamerActive
                        ? LocalizationService.Instance.GetString("TrayGamerModeActive")
                        : LocalizationService.Instance.GetString("TrayGamerModeInactive"),
                    gamerIsPro),
                Icon = CreateSvgIcon("M19,15H5V7H19M19,5H5A2,2 0 0,0 3,7V15A2,2 0 0,0 5,17H19A2,2 0 0,0 21,15V7A2,2 0 0,0 19,5M7,8H8V9H7V8M7,10H8V11H7V10M7,12H8V13H7V12M9,8H10V9H9V8M9,10H10V11H9V10M9,12H10V13H9V12M11,8H12V9H11V8M11,10H12V11H11V10M11,12H12V13H11V12M13,8H14V9H13V8M13,10H14V11H13V10M13,12H14V13H13V12M15,8H16V9H15V8M15,10H16V11H15V10M15,12H16V13H15V12M17,8H18V9H17V8M17,10H18V11H17V10M17,12H18V13H17V12Z", "#FF4500"),
