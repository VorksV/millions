    public partial class MainWindow : Window
    {
        private UserControl? _currentView;
        private Button? _currentSelectedButton;
        private bool _isNavigating = false;
        private bool _gateLocked = false;
        private bool _isLockedForOnboarding = false;
        private bool _isUpdatingSelection = false; // Flag para prevenir loops recursivos
        private bool _isLicenseBlocked = false;
        
        // Recursos estáticos para evitar criação excessiva
        private static SolidColorBrush? _primaryBrush;
        private static SolidColorBrush? _secondaryTextBrush;
        
        // Servios principais
        private readonly LocalizationService _localization;
        private readonly SettingsService _settings;
        private readonly ILoggingService _loggingService;
        
        private WinForms.NotifyIcon? _notifyIcon;
        private VoltrisOptimizer.UI.Controls.ModernTrayTooltip? _modernTooltip;
        private System.Windows.Threading.DispatcherTimer? _tooltipShowTimer;
        private System.Windows.Threading.DispatcherTimer? _tooltipMousePollTimer;
        private System.Drawing.Point _lastMousePos;
        private DateTime _lastMouseMoveTime = DateTime.MinValue;
        private bool _isDraggingTitleBar = false;
        private bool _titleBarPressed = false;
        private System.Windows.Point _titleBarDownPoint;
        private long _dragLastMovingTick = 0;
        private long _dragLastMovingLogTick = 0;
        private bool _dragSuspendedAcrylic = false;
        private System.Windows.Window? _dragGhost;
        private volatile bool _dragPendingProgress = false;
        private int _dragPendingProgressValue = 0;
        private volatile bool _dragPendingStatus = false;
        private string _dragPendingStatusMessage = string.Empty;
        private System.Drawing.Point _lastMousePosForDebounce;
        private DateTime _lastTooltipShowTime = DateTime.MinValue;
        private System.Drawing.Point _tooltipAnchorPos;
        private double _tooltipCurrentDpi = 1.0;
         private bool _tooltipVisible = false;
         private static readonly object _tooltipLogLock = new();
         /// <summary>Enquanto este timestamp estiver no futuro, nenhum tooltip será exibido (cooldown pós-restart do Explorer).</summary>
        private DateTime _suppressTooltipUntil = DateTime.MinValue;
        private ContextMenu? _cachedTrayMenu;
        private bool _isTrayContextMenuOpen = false;
        private DateTime _lastLeftClickTime = DateTime.MinValue;
        private bool _currentWidgetVisible = false;
        private bool _isClosing = false;
        private IntPtr _hwnd;

        /// <summary>
        /// [FIX:STARTUP-POS] Garante que a centralização de abertura aconteça UMA vez
        /// só, sobre o tamanho final. Sem esta trava, qualquer re-renderização futura
        /// poderia reposicionar uma janela que o usuário já arrastou.
        /// </summary>
        private bool _startupPositionFinalized;
        private HwndSource? _dummySource;

        /// <summary>
        /// [FIX:STARTUP-VISIBILIDADE] Decisão de visibilidade resolvida UMA vez,
        /// no construtor, e reaproveitada pelo Loaded.
        ///
        /// POR QUE ESTE CAMPO EXISTE
        /// ==========================
        /// Antes, o Loaded re-detectava "iniciar minimizado" com a mesma expressão,
        /// mas o resultado não era o mesmo que o do App — e as duas partes discordando
        /// era a causa-raiz de DOIS sintomas visíveis:
        ///
        /// 1) FLASH OPACO. O App minimiza a janela ANTES de Show(). No
        ///    SourceInitialized, o VisualEffectsManager encontra a janela Minimizada
        ///    e adia o acrylic (a API do DWM precisa de geometria válida). O Loaded
        ///    então forçava WindowState=Normal e chamava Show() de novo. Resultado:
        ///    a janela aparecia com o fundo sólido opaco e só recebia acrylic
        ///    ~590 ms depois, já depois do primeiro quadro. Medido no log:
        ///
        ///        03:44:30.678  Background <- #1E1E2E sólido
        ///        03:44:30.683  Acrylic adiado (janela Minimized)
        ///        03:44:31.137  PRIMEIRO PAINT (fundo ainda sólido)
        ///        03:44:31.199  Acrylic realmente aplicado
        ///
        /// 2) JANELA DESCENTRALIZADA. Pelo mesmo motivo, GetWindowRect devolvia
        ///    geometria inválida no SourceInitialized e a centralização só
        ///    acontecia no OnContentRendered — DEPOIS do primeiro paint. O log
        ///    mostra "Centralização adiada" às 30.687 e "Centralização final" às
        ///    31.153, com o paint em 31.137 no meio.
        ///
        /// Se a decisão é a mesma nos dois lados, a janela nunca fica Minimizada
        /// enquanto está sendo apresentada, e acrylic + centralização acontecem no
        /// SourceInitialized, ou seja ANTES do primeiro pixel.
        /// </summary>
        private bool _startMinimizedRequested;
        
        private IGamerModeOrchestrator? _gamerOrchestrator;
        private GamerViewModel? _gamerViewModel;
        
        // CONTROLE DE ESTADO PARA PREVENIR DUPLICAES
        private static int _initializationStarted = 0;
        private static int _initializationCompleted = 0;
        private int _continueNormalFlowExecutionState = 0;
        private int _applicationStateInitialized = 0;
        
        // Timer de status para o footer
        private readonly System.Windows.Threading.DispatcherTimer _statusTimer;
        
        // Timer para verificação peridica do status do trial
        private readonly System.Windows.Threading.DispatcherTimer _licenseStatusTimer;
        
        // CancellationToken para loops de background (polling, etc.)
        private bool _isAppActive = true;
        public bool IsAppActive
        {
            get => _isAppActive;
            set
            {
                if (_isAppActive != value)
                {
                    _isAppActive = value;
                    LogToFile($"[Main] State changed: IsAppActive={value}");
                    UpdateAllViewModelsActiveState();
                }
            }
        }

        // Dependency Properties for footer
        public static readonly DependencyProperty IsCancelButtonVisibleProperty =
            DependencyProperty.Register(nameof(IsCancelButtonVisible), typeof(bool), typeof(MainWindow), new PropertyMetadata(false));
        public bool IsCancelButtonVisible
        {
            get => (bool)GetValue(IsCancelButtonVisibleProperty);
            set => SetValue(IsCancelButtonVisibleProperty, value);
        }

        public static readonly DependencyProperty HasQueuedItemsProperty =
            DependencyProperty.Register(nameof(HasQueuedItems), typeof(bool), typeof(MainWindow), new PropertyMetadata(false));
        public bool HasQueuedItems
        {
            get => (bool)GetValue(HasQueuedItemsProperty);
            set => SetValue(HasQueuedItemsProperty, value);
        }

        public static readonly DependencyProperty QueueStatusTextProperty =
            DependencyProperty.Register(nameof(QueueStatusText), typeof(string), typeof(MainWindow), new PropertyMetadata(""));
        public string QueueStatusText
        {
            get => (string)GetValue(QueueStatusTextProperty);
            set => SetValue(QueueStatusTextProperty, value);
        }

        // Estado do Sidebar: controla o modo rail (ícones apenas) via DataTriggers no XAML
        public static readonly DependencyProperty IsSidebarExpandedProperty =
            DependencyProperty.Register(nameof(IsSidebarExpanded), typeof(bool), typeof(MainWindow), new PropertyMetadata(true));
        public bool IsSidebarExpanded
        {
            get => (bool)GetValue(IsSidebarExpandedProperty);
            set => SetValue(IsSidebarExpandedProperty, value);
        }

        // Controle de colapso automático responsivo
        private const double SideNavCollapseWidthThreshold = 780;
        private const double SideNavExpandedWidthBounds = 240;
        private const double SideNavRailWidthBounds = 56;
        private bool _sidebarStateInitialized = false;
        private bool _sidebarAutoCollapsed = false;
        private bool _sidebarUserOverride = false;

        private void UpdateAllViewModelsActiveState()
        {
            try
            {
                // Atualizar o ViewModel da pgina ATUAL
                if (_currentView?.DataContext is ViewModelBase vm)
                {
                    vm.IsActive = _isAppActive;
                }
            }
            catch (Exception ex)
            {
                LogToFile($"Erro ao atualizar estado dos ViewModels: {ex.Message}");
            }
        }

        private readonly CancellationTokenSource _backgroundCts = new();

        private Dictionary<string, UserControl> _viewCache = new Dictionary<string, UserControl>();

public MainWindow()
        {
            // [LOG] MainWindow constructor entry
            var tid = Thread.CurrentThread.ManagedThreadId;
            VoltrisOptimizer.Helpers.StartupStepTracker.Instance?.Begin("MAINWINDOW_CTOR_BEGIN", $"TID={tid}");
            LogToFile($"[MAINWINDOW][TID:{tid}] Construtor INICIO");
            
            // OTIMIZAÇÃO CRÍTICA: Forçar renderização básica antes de InitializeComponent()
            // Isso previne que o DWM trave tentando composicionar efeitos complexos de uma vez
            System.Windows.Media.RenderOptions.ProcessRenderMode = System.Windows.Interop.RenderMode.Default;
            
            InitializeComponent();
            
            // [FIX:STARTUP-POS] TAMANHO DETERMINÍSTICO ANTES DO PRIMEIRO Show().
            //
            // BUG ORIGINAL (janela abria deslocada para a direita):
            //   O XAML usava WindowStartupLocation="CenterScreen" com
            //   SizeToContent="Manual" e SEM Width/Height declarados. Nesse
            //   regime o WPF deriva o tamanho inicial do DesiredSize do
            //   conteúdo — e, no primeiro passo de layout, esse DesiredSize
            //   ainda está incompleto: boa parte dos DynamicResource e dos
            //   bindings de LocalizationService do MainWindow.xaml (64 KB de
            //   XAML) ainda não resolveu valor. A janela era medida com um
            //   tamanho minúsculo (≈159x27), o centro era calculado sobre
            //   esse tamanho errado, e o layout seguinte a fazia crescer para
            //   o tamanho real (≈1152x628) SEM recalcular o centro.
            //
            //   Resultado: Left calculada para uma janela de 159 px de largura
            //   numa tela de 1920 (≈880) e mantida quando a janela real passou
            //   a ter 1152 px — a janela abria escorregada para a direita e
            //   para fora da tela. É exatamente o sintoma relatado.
            //
            // CORREÇÃO: declarar o tamanho de design no XAML (feito) e aqui
            // apenas limitá-lo à área de trabalho do monitor atual, para que
            // telas pequenas (1366x768, 1280x720 com barra de tarefas) ainda
            //recebam uma janela que cabe. Com Width/Height finitos desde o
            //   início, a centralização passa a ser exata já no primeiro quadro.
                WindowPlacementHelper.FitToWorkArea(this, 1152, 720);
            LogToFile($"[MAINWINDOW][TID:{tid}] Tamanho inicial definido: {Width}x{Height}");

            // [FIX:STARTUP-POS] Centraliza AQUI, antes do primeiro Show().
            //
            // Por que era preciso: o XAML declara WindowStartupLocation="Manual" sem
            // Left/Top, então o primeiro quadro nascia no canto/cascata padrão do
            // Windows e só depois saltava para o centro — quando o OnSourceInitialized
            // centralizava, ou, se ele falhasse, só no OnContentRendered (depois do
            // paint). O usuário via a janela nascer torta e se corrigir.
            //
            // Aqui ainda não existe HWND, então só o caminho gerenciado é possível
            // (Left/Top em DIPs), o que é suficiente e é o que qualquer programa
            // faz para se posicionar antes de aparecer. O caminho preciso por
            // monitor continua existindo no OnSourceInitialized/OnContentRendered,
            // que refinam esta posição para o monitor real sem-animation.
            try
            {
                if (WindowPlacementHelper.TryCenterBeforeShow(this))
                {
                    LogToFile($"[MAINWINDOW][TID:{tid}] Posição inicial centralizada: " +
                              $"Left={Left:F0} Top={Top:F0} " +
                              $"(work {SystemParameters.WorkArea.Width:F0}x{SystemParameters.WorkArea.Height:F0})");
                }
                else
                {
                    LogToFile($"[MAINWINDOW][TID:{tid}] Centralização pré-Show indisponível.");
                }
            }
            catch (Exception ex)
            {
                LogToFile($"[MAINWINDOW][TID:{tid}] Falha ao centralizar antes do Show: {ex.Message}");
            }
            
            // Se for Windows 10, forçar o design a ser 100% quadrado para evitar cantos transparentes
            if (!RoundedWindowHelper.IsWindows11)
            {
                MainBorder.CornerRadius = new CornerRadius(0);
                BackgroundBorder.CornerRadius = new CornerRadius(0);
                // ClipGeometry.RadiusX = 0;
                // ClipGeometry.RadiusY = 0;
            }
            else
            {
                // ADIAR aplicação de bordas arredondadas para após renderização inicial
                Dispatcher.BeginInvoke(() => RoundedWindowHelper.Apply(this, 16), 
                    System.Windows.Threading.DispatcherPriority.Background);
            }
            
            // [LOG] After InitializeComponent
            LogToFile($"[MAINWINDOW][TID:{tid}] InitializeComponent() concluído");
            
            // OTIMIZAÇÃO: Carregar serviços básicos primeiro, resto em background
            _localization = LocalizationService.Instance;
            _settings = SettingsService.Instance;
            LogToFile($"[MAINWINDOW][TID:{tid}] Serviços básicos inicializados");

            // ADIAR conexões de eventos não-críticos para após a janela estar visível
            Dispatcher.BeginInvoke(() => {
                GlobalProgressService.Instance.ProgressChanged += OnGlobalProgressChanged;
                GlobalProgressService.Instance.StatusChanged += OnGlobalStatusChanged;
                ProgressTrackingService.Instance.ProgressUpdated += OnHierarchicalProgressUpdated;
                ProgressTrackingService.Instance.OperationCompleted += OnHierarchicalOperationCompleted;
            }, System.Windows.Threading.DispatcherPriority.Background);
            
            // Carregar idioma em background (não bloqueia UI)
            Task.Run(() => _localization.SetLanguage(_settings.Settings.Language));
            
            // ADIAR carregamento de recursos estáticos para após renderização
            Dispatcher.BeginInvoke(() => {
                try {
                    _primaryBrush = (SolidColorBrush)Application.Current.Resources["PrimaryBrush"];
                    _secondaryTextBrush = (SolidColorBrush)Application.Current.Resources["TextSecondaryBrush"];
                } catch { }
            }, System.Windows.Threading.DispatcherPriority.Background);
            
            // [FIX:STARTUP-VISIBILIDADE] Decisão de visibilidade resolvida UMA vez.
            //
            // O bug anterior: `!args.Any()` nunca era verdadeiro. GetCommandLineArgs()
            // SEMPRE devolve ao menos o caminho do executável, então `args.Any()` é
            // sempre true e o segundo operando da condição morria. Na prática isso
            // fazia `startMinimized` valer false SEMPRE, mesmo com a configuração
            // ligada — e o App, que resolve a mesma condição corretamente, minimiza
            // a janela. As duas decisões divergiam e o Loaded desfaizia o estado do
            // App (WindowState=Normal + um segundo Show()).
            //
            // `args.Skip(1)` descarta o executável e olha só os argumentos reais.
            var args = Environment.GetCommandLineArgs().Skip(1).ToArray();
            bool cliRequestsMinimized = args.Any(arg =>
                            arg.Equals("/minimized", StringComparison.OrdinalIgnoreCase) ||
                            arg.Equals("-minimized", StringComparison.OrdinalIgnoreCase) ||
                            arg.Equals("--minimized", StringComparison.OrdinalIgnoreCase));

            // Mesma decisão do App.xaml.cs, com os mesmos critérios.
            //
            // Aqui antes estava
            //     StartMinimized && StartWithWindows
            // o que não é a mesma coisa que o App decide — e é exatamente essa
            // divergência que fazia a janela ser apresentada Minimizada, o que
            // adiava o acrylic e a centralização para depois do primeiro paint.
            //
            // Origem da execução, agora idêntica nos dois lados:
            //
            //   · --autostart  -> bandeja (o Windows iniciou)
            //   · --minimized  -> bandeja (pedido explícito)
            //   · sem flags     -> janela visível, a não ser que o usuário tenha
            //     marcado "Iniciar minimizado"
            bool isWindowsAutoStart = StartupAutostartDetector.HasAutostartFlag();
            bool userWantsMinimized = _settings.Settings.StartMinimized;

            _startMinimizedRequested = cliRequestsMinimized
                                       || isWindowsAutoStart
                                       || userWantsMinimized;

            LogToFile($"[MAINWINDOW][TID:{tid}] Visibilidade de abertura: " +
                      $"minimized={_startMinimizedRequested} " +
                      $"(cli={cliRequestsMinimized}, autoStartWindows={isWindowsAutoStart}, " +
                      $"cfgStartMinimized={userWantsMinimized})");

            // SUPPRESS TOOLTIP AT STARTUP:
            _suppressTooltipUntil = DateTime.Now.AddSeconds(5);
            
            // Capture WindowState and ShowInTaskbar on the UI thread to prevent cross-thread access exceptions.
            var cachedWindowState = WindowState;
            var cachedShowInTaskbar = ShowInTaskbar;

            // Logar inicializao (Async/Fire-and-forget para no bloquear UI Thread)
            Task.Run(() =>
            {
                try
                {
                    var mtid = Thread.CurrentThread.ManagedThreadId;
                    var logDir = LogDirectoryResolver.Resolve();
                    if (!System.IO.Directory.Exists(logDir))
                        System.IO.Directory.CreateDirectory(logDir);
                    var logFile = System.IO.Path.Combine(logDir, "startup_execution.log");
                    System.IO.File.AppendAllText(logFile, 
                        $"[{DateTime.Now:yyyy-MM-dd HH:mm:ss.fff}][TID:{mtid}] ===== MAINWINDOW CONSTRUTOR =====\n" +
                        $"  Argumentos: {string.Join(" ", args)}\n" +
                        $"  StartMinimized (arg): {cliRequestsMinimized}\n" +
                        $"  StartMinimized (config): {_settings.Settings.StartMinimized}\n" +
                        $"  StartWithWindows (config): {_settings.Settings.StartWithWindows}\n" +
                        $"  DECISAO FINAL (_startMinimizedRequested): {_startMinimizedRequested}\n" +
                        $"  ProcessPath: {System.Environment.ProcessPath ?? "N/A"}\n" +
                        $"  BaseDirectory: {AppDomain.CurrentDomain.BaseDirectory}\n" +
                        $"  WindowState: {cachedWindowState}\n" +
                        $"  ShowInTaskbar: {cachedShowInTaskbar}\n" +
                        $"===== FIM MAINWINDOW CONSTRUTOR =====\n\n");
                }
                catch { }
            });
            
            LogToFile($"[MAINWINDOW][TID:{tid}] Iniciando InitializeNotifyIconAsync()...");
            _ = InitializeNotifyIconAsync();
            Dispatcher.InvokeAsync(() => UpdateLocalizedTexts(), System.Windows.Threading.DispatcherPriority.Background);
            Dispatcher.BeginInvoke(() => ApplyInitialSidebarState(), System.Windows.Threading.DispatcherPriority.Loaded);

            // PRÉ-RESOLUÇÃO: Iniciar WidgetManagerService em background para reduzir gap SERVICES→WIDGET
            Task.Run(() => { var _ = App.WidgetManager; });
            
            // Inicializar timer de status (5 segundos de exibio)
            _statusTimer = new System.Windows.Threading.DispatcherTimer
            {
                Interval = TimeSpan.FromSeconds(5)
            };
            _statusTimer.Tick += (s, e) => 
            {
                _statusTimer.Stop();

                // [FIX:END-STATE] A BARRA TAMBÉM PRECISA ZERAR.
                //
                // Este timer escondia só o TEXTO. Com a correção que mantém a
                // confirmação de sucesso na tela, a barra em 100% ficava presa
                // para sempre no rodapé depois de cada otimização: o texto
                // sumia em 5s, a barra não sumia nunca.
                //
                // A CONDIÇÃO É SÓ O FLAG, e não "existe operação no
                // GlobalProgressService". Esse era o segundo bug do mesmo
                // sintoma: o botão circular abre uma operação em
                // GlobalProgressService ("MasterDeepClean") e nunca a fecha, de
                // modo que IsOperationRunning ficava true para sempre — e um
                // teste por esse serviço travava o reset aqui para sempre.
                //
                // O flag é mais confiável porque o timer SÓ é armado na emissão
                // terminal, e qualquer emissão NÃO terminal posterior (ou seja,
                // uma operação nova começando) o zera antes disso. Se o timer
                // disparou, foi por uma conclusão — logo, é seguro zerar.
                bool deveZerar = _lastProgressWasTerminal;

                App.LoggingService?.LogInfo(
                    $"[FOOTER-END] Auto-ocultar disparou | _lastProgressWasTerminal={_lastProgressWasTerminal} " +
                    $"| deveZerarBarra={deveZerar}");

                if (deveZerar)
                {
                    _lastProgressWasTerminal = false;
                    UpdateProgress(0);
                }

                UpdateStatus(string.Empty);
            };
            
            // Inicializar timer de verificação de licença (verifica a cada 5 minutos)
            // 30s era excessivo  causa requisio HTTP + I/O de disco desnecessários
            _licenseStatusTimer = new System.Windows.Threading.DispatcherTimer
            {
                Interval = TimeSpan.FromMinutes(5)
            };
            _licenseStatusTimer.Tick += LicenseStatusTimer_Tick;
            
            // Inicializar evento de mudana de idioma
            _localization.LanguageChanged += (s, e) => UpdateLocalizedTexts();

            // Sincronizar status da licença globalmente e aplicar bloqueios se necessário
            VoltrisOptimizer.Services.LicenseManager.Instance.LicenseStatusChanged += (s, e) => {
                Dispatcher.BeginInvoke(new Action(() => CheckLicenseStatus()), System.Windows.Threading.DispatcherPriority.Background);
            };
            
            // NOVO: Subscribe ao evento StateChanged do LicenseOrchestrationService para atualizar card do footer
            try
            {
                LicenseOrchestrationService.Instance.StateChanged += (s, e) => {
                    Dispatcher.BeginInvoke(new Action(() => UpdateFooterPromoCardVisibility()), System.Windows.Threading.DispatcherPriority.Normal);
                };
            }
            catch (Exception ex)
            {
                LogToFile($"[LICENSE-SUBSCRIPTION] Erro ao subscribir a StateChanged: {ex.Message}");
            }
            
            // Iniciar timer de verificação peridica do status do trial
            StartLicenseStatusTimer();
            
            // Atualizar verso
            UpdateVersionInfo();

            // OTIMIZAÇÃO PERFORMANCE: Monitorar visibilidade para pausar serviços
            this.StateChanged += MainWindow_StateChanged; // Track window state changes
            ApplicationStateTracker.UpdateWindowState(this.WindowState);
            this.IsVisibleChanged += MainWindow_IsVisibleChanged;
            this.Activated += (s, e) => { if (this.WindowState != WindowState.Minimized && this.IsVisible) { IsAppActive = true; ApplicationStateTracker.UpdateWindowActivated(true); } };
            this.Deactivated += (s, e) => { ApplicationStateTracker.UpdateWindowActivated(false); };

            VoltrisOptimizer.Helpers.StartupStepTracker.Instance?.End("MAINWINDOW_CTOR_BEGIN");

            Loaded += async (s, e) =>
            {
                // [LOG] Loaded event entry
                var ltid = Thread.CurrentThread.ManagedThreadId;
                LogToFile($"[MAINWINDOW][TID:{ltid}] Evento Loaded INCIO");

                LogToFile($"[MAINWINDOW][TID:{ltid}] ===== EVENTO LOADED =====\n" +
                         $"  WindowState ANTES: {WindowState}\n" +
                         $"  ShowInTaskbar ANTES: {ShowInTaskbar}\n" +
                         $"  Visibility ANTES: {Visibility}\n" +
                         $"  startMinimized resolvido: {_startMinimizedRequested}\n");

                // Marcar que a janela foi totalmente carregada
                _isWindowFullyLoaded = true;
                LogToFile($"[MAINWINDOW][TID:{ltid}] _isWindowFullyLoaded = true");

                // Garantir que o sidebar comea sempre no topo (PRINCIPAL visvel)
                SidebarScrollViewer?.ScrollToTop();

                if (_startMinimizedRequested)
                {
                    LogToFile($"[MAINWINDOW][TID:{ltid}] INICIANDO MINIMIZADO (decisão do construtor)");

                    // Garantir que o handle foi criado
                    if (_hwnd == IntPtr.Zero)
                    {
                        _hwnd = new WindowInteropHelper(this).Handle;
                    }

                    // Esconder para a bandeja
                    HideToTray();

                    // Notificar usuário silenciosamente via log
                    LogToFile($"[MAINWINDOW][TID:{ltid}] Aplicativo iniciado na bandeja do sistema.");
                }
                else
                {
                    // INICIAR NORMAL
                    LogToFile($"[MAINWINDOW][TID:{ltid}] INICIANDO NORMAL (decisão do construtor)");

                    // [FIX:STARTUP-VISIBILIDADE] O App já chamou Show() antes deste
                    // evento, e por isso a janela JÁ está visível e em WindowState
                    // Normal neste ponto. Forçar Normal e chamar Show() uma segunda
                    // vez era o que produzia o acrylic adiado: o Show() do App
                    // acontece com a janela Minimizada, o VisualEffectsManager
                    // adia o acrylic por falta de geometria, e só este bloco
                    // devolvia a janela ao estado visível — tarde demais, depois
                    // do primeiro paint.
                    //
                    // Agora a decisão vem do construtor e é a mesma do App, então a
                    // janela nunca é apresentada Minimizada. O acrylic e a
                    // centralização acontecem no SourceInitialized, antes do
                    // primeiro pixel.
                    if (WindowState == WindowState.Minimized)
                    {
                        WindowState = WindowState.Normal;
                        LogToFile($"[MAINWINDOW][TID:{ltid}] Estado normalizado antes de exibir");
                    }

                    ShowInTaskbar = true;
                    Visibility = Visibility.Visible;
                    Topmost = false;

                    // Show() só é necessário se a janela ainda não estiver visível.
                    // Chamar de novo numa janela já apresentada é redundante e
                    // dispara trabalho de layout sem necessidade.
                    if (!IsVisible)
                    {
                        Show();
                    }
                    Activate();
                }
                
                LogToFile($"[MAINWINDOW][TID:{ltid}] ===== EVENTO LOADED FINALIZADO =====\n" +
                         $"  WindowState DEPOIS: {WindowState}\n" +
                         $"  ShowInTaskbar DEPOIS: {ShowInTaskbar}\n" +
                         $"  Visibility DEPOIS: {Visibility}\n");
                
                // CRÍTICO: Aguardar janela estar totalmente renderizada antes de carregar serviços pesados
                await Task.Delay(100);
                
                // 1. Serviços leves primeiro (prioridade alta)
                Dispatcher.BeginInvoke(() => {
                    SidebarScrollViewer?.ScrollToTop();
                    UpdateVersionInfo();
                }, System.Windows.Threading.DispatcherPriority.Background);
                
                // 2. Serviços médios em background (prioridade normal)
                Task.Run(async () => {
                    await Task.Delay(200);
                    
                    Dispatcher.BeginInvoke(async () => {
                        // GamerMode em background
                        _ = InitializeGamerModeIntegrationAsync();
                        
                        // Widget Manager com delay
                        await Task.Delay(300);
                        
                        try {
                            var wManager = App.WidgetManager;
                            if (wManager != null) {
                                wManager.VisibilityChanged += (isVisible) => Dispatcher.BeginInvoke(() => {
                                    UpdateWidgetToggleIcon(isVisible);
                                    _currentWidgetVisible = isVisible;
                                    UpdateSystrayTooltip();
                                }, System.Windows.Threading.DispatcherPriority.Normal);
                                
                                bool initialVisible = wManager.IsWidgetVisible;
                                Dispatcher.BeginInvoke(() => {
                                    _currentWidgetVisible = initialVisible;
                                    UpdateWidgetToggleIcon(initialVisible);
                                }, System.Windows.Threading.DispatcherPriority.Normal);
                            }
                        } catch { }
                        
                        // 3. Efeitos decorativos por último
                        await LoadDecorativeEffectsAsync();
                    }, System.Windows.Threading.DispatcherPriority.Normal);
                });
                
                // 4. Fluxo de boot e navegação (não bloqueia UI)
                MainWindow_Loaded_Gate(s, e);
            };
            
            // === WINDOWS 11: Re-aplicar WPF Clip APÓS primeira renderização completa ===
            this.ContentRendered += (s, e) =>
            {
                LogToFile($"[CONTENT-RENDERED] ✅ Primeira renderização completa | Size={this.ActualWidth}x{this.ActualHeight}");
                
                // Windows 11: Re-aplicar apenas WPF Clip com tamanho REAL
                if (this.ActualWidth > 0 && this.ActualHeight > 0 && Environment.OSVersion.Version.Build >= 22000)
                {
                    LogToFile($"[CONTENT-RENDERED] Windows 11: Re-aplicando WPF Clip com tamanho real...");
                    VoltrisOptimizer.Helpers.RoundedWindowHelper.ForceApply(this, 16);
                }
                else
                {
                    LogToFile($"[CONTENT-RENDERED] ⚠️ Size inválido ou Windows 10: {this.ActualWidth}x{this.ActualHeight}");
                }
            };
            LogToFile($"[MainWindow] Handler ContentRendered registrado");
        }

        private void MainWindow_StateChanged(object sender, EventArgs e)
        {
            bool isMinimized = this.WindowState == WindowState.Minimized;
            IsAppActive = !isMinimized && this.IsVisible;

            // Atualizar rastreador de estado da aplicação
            ApplicationStateTracker.UpdateWindowState(this.WindowState);
            ApplicationStateTracker.UpdateWindowActivated(IsAppActive);

            if (isMinimized)
            {
                // Reduzir polling do Tooltip / Sensores quando minimizado para economizar CPU
                _tooltipShowTimer?.Stop();
                HideModernTooltip();
            }

            LogToFile($"[MAXIMIZE-DEBUG] StateChanged: CurrentState={this.WindowState}, ActualSize={this.ActualWidth}x{this.ActualHeight}");

            if (this.WindowState == WindowState.Maximized)
            {
                LogToFile($"[MAXIMIZE-DEBUG] Aplicando lgica definitiva de Maximizado...");

                // NOTA: Não forçamos Width/Height = NaN aqui pois o WPF lida com isso.
                // Resetamos apenas no RootContainer para garantir que ele se expanda.
                if (RootContainer != null)
                {
                    RootContainer.Width = double.NaN;
                    RootContainer.Height = double.NaN;

                    // CORREO DEFINITIVA: Remover o Grid.Clip e Resetar Margens IMEDIATAMENTE
                    RootContainer.Clip = null;
                    RootContainer.Margin = new Thickness(0);
                }

                // Redefinir regies Win32 (limpar clipping de bordas arredondadas)
                IntPtr hwnd = new System.Windows.Interop.WindowInteropHelper(this).Handle;
                if (hwnd != IntPtr.Zero)
                {
                    Win32.SetWindowRgn(hwnd, IntPtr.Zero, true);
                }

                // Ajustar bordas para modo full-screen (remover arredondamento e sombras)
                UpdateWindowChromeForMaximizedState();

                // FORAR ATUALIZAO DE LAYOUT IMEDIATA
                this.InvalidateMeasure();
                this.InvalidateArrange();
                this.UpdateLayout();

                // Agendar verificação ps-renderizao para garantir que nenhum resqucio de clip ficou
                Dispatcher.BeginInvoke(new Action(() =>
                {
                    if (this.WindowState == WindowState.Maximized)
                    {
                        if (RootContainer != null) RootContainer.Clip = null;
                        this.Clip = null;
                        this.InvalidateVisual();
                        LogToFile($"[MAXIMIZE-DEBUG] PS-MAXIMIZE: Layout Finalizado - RootContainer={RootContainer?.ActualWidth}x{RootContainer?.ActualHeight}");
                    }
                }), System.Windows.Threading.DispatcherPriority.Loaded);
            }
            else if (this.WindowState == WindowState.Normal)
            {
                LogToFile($"[MAXIMIZE-DEBUG] Aplicando lgica de Normalizado...");

                // Restaurar Chrome e Clipping de modo Normal
                UpdateWindowChromeForNormalState();

                // Re-habilitar clip geometry (arredondamento via WPF)
                // UpdateClipGeometry();

                // Aplicar regio arredondada apenas no Windows 11
                var hwnd = new System.Windows.Interop.WindowInteropHelper(this).Handle;
                if (hwnd != IntPtr.Zero && Environment.OSVersion.Version.Build >= 22000)
                {
                    ApplyRoundedRegion(hwnd);
                }
            }

            // Lgica de Minimizao (Sincronizada com o ORIGINAL)
            if (isMinimized && _settings.Settings.MinimizeToTray && _isWindowFullyLoaded)
            {
                // Só vai para o tray se o usuário clicou no botão minimizar do app (ou via TitleBar personalizado)
                // OBS: No nosso caso, o botão de título define _userInitiatedMinimize.
                if (typeof(MainWindow).GetField("_userInitiatedMinimize", System.Reflection.BindingFlags.NonPublic | System.Reflection.BindingFlags.Instance)?.GetValue(this) as bool? == true)
                {
                    LogToFile("[MAXIMIZE-DEBUG] Minimização manual  Escondendo para tray");
                    // Resetar flag via Reflection ou método se acessível
                    typeof(MainWindow).GetField("_userInitiatedMinimize", System.Reflection.BindingFlags.NonPublic | System.Reflection.BindingFlags.Instance)?.SetValue(this, false);
                    HideToTray();
                }
            }
        }

        private void UpdateWindowChromeForMaximizedState()
        {
            if (MainBorder != null)
            {
                MainBorder.CornerRadius = new CornerRadius(0);
                MainBorder.Effect = null;
                MainBorder.BorderThickness = new Thickness(0);
            }
            if (BackgroundBorder != null) BackgroundBorder.CornerRadius = new CornerRadius(0);
            if (TitleBarBorder != null) TitleBarBorder.CornerRadius = new CornerRadius(0);
            if (ContentClipBorder != null) ContentClipBorder.CornerRadius = new CornerRadius(0);
            if (BottomBarBorder != null) BottomBarBorder.CornerRadius = new CornerRadius(0);
            // Desabilitar handles de resize quando maximizado
            if (ResizeHandleGrid != null) { ResizeHandleGrid.IsHitTestVisible = false; ResizeHandleGrid.Visibility = Visibility.Collapsed; }
        }

        private void UpdateWindowChromeForNormalState()
        {
            bool isWin11 = Environment.OSVersion.Version.Build >= 22000;
            int radius = isWin11 ? 16 : 0;

            if (MainBorder != null)
            {
                MainBorder.CornerRadius = new CornerRadius(radius);
                if (isWin11)
                {
                    MainBorder.Effect = new System.Windows.Media.Effects.DropShadowEffect
                    {
                        BlurRadius = 15,
                        ShadowDepth = 0,
                        Opacity = 0.4,
                        Color = System.Windows.Media.Colors.Black
                    };
                    MainBorder.BorderThickness = new Thickness(1);
                }
                else
                {
                    MainBorder.Effect = null;
                    MainBorder.BorderThickness = new Thickness(0);
                }
            }
            if (BackgroundBorder != null) BackgroundBorder.CornerRadius = new CornerRadius(radius);
            if (TitleBarBorder != null) TitleBarBorder.CornerRadius = new CornerRadius(radius, radius, 0, 0);
            if (ContentClipBorder != null) ContentClipBorder.CornerRadius = new CornerRadius(radius);
            if (BottomBarBorder != null) BottomBarBorder.CornerRadius = new CornerRadius(0, 0, radius, radius);
            // Reativar handles de resize quando restaurado
            if (ResizeHandleGrid != null) { ResizeHandleGrid.IsHitTestVisible = true; ResizeHandleGrid.Visibility = Visibility.Visible; }
        }

        private void MainWindow_IsVisibleChanged(object sender, DependencyPropertyChangedEventArgs e)
        {
            bool isVisible = (bool)e.NewValue;
            IsAppActive = isVisible && this.WindowState != WindowState.Minimized;
            // Atualizar rastreador de visibilidade da janela
            ApplicationStateTracker.UpdateWindowVisibility(isVisible);
            LogToFile($"[Main] IsVisible={isVisible}, IsAppActive={IsAppActive}");
        }

        private void InitializeNavigation()
        {
            try
            {
                // Iniciar navegando para o dashboard (isso já cuida da seleção visual)
                Dispatcher.InvokeAsync(async () => { await System.Threading.Tasks.Task.Delay(200); NavigateToDashboard(); }, System.Windows.Threading.DispatcherPriority.ApplicationIdle);
            }
            catch (Exception ex)
            {
                LogToFile($"Erro ao inicializar navegao: {ex.Message}");
            }
        }

        private async void MainWindow_Loaded_Gate(object sender, RoutedEventArgs e)
        {
            LogToFile("===== MainWindow_Loaded_Gate INICIADO =====");
            
            if (Interlocked.Exchange(ref _initializationStarted, 1) != 0)
            {
                LogToFile("[BOOT] MainWindow_Loaded_Gate ignorado: inicialização já iniciada.");
                return;
            }
            
            // ?? FORENSE: Iniciar monitoramento de freezes na UI thread
            try
            {
                var forensics = new VoltrisOptimizer.Helpers.StartupFreezeForensics(App.LoggingService);
                forensics.Start();
                forensics.MarkMainWindowLoaded();
                LogToFile("[FORENSICS] StartupFreezeForensics ativado.");
            }
            catch (Exception fex)
            {
                LogToFile($"[FORENSICS] Falha ao iniciar forense: {fex.Message}");
            }
            
            var args = Environment.GetCommandLineArgs();
            var startedMinimized = args.Any(arg => arg.Equals("/minimized", StringComparison.OrdinalIgnoreCase) || 
                                                 arg.Equals("-minimized", StringComparison.OrdinalIgnoreCase));

            if (!startedMinimized)
            {
                if (Visibility != Visibility.Visible)
                {
                    Visibility = Visibility.Visible;
                    Show();
                }
                
                if (!ShowInTaskbar) ShowInTaskbar = true;
            }

            // INICIAR SEQUÊNCIA DE BOOT ESTRUTURADA
            await BootSequenceAsync();
        }

        /// <summary>
        /// Sequência de boot profissional e sequencial para evitar thread contention e freezes.
        /// </summary>
        private async Task BootSequenceAsync()
        {
            await Task.Run(async () =>
            {
                LogToFile("[BOOT] ===== INÍCIO DA SEQUÊNCIA DE BOOT =====");
                VoltrisDiagnosticSystem.Instance.Timeline("BOOT", "BootSequenceAsync iniciado");

                var forensics = VoltrisOptimizer.Helpers.StartupFreezeForensics.Instance;
                
                var locBoot = LocalizationService.Instance;
                var bootToken = GlobalProgressService.Instance.BeginOperation(locBoot.GetString("BootInitializing"), true);
                LogToFile($"[BOOT] Token de progresso iniciado: '{locBoot.GetString("BootInitializing")}'");

                VoltrisDiagnosticSystem.Instance.Timeline("LICENSE", "Restauração de licença iniciada em background");

                var licenseTask = Task.Run(async () => {
                    LogToFile("[BOOT-BG] Iniciando restauração de licença em background...");
                    try {
                        LicenseTokenStore.TryRestoreFromRegistry();
                        LogToFile("[BOOT-BG] LicenseTokenStore.TryRestoreFromRegistry concluído.");

                        using var cts = new CancellationTokenSource(TimeSpan.FromSeconds(15));
                        await LicenseOrchestrationService.Instance.GetCurrentStateAsync(cts.Token).ConfigureAwait(false);
                        LogToFile("[BOOT-BG] LicenseOrchestrationService.GetCurrentStateAsync concluído.");
                    }
                    catch (Exception ex) {
                        LogToFile($"[BOOT-BG] ERRO/TIMEOUT na licença: {ex.Message}");
                    }
                });

                LogToFile("[BOOT] Aguardando licença (máx 500ms)...");
                await Task.WhenAny(licenseTask, Task.Delay(500)).ConfigureAwait(false);
                LogToFile("[BOOT] Aguardo de licença finalizado.");
                VoltrisDiagnosticSystem.Instance.Timeline("LICENSE", "Aguardo de licença concluído (máx 500ms)");

                LogToFile("[BOOT] Chamando bootToken.Complete...");
                bootToken.Complete(locBoot.GetString("BootComplete"));
                LogToFile("[BOOT] bootToken.Complete concluído.");

                // Fluxo principal: Decidir entre onboarding ou dashboard
                await Dispatcher.BeginInvoke(new Action(() =>
                {
                    forensics?.BeginUIOperation("ContinueNormalFlow");
                    LogToFile("[BOOT] Encaminhando para ContinueNormalFlow.");
                    VoltrisDiagnosticSystem.Instance.Timeline("FLOW", "ContinueNormalFlow chamado");
                    ContinueNormalFlow();
                    forensics?.EndUIOperation("ContinueNormalFlow");
                    
                    LogToFile("[BOOT] BootSequenceAsync terminou fluxo principal. Purgando operações...");
                    GlobalProgressService.Instance.PurgeStaleOperations(TimeSpan.FromMinutes(5));
                    
                    forensics?.BeginUIOperation("InitializeApplicationState");
                    LogToFile("[BOOT] Chamando InitializeApplicationState.");
                    VoltrisDiagnosticSystem.Instance.Timeline("BOOT", "InitializeApplicationState chamado");
                    InitializeApplicationState();
                    forensics?.EndUIOperation("InitializeApplicationState");
                    
                    forensics?.StopMonitoring();
                    VoltrisDiagnosticSystem.Instance.Timeline("BOOT", "BootSequenceAsync concluído");
                    LogToFile("[BOOT] ===== FIM DA SEQUÊNCIA DE BOOT =====");
                }), System.Windows.Threading.DispatcherPriority.Background);
            });
        }

        private void InitializeApplicationState()
        {
            if (Interlocked.Exchange(ref _applicationStateInitialized, 1) != 0)
            {
                LogToFile("[BOOT] InitializeApplicationState já executado, ignorando.");
                return;
            }

            _initializationCompleted = 1;
            
            // Verificação automática de atualizações (Silenciosa e Mandatória)
            _ = CheckForUpdatesAutomaticallyAsync();

            // Garante a credencial do dispositivo UMA VEZ, antes do loop de status.
            // Sem ela o servidor nao devolve o email do dono e o app nao consegue se
            // desvincular depois. Antes isto vivia dentro do while e virava um POST
            // a cada iteracao (5 s) que nao mudava nada.
            _ = EnterpriseService.EnsureDeviceCredentialAsync();

            // Atualizar status de vinculao inicialmente e iniciar polling
            _ = UpdateLinkingStatusAsync();
            
            // Subscrever ao evento do CloudAccountService para atualizar o header IMEDIATAMENTE quando status mudar
            CloudAccountService.Instance.AccountStateChanged += OnCloudAccountStateChanged;

            // Subscrever a mudanças de configuração para atualizar visibilidade Beta
            SettingsService.Instance.SettingsChanged += OnSettingsChanged;

            // Aplicar visibilidade inicial das páginas Beta
            UpdateBetaFeatureVisibility();

            // Verificar status da licença no carregamento (Background-safe)
            _ = Task.Run(() => CheckLicenseStatus());
            
            // Atualizar visibilidade do card de marketing
            UpdateFooterPromoCardVisibility();
        }

        private void OnSettingsChanged(object? sender, EventArgs e)
        {
            Dispatcher.BeginInvoke(new Action(() =>
            {
                UpdateBetaFeatureVisibility();
            }));
        }

        private void UpdateBetaFeatureVisibility()
        {
            try
            {
                NavRecovery.Visibility = SettingsService.Instance.Settings.ShowRecoveryPage
                    ? Visibility.Visible
                    : Visibility.Collapsed;

                NavDrivers.Visibility = SettingsService.Instance.Settings.ShowDriversPage
                    ? Visibility.Visible
                    : Visibility.Collapsed;

                ShieldHeaderButton.Visibility = Visibility.Visible;

                NavShield.Visibility = Visibility.Visible;
            }
            catch (Exception ex)
            {
                App.LoggingService?.LogError($"[MainWindow] Erro ao atualizar visibilidade Beta: {ex.Message}", ex);
            }
        }

        private async Task CheckLicenseStatus()
        {
            try
            {
                // CORREÇÃO: Esperar o LicenseOrchestrationService ter o cache populado
                // O construtor do serviço tem um Task.Delay(5000) + consulta ao backend.
                // Com apenas 2s de delay, o cache estava null e retornava 'expirado' falsamente.
                LogToFile("[LICENSE-CHECK] Aguardando LicenseOrchestrationService popular cache...");

                // Aguardar até 15 segundos pelo cache ser populado
                for (int i = 0; i < 30; i++)
                {
                    await Task.Delay(500).ConfigureAwait(false);
                    
                    // Verificar se o cache j foi populado
                    if (LicenseOrchestrationService.Instance.CachedState != null)
                    {
                        LogToFile($"[LICENSE-CHECK] Cache populado aps {(i + 1) * 500}ms");
                        break;
                    }
                    
                    // Se LicenseTokenStore j tem licença Pro, no precisa esperar o cache
                    if (VoltrisOptimizer.Services.License.LicenseTokenStore.IsProActive)
                    {
                        LogToFile("[LICENSE-CHECK] LicenseTokenStore.IsProActive=true, no precisa esperar cache");
                        break;
                    }
                }

                // Usar LicenseOrchestrationService como fonte de verdade (j tem null-safety)
                bool isExpired = LicenseOrchestrationService.Instance.IsTrialExpired;
                LogToFile($"[LICENSE-CHECK] IsTrialExpired={isExpired}, CachedState={LicenseOrchestrationService.Instance.CachedState != null}");

                // FREEMIUM: o app é 100% gratuito. Nenhum estado de licença bloqueia o app;
                // apenas os recursos PRO são bloqueados individualmente (LicensedCommand/ProFeatureGuard).
                await Dispatcher.InvokeAsync(() => {
                    _isLicenseBlocked = false;
                    LogToFile("[LICENSE-CHECK] Freemium ativo - modo gratuito liberado. isExpired não bloqueia mais o app.");

                    if (LicenseLockdownOverlay != null)
                    {
                        LicenseLockdownOverlay.Visibility = Visibility.Collapsed;
                    }
                    
                    // Atualizar visibilidade do card de marketing
                    UpdateFooterPromoCardVisibility();
                    
                    EnableSidebar();
                });
            }
            catch (Exception ex)
            {
                LogToFile($"[LICENSE-BLOCK] Erro ao verificar licença: {ex.Message}");
                // CORREÇÃO: Em caso de erro, NÃO bloquear (fail-open durante inicialização)
                // O prximo ciclo de verificação cuidar do bloqueio se realmente necessário
            }
        }

        private async Task CheckForUpdatesAutomaticallyAsync()
        {
            try
            {
                LogToFile("Iniciando verificação automtica de atualizaes...");
                
                // Aguardar um pouco para no competir com a renderizao inicial do Dashboard
                await Task.Delay(TimeSpan.FromSeconds(3)).ConfigureAwait(false);

                var updateInfo = await UpdateService.CheckForUpdatesAsync();

                if (updateInfo != null)
                {
                    LogToFile($"Nova versão detectada: {updateInfo.LatestVersion}. Abrindo janela de atualização mandatória.");

                    // CORREÇÃO: Adiar a exibição enquanto houver jogo ativo (Modo Gamer).
                    // Um diálogo modal/invisível atrás de um jogo em tela cheia exclusiva
                    // congelava o app por completo (UI thread presa em ShowDialog/MessageBox).
                    for (int i = 0; i < 30 && _gamerViewModel == null && App.Services != null; i++)
                    {
                        await Task.Delay(TimeSpan.FromMilliseconds(500)).ConfigureAwait(false);
                    }

                    if (_gamerViewModel?.IsGamerModeActive == true)
                    {
                        LogToFile("Modo Gamer ativo — adiando atualização até o jogo ser fechado.");
                        while (_gamerViewModel?.IsGamerModeActive == true)
                        {
                            await Task.Delay(TimeSpan.FromSeconds(5)).ConfigureAwait(false);
                        }
                    }

                    await Dispatcher.InvokeAsync(() =>
                    {
                        var updateWindow = new VoltrisOptimizer.Core.Updater.UpdateWindow(updateInfo);
                        updateWindow.Owner = this;
                        updateWindow.ShowDialog();
                    });
                }
                else
                {
                    LogToFile("Nenhuma atualização pendente encontrada.");
                }
            }
            catch (Exception ex)
            {
                LogToFile($"Erro na verificação automtica de updates: {ex.Message}");
            }
        }

        private RemoteCommandService? _remoteCommandService;

        /// <summary>
        /// Fora atualização imediata do ícone de vinculao no header.
        /// Chamado pelas configurações quando o usuário vincula ou desvincula.
        /// </summary>
        public void ForceUpdateLinkingStatus()
        {
            LogToFile("[CLOUD] ForceUpdateLinkingStatus chamado  atualizando header via CloudAccountService.");
            try
            {
                bool isLinked = CloudAccountService.Instance.IsLinked;

                // O chip de conta do Dashboard se inscreve no AccountStateChanged
                // e se atualiza sozinho; o MainWindow cuida do ciclo de vida do
                // RemoteCommandService, que é o que realmente precisa agir aqui.
                if (!isLinked && _remoteCommandService != null)
                {
                    LogToFile("[CLOUD] Parando RemoteCommandService aps desvinculao.");
                    _remoteCommandService.Stop();
                    _remoteCommandService.Dispose();
                    _remoteCommandService = null;
                }
                else if (isLinked && _remoteCommandService == null)
                {
                    LogToFile("[CLOUD] Iniciando RemoteCommandService aps vinculao.");
                    _remoteCommandService = new RemoteCommandService(App.LoggingService ?? new LoggingService(
                        LogDirectoryResolver.Resolve()));
                    _remoteCommandService.Start();
                }
            }
            catch (Exception ex)
            {
                LogToFile($"[CLOUD] Erro crtico em ForceUpdateLinkingStatus: {ex.Message}");
            }
        }

        private void OnCloudAccountStateChanged(object? sender, AccountStateChangedEventArgs args)
        {
            Dispatcher.BeginInvoke(() => {
                try {
                    LogToFile($"[CLOUD] Estado da conta alterado: IsLinked={args.IsLinked}, Email={args.Email ?? "null"}");
                } catch (Exception ex) { LogToFile($"[CLOUD] Erro em OnCloudAccountStateChanged: {ex.Message}"); }
            });
        }

        /// <summary>
        /// Intervalo do poll de estado do vínculo.
        ///
        /// Vinculado: 60 s. O intervalo de 5 s existia para o desvinculo feito NO
        /// SITE aparecer "quase imediato" — mas a conta é do próprio usuário, e
        /// o próprio app é quem desvincula pela tela. Ou seja: o caso que o 5 s
        /// resolvia (usuário desvincula em outro dispositivo e espera o app
        /// reagir) é raro, e pagava 17.280 requisições/dia por máquina. Com 60 s
        /// o efeito ainda aparece em no máximo 1 minuto, que é imperceptível.
        ///
        /// Desvinculado, credencial divergente ou servidor fora: 5 min. Se não há
        /// vínculo não há o que espiar, e esse estado é o que mais consumia.
        ///
        /// Custo por máquina vinculada: de ~43.000 para ~43.000 requisições/mês
        /// somando o ciclo de comandos, o que deixa de ser o gargalo.
        /// </summary>
        private static readonly TimeSpan LinkedPollInterval = TimeSpan.FromSeconds(60);
        private static readonly TimeSpan IdlePollInterval = TimeSpan.FromMinutes(5);

        private async Task UpdateLinkingStatusAsync()
        {
            var token = _backgroundCts.Token;
            while (!token.IsCancellationRequested)
            {
                // Começa no intervalo rápido: logo após vincular, o usuário
                // espera a confirmação.
                var nextDelay = LinkedPollInterval;

                try
                {
                    // CORREÇÃO: ConfigureAwait(false) em todas as operações de I/O para
                    // evitar que as continuações capturem o SynchronizationContext da UI thread.
                    // Sem isso, cada await postava o resultado de volta à UI thread,
                    // causando os freezes em WaitSleepJoin observados no log de diagnóstico.
                    //
                    // O retorno é TIPADO: distingue "não vinculado" de "servidor fora".
                    // Antes, qualquer falha de rede virava isLinked=false e o estado
                    // local era APAGADO sem o servidor ter desvinculado nada.
                    var linkStatus = await EnterpriseService.Instance.GetLinkStatusAsync().ConfigureAwait(false);
                    var isLinked = linkStatus.IsLinked;
                    var email = linkStatus.Email;

                    if (linkStatus.Outcome == LinkCheckOutcome.Unreachable)
                    {
                        // Inconclusivo: preserva o estado local e não mexe no serviço
                        // de comandos remotos (o vínculo pode continuar válido).
                        LogToFile(
                            $"[ENTERPRISE] Consulta de vínculo inconclusiva " +
                            $"(http={linkStatus.HttpStatus?.ToString() ?? "-"}, " +
                            $"corr={linkStatus.CorrelationId ?? "-"}). Estado local preservado.");

                        CloudAccountService.Instance.SyncFromSettings();

                        // O chip de conta do Dashboard reage sozinho ao
                        // PropertyChanged disparado pelo SyncFromSettings acima.
                        nextDelay = IdlePollInterval;
                        goto Delay;
                    }

                    if (linkStatus.Outcome == LinkCheckOutcome.CredentialMismatch)
                    {
                        // O servidor tem vínculo mas a credencial deste PC não
                        // confere. NÃO desloga: o vínculo continua valendo no
                        // site. Orienta revincular.
                        LogToFile(
                            "[ENTERPRISE] Credencial do dispositivo divergente. " +
                            "O vínculo continua ativo; revincule o computador pela conta.");

                        CloudAccountService.Instance.SyncFromSettings();

                        nextDelay = IdlePollInterval;
                        goto Delay;
                    }

                    // Sincronizar com as configurações
                    var settings = SettingsService.Instance.Settings;
                    bool changed = false;

                    if (settings.IsDeviceLinked != isLinked)
                    {
                        settings.IsDeviceLinked = isLinked;
                        changed = true;
                    }

                    if (isLinked && !string.IsNullOrEmpty(email) && settings.LinkedUserEmail != email)
                    {
                        settings.LinkedUserEmail = email;
                        changed = true;
                    }

                    if (!isLinked)
                    {
                        settings.LinkedUserEmail = null;
                        settings.LinkedAt = null;
                        changed = true;
                    }

                    if (changed)
                    {
                        SettingsService.Instance.SaveSettings();
                        LogToFile(
                            isLinked
                                ? $"[ENTERPRISE] Conta vinculada: {email}"
                                : "[ENTERPRISE] Servidor confirmou que não há vínculo - conta deslogada.");
                    }

                    CloudAccountService.Instance.SyncFromSettings();

                    // Iniciar serviço de comandos remotos quando vinculado
                    if (isLinked && _remoteCommandService == null)
                    {
                        LogToFile("[ENTERPRISE] Dispositivo vinculado - iniciando RemoteCommandService.");
                        _remoteCommandService = new RemoteCommandService(App.LoggingService ?? new LoggingService(
                            LogDirectoryResolver.Resolve()));
                        _remoteCommandService.Start();
                    }
                    else if (!isLinked && _remoteCommandService != null)
                    {
                        LogToFile("[ENTERPRISE] Dispositivo desvinculado - parando RemoteCommandService.");
                        _remoteCommandService.Stop();
                        _remoteCommandService.Dispose();
                        _remoteCommandService = null;
                    }

                    await Dispatcher.InvokeAsync(() =>
                    {
                        // O chip de conta do Dashboard reage sozinho ao
                        // PropertyChanged do CloudAccountService, que acabou de
                        // ser atualizado por SyncFromSettings acima.
                    });

                    nextDelay = isLinked ? LinkedPollInterval : IdlePollInterval;
                }
                catch (OperationCanceledException) { break; }
                catch (Exception ex)
                {
                    LogToFile($"[ENTERPRISE] Erro no UpdateLinkingStatusAsync: {ex.Message}");
                }

            Delay:
                try { await Task.Delay(nextDelay, token).ConfigureAwait(false); }
                catch (OperationCanceledException) { break; }
            }
        }

        /// <summary>
        /// Navega para uma view específica com logs e checks de segurança
        /// </summary>
        internal void NavigateToPageSafe(string pageName)
        {
            var navSw = System.Diagnostics.Stopwatch.StartNew();
            try
            {
                if (_isLockedForOnboarding)
                {
                    LogToFile($"[NAV-SAFE] Navegao para '{pageName}' ignorada devido ao onboarding ativo.");
                    return;
                }
                LogToFile($"[NAV-SAFE] Iniciando navegao para: {pageName}");
                VoltrisDiagnosticSystem.Instance.Timeline("NAV", $"NavigateToPageSafe('{pageName}') iniciado");
                VoltrisDiagnosticSystem.Instance.BeginUIOperation($"NavigateTo_{pageName}");

                // Progresso: informar usuário que está carregando
                try { GlobalProgressService.Instance.StartOperation(string.Format(LocalizationService.Instance.GetString("LoadingPage"), pageName)); } catch { }

                LogToFile($"[NAV-SAFE] Navegando para {pageName}...");

                // Bloquear navegação para páginas Beta desativadas
                if ((pageName == "Recovery" && !SettingsService.Instance.Settings.ShowRecoveryPage) ||
                    (pageName == "Drivers" && !SettingsService.Instance.Settings.ShowDriversPage))
                {
                    App.LoggingService?.LogWarning($"[NAV-SAFE] Navegao bloqueada - página Beta '{pageName}' desativada nas configurações");
                    return;
                }

                // A página Modo Gamer abre normalmente para todos; os comandos internos de
                // ação são bloqueados individualmente pelo LicensedCommand (modal de compra).
                UserControl? viewToNavigate = null;

                // 1. Tentar obter do cache
                if (_viewCache.ContainsKey(pageName))
                {
                    viewToNavigate = _viewCache[pageName];
                    LogToFile($"[NAV-SAFE] View '{pageName}' obtida do cache.");
                }
                else
                {
                    // 2. Se no existir, criar e cachear
                    try
                    {
                        LogToFile($"Criando nova view: {pageName}");
                        VoltrisDiagnosticSystem.Instance.Timeline("VIEW-CREATE", $"Criando view '{pageName}'");
                        var viewSw = System.Diagnostics.Stopwatch.StartNew();
                        
                        viewToNavigate = pageName switch
                        {
                            "Dashboard" => new DashboardView(),
                            "Performance" => new PerformanceView(),
                            "Network" => new NetworkView(),
                            "System" => new SystemView(),
                            "Gamer" => new GamerView(),
                            "Shield" => new ShieldView(),
                            "Repair" => new RepairView(),
                            "Security" => new SecurityView(),
                            "Privacy" => new PrivacyView(),
                            "Debloat" => new DebloatView(),
                            "Recovery" => new RecoveryView(),
                            "DeviceInfo" => new DeviceInfoView(),
                            "History" => new HistoryView(),
                            "Scheduler" => new SchedulerView(),
                            "Settings" => new SettingsView(),
                            "Diagnostics" => new GameDiagnosticsView(),
                            "Shortcuts" => new VoltrisOptimizer.UI.Views.ShortcutsView(),
                            "Benchmark" => new VoltrisOptimizer.UI.Views.BenchmarkPage(),
                            // [FIX:PAGINA-ENERGIA-REMOVIDA]
                      // A rota "Energy" saía da fábrica de páginas. Ela oferecia
                      // ativação manual de planos e edição de EPP, que desfaziam
                      // o Perfil Inteligente. Energia se controla pelo Perfil.
                            "Personalize" => new VoltrisOptimizer.UI.Views.PersonalizeView(),
                            "Display" => new VoltrisOptimizer.UI.Views.DisplayView(),
                            "StreamHub" => new VoltrisOptimizer.UI.Views.StreamHubView(),
                            "Drivers" => new DriversView(),
                            "License" => new VoltrisOptimizer.UI.Views.LicenseActivationView(),
                            _ => null
                        };

                        viewSw.Stop();
                        VoltrisDiagnosticSystem.Instance.Timeline("VIEW-CREATE", $"View '{pageName}' criada em {viewSw.ElapsedMilliseconds}ms");

                        if (viewToNavigate != null)
                        {
                            _viewCache[pageName] = viewToNavigate;
                            LogToFile($"View '{pageName}' criada e cacheada em {viewSw.ElapsedMilliseconds}ms");
                        }
                    }
                    catch (Exception ex)
                    {
                         // A CORREÇÃO REAL fica no InnerException: XamlReader.RewrapException embrulha a
                         // exceção verdadeira (ex.: TypeConverterMarkupExtension) e registrar apenas
                         // ex.Message tornava a falha de BAML impossível de diagnosticar.
                         LogToFile($"ERRO CRITICO ao criar pagina '{pageName}': {ex.Describe()}");
                         App.LoggingService?.LogError($"[NAV] Falha ao criar a view '{pageName}'. Cadeia completa de excecoes abaixo.", ex);
                         VoltrisDiagnosticSystem.Instance.Timeline("VIEW-ERROR", $"Falha ao criar '{pageName}': {ex.Describe()}");
                         
                         var errorMsg = $"Erro ao criar pagina '{pageName}':\n\n{ex.Message}";
                         if (ex.InnerException != null)
                         {
                             errorMsg += $"\n\nErro interno: {ex.InnerException.Message}";
                         }
                         
                         MessageBox.Show(errorMsg, LocalizationService.Instance.GetString("Error"), MessageBoxButton.OK, MessageBoxImage.Error);
                         VoltrisDiagnosticSystem.Instance.EndUIOperation($"NavigateTo_{pageName}");
                         return;
                    }
                }

                if (viewToNavigate != null)
                {
                    // DESATIVAR MONITORAMENTO DA VIEW ANTERIOR
                    if (_currentView?.DataContext is ViewModelBase oldVm)
                    {
                        oldVm.IsActive = false;
                        App.LoggingService?.LogTrace($"[Navigation] Pausando ViewModel: {oldVm.GetType().Name}");
                    }

                    LogToFile($"[NAV-SAFE] Atribuindo view '{pageName}' ao ContentFrame...");
                    ContentFrame.Content = viewToNavigate;
                    LogToFile($"[NAV-SAFE] Atribuio concluda.");
                    _currentView = viewToNavigate;
                    _lastPageName = pageName;

                    // ATIVAR MONITORAMENTO DA NOVA VIEW (Respeitando estado da janela)
                    if (viewToNavigate.DataContext is ViewModelBase newVm)
                    {
                        // Só ativar se a janela estiver visível e não minimizada no tray
                        newVm.IsActive = WindowState != WindowState.Minimized && Visibility == Visibility.Visible;
                        App.LoggingService?.LogTrace($"[Navigation] Ativando ViewModel: {newVm.GetType().Name} (Active={newVm.IsActive})");
                    }
                    
                    // CORREO PERFORMANCE: Telemetria em background para no bloquear navegao
                    _ = Task.Run(() => App.TelemetryService?.TrackEvent("PAGE_VIEW", "Navigation", pageName, forceFlush: true));
                }

                VoltrisDiagnosticSystem.Instance.EndUIOperation($"NavigateTo_{pageName}");

                navSw.Stop();
                if (navSw.ElapsedMilliseconds > 500)
                {
                    LogToFile($"[NAV-WARN] Navegao para '{pageName}' demorou {navSw.ElapsedMilliseconds}ms (>500ms)");
                    VoltrisDiagnosticSystem.Instance.Timeline("NAV-WARN", $"NavigateToPageSafe('{pageName}') lento: {navSw.ElapsedMilliseconds}ms");
                }
            }
            catch (Exception ex)
            {
                LogToFile($"Erro ao navegar: {ex.Describe()}");
                App.LoggingService?.LogError($"[NAV] NavigateToPageSafe('{pageName}') falhou. Cadeia completa de excecoes abaixo.", ex);
                VoltrisDiagnosticSystem.Instance.Timeline("NAV-ERROR", $"NavigateToPageSafe('{pageName}') falhou: {ex.Message}");
            }
            finally
            {
                try { GlobalProgressService.Instance.CompleteOperation(string.Format(LocalizationService.Instance.GetString("LoadingPage"), pageName)); } catch { }
            }
        }

        private string _lastPageName = "Dashboard";

        /// <summary>
        /// CORREO CRTICA: Verso assncrona de NavigateToPageSafe para Systray
        /// Aguarda a navegação ser concluída antes de retornar
        /// </summary>
        private async Task NavigateToPageSafeAsync(string pageName)
        {
            var tcs = new TaskCompletionSource<bool>();
            
            try
            {
                await Application.Current.Dispatcher.InvokeAsync(() =>
                {
                    try
                    {
                        NavigateToPageSafe(pageName);
                        
                        // Aguardar frame carregar
                        if (ContentFrame != null && ContentFrame.Content != null)
                        {
                            var content = ContentFrame.Content as FrameworkElement;
                            if (content != null)
                            {
                                if (content.IsLoaded)
                                {
                                    tcs.TrySetResult(true);
                                }
                                else
                                {
                                    RoutedEventHandler? loadedHandler = null;
                                    loadedHandler = (s, e) =>
                                    {
                                        content.Loaded -= loadedHandler;
                                        tcs.TrySetResult(true);
                                    };
                                    content.Loaded += loadedHandler;
                                    Task.Delay(3000).ContinueWith(_ => tcs.TrySetResult(false));
                                }
                            }
                            else
                            {
                                tcs.TrySetResult(true);
                            }
                        }
                        else
                        {
                            tcs.TrySetResult(false);
                        }
                    }
                    catch (Exception ex)
                    {
                        App.LoggingService?.LogError($"[NavigateToPageSafeAsync] Erro ao navegar para {pageName}", ex);
                        tcs.TrySetException(ex);
                    }
                });
                
                await tcs.Task;
            }
            catch (Exception ex)
            {
                App.LoggingService?.LogError($"[NavigateToPageSafeAsync] Erro crtico ao navegar para {pageName}", ex);
            }
        }

        private void Window_Loaded(object sender, RoutedEventArgs e)
        {
            // Simplificado para evitar conflitos com MainWindow_Loaded_Gate
            var args = Environment.GetCommandLineArgs();
            var startedMinimized = args.Any(arg => arg.Equals("/minimized", StringComparison.OrdinalIgnoreCase) || 
                                                 arg.Equals("-minimized", StringComparison.OrdinalIgnoreCase));
            
            if (!startedMinimized)
            {
                 // Garantias bsicas de UI apenas se no for background startup
                 if (_hwnd != IntPtr.Zero) SetWindowIcon(_hwnd);
            }
            
            // UpdateClipGeometry();
            // SizeChanged += (s, args) => UpdateClipGeometry();
            
            // Aplicar backdrop no ContentRendered  nico evento que garante que a janela
            // está de fato visível e pintada na tela (necessário para SetWindowCompositionAttribute)
            ContentRendered += Window_ContentRendered;

            // CORREO PERFORMANCE: Remover duplicao  GlobalProgressService j  íconectado no construtor.
            // Conectar duas vezes causa handlers duplicados e processamento dobrado.
        }

        private void Window_ContentRendered(object? sender, EventArgs e)
        {
            ContentRendered -= Window_ContentRendered;

            try
            {
                bool isLight = _settings.Settings.Theme?.Equals("Light", StringComparison.OrdinalIgnoreCase) == true;
                UpdateThemeToggleIcon(isLight);
                UpdateTransparencyToggleIcon(_settings.Settings.EnableTransparency);

                ApplyThemeAndTransparency(_settings.Settings.Theme, _settings.Settings.EnableTransparency);

                Dispatcher.BeginInvoke(new Action(() => {
                    try { RoundedWindowHelper.ForceApply(this, 16); } catch { }
                }), System.Windows.Threading.DispatcherPriority.Render);

                LogToFile("[TASKBAR-RESTORE] ContentRendered concluído.");
            }
            catch (Exception ex)
            {
                App.LoggingService?.LogError($"[MainWindow] ContentRendered: {ex.Message}");
            }
        }

        /// <summary>
        /// Restaurar configurações do Taskbar persistidas (centralização + estilo).
        /// IMPORTANTE: Este método é chamado de Task.Run (background thread).
        /// TODOS os awaits internos devem ter ConfigureAwait(false) para não voltar
        /// à UI thread caso contrário causará WaitSleepJoin freezes de 11s.
        /// Qualquer acesso a APIs de UI deve ser via Dispatcher.InvokeAsync.
        /// </summary>
        private async Task RestoreSavedTaskbarSettingsAsync()
        {
            VoltrisOptimizer.Helpers.StartupStepTracker.Instance?.Begin("TASKBAR_RESTORE", "Restaurando alinhamento e estilo da taskbar");
            LogToFile("[TASKBAR-RESTORE] Iniciando (background thread)...");

            var taskbarCtrl = App.Services?.GetService<VoltrisOptimizer.Services.Personalize.TaskbarControlService>();
            if (taskbarCtrl == null)
            {
                LogToFile("[TASKBAR-RESTORE] TaskbarControlService no disponvel.");
                VoltrisOptimizer.Helpers.StartupStepTracker.Instance?.End("TASKBAR_RESTORE", "Service NULL");
                return;
            }

            LogToFile("[TASKBAR-RESTORE] Obtendo settings...");
            var s = _settings.Settings;
            bool isWin11 = Environment.OSVersion.Version.Build >= 22000;

            // Evitar mltiplas execues simultneas
            if (System.Threading.Interlocked.CompareExchange(ref _taskbarRestoreStarted, 1, 0) != 0)
            {
                LogToFile("[TASKBAR-RESTORE] Ignorado  execuo j em andamento.");
                VoltrisOptimizer.Helpers.StartupStepTracker.Instance?.Event("TASKBAR_RESTORE", "Ignorado  execuo j em andamento");
                return;
            }

            try
            {
                // Restaurar estilo e centralização em múltiplas tentativas.
                // ConfigureAwait(false) OBRIGATRIO: impede que os awaits voltem  UI thread.
                // Sem ConfigureAwait(false), Task.Delay retorna na UI thread e o cdigo WinAPI
                // seguinte bloqueia o Dispatcher causando 43 freezes consecutivos de 1s.
                int[] delaysMs = { 1000, 3000, 7000 };
                bool successOnFirstAttempt = false;

                for (int attempt = 0; attempt < delaysMs.Length; attempt++)
                {
                    // ? ConfigureAwait(false): continua em background thread, no na UI thread
                    await Task.Delay(delaysMs[attempt]).ConfigureAwait(false);

                    try
                    {
                        LogToFile($"[TASKBAR-RESTORE] Tentativa {attempt + 1}/{delaysMs.Length}  Aplicando configuraes (TID={Thread.CurrentThread.ManagedThreadId})...");
                        App.LoggingService?.LogInfo($"[MainWindow] [TaskbarRestore] Tentativa {attempt + 1}/{delaysMs.Length}  CenteringEnabled={s.TaskbarCenteringEnabled} StyleEnabled={s.TaskbarStyleEnabled} IsWin11={isWin11}");

                        // Restaurar estilo visual  SetStyle usa WinAPI (user32) que não precisa UI thread
                        if (s.TaskbarStyleEnabled)
                        {
                            var mode = (VoltrisOptimizer.Services.Personalize.TaskbarStyleMode)s.TaskbarStyleIndex;
                            taskbarCtrl.SetStyle(true, mode, (byte)System.Math.Clamp(s.TaskbarOpacity, 0, 255));
                        }

                        // Restaurar centralização (apenas Win10)  SetCentering usa Registry + WinAPI
                        if (s.TaskbarCenteringEnabled && !isWin11)
                        {
                            taskbarCtrl.SetCentering(true);
                            App.LoggingService?.LogInfo($"[MainWindow] [TaskbarRestore] Centralizao aplicada (tentativa {attempt + 1}).");
                        }

                        // Restaurar VoltrisBlur (apenas na primeira tentativa)
                        if (attempt == 0 && s.VoltrisBlurInstalled)
                        {
                            var voltrisBlur = App.Services?.GetService<VoltrisOptimizer.Services.Personalize.VoltrisBlurService>();
                            if (voltrisBlur != null)
                            {
                                var effect = (VoltrisOptimizer.Services.Personalize.ExplorerEffect)s.VoltrisBlurEffectIndex;
                                // ? ConfigureAwait(false): ApplyConfigOnlyAsync pode ter awaits internos
                                await voltrisBlur.ApplyConfigOnlyAsync(
                                    effect,
                                    s.VoltrisBlurClearAddress, s.VoltrisBlurClearBarBg, false,
                                    s.VoltrisBlurShowLine,
                                    (byte)s.VoltrisBlurAlpha, (byte)s.VoltrisBlurColorR,
                                    (byte)s.VoltrisBlurColorG, (byte)s.VoltrisBlurColorB).ConfigureAwait(false);
                            }
                        }

                        successOnFirstAttempt = true;

                        // Sair aps a primeira tentativa bem-sucedida (tentativas 2+ so apenas
                        // para o caso de reinício do Explorer  se chegou aqui sem exceção, OK)
                        if (attempt > 0) break;
                    }
                    catch (Exception ex)
                    {
                        App.LoggingService?.LogWarning($"[MainWindow] [TaskbarRestore] Tentativa {attempt + 1} erro: {ex.Message}");
                        successOnFirstAttempt = false;
                    }

                    // Se primeira tentativa foi bem-sucedida E no h necessidade de re-aplicar,
                    // aguardar o delay da segunda tentativa seria desnecessário  sair
                    if (successOnFirstAttempt && attempt == 0 && !s.TaskbarCenteringEnabled && !s.TaskbarStyleEnabled)
                        break;
                }

                VoltrisOptimizer.Helpers.StartupStepTracker.Instance?.End("TASKBAR_RESTORE", $"Concludo em {delaysMs.Take(delaysMs.Length).Sum()}ms de delays");
            }
            catch (Exception ex)
            {
                VoltrisOptimizer.Helpers.StartupStepTracker.Instance?.Fail("TASKBAR_RESTORE", ex, "Falha ao restaurar taskbar");
            }
            finally
            {
                // Resetar flag para permitir nova restauração (ex: troca de usuário)
                System.Threading.Interlocked.Exchange(ref _taskbarRestoreStarted, 0);
            }
        }

        private int _taskbarRestoreStarted = 0;

        // Restante do arquivo mantido... (Métodos auxiliares, NotifyIcon, etc)

        
        // ---- Constantes Win32 para redimensionamento manual ----
        private const uint WM_NCLBUTTONDOWN = 0x00A1;
        // HT* constants — áreas da janela (non-client hit test values)
        private const int HTLEFT = 10;
        private const int HTRIGHT = 11;
        private const int HTTOP = 12;
        private const int HTTOPLEFT = 13;
        private const int HTTOPRIGHT = 14;
        private const int HTBOTTOM = 15;
        private const int HTBOTTOMLEFT = 16;
        private const int HTBOTTOMRIGHT = 17;

        /// <summary>
        /// Handler para os handles de redimensionamento nas bordas e cantos da janela.
        /// Usa o padrão ReleaseCapture + WM_NCLBUTTONDOWN para iniciar o sizing nativo do Windows.
        /// </summary>
        private void ResizeHandle_MouseDown(object sender, System.Windows.Input.MouseButtonEventArgs e)
        {
            if (e.ChangedButton != System.Windows.Input.MouseButton.Left) return;
            if (sender is System.Windows.Controls.Border border && border.Tag is string direction)
            {
                int htValue = direction switch
                {
                    "Left" => HTLEFT,
                    "Right" => HTRIGHT,
                    "Top" => HTTOP,
                    "TopLeft" => HTTOPLEFT,
                    "TopRight" => HTTOPRIGHT,
                    "Bottom" => HTBOTTOM,
                    "BottomLeft" => HTBOTTOMLEFT,
                    "BottomRight" => HTBOTTOMRIGHT,
                    _ => 0
                };
                if (htValue == 0) return;

                try
                {
                    var hwnd = new System.Windows.Interop.WindowInteropHelper(this).Handle;
                    if (hwnd == IntPtr.Zero) return;

                    // Libera captura do WPF e simula clique na área não-cliente
                    // para que o Windows gerencie todo o resize (cursor, tracking, preview)
                    Win32.ReleaseCapture();
                    Win32.SendMessage(hwnd, WM_NCLBUTTONDOWN, (IntPtr)htValue, IntPtr.Zero);
                    e.Handled = true;
                }
                catch { }
            }
        }

        /// <summary>
        /// Alterna entre maximizado e normal, atualizando o ícone do botão.
        /// </summary>
        private void ToggleWindowState()
        {
            if (WindowState == WindowState.Maximized)
            {
                WindowState = WindowState.Normal;
                if (MaximizeIcon != null)
                    MaximizeIcon.Data = System.Windows.Media.Geometry.Parse("M4,4 L20,4 L20,20 L4,20 Z");
            }
            else
            {
                WindowState = WindowState.Maximized;
                if (MaximizeIcon != null)
                    MaximizeIcon.Data = System.Windows.Media.Geometry.Parse("M4,4 L12,4 L12,12 L4,12 Z M12,12 L20,12 L20,20 L12,20 Z");
            }
        }

        private void LogToFile(string message)
        {
            // Usar logging centralizado em vez de I/O direto
            try
            {
                App.LoggingService?.LogInfo($"[MainWindow] {message}");
            }
            catch { }
        }



        private void ShowWelcomeScreen()
        {
            // OBSOLETO: O fluxo agora é tratado no App.xaml.cs antes do Show() desta janela.
            // Mantido apenas para compatibilidade de assinatura se necessário.
            ContinueNormalFlow();
        }

        // Guard de re-entrncia para evitar dupla execuo
        private volatile bool _continueNormalFlowExecuted = false;

        private void ContinueNormalFlow()
        {
            // Prevenir execuo duplicada  race condition entre BootSequenceAsync e ShowWelcomeScreen
            if (_continueNormalFlowExecuted || Interlocked.Exchange(ref _continueNormalFlowExecutionState, 1) != 0)
            {
                LogToFile("[FLOW] ContinueNormalFlow IGNORADO  j executado anteriormente.");
                return;
            }
            _continueNormalFlowExecuted = true;

            // CORREO ARQUITETURAL: Usar _ = ContinueNormalFlowAsync() para que a Task
            // seja fire-and-forget MAS com tratamento de exceo adequado.
            // Não usar Task.Run aqui pois já estamos na UI thread (chamado de BootSequenceAsync
            // que é async void via Loaded event). O Task.Run interno criava uma race condition
            // onde o Dispatcher.InvokeAsync era chamado de dentro de Task.Run enquanto a UI
            // thread podia estar construindo o DashboardViewModel simultaneamente.
            _ = ContinueNormalFlowAsync();
        }

        /// <summary>
        /// Implementao async de ContinueNormalFlow.
        /// CORREO: Elimina o Task.Run + Dispatcher.InvokeAsync aninhado que causava
        /// race condition. Agora executa o trabalho de background com ConfigureAwait(false)
        /// e retorna para a UI thread via await Dispatcher.InvokeAsync apenas uma vez.
        /// </summary>
        private async Task ContinueNormalFlowAsync()
        {
            try
            {
                LogToFile("[FLOW] ContinueNormalFlowAsync INICIADO.");
                VoltrisDiagnosticSystem.Instance.Timeline("FLOW", "ContinueNormalFlowAsync iniciado");

                // Trabalho de background: carregar ProfileStore (I/O de disco  NÃO deve estar na UI thread)
                bool needsOnboarding = true;
                Core.SystemIntelligenceProfiler.ProfilerState? profileState = null;
                try
                {
                    var result = await Task.Run(() =>
                    {
                        LogToFile($"[FLOW-BG][TID:{Thread.CurrentThread.ManagedThreadId}] Carregando ProfileStore...");
                        var profileStore = new Core.SystemIntelligenceProfiler.ProfileStore();
                        var state = profileStore.Load();
                        LogToFile("[FLOW-BG] ProfileState carregado.");

                        var onboardingService = new VoltrisOptimizer.Services.OnboardingService();
                        bool isNeeded = !state.QuestionnaireCompleted || !onboardingService.HasCompletedOnboarding();
                        return new { IsNeeded = isNeeded, State = state };
                    }).ConfigureAwait(true); // ConfigureAwait(true) = retornar para UI thread aps await

                    needsOnboarding = result.IsNeeded;
                    profileState = result.State;
                }
                catch (Exception ex)
                {
                    LogToFile($"[FLOW-BG] Erro ao carregar ProfileStore: {ex.Message}");
                    needsOnboarding = false; // Fallback seguro: ir para Dashboard
                }

// Agora estamos de volta na UI thread (ConfigureAwait(true))
                LogToFile($"[FLOW-UI][TID:{Thread.CurrentThread.ManagedThreadId}] Decidindo fluxo. needsOnboarding={needsOnboarding}");
                VoltrisDiagnosticSystem.Instance.Timeline("FLOW", $"Decisao de fluxo: needsOnboarding={needsOnboarding}");

                // === FLUXO NORMAL DE ONBOARDING ===
                if (needsOnboarding)
                {
                    LogToFile("[FLOW-UI] Onboarding necessário - iniciando fluxo");
                    _isLockedForOnboarding = true;
                    DisableSidebarCompletely();

                    try { GlobalProgressService.Instance.StartOperation(LocalizationService.Instance.GetString("ConfiguringProfile")); } catch { }

                    if (profileState != null && profileState.QuestionnaireCompleted)
                    {
                        // Questionário já concluído: a página "Relatório DNA" não
                        // existe mais. As otimizações que ela aplicava rodam no
                        // primeiro clique do botão circular, então o app segue
                        // direto para o Dashboard.
                        LogToFile("[FLOW-UI] Questionário concluído. O pacote de otimizações roda no 1º clique do botão circular.");
                        NavigateToDashboard();
                    }
                    else
                    {
                        LogToFile("[FLOW-UI] Onboarding pendente. Direcionando para ProfilerQuestionnaireView.");
                        // Se a construção da view lançar (XAML inválido, recurso
                        // faltando), a exceção sobe até o catch externo de
                        // ContinueNormalFlowAsync e o ContentFrame fica VAZIO —
                        // sintoma idêntico a "a página não carrega". Por isso o
                        // log de diagnóstico é escrito aqui também, com o
                        // detalhe da exceção.
                        VoltrisOptimizer.Core.SystemIntelligenceProfiler.UI.Views.ProfilerViewDebug.Log("[MainWindow] instanciando ProfilerQuestionnaireView...");
                        try
                        {
                            var questionnaireView = new Core.SystemIntelligenceProfiler.UI.Views.ProfilerQuestionnaireView();
                            ContentFrame.Content = questionnaireView;
                            VoltrisOptimizer.Core.SystemIntelligenceProfiler.UI.Views.ProfilerViewDebug.Log("[MainWindow] view atribuida ao ContentFrame OK");
                        }
                        catch (Exception viewEx)
                        {
							VoltrisOptimizer.Core.SystemIntelligenceProfiler.UI.Views.ProfilerViewDebug.LogExceptionChain("[MainWindow] FALHA ao criar a view:", viewEx);
                            LogToFile("[FLOW-UI] FALHA ao montar a tela de Perfil Inteligente: " + viewEx.Message);
                            // Não engolir: sem view, o primeiro uso não tem para onde ir.
                            NavigateToDashboard();
                        }
                    }
                }
                else
                {
                    LogToFile("[FLOW-UI] Onboarding NÃO necessário - indo para Dashboard");
                    try { GlobalProgressService.Instance.FinalizeOperation(LocalizationService.Instance.GetString("ConfiguringProfile"), string.Empty); } catch { }
                    NavigateToDashboard();
                }

                // Verificao de agendamento pendente do Prepare PC (silenciosa, no-bloqueante).
                try
                {
                    var flowController = new VoltrisOptimizer.Core.PreparePc.PreparePcFlowController(
                        ContentFrame,
                        App.LoggingService,
                        onComplete: () => NavigateToDashboard());
                    flowController.ExecuteScheduledPreparePcIfPending();
                }
                catch (Exception ex)
                {
                    LogToFile($"Erro ao verificar agendamento pendente: {ex.Message}");
                }

                VoltrisDiagnosticSystem.Instance.Timeline("FLOW", "ContinueNormalFlowAsync concludo");
            }
            catch (Exception ex)
            {
                LogToFile($"ERRO CRTICO em ContinueNormalFlowAsync: {ex.Message}");
                VoltrisDiagnosticSystem.Instance.Timeline("FLOW-ERROR", $"ContinueNormalFlowAsync falhou: {ex.Message}");
                if (!_isLockedForOnboarding) NavigateToDashboard();
            }
        }



        private void ShowOnboardingFlow()
        {
            try
            {
                var onboardingView = new OnboardingView();
                onboardingView.OnboardingCompleted += (s, e) =>
                {
                    try
                    {
                        // Aps tutorial, mostrar o Questionrio do Profiler
                        // O sidebar continua BLOQUEADO
                        var questionnaire = new VoltrisOptimizer.Core.SystemIntelligenceProfiler.UI.Views.ProfilerQuestionnaireView();
                        if (ContentFrame != null)
                        {
                            ContentFrame.Content = questionnaire;
                        }
                    }
                    catch (Exception ex)
                    {
                        LogToFile($"ERRO aps onboarding: {ex.Message}");
Dispatcher.InvokeAsync(() => NavigateToDashboard(), System.Windows.Threading.DispatcherPriority.ApplicationIdle);
                    }
                };
                
                // Substituir contedo atual pelo onboarding
                if (ContentFrame != null)
                {
                    ContentFrame.Content = onboardingView;
                }
            }
            catch (Exception ex)
            {
                LogToFile($"ERRO ao mostrar onboarding: {ex.Message}");
                Dispatcher.InvokeAsync(async () => { await System.Threading.Tasks.Task.Delay(200); NavigateToDashboard(); }, System.Windows.Threading.DispatcherPriority.ApplicationIdle);
            }
        }

        /// <summary>
        /// Vai para o Dashboard e destrava o app (gate + sidebar).
        /// Público porque o questionário de Perfil Inteligente é a última etapa
        /// do primeiro uso e precisa destravar ao concluir.
        /// </summary>
        public void NavigateToDashboard()
        {
            try {
                LogToFile("[NAV] NavigateToDashboard INICIADO.");
                if (NeedsOnboarding())
                {
                    LogToFile("[NAV] Ignorando NavigateToDashboard pois o Onboarding ainda está ativo/pendente.");
                    return;
                }
                _gateLocked = false;
                _isLockedForOnboarding = false;
                EnableSidebar();
                
                try { 
                    LogToFile("[NAV] Purgando operações de progresso antigas...");
                    GlobalProgressService.Instance.PurgeStaleOperations(TimeSpan.FromMinutes(2)); 
                } catch { }
                try { GlobalProgressService.Instance.FinalizeOperation(LocalizationService.Instance.GetString("ConfiguringProfile"), string.Empty); } catch { }
                
                LogToFile("[NAV] Agendando NavigateToPageSafe('Dashboard') no Dispatcher (ApplicationIdle)...");
                Dispatcher.InvokeAsync(() => {
                    LogToFile("[NAV-UI] Executando NavigateToPageSafe('Dashboard')...");
                    VoltrisDiagnosticSystem.Instance.Timeline("NAV", "NavigateToPageSafe('Dashboard') iniciado");
                    VoltrisDiagnosticSystem.Instance.BeginUIOperation("NavigateToDashboard");
                    NavigateToPageSafe("Dashboard");
                    VoltrisDiagnosticSystem.Instance.EndUIOperation("NavigateToDashboard");
                    
                    if (NavDashboard != null) {
                        LogToFile("[NAV-UI] Atualizando seleo visual do boto Dashboard.");
                        UpdateButtonSelectionSafe(NavDashboard);
                    }
                    LogToFile("[NAV-UI] Finalizado.");
                }, System.Windows.Threading.DispatcherPriority.ApplicationIdle);
            } 
            catch (Exception ex) { 
                LogToFile($"[NAV] ERRO em NavigateToDashboard: {ex.Message}");
                NavigateToPageSafe("Dashboard"); 
            }
        }

        public void UnlockGate()
        {
            _gateLocked = false;
            if (NeedsOnboarding())
            {
                App.LoggingService?.LogWarning("[MainWindow] UnlockGate ignorado para _isLockedForOnboarding pois onboarding  necessário.");
                return;
            }
            _isLockedForOnboarding = false;
            EnableSidebar();
        }

        /// <summary>
        /// Desabilita sidebar quando licença expirou (bloqueio profissional nvel SaaS)
        /// </summary>
        public void DisableSidebarForExpiredLicense()
        {
            App.LoggingService?.LogWarning("[MainWindow] DisableSidebarForExpiredLicense - bloqueando sidebar por licença expirada");
            
            _isLicenseBlocked = true;
            if (!NeedsOnboarding())
            {
                _isLockedForOnboarding = false; // Limpar trava de onboarding
            }
            
            // Desabilitar todos os botes exceto Dashboard e License Activation
            var buttons = new[] { NavPerformance, NavNetwork, NavSystem, NavGamer, NavDiagnostics, NavHistory, NavScheduler, NavShield, NavRepair, NavPersonalize, NavDisplay, NavSecurity, NavPrivacy, NavDebloat, NavRecovery, NavDrivers, NavDeviceInfo, NavBenchmark, NavStreamHub, NavShortcuts };
            
            foreach (var btn in buttons)
            {
                if (btn != null)
                {
                    btn.IsEnabled = false;
                    btn.Opacity = 0.5;
                    App.LoggingService?.LogTrace($"[MainWindow] Boto '{btn.Name}' desabilitado por licença expirada");
                }
            }
            
            // Manter Dashboard e License Activation habilitados
            if (NavDashboard != null)
            {
                NavDashboard.IsEnabled = true;
                NavDashboard.Opacity = 1.0;
                App.LoggingService?.LogInfo("[MainWindow] Boto Dashboard mantido habilitado (pgina inicial)");
            }
            
            App.LoggingService?.LogSuccess("[MainWindow] Sidebar bloqueado com sucesso - apenas Dashboard disponível");
        }

        /// <summary>
        /// Habilita todos os botes da sidebar (aps completar onboarding ou ativar licença)
        /// </summary>
        private bool NeedsOnboarding()
        {
            try
            {
                var profileStore = new Core.SystemIntelligenceProfiler.ProfileStore();
                var state = profileStore.Load();
                var onboardingService = new VoltrisOptimizer.Services.OnboardingService();
                bool needs = !state.QuestionnaireCompleted || !onboardingService.HasCompletedOnboarding();
                LogToFile($"[NeedsOnboarding] Resultado: {needs} (QuestionnaireCompleted={state.QuestionnaireCompleted})");
                return needs;
            }
            catch (Exception ex)
            {
                LogToFile($"Erro ao verificar NeedsOnboarding: {ex.Message}");
                return false;
            }
        }

        public void EnableSidebar()
        {
            App.LoggingService?.LogInfo("[MainWindow] EnableSidebar - habilitando sidebar completa");
            
            _isLicenseBlocked = false;

            if (NeedsOnboarding())
            {
                App.LoggingService?.LogInfo("[MainWindow] EnableSidebar ignorado pois o Onboarding ainda está ativo/pendente.");
                return;
            }

            _isLockedForOnboarding = false;
            var buttons = new[] { NavDashboard, NavPerformance, NavNetwork, NavSystem, NavGamer, NavDiagnostics, NavHistory, NavScheduler, NavShield, NavRepair, NavPersonalize, NavDisplay, NavSecurity, NavPrivacy, NavDebloat, NavRecovery, NavDrivers, NavDeviceInfo, NavBenchmark, NavStreamHub, NavShortcuts };
            foreach (var btn in buttons.Where(b => b != null))
            {
                btn.IsEnabled = true;
                btn.Opacity = 1.0; 
            }
            
            // Habilitar header tambm
            if (SettingsButton != null) { SettingsButton.IsEnabled = true; SettingsButton.Opacity = 1.0; }
            if (ActivateLicenseHeaderButton != null) { ActivateLicenseHeaderButton.IsEnabled = true; ActivateLicenseHeaderButton.Opacity = 1.0; }
            if (ShieldHeaderButton != null) { ShieldHeaderButton.IsEnabled = true; ShieldHeaderButton.Opacity = 1.0; }
            if (ThemeToggleButton != null) { ThemeToggleButton.IsEnabled = true; ThemeToggleButton.Opacity = 1.0; }
            if (TransparencyToggleButton != null) { TransparencyToggleButton.IsEnabled = true; TransparencyToggleButton.Opacity = 1.0; }
            if (WidgetToggleButton != null) { WidgetToggleButton.IsEnabled = true; WidgetToggleButton.Opacity = 1.0; }
            if (NotificationBellButton != null) { NotificationBellButton.IsEnabled = true; NotificationBellButton.Opacity = 1.0; }
        }

        

        
        
