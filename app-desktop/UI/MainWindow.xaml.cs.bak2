        private void WidgetToggleButton_Click(object sender, RoutedEventArgs e)
        {
            if (_isLockedForOnboarding)
            {
                LockModal.Show();
                return;
            }
            try
            {
                var widgetManager = App.WidgetManager;
                if (widgetManager == null)
                {
                    App.LoggingService?.LogWarning("[MainWindow] WidgetManager é null, não é possível controlar widget");
                    return;
                }

                widgetManager.ToggleWidget();
                App.LoggingService?.LogInfo("[MainWindow] ToggleWidget acionado via header button");
            }
            catch (Exception ex)
            {
                App.LoggingService?.LogError($"[MainWindow] Erro ao alternar widget: {ex.Message}", ex);
            }
        }

        private void UpdateWidgetToggleIcon(bool isVisible)
        {
            if (WidgetToggleIcon == null) return;
            try
            {
                if (isVisible)
                {
                    // Verde quando ativo
                    WidgetToggleIcon.Fill = new System.Windows.Media.SolidColorBrush(System.Windows.Media.Color.FromRgb(34, 197, 94)); // #22C55E
                }
                else
                {
                    // Cinza/Azulado quando desativado
                    WidgetToggleIcon.Fill = new System.Windows.Media.SolidColorBrush(System.Windows.Media.Color.FromRgb(100, 116, 139)); // #64748B
                }
            }
            catch (Exception ex)
            {
                App.LoggingService?.LogWarning($"[MainWindow] Erro ao atualizar ícone do widget: {ex.Message}");
            }
        }

        private void ThemeToggleButton_Click(object sender, RoutedEventArgs e)
        {
            if (_isLockedForOnboarding)
            {
                LockModal.Show();
                return;
            }
            try
            {
                var settings = SettingsService.Instance.Settings;
                bool isCurrentlyLight = settings.Theme?.Equals("Light", StringComparison.OrdinalIgnoreCase) == true;
                bool goLight = !isCurrentlyLight;
                settings.Theme = goLight ? "Light" : "Dark";
                SettingsService.Instance.SaveSettings();
                ApplyThemeAndTransparency(settings.Theme, settings.EnableTransparency);
                UpdateThemeToggleIcon(goLight);
                
                // Sincronizar SettingsView se estiver visível
                SyncSettingsViewFromHeader();
            }
            catch (Exception ex)
            {
                App.LoggingService?.LogError("[Header] Erro ao alternar tema", ex);
            }
        }

        private void TransparencyToggleButton_Click(object sender, RoutedEventArgs e)
        {
            if (_isLockedForOnboarding)
            {
                LockModal.Show();
                return;
            }
            try
            {
                var settings = SettingsService.Instance.Settings;
                bool enable = !settings.EnableTransparency;
                settings.EnableTransparency = enable;
                SettingsService.Instance.SaveSettings();
                ApplyThemeAndTransparency(settings.Theme, enable);
                UpdateTransparencyToggleIcon(enable);
                
                // SINCRONIZAR WIDGET EM TEMPO REAL
                App.WidgetManager?.UpdateTransparency(enable);
                
                // Sincronizar SettingsView se estiver visível
                SyncSettingsViewFromHeader();
            }
            catch (Exception ex)
            {
                App.LoggingService?.LogError("[Header] Erro ao alternar transparncia", ex);
            }
        }

        private void NotificationBellButton_Click(object sender, RoutedEventArgs e)
        {
            if (_isLockedForOnboarding)
            {
                LockModal.Show();
                return;
            }
            try
            {
                if (NotificationDrawerControl != null && 
                    NotificationDrawerControl.DataContext is VoltrisOptimizer.UI.ViewModels.NotificationDrawerViewModel vm)
                {
                    vm.IsOpen = !vm.IsOpen;
                }
            }
            catch (Exception ex)
            {
                App.LoggingService?.LogError($"[Header] Erro ao alternar Notification Drawer: {ex.Message}");
            }
        }

        /// <summary>
        /// Aplica tema e transparncia na ordem correta:
        /// 1. Transparncia (Off/On)  define brushes base
        /// 2. Tema (Dark/Light)  sobresscreve por cima, garantindo que o tema vença
        /// 3. Backdrop DWM
        /// </summary>
        private void ApplyThemeAndTransparency(string? theme, bool transparency)
        {
            var dicts = Application.Current.Resources.MergedDictionaries;

            // Remover todos os dicionrios de tema e transparncia
            for (int i = dicts.Count - 1; i >= 0; i--)
            {
                var src = dicts[i].Source?.ToString() ?? string.Empty;
                if (src.EndsWith("DarkTheme.xaml",           StringComparison.OrdinalIgnoreCase) ||
                    src.EndsWith("LightTheme.xaml",          StringComparison.OrdinalIgnoreCase) ||
                    src.EndsWith("TransparencyOn.xaml",      StringComparison.OrdinalIgnoreCase) ||
                    src.EndsWith("TransparencyOff.xaml",     StringComparison.OrdinalIgnoreCase) ||
                    src.EndsWith("LightTransparencyOn.xaml", StringComparison.OrdinalIgnoreCase))
                    dicts.RemoveAt(i);
            }

            bool isLight = theme?.Equals("Light", StringComparison.OrdinalIgnoreCase) == true;

            // 1. Tema base  define todas as cores slidas do tema
            dicts.Add(new ResourceDictionary
            {
                Source = new Uri(isLight ? "/UI/Themes/LightTheme.xaml" : "/UI/Themes/DarkTheme.xaml", UriKind.Relative)
            });

            // 2. Transparência por cima  sobresscreve fundos com versões semi-transparentes
            //    Dark+transparência: TransparencyOn.xaml sobresscreve DarkBrush/DarkPanelBrush etc.
            //    Light+transparência: LightTransparencyOn.xaml sobresscreve com versões claras semi-transparentes
            //    Sem transparência: TransparencyOff.xaml (brushes sólidos, sem efeito)
            if (transparency)
            {
                if (isLight)
                {
                    dicts.Add(new ResourceDictionary
                    {
                        Source = new Uri("/UI/Themes/LightTransparencyOn.xaml", UriKind.Relative)
                    });
                }
                else
                {
                    dicts.Add(new ResourceDictionary
                    {
                        Source = new Uri("/UI/Themes/TransparencyOn.xaml", UriKind.Relative)
                    });
                }
            }
            else
            {
                dicts.Add(new ResourceDictionary
                {
                    Source = new Uri("/UI/Themes/TransparencyOff.xaml", UriKind.Relative)
                });
            }

            // 3. Backdrop DWM  só faz sentido com transparência ativa
            ApplyWindowTransparency(transparency);
        }

