        /// <summary>
        /// Aplica bordas arredondadas nativas do Windows 11 quando disponvel
        /// </summary>
        private void Window_SourceInitialized(object sender, EventArgs e)
        {
            LogToFile("===== Window_SourceInitialized INICIADO =====");
            try
            {
                var hwnd = new WindowInteropHelper(this).Handle;
                _hwnd = hwnd;
                LogToFile($"[SourceInitialized] Handle obtido: 0x{hwnd:X8}");

                SetWindowIcon(hwnd);
                CreateDummyWindow();
                LogToFile($"[SourceInitialized] ícone e dummy window configurados");

                // FIX CRÍTICO WINDOWS 10: Definir background sólido ANTES de aplicar acrylic
                // Background transparente (#00FFFFFF) no XAML quebra o acrylic no Windows 10
                if (Environment.OSVersion.Version.Build < 22000)
                {
                    LogToFile("[SourceInitialized] Windows 10 detectado - definindo background sólido temporário para acrylic");
                    this.Background = new SolidColorBrush(System.Windows.Media.Color.FromRgb(30, 30, 46)); // Cor base escura sólida
                    this.Opacity = 1.0;
                }

                if (_settings?.Settings != null)
                {
                    LogToFile($"[SourceInitialized] Settings disponível | EnableTransparency={_settings.Settings.EnableTransparency}");
                    
                    // CORREÇÃO PROBLEMA 3: Sincronizar botão do header ANTES de aplicar transparência
                    // Isso garante que o ícone já nasce azul se Acrylic estiver ativo
                    bool isLight = _settings.Settings.Theme?.Equals("Light", StringComparison.OrdinalIgnoreCase) == true;
                    UpdateThemeToggleIcon(isLight);
                    UpdateTransparencyToggleIcon(_settings.Settings.EnableTransparency);
                    LogToFile($"[SourceInitialized] Botões do header sincronizados | AcrylicAtivo={_settings.Settings.EnableTransparency}");
                    
                    ApplyWindowTransparency(_settings.Settings.EnableTransparency);
                    
                    // Atualizar estado interno do VisualEffectsManager
                    VoltrisOptimizer.Helpers.VisualEffectsManager.SetAcrylicState(_settings.Settings.EnableTransparency);
                    
                    // FIX: Verificar consistência após aplicar transparência no startup
                    VerifyAcrylicConsistency();
                }
                else
                {
                    LogToFile($"[SourceInitialized] Settings é NULL");
                }
                
                // FIX: Forçar update de layout após inicialização para corrigir bug de clipping na primeira renderização
                LogToFile($"[SourceInitialized] Agendando update de layout em DispatcherPriority.Render");
                Dispatcher.InvokeAsync(() =>
                {
                    LogToFile($"[SourceInitialized-Callback] Iniciando InvalidateVisual/UpdateLayout");
                    InvalidateVisual();
                    UpdateLayout();
                    if (RootContainer != null)
                    {
                        RootContainer.UpdateLayout();
                        LogToFile($"[SourceInitialized-Callback] RootContainer atualizado | Size={RootContainer.ActualWidth}x{RootContainer.ActualHeight}");
                    }
                    LogToFile($"[SourceInitialized-Callback] COMPLETADO");
                }, System.Windows.Threading.DispatcherPriority.Render);
                
                LogToFile($"===== Window_SourceInitialized COMPLETADO =====");
            }
            catch (Exception ex)
            {
                string msg = $"[SourceInitialized] ERRO: {ex.Message}";
                LogToFile(msg);
                App.LoggingService?.LogWarning(msg);
            }
        }

        /// <summary>
        /// Aplica ou remove o efeito acrylic/blur na janela principal.
        /// Chamado no startup e quando o usuário altera a configuração nas Settings.
        /// </summary>
        public void ApplyWindowTransparency(bool enabled)
        {
            try
            {
                LogToFile($"[TRANSPARENCY] ApplyWindowTransparency INICIADO | enabled={enabled}");
                
                if (enabled)
                {
                    bool isLight = _settings.Settings.Theme?.Equals("Light", StringComparison.OrdinalIgnoreCase) == true;
                    LogToFile($"[TRANSPARENCY] Aplicando Acrylic | isLight={isLight}");
                    VoltrisOptimizer.UI.Helpers.BackdropHelper.ApplyModernBackdrop(this, VoltrisOptimizer.UI.Helpers.BackdropHelper.SystemBackdropType.Acrylic, isLight);
                    LogToFile($"[TRANSPARENCY] ApplyModernBackdrop chamado");
                }
                else
                {
                    LogToFile($"[TRANSPARENCY] Removendo backdrop");
                    VoltrisOptimizer.UI.Helpers.BackdropHelper.RemoveBackdrop(this);
                }
                
                LogToFile($"[TRANSPARENCY] ApplyWindowTransparency COMPLETADO");
            }
            catch (Exception ex)
            {
                string msg = $"[TRANSPARENCY] ERRO: {ex.Message}";
                LogToFile(msg);
                App.LoggingService?.LogWarning(msg);
            }
        }
        
        /// <summary>
        /// Define o ícone da janela usando Win32 API para garantir que aparea na barra de tarefas e Alt+Tab
        /// </summary>
        private void SetWindowIcon(IntPtr hwnd)
        {
            try
            {
                // Carregar do recurso embutido (mais seguro que arquivo solto)
                var iconUri = new Uri("pack://application:,,/Images/favicon.ico");
                var resourceInfo = Application.GetResourceStream(iconUri);
                
                if (resourceInfo != null)
                {
                    using (var iconStream = resourceInfo.Stream)
                    {
                        // Carregar o .ico completo - Windows escolhe automaticamente as melhores resoluções
                        var icon = new System.Drawing.Icon(iconStream);
                        
                        // Definir ícone grande (usado na barra de tarefas e Alt+Tab)
                        // O Windows seleciona automaticamente a melhor resolução do .ico
                        Win32.SendMessage(hwnd, Win32.WM_SETICON, new IntPtr(1), icon.Handle); // ICON_BIG
                        
                        // Definir ícone pequeno (usado na barra de ttulo)
                        Win32.SendMessage(hwnd, Win32.WM_SETICON, new IntPtr(0), icon.Handle); // ICON_SMALL
                        
                        // Tambm definir via SetClassLongPtr para garantir persistncia
                        Win32.SetClassLongPtrSafe(hwnd, Win32.GCL_HICON, icon.Handle);
                        Win32.SetClassLongPtrSafe(hwnd, Win32.GCL_HICONSM, icon.Handle);
                        
                        // Forçar atualização do ícone WPF tambm
                        try 
                        {
                            iconStream.Position = 0;
                            this.Icon = System.Windows.Media.Imaging.BitmapFrame.Create(
                                iconStream,
                                System.Windows.Media.Imaging.BitmapCreateOptions.None,
                                System.Windows.Media.Imaging.BitmapCacheOption.OnLoad
                            );
                        }
                        catch (Exception ex)
                        {
                            App.LoggingService?.LogWarning($"Erro ao definir this.Icon WPF: {ex.Message}");
                        }

                        App.LoggingService?.LogInfo("Íícone da janela definido com sucesso (multi-resolução)");
                    }
                }
            }
            catch (Exception ex)
            {
                App.LoggingService?.LogWarning($"Erro ao definir ícone da janela: {ex.Message}");
            }
        }
        
        /// <summary>
        /// FIX: Verifica e corrige inconsistências do acrylic após startup do Windows
        /// </summary>
        private void VerifyAcrylicConsistency()
        {
            try
            {
                bool expectedTransparency = _settings?.Settings?.EnableTransparency ?? true;
                bool actualAcrylicState = VisualEffectsManager.IsAcrylicEnabled();
                
                if (expectedTransparency != actualAcrylicState)
                {
                    LogToFile($"[VERIFY] Inconsistência detectada! EnableTransparency={expectedTransparency}, IsAcrylicEnabled={actualAcrylicState}");

                    // Estado interno não reflete a aplicação real (ex.: startup minimizado).
                    // Reagendar para o próximo idle, quando a janela estiver apresentada,
                    // em vez de aplicar na hora (que falha em janela minimizada/oculta).
                    LogToFile("[VERIFY] Reagendando aplicação de Acrylic no próximo idle (janela apresentada)...");
                    Dispatcher.BeginInvoke(new Action(() =>
                    {
                        try
                        {
                            ApplyWindowTransparency(expectedTransparency);
                            VoltrisOptimizer.Helpers.VisualEffectsManager.SetAcrylicState(expectedTransparency);
                            LogToFile("[VERIFY] Acrylic aplicado (deferred)");
                        }
                        catch (Exception ex)
                        {
                            LogToFile($"[VERIFY] Erro ao aplicar Acrylic (deferred): {ex.Message}");
                        }
                    }), System.Windows.Threading.DispatcherPriority.ApplicationIdle);
                }
                else
                {
                    LogToFile($"[VERIFY] Acrylic consistente: {expectedTransparency}");
                }
            }
            catch (Exception ex)
            {
                LogToFile($"[VERIFY] Erro na verificação de consistência: {ex.Message}");
            }
        }
        
        /// <summary>
        /// Aplica regio arredondada  janela (fallback para Windows 10)
        protected override void OnSourceInitialized(EventArgs e)
        {
            base.OnSourceInitialized(e);
            _hwnd = new WindowInteropHelper(this).Handle;
            
            HwndSource? source = HwndSource.FromHwnd(_hwnd);
            source?.AddHook(WndProc);
            
            LogToFile($"[MainWindow] WndProc Hook registrado no HWND: {_hwnd}");

            // ── CENTRALIZAÇÃO EXPLÍCITA E LOGADA ────────────────────────
            //
            // BUG ORIGINAL: a centralização era feita aqui, em OnSourceInitialized,
            // lendo `SystemParameters.WorkArea` e `Width`/`ActualWidth`.
            //
            // São dois defeitos independentes, e ambos precisam ser corrigidos:
            //
            //  1) TIMING. Este ponto ainda pode ser anterior ao layout final. Com
            //     Width/Height agora declarados no XAML, o tamanho já é conhecido
            //     e determinístico, então o centro aqui já sai correto — mas
            //     continua havendo uma rede de segurança em OnContentRendered.
            //
            //  2) MONITOR ERRADO. `SystemParameters.WorkArea` é SEMPRE a área do
            //     monitor PRIMÁRIO. Em um setup com dois monitores, ou com DPI
            //     misto (o app é PerMonitorV2), centralizar por aí põe a janela
            //     no monitor errado e com escala errada. A área correta vem de
            //     GetMonitorInfo do monitor em que a janela realmente está.
            //
            // WindowPlacementHelper centraliza em PIXELS FÍSICOS (both operands
            // from Win32) e converte uma única vez no fim, evitando erro de DPI
            // acumulado. Também refuse maximizada/minimizada, onde SetWindowPos
            // seria ignorado.
            try
            {
                if (WindowPlacementHelper.CenterOnCurrentMonitor(this))
                {
                    var area = System.Windows.SystemParameters.WorkArea;
                    LogToFile(
                        $"[MAINWINDOW][STARTUP-POS] Centralizado no monitor atual: " +
                        $"{WindowPlacementHelper.ResolveManagedWidth(this):F0}x" +
                        $"{WindowPlacementHelper.ResolveManagedHeight(this):F0} " +
                        $"em ({Left:F0}, {Top:F0}) | WorkArea primário " +
                        $"{area.Left:F0},{area.Top:F0} {area.Width:F0}x{area.Height:F0}");
                }
                else
                {
                    LogToFile("[MAINWINDOW][STARTUP-POS] Centralização adiada (janela sem geometria válida).");
                }
            }
            catch (Exception ex)
            {
                LogToFile($"[MAINWINDOW][STARTUP-POS] Falha ao centralizar: {ex.Message}");
            }
            
            CreateDummyWindow();
        }

        /// <summary>
        /// Rede de segurança da centralização: reexecuta o centro depois que a
        /// janela passou pelo primeiro layout e render real.
        ///
        /// POR QUE ISSO É NECESSÁRIO
        /// ===========================
        /// OnSourceInitialized dispara quando o HWND é criado, o que é cedo demais
        /// para garantir o tamanho final. ContentRendered dispara DEPOIS do primeiro
        /// quadro desenhado — nesse ponto o DesiredSize do conteúdo já é o definitivo
        /// e qualquer elemento que tenha crescido (conteúdo que carrega de forma
        /// assíncrona, sidebar expandida, colunas do dashboard carregadas) já
        /// estabilizou.
        ///
        /// POR QUE É ESTRITAMENTE UMA ÚNICA VEZ
        /// ====================================
        /// ContentRendered também é disparado a cada Show() posterior — ou seja,
        /// quando o usuário restaura a janela da bandeja. Centralizar de novo
        /// nesse momento sobrescreveria a posição que o usuário escolheu ao
        /// arrastar. Por isso a trava é marcada ANTES de qualquer condição de
        /// saída: esta rotina pertence à ABERTURA, e só à abertura.
        /// </summary>
        protected override void OnContentRendered(EventArgs e)
        {
            base.OnContentRendered(e);

            if (_startupPositionFinalized)
                return;

            // Marca de forma incondicional: esta é a última chance de rodar, e
            // rodar mais de uma vez sobrescreveria a posição do usuário.
            _startupPositionFinalized = true;

            try
            {
                // Iniciando minimizado, a janela não tem geometria presented e a
                // posição já foi resolvida em OnSourceInitialized. Nada a fazer.
                if (WindowState != WindowState.Normal)
                {
                    LogToFile("[MAINWINDOW][STARTUP-POS] Janela não está Normal na primeira renderização; centralização final não aplicada.");
                    return;
                }

                double finalWidth = WindowPlacementHelper.ResolveManagedWidth(this);
                double finalHeight = WindowPlacementHelper.ResolveManagedHeight(this);
                if (finalWidth <= 0 || finalHeight <= 0)
                    return;

                if (WindowPlacementHelper.CenterOnCurrentMonitor(this))
                {
                    LogToFile(
                        $"[MAINWINDOW][STARTUP-POS] Centralização final confirmada: " +
                        $"{finalWidth:F0}x{finalHeight:F0} em ({Left:F0}, {Top:F0})");
                }
            }
            catch (Exception ex)
            {
                _startupPositionFinalized = true;
                LogToFile($"[MAINWINDOW][STARTUP-POS] Falha na centralização final: {ex.Message}");
            }
        }

        private void CreateDummyWindow()
        {
            try
            {
                if (_dummySource != null) return;
                var p = new HwndSourceParameters("VoltrisOptimizer.Hidden");
                p.Width = 0;
                p.Height = 0;
                p.PositionX = -32000;
                p.PositionY = -32000;
                p.WindowStyle = unchecked((int)0x80000000);
                p.ExtendedWindowStyle = Win32WindowHelper.WS_EX_TOOLWINDOW;
                _dummySource = new HwndSource(p);
            }
            catch { }
        }

        private void HideToTray()
        {
            try
            {
                if (_hwnd == IntPtr.Zero) _hwnd = new WindowInteropHelper(this).Handle;
                Win32WindowHelper.RemoveExStyle(_hwnd, Win32WindowHelper.WS_EX_APPWINDOW);
                Win32WindowHelper.AddExStyle(_hwnd, Win32WindowHelper.WS_EX_TOOLWINDOW);
                ShowInTaskbar = false;
                Hide();
                Win32WindowHelper.ShowWindowAsync(_hwnd, Win32WindowHelper.SW_HIDE);
                // Atualizar rastreador de estado da bandeja
                ApplicationStateTracker.UpdateTrayState(true);
            }
            catch { }
        }

        private void RestoreFromTray()
        {
            try
            {
                if (_hwnd == IntPtr.Zero) _hwnd = new WindowInteropHelper(this).Handle;
                Win32WindowHelper.RemoveExStyle(_hwnd, Win32WindowHelper.WS_EX_TOOLWINDOW);
                Win32WindowHelper.AddExStyle(_hwnd, Win32WindowHelper.WS_EX_APPWINDOW);
                ShowInTaskbar = true;
                Show();
                WindowState = WindowState.Normal;
                Activate();
                Win32WindowHelper.ShowWindowAsync(_hwnd, Win32WindowHelper.SW_SHOW);
                Win32WindowHelper.SetForegroundWindow(_hwnd);
                // Atualizar rastreador de estado da bandeja
                ApplicationStateTracker.UpdateTrayState(false);

                // CORREÇÃO: Restaurar o efeito visual de fundo (Acrylic) ao restaurar da bandeja, 
                // pois ao esconder e mostrar a janela via Win32 o Windows pode perder o CompositionAttribute.
                // Aplicação é adiada até a janela estar realmente apresentada (idle), pois no Windows 10
                // uma aplicação imediata após ShowWindowAsync costuma ser descartada pelo DWM.
                if (_settings?.Settings != null && _settings.Settings.EnableTransparency)
                {
                    LogToFile("[MainWindow] Restaurando o efeito visual Acrylic após retornar do systray (após render).");
                    Dispatcher.BeginInvoke(new Action(() =>
                    {
                        try
                        {
                            ApplyWindowTransparency(true);
                        }
                        catch (Exception ex)
                        {
                            LogToFile($"[MainWindow] Erro ao reaplicar Acrylic no restore: {ex.Message}");
                        }
                    }), System.Windows.Threading.DispatcherPriority.ApplicationIdle);
                }
                
                // FIX: Verificar consistência do acrylic após restauração (startup do Windows)
                VerifyAcrylicConsistency();
            }
            catch { }
        }
        

        
        
        private async Task<System.Drawing.Icon?> LoadIconAsync()
        {
            return await Task.Run(() =>
            {
                System.Drawing.Icon? icon = null;

                try
                {
                    var iconUri = new Uri("pack://application:,,/Images/favicon.ico");
                    var resourceInfo = Application.GetResourceStream(iconUri);
                    if (resourceInfo != null)
                    {
                        using var stream = resourceInfo.Stream;
                        using var ms = new MemoryStream();
                        stream.CopyTo(ms);
                        ms.Position = 0;
                        icon = new System.Drawing.Icon(ms);
                        LogToFile($"Ícone carregado de recurso embutido em background thread");
                    }
                }
                catch (Exception ex)
                {
                    LogToFile($"Erro ao carregar ícone de recurso embutido: {ex.Message}");
                }

                if (icon == null)
                {
                    try
                    {
                        var iconPath = Path.Combine(AppDomain.CurrentDomain.BaseDirectory, "Images", "favicon.ico");
                        if (File.Exists(iconPath))
                        {
                            icon = new System.Drawing.Icon(iconPath);
                            LogToFile($"Ícone carregado de arquivo físico: {iconPath}");
                        }
                    }
                    catch (Exception ex)
                    {
                        LogToFile($"Erro ao carregar ícone de arquivo físico: {ex.Message}");
                    }
                }

                return icon;
            });
        }

        private async Task InitializeNotifyIconAsync()
        {
            LogToFile("InitializeNotifyIconAsync() - INÍCIO");
            try
            {
                var icon = await LoadIconAsync();
                icon ??= System.Drawing.SystemIcons.Application;

                LogToFile("Criando NotifyIcon na UI thread...");
                _notifyIcon = new WinForms.NotifyIcon
                {
                    Icon = icon,
                    Visible = true,
                    Text = ""
                };
                
                // CORREÇÃO: Garantir que o íícone do systray é removido mesmo quando o processo
                //  finalizado pelo Gerenciador de Tarefas (kill forado).
                // ProcessExit dispara mesmo em Environment.Exit e kill externo.
                var iconRef = _notifyIcon;
                AppDomain.CurrentDomain.ProcessExit += (s, e) =>
                {
                    try { iconRef.Visible = false; iconRef.Dispose(); } catch { }
                };
                
                LogToFile($"NotifyIcon criado - Visible: {_notifyIcon.Visible}, Text: {_notifyIcon.Text}");
                
                // Eventos
                _notifyIcon.MouseClick += NotifyIcon_MouseClick;
                _notifyIcon.DoubleClick += (s, e) => 
                {
                    LogToFile("NotifyIcon DoubleClick - chamando ShowWindow()");
                    ShowWindow();
                };

                // Modern tooltip: show on hover via MouseMove do NotifyIcon
                _notifyIcon.MouseMove += NotifyIcon_MouseMove;

                // Timer de delay para mostrar o tooltip (evita flash ao passar rapidamente)
                _tooltipShowTimer = new System.Windows.Threading.DispatcherTimer
                {
                    Interval = TimeSpan.FromMilliseconds(400)
                };
                _tooltipShowTimer.Tick += (s, e) =>
                {
                    _tooltipShowTimer.Stop();
                    ShowModernTooltip();
                };

                // Timer de polling: verifica se o mouse ainda está sobre o íícone do systray.
                // É a única forma confiável - WM_MOUSELEAVE não funciona bem com NotifyIcon
                // porque a janela do tooltip fica sobre o íícone e intercepta os eventos.
                // CORREO PERFORMANCE: 200ms  suficiente para detectar sada do mouse do ícone.
                // 100ms era desnecessariamente agressivo e gerava 10 ticks/s na UI thread.
                _tooltipMousePollTimer = new System.Windows.Threading.DispatcherTimer
                {
                    Interval = TimeSpan.FromMilliseconds(500)
                };
                _tooltipMousePollTimer.Tick += TooltipMousePollTimer_Tick;

                // Tooltip rico: atualizar com status do Shield + Perfil + Plano de Energia
                UpdateSystrayTooltip();

                // Subscrever a mudanas de perfil e plano de energia para atualizar tooltip
                SettingsService.Instance.ProfileChanged += (_, __) => UpdateSystrayTooltip();
                if (App.Services != null)
                {
                      // [FIX:UNICA-FONTE] A inscrição de `PlanChanged` saiu daqui.
                      //
                      // O evento vinha do `o servico legado`, o serviço
                      // legado de planos que foi removido. Note que a própria
                      // assinatura do método já avisava que resolver esses serviços
                      // causava cascata de injeção de dependência na thread da UI.
                      //
                      // A atualização do tooltip agora escuta o evento que realmente
                      // importa e já existe: `SettingsService.ProfileChanged`. É o
                      // mesmo evento que o `ProfilePowerCoordinator` consome para
                      // aplicar o perfil, então tooltip e energia ficam sempre
                      // coerentes — não há mais duas fontes de "qual plano está
                      // ativo" discordando entre si.
                      Task.Run(() =>
                      {
                          try
                          {
                              var shieldService = App.Services.GetService<VoltrisOptimizer.Services.Shield.VoltrisShieldService>();
                              if (shieldService != null)
                                  shieldService.StatusChanged += (_, __) => Dispatcher.BeginInvoke(() => UpdateSystrayTooltip());


                            var voltrisBlurService = App.Services.GetService<VoltrisOptimizer.Services.Personalize.VoltrisBlurService>();
                            if (voltrisBlurService != null)
                            {
                                voltrisBlurService.ExplorerRestarted += (_, __) =>
                                {
                                    TooltipLog("[ExplorerRestarted] Explorer reiniciando - suprimindo e destruindo tooltip para recalibragem.");
                                    _suppressTooltipUntil = DateTime.UtcNow.AddSeconds(6);
                                    Dispatcher.BeginInvoke(() => {
                                        _tooltipVisible = false;
                                        _tooltipShowTimer?.Stop();
                                        _tooltipMousePollTimer?.Stop();
                                        
                                        if (_modernTooltip != null)
                                        {
                                            try { _modernTooltip.Close(); } catch { }
                                            _modernTooltip = null;
                                        }
                                    });
                                };
                                TooltipLog("ExplorerRestarted event subscrito com sucesso.");
                            }
                        }
                        catch (Exception innerEx)
                        {
                            App.LoggingService?.LogError($"[InitializeNotifyIconAsync] Erro ao resolver serviços de background: {innerEx.Message}", innerEx);
                        }
                    });
                }
                
                LogToFile("InitializeNotifyIconAsync() - SUCESSO");
            }
            catch (Exception ex)
            {
                LogToFile($"ERRO CRTICO em InitializeNotifyIconAsync(): {ex.Message}\\n{ex.StackTrace}");
                App.LoggingService?.LogError($"Erro ao inicializar systray: {ex.Message}", ex);
            }
        }

        /// <summary>
        /// Atualiza os dados do ModernTrayTooltip com status atual.
        /// O tooltip clssico (NotifyIcon.Text)  mantido vazio intencionalmente.
        /// </summary>
        private void UpdateSystrayTooltip()
        {
            if (_notifyIcon == null) return;

            try
            {
                // Atualizar o tooltip moderno se estiver visível
                if (_modernTooltip != null && _modernTooltip.IsVisible)
                {
                    Dispatcher.BeginInvoke(() => RefreshModernTooltipData());
                }
            }
            catch (Exception ex)
            {
                App.LoggingService?.LogWarning($"[Systray] Erro ao atualizar tooltip: {ex.Message}");
            }
        }

        private void RefreshModernTooltipData()
        {
            if (_modernTooltip == null) return;
            var shieldService = App.Services?.GetService<VoltrisOptimizer.Services.Shield.VoltrisShieldService>();
            var shieldActive = shieldService?.IsProtectionActive ?? false;
              var profile = SettingsService.Instance.Settings.IntelligentProfile;

              // [FIX:UNICA-FONTE] Nome do perfil e nome do plano vêm do nosso
              // sistema, sem serviço legado.
              //
              // `GetProfileDisplayName` e `GetActivePlanDisplayName` viviam no
              // `o servico legado`. O que resta é ler o enum do perfil
              // e o plano ativo pela API do Windows — que é a mesma fonte que o
              // `ProfilePowerCoordinator` usa, então o tooltip não tem como
              // divergir do que está realmente aplicado.
              var profileName = profile.ToString();
              string planName;
              try
              {
                  planName = Utils.Win32.PowerNativeMethods.TryGetActiveSchemeGuid(out Guid active)
                      ? Utils.Win32.PowerNativeMethods.GetPlanName(active)
                      : "";
              }
              catch { planName = ""; }
            var version = Properties.VersionInfo.Version;
             var widgetVisible = _currentWidgetVisible;
            _modernTooltip.UpdateStatus(shieldActive, profileName, planName, version, widgetVisible);
        }

        // -- P/Invoke para obter posição real do cursor (independente de DPI/WinForms) --
        [DllImport("user32.dll")]
        private static extern bool GetCursorPos(out System.Drawing.Point lpPoint);

        // -- Shell_NotifyIconGetRect: obtm o rect exato do ícone no systray --
        [StructLayout(LayoutKind.Sequential)]
        private struct NOTIFYICONIDENTIFIER
        {
            public uint cbSize;
            public IntPtr hWnd;
            public uint uID;
            public Guid guidItem;
        }
        [DllImport("shell32.dll", SetLastError = true)]
        private static extern int Shell_NotifyIconGetRect(ref NOTIFYICONIDENTIFIER identifier, out RECT iconLocation);
        [StructLayout(LayoutKind.Sequential)]
        private struct RECT { public int Left, Top, Right, Bottom; }

        // .NET 8+ renomeou os campos internos de "id"/"window" para "_id"/"_window".
        // Tentamos ambas as variantes para compatibilidade com .NET 6/7/8+, mas
        // resolvemos UMA vez: GetTrayIconRect roda a cada MouseMove do tray.
        private static readonly System.Reflection.FieldInfo? _notifyIdField =
            typeof(WinForms.NotifyIcon)
                .GetField("_id", System.Reflection.BindingFlags.NonPublic | System.Reflection.BindingFlags.Instance)
            ?? typeof(WinForms.NotifyIcon)
                .GetField("id", System.Reflection.BindingFlags.NonPublic | System.Reflection.BindingFlags.Instance);

        private static readonly System.Reflection.FieldInfo? _notifyWindowField =
            typeof(WinForms.NotifyIcon)
                .GetField("_window", System.Reflection.BindingFlags.NonPublic | System.Reflection.BindingFlags.Instance)
            ?? typeof(WinForms.NotifyIcon)
                .GetField("window", System.Reflection.BindingFlags.NonPublic | System.Reflection.BindingFlags.Instance);

        private static bool _trayIconReflectionFailed;

        private static System.Collections.Concurrent.ConcurrentDictionary<Type, System.Reflection.PropertyInfo?> _handlePropertyCache
            = new System.Collections.Concurrent.ConcurrentDictionary<Type, System.Reflection.PropertyInfo?>();

        private static System.Reflection.PropertyInfo? GetCachedHandleProperty(object nativeWindow)
        {
            var type = nativeWindow.GetType();
            return _handlePropertyCache.GetOrAdd(type, t => t.GetProperty("Handle",
                System.Reflection.BindingFlags.Public | System.Reflection.BindingFlags.Instance));
        }

        // Caminho do log resolvido UMA vez. Antes, toda chamada de TooltipLog
        // fazia Directory.CreateDirectory + File.AppendAllText na thread de UI.
        // O diretório já existe depois do primeiro uso, então repetir o
        // CreateDirectory a cada evento era I/O puro e jogado fora.
        private static readonly string TooltipLogPath = Path.Combine(LogDirectoryResolver.Resolve(), "tooltip_debug.log");

        private void TooltipLog(string msg)
        {
            var line = $"[{DateTime.Now:HH:mm:ss.fff}] [TOOLTIP] {msg}";
            System.Diagnostics.Debug.WriteLine(line);
            try
            {
                lock (_tooltipLogLock)
                {
                    var dir = System.IO.Path.GetDirectoryName(TooltipLogPath);
                    if (!System.IO.Directory.Exists(dir))
                        System.IO.Directory.CreateDirectory(dir!);

                    System.IO.File.AppendAllText(TooltipLogPath, line + "\n", System.Text.Encoding.UTF8);
                }
            }
            catch { }
        }

        private System.Drawing.Rectangle GetTrayIconRect()
        {
            try
            {
                if (_notifyIcon == null) return System.Drawing.Rectangle.Empty;

                // Reflexo resolvido UMA vez. GetTrayIconRect roda a cada evento de
                // mouse sobre o tray (até 20x/s com o debounce de 50ms), e antes
                // fazia 5 GetField/GetProperty por chamada — varredura de metadados
                // repetida sem necessidade. O layout dos tipos do NotifyIcon não
                // muda em runtime, então o cache é seguro.
                if (_notifyIdField == null || _notifyWindowField == null)
                {
                    if (!_trayIconReflectionFailed)
                    {
                        _trayIconReflectionFailed = true;
                        TooltipLog("GetTrayIconRect: campos 'id' ou 'window' nao encontrados via reflexao");
                    }
                    return System.Drawing.Rectangle.Empty;
                }

                uint id = 0;
                try { id = Convert.ToUInt32(_notifyIdField.GetValue(_notifyIcon)); } catch { }
                var nativeWindow = _notifyWindowField.GetValue(_notifyIcon);
                if (nativeWindow == null) return System.Drawing.Rectangle.Empty;

                var handleProp = GetCachedHandleProperty(nativeWindow);
                IntPtr hWnd = (IntPtr)(handleProp?.GetValue(nativeWindow) ?? IntPtr.Zero);

                if (hWnd == IntPtr.Zero) return System.Drawing.Rectangle.Empty;

                var nid = new NOTIFYICONIDENTIFIER
                {
                    cbSize   = (uint)Marshal.SizeOf<NOTIFYICONIDENTIFIER>(),
                    hWnd     = hWnd,
                    uID      = id,
                    guidItem = Guid.Empty
                };

                int hr = Shell_NotifyIconGetRect(ref nid, out RECT r);

                if (hr == 0) // S_OK  ícone visvel na bandeja
                {
                    if (!_tooltipVisible)
                        TooltipLog($"GetTrayIconRect: S_OK rect=({r.Left},{r.Top},{r.Right},{r.Bottom})");
                    return System.Drawing.Rectangle.FromLTRB(r.Left, r.Top, r.Right, r.Bottom);
                }
                
                // hr == 1 (S_FALSE): íícone está na área de overflow (oculto).
                // O rect retornado aponta para o boto de overflow, no para o ícone real.
                // Retornar Empty para evitar tooltip em posio incorreta.
                if (hr == 1)
                    return System.Drawing.Rectangle.Empty;
            }
            catch (Exception ex)
            {
                TooltipLog($"GetTrayIconRect ERRO: {ex.Message}");
            }
            return System.Drawing.Rectangle.Empty;
        }

        private void NotifyIcon_MouseMove(object? sender, WinForms.MouseEventArgs e)
        {
            if (_isTrayContextMenuOpen) return;
            // Cooldown pós-restart do Explorer: evita que o tooltip reapareça imediatamente
            if (DateTime.UtcNow < _suppressTooltipUntil) return;

            // Debounce temporal e espacial para evitar Event Flood (e P/Invoke excessivo)
            GetCursorPos(out System.Drawing.Point realPos);
            
            var now = DateTime.UtcNow;
            if ((now - _lastMouseMoveTime).TotalMilliseconds < 50)
            {
                // Verifica movimento espacial (se no moveu mais de 3 pixels, ignora)
                if (Math.Abs(realPos.X - _lastMousePosForDebounce.X) < 3 && 
                    Math.Abs(realPos.Y - _lastMousePosForDebounce.Y) < 3)
                {
                    return;
                }
            }

            _lastMouseMoveTime = now;
            _lastMousePosForDebounce = realPos;

            // e.Location retorna (0,0) no NotifyIcon  usar GetCursorPos para posio real
            _lastMousePos = realPos;

            // CORREÇÃO CRÍTICA: Só disparar se o mouse estiver REALMENTE sobre o íícone.
            // Isso evita que o tooltip apareça do nada no startup ou se o mouse estiver em (0,0).
            var iconRect = GetTrayIconRect();
            if (iconRect.IsEmpty) 
            {
                // Se no conseguimos o rect, no podemos confirmar o hover com segurana.
                // Logamos mas no prosseguimos para evitar tooltips "fantasmas".
                return; 
            }

            // Adicionar uma margem de tolerncia de 5px.
            var toleranceRect = iconRect;
            toleranceRect.Inflate(5, 5);
            if (!toleranceRect.Contains(realPos))
            {
                // Mouse disparou o evento mas não está sobre o rect (evento espúrio do Windows)
                return;
            }

            // Rate-limit ANTES de qualquer log. Antes these guards vinham DEPOIS
            // do TooltipLog da linha seguinte, o que anulava a proteção: o log
            // rodava em TODO MouseMove enquanto o tooltip ainda não aparecia.
            if (_tooltipVisible) return;
            if (_tooltipShowTimer?.IsEnabled ?? false) return;

            TooltipLog($"MouseMove e.Location=({e.Location.X},{e.Location.Y}) realPos=({realPos.X},{realPos.Y}) _tooltipVisible={_tooltipVisible} showTimerActive={_tooltipShowTimer?.IsEnabled}");

            TooltipLog("MouseMove ? iniciando _tooltipShowTimer");
            _tooltipShowTimer?.Start();
        }

        /// <summary>
        /// Polling a cada 100ms: verifica se o mouse ainda está sobre o íícone do systray.
        /// Usa Shell_NotifyIconGetRect para obter o rect exato do íícone, sem depender de
        /// NotifyIcon.MouseMove (que para de disparar quando o tooltip está visível).
        /// </summary>
        private void TooltipMousePollTimer_Tick(object? sender, EventArgs e)
        {
            var sw = System.Diagnostics.Stopwatch.StartNew();
            // Guard: só processar se o tooltip está visível segundo nossa flag
            if (!_tooltipVisible) return;
            if ((DateTime.Now - _lastTooltipShowTime).TotalMilliseconds < 300) return; // HitTest Cooldown

            try
            {
                GetCursorPos(out System.Drawing.Point curPos);

                // 1. Tentar obter o rect exato do ícone via Shell API
                var iconRect = GetTrayIconRect();
                bool iconRectValid = !iconRect.IsEmpty;

                // 2. Fallback: usar posio do mouse no momento do show + tolerncia generosa
                //    _tooltipAnchorPos  capturado via GetCursorPos no ShowModernTooltip, ento  confivel
                if (!iconRectValid)
                {
                    // Tolerncia de 60px  cobre o ícone (~24px) + margem de erro generosa
                    iconRect = new System.Drawing.Rectangle(
                        _tooltipAnchorPos.X - 60, _tooltipAnchorPos.Y - 60, 120, 120);
                }

                // 3. Expandir levemente o rect do ícone para evitar sada acidental por 1px
                var expandedIconRect = iconRectValid
                    ? System.Drawing.Rectangle.Inflate(iconRect, 8, 8) // Margem de 8px para tolerar o DPI mismatch
                    : iconRect; // fallback j tem tolerncia generosa

                // 4. Rect do tooltip em coordenadas de tela (pixels fsicos)
                //    Usar tamanho mnimo de 300x160 se ainda no renderizou
                var dpi = GetSystemDpiScale();
                var tooltipScreenRect = _modernTooltip != null ? new System.Drawing.Rectangle(
                    (int)(_modernTooltip.Left   * dpi),
                    (int)(_modernTooltip.Top    * dpi),
                    (int)(Math.Max(_modernTooltip.ActualWidth,  300) * dpi),
                    (int)(Math.Max(_modernTooltip.ActualHeight, 160) * dpi)) : System.Drawing.Rectangle.Empty;

                bool overIcon    = expandedIconRect.Contains(curPos);
                bool overTooltip = !tooltipScreenRect.IsEmpty && tooltipScreenRect.Contains(curPos);

                if (!overIcon && !overTooltip || _tooltipVisible != (overIcon || overTooltip))
                    TooltipLog($"Poll cursor=({curPos.X},{curPos.Y}) overIcon={overIcon} overTooltip={overTooltip}");

                if (overIcon || overTooltip)
                {
                    sw.Stop();
                    if (sw.ElapsedMilliseconds > 10)
                    {
                        try { VoltrisDiagnosticSystem.Instance.Timeline("TOOLTIP-PERF", $"TooltipMousePollTimer_Tick LENTO: levou {sw.ElapsedMilliseconds}ms"); } catch { }
                    }
                    return; // mouse ainda na rea  manter visvel
                }

                // Mouse saiu  esconder
                TooltipLog("Poll ? mouse saiu da rea ? HideModernTooltip");
                _tooltipShowTimer?.Stop();
                _tooltipMousePollTimer?.Stop();
                HideModernTooltip();
            }
            catch (Exception ex)
            {
                TooltipLog($"Poll ERRO: {ex.Message}");
            }
            sw.Stop();
            if (sw.ElapsedMilliseconds > 10)
            {
                try { VoltrisDiagnosticSystem.Instance.Timeline("TOOLTIP-PERF", $"TooltipMousePollTimer_Tick LENTO: levou {sw.ElapsedMilliseconds}ms"); } catch { }
            }
        }

        private double GetSystemDpiScale()
        {
            try
            {
                var source = PresentationSource.FromVisual(this);
                if (source?.CompositionTarget != null)
                    return source.CompositionTarget.TransformToDevice.M11;
            }
            catch { }
            return 1.0;
        }

        private void ShowModernTooltip()
        {
            try { VoltrisDiagnosticSystem.Instance.Timeline("TOOLTIP", "ShowModernTooltip chamado"); } catch { }
            // Se o contexto do menu está aberto, ignorar
            if (_isTrayContextMenuOpen) return;

            // Se o tooltip já está visível e NÃO está fechando, ignorar
            if (_tooltipVisible && _modernTooltip != null && !_modernTooltip.IsAnimating) 
            { 
                TooltipLog("ShowModernTooltip ? j visvel, ignorando"); 
                return; 
            }
            // Cooldown pós-restart do Explorer
            if (DateTime.UtcNow < _suppressTooltipUntil)
            {
                TooltipLog("ShowModernTooltip ? suprimido (cooldown pós-restart do Explorer ainda ativo).");
                return;
            }

            TooltipLog($"ShowModernTooltip ? INICIANDO (lastMousePos={_lastMousePos.X},{_lastMousePos.Y})");

            try
            {
                Dispatcher.BeginInvoke(() =>
                {
                    // Double-check dentro do Dispatcher (thread-safe)
                    if (_tooltipVisible) { TooltipLog("ShowModernTooltip Dispatcher ? j visvel, ignorando"); return; }

                    if (_modernTooltip == null)
                    {
                        try { VoltrisDiagnosticSystem.Instance.Timeline("TOOLTIP", "ShowModernTooltip: Criando nova instncia de ModernTrayTooltip"); } catch { }
                        _modernTooltip = new VoltrisOptimizer.UI.Controls.ModernTrayTooltip();
                        _modernTooltip.WidgetToggleRequested += (s, args) =>
                        {
                            try
                            {
                                var widgetSvc = App.WidgetManager;
                                if (widgetSvc != null) widgetSvc.ToggleWidget();
                            }
                            catch { }
                        };
                        TooltipLog("ShowModernTooltip ? ModernTrayTooltip criado");
                    }

                    // Setar flag ANTES de Show() para bloquear qualquer re-entrada
                    _tooltipVisible = true;
                    _lastTooltipShowTime = DateTime.Now;

                    // Salvar posição do mouse no momento do show - usada pelo poll timer
                    GetCursorPos(out _tooltipAnchorPos);

                    RefreshModernTooltipData();

                    // Passar o rect fsico do ícone para o tooltip posicionar-se corretamente
                    var iconRect = GetTrayIconRect();
                    if (iconRect.IsEmpty)
                    {
                        TooltipLog("ShowModernTooltip ? ABORTANDO (iconRect está vazio, evita tooltip em posição aleatória)");
                        _tooltipVisible = false;
                        return;
                    }

                    TooltipLog($"ShowModernTooltip ? iconRect={iconRect}");
                    _modernTooltip.SetIconRect(iconRect);

                    _modernTooltip.ShowAboveTray();

                    TooltipLog($"ShowModernTooltip ? ShowAboveTray() chamado.");

                    // Iniciar polling
                    if (!(_tooltipMousePollTimer?.IsEnabled ?? false))
                    {
                        _tooltipMousePollTimer?.Start();
                        TooltipLog("ShowModernTooltip ? _tooltipMousePollTimer iniciado");
                    }
                });
            }
            catch (Exception ex)
            {
                _tooltipVisible = false;
                TooltipLog($"ShowModernTooltip ERRO: {ex.Message}");
            }
        }

        private void HideModernTooltip()
        {
            try { VoltrisDiagnosticSystem.Instance.Timeline("TOOLTIP", "HideModernTooltip chamado"); } catch { }
            if (!_tooltipVisible && (_modernTooltip == null || !_modernTooltip.IsVisible)) return;

            TooltipLog("HideModernTooltip ? chamado");
            try
            {
                Dispatcher.BeginInvoke(() =>
                {
                    _tooltipVisible = false;
                    _tooltipMousePollTimer?.Stop();
                    
                    if (_modernTooltip != null)
                    {
                        _modernTooltip.HideAnimated(() => {
                            // Não destruímos mais o tooltip a cada hide para performance e estabilidade.
                            // Ele só será destruído em ExplorerRestarted.
                            TooltipLog("HideModernTooltip ? animao finalizada, tooltip oculto");
                        });
                    }
                });
            }
            catch (Exception ex)
            {
                TooltipLog($"HideModernTooltip ERRO: {ex.Message}");
                _tooltipVisible = false;
            }
        }

        private void NotifyIcon_MouseClick(object? sender, WinForms.MouseEventArgs e)
        {
            if (e.Button == WinForms.MouseButtons.Right)
            {
                // CORREO: O NotifyIcon pode disparar MouseClick com Right E Left
                // para um ÚNICO clique do usuário (comportamento do Windows dependendo
                // da verso/configurao). Se um Left-click acabou de ocorrer (menos de
                // 300ms atrs), ignoramos o Right-click para evitar que ambos os menus
                // (ModernTrayMenu e ContextMenu legado) apaream simultaneamente.
                if ((DateTime.Now - _lastLeftClickTime).TotalMilliseconds < 300)
                    return;

                ShowContextMenu();
            }
            else if (e.Button == WinForms.MouseButtons.Left)
            {
                _lastLeftClickTime = DateTime.Now;
                // Removido: não abrir mais a janela ou o tooltip antigo com o clique esquerdo (conforme solicitado pelo usuário).
                // O clique duplo (DoubleClick) continuar abrindo o aplicativo normalmente.
            }
        }

        private void ShowContextMenu()
        {
            // Usar BeginInvoke para evitar bloqueio e re-entrncia no dispatcher
            Application.Current.Dispatcher.BeginInvoke(new Action(() =>
            {
                try
                {
                    // Parar timers de tooltip e esconder tooltip imediatamente
                    // para evitar que o tooltip roube foco e feche o menu
                    _tooltipShowTimer?.Stop();
                    HideModernTooltip();

                    // Se j existe um menu aberto, fechar antes de recriar
                    if (_isTrayContextMenuOpen && _cachedTrayMenu != null)
                    {
                        _cachedTrayMenu.IsOpen = false;
                    }

                    // Sempre recriar para refletir estado atual
                    _cachedTrayMenu = CreateTrayContextMenu();
                    var contextMenu = _cachedTrayMenu;

                    var mousePos = System.Windows.Forms.Control.MousePosition;

                    // CORREO: Usar a janela dummy (invisvel) para SetForegroundWindow.
                    // Usar a janela principal (que pode estar oculta com WS_EX_TOOLWINDOW)
                    // causa instabilidade de foco e faz o menu piscar/fechar.
                    IntPtr foregroundHwnd = IntPtr.Zero;
                    if (_dummySource != null && _dummySource.Handle != IntPtr.Zero)
                    {
                        foregroundHwnd = _dummySource.Handle;
                    }
                    else
                    {
                        if (_hwnd == IntPtr.Zero)
                            _hwnd = new WindowInteropHelper(this).Handle;
                        foregroundHwnd = _hwnd;
                    }

                    if (foregroundHwnd != IntPtr.Zero)
                    {
                        Win32.SetForegroundWindow(foregroundHwnd);
                    }

                    // Rastrear estado do menu para impedir tooltip de interferir
                    _isTrayContextMenuOpen = true;
                    contextMenu.Closed += (s, e) =>
                    {
                        _isTrayContextMenuOpen = false;
                    };

                    contextMenu.PlacementTarget = this;
                    contextMenu.Placement = System.Windows.Controls.Primitives.PlacementMode.AbsolutePoint;
                    contextMenu.PlacementRectangle = new Rect(mousePos.X, mousePos.Y, 0, 0);
                    contextMenu.HorizontalOffset = 0;
                    contextMenu.VerticalOffset = 0;
                    contextMenu.StaysOpen = false;

                    contextMenu.IsOpen = true;
                }
                catch (Exception ex)
                {
                    _isTrayContextMenuOpen = false;
                    App.LoggingService?.LogError("Erro ao exibir menu do systray", ex);
                }
            }), System.Windows.Threading.DispatcherPriority.Send);
        }

        private ContextMenu CreateTrayContextMenu()
        {
            var menu = new ContextMenu();
            
            // Obter verso
            string versionString = $"v{Properties.VersionInfo.Version}";
            
            // Cabealho (no clicvel, apenas visual)
            var headerItem = new MenuItem
            {
                Header = CreateHeaderContent("Voltris Optimizer", versionString),
                IsEnabled = false,
                Background = new SolidColorBrush(MediaColor.FromRgb(0x1A, 0x1A, 0x2E)),
                Padding = new Thickness(16, 12, 16, 12),
                Height = 72,
                HorizontalContentAlignment = HorizontalAlignment.Center
            };
            menu.Items.Add(headerItem);
            
            menu.Items.Add(CreateFullWidthSeparator());
            
            // Seo: Aes Rpidas
            menu.Items.Add(CreateSectionHeader(LocalizationService.Instance.GetString("TrayQuickActions")));
            
            // Mostrar (ícone: olho - cor azul sidebar Dashboard)
            var showItem = new MenuItem
            {
                Header = LocalizationService.Instance.GetString("TrayShowLegacy"),
                Icon = CreateSvgIcon("M12,9A3,3 0 0,0 9,12A3,3 0 0,0 12,15A3,3 0 0,0 15,12A3,3 0 0,0 12,9M12,17A5,5 0 0,1 7,12A5,5 0 0,1 12,7A5,5 0 0,1 17,12A5,5 0 0,1 12,17M12,4.5C7.59,4.5 3.82,7.14 2,10.5C3.82,13.86 7.59,16.5 12,16.5C16.41,16.5 20.18,13.86 22,10.5C20.18,7.14 16.41,4.5 12,4.5Z", "#31A8FF")
            };
            showItem.Click += (s, e) => ShowWindow();
            menu.Items.Add(showItem);
            
            // Dashboard (ícone: casa - cor roxa #8B31FF igual Image 3)
            var dashboardItem = new MenuItem
            {
                Header = LocalizationService.Instance.GetString("TrayDashboard"),
                Icon = CreateSvgIcon("M10,20V14H14V20H19V12H22L12,3L2,12H5V20H10Z", "#8B31FF")
            };
            dashboardItem.Click += (s, e) =>
            {
                ShowWindow();
                NavigateToPageSafe("Dashboard");
            };
            menu.Items.Add(dashboardItem);
            
            // Limpeza Rpida (ícone: brilhos/brush - cor verde #10B981)
            var cleanupItem = new MenuItem
            {
                Header = LocalizationService.Instance.GetString("TrayQuickCleanup"),
                Icon = CreateSvgIcon("M19.5,8.5l-1.23-2.63L15.65,4.65c-0.27-0.06-0.54,0.15-0.6,0.42c-0.01,0.06-0.01,0.12,0,0.18l1.23,2.63l2.63,1.23c0.27,0.06,0.54-0.15,0.6-0.42C19.56,8.63,19.54,8.56,19.5,8.5z M14.5,12.5l-1.23-2.63L10.65,8.65c-0.27-0.06-0.54,0.15-0.6,0.42c-0.01,0.06-0.01,0.12,0,0.18l1.23,2.63l2.63,1.23c0.27,0.06,0.54-0.15,0.6-0.42C14.56,12.63,14.54,12.56,14.5,12.5z", "#10B981")
            };
            cleanupItem.Click += async (s, e) =>
            {
                try
                {
                    App.LoggingService?.LogInfo("[Systray] Limpeza Rpida iniciada via Systray");
                    ShowWindow();
                    await NavigateToPageSafeAsync("Dashboard");
                    await VoltrisOptimizer.UI.ViewModels.TransientDashboard.RunAsync(vm => vm.QuickCleanupAsync("Systray"));
                }
                catch { }
            };
            menu.Items.Add(cleanupItem);
            
            // Otimizar Agora (ícone: raio - cor laranja #F59E0B)
            var optimizeItem = new MenuItem
            {
                Header = LocalizationService.Instance.GetString("TrayOptimizeNow"),
                Icon = CreateSvgIcon("M13,10H17L11,20V14H7L13,2V10Z", "#F59E0B")
            };
            optimizeItem.Click += async (s, e) =>
            {
                try
                {
                    App.LoggingService?.LogInfo("[Systray] Otimizar Agora iniciado via Systray");
                    ShowWindow();
                    await NavigateToPageSafeAsync("Dashboard");
                    await VoltrisOptimizer.UI.ViewModels.TransientDashboard.RunAsync(vm => vm.QuickOptimizeAsync("Systray"));
                }
                catch { }
            };
            menu.Items.Add(optimizeItem);

            // Widget: Ativo (ícone: barras - cor azul #3b82f6)
bool widgetVisible = App.WidgetManager?.IsWidgetVisible ?? false;
var widgetHeader = widgetVisible ?
    LocalizationService.Instance.GetString("TrayWidgetActive") :
    LocalizationService.Instance.GetString("TrayWidgetInactive");

var widgetItem = new MenuItem
{
    Header = widgetHeader,
    Icon = CreateSvgIcon("M16,11V7H19V11H16M16,20V12H19V20H16M11,20V9H14V20H11M6,20V13H9V20H6Z", "#3b82f6")
};
            widgetItem.Click += (s, e) => 
            {
                try { 
                    var widgetSvc = App.Services?.GetService(typeof(VoltrisOptimizer.UI.Widgets.WidgetManagerService)) as VoltrisOptimizer.UI.Widgets.WidgetManagerService;
                    if (widgetSvc != null) widgetSvc.ToggleWidget(); 
                } catch { }
            };
            menu.Items.Add(widgetItem);
            
            menu.Items.Add(CreateFullWidthSeparator());
            
            // Seo: Navegao
            menu.Items.Add(CreateSectionHeader(LocalizationService.Instance.GetString("TrayNavigationLegacy")));
            
            // Histórico (íícone: pulsação - cor roxa #8B31FF)
            var historyItem = new MenuItem
            {
                Header = LocalizationService.Instance.GetString("TrayHistoryLegacy"),
                Icon = CreateSvgIcon("M16,6L18.29,8.29L13.41,13.17L9.41,9.17L2,16.59L3.41,18L9.41,12L13.41,16L19.71,9.71L22,12V6H16Z", "#8B31FF")
            };
            historyItem.Click += (s, e) => { ShowWindow(); NavigateToPageSafe("History"); };
            menu.Items.Add(historyItem);
            
            // Agendamento (ícone: relgio - cor laranja #F59E0B)
            var schedulerItem = new MenuItem
            {
                Header = LocalizationService.Instance.GetString("TraySchedulerLegacy"),
                Icon = CreateSvgIcon("M12,20A8,8 0 0,0 20,12A8,8 0 0,0 12,4A8,8 0 0,0 4,12A8,8 0 0,0 12,20M12,2A10,10 0 0,1 22,12A10,10 0 0,1 12,22C6.47,22 2,17.5 2,12A10,10 0 0,1 12,2M12.5,7V12.25L17,14.92L16.25,16.15L11,13V7H12.5Z", "#F59E0B")
            };
            schedulerItem.Click += (s, e) => { ShowWindow(); NavigateToPageSafe("Scheduler"); };
            menu.Items.Add(schedulerItem);
            
            // Configuraes (ícone: engrenagem - cor cinza #94A3B8)
            var settingsItem = new MenuItem
            {
                Header = LocalizationService.Instance.GetString("TraySettingsLegacy"),
                Icon = CreateSvgIcon("M12,15.5A3.5,3.5 0 0,1 8.5,12A3.5,3.5 0 0,1 12,8.5A3.5,3.5 0 0,1 15.5,12A3.5,3.5 0 0,1 12,15.5M19.43,12.97C19.47,12.65 19.5,12.33 19.5,12C19.5,11.67 19.47,11.34 19.43,11L21.54,9.37C21.73,9.22 21.78,8.95 21.66,8.73L19.66,5.27C19.54,5.05 19.27,4.96 19.05,5.05L16.56,6.05C16.04,5.66 15.5,5.32 14.87,5.07L14.5,2.42C14.46,2.18 14.25,2 14,2H10C9.75,2 9.54,2.18 9.5,2.42L9.13,5.07C8.5,5.32 7.96,5.66 7.44,6.05L4.95,5.05C4.73,4.96 4.46,5.05 4.34,5.27L2.34,8.73C2.21,8.95 2.27,9.22 2.46,9.37L4.57,11C4.53,11.34 4.5,11.67 4.5,12C4.5,12.33 4.53,12.65 4.57,12.97L2.46,14.63C2.27,14.78 2.21,15.05 2.34,15.27L4.34,18.73C4.46,18.95 4.73,19.03 4.95,18.95L7.44,17.94C7.96,18.34 8.5,18.68 9.13,18.93L9.5,21.58C9.54,21.82 9.75,22 10,22H14C14.25,22 14.46,21.82 14.5,21.58L14.87,18.93C15.5,18.67 16.04,18.34 16.56,17.94L19.05,18.95C19.27,19.03 19.54,18.95 19.66,18.73L21.66,15.27C21.78,15.05 21.73,14.78 21.54,14.63L19.43,12.97Z", "#94A3B8")
            };
            settingsItem.Click += (s, e) => { ShowWindow(); NavigateToPageSafe("Settings"); };
            menu.Items.Add(settingsItem);
            
            menu.Items.Add(CreateFullWidthSeparator());

            // ============================================
            // Seo: Controles
            // ============================================
            menu.Items.Add(CreateSectionHeader(LocalizationService.Instance.GetString("TrayControls")));
            bool isGamerActive = (_gamerViewModel?.IsGamerModeActive == true) || (_gamerOrchestrator?.IsActive == true);

            // Modo Gamer (ícone: teclado - cor rosa #FF4B6B)
            // RECURSO PRO, igual ao Perfil Inteligente: o badge aparece quando
            // não há licença paga. O item nunca é desabilitado — quem bloqueia
