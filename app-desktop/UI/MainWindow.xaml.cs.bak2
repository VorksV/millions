        /// <summary>
        /// Event handler para mudanas de progresso global
        /// </summary>
        private void OnGlobalProgressChanged(object? sender, ProgressEventArgs e)
        {
            UpdateProgress(e.Percentage);
        }

        /// <summary>
        /// Event handler para mudanas de status global
        /// </summary>
        private void OnGlobalStatusChanged(object? sender, string status)
        {
            UpdateStatus(status);
        }

        private void OnHierarchicalProgressUpdated(object? sender, HierarchicalProgressEventArgs e)
        {
            if (VoltrisOptimizer.UI.Helpers.Win32WindowHelper.IsWindowDragInProgress)
            {
                UpdateProgress(e.GlobalPercentage);
                UpdateStatus(e.OperationName);
                UpdateStatusIconForProgress(e.OperationName, e.SubTaskName, e.Detail);
                return;
            }

            UpdateProgress(e.GlobalPercentage);
            
            Dispatcher.InvokeAsync(() =>
            {
                _statusTimer?.Stop();
                if (StatusLabel != null)
                {
                    // [FIX:PROGRESS-STAGE] O texto principal é o NOME DA ETAPA em
                    // curso — "Analisando...", "Limpando...", "Otimizando..." —
                    // exceto na emissão terminal, onde é a MENSAGEM DE CONCLUSÃO.
                    //
                    // [FIX:END-STATE] Sem esta distinção, o rodapé exibia
                    // "Otimizando..." ao lado de uma barra em 100%: dizia que
                    // ainda estava otimizando no instante exato em que havia
                    // terminado. A mensagem final nunca aparecia, porque o
                    // evento de conclusão (2s depois) apagava tudo.
                    bool isTerminal = e.IsCompleted;
                    _lastProgressWasTerminal = isTerminal;

                    string statusText = isTerminal
                        ? LocalizationService.Instance.GetString("MasterOptimizationSuccess")
                        : (!string.IsNullOrEmpty(e.SubTaskName) ? e.SubTaskName : e.OperationName);

                    StatusLabel.Text = statusText;
                    StatusLabel.Visibility = Visibility.Visible;

                    // [FIX:PROGRESS-ICON] O ícone passa a ser escolhido pelo que
                    // está acontecendo agora (etapa + item), e não pelo nome fixo
                    // da operação — que continha "otimização" e forçava o raio
                    // durante a limpeza.
                    UpdateStatusIconForProgress(e.OperationName, statusText, e.Detail);

                    // [FIX:END-STATE] ARMA O AUTO-OCULTAR NA EMISSÃO TERMINAL.
                    //
                    // BUG REAL, e a causa de "a barra fica sempre cheia no
                    // rodapé": este método FAZ `_statusTimer.Stop()` lá em cima
                    // e escreve o `StatusLabel` DIRETO, sem passar por
                    // `UpdateStatus()` — que é o ÚNICO lugar do arquivo que
                    // inicia o timer (linha ~5077). Resultado: no evento
                    // terminal o timer era parado e nunca reiniciado, e a lógica
                    // de zerar a barra dentro do `Tick` jamais executava. Era
                    // código morto: a correção existia, mas era inalcançável.
                    //
                    // Só arma no terminal. Durante as etapas o progresso está em
                    // curso e o rodapé não pode se auto-ocultar — seria o rodapé
                    // sumindo no meio do trabalho.
                    if (isTerminal)
                    {
                        _statusTimer?.Stop();
                        _statusTimer?.Start();

                        App.LoggingService?.LogInfo(
                            $"[FOOTER-END] Emissão terminal: texto=\"{statusText}\" | " +
                            $"barra em {e.GlobalPercentage}% | auto-ocultar ARMADO " +
                            $"({_statusTimer?.Interval.TotalSeconds.ToString("F0") ?? "?"}s) — " +
                            "é ele que vai zerar a barra e esconder o texto.");
                    }
                    
                    if (SubTaskLabel != null)
                    {
                        // [FIX:PROGRESS-DETAIL] O rodapé passa a mostrar o ITEM
                        // concreto ("Cache do Windows", "Rede"...), que antes ia
                        // só para o botão circular.
                        //
                        // O usuário via "- Limpando (54%)" e não sabia o que estava
                        // sendo limpo. Com o detalhe, vira "- Cache do Windows".
                        // Sem detalhe (ex.: a etapa de otimização, que não tem item
                        // nomeado), mantém o formato antigo com a porcentagem da
                        // etapa, que é a informação útil naquele momento.
                        if (!string.IsNullOrEmpty(e.Detail))
                        {
                            SubTaskLabel.Text = $"- {e.Detail}";
                            SubTaskLabel.Visibility = Visibility.Visible;
                        }
                        else if (!string.IsNullOrEmpty(e.SubTaskName))
                        {
                            SubTaskLabel.Text = $"- {e.SubTaskName} ({e.SubTaskPercentage}%)";
                            SubTaskLabel.Visibility = Visibility.Visible;
                        }
                        else
                        {
                            SubTaskLabel.Visibility = Visibility.Collapsed;
                        }
                    }
                    
                    if (TimeEstimationLabel != null)
                    {
                        string elapsedStr = e.TimeElapsed.ToString(@"mm\:ss");
                        string lblElapsed = LocalizationService.Instance["ElapsedWord"];
                        string lblRemaining = LocalizationService.Instance["RemainingWord"];

                        if (e.GlobalPercentage == 100)
                        {
                            TimeEstimationLabel.Text = $"⏱ {lblElapsed}: {elapsedStr}";
                            // TimeEstimationLabel.Text = $"⏱ {lblElapsed}: {elapsedStr}";
                        }
                        else if (e.EstimatedTimeRemaining.HasValue)
                        {
                            string remainingStr = e.EstimatedTimeRemaining.Value.ToString(@"mm\:ss");
                            TimeEstimationLabel.Text = $"⏱ {lblElapsed}: {elapsedStr} | {lblRemaining}: {remainingStr}";
                            // TimeEstimationLabel.Text = $"⏱ {lblElapsed}: {elapsedStr} | {lblRemaining}: {remainingStr}";
                        }
                        else
                        {
                            TimeEstimationLabel.Text = $"⏱ {lblElapsed}: {elapsedStr} | {lblRemaining}: " + LocalizationService.Instance["CalculatingWord"];
                        }
                        
                        TimeEstimationLabel.Visibility = Visibility.Visible;
                    }
                    if (StatusContainer != null) StatusContainer.Visibility = Visibility.Visible;
                }
            });
        }
        private void OnHierarchicalOperationCompleted(object? sender, EventArgs e)
        {
            Dispatcher.InvokeAsync(() =>
            {
                if (SubTaskLabel != null) SubTaskLabel.Visibility = Visibility.Collapsed;
                if (TimeEstimationLabel != null) TimeEstimationLabel.Visibility = Visibility.Collapsed;

                // [FIX:END-STATE] NÃO APAGA MAIS A BARRA.
                //
                // Esta é a origem do "depois não mostra nada". Este evento chega
                // 2s depois de a operação terminar, e fazia
                //     UpdateProgress(0)  -> barra com Opacity 0 (some)
                //     UpdateStatus("")   -> StatusContainer Collapsed (some)
                // apagando justamente a mensagem de sucesso que o evento
                // terminal tinha acabado de escrever. O usuário via "Otimização
                // concluída" por 2 segundos e depois um rodapé vazio.
                //
                // O comportamento certo é o inverso: a barra fica em 100% e a
                // confirmação permanece, e o auto-ocultar de 5s (o
                // _statusTimer, que existe exatamente para isso) é quem
                // decide quando o rodapé volta ao normal.
                if (_lastProgressWasTerminal)
                {
                    App.LoggingService?.LogInfo(
                        $"[FOOTER-END] Operação encerrada em estado TERMINAL: mantendo barra em 100% " +
                        $"com a confirmação. O auto-ocultar de 5s é quem zera a barra depois.");
                    UpdateProgress(100);
                    return;
                }

                // Operação encerrada SEM estado terminal conhecido (cancelada,
                // falha, ou encerrada por outro caminho): aí sim limpa.
                App.LoggingService?.LogInfo(
                    $"[FOOTER-END] Operação encerrada SEM estado terminal: limpando o rodapé.");
                UpdateProgress(0);
                UpdateStatus(string.Empty);
            });
        }

        /// <summary>
        /// [FIX:END-STATE] Ultimo estado terminal emitido. O evento de conclusão
        /// chega 2s depois e usa isto para decidir entre "manter a confirmação" e
        /// "limpar o rodapé".
        /// </summary>
        private bool _lastProgressWasTerminal;

        /// <summary>
        /// Atualiza a barra de progresso (footer apenas)
        /// </summary>
        public void UpdateProgress(int percentage)
        {
            if (VoltrisOptimizer.UI.Helpers.Win32WindowHelper.IsWindowDragInProgress)
            {
                _dragPendingProgress = true;
                _dragPendingProgressValue = percentage;
                return;
            }

            Dispatcher.InvokeAsync(() =>
            {
                if (ProgressBarFill != null)
                {
                    double totalWidth = 0;
                    if (ProgressBarFill.Parent is Border track)
                    {
                        totalWidth = track.ActualWidth;
                    }
                    
                    if (totalWidth <= 0 && ContentFrame != null)
                    {
                        totalWidth = ContentFrame.ActualWidth;
                    }
                    
                    if (totalWidth <= 0)
                    {
                        totalWidth = this.ActualWidth > 300 ? this.ActualWidth - 300 : 500;
                    }

                    if (percentage <= 0)
                    {
                        // Só esconde quando for 0 (limpeza do estado)
                        var anim = new System.Windows.Media.Animation.DoubleAnimation(0, TimeSpan.FromMilliseconds(400));
                        ProgressBarFill.BeginAnimation(WidthProperty, anim);
                        ProgressBarFill.Opacity = 0;
                    }
                    else
                    {
                        // Mostrar e atualizar  inclusive para 100% (concluso)
                        ProgressBarFill.Opacity = 1;
                        double targetWidth = (totalWidth / 100.0) * Math.Min(percentage, 100);
                        targetWidth = Math.Max(1, Math.Min(targetWidth, totalWidth));
                        
                        var anim = new System.Windows.Media.Animation.DoubleAnimation(targetWidth, TimeSpan.FromMilliseconds(200));
                        ProgressBarFill.BeginAnimation(WidthProperty, anim);
                    }
                }
            });
        }

        /// <summary>
        /// Atualiza o status (footer apenas)
        /// </summary>
        public void UpdateStatus(string message)
        {
            if (VoltrisOptimizer.UI.Helpers.Win32WindowHelper.IsWindowDragInProgress)
            {
                _dragPendingStatus = true;
                _dragPendingStatusMessage = message ?? string.Empty;
                return;
            }

            Dispatcher.InvokeAsync(() =>
            {
                _statusTimer?.Stop();

                if (StatusLabel != null)
                {
                    if (string.IsNullOrWhiteSpace(message))
                    {
                        StatusLabel.Text = string.Empty;
                        StatusLabel.Visibility = Visibility.Collapsed;
                        if (StatusContainer != null) StatusContainer.Visibility = Visibility.Collapsed;
                    }
                    else
                    {
                        StatusLabel.Text = message;
                        StatusLabel.Visibility = Visibility.Visible;
                        
                        // Determinar de forma inteligente o íícone contextual e estilo de cor
                        UpdateStatusIconContext(message);

                        if (StatusContainer != null) StatusContainer.Visibility = Visibility.Visible;

                        // Timer para limpar o status aps 5 segundos (s para mensagens no-concluso)
                        // No iniciar se houver uma operao em andamento, para no esconder a mensagem do progresso
                        if (!message.StartsWith("?") && !GlobalProgressService.Instance.IsOperationRunning)
                        {
                            _statusTimer?.Start();
                        }
                    }
                }
            });
        }

        /// <summary>
        /// Determina de forma inteligente e aplica o íícone contextual e estilo de cor na Barra de Progresso Global.
        /// </summary>
        private void UpdateStatusIconContext(string message)
        {
            if (string.IsNullOrEmpty(message)) return;
            TryMatchStatusIcon(message);
        }

        /// <summary>
        /// [FIX:PROGRESS-ICON] Escolhe o ícone do rodapé durante uma operação
        /// hierárquica.
        ///
        /// BUG ORIGINAL
        /// O ícone era escolhido só a partir de <c>OperationName</c> — que é o
        /// nome fixo da operação, "Iniciar Otimização". Esse texto contém
        /// "otimização" em TODAS as fases, então o seletor casava a regra de
        /// otimização e o rodapé mostrava o raio azul durante a análise, durante
        /// a limpeza e durante a otimização. O usuário via o ícone de raio
        /// enquanto o app limpava cache.
        ///
        /// O ícone de limpeza (sparkles) já existia na regra 4 e nunca aparecia
        /// nesse fluxo, por isso ele nunca casava.
        ///
        /// CORREÇÃO
        /// Tentar primeiro o texto ESPECÍFICO do que está acontecendo agora (etapa
        /// + item em andamento) e só cair para o nome da operação se ele não
        /// disser nada. Assim "Limpando / Cache do Windows" casa a regra de limpeza
        /// e o rodapé troca o raio pelo ícone de limpeza, com a mesma animação de
        /// escala que já existia.
        ///
        /// A ordem importa e é intencional: o texto específico é testado ANTES do
        /// nome da operação, porque o nome carrega "otimização" e venceria a
        /// concorrência se fosse testado primeiro.
        /// </summary>
        private void UpdateStatusIconForProgress(string operationName, string subTaskName, string detail)
        {
            if (StatusIconPath == null || StatusIconContainer == null || StatusIconGlow == null) return;

            // 1) O que está acontecendo agora (específico).
            if (TryMatchStatusIcon((subTaskName + " " + detail).Trim()))
                return;

            // 2) Contexto geral da operação.
            TryMatchStatusIcon(operationName);
        }

        /// <summary>
        /// Tenta casar o texto contra as regras de ícone. Retorna <c>true</c> se
        /// alguma regra casou, o que permite ao chamador tentar o próximo texto
        /// sem precisar saber qual regra existe.
        /// </summary>
        private bool TryMatchStatusIcon(string message)
        {
            if (string.IsNullOrEmpty(message)) return false;
            if (StatusIconPath == null || StatusIconContainer == null || StatusIconGlow == null) return false;

            string msgLower = message.ToLowerInvariant();

            // Configuraes padro (Processamento Genrico)
            string iconData = "M12,15.5A3.5,3.5 0 0,1 8.5,12A3.5,3.5 0 0,1 12,8.5A3.5,3.5 0 0,1 15.5,12A3.5,3.5 0 0,1 12,15.5M19.43,12.97C19.47,12.65 19.5,12.33 19.5,12C19.5,11.67 19.47,11.34 19.43,11L21.54,9.37C21.73,9.22 21.78,8.95 21.66,8.73L19.66,5.27C19.54,5.05 19.27,4.96 19.05,5.05L16.56,6.05C16.04,5.66 15.47,5.34 14.86,5.08L14.48,2.42C14.44,2.18 14.24,2 14,2H10C9.76,2 9.56,2.18 9.52,2.42L9.14,5.08C8.53,5.34 7.96,5.66 7.44,6.05L4.95,5.05C4.73,4.96 4.46,5.05 4.34,5.27L2.34,8.73C2.21,8.95 2.27,9.22 2.46,9.37L4.57,11C4.53,11.34 4.5,11.67 4.5,12C4.5,12.33 4.53,12.65 4.57,13L2.46,14.63C2.27,14.78 2.21,15.05 2.34,15.27L4.34,18.73C4.46,18.95 4.73,19.05 4.95,18.96L7.44,17.96C7.96,18.34 8.53,18.66 9.14,18.92L9.52,21.58C9.56,21.82 9.76,22 10,22H14C14.24,22 14.44,21.82 14.48,21.58L14.86,18.92C15.47,18.66 16.04,18.34 16.56,17.96L19.05,18.96C19.27,19.05 19.54,18.95 19.66,18.73L21.66,15.27C21.78,15.05 21.73,14.78 21.54,14.63L19.43,12.97Z"; // Spinner / Gear
            string brushColorHex = "#EC4899"; // Magenta
            string bgColorHex = "#15EC4899";

            // 1. Sucesso / Conclusão
            if (msgLower.StartsWith("?") || msgLower.Contains("concludo") || msgLower.Contains("concluída") || msgLower.Contains("sucesso") || msgLower.Contains("finalizado") || msgLower.Contains("pronto") || msgLower.Contains("concluído"))
            {
                iconData = "M21,7L9,19L3.5,13.5L4.91,12.09L9,16.17L19.59,5.59L21,7Z"; // Check
                brushColorHex = "#10B981"; // Emerald
                bgColorHex = "#1510B981";
            }
            // 2. Segurana / Proteo / Antivirus / Firewall
            else if (msgLower.Contains("segurana") || msgLower.Contains("proteger") || msgLower.Contains("proteo") || msgLower.Contains("defender") || msgLower.Contains("antivrus") || msgLower.Contains("antivirus") || msgLower.Contains("scan") || msgLower.Contains("verificar") || msgLower.Contains("telemetria") || msgLower.Contains("privacidade") || msgLower.Contains("bloqueio"))
            {
                iconData = "M12,1L3,5V11C3,16.55 6.84,21.74 12,23C17.16,21.74 21,16.55 21,11V5L12,1ZM12,17L7,12L8.41,10.59L12,14.17L15.59,10.59L17,12L12,17Z"; // Shield with check arrow
                brushColorHex = "#10B981"; // Emerald
                bgColorHex = "#1510B981";
            }
            // 3. Análise / Diagnóstico / Escaneamento
            //
            // [FIX:PROGRESS-ICON] Regra NOVA. A etapa de análise do botão
            // circular ("Analisando") não casava com NENHUMA regra: as de
            // otimização e de limpeza não a reconhecem. Resultado: durante toda
            // a análise o rodapé ficava no ícone genérico de engrenagem, sem
            // nenhuma relação com o que estava acontecendo. O nome "scanner"
            // também é ambíguo com antivírus (regra 2), então a análise tem
            // regra própria.
            else if (msgLower.Contains("analisando") || msgLower.Contains("analise") || msgLower.Contains("análise") || msgLower.Contains("analisando") || msgLower.Contains("diagnosticando") || msgLower.Contains("diagnóstico") || msgLower.Contains("diagnostico") || msgLower.Contains("avaliar") || msgLower.Contains("inspecionar"))
            {
                iconData = "M15.5,14H14.71L14.43,13.73C15.41,12.59 16,11.11 16,9.5 16,5.91 13.09,3 9.5,3S3,5.91 3,9.5 5.91,16 9.5,16C11.11,16 12.59,15.41 13.73,14.43L14,14.71V15.5L19,20.5 20.5,19M9.5,14C7.01,14 5,11.99 5,9.5S7.01,5 9.5,5 14,7.01 14,9.5 11.99,14 9.5,14Z"; // Chart/magnifier (analise)
                brushColorHex = "#38BDF8"; // Sky Blue
                bgColorHex = "#1538BDF8";
            }
            // 4. Limpeza / RAM / Cache / Trim
            //
            // [FIX:PROGRESS-ICON] VEM ANTES da de otimização de propósito.
            //
            // A ordem original testava otimização (3) antes de limpeza (4). Com
            // o nome da operação — que contém "otimização" — a regra 3 sempre
            // vencia, e o ícone de limpeza era inalcançável nesse fluxo.
            // Testando o texto específico da etapa primeiro, e deixando limpeza
            // antes de otimização dentro desse texto, "Limpando / Cache" agora
            // chega ao ícone de limpeza mesmo que a frase também contenha
            // "otimização".
            else if (msgLower.Contains("limpeza") || msgLower.Contains("limpar") || msgLower.Contains("limpando") || msgLower.Contains("cache") || msgLower.Contains("ram") || msgLower.Contains("trim") || msgLower.Contains("memória") || msgLower.Contains("memria") || msgLower.Contains("temp") || msgLower.Contains("temporários") || msgLower.Contains("temporrios") || msgLower.Contains("temporarios") || msgLower.Contains("lixo"))
            {
                iconData = "M19,10.5L17.5,12L19,13.5L20.5,12L19,10.5M12,1.5L9.5,6.5L4.5,9L9.5,11.5L12,16.5L14.5,11.5L19.5,9L14.5,6.5L12,1.5M12,5.5L13.4,8.6L16.5,10L13.4,11.4L12,14.5L10.6,11.4L7.5,10L10.6,8.6L12,5.5M6,16.5L4.5,18L6,19.5L7.5,18L6,16.5Z"; // Sparkles
                brushColorHex = "#C084FC"; // Light Violet
                bgColorHex = "#15C084FC";
            }
            // 5. Otimizao / Performance
            //
            // [FIX:PROGRESS-ICON] Movida para DEPOIS da de limpeza. Continua
            // contendo "otimização" e por isso continua sendo o fallback correto
            // quando o texto é o nome da operação, mas não pode roubar a limpeza
            // quando a frase também fala em otimizar.
            else if (msgLower.Contains("otimizando") || msgLower.Contains("otimização") || msgLower.Contains("otimizacao") || msgLower.Contains("otimizar") || msgLower.Contains("performance") || msgLower.Contains("acelerar") || msgLower.Contains("boost") || msgLower.Contains("cpu") || msgLower.Contains("gpu") || msgLower.Contains("epp") || msgLower.Contains("prioridade") || msgLower.Contains("parking") || msgLower.Contains("power profile") || msgLower.Contains("game mode") || msgLower.Contains("gamer"))
            {
                iconData = "M7,2L17,2L13.5,9L18,9L10,22L11.5,13L6,13L7,2Z"; // Lightning
                brushColorHex = "#31A8FF"; // Cyan Blue
                bgColorHex = "#1531A8FF";
            }
            // 6. Download / Instalao / Update
            else if (msgLower.Contains("download") || msgLower.Contains("baixando") || msgLower.Contains("atualização") || msgLower.Contains("atualizacao") || msgLower.Contains("windows update") || msgLower.Contains("instalando") || msgLower.Contains("install") || msgLower.Contains("preparando instalao"))
            {
                iconData = "M5,20H19V18H5M19,9H15V3H9V9H5L12,16L19,9Z"; // Download Arrow
                brushColorHex = "#A855F7"; // Purple/Pink
                bgColorHex = "#15A855F7";
            }
            // 7. Recuperao / Reparo
            else if (msgLower.Contains("recuperao") || msgLower.Contains("recuperacao") || msgLower.Contains("reparo") || msgLower.Contains("reparar") || msgLower.Contains("corrigir") || msgLower.Contains("corrigindo") || msgLower.Contains("sfc") || msgLower.Contains("dism") || msgLower.Contains("integridade") || msgLower.Contains("restaurar") || msgLower.Contains("chkdsk") || msgLower.Contains("fix"))
            {
                iconData = "M21.71,20.29L18.39,16.97C18.79,15.5 18.9,13.9 18.5,12.3L22.5,8.3C22.9,7.9 22.9,7.3 22.5,6.9L17.1,1.5C16.7,1.1 16.1,1.1 15.7,1.5L11.7,5.5C10.1,5.1 8.5,5.2 7,5.6L3.7,2.3C3.3,1.9 2.7,1.9 2.3,2.3L1.1,3.5C0.7,3.9 0.7,4.5 1.1,4.9L4.4,8.2C4,9.7 3.9,11.3 4.3,12.9L0.3,16.9C-0.1,17.3 -0.1,17.9 0.3,18.3L5.7,23.7C6.1,24.1 6.7,24.1 7.1,23.7L11.1,19.7C12.7,20.1 14.3,20 15.8,19.6L19.1,22.9C19.5,23.3 20.1,23.3 20.5,22.9L21.7,21.7C22.1,21.3 22.1,20.7 21.7,20.29Z"; // Wrench/Hammer
                brushColorHex = "#F59E0B"; // Amber Gold
                bgColorHex = "#15F59E0B";
            }

            try
            {
                var brush = new SolidColorBrush((MediaColor)System.Windows.Media.ColorConverter.ConvertFromString(brushColorHex));
                var bgBrush = new SolidColorBrush((MediaColor)System.Windows.Media.ColorConverter.ConvertFromString(bgColorHex));

                StatusIconPath.Data = Geometry.Parse(iconData);
                StatusIconPath.Fill = brush;
                StatusIconContainer.Background = bgBrush;
                StatusIconGlow.Color = (MediaColor)System.Windows.Media.ColorConverter.ConvertFromString(brushColorHex);

                // Aplica uma animao suave de Scale no ícone para um feedback visual ultra fluido
                var scaleAnim = new System.Windows.Media.Animation.DoubleAnimation(0.3, 1.0, TimeSpan.FromMilliseconds(300))
                {
                    EasingFunction = new System.Windows.Media.Animation.QuadraticEase { EasingMode = System.Windows.Media.Animation.EasingMode.EaseOut }
                };
                var scaleTransform = new ScaleTransform();
                StatusIconContainer.RenderTransform = scaleTransform;
                StatusIconContainer.RenderTransformOrigin = new System.Windows.Point(0.5, 0.5);
                scaleTransform.BeginAnimation(ScaleTransform.ScaleXProperty, scaleAnim);
                scaleTransform.BeginAnimation(ScaleTransform.ScaleYProperty, scaleAnim);

                return true;
            }
            catch (Exception ex)
            {
                LogToFile($"[UpdateStatusIconContext] Erro ao aplicar estilo: {ex.Message}");
                return false;
            }
        }


        private void OnMainWindowLoaded(object sender, RoutedEventArgs e)
        {
            GlobalOperationManager.Instance.PropertyChanged += OnGlobalOperationManagerPropertyChanged;
        }

        private void OnGlobalOperationManagerPropertyChanged(object sender, System.ComponentModel.PropertyChangedEventArgs args)
        {
            var gom = GlobalOperationManager.Instance;
            Dispatcher.InvokeAsync(() =>
            {
                IsCancelButtonVisible = gom.CanCancelCurrent;
                HasQueuedItems = gom.HasQueuedItems;
                QueueStatusText = gom.QueueStatusText;
            });
        }

        private void CancelButton_Click(object sender, RoutedEventArgs e)
        {
            GlobalOperationManager.Instance.CancelCurrent();
        }

        // ============================================
        // EVENTOS DA BARRA DE TTULO MODERNA
        // ============================================

        /// <summary>
        /// Permite arrastar a janela pela barra de ttulo e alterna maximize/restore ao clicar duas vezes.
        /// Usa o MOVE-LOOP NATIVO do Windows (WM_NCLBUTTONDOWN + HTCAPTION), o mesmo que programas
        /// profissionais usam em ttulos customizados. O SISTEMA move a superfcie da janela via DWM
        /// em tempo real, sem o WPF reprocessar Left/Top a cada movimento do mouse — o que evitava
        /// o HwndTarget.UpdateWindowSettings (freeze de ~1s em janela AllowsTransparency no Windows 10).
        /// </summary>
        private void TitleBar_MouseDown(object sender, MouseButtonEventArgs e)
        {
            if (e.ChangedButton == MouseButton.Left && e.LeftButton == MouseButtonState.Pressed)
            {
                // Double-click no header => maximizar/restaurar (comportamento padrão do Windows)
                if (e.ClickCount == 2)
                {
                    LogToFile("[TITLEBAR] MouseDown ClickCount=2 - ToggleWindowState (sem drag)");
                    _titleBarPressed = false;
                    (sender as UIElement)?.ReleaseMouseCapture();
                    ToggleWindowState();
                    e.Handled = true;
                    return;
                }

                // FIX FLICKER: não inicia o drag imediatamente. A janela real (AllowsTransparency)
                // é escondida durante o photo-drag e re-exibida ao soltar, o que repinta a árvore
                // inteira e causa a piscada na interface em TODO clique (mesmo sem arrastar).
                // Só engajamos o drag quando o mouse realmente se mover acima do threshold.
                _titleBarPressed = true;
                _titleBarDownPoint = e.GetPosition(this);
                (sender as UIElement)?.CaptureMouse();
                LogToFile("[TITLEBAR] MouseDown registrado (aguardando movimento >= threshold para iniciar drag)");
                e.Handled = true;
                return;
            }
        }

        private void TitleBar_MouseMove(object sender, MouseEventArgs e)
        {
            if (!_titleBarPressed)
                return;

            if (_isDraggingTitleBar)
            {
                _titleBarPressed = false;
                return;
            }

            // Só interessa enquanto o botão esquerdo estiver pressionado
            if (e.LeftButton != MouseButtonState.Pressed)
            {
                _titleBarPressed = false;
                (sender as UIElement)?.ReleaseMouseCapture();
                return;
            }

            // Se o usuário realmente moveu o mouse acima do threshold (padrão do Windows ~4 DIPs),
            // aí sim inicia o drag nativo/photo-drag.
            var p = e.GetPosition(this);
            double dx = Math.Abs(p.X - _titleBarDownPoint.X);
            double dy = Math.Abs(p.Y - _titleBarDownPoint.Y);
            if (dx >= SystemParameters.MinimumHorizontalDragDistance || dy >= SystemParameters.MinimumVerticalDragDistance)
            {
                _titleBarPressed = false;
                LogToFile($"[TITLEBAR] Movimento detectado dx={dx:F1} dy={dy:F1} - iniciando drag");
                StartWindowDrag();
                e.Handled = true;
            }
        }

        private void TitleBar_MouseUp(object sender, MouseButtonEventArgs e)
        {
            if (!_titleBarPressed)
                return;

            // Clique simples sem movimento: não iniciou drag => não esconde/restaura a janela => sem flicker.
            LogToFile("[TITLEBAR] MouseUp sem movimento - clique simples, sem drag");
            _titleBarPressed = false;
            (sender as UIElement)?.ReleaseMouseCapture();
            e.Handled = true;
        }

        private void StartWindowDrag()
        {
            if (_isDraggingTitleBar) return;
            if (WindowState == WindowState.Maximized)
            {
                ToggleWindowState();
                return;
            }

            StartNativeWindowDrag();
        }

        /// <summary>
        /// PHOTO-DRAG: captura um snapshot rapido (CopyFromScreen, ~1ms) da aparencia atual
        /// da janela, esconde a janela real e arrasta um fantasma leve (imagem unica) no
        /// move-loop nativo. Ao soltar, posiciona a janela real no lugar do fantasma.
        /// Durante TODO o arrasto o WPF nunca re-renderiza a arvore grande — só o fantasma.
        /// Retorna false para cair no arrasto nativo normal em caso de qualquer problema.
        /// </summary>
        private bool TryStartPhotoDrag()
        {
            try
            {
                IntPtr hwnd = _hwnd != IntPtr.Zero ? _hwnd : new System.Windows.Interop.WindowInteropHelper(this).Handle;
                _hwnd = hwnd;

                long tCapture = Environment.TickCount64;
                bool okSnap = TryCaptureWindowSnapshot(out var snapshot);
                long captureMs = Environment.TickCount64 - tCapture;
                if (!okSnap || snapshot == null)
                {
                    LogToFile("[DRAG-PERF] PHOTO captura falhou em " + captureMs + "ms, usando arrasto nativo");
                    return false;
                }

                var dpi = VisualTreeHelper.GetDpi(this);
                double dpiX = dpi.DpiScaleX;
                double dpiY = dpi.DpiScaleY;

                VoltrisOptimizer.UI.Helpers.Win32WindowHelper.GetWindowRect(hwnd, out var rectStart);
                int physW = rectStart.Width;
                int physH = rectStart.Height;

                var ghost = new System.Windows.Window
                {
                    WindowStyle = System.Windows.WindowStyle.None,
                    AllowsTransparency = false,
                    Background = System.Windows.Media.Brushes.Black,
                    BorderThickness = new System.Windows.Thickness(0),
                    ResizeMode = System.Windows.ResizeMode.NoResize,
                    ShowInTaskbar = false,
                    ShowActivated = false,
                    Topmost = true,
                    Focusable = false,
                    IsHitTestVisible = false,
                    SizeToContent = System.Windows.SizeToContent.Manual,
                    Left = rectStart.Left / dpiX,
                    Top = rectStart.Top / dpiY,
                    Width = physW / dpiX,
                    Height = physH / dpiY
                };
                ghost.Content = new System.Windows.Controls.Image
                {
                    Source = snapshot,
                    Stretch = System.Windows.Media.Stretch.Fill
                };
                _dragGhost = ghost;

                ghost.Show();
                LogToFile("[DRAG-PERF] PHOTO fantasma exibido em " + captureMs + "ms de captura");

                _isDraggingTitleBar = true;
                VoltrisOptimizer.UI.Helpers.Win32WindowHelper.IsWindowDragInProgress = true;
                LogDragEnvironment();

                this.Visibility = System.Windows.Visibility.Hidden;

                long t0 = Environment.TickCount64;
                IntPtr ghostHwnd = new System.Windows.Interop.WindowInteropHelper(ghost).Handle;
                VoltrisOptimizer.UI.Helpers.Win32WindowHelper.GetWindowRect(ghostHwnd, out var ghostStart);
                VoltrisOptimizer.UI.Helpers.Win32WindowHelper.ReleaseCapture();
                VoltrisOptimizer.UI.Helpers.Win32WindowHelper.SendMessage(ghostHwnd, VoltrisOptimizer.UI.Helpers.Win32WindowHelper.WM_NCLBUTTONDOWN, new IntPtr(VoltrisOptimizer.UI.Helpers.Win32WindowHelper.HT_CAPTION), IntPtr.Zero);
                long dur = Environment.TickCount64 - t0;

                VoltrisOptimizer.UI.Helpers.Win32WindowHelper.GetWindowRect(ghostHwnd, out var ghostEnd);
                double dx = ghostEnd.Left - ghostStart.Left;
                double dy = ghostEnd.Top - ghostStart.Top;

                this.Left = ghostEnd.Left / dpiX;
                this.Top = ghostEnd.Top / dpiY;

                LogToFile(string.Format("[DRAG-PERF] PHOTO dur={0}ms capture={1}ms start=L{2},T{3} end=L{4},T{5} dx={6:F0} dy={7:F0} size={8}x{9}", dur, captureMs, ghostStart.Left, ghostStart.Top, ghostEnd.Left, ghostEnd.Top, dx, dy, physW, physH));

                ReturnFromPhotoDrag();
                return true;
            }
            catch (Exception ex)
            {
                LogToFile("[DRAG-PERF] PHOTO erro, usando arrasto nativo: " + ex.Message);
                ReturnFromPhotoDrag();
                return false;
            }
        }

        /// <summary>
        /// Restaura a janela real ao estado visivel e descarta o fantasma.
        /// </summary>
        private void ReturnFromPhotoDrag()
        {
            try
            {
                if (this.Visibility != System.Windows.Visibility.Visible)
                {
                    this.Visibility = System.Windows.Visibility.Visible;
                }
            }
            catch { }

            try
            {
                if (_dragGhost != null)
                {
                    var g = _dragGhost;
                    _dragGhost = null;
                    g.Opacity = 0;
                    g.Hide();
                    g.Close();
                }
            }
            catch { }

            _isDraggingTitleBar = false;
            VoltrisOptimizer.UI.Helpers.Win32WindowHelper.IsWindowDragInProgress = false;
            FlushDeferredDragUI();
        }

        /// <summary>
        /// Captura a aparencia atual da janela direto da tela (CopyFromScreen).
        /// Core do PHOTO-DRAG: barato (~1ms) e preserva o visual real (acrylic incl.).
        /// </summary>
        private bool TryCaptureWindowSnapshot(out System.Windows.Media.Imaging.BitmapSource snapshot)
        {
            snapshot = null!;
            try
            {
                IntPtr hwnd = _hwnd != IntPtr.Zero ? _hwnd : new System.Windows.Interop.WindowInteropHelper(this).Handle;
                VoltrisOptimizer.UI.Helpers.Win32WindowHelper.GetWindowRect(hwnd, out var rect);
                int w = rect.Width;
                int h = rect.Height;
                if (w <= 0 || h <= 0) return false;

                using (var bmp = new System.Drawing.Bitmap(w, h))
                {
                    using (var g = System.Drawing.Graphics.FromImage(bmp))
                    {
                        g.CopyFromScreen(rect.Left, rect.Top, 0, 0, bmp.Size, System.Drawing.CopyPixelOperation.SourceCopy);
                    }

                    IntPtr hbmp = bmp.GetHbitmap();
                    try
                    {
                        snapshot = System.Windows.Interop.Imaging.CreateBitmapSourceFromHBitmap(hbmp, IntPtr.Zero, System.Windows.Int32Rect.Empty, System.Windows.Media.Imaging.BitmapSizeOptions.FromEmptyOptions());
                    }
                    finally
                    {
                        try { Win32.DeleteObject(hbmp); } catch { }
                    }
                }

                if (snapshot != null) snapshot.Freeze();
                return snapshot != null;
            }
            catch (Exception ex)
            {
                LogToFile("[DRAG-PERF] Erro na captura CopyFromScreen: " + ex.Message);
                return false;
            }
        }

        private void LogDragEnvironment()
        {
            try
            {
                IntPtr hwnd = _hwnd != IntPtr.Zero ? _hwnd : new System.Windows.Interop.WindowInteropHelper(this).Handle;
                var dpi = VisualTreeHelper.GetDpi(this);
                IntPtr exStyle = VoltrisOptimizer.UI.Helpers.Win32WindowHelper.GetExStyle(hwnd);
                bool layered = (exStyle.ToInt64() & VoltrisOptimizer.UI.Helpers.Win32WindowHelper.WS_EX_LAYERED) != 0;
                int tier = System.Windows.Media.RenderCapability.Tier >> 16;
                bool dwm = true;
                try { VoltrisOptimizer.UI.Helpers.Win32WindowHelper.DwmIsCompositionEnabled(out dwm); } catch { }
                var ps = System.Diagnostics.Process.GetCurrentProcess();

                LogToFile(string.Format("[DRAG-DIAG] hwnd={0} dpi={1:F2} layered={2} exStyle=0x{3:X8} allowsTransp={4} winStyle={5} resizeMode={6} winState={7} dwm={8} renderTier={9} wsMB={10:F0} threads={11}", hwnd, dpi.DpiScaleX, layered, exStyle.ToInt64(), AllowsTransparency, WindowStyle, ResizeMode, WindowState, dwm, tier, ps.WorkingSet64 / 1048576.0, ps.Threads.Count));
            }
            catch (Exception ex)
            {
                LogToFile("[DRAG-DIAG] erro ao coletar ambiente: " + ex.Message);
            }
        }

        private void StartNativeWindowDrag()
        {
            try
            {
                if (_isDraggingTitleBar) return;

                if (WindowState == WindowState.Maximized)
                {
                    ToggleWindowState();
                    return;
                }

                _isDraggingTitleBar = true;
                VoltrisOptimizer.UI.Helpers.Win32WindowHelper.IsWindowDragInProgress = true;
                LogDragEnvironment();

                IntPtr hwnd = _hwnd != IntPtr.Zero ? _hwnd : new System.Windows.Interop.WindowInteropHelper(this).Handle;
                _hwnd = hwnd;

                VoltrisOptimizer.UI.Helpers.Win32WindowHelper.GetWindowRect(hwnd, out var rectStart);

                long t0 = Environment.TickCount64;

                // Libera qualquer captura anterior e entrega o arrasto ao SISTEMA:
                // WM_NCLBUTTONDOWN/HTCAPTION faz o DefWindowProc iniciar o loop modal
                // de movimentao — a janela anda em tempo real pela composição DWM.
                // Esta chamada BLOQUEIA até o usuário soltar o botao do mouse.
                VoltrisOptimizer.UI.Helpers.Win32WindowHelper.ReleaseCapture();
                VoltrisOptimizer.UI.Helpers.Win32WindowHelper.SendMessage(hwnd, VoltrisOptimizer.UI.Helpers.Win32WindowHelper.WM_NCLBUTTONDOWN, new IntPtr(VoltrisOptimizer.UI.Helpers.Win32WindowHelper.HT_CAPTION), IntPtr.Zero);

                long dur = Environment.TickCount64 - t0;

                VoltrisOptimizer.UI.Helpers.Win32WindowHelper.GetWindowRect(hwnd, out var rectEnd);
                double dx = rectEnd.Left - rectStart.Left;
                double dy = rectEnd.Top - rectStart.Top;

                LogToFile(string.Format("[DRAG-PERF] NATIVE dur={0}ms start=L{1},T{2} end=L{3},T{4} sizeNow={5}x{6} dx={7:F0} dy={8:F0} acrylic={9} transp={10} os={11}", dur, rectStart.Left, rectStart.Top, rectEnd.Left, rectEnd.Top, rectEnd.Width, rectEnd.Height, dx, dy, VoltrisOptimizer.Helpers.VisualEffectsManager.IsAcrylicEnabled(), _settings.Settings.EnableTransparency, Environment.OSVersion.Version.Build));
            }
            catch (Exception ex)
            {
                LogToFile("[DRAG-PERF] ERRO no arrasto nativo: " + ex.Message);
            }
            finally
            {
                _isDraggingTitleBar = false;
                VoltrisOptimizer.UI.Helpers.Win32WindowHelper.IsWindowDragInProgress = false;
                FlushDeferredDragUI();
            }
        }

        /// <summary>
        /// Reaplica, uma unica vez apos o fim do drag, as escritas de UI (progresso/
        /// status) que foram adiadas durante o move nativo. Evita o burst de layout
        /// represado no fim do arrasto (fonte do congelamento de ~1s gravado nos logs).
        /// </summary>
        private void FlushDeferredDragUI()
        {
            try
            {
                bool hasProgress = _dragPendingProgress;
                bool hasStatus = _dragPendingStatus;
                _dragPendingProgress = false;
                _dragPendingStatus = false;

                if (!hasProgress && !hasStatus) return;

                int progressValue = _dragPendingProgressValue;
                string statusMessage = _dragPendingStatusMessage;

                Dispatcher.BeginInvoke(new Action(() =>
                {
                    try
                    {
                        if (hasProgress) UpdateProgress(progressValue);
                        if (hasStatus) UpdateStatus(statusMessage);
                    }
                    catch (Exception ex)
                    {
                        LogToFile("[DRAG-PERF] Erro ao aplicar UI deferida apos drag: " + ex.Message);
                    }
                }), System.Windows.Threading.DispatcherPriority.Background);

                LogToFile("[DRAG-PERF] Flush de UI deferida durante drag: progress=" + hasProgress + " status=" + hasStatus);
            }
            catch (Exception ex)
            {
                LogToFile("[DRAG-PERF] Falha ao agendar flush de UI deferida: " + ex.Message);
            }
        }

        private void SuspendAcrylicDuringDrag()
        {
            try
            {
                bool acrylicActive = VoltrisOptimizer.Helpers.VisualEffectsManager.IsAcrylicEnabled();
                if (acrylicActive && _settings.Settings.EnableTransparency)
                {
                    _dragSuspendedAcrylic = true;
                    VoltrisOptimizer.UI.Helpers.BackdropHelper.ApplyModernBackdrop(this, VoltrisOptimizer.UI.Helpers.BackdropHelper.SystemBackdropType.None);
                    LogToFile("[DRAG-PERF] Acrylic suspenso durante o drag");
                }
            }
            catch (Exception ex)
            {
                LogToFile("[DRAG-PERF] Falha ao suspender acrylic: " + ex.Message);
            }
        }

        private void RestoreAcrylicAfterDrag()
        {
            try
            {
                bool wasSuspended = _dragSuspendedAcrylic;
                _dragSuspendedAcrylic = false;
                if (!wasSuspended) return;

                var t = new System.Windows.Threading.DispatcherTimer(System.Windows.Threading.DispatcherPriority.Background);
                t.Interval = TimeSpan.FromMilliseconds(250);
                t.Tick += (s2, e2) =>
                {
                    t.Stop();
                    try
                    {
                        if (_settings.Settings.EnableTransparency)
                        {
                            VoltrisOptimizer.UI.Helpers.BackdropHelper.ApplyModernBackdrop(this, VoltrisOptimizer.UI.Helpers.BackdropHelper.SystemBackdropType.Acrylic);
                        }
                        LogToFile("[DRAG-PERF] Acrylic reaplicado apos drag");
                    }
                    catch (Exception ex)
                    {
                        LogToFile("[DRAG-PERF] Falha ao reaplicar acrylic: " + ex.Message);
                    }
                };
                t.Start();
            }
            catch (Exception ex)
            {
                LogToFile("[DRAG-PERF] Falha ao agendar reaplicacao do acrylic: " + ex.Message);
            }
        }

        /// <summary>
        /// Minimiza a janela
        /// </summary>
        private void MinimizeButton_Click(object sender, RoutedEventArgs e)
        {
            _userInitiatedMinimize = true;
            WindowState = WindowState.Minimized;
        }

        /// <summary>
        /// Maximiza ou restaura a janela
        /// </summary>
        private void MaximizeButton_Click(object sender, RoutedEventArgs e)
        {
            LogToFile($"[MAXIMIZE-DEBUG] Button Click - WindowState={WindowState}, Size={ActualWidth}x{ActualHeight}");
            LogToFile($"[MAXIMIZE-DEBUG] RootContainer Size={RootContainer?.ActualWidth}x{RootContainer?.ActualHeight}, Margin={RootContainer?.Margin}");
            LogToFile($"[MAXIMIZE-DEBUG] Screen: WorkArea={SystemParameters.WorkArea}, Primary={SystemParameters.PrimaryScreenWidth}x{SystemParameters.PrimaryScreenHeight}");
            
            // Logar todos os monitores para detectar problemas em multi-monitor
            foreach (var monitor in System.Windows.Forms.Screen.AllScreens)
            {
                LogToFile($"[MAXIMIZE-DEBUG] Monitor '{monitor.DeviceName}': Bounds={monitor.Bounds}, WorkArea={monitor.WorkingArea}, Primary={monitor.Primary}");
            }
            
            if (WindowState == WindowState.Maximized)
            {
                WindowState = WindowState.Normal;
                if (MaximizeIcon != null)
                {
                    MaximizeIcon.Data = Geometry.Parse("M4,4 L20,4 L20,20 L4,20 Z");
                }
            }
            else
            {
                WindowState = WindowState.Maximized;
                if (MaximizeIcon != null)
                {
                    MaximizeIcon.Data = Geometry.Parse("M4,4 L12,4 L12,12 L4,12 Z M12,12 L20,12 L20,20 L12,20 Z");
                }
            }
            
            // Log pós-mudança (agendar para depois do layout recalcular)
            Dispatcher.BeginInvoke(new Action(() =>
            {
                LogToFile($"[MAXIMIZE-DEBUG] Estado DEPOIS: WindowState={WindowState}");
                LogToFile($"[MAXIMIZE-DEBUG] Window Size DEPOIS: {ActualWidth}x{ActualHeight}");
                LogToFile($"[MAXIMIZE-DEBUG] RootContainer Size DEPOIS: {RootContainer?.ActualWidth}x{RootContainer?.ActualHeight}");
                LogToFile($"[MAXIMIZE-DEBUG] RootContainer.Margin DEPOIS: {RootContainer?.Margin}");
                LogToFile($"[MAXIMIZE-DEBUG] RootContainer.Clip DEPOIS: {RootContainer?.Clip}");
                // LogToFile($"[MAXIMIZE-DEBUG] ClipGeometry.Rect DEPOIS: {ClipGeometry?.Rect}");
                LogToFile($"[MAXIMIZE-DEBUG] ContentClipBorder.ActualWidth DEPOIS: {ContentClipBorder?.ActualWidth}x{ContentClipBorder?.ActualHeight}");
                LogToFile($"[MAXIMIZE-DEBUG] ContentFrame.ActualWidth DEPOIS: {ContentFrame?.ActualWidth}x{ContentFrame?.ActualHeight}");
                LogToFile($"[MAXIMIZE-DEBUG] ===== MaximizeButton_Click FIM =====");
            }), System.Windows.Threading.DispatcherPriority.Loaded);
        }

        /// <summary>
        /// Fecha a janela
        /// </summary>
        private void CloseButton_Click(object sender, RoutedEventArgs e)
        {
            if (_settings.Settings.CloseToTray)
            {
                // Minimizar para systray
                WindowState = WindowState.Minimized;
                HideToTray();
            }
            else
            {
                ExitApplication();
            }
        }
