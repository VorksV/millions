<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.17763.0</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Images\favicon.ico</ApplicationIcon>
    <AssemblyName>VoltrisOptimizer</AssemblyName>
    <StartupObject>VoltrisOptimizer.Program</StartupObject>
    <RootNamespace>VoltrisOptimizer</RootNamespace>
<Version>1.0.2.5</Version>
    <AssemblyVersion>1.0.2.5</AssemblyVersion>
    <FileVersion>1.0.2.5</FileVersion>
    <Authors>VOLTRIS</Authors>
    <Company>Voltris Corporation</Company>
    <Product>Voltris Optimizer</Product>
    <Description>Sistema Profissional de Otimização para Windows 10/11</Description>
    <Copyright>Copyright © VOLTRIS 2025</Copyright>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ForceDesignerDpiUnaware>true</ForceDesignerDpiUnaware>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
    <DefaultItemExcludes>$(DefaultItemExcludes);**\obj\**;**\bin\**;LicenseGenerator\**;RyTuneX-main\**;bACKUP VOLTRIS\**;VOLTRIS BACKUP\**;ANALISAR\**;TaskbarX-master\**;VoltrisBlur-main\**;ORIGINAL\**;Nova Pasta\**;RoslynDiag\**</DefaultItemExcludes>
    <RuntimeIdentifiers>win-x86;win-x64</RuntimeIdentifiers>
    
    <!-- ? CORREO ANTIV RUS: Configuraes para evitar falsos positivos -->
    <SignAssembly>false</SignAssembly>
    <RunPostBuildEvent>false</RunPostBuildEvent>
    
    <!-- Publicao controlada via perfis Publish-x64/Publish-x86 -->
		<LangVersion>preview</LangVersion>
  		<LangVersion>preview</LangVersion>
	</PropertyGroup>

  <!-- Remover PublishDir custom para usar diretrio padro 'bin/Release/.../publish' -->

  <PropertyGroup Condition="'$(Configuration)'=='Debug'">
    <OutputPath>artifacts_app\</OutputPath>
  		<LangVersion>preview</LangVersion>
	</PropertyGroup>

<PropertyGroup Condition="'$(Configuration)'=='Release'">
    <OutputPath>artifacts_app\</OutputPath>
    <!-- CONFIGURAES DE OTIMIZAO PARA RELEASE -->
    <Optimize>true</Optimize>
    <!-- P0 AV-Hardening: evita timestamp pseudo-aleatrio/determinstico no PE (ex: ano 2074) -->
    <Deterministic>false</Deterministic>
    <ContinuousIntegrationBuild>false</ContinuousIntegrationBuild>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <DefineConstants>RELEASE</DefineConstants>
    
    <!-- Otimizaes AOT/JIT -->
    <TieredCompilation>true</TieredCompilation>
    <TieredCompilationQuickJit>true</TieredCompilationQuickJit>
    
    <!-- CORREO ANTIV RUS: Configuraes para whitelist -->
    <PublishSingleFile>false</PublishSingleFile>
    <SelfContained>false</SelfContained>
    <PublishReadyToRun>false</PublishReadyToRun>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <EnableNETAnalyzers>false</EnableNETAnalyzers>
    <RunAnalyzersDuringBuild>false</RunAnalyzersDuringBuild>
    
    <!-- CORREO POWERSHELL: Garantir que todas as DLLs do PowerShell sejam copiadas -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <SatelliteResourceLanguages>pt-BR;en</SatelliteResourceLanguages>
    
    <!-- ARQUIVOS SOLTOS POR PADRO (Enterprise Build) -->
    <!-- Ser controlado via parmetros do dotnet publish -->
    <PublishSingleFile>false</PublishSingleFile>
    <EnableCompressionInSingleFile>false</EnableCompressionInSingleFile>
    
    <!-- No usar trim - quebra reflection em WPF -->
    <PublishTrimmed>false</PublishTrimmed>

    <!-- AUDITORIA FORENSE: Server GC ativado para reduzir pausas de GC (Workstation GC causa stutter em jogo) -->
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <!-- AUDITORIA FORENSE: GC Simultâneo desativado para evitar contenção com threads do jogo no mesmo heap -->
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
   		<LangVersion>preview</LangVersion>
	</PropertyGroup>

  <!-- Assinatura Authenticode opcional no build local/release.
       Ativa quando os parmetros abaixo forem fornecidos:
         - /p:EnableAuthenticodeSigning=true
         - /p:AuthenticodePfxPath=...
         - /p:AuthenticodePfxPassword=...
       (ou via variveis de ambiente equivalentes). -->
  <PropertyGroup>
    <EnableAuthenticodeSigning Condition="'$(EnableAuthenticodeSigning)'==''">false</EnableAuthenticodeSigning>
    <AuthenticodePfxPath Condition="'$(AuthenticodePfxPath)'==''">$(VOLTRIS_AUTHENTICODE_PFX_PATH)</AuthenticodePfxPath>
    <AuthenticodePfxPassword Condition="'$(AuthenticodePfxPassword)'==''">$(VOLTRIS_AUTHENTICODE_PFX_PASSWORD)</AuthenticodePfxPassword>
    <AuthenticodeTimestampUrl Condition="'$(AuthenticodeTimestampUrl)'==''">http://timestamp.digicert.com</AuthenticodeTimestampUrl>
    <SignToolPath Condition="'$(SignToolPath)'==''">signtool.exe</SignToolPath>
  		<LangVersion>preview</LangVersion>
	</PropertyGroup>

  <ItemGroup>
    <!-- Catalogo local de drivers (fonte primaria de verificacao) -->
    <None Include="DriverData\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
