  <!-- DLLS extras: copiadas para o output automaticamente -->

  <!-- Coloque DLLs de terceiros em DLLS\ e elas sero copiadas com o exe -->
  <!--   DLLS\VoltrisBlur\VoltrisBlur.dll ? output\VoltrisBlur\ -->
  <!--   DLLS\outra.dll                             ? output\outra.dll        -->
  <!-- CORREO PROFISSIONAL: Leva apenas binrios e configs para o output, achatando a estrutura de pastas da RecoveryEngine -->
  <ItemGroup>
    <!-- Regra Geral para DLLs comuns da pasta DLLS -->
    <None Include="DLLS\**\*.dll;DLLS\**\*.sys;DLLS\**\*.ini;DLLS\**\*.json" Exclude="DLLS\RecoveryEngine\**\*;DLLS\DriverEngine\**\*" Condition="Exists('DLLS')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>%(RecursiveDir)%(Filename)%(Extension)</Link>
    </None>
    
    <!-- Regra Especfica para RecoveryEngine (Para ficar: RecoveryEngine\AsDllsAqui) -->
    <None Include="DLLS\RecoveryEngine\build\Release\*.dll" Condition="Exists('DLLS\RecoveryEngine\build\Release')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>RecoveryEngine\%(Filename)%(Extension)</Link>
    </None>

    <!-- Regra Especfica para DriverEngine (Para ficar: DriverEngine\driver_engine_x64.dll e x86.dll) -->
    <None Include="DLLS\DriverEngine\Dlls\*.dll" Condition="Exists('DLLS\DriverEngine\Dlls')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>DriverEngine\%(Filename)%(Extension)</Link>
    </None>
  </ItemGroup>

  <!-- CORREO: Garantir que todas as DLLs do PowerShell sejam copiadas -->
  <ItemGroup>
    <Content Include="packages\Microsoft.PowerShell.Commands.Diagnostics\**\*.dll" Condition="Exists('packages\Microsoft.PowerShell.Commands.Diagnostics')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>%(RecursiveDir)%(Filename)%(Extension)</Link>
    </Content>
    <Content Include="packages\Microsoft.PowerShell.Commands.Utility\**\*.dll" Condition="Exists('packages\Microsoft.PowerShell.Commands.Utility')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>%(RecursiveDir)%(Filename)%(Extension)</Link>
    </Content>
    <Content Include="packages\Microsoft.PowerShell.ConsoleHost\**\*.dll" Condition="Exists('packages\Microsoft.PowerShell.ConsoleHost')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>%(RecursiveDir)%(Filename)%(Extension)</Link>
    </Content>
  </ItemGroup>

  
  <!-- Copiando arquivos de cones para o build final -->
  <ItemGroup>
